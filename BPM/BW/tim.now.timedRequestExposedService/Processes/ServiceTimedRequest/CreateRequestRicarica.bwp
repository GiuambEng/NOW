dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;DATAFINERICARICADTU&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;count($T_RITARDO_OFF/Record)>0 &quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;tib:add-to-dateTime($Start/tns1:AssetRicarica/dataFine,0,0,0,0,xsd:integer($T_RITARDO_OFF/Record[1]/VALORE_NUMERICO),0)&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/dataFine&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--L'attributo TIPOLOGIARICARICA non esiste come enumeration del casedata sul nomeAttributo-->&lt;progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivo>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;azione>&lt;xsl:value-of select=&quot;'A'&quot;/>&lt;/azione>&lt;/dettaglioordine>&lt;offerta>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/OFFERTA&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;/ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectAsset/Record/IDCONTRATTO)&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/IDCONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/OFFERTA&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/OFFERTA&quot;/>&lt;/offerta>&lt;/xsl:if>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/IDOFFERTA)&quot;/>&lt;/IDOfferta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($Start/tns1:AssetRicarica/created), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$MapperRicarica/Richiesta/DatiRisorsa/CodiceOloAgcom&quot;/>&lt;/codificaOLOAGCOMRic>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:AssetRicarica/famigliaAsset)='SCHEDULATA'&quot;>&lt;codiceTrasformazione>&lt;xsl:value-of select=&quot;'ACCSCHEDUL'&quot;/>&lt;/codiceTrasformazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns1:AssetRicarica/famigliaAsset)='PROLUNGATA'&quot;>&lt;codiceTrasformazione>&lt;xsl:value-of select=&quot;'ACCPROL'&quot;/>&lt;/codiceTrasformazione>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/VULAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTORICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
