                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLog_RecordTrovati">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SelectAsset/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
