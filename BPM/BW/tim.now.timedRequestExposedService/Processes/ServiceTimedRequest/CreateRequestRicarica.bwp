                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CreateRequestRicarica/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MapperRicarica&quot;/>&lt;xsl:param name=&quot;SelectAsset&quot;/>&lt;xsl:param name=&quot;SelectParametri&quot;/>&lt;xsl:param name=&quot;T_RITARDO_OFF&quot;/>&lt;xsl:template name=&quot;MapperCreateRequest-input&quot; match=&quot;/&quot;>&lt;tns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;INTERNAL&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelectAsset/Record[1]/OFFERTA='BITSTREAMGBEASIMME