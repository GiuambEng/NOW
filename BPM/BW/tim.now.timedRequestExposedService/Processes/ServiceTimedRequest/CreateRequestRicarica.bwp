                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectAsset-input" name="SelectAsset"
                    outputVariable="SelectAsset"
                    tibex:xpdlId="cd24003b-17bb-478c-b1d4-b69f90f3d1ef" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
