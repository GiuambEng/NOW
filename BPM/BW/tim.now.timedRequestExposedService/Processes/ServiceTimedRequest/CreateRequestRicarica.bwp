                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CreateRequestRicarica/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectParametri&quot;/>&lt;xsl:param name=&quot;SelectAsset&quot;/>&lt;xsl:template name=&quot;LogSelectParametri-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| PID: &amp;quot;, $Start/tns1:ProcessID, &amp;quot;| IDAssetRicarica: &amp;quot;, xsd:string($Start/tns1:AssetRicarica/IDAssetRicarica),&amp;quot;IDRichiestaOLO:  &amp;quot;,$SelectAsset/Record[1]/IDRICHIESTAOLO)&quot;/>&lt;/msgCode>&lt;loggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/loggerName>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectParametri/Record)>0&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat('SelectParametri',tib:render-xml($SelectParametri,true(),true()))&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;'SelectParametri: Record non trovati'&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CreateRequestRicarica/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MapperRicarica&quot;/>&lt;xsl:param name=&quot;SelectAsset&quot;/>&lt;xsl:param name=&quot;SelectParametri&quot;/>&lt;xsl:param name=&quot;T_RITARDO_OFF&quot;/>&lt;xsl:template name=&quot;MapperCreateRequest-input&quot; match=&quot;/&quot;>&lt;tns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;INTERNAL&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelectAsset/Record[1]/OFFERTA='BITSTREAMGBEASIMMETRICOFLAT'&quot;>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;RICARICA&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$MapperRicarica/Richiesta/DatiRisorsa/CodiceOloAgcom&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/CODICEORDINEOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/CODICEORDINEOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/dataInvioRichiesta>&lt;ordine>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/OFFERTA&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/OFFERTA&quot;/>&lt;/offertaCatalogo>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/CODIFICAOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCENSIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTO&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/VULAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTORICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;nomeComponente>&lt;xsl:value-of select=&quot;'DATIRICARICA'&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;'3791'&quot;/>&lt;/integrationID>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'DATAINIZIORICARICA'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/dataInizio&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;xsl:if test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'DATAINIZIORICARICADTU'&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectParametri/Record)>0&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;tib:add-to-dateTime($Start/tns1:AssetRicarica/dataInizio,0,0,0,0,xsd:integer($SelectParametri/Record[1]/VALORE_NUMERICO),0)&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/dataInizio&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'DATAFINERICARICA'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/dataFine&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'IDENTIFICATIVOASSET'&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:AssetRicarica/IDAsset=$SelectAsset/Record[1]/IDASSET&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/IDAsset&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;'OFFERTA'&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/OFFERTA&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;TIPOLOGIAACCENSIONERICARICA&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:AssetRicarica/famigliaAsset)=('NRT','RICARICAINIZIALE')&quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'NRT'&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;'SCHEDULATA'&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSETRICARICA&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/IDAssetRicarica&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOTIPOLOGIARICARICA&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/tipologiaRicarica&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;xsl:if test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Spegnimento)&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;DATAFINERICARICADTU&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;xsl:choose>&lt;xsl:when test=&quot;count($T_RITARDO_OFF/Record)>0 &quot;>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;tib:add-to-dateTime($Start/tns1:AssetRicarica/dataFine,0,0,0,0,xsd:integer($T_RITARDO_OFF/Record[1]/VALORE_NUMERICO),0)&quot;/>&lt;/valoreAttributo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/tns1:AssetRicarica/dataFine&quot;/>&lt;/valoreAttributo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;'VARCHAR2'&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            &lt;!--L'attributo TIPOLOGIARICARICA non esiste come enumeration del casedata sul nomeAttributo-->&lt;progressivo>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivo>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;azione>&lt;xsl:value-of select=&quot;'A'&quot;/>&lt;/azione>&lt;/dettaglioordine>&lt;offerta>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/OFFERTA&quot;/>&lt;/offerta>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/IDRISORSA&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;/ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectAsset/Record/IDCONTRATTO)&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/IDCONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$SelectAsset/Record[1]/OFFERTA&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$SelectAsset/Record[1]/OFFERTA&quot;/>&lt;/offerta>&lt;/xsl:if>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($SelectAsset/Record[1]/IDOFFERTA)&quot;/>&lt;/IDOfferta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($Start/tns1:AssetRicarica/created), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(current-date(), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$MapperRicarica/Richiesta/DatiRisorsa/CodiceOloAgcom&quot;/>&lt;/codificaOLOAGCOMRic>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:AssetRicarica/famigliaAsset)='SCHEDULATA'&quot;>&lt;codiceTrasformazione>&lt;xsl:value-of select=&quot;'ACCSCHEDUL'&quot;/>&lt;/codiceTrasformazione>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns1:AssetRicarica/famigliaAsset)='PROLUNGATA'&quot;>&lt;codiceTrasformazione>&lt;xsl:value-of select=&quot;'ACCPROL'&quot;/>&lt;/codiceTrasformazione>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamGBEAsimmetricoFlat/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/BitstreamNGAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat('ACCENSIONERICARICA', $MapperRicarica/Richiesta/TipoAzione/Accensione/VULAFTTCAB/TaglioRicarica)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;SPEGNIMENTORICARICA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
