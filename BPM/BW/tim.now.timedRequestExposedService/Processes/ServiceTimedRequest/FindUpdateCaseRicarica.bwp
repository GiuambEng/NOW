e-of select=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/statoAsset&quot;/>&lt;/statoAsset>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;famigliaAsset>&lt;xsl:value-of select=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/famigliaAsset&quot;/>&lt;/famigliaAsset>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;created>&lt;xsl:value-of select=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/created&quot;/>&lt;/created>&lt;xsl:if test=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/dataAccensione&quot;>&lt;dataAccensione>&lt;xsl:value-of select=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/dataAccensione&quot;/>&lt;/dataAccensione>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/statoAsset='ACCESA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ORADES)&quot;>&lt;dataSpegnimento>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:DES), month-from-date($Start/tns:DES), day-from-date($Start/tns:DES), hours-from-time($Start/tns:ORADES), minutes-from-time($Start/tns:ORADES), xsd:int(seconds-from-time($Start/tns:ORADES)))&quot;/>&lt;/dataSpegnimento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;dataSpegnimento>&lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($Start/tns:DES), month-from-date($Start/tns:DES), day-from-date($Start/tns:DES), 00,00,00)&quot;/>&lt;/dataSpegnimento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/dataSpegnimento&quot;>&lt;dataSpegnimento>&lt;xsl:value-of select=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/dataSpegnimento&quot;/>&lt;/dataSpegnimento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/statoAsset='SCHEDULATA'&quot;>&lt;dataAnnullamento>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/dataAnnullamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/dataAnnullamento&quot;>&lt;dataAnnullamento>&lt;xsl:value-of select=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/dataAnnullamento&quot;/>&lt;/dataAnnullamento>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;operatore>&lt;xsl:value-of select=&quot;$Start/tns:Update/tns:Input[number($index)]/tns:AssetRicarica/operatore&quot;/>&lt;/operatore>&lt;/ns:AssetRicaricaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
