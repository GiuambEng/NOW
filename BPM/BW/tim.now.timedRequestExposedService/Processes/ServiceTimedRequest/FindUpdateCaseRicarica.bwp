                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+0795eac9-656a-49f0-ab31-c37aeb79db6f" version="2.0"> <xsl:template name="Accumulate3" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate3"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while2" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns1:Find/ns1:Input/ns1:Criteria/ns1:NamedParameterAssigned)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns1:Find/ns1:Input/ns1:Criteria/ns1:NamedParameterAssigned)]]></bpws:condition>
                        <bpws:flow name="flow3">
