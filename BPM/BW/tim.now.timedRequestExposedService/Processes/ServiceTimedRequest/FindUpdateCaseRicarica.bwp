            </bpws:scope>
            <bpws:scope name="While2" tibex:group="while" tibex:xpdlId="41a6240e-1bf6-40b9-96ac-fbe02506ab04">
                <bpws:targets>
                    <bpws:target linkName="ControlFindUpdateToWhile2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While2ToRead"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
