                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCaseRicarica/&quot; xmlns:tns1=&quot;http://services.bds.tibco.com/BusinessDataServices_1.2.0&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Find-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:FindCaseByCriteriaRequest>&#xa;            &lt;caseModelVersion>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Input/tns:caseModelVersion&quot;/>&#xa;            &lt;/caseModelVersion>&#xa;            &lt;caseType>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Input/tns:caseType&quot;/>&#xa;            &lt;/caseType>&#xa;            &lt;criteria>&#xa;                &lt;queryString>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Input/tns:Criteria/tns:queryString&quot;/>&#xa;                &lt;/queryString>&#xa;                &lt;namedParameterAssignment>&#xa;                    &lt;name>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Find/tns:Input/tns:Criteria/tns:NamedParameterAssigned[number($index)]/tns:name&quot;/>&#xa;                    &lt;/name>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:Find/tns:Input/tns:Criteria/tns:NamedParameterAssigned[number($index)]/tns:value&quot;>&#xa;                        &lt;value>&#xa;                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/value>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/namedParameterAssignment>&#xa;            &lt;/criteria>&#xa;        &lt;/ns:FindCaseByCriteriaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToFind"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="FindToLogFind"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AccumulateFindAsset/&quot; xmlns:ns=&quot;http://api.bds.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Find&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;xsl:if test=&quot;$Find/findCaseByCriteriaResponse/ns:FindCaseByCriteriaResponse/caseReference[1]&quot;>&lt;tns:CaseReference>&lt;xsl:value-of select=&quot;$Find/findCaseByCriteriaResponse/ns:FindCaseByCriteriaResponse/caseReference[1]&quot;/>&lt;/tns:CaseReference>&lt;/xsl:if>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>"
