            &lt;/Output&gt;
        &lt;/tns:FindUpdateCaseRicaricaResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
