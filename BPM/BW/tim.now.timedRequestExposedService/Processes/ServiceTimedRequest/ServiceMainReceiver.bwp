                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/ServiceTimedRequest/" xmlns:tns1="http://www.tim.com/NOW/xsd/FindUpdateCaseRicarica/" xmlns:tns2="http://www.tim.com/NOW/xsd/ServiceTimedRequest" version="2.0"&gt;
    &lt;xsl:param name="FindUpdateRicarica"/&gt;
    &lt;xsl:template name="FindUpdateCaseRicaricaOut-input" match="/"&gt;
        &lt;tns:FindUpdateCaseRicaricaResponse&gt;
            &lt;Output&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($FindUpdateRicarica/tns1:Find)"&gt;
                        &lt;xsl:for-each select="$FindUpdateRicarica/tns1:Find"&gt;
                            &lt;tns2:Find&gt;
                                &lt;xsl:if test="tns1:CaseReference"&gt;
                                    &lt;tns2:CaseReference&gt;
                                        &lt;xsl:value-of select="tns1:CaseReference"/&gt;
                                    &lt;/tns2:CaseReference&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:for-each select="tns1:Response"&gt;
                                    &lt;tns2:Response&gt;
                                        &lt;tns2:Esito&gt;
                                            &lt;xsl:value-of select="tns1:Esito"/&gt;
                                        &lt;/tns2:Esito&gt;
                                        &lt;xsl:if test="tns1:DescrizioneEsito"&gt;
                                            &lt;tns2:DescrizioneEsito&gt;
                                                &lt;xsl:value-of select="tns1:DescrizioneEsito"/&gt;
