                                                &lt;xsl:value-of select="IDAssetRicarica"/&gt;
                                            &lt;/IDAssetRicarica&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;IDAsset&gt;
                                            &lt;xsl:value-of select="IDAsset"/&gt;
                                        &lt;/IDAsset&gt;
                                        &lt;dataInizio&gt;
                                            &lt;xsl:value-of select="dataInizio"/&gt;
                                        &lt;/dataInizio&gt;
                                        &lt;dataFine&gt;
