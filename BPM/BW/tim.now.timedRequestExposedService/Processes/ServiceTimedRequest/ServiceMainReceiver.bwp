                                        &lt;/xsl:if&gt;
                                    &lt;/tns2:Response&gt;
                                &lt;/xsl:for-each&gt;
                                &lt;xsl:for-each select="tns1:AssetRicarica"&gt;
                                    &lt;tns2:AssetRicarica&gt;
                                        &lt;xsl:if test="IDAssetRicarica"&gt;
