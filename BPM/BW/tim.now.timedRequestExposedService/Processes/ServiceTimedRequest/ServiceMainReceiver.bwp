                            &lt;xsl:if test="$FindUpdateRicarica/tns1:Create/tns1:CaseReference"&gt;
                                &lt;tns2:CaseReference&gt;
                                    &lt;xsl:value-of select="$FindUpdateRicarica/tns1:Create/tns1:CaseReference"/&gt;
                                &lt;/tns2:CaseReference&gt;
