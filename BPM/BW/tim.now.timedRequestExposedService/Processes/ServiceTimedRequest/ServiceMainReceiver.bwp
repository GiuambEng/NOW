                                                &lt;xsl:value-of select="lastUpdate"/&gt;
                                            &lt;/lastUpdate&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;created&gt;
                                            &lt;xsl:value-of select="created"/&gt;
                                        &lt;/created&gt;
                                        &lt;xsl:if test="dataAccensione"&gt;
                                            &lt;dataAccensione&gt;
                                                &lt;xsl:value-of select="dataAccensione"/&gt;
                                            &lt;/dataAccensione&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="dataSpegnimento"&gt;
                                            &lt;dataSpegnimento&gt;
                                                &lt;xsl:value-of select="dataSpegnimento"/&gt;
                                            &lt;/dataSpegnimento&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="dataAnnullamento"&gt;
