                            &lt;xsl:if test="$FindUpdateRicarica/tns1:Create/tns1:AssetNow"&gt;
                                &lt;tns2:AssetNow&gt;
                                    &lt;xsl:value-of select="$FindUpdateRicarica/tns1:Create/tns1:AssetNow"/&gt;
                                &lt;/tns2:AssetNow&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:for-each select="$FindUpdateRicarica/tns1:Create/tns1:Response"&gt;
                                &lt;tns2:Response&gt;
                                    &lt;tns2:Esito&gt;
