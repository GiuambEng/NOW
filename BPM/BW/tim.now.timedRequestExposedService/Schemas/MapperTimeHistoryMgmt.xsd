<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/MapperTimeHistoryMgmt" xmlns:tns="http://www.example.org/MapperTimeHistoryMgmt" elementFormDefault="qualified">


    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="InputMapper" maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="IDRICHIESTAOLO"
    							type="string">
    						</element>
    						<element name="TASK" type="string"></element>
    						<element name="SCADENZA" type="dateTime"></element>
    						<element name="STATO" type="string"></element>
    						<element name="QUEUE_NAME" type="string"></element>
    						<element name="CREATED" type="dateTime"></element>
    						<element name="LAST_UPDATE" type="dateTime"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>