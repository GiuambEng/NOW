<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/StoricoRichiestaRicarica/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/StoricoRichiestaRicarica/">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="IDRichOLO" type="string" minOccurs="1" maxOccurs="1" ></element>
    			<element name="IDAssetRicarica" type="string" minOccurs="0" maxOccurs="unbounded"></element>
    			<element name="ProcessID" type="string" minOccurs="0" maxOccurs="1" ></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Output">
    <complexType>
    
        <sequence>
    		<element name="Esito" type="string" minOccurs="1" maxOccurs="1"></element>
    	</sequence>
    </complexType>
    </element>
    
</schema>