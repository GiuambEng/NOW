<?xml version="1.0" encoding="UTF-8"?>
<schema
	targetNamespace="http://www.tim.com/NOW/xsd/CreateRequestRicarica/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/CreateRequestRicarica/" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">

	<import schemaLocation="../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="Input">
		<complexType>
			<sequence>
				<element name="AssetRicarica" type="pref:AssetRicarica"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="ContenutoXML" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="IDAssetRicarica" type="int" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="ProcessID" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="FlagAccensione" type="boolean"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Control" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Output">
		<complexType>
			<sequence>
				<element name="Esito" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="IDRichiestaOLO" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="ControlloFault" type="boolean" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>