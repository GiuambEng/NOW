            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;IDANAG_CAUSALE&quot;/>&lt;xsl:template name=&quot;MapperCps_EsitoVerifiche-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaCPS>&lt;tns:EsitoVerifiche>&lt;tns:CodiceFornitore>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns:CodiceFornitore>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineTI)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineTI&quot;>&lt;tns:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineTI&quot;/>&lt;/tns:CodiceOrdineFornitore>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codiceOrdineTI)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codiceOrdineTI&quot;>&lt;tns:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codiceOrdineTI&quot;/>&lt;/tns:CodiceOrdineFornitore>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:CodiceRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns:CodiceRichiedente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineOLO)>0&quot;>&lt;tns:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineRichiedente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineRichiedente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns:DataNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='SCARTATO'&quot;>&lt;tns:StatoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:StatoOrdine>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='ACQUISITO' or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO= &amp;quot;INDELIVERY&amp;quot; or&amp;#xD;&amp;#xA;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO= &amp;quot;INVIATOADELIVERY&amp;quot;&quot;>&lt;tns:StatoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:StatoOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:StatoOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario='RECIPIENT'&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario='RECIPIENT'&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario='DONATING'&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/tns:DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;count($IDANAG_CAUSALE/Record)>0&quot;>&lt;tns:Rifiuto>&lt;tns:TipoCausaleRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/TIPO_CAUSALE_RIF_CPS&quot;/>&lt;/tns:TipoCausaleRifiuto>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/tns:Rifiuto>&lt;/xsl:if>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/DRO)&quot;>&lt;tns:DataDRO>&lt;xsl:value-of select=&quot;format-date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/DRO , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataDRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataDRO>&lt;xsl:value-of select=&quot;format-date(current-date() , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataDRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:EsitoVerifiche>&lt;/tns:NotificaCPS>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
