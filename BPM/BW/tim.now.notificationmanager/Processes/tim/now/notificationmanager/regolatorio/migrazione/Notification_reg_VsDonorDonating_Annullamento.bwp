                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;IDDettaglio&quot;/>&lt;xsl:template name=&quot;MigrazioneMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaVsDonorDonating>&lt;tns:TestataNotifica>&lt;tns:CodiceDonating>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceDonating&quot;/>&lt;/tns:CodiceDonating>&lt;tns:CodiceOrdineRiferimentoTI>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceOrdineRiferimentoTI&quot;/>&lt;/tns:CodiceOrdineRiferimentoTI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceRisorsa1)&quot;>&lt;tns:CodiceRisorsa1>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceRisorsa1&quot;/>&lt;/tns:CodiceRisorsa1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceRisorsa2>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceRisorsa2&quot;/>&lt;/tns:CodiceRisorsa2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceSessione1)&quot;>&lt;tns:CodiceSessione1>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceSessione1&quot;/>&lt;/tns:CodiceSessione1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceSessione2>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:CodiceSessione2&quot;/>&lt;/tns:CodiceSessione2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:DataNotifica&quot;/>&lt;/tns:DataNotifica>&lt;tns:DataDRO>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:DataDRO&quot;/>&lt;/tns:DataDRO>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:Note&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataVsDonorDonating/tns1:Note&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/tns:TestataNotifica>&lt;tns:Annullamento>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot;)&amp;#xD;&amp;#xA; and exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns1:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot; and upper-case(valoreAttributo)!=&amp;quot;TLC&amp;quot;]) &amp;#xD;&amp;#xA; and &amp;#xD;&amp;#xA;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns1:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo) > 0  and exists($IDDettaglio/tns1:IDDettaglio[1]) &quot;>&lt;tns:CodiceDonor>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns1:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:CodiceDonor>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot; and&amp;#xD;&amp;#xA;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo)>0 and&amp;#xD;&amp;#xA;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo=$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:CodificaOLOAGCOMDestinatario&quot;>&lt;tns:CodiceDonor>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo&quot;/>&lt;/tns:CodiceDonor>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceDonor>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/tns:CodiceDonor>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOM = &amp;quot;TLC&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:CodiceRecipient>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/tns:CodiceRecipient>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOM != &amp;quot;TLC&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:CodiceRecipient>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:CodiceRecipient>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceRecipient>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns:CodiceRecipient>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RichiestaNok>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:RichiestaNok>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IDDettaglio/tns1:IDDettaglio[1]) and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns1:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo) > 0 and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns1:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo) > 0&quot;>&lt;tns:NP>&lt;tns:RoutingNumberRecipient>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns1:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:RoutingNumberRecipient>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns1:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DN>&lt;xsl:for-each select=&quot;$IDDettaglio/tns1:IDDettaglio[.!=$IDDettaglio/tns1:IDDettaglio[1]]&quot;>&lt;xsl:variable name=&quot;IDDettaglio&quot; select=&quot;.&quot;/>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&lt;tns:DNaggiuntive>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DNaggiuntive>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:NP>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/offerta = &amp;quot;ULLLINEAATTIVANP&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/offerta = &amp;quot;ULLDATILINEAATTIVANP&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/offerta = &amp;quot;SLULINEAATTIVANP&amp;quot;) and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRisorsa) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = ../../IDRisorsa]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo) > 0 and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = ../../IDRisorsa]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo) > 0&quot;>&lt;tns:NP>&lt;tns:RoutingNumberRecipient>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = ../../IDRisorsa]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:RoutingNumberRecipient>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = ../../IDRisorsa]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DN>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != ../../IDRisorsa]&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&lt;tns:DNaggiuntive>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DNaggiuntive>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:NP>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/offerta, &amp;quot;WLR&amp;quot;) or starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/offerta, &amp;quot;VULL&amp;quot;)) and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:NP>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/offerta, &amp;quot;WLR&amp;quot;)&quot;>&lt;tns:RoutingNumberRecipient>&lt;xsl:value-of select=&quot;&amp;quot;C000002&amp;quot;&quot;/>&lt;/tns:RoutingNumberRecipient>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RoutingNumberRecipient>&lt;xsl:value-of select=&quot;&amp;quot;C000003&amp;quot;&quot;/>&lt;/tns:RoutingNumberRecipient>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DN>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&lt;tns:DNaggiuntive>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DNaggiuntive>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:NP>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSIS