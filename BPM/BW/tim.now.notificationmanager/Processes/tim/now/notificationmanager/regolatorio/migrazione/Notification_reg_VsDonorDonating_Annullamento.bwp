quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&#xa;                                                                &lt;tns:DNaggiuntive>&#xa;                                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                                &lt;/tns:DNaggiuntive>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:for-each>&#xa;                                                    &lt;/tns:NP>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise/>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;(starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/offerta, &amp;quot;WLR&amp;quot;) or starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/offerta, &amp;quot;VULL&amp;quot;)) and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&#xa;                                                    &lt;tns:NP>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/offerta, &amp;quot;WLR&amp;quot;)&quot;>&#xa;                                                                &lt;tns:RoutingNumberRecipient>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;C000002&amp;quot;&quot;/>&#xa;                                                                &lt;/tns:RoutingNumberRecipient>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;tns:RoutingNumberRecipient>&#xa;                                                                    &lt;xsl:value-of select=&quot;&amp;quot;C000003&amp;quot;&quot;/>&#xa;                                                                &lt;/tns:RoutingNumberRecipient>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                        &lt;tns:DN>&#xa;                                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                        &lt;/tns:DN>&#xa;                                                        &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]&quot;>&#xa;                                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quo