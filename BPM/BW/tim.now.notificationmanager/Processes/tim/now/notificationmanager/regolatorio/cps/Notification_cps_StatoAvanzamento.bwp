                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;IDANAG_CAUSALE&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperCps_StatoAvanzamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaCPS>&#xa;                &lt;tns:StatoAvanzamento>&#xa;                    &lt;tns:CodiceFornitore>&#xa;                        &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                    &lt;/tns:CodiceFornitore>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI)>0&quot;>&#xa;                            &lt;tns:CodiceOrdineFornitore>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;/>&#xa;                            &lt;/tns:CodiceOrdineFornitore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceOrdineFornitore>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/codiceOrdineTI&quot;/>&#xa;                            &lt;/tns:CodiceOrdineFornitore>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:CodiceRichiedente>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodiceRichiedente>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO)>0&quot;>&#xa;                            &lt;tns:CodiceOrdineRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                            &lt;/tns:CodiceOrdineRichiedente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceOrdineRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/codiceOrdineOLO&quot;/>&#xa;                            &lt;/tns:CodiceOrdineRichiedente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:DataNotifica>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataNotifica>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='SOSPESO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='SOSPESOATTESAPERMESSI' &amp;#xD;&amp;#xA;&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;6&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='ANNULLATO'&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='ACQUISITO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO= &amp;quot;INDELIVERY&amp;quot; or&amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO= &amp;quot;INVIATOADELIVERY&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO= &amp;quot;VERIFICHEINRETE&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO= &amp;quot;INANNULLAMENTOSULDELIVERY&amp;quot;&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='RIFIUTATO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='SCARTATO'&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='ACCETTATO'&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='ESPLETAMENTOTECNICO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='CHIUSO'&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='ESPLETAMENTOTECNICOKO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='SCARTATO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='RIFIUTATO'&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/DRO)&quot;>&#xa;                            &lt;tns:DataDRO>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/DRO , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataDRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataDRO>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date() , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataDRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario='RECIPIENT'&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario='RECIPIENT'&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario='DONATING'&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario='DONATING'&quot;>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($JDBCQuery/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:DataEstrazioneWL>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataEstrazioneWL>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES)&quot;>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(xsd:dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                            &lt;tns:OrarioDataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;xsd:string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/ORA_DES)&quot;/>&#xa;                            &lt;/tns:OrarioDataEspletamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;count($IDANAG_CAUSALE/Record)>0&quot;>&#xa;                        &lt;tns:Rifiuto>&#xa;                            &lt;tns:TipoCausaleRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                            &lt;/tns:TipoCausaleRifiuto>&#xa;                            &lt;tns:CodiceMotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                            &lt;/tns:CodiceMotivoRifiuto>&#xa;                            &lt;tns:MotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/TIPO_CAUSALE_RIF_CPS&quot;/>&#xa;                            &lt;/tns:MotivoRifiuto>&#xa;                        &lt;/tns:Rifiuto>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:StatoAvanzamento>&#xa;            &lt;/tns:NotificaCPS>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
