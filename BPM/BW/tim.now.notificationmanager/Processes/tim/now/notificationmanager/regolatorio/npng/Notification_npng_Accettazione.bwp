                                    sqlStatement="SELECT COD_CAUS_OLO, DESCR_CAUS_OLO&#xa;  FROM ANAG_CAUS&#xa;  WHERE ID_ANAG_CAUS = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
