                partnerLink="Notification_npng_Accettazione"
                portType="ns8:Notification_reg_Accettazione"
                tibex:xpdlId="9d579d17-81be-4f11-82eb-e39325332ea3" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns="http://xsd.telecomitalia.it/crm/regolatorio" version="2.0"&gt;
    &lt;xsl:param name="NPNGMapper"/&gt;
    &lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;
        &lt;tns4:GenericNotificationResponse&gt;
            &lt;NotificaGenericaRisposta&gt;
                &lt;tns3:NotificaGenericaResponse&gt;
                    &lt;tns:NotificaOloRegolatorio&gt;
                        &lt;tns:NotificaVsRecipient&gt;
                            &lt;tns:TestataNotifica&gt;
                                &lt;tns:CodiceRecipient&gt;
                                    &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRecipient"/&gt;
                                &lt;/tns:CodiceRecipient&gt;
                                &lt;tns:CodiceOrdineRecipient&gt;
                                    &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceOrdineRecipient"/&gt;
                                &lt;/tns:CodiceOrdineRecipient&gt;
                                &lt;tns:CodiceRisorsa1&gt;
                                    &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRisorsa1"/&gt;
                                &lt;/tns:CodiceRisorsa1&gt;
                                &lt;xsl:if test="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRisorsa2"&gt;
                                    &lt;tns:CodiceRisorsa2&gt;
                                        &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRisorsa2"/&gt;
                                    &lt;/tns:CodiceRisorsa2&gt;
                                &lt;/xsl:if&gt;
                                &lt;tns:DataNotifica&gt;
                                    &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/DataNotifica"/&gt;
                                &lt;/tns:DataNotifica&gt;
                                &lt;tns:DataDRO&gt;
                                    &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/DataDRO"/&gt;
                                &lt;/tns:DataDRO&gt;
                                &lt;xsl:if test="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/Note"&gt;
                                    &lt;tns:Note&gt;
                                        &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/Note"/&gt;
                                    &lt;/tns:Note&gt;
                                &lt;/xsl:if&gt;
                            &lt;/tns:TestataNotifica&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaOk)"&gt;
                                    &lt;tns:Accettazione&gt;
                                        &lt;tns:RichiestaOk&gt;
                                            &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaOk"/&gt;
                                        &lt;/tns:RichiestaOk&gt;
                                    &lt;/tns:Accettazione&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns:Accettazione&gt;
                                        &lt;tns:RichiestaNok&gt;
                                            &lt;tns:CausaleRifiutoMig&gt;
                                                &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/CausaleRifiutoMig"/&gt;
                                            &lt;/tns:CausaleRifiutoMig&gt;
                                            &lt;tns:CodiceMotivoRifiutoMig&gt;
                                                &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/CodiceMotivoRifiutoMig"/&gt;
                                            &lt;/tns:CodiceMotivoRifiutoMig&gt;
                                            &lt;tns:MotivoRifiutoMig&gt;
                                                &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/MotivoRifiutoMig"/&gt;
                                            &lt;/tns:MotivoRifiutoMig&gt;
                                            &lt;xsl:if test="$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/NumerazioneErrata"&gt;
                                                &lt;tns:NumerazioneErrata&gt;
                                                    &lt;xsl:value-of select="$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/NumerazioneErrata"/&gt;
                                                &lt;/tns:NumerazioneErrata&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/tns:RichiestaNok&gt;
                                    &lt;/tns:Accettazione&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns:NotificaVsRecipient&gt;
                    &lt;/tns:NotificaOloRegolatorio&gt;
                &lt;/tns3:NotificaGenericaResponse&gt;
            &lt;/NotificaGenericaRisposta&gt;
        &lt;/tns4:GenericNotificationResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NPNGMapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NotificaGenericaResponse>&#xa;            &lt;tns:NotificaOloRegolatorio>&#xa;                &lt;tns:NotificaVsRecipient>&#xa;                    &lt;tns:TestataNotifica>&#xa;                        &lt;tns:CodiceRecipient>&#xa;                            &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRecipient&quot;/>&#xa;                        &lt;/tns:CodiceRecipient>&#xa;                        &lt;tns:CodiceOrdineRecipient>&#xa;                            &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceOrdineRecipient&quot;/>&#xa;                        &lt;/tns:CodiceOrdineRecipient>&#xa;                        &lt;tns:CodiceRisorsa1>&#xa;                            &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRisorsa1&quot;/>&#xa;                        &lt;/tns:CodiceRisorsa1>&#xa;                        &lt;xsl:if test=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRisorsa2&quot;>&#xa;                            &lt;tns:CodiceRisorsa2>&#xa;                                &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/CodiceRisorsa2&quot;/>&#xa;                            &lt;/tns:CodiceRisorsa2>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/DataNotifica&quot;/>&#xa;                        &lt;/tns:DataNotifica>&#xa;                        &lt;tns:DataDRO>&#xa;                            &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/DataDRO&quot;/>&#xa;                        &lt;/tns:DataDRO>&#xa;                        &lt;xsl:if test=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/Note&quot;>&#xa;                            &lt;tns:Note>&#xa;                                &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/TestataNotifica/Note&quot;/>&#xa;                            &lt;/tns:Note>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:TestataNotifica>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaOk)&quot;>&#xa;                            &lt;tns:Accettazione>&#xa;                                &lt;tns:RichiestaOk>&#xa;                                    &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaOk&quot;/>&#xa;                                &lt;/tns:RichiestaOk>&#xa;                            &lt;/tns:Accettazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Accettazione>&#xa;                                &lt;tns:RichiestaNok>&#xa;                                    &lt;tns:CausaleRifiutoMig>&#xa;                                        &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/CausaleRifiutoMig&quot;/>&#xa;                                    &lt;/tns:CausaleRifiutoMig>&#xa;                                    &lt;tns:CodiceMotivoRifiutoMig>&#xa;                                        &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/CodiceMotivoRifiutoMig&quot;/>&#xa;                                    &lt;/tns:CodiceMotivoRifiutoMig>&#xa;                                    &lt;tns:MotivoRifiutoMig>&#xa;                                        &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/MotivoRifiutoMig&quot;/>&#xa;                                    &lt;/tns:MotivoRifiutoMig>&#xa;                                    &lt;xsl:if test=&quot;$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/NumerazioneErrata&quot;>&#xa;                                        &lt;tns:NumerazioneErrata>&#xa;                                            &lt;xsl:value-of select=&quot;$NPNGMapper/NotificaVsRecipient[1]/Accettazione/RichiestaNok/NumerazioneErrata&quot;/>&#xa;                                        &lt;/tns:NumerazioneErrata>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:RichiestaNok>&#xa;                            &lt;/tns:Accettazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:NotificaVsRecipient>&#xa;            &lt;/tns:NotificaOloRegolatorio>&#xa;        &lt;/tns3:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
