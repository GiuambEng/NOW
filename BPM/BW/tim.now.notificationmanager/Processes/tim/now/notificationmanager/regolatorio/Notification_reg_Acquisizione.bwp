                        <bpws:reply faultName="fault" name="Reply"
                            operation="GenericNotification"
                            partnerLink="Notification_reg_Acquisizione"
                            portType="ns8:Notification_reg_Acquisizione"
                            tibex:xpdlId="d3f417ee-11c5-4135-8dd8-196e6ca02c50" variable="Reply-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns3="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns2:GenericNotificationFault&gt;&lt;NotificaGenericaFault&gt;&lt;tns3:NotificaGenericaFault&gt;&lt;tns3:Codice&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns3:Codice&gt;&lt;tns3:Descrizione&gt;&lt;xsl:value-of select="concat(tib:render-xml($FaultDetails), $FaultDetails/MsgCode)"/&gt;&lt;/tns3:Descrizione&gt;&lt;/tns3:NotificaGenericaFault&gt;&lt;/NotificaGenericaFault&gt;&lt;/tns2:GenericNotificationFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NotificaGenericaFault>&#xa;            &lt;tns3:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns3:Codice>&#xa;            &lt;tns3:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;concat(tib:render-xml($FaultDetails), $FaultDetails/MsgCode)&quot;/>&#xa;            &lt;/tns3:Descrizione>&#xa;        &lt;/tns3:NotificaGenericaFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
