                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&#xa;                            &lt;tns:Rifiuto>&#xa;                                &lt;tns:TipoCausaleRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns:TipoCausaleRifiuto>&#xa;                                &lt;tns:CodiceMotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;tns:MotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:MotivoRifiuto>&#xa;                            &lt;/tns:Rifiuto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/tipologiaLinea)),&amp;quot;ISDN&amp;quot;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BORCHIANT1PLUS&amp;quot;]/valoreAttributo = &amp;quot;W-&amp;quot;&quot;>&#xa;                                    &lt;tns:BorchiaISDN>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&#xa;                                    &lt;/tns:BorchiaISDN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BORCHIANT1PLUS&amp;quot;]/valoreAttributo = &amp;quot;W+&amp;quot;&quot;>&#xa;                                    &lt;tns:BorchiaISDN>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;B&amp;quot;&quot;/>&#xa;                                    &lt;/tns:BorchiaISDN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Acquisizione>&#xa;            &lt;/tns:NotificaWLR>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &l