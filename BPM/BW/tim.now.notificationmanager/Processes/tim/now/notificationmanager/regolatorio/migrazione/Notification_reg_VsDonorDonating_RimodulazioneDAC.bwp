-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataDAC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/DAC)&quot;>&#xa;                            &lt;tns:DataDAC>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataDAC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataDAC>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($calcDeadline.response/@end-date-time, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataDAC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:RimodulazioneDAC>&#xa;            &lt;/tns:NotificaVsDonorDonating>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
