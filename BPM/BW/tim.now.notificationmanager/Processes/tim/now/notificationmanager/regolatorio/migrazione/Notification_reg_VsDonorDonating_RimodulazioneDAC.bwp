            </bpws:receive>
            <bpws:reply name="GenericNotificationOut"
                operation="GenericNotification"
                partnerLink="Notification_reg_VsDonorDonating_RimodulazioneDAC"
                portType="ns8:Notification_reg_VsDonorDonating_RimodulazioneDAC"
                tibex:xpdlId="9d579d17-81be-4f11-82eb-e39325332ea3" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns="http://xsd.telecomitalia.it/crm/regolatorio" version="2.0"&gt;&lt;xsl:param name="MigrazioneMapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns4:GenericNotificationResponse&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns3:NotificaGenericaResponse&gt;&lt;tns:NotificaOloRegolatorio&gt;&lt;tns:NotificaVsDonorDonating&gt;&lt;xsl:copy-of select="$MigrazioneMapper/tns:NotificaVsDonorDonating/tns:TestataNotifica"/&gt;&lt;xsl:copy-of select="$MigrazioneMapper/tns:NotificaVsDonorDonating/tns:RimodulazioneDAC"/&gt;&lt;/tns:NotificaVsDonorDonating&gt;&lt;/tns:NotificaOloRegolatorio&gt;&lt;/tns3:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns4:GenericNotificationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MigrazioneMapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NotificaGenericaResponse>&#xa;            &lt;tns:NotificaOloRegolatorio>&#xa;                &lt;tns:NotificaVsDonorDonating>&#xa;                    &lt;xsl:copy-of select=&quot;$MigrazioneMapper/tns:NotificaVsDonorDonating/tns:TestataNotifica&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$MigrazioneMapper/tns:NotificaVsDonorDonating/tns:RimodulazioneDAC&quot;/>&#xa;                &lt;/tns:NotificaVsDonorDonating>&#xa;            &lt;/tns:NotificaOloRegolatorio>&#xa;        &lt;/tns3:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="ULLMapperToGenericNotificationOut"/>
                </bpws:targets>
                <bpws:sources/>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:ns=&quot;http://deadline.api.dac.n2.tibco.com&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;IDDettaglio&quot;/>&lt;xsl:param name=&quot;calcDeadline&quot;/>&lt;xsl:template name=&quot;MigrazioneMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaVsDonorDonating>&lt;tns:TestataNotifica>&lt;tns:CodiceDonating>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceDonating&quot;/>&lt;/tns:CodiceDonating>&lt;tns:CodiceOrdineRiferimentoTI>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceOrdineRiferimentoTI&quot;/>&lt;/tns:CodiceOrdineRiferimentoTI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceRisorsa1)&quot;>&lt;tns:CodiceRisorsa1>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceRisorsa1&quot;/>&lt;/tns:CodiceRisorsa1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceRisorsa2>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceRisorsa2&quot;/>&lt;/tns:CodiceRisorsa2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceSessione1)&quot;>&lt;tns:CodiceSessione1>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceSessione1&quot;/>&lt;/tns:CodiceSessione1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceSessione2>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceSessione2&quot;/>&lt;/tns:CodiceSessione2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:DataNotifica&quot;/>&lt;/tns:DataNotifica>&lt;tns:DataDRO>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:DataDRO&quot;/>&lt;/tns:DataDRO>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:Note&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:Note&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/tns:TestataNotifica>&lt;tns:RimodulazioneDAC>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot;)&amp;#xD;&amp;#xA; and exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot; and upper-case(valoreAttributo)!=&amp;quot;TLC&amp;quot;]) &amp;#xD;&amp;#xA; and &amp;#xD;&amp;#xA;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo) > 0  and exists($IDDettaglio/tns3:IDDettaglio[1]) &quot;>&lt;tns:CodiceDonor>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:CodiceDonor>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot; and&amp;#xD;&amp;#xA;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo)>0 and&amp;#xD;&amp;#xA;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo=$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:CodificaOLOAGCOMDestinatario&quot;>&lt;tns:CodiceDonor>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo&quot;/>&lt;/tns:CodiceDonor>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceDonor>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/tns:CodiceDonor>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/codificaOLOAGCOM = &amp;quot;TLC&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:CodiceRecipient>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/tns:CodiceRecipient>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/codificaOLOAGCOM != &amp;quot;TLC&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:CodiceRecipient>&lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&lt;/tns:CodiceRecipient>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceRecipient>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns:CodiceRecipient>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IDDettaglio/tns3:IDDettaglio[1]) and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/o