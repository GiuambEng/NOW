mp;quot;NUMBERPORTABILITY&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;tns:RoutingNumberRecipient>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = $NumeroTelefonico1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:RoutingNumberRecipient>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = $NumeroTelefonico1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DN>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != $NumeroTelefonico1]&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&lt;tns:DNaggiuntive>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DNaggiuntive>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:NP>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/DACRimodulata)&quot;>&lt;tns:DataDAC>&lt;xsl:value-of select=&quot;format-date($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataDAC>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/DAC)&quot;>&lt;tns:DataDAC>&lt;xsl:value-of select=&quot;format-date($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataDAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataDAC>&lt;xsl:value-of select=&quot;format-dateTime($calcDeadline/response/ns:calcDeadlineResponse/@end-date-time, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataDAC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RimodulazioneDAC>&lt;/tns:NotificaVsDonorDonating>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MigrazioneMapper-input"
                    name="MigrazioneMapper"
                    outputVariable="MigrazioneMapper"
                    tibex:xpdlId="0117154f-406c-483d-a94c-ed04c836d69e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="calcDeadlineToMigrazioneMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ULLMapperToGenericNotificationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:ns=&quot;http://deadline.api.dac.n2.tibco.com&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;calcDeadline.response&quot;/>&#xa;    &lt;xsl:param name=&quot;IDDettaglio&quot;/>&#xa;    &lt;xsl:template name=&quot;MigrazioneMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaVsDonorDonating>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;tns:CodiceDonating>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceDonating&quot;/>&#xa;                    &lt;/tns:CodiceDonating>&#xa;                    &lt;tns:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceOrdineRiferimentoTI&quot;/>&#xa;                    &lt;/tns:CodiceOrdineRiferimentoTI>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceRisorsa1)&quot;>&#xa;                            &lt;tns:CodiceRisorsa1>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceRisorsa1&quot;/>&#xa;                            &lt;/tns:CodiceRisorsa1>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceRisorsa2>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceRisorsa2&quot;/>&#xa;                            &lt;/tns:CodiceRisorsa2>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceSessione1)&quot;>&#xa;                            &lt;tns:CodiceSessione1>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceSessione1&quot;/>&#xa;                            &lt;/tns:CodiceSessione1>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceSessione2>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:CodiceSessione2&quot;/>&#xa;                            &lt;/tns:CodiceSessione2>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:DataNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:DataNotifica&quot;/>&#xa;                    &lt;/tns:DataNotifica>&#xa;                    &lt;tns:DataDRO>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:DataDRO&quot;/>&#xa;                    &lt;/tns:DataDRO>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:Note&quot;>&#xa;                        &lt;tns:Note>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataVsDonorDonating/tns3:Note&quot;/>&#xa;                        &lt;/tns:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:RimodulazioneDAC>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot;)&amp;#xD;&amp;#xA; and exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot; and upper-case(valoreAttributo)!=&amp;quot;TLC&amp;quot;]) &amp;#xD;&amp;#xA; and &amp;#xD;&amp;#xA;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo) > 0  and exists($IDDettaglio/tns3:IDDettaglio[1]) &quot;>&#xa;                            &lt;tns:CodiceDonor>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo&quot;/>&#xa;                            &lt;/tns:CodiceDonor>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot; and&amp;#xD;&amp;#xA;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo)>0 and&amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo=$GenericNotificationIn.NotificaGenericaRichiesta/tns3:CodificaOLOAGCOMDestinatario&quot;>&#xa;                            &lt;tns:CodiceDonor>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:CodiceDonor>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceDonor>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                            &lt;/tns:CodiceDonor>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/codificaOLOAGCOM = &amp;quot;TLC&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&#xa;                            &lt;tns:CodiceRecipient>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                            &lt;/tns:CodiceRecipient>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/codificaOLOAGCOM != &amp;quot;TLC&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&#xa;                            &lt;tns:CodiceRecipient>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;***&amp;quot;&quot;/>&#xa;                            &lt;/tns:CodiceRecipient>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceRecipient>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/tns:CodiceRecipient>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($IDDettaglio/tns3:IDDettaglio[1]) and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo) > 0 and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;tns:NP>&#xa;                                        &lt;tns:RoutingNumberRecipient>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/tns:RoutingNumberRecipient>&#xa;                                        &lt;tns:DN>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio/tns3:IDDettaglio[1]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/tns:DN>&#xa;                                        &lt;xsl:for-each select=&quot;$IDDettaglio/tns3:IDDettaglio[.!=$IDDettaglio/tns3:IDDettaglio[1]]&quot;>&#xa;                                            &lt;xsl:variable name=&quot;IDDettaglio&quot; select=&quot;.&quot;/>&#xa;                                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&#xa;                                                &lt;tns:DNaggiuntive>&#xa;                                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[IDDettaglioOrdine = $IDDettaglio]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/tns:DNaggiuntive>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/tns:NP>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/offerta = &amp;quot;ULLLINEAATTIVANP&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/offerta = &amp;quot;ULLDATILINEAATTIVANP&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/offerta = &amp;quot;SLULINEAATTIVANP&amp;quot;) and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRisorsa) > 0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = ../../IDRisorsa]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo) > 0 and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdi