                <bpws:link name="calcDeadlineToMigrazioneMapper" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes"
                name="GenericNotificationIn"
                operation="GenericNotification"
                partnerLink="Notification_reg_VsDonorDonating_RimodulazioneDAC"
                portType="ns8:Notification_reg_VsDonorDonating_RimodulazioneDAC"
                tibex:xpdlId="40921440-43da-4217-841a-51c6a02afb03" variable="GenericNotificationIn">
