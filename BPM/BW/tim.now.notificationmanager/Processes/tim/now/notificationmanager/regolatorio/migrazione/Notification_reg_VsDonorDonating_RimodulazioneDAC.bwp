            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:template name=&quot;IDDettaglio&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot;&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:CodificaOLOAGCOMDestinatario = &amp;quot;INF&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:CodificaOLOAGCOMDestinatario = &amp;quot;WIN&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and  attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo = &amp;quot;INF&amp;quot;])&quot;>&#xa;                                &lt;tns:NumberPortability>&#xa;                                    &lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and  attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo = &amp;quot;INF&amp;quot;]&quot;>&#xa;                                        &lt;tns:IDDettaglio>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglio>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/tns:NumberPortability>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and  attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo = &amp;quot;WIN&amp;quot;])&quot;>&#xa;                                &lt;tns:NumberPortability>&#xa;                                    &lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and  attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo = &amp;quot;WIN&amp;quot;]&quot;>&#xa;                                        &lt;tns:IDDettaglio>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglio>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/tns:NumberPortability>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:NumberPortability>&#xa;                                    &lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and  attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo = ../../../tns:CodificaOLOAGCOMDestinatario]&quot;>&#xa;          