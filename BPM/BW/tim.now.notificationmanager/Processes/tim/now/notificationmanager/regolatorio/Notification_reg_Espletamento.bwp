                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Espletamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_Espletamento&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_Espletamento&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in input:&amp;#xA;&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaNotifica, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;Offerta:&amp;#xA;&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Offerta, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;Causale:&amp;#xA;&amp;quot;, $JDBC_CAUSALE/Record[1]/COD_CAUS_OLO, &amp;quot; &amp;quot;, $JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO)&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in input:&amp;#xA;&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaNotifica, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;Offerta:&amp;#xA;&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Offerta)&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.regolatorio&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;GenericNotification_&amp;quot;,$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;                &lt;tns1:Playload/>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:template name=&quot;DTUElement&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:DTUMapping>&#xa;            &lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/created&quot;>&#xa;                &lt;xsl:sort select=&quot;string(.)&quot;/>&#xa;                &lt;tns3:DTUElement>&#xa;                    &lt;xsl:value-of select=&quot;string(.)&quot;/>&#xa;                &lt;/tns3:DTUElement>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:DTUMapping>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DTUFoniaElement"
                    name="DTUFoniaElementAssign"
                    outputVariable="DTUFoniaElement"
                    tibex:xpdlId="af8df417-c350-48a9-808e-b655cfe7a4a4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_EspletamentoToDataValidazioneTecnicoGestionale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DTUFoniaElementAssignToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;DTUElement&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:DTUMapping>&#xa;            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/created&quot;>&#xa;                &lt;xsl:sort select=&quot;string(.)&quot;/>&#xa;                &lt;tns3:DTUElement>&#xa;                    &lt;xsl:value-of select=&quot;string(.)&quot;/>&#xa;                &lt;/tns3:DTUElement>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:DTUMapping>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DTUFoniaElement" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+982ce33b-6712-45e6-806f-ca52628f09fb+input&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_DataValidazioneTecnicoGestionale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO_DTU>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_DTU>&#xa;            &lt;ID_RICH_OLO_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_NOW_WHLS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Offerta, &amp;quot;WLR&amp;quot;)&quot;>&#xa;                    &lt;DESCR_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NI_PRENOTAZIONE_NUMERO&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_EVENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_EVENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_DataValidazioneTecnicoGestionale-input"
                    name="JDBC_DataValidazioneTecnicoGestionale"
                    outputVariable="JDBC_DataValidazioneTecnicoGestionale"
                    tibex:xpdlId="982ce33b-6712-45e6-806f-ca52628f09fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToJDBC_DataValidazioneTecnicoGestionale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToSLUMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta, &quot;SLU&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta, "SLU")]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryToULLMapper_ULLULLDatiVULL">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBC_DataValidazioneTecnicoGestionaleToWLRMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta, &quot;WLR&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta, "WLR")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+982ce33b-6712-45e6-806f-ca52628f09fb+input&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_DataValidazioneTecnicoGestionale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO_DTU>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_DTU>&#xa;            &lt;ID_RICH_OLO_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_NOW_WHLS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Offerta, &amp;quot;WLR&amp;quot;)&quot;>&#xa;                    &lt;DESCR_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NI_PRENOTAZIONE_NUMERO&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_EVENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_EVENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DATA_ESITO&#xd;&#xa;&#x9;FROM EVENTO_DTU EDTU, EVENTO_ORDN_NOW_WHLS ENOW, TIPOLG_EVENTO TIPEV&#xd;&#xa;&#x9;WHERE EDTU.IDTPLG_STATO_EVENTO_DTU = '6' AND EDTU.ID_RICH_OLO = ? AND&#xd;&#xa;&#x9;EDTU.ID_EVENTO_ORDN_NOW_WHLS = ENOW.ID_EVENTO_ORDN_NOW_WHLS AND ENOW.ID_RICH_OLO = ?&#xd;&#xa;&#x9;AND ENOW.IDTPLG_EVENTO = TIPEV.IDTPLG_EVENTO AND TIPEV.DESCR_EVENTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_DTU"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_EVENTO"/>
                                    <columnMetadata
                                    columnName="DATA_ESITO"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&lt;xsl:template name=&quot;WLRMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaWLR>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:Espletamento>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/flagNaked&quot;>&lt;tns:FlagLineaBtsNaked>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/flagNaked&quot;/>&lt;/tns:FlagLineaBtsNaked>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/created)) > 0&quot;>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:OrarioDataEspletamento>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OrarioDataEspletamento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&lt;tns:Rifiuto>&lt;tns:TipoCausaleRifiuto>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:TipoCausaleRifiuto>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/tns:Rifiuto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema) > 0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/noteCliente&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/noteCliente&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/tns:DataNotifica)&quot;>&lt;tns:DataEstrazioneWL>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/tns:DataNotifica, 1, 10)&quot;/>&lt;/tns:DataEstrazioneWL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataEstrazioneWL>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEstrazioneWL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/tipologiaLinea)), &amp;quot;POTS&amp;quot;)&quot;>&lt;tns:TipoDn>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:TipoDn>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/tipologiaLinea)),&amp;quot;ISDN&amp;quot;)&quot;>&lt;tns:TipoDn>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:TipoDn>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;PBX&amp;quot;&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRAMULTI&amp;quot; or upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRA MULTI&amp;quot;&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRAMONO&amp;quot; or upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRA MONO&amp;quot;&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;SIMPLEX&amp;quot;&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/tipologiaLinea)), &amp;quot;ISDN&amp;quot;)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BORCHIANT1PLUS&amp;quot;]/valoreAttributo = &amp;quot;W-&amp;quot;&quot;>&lt;tns:BorchiaISDN>&lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&lt;/tns:BorchiaISDN>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BORCHIANT1PLUS&amp;quot;]/valoreAttributo = &amp;quot;W+&amp;quot;&quot;>&lt;tns:BorchiaISDN>&lt;xsl:value-of select=&quot;&amp;quot;B&amp;quot;&quot;/>&lt;/tns:BorchiaISDN>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;STS&amp;quot;])&quot;>&lt;tns:CodiciSTS>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;STS&amp;quot;]&quot;>&lt;tns:CodiceSTS>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICE&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:CodiceSTS>&lt;/xsl:for-each>&lt;/tns:CodiciSTS>&lt;/xsl:if>&lt;/tns:Espletamento>&lt;/tns:NotificaWLR>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="WLRMapper-input" name="WLRMapper"
                    outputVariable="WLRMapper"
                    tibex:xpdlId="74a1768d-e2e5-4c1d-83d8-fbb022f9af91" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_DataValidazioneTecnicoGestionaleToWLRMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&#xa;    &lt;xsl:template name=&quot;WLRMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaWLR>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:Espletamento>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;tns:DN>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:DN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/flagNaked&quot;>&#xa;                        &lt;tns:FlagLineaBtsNaked>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/flagNaked&quot;/>&#xa;                        &lt;/tns:FlagLineaBtsNaked>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/created)) > 0&quot;>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                        &lt;tns:OrarioDataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:OrarioDataEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&#xa;                            &lt;tns:Rifiuto>&#xa;                                &lt;tns:TipoCausaleRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns:TipoCausaleRifiuto>&#xa;                                &lt;tns:CodiceMotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;tns:MotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:MotivoRifiuto>&#xa;                            &lt;/tns:Rifiuto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;/>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/noteCliente&quot;>&#xa;                                        &lt;tns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/noteCliente&quot;/>&#xa;                                        &lt;/tns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/tns:DataNotifica)&quot;>&#xa;                            &lt;tns:DataEstrazioneWL>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/tns:DataNotifica, 1, 10)&quot;/>&#xa;                            &lt;/tns:DataEstrazioneWL>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataEstrazioneWL>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEstrazioneWL>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/tipologiaLinea)), &amp;quot;POTS&amp;quot;)&quot;>&#xa;                            &lt;tns:TipoDn>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoDn>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/tipologiaLinea)),&amp;quot;ISDN&amp;quot;)&quot;>&#xa;                            &lt;tns:TipoDn>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoDn>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;PBX&amp;quot;&quot;>&#xa;                            &lt;tns:TipoLinea>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoLinea>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRAMULTI&amp;quot; or upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRA MULTI&amp;quot;&quot;>&#xa;                            &lt;tns:TipoLinea>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoLinea>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRAMONO&amp;quot; or upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;BRA MONO&amp;quot;&quot;>&#xa;                            &lt;tns:TipoLinea>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoLinea>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)) = &amp;quot;SIMPLEX&amp;quot;&quot;>&#xa;                            &lt;tns:TipoLinea>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoLinea>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:TipoLinea>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoLinea>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/tipologiaLinea)), &amp;quot;ISDN&amp;quot;)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BORCHIANT1PLUS&amp;quot;]/valoreAttributo = &amp;quot;W-&amp;quot;&quot;>&#xa;                                    &lt;tns:BorchiaISDN>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&#xa;                                    &lt;/tns:BorchiaISDN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;BORCHIANT1PLUS&amp;quot;]/valoreAttributo = &amp;quot;W+&amp;quot;&quot;>&#xa;                                    &lt;tns:BorchiaISDN>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;B&amp;quot;&quot;/>&#xa;                                    &lt;/tns:BorchiaISDN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;STS&amp;quot;])&quot;>&#xa;                        &lt;tns:CodiciSTS>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;STS&amp;quot;]&quot;>&#xa;                                &lt;tns:CodiceSTS>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/tns:CodiceSTS>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns:CodiciSTS>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Espletamento>&#xa;            &lt;/tns:NotificaWLR>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:regolatorio="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="regolatorio:NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2fab5b38-ef70-4abd-8708-e4e8b3f7d192+input&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:template name=&quot;Offerta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Offerta-input" name="Offerta"
                    outputVariable="Offerta"
                    tibex:xpdlId="2fab5b38-ef70-4abd-8708-e4e8b3f7d192" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DTUFoniaElementAssignToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2fab5b38-ef70-4abd-8708-e4e8b3f7d192+input&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;Offerta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOC.NOME_OFFERTA_CATLG  FROM OFFERTA NOC , TRASCODFC_OFFERTA TF &#xd;&#xa;WHERE NOC.ID_OFFERTA=TF.ID_OFFERTA AND TF.PROVENIENZA='BPM' AND TF.NOME_OFFERTA_ESTERNA=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_CATLG"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOfferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_Espletamento&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_Espletamento&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Offerta/Record)>0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('SelectOfferta :',tib:render-xml($Offerta,true(),true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;'SelectOfferta: Record non trovato'&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.regolatorio&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;GenericNotification_&amp;quot;,$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;                &lt;tns1:Playload/>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOfferta-input" name="LogOfferta"
                    tibex:xpdlId="b09d61ae-45b3-4eeb-946b-0ddf8c6af539"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToJDBC_DataValidazioneTecnicoGestionale"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOfferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_Espletamento&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_Espletamento&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Offerta/Record)>0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('SelectOfferta :',tib:render-xml($Offerta,true(),true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;'SelectOfferta: Record non trovato'&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.regolatorio&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;GenericNotification_&amp;quot;,$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;                &lt;tns1:Playload/>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
