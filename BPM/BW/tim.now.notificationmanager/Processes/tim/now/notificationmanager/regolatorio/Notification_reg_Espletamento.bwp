            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:template name=&quot;ULLMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaULL>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:Espletamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo)>0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo='TLC' and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0 &quot;>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/IDRisorsa&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/created)) > 0&quot;>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:OrarioDataEspletamento>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OrarioDataEspletamento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema) > 0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/noteCliente&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/noteCliente&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&lt;tns:Rifiuto>&lt;tns:TipoCausaleRifiuto>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:TipoCausaleRifiuto>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/tns:Rifiuto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE1&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:PosizionePermutatore1>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE1&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:PosizionePermutatore1>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE2&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:PosizionePermutatore2>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE2&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:PosizionePermutatore2>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:EsecPermutaArmadio>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:EsecPermutaArmadio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:EsecPermutaArmadio>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:EsecPermutaArmadio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo != &amp;quot;A&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo != &amp;quot;M&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot;]/valoreAttributo != &amp;quot;P&amp;quot;&quot;>&lt;tns:TipoCessazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE AMMINISTRATIVA&amp;quot;&quot;/>&lt;/tns:TipoCessazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TipoCessazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE TECNICA&amp;quot;&quot;/>&lt;/tns:TipoCessazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot; and (string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0 or string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULLDATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0  )&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;>&lt;tns:IDRisorsaOLD>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;/>&lt;/tns:IDRisorsaOLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULLDATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;>&lt;tns:IDRisorsaOLD>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULLDATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;/>&lt;/tns:IDRisorsaOLD>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(count($Offerta/Record)>0 or exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo))  and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Offerta/Record)>0&quot;>&lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='SLULINEAATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'SLULineaAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='SLULINEAATTIVANP'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'SLULineaAttivaNP'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='SLULINEANONATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'SLULineaNonAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLLINEANONATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLLineaNonAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLLINEAATTIVANP'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLLineaAttivaNP'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLLINEAATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLLineaAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLDATILINEANONATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLDatiLineaNonAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLDATILINEAATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLDatiLineaAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLDATILINEAATTIVANP'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLDatiLineaAttivaNP'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&lt;tns:ServiziOpzionali>&lt;tns:CodiceServizio>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&lt;/tns:CodiceServizio>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;>&lt;tns:Esito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;/>&lt;/tns:Esito>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;>&lt;tns:CausaleEsito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;/>&lt;/tns:CausaleEsito>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;>&lt;tns:DescrizioneEsito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;/>&lt;/tns:DescrizioneEsito>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/tns:ServiziOpzionali>&lt;/xsl:for-each>&lt;/tns:Espletamento>&lt;/tns:NotificaULL>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ULLMapper-input" name="ULLMapper"
                    outputVariable="ULLMapper"
                    tibex:xpdlId="a0aa3b4f-8571-49a9-9aa1-bc05893bbb8c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToULLMapper_ULLULLDatiVULL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:template name=&quot;ULLMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaULL>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:Espletamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo='TLC' and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0 &quot;>&#xa;                            &lt;tns:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:IdRisorsa>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/IDRisorsa&quot;/>&#xa;                            &lt;/tns:IdRisorsa>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/created)) > 0&quot;>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                        &lt;tns:OrarioDataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:OrarioDataEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;/>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/noteCliente&quot;>&#xa;                                        &lt;tns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/noteCliente&quot;/>&#xa;                                        &lt;/tns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&#xa;                            &lt;tns:Rifiuto>&#xa;                                &lt;tns:TipoCausaleRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns:TipoCausaleRifiuto>&#xa;                                &lt;tns:CodiceMotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;tns:MotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:MotivoRifiuto>&#xa;                            &lt;/tns:Rifiuto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE1&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                        &lt;tns:PosizionePermutatore1>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE1&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:PosizionePermutatore1>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE2&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                        &lt;tns:PosizionePermutatore2>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEPERMUTATORE2&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:PosizionePermutatore2>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:EsecPermutaArmadio>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PERMUTAARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                            &lt;/tns:EsecPermutaArmadio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:EsecPermutaArmadio>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns:EsecPermutaArmadio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo != &amp;quot;A&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo != &amp;quot;M&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOCESSAZIONE&amp;quot;]/valoreAttributo != &amp;quot;P&amp;quot;&quot;>&#xa;                                    &lt;tns:TipoCessazione>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE AMMINISTRATIVA&amp;quot;&quot;/>&#xa;                                    &lt;/tns:TipoCessazione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:TipoCessazione>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE TECNICA&amp;quot;&quot;/>&#xa;                                    &lt;/tns:TipoCessazione>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot; and (string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0 or string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULLDATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0  )&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;>&#xa;                                        &lt;tns:IDRisorsaOLD>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULL']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns:IDRisorsaOLD>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULLDATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;>&#xa;                                        &lt;tns:IDRisorsaOLD>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente= 'ACCESSOULLDATI']/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns:IDRisorsaOLD>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(count($Offerta/Record)>0 or exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo))  and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($Offerta/Record)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                                        &lt;tns:ServizioOLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                                        &lt;/tns:ServizioOLD>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='SLULINEAATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'SLULineaAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='SLULINEAATTIVANP'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'SLULineaAttivaNP'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='SLULINEANONATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'SLULineaNonAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLLINEANONATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLLineaNonAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLLINEAATTIVANP'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLLineaAttivaNP'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLLINEAATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLLineaAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLDATILINEANONATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLDatiLineaNonAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLDATILINEAATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLDatiLineaAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/&amp;#xD;&amp;#xA;attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo)='ULLDATILINEAATTIVANP'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLDatiLineaAttivaNP'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&#xa;                        &lt;tns:ServiziOpzionali>&#xa;                            &lt;tns:CodiceServizio>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:CodiceServizio>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:Esito>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:Esito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:CausaleEsito>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:CausaleEsito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:DescrizioneEsito>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:DescrizioneEsito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:ServiziOpzionali>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:Espletamento>&#xa;            &lt;/tns:NotificaULL>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:regolatorio="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="regolatorio:NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:template name=&quot;SLUMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaSLU>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:Espletamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo)>0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo='TLC' and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/IDRisorsa&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/created)) > 0&quot;>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:OrarioDataEspletamento>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OrarioDataEspletamento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema) > 0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/notedaSistema&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;/>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/noteCliente&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/noteCliente&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&lt;tns:Rifiuto>&lt;tns:TipoCausaleRifiuto>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:TipoCausaleRifiuto>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/tns:Rifiuto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo !=$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo !=$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='RIPROGETTAZIONEONFIELD']/valoreAttributo)>0 and upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='RIPROGETTAZIONEONFIELD']/valoreAttributo)='S'&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:IdArlTI>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:IdArlTI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDARLTI&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:IdArlTI>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDARLTI&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:IdArlTI>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOSLU&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEARLTI1&amp;quot;]/valoreAttributo&quot;>&lt;tns:PosizioneARLTI1>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOSLU&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEARLTI1&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:PosizioneARLTI1>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOSLU&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEARLTI2&amp;quot;]/valoreAttributo&quot;>&lt;tns:PosizioneARLTI2>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOSLU&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEARLTI2&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:PosizioneARLTI2>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(count($Offerta/Record)>0 or exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)) and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Offerta/Record)>0&quot;>&lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='SLULINEAATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'SLULineaAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='SLULINEAATTIVANP'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'SLULineaAttivaNP'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='SLULINEANONATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'SLULineaNonAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLLINEANONATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLLineaNonAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLLINEAATTIVANP'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLLineaAttivaNP'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLLINEAATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLLineaAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLDATILINEANONATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLDatiLineaNonAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLDATILINEAATTIVA'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLDatiLineaAttiva'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLDATILINEAATTIVANP'&quot;>&lt;tns:ServizioOLD>&lt;xsl:value-of select=&quot;'ULLDatiLineaAttivaNP'&quot;/>&lt;/tns:ServizioOLD>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot; and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;>&lt;tns:IDRisorsaOLD>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;/>&lt;/tns:IDRisorsaOLD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&lt;tns:ServiziOpzionali>&lt;tns:CodiceServizio>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&lt;/tns:CodiceServizio>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;>&lt;tns:Esito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;/>&lt;/tns:Esito>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;>&lt;tns:CausaleEsito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;/>&lt;/tns:CausaleEsito>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;>&lt;tns:DescrizioneEsito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;/>&lt;/tns:DescrizioneEsito>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/tns:ServiziOpzionali>&lt;/xsl:for-each>&lt;/tns:Espletamento>&lt;/tns:NotificaSLU>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SLUMapper-input" name="SLUMapper"
                    outputVariable="SLUMapper"
                    tibex:xpdlId="858dce73-5675-49fb-80dc-a593889eebaa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToSLUMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:template name=&quot;SLUMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaSLU>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:Espletamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo='TLC' and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo)>0&quot;>&#xa;                            &lt;tns:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA' and azione='D']/attributiDettaglioOrdine[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:IdRisorsa>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/IDRisorsa&quot;/>&#xa;                            &lt;/tns:IdRisorsa>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/created)) > 0&quot;>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                        &lt;tns:OrarioDataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:OrarioDataEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;/>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/noteCliente&quot;>&#xa;                                        &lt;tns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/noteCliente&quot;/>&#xa;                                        &lt;/tns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&#xa;                            &lt;tns:Rifiuto>&#xa;                                &lt;tns:TipoCausaleRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns:TipoCausaleRifiuto>&#xa;                                &lt;tns:CodiceMotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;tns:MotivoRifiuto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/tns:MotivoRifiuto>&#xa;                            &lt;/tns:Rifiuto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo !=$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo !=$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='RIPROGETTAZIONEONFIELD']/valoreAttributo)>0 and upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='RIPROGETTAZIONEONFIELD']/valoreAttributo)='S'&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                                &lt;tns:IdArlTI>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEARMADIO&amp;quot; and string(created) = $DTUFoniaElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                                &lt;/tns:IdArlTI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attri