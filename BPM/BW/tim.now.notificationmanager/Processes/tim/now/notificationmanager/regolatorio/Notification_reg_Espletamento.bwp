                          &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLDATILINEAATTIVANP'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLDatiLineaAttivaNP'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;>&#xa;                                &lt;tns:IDRisorsaOLD>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDRISORSAOLD']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:IDRisorsaOLD>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&#xa;                        &lt;tns:ServiziOpzionali>&#xa;                            &lt;tns:CodiceServizio>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:CodiceServizio>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:Esito>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:Esito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:CausaleEsito>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:CausaleEsito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:DescrizioneEsito>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:DescrizioneEsito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:ServiziOpzionali>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns:Espletamento>&#xa;            &lt;/tns:NotificaSLU>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
