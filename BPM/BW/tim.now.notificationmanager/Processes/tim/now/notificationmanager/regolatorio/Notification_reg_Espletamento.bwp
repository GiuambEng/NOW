LU&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONEARLTI2&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:PosizioneARLTI2>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(count($Offerta/Record)>0 or exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)) and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione='ATTIVAZIONE' and  $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/tipologiaSottolav='CAMBIOTECNOLOGIA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaNotifica = &amp;quot;OK&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($Offerta/Record)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;>&#xa;                                        &lt;tns:ServizioOLD>&#xa;                                            &lt;xsl:value-of select=&quot;$Offerta/Record[1]/NOME_OFFERTA_CATLG&quot;/>&#xa;                                        &lt;/tns:ServizioOLD>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='SLULINEAATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'SLULineaAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='SLULINEAATTIVANP'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'SLULineaAttivaNP'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='SLULINEANONATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'SLULineaNonAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']&amp;#xD;&amp;#xA;/valoreAttributo)='ULLLINEANONATTIVA'&quot;>&#xa;                                    &lt;tns:ServizioOLD>&#xa;                                        &lt;xsl:value-of select=&quot;'ULLLineaNonAttiva'&quot;/>&#xa;                                    &lt;/tns:ServizioOLD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZAFONIA']/attributiDettaglioOrdine[nomeAttri