                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TestataNotifica/tns2:TestataRegolatorio/tns3:StatoOrdine != &quot;3&quot; and string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDAnagraficaCausale)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TestataNotifica/tns2:TestataRegolatorio/tns3:StatoOrdine != "3" and string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDAnagraficaCausale)) > 0]]></bpws:transitionCondition>
