            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&lt;xsl:param name=&quot;DTUFonia&quot;/>&lt;xsl:param name=&quot;IDANAG_CAUSALE&quot;/>&lt;xsl:template name=&quot;MapperCPS-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaCPS>&lt;tns:EsitoEspletamento>&lt;tns:CodiceFornitore>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns:CodiceFornitore>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineTI)>0&quot;>&lt;tns:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineTI&quot;/>&lt;/tns:CodiceOrdineFornitore>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codiceOrdineTI&quot;/>&lt;/tns:CodiceOrdineFornitore>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CodiceRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns:CodiceRichiedente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineOLO)>0&quot;>&lt;tns:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineRichiedente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineRichiedente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns:DataNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='ESPLETAMENTOTECNICO' or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='CHIUSO' or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='INVIATOAFATTURAZIONE' or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='FATTURAZIONEKO'&quot;>&lt;tns:StatoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&lt;/tns:StatoOrdine>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='ESPLETAMENTOTECNICOKO' or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaOLO='SCARTATO'&quot;>&lt;tns:StatoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&lt;/tns:StatoOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:StatoOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/DRO)&quot;>&lt;tns:DataDRO>&lt;xsl:value-of select=&quot;format-date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/DRO , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataDRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataDRO>&lt;xsl:value-of select=&quot;format-date(current-date() , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataDRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/tns:DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBC_DataValidazioneTecnicoGestionale/Record)>0&quot;>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DES)&quot;>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-dateTime(xsd:dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DES), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:OrarioDataEspletamento>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OrarioDataEspletamento>&lt;/xsl:if>&lt;xsl:if test=&quot;count($IDANAG_CAUSALE/Record)>0&quot;>&lt;tns:Rifiuto>&lt;tns:TipoCausaleRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/TIPO_CAUSALE_RIF_CPS&quot;/>&lt;/tns:TipoCausaleRifiuto>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/tns:Rifiuto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:EsitoEspletamento>&lt;/tns:NotificaCPS>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperCPS-input" name="MapperCPS"
                    outputVariable="MapperCPS"
                    tibex:xpdlId="e1a5c798-2881-4eb5-b069-c0c60f4fae05" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperCPSToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUFonia&quot;/>&#xa;    &lt;xsl:param name=&quot;IDANAG_CAUSALE&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperCPS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaCPS>&#xa;                &lt;tns:EsitoEspletamento>&#xa;                    &lt;tns:CodiceFornitore>&#xa;                        &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                    &lt;/tns:CodiceFornitore>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI)>0&quot;>&#xa;                            &lt;tns:CodiceOrdineFornitore>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;/>&#xa;                            &lt;/tns:CodiceOrdineFornitore>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceOrdineFornitore>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/codiceOrdineTI&quot;/>&#xa;                            &lt;/tns:CodiceOrdineFornitore>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:CodiceRichiedente>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodiceRichiedente>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO)>0&quot;>&#xa;                            &lt;tns:CodiceOrdineRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                            &lt;/tns:CodiceOrdineRichiedente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodiceOrdineRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/codiceOrdineOLO&quot;/>&#xa;                            &lt;/tns:CodiceOrdineRichiedente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:DataNotifica>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataNotifica>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='ESPLETAMENTOTECNICO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='CHIUSO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='INVIATOAFATTURAZIONE' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='FATTURAZIONEKO'&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='ESPLETAMENTOTECNICOKO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO='SCARTATO'&quot;>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:StatoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns:StatoOrdine>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/DRO)&quot;>&#xa;                            &lt;tns:DataDRO>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/DRO , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataDRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataDRO>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date() , &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataDRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($JDBC_DataValidazioneTecnicoGestionale/Record)>0&quot;>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES)&quot;>&#xa;                                    &lt;tns:DataEspletamento>&#xa;                                        &lt;xsl:value-of select=&quot;format-dateTime(xsd:dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:DataEspletamento>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DataEspletamento>&#xa;                                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:DataEspletamento>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                        &lt;tns:OrarioDataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFonia/tns1:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:OrarioDataEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;count($IDANAG_CAUSALE/Record)>0&quot;>&#xa;                        &lt;tns:Rifiuto>&#xa;                            &lt;tns:TipoCausaleRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/TIPO_CAUSALE_RIF_CPS&quot;/>&#xa;                            &lt;/tns:TipoCausaleRifiuto>&#xa;                            &lt;tns:CodiceMotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                            &lt;/tns:CodiceMotivoRifiuto>&#xa;                            &lt;tns:MotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                            &lt;/tns:MotivoRifiuto>&#xa;                        &lt;/tns:Rifiuto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:EsitoEspletamento>&#xa;            &lt;/tns:NotificaCPS>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:regolatorio="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="regolatorio:NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0e489fcd-b335-4959-aa38-ca705fafe68c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO_DTU>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO_DTU>&lt;ID_RICH_OLO_NOW_WHLS>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO_NOW_WHLS>&lt;DESCR_EVENTO>&lt;xsl:value-of select=&quot;&amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;&quot;/>&lt;/DESCR_EVENTO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_DataValidazioneTecnicoGestionale-input"
                    name="JDBC_DataValidazioneTecnicoGestionale"
                    outputVariable="JDBC_DataValidazioneTecnicoGestionale"
                    tibex:xpdlId="0e489fcd-b335-4959-aa38-ca705fafe68c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartcps_EsitoEspletamentoToJDBCQuery"/>
                        <bpws:target linkName="GenericLoggerToJDBC_DataValidazioneTecnicoGestionale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_DataValidazioneTecnicoGestionaleToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0e489fcd-b335-4959-aa38-ca705fafe68c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO_DTU>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_DTU>&#xa;            &lt;ID_RICH_OLO_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_NOW_WHLS>&#xa;            &lt;DESCR_EVENTO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;&quot;/>&#xa;            &lt;/DESCR_EVENTO>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DATA_ESITO&#xa;&#x9;FROM EVENTO_DTU EDTU, EVENTO_ORDN_NOW_WHLS ENOW, TIPOLG_EVENTO TIPEV&#xa;&#x9;WHERE EDTU.IDTPLG_STATO_EVENTO_DTU = '6' AND EDTU.ID_RICH_OLO = ? AND&#xa;&#x9;EDTU.ID_EVENTO_ORDN_NOW_WHLS = ENOW.ID_EVENTO_ORDN_NOW_WHLS AND ENOW.ID_RICH_OLO = ?&#xa;&#x9;AND ENOW.IDTPLG_EVENTO = TIPEV.IDTPLG_EVENTO AND TIPEV.DESCR_EVENTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_DTU"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_EVENTO"/>
                                    <columnMetadata
                                    columnName="DATA_ESITO"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:template name=&quot;DTUFonia&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DTUMapping>&#xa;            &lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/created&quot;>&#xa;                &lt;xsl:sort select=&quot;string(.)&quot;/>&#xa;                &lt;tns:DTUElement>&#xa;                    &lt;xsl:value-of select=&quot;string(.)&quot;/>&#xa;                &lt;/tns:DTUElement>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:DTUMapping>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DTUFonia" name="DTUElement"
                    outputVariable="DTUFonia"
