                                    sqlStatement="SELECT AC.COD_CAUS_OLO, AC.DESCR_CAUS_OLO,TP.TIPO_CAUSALE_RIF_CPS&#xa;  FROM ANAG_CAUS AC,TIPOLG_CAUSALE_RIFIUTO_CPS TP&#xa;  WHERE TP.ID_TIPO_CAUS_RIF_CPS=AC.ID_TIPO_CAUS_RIF_CPS AND AC.ID_ANAG_CAUS =?" xsi:type="jdbcPalette:JDBCQueryActivity">
