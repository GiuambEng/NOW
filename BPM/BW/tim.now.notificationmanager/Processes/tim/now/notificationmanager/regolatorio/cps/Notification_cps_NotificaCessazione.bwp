                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;IDANAG_CAUSALE&quot;/>&lt;xsl:param name=&quot;Trascodifica&quot;/>&lt;xsl:param name=&quot;Referente&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;ANAG_CAUSALE&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:template name=&quot;MapperCPS_NotificaCessazione-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaCPS>&lt;tns:NotificaCessazione>&lt;tns:CodiceFornitore>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns:CodiceFornitore>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns:DataNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo)>0 and ($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo='05' or $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo='06' or $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo='08') and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione='CESSAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COUNT=0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDRisorsa&quot;/>&lt;/tns:DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataSottoscrizioneContratto>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DSC']/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataSottoscrizioneContratto>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-dateTime(xsd:dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/DES), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;xsl:if test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione='ATTIVAZIONE' or $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/lavorazione='CESSAZIONE') and (exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente) or count($Referente/Record)>0) and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/canaleRichiesta!='INTERNAL' and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/canaleRichiesta!='SDR'&quot;>&lt;tns:Referente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/nomeReferente)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/nomeReferente&quot;>&lt;tns:NomeReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/nomeReferente&quot;/>&lt;/tns:NomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Referente/Record[NOME='NOMEREFERENTE'])&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='NOMEREFERENTE'][1]/VALORE&quot;>&lt;tns:NomeReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='NOMEREFERENTE'][1]/VALORE&quot;/>&lt;/tns:NomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Referente/Record[NOME='COGNOMEREFERENTE'])&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='COGNOMEREFERENTE'][1]/VALORE&quot;>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='COGNOMEREFERENTE'][1]/VALORE&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Referente/Record[NOME='INDIRIZZOREFERENTE'])&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='INDIRIZZOREFERENTE'][1]/VALORE&quot;>&lt;tns:IndirizzoReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='INDIRIZZOREFERENTE'][1]/VALORE&quot;/>&lt;/tns:IndirizzoReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente)>0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/offerta = 'CPS'&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Referente/Record[NOME='TELEFONOFISSOREFERENTE']) and $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/offerta = 'CPS'&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='TELEFONOFISSOREFERENTE'][1]/VALORE&quot;>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='TELEFONOFISSOREFERENTE'][1]/VALORE&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Referente/Record[NOME='FAXREFERENTE'])&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='FAXREFERENTE'][1]/VALORE&quot;>&lt;tns:FaxReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='FAXREFERENTE'][1]/VALORE&quot;/>&lt;/tns:FaxReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/emailReferente)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/emailReferente&quot;>&lt;tns:EmailReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/emailReferente&quot;/>&lt;/tns:EmailReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Referente/Record[NOME='EMAILREFERENTE'])&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='EMAILREFERENTE'][1]/VALORE&quot;>&lt;tns:EmailReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='EMAILREFERENTE'][1]/VALORE&quot;/>&lt;/tns:EmailReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($Referente/Record[NOME='CAPREFERENTE'])&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='CAPREFERENTE'][1]/VALORE&quot;>&lt;tns:CapReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='CAPREFERENTE'][1]/VALORE&quot;/>&lt;/tns:CapReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Referente/Record[NOME='CODICECOMUNEREFERENTE'])&quot;>&lt;xsl:if test=&quot;$Referente/Record[NOME='CODICECOMUNEREFERENTE'][1]/VALORE&quot;>&lt;tns:CodiceComuneReferente>&lt;xsl:value-of select=&quot;$Referente/Record[NOME='CODICECOMUNEREFERENTE'][1]/VALORE&quot;/>&lt;/tns:CodiceComuneReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:Referente>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario='DONATING'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery1/Record)>0&quot;>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$Trascodifica/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO)>0&quot;>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$ANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TipologiaOLODestinatario='DONATING'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery1/Record)>0&quot;>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$Trascodifica/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO)>0&quot;>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$ANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:NotificaCessazione>&lt;/tns:NotificaCPS>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperCPS_NotificaCessazione-input"
                    name="MapperCPS_NotificaCessazione"
                    outputVariable="MapperCPS_NotificaCessazione"
                    tibex:xpdlId="794e5a10-eb8a-42b8-805a-2c6a2d360da5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToMapperCPS_NotificaCessazione"/>
                        <bpws:target linkName="EmptyToMapperCPS_NotificaCessazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;IDANAG_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;Trascodifica&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;ANAG_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperCPS_NotificaCessazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaCPS>&#xa;                &lt;tns:NotificaCessazione>&#xa;                    &lt;tns:CodiceFornitore>&#xa;                        &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                    &lt;/tns:CodiceFornitore>&#xa;                    &lt;tns:DataNotifica>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataNotifica>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo)>0 and ($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo='05' or $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo='06' or $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSO']/attributiDettaglioOrdine[nomeAttributo='SOTTOLAVORAZIONESDR']/valoreAttributo='08') and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COUNT=0&quot;>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='ACCESSOCPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo)>0&quot;>&#xa;                            &lt;tns:DN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='IDRISORSA']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DN>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/tns:DN>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:DataSottoscrizioneContratto>&#xa;                        &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='CONSISTENZACPS']/attributiDettaglioOrdine[nomeAttributo='DSC']/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataSottoscrizioneContratto>&#xa;                    &lt;tns:DataEspletamento>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(xsd:dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/DES), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataEspletamento>&#xa;                    &lt;xsl:if test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione='ATTIVAZIONE' or $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/lavorazione='CESSAZIONE') and (exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente) or count($Referente/Record)>0) and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/canaleRichiesta!='INTERNAL' and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/canaleRichiesta!='SDR'&quot;>&#xa;                        &lt;tns:Referente>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/nomeReferente)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/nomeReferente&quot;>&#xa;                                        &lt;tns:NomeReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/nomeReferente&quot;/>&#xa;                                        &lt;/tns:NomeReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Referente/Record[NOME='NOMEREFERENTE'])&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Referente/Record[NOME='NOMEREFERENTE'][1]/VALORE&quot;>&#xa;                                        &lt;tns:NomeReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$Referente/Record[NOME='NOMEREFERENTE'][1]/VALORE&quot;/>&#xa;                                        &lt;/tns:NomeReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;>&#xa;                                        &lt;tns:CognomeReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&#xa;                                        &lt;/tns:CognomeReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Referente/Record[NOME='COGNOMEREFERENTE'])&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Referente/Record[NOME='COGNOMEREFERENTE'][1]/VALORE&quot;>&#xa;                                        &lt;tns:CognomeReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$Referente/Record[NOME='COGNOMEREFERENTE'][1]/VALORE&quot;/>&#xa;                                        &lt;/tns:CognomeReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists($Referente/Record[NOME='INDIRIZZOREFERENTE'])&quot;>&#xa;                                &lt;xsl:if test=&quot;$Referente/Record[NOME='INDIRIZZOREFERENTE'][1]/VALORE&quot;>&#xa;                                    &lt;tns:IndirizzoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Referente/Record[NOME='INDIRIZZOREFERENTE'][1]/VALORE&quot;/>&#xa;                                    &lt;/tns:IndirizzoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/offerta = 'CPS'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;>&#xa;                                        &lt;tns:TelefonoFissoReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&#xa;                                        &lt;/tns:TelefonoFissoReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Referente/Record[NOME='TELEFONOFISSOREFERENTE']) and $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/offerta = 'CPS'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Referente/Record[NOME='TELEFONOFISSOREFERENTE'][1]/VALORE&quot;>&#xa;                                        &lt;tns:TelefonoFissoReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$Referente/Record[NOME='TELEFONOFISSOREFERENTE'][1]/VALORE&quot;/>&#xa;                                        &lt;/tns:TelefonoFissoReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists($Referente/Record[NOME='FAXREFERENTE'])&quot;>&#xa;                                &lt;xsl:if test=&quot;$Referente/Record[NOME='FAXREFERENTE'][1]/VALORE&quot;>&#xa;                                    &lt;tns:FaxReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Referente/Record[NOME='FAXREFERENTE'][1]/VALORE&quot;/>&#xa;                                    &lt;/tns:FaxReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/emailReferente)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/emailReferente&quot;>&#xa;                                        &lt;tns:EmailReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/emailReferente&quot;/>&#xa;                                        &lt;/tns:EmailReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($Referente/Record[NOME='EMAILREFERENTE'])&quot;>&#xa;                                    &lt;xsl:if test=&quot;$Referente/Record[NOME='EMAILREFERENTE'][1]/VALORE&quot;>&#xa;                                        &lt;tns:EmailReferente>&#xa;                                            &lt;xsl:value-of select=&quot;$Referente/Record[NOME='EMAILREFERENTE'][1]/VALORE&quot;/>&#xa;                                        &lt;/tns:EmailReferente>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;exists($Referente/Record[NOME='CAPREFERENTE'])&quot;>&#xa;                                &lt;xsl:if test=&quot;$Referente/Record[NOME='CAPREFERENTE'][1]/VALORE&quot;>&#xa;                                    &lt;tns:CapReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Referente/Record[NOME='CAPREFERENTE'][1]/VALORE&quot;/>&#xa;                                    &lt;/tns:CapReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($Referente/Record[NOME='CODICECOMUNEREFERENTE'])&quot;>&#xa;                                &lt;xsl:if test=&quot;$Referente/Record[NOME='CODICECOMUNEREFERENTE'][1]/VALORE&quot;>&#xa;                                    &lt;tns:CodiceComuneReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Referente/Record[NOME='CODICECOMUNEREFERENTE'][1]/VALORE&quot;/>&#xa;                                    &lt;/tns:CodiceComuneReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:Referente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario='DONATING'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($JDBCQuery1/Record)>0&quot;>&#xa;                                    &lt;tns:CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$Trascodifica/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO)>0&quot;>&#xa;                                    &lt;tns:CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$ANAG_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:CodiceMotivoRifiuto>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TipologiaOLODestinatario='DONATING'&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($JDBCQuery1/Record)>0&quot;>&#xa;                                    &lt;tns:MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:MotivoRifiuto>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$Trascodifica/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:MotivoRifiuto>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO)>0&quot;>&#xa;                                    &lt;tns:MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$IDANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:MotivoRifiuto>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$ANAG_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                    &lt;/tns:MotivoRifiuto>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:NotificaCessazione>&#xa;            &lt;/tns:NotificaCPS>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:regolatorio="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="regolatorio:NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;MapperCPS_NotificaCessazione&quot;/>&lt;xsl:template name=&quot;LogMapperCPS_NotificaCessazione-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Notification_cps_NotificaCessazione&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Notification_cps_NotificaCessazione&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('MapperCPS_NotificaCessazione',tib:render-xml($MapperCPS_NotificaCessazione, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogMapperCPS_NotificaCessazione-input"
                    name="LogMapperCPS_NotificaCessazione"
                    tibex:xpdlId="b2707788-9240-47f0-a516-e9192bd38f34"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEndNotification_cps_NotificaCessazione"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperCPS_NotificaCessazione&quot;/>&#xa;    &lt;xsl:template name=&quot;LogMapperCPS_NotificaCessazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_cps_NotificaCessazione&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_cps_NotificaCessazione&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('MapperCPS_NotificaCessazione',tib:render-xml($MapperCPS_No