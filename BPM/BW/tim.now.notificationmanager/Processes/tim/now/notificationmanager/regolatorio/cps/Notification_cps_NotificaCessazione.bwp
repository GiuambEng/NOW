                                expression="$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:TipologiaOLODestinatario='DONATING'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
