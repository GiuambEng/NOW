            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8a2b1ab8-f42c-40ca-9071-e0953c645b91+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;Trascodifica-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;SOTTO_LAVRZ>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/tipologiaSottolav)&quot;>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/tipologiaSottolav&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SOTTO_LAVRZ>&lt;LAVRZ>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/lavorazione)&quot;>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/LAVRZ>&lt;ID_OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDOfferta)&quot;>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDOfferta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_OFFERTA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Trascodifica-input"
                    name="Trascodifica" outputVariable="Trascodifica"
                    tibex:xpdlId="8a2b1ab8-f42c-40ca-9071-e0953c645b91" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToTrascodifica"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TrascodificaToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8a2b1ab8-f42c-40ca-9071-e0953c645b91+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;Trascodifica-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;SOTTO_LAVRZ>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/tipologiaSottolav)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/tipologiaSottolav&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/SOTTO_LAVRZ>&#xa;            &lt;LAVRZ>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LAVRZ>&#xa;            &lt;ID_OFFERTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDOfferta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDOfferta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_OFFERTA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT AC.COD_CAUS_OLO, AC.DESCR_CAUS_OLO FROM  ANAG_CAUS AC WHERE &#xa;AC.COD_CAUS_INTERNO=(SELECT COD_CAUS_DESTNRIO FROM TRASCODFC_COD_CAUS_DEST  WHERE SOTTO_LAVRZ=? AND LAVRZ=? AND&#xa;STRUTTURA_RICH='REGOLATORIO' AND ID_SISTEMA='NOW' AND  ATTR='ID_ANAG_CAUS' AND ID_OFFERTA=?)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SOTTO_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LAVRZ"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_OFFERTA"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
