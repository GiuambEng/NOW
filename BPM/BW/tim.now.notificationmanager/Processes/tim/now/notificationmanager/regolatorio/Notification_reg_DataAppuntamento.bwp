                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUElement&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectEVENTO&quot;/>&#xa;    &lt;xsl:template name=&quot;SLUMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaSLU>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:DataAppuntamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo, 1, 2)&quot;/>&#xa;                            &lt;/tns:OraAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:OraAppuntamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente, 'dk')&quot;>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente, 'dk')&quot;>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/nomeReferente)&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:ReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                            &lt;/tns:ReferenteContattato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) = 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&#xa;                                            &lt;tns:TelefonoReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&#xa;                                            &lt;/tns:TelefonoReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:TelefonoReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&#xa;                                            &lt;/tns:TelefonoReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&#xa;                                    &lt;tns:TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoReferenteContattato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:TelefonoReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&#xa;                            &lt;/tns:TelefonoReferenteContattato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataContatto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                            &lt;/tns:OraContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]:[m01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:OraContatto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)>0 and upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)='SU'&quot;>&#xa;                            &lt;tns:TipoAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$SelectCAUS_ESITO/Record[1]/CAUS_ESITO='021' and count($SelectEVENTO/Record)>0&quot;>&#xa;                            &lt;tns:TipoAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente,'dk')&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;>&#xa;                                &lt;tns:Progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;/>&#xa;                                &lt;/tns:Progressivo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente,'dk')&quot;>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&#xa;                                    &lt;tns:Progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&#xa;                                    &lt;/tns:Progressivo>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:DataAppuntamento>&#xa;            &lt;/tns:NotificaSLU>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:regolatorio="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="regolatorio:NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;LOG_DataAppuntamento-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in input:&amp;#xA;&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaNotifica, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;Offerta:&amp;#xA;&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_DataAppuntamento-input"
                    name="LOG_DataAppuntamento"
                    tibex:xpdlId="2226f54d-2ad6-468b-9309-42afea9ccc95"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericNotificationInToLOG_DataAppuntamento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_IDEvento">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:IDEventoOrdineNOW)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:IDEventoOrdineNOW)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_DataAppuntamentoToDTUElementAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_DataAppuntamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in input:&amp;#xA;&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;Offerta:&amp;#xA;&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;DTUElement&quot; match=&quot;/&quot;>&lt;tns:DTUMapping>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/created&quot;>&lt;xsl:sort select=&quot;string(.)&quot;/>&lt;tns:DTUElement>&lt;xsl:value-of select=&quot;string(.)&quot;/>&lt;/tns:DTUElement>&lt;/xsl:for-each>&lt;/tns:DTUMapping>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DTUElement" name="DTUElementAssign"
                    outputVariable="DTUElement"
                    tibex:xpdlId="c4f83879-767a-44e7-8b0c-fe2a089dea13" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToDTUElementAssign"/>
                        <bpws:target linkName="LOG_DataAppuntamentoToDTUElementAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToSLUMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta, &quot;SLU&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta, "SLU")]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToULLMapper_ULLULLDatiVULL">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
