                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;DTUElement&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DTUMapping>&#xa;            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/created&quot;>&#xa;                &lt;xsl:sort select=&quot;string(.)&quot;/>&#xa;                &lt;tns:DTUElement>&#xa;                    &lt;xsl:value-of select=&quot;string(.)&quot;/>&#xa;                &lt;/tns:DTUElement>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:DTUMapping>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="DTUElement" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;DTUElement&quot;/>&lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&lt;xsl:param name=&quot;SelectEVENTO&quot;/>&lt;xsl:template name=&quot;WLRMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaWLR>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:DataAppuntamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:NuovaDA>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NuovaDA>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:OraAppuntamento>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo, 1, 2)&quot;/>&lt;/tns:OraAppuntamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OraAppuntamento>&lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&lt;/tns:OraAppuntamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, 'dk')&quot;>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/cognomeReferente, 'dk')&quot;>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/nomeReferente)&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) = 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataContatto>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContatto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataContatto>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContatto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:OraContatto>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OraContatto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OraContatto>&lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]:[m01]&amp;quot;)&quot;/>&lt;/tns:OraContatto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$SelectCAUS_ESITO/Record[1]/CAUS_ESITO='021' and count($SelectEVENTO/Record)>0&quot;>&lt;tns:TipoAppuntamento>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:TipoAppuntamento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente,'dk')&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente,'dk')&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:DataAppuntamento>&lt;/tns:NotificaWLR>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="WLRMapper-input" name="WLRMapper"
                    outputVariable="WLRMapper"
                    tibex:xpdlId="e42d643e-d2e4-4246-a797-ba66c2f8e501" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DTUElementAssignToMapper_WLR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUElement&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectEVENTO&quot;/>&#xa;    &lt;xsl:template name=&quot;WLRMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaWLR>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:DataAppuntamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo, 1, 2)&quot;/>&#xa;                            &lt;/tns:OraAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:OraAppuntamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, 'dk')&quot;>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/cognomeReferente, 'dk')&quot;>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/nomeReferente)&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:ReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                            &lt;/tns:ReferenteContattato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) = 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&#xa;                                            &lt;tns:TelefonoReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&#xa;                                            &lt;/tns:TelefonoReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:TelefonoReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&#xa;                                            &lt;/tns:TelefonoReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&#xa;                                    &lt;tns:TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoReferenteContattato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:TelefonoReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&#xa;                            &lt;/tns:TelefonoReferenteContattato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataContatto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                            &lt;/tns:OraContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]:[m01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:OraContatto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$SelectCAUS_ESITO/Record[1]/CAUS_ESITO='021' and count($SelectEVENTO/Record)>0&quot;>&#xa;                        &lt;tns:TipoAppuntamento>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&#xa;                        &lt;/tns:TipoAppuntamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/cognomeReferente,'dk')&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;>&#xa;                                &lt;tns:Progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns1:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;/>&#xa;                                &lt;/tns:Progressivo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente,'dk')&quot;>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&#xa;                                    &lt;tns:Progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&#xa;                                    &lt;/tns:Progressivo>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:DataAppuntamento>&#xa;            &lt;/tns:NotificaWLR>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
