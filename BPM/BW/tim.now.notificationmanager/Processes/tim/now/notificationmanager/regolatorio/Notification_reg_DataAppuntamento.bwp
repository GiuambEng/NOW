                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT IDTPLG_EVENTO FROM EVENTO_ORDN_NOW_WHLS  WHERE ID_RICH_OLO=? AND ID_EVENTO_ORDN_NOW_WHLS=?&#xd;&#xa;AND IDTPLG_EVENTO=(SELECT IDTPLG_EVENTO FROM TIPOLG_EVENTO WHERE DESCR_EVENTO='NI_PRESA_APPUNTAMENTO')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
