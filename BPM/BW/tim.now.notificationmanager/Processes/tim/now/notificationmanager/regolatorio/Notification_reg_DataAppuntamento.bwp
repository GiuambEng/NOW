        <bpws:variable element="ns10:jdbcQueryActivityInput"
            name="SelectCAUS_ESITO-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns11:resultSet" name="SelectCAUS_ESITO" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
