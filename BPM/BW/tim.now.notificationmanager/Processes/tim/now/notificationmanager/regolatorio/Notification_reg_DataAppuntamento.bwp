                        <bpws:source linkName="DTUElementAssignToMapper_WLR">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta, &quot;WLR&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
