    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="21bdac6b-ba02-40df-8267-4760074388e6">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="LOG_FaultToReply" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:reply faultName="fault" name="Reply"
                            operation="GenericNotification"
                            partnerLink="Notification_reg_DataAppuntamento"
                            portType="ns7:Notification_reg_DataAppuntamento"
                            tibex:xpdlId="1eab1b7c-b5b0-45d3-88aa-c256fc77f275" variable="Reply-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns3="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns2:GenericNotificationFault&gt;&lt;NotificaGenericaFault&gt;&lt;tns3:NotificaGenericaFault&gt;&lt;tns3:Codice&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns3:Codice&gt;&lt;tns3:Descrizione&gt;&lt;xsl:value-of select="concat(tib:render-xml($FaultDetails), $FaultDetails/MsgCode)"/&gt;&lt;/tns3:Descrizione&gt;&lt;/tns3:NotificaGenericaFault&gt;&lt;/NotificaGenericaFault&gt;&lt;/tns2:GenericNotificationFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NotificaGenericaFault>&#xa;            &lt;tns3:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns3:Codice>&#xa;            &lt;tns3:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;concat(tib:render-xml($FaultDetails), $FaultDetails/MsgCode)&quot;/>&#xa;            &lt;/tns3:Descrizione>&#xa;        &lt;/tns3:NotificaGenericaFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="LOG_FaultToReply"/>
                            </bpws:targets>
                        </bpws:reply>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;LOG_Fault-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:MsgCode>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="LOG_Fault-input"
                                name="LOG_Fault"
                                tibex:xpdlId="e8d86451-16f3-47da-b47f-9947dc0aff19"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LOG_FaultToReply"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Fault-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_reg_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/tns:MsgCode>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="AssignToULLMapper_ULLULLDatiVULL"
                    tibex:label="ULL ULLDati VULL" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignToSLUMapper" tibex:label="SLU" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MapperToGenericNotificationOut" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToGenericNotificationOut1" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="GenericNotificationInToLOG_DataAppuntamento" tibex:linkType="SUCCESS"/>
                <bpws:link name="LOG_IDEvento" tibex:label="IDEvento" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="DTUElementAssignToMapper_WLR"
                    tibex:label="WLR" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MapperToGenericNotificationOut2" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQuery1ToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToDTUElementAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToJDBCQuery1" tibex:linkType="SUCCESS"/>
                <bpws:link name="LOG_DataAppuntamentoToDTUElementAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:receive createInstance="yes"
                name="GenericNotificationIn"
                operation="GenericNotification"
                partnerLink="Notification_reg_DataAppuntamento"
                portType="ns7:Notification_reg_DataAppuntamento"
                tibex:xpdlId="40921440-43da-4217-841a-51c6a02afb03" variable="GenericNotificationIn">
                <bpws:sources>
                    <bpws:source linkName="GenericNotificationInToLOG_DataAppuntamento"/>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="GenericNotificationOut"
                operation="GenericNotification"
                partnerLink="Notification_reg_DataAppuntamento"
                portType="ns7:Notification_reg_DataAppuntamento"
                tibex:xpdlId="4d9c4957-0599-494a-b4c4-40385fc6c12d" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns="http://xsd.telecomitalia.it/crm/regolatorio" version="2.0"&gt;&lt;xsl:param name="GenericNotificationIn"/&gt;&lt;xsl:param name="SLUMapper"/&gt;&lt;xsl:param name="ULLMapper"/&gt;&lt;xsl:param name="WLRMapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns4:GenericNotificationResponse&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns3:NotificaGenericaResponse&gt;&lt;xsl:choose&gt;&lt;xsl:when test="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Offerta, &amp;quot;WLR&amp;quot;)"&gt;&lt;xsl:copy-of select="$WLRMapper"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Offerta, &amp;quot;SLU&amp;quot;)"&gt;&lt;xsl:copy-of select="$SLUMapper"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:copy-of select="$ULLMapper"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns3:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns4:GenericNotificationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;SLUMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;ULLMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;WLRMapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NotificaGenericaResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Offerta, &amp;quot;WLR&amp;quot;)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$WLRMapper&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Offerta, &amp;quot;SLU&amp;quot;)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$SLUMapper&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:copy-of select=&quot;$ULLMapper&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="MapperToGenericNotificationOut"/>
                    <bpws:target linkName="MapperToGenericNotificationOut1"/>
                    <bpws:target linkName="MapperToGenericNotificationOut2"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUElement&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectEVENTO&quot;/>&#xa;    &lt;xsl:template name=&quot;ULLMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaULL>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:DataAppuntamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo, 1, 2)&quot;/>&#xa;                            &lt;/tns:OraAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:OraAppuntamento>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, 'dk')&quot;>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente, 'dk')&quot;>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/nomeReferente)&quot;/>&#xa;                                            &lt;/tns:ReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:ReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                            &lt;/tns:ReferenteContattato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) = 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&#xa;                                            &lt;tns:TelefonoReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&#xa;                                            &lt;/tns:TelefonoReferenteContattato>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:TelefonoReferenteContattato>&#xa;                                                &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&#xa;                                            &lt;/tns:TelefonoReferenteContattato>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&#xa;                                    &lt;tns:TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoReferenteContattato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:TelefonoReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&#xa;                            &lt;/tns:TelefonoReferenteContattato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataContatto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                            &lt;/tns:OraContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]:[m01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:OraContatto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)>0 and upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)='SU'&quot;>&#xa;                            &lt;tns:TipoAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$SelectCAUS_ESITO/Record[1]/CAUS_ESITO='021' and count($SelectEVENTO/Record)>0&quot;>&#xa;                            &lt;tns:TipoAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipoAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente,'dk')&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;>&#xa;                                &lt;tns:Progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;/>&#xa;                                &lt;/tns:Progressivo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente,'dk')&quot;>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&#xa;                                    &lt;tns:Progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&#xa;                                    &lt;/tns:Progressivo>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:DataAppuntamento>&#xa;            &lt;/tns:NotificaULL>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ULLMapper-input" name="ULLMapper"
                    outputVariable="ULLMapper"
                    tibex:xpdlId="a47a45fc-2de0-48c7-8a1a-3b51a4565b46" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToULLMapper_ULLULLDatiVULL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&lt;xsl:param name=&quot;DTUElement&quot;/>&lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&lt;xsl:param name=&quot;SelectEVENTO&quot;/>&lt;xsl:template name=&quot;ULLMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaULL>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:DataAppuntamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:NuovaDA>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NuovaDA>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:OraAppuntamento>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo, 1, 2)&quot;/>&lt;/tns:OraAppuntamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OraAppuntamento>&lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&lt;/tns:OraAppuntamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, 'dk')&quot;>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente, 'dk')&quot;>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/nomeReferente)&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) = 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataContatto>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContatto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataContatto>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContatto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:OraContatto>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OraContatto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OraContatto>&lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]:[m01]&amp;quot;)&quot;/>&lt;/tns:OraContatto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)>0 and upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)='SU'&quot;>&lt;tns:TipoAppuntamento>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/tns:TipoAppuntamento>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectCAUS_ESITO/Record[1]/CAUS_ESITO='021' and count($SelectEVENTO/Record)>0&quot;>&lt;tns:TipoAppuntamento>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:TipoAppuntamento>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente,'dk')&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente,'dk')&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:DataAppuntamento>&lt;/tns:NotificaULL>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:regolatorio="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="regolatorio:NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;DTUElement&quot;/>&lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&lt;xsl:param name=&quot;SelectEVENTO&quot;/>&lt;xsl:template name=&quot;SLUMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaSLU>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:DataAppuntamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:NuovaDA>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DATAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NuovaDA>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:OraAppuntamento>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORAAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo, 1, 2)&quot;/>&lt;/tns:OraAppuntamento>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OraAppuntamento>&lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&lt;/tns:OraAppuntamento>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente, 'dk')&quot;>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente, 'dk')&quot;>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/nomeReferente)&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ReferenteContattato>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tns:ReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) = 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&lt;/tns:TelefonoReferenteContattato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataContatto>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATADT&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContatto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataContatto>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContatto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:OraContatto>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELEFONATAORA&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OraContatto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OraContatto>&lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]:[m01]&amp;quot;)&quot;/>&lt;/tns:OraContatto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)>0 and upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente='APPUNTAMENTODISAGGREGAZIONE']/attributiDettaglioOrdine[nomeAttributo='OWNERPRESAAPPUNTAMENTO']/valoreAttributo)='SU'&quot;>&lt;tns:TipoAppuntamento>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/tns:TipoAppuntamento>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectCAUS_ESITO/Record[1]/CAUS_ESITO='021' and count($SelectEVENTO/Record)>0&quot;>&lt;tns:TipoAppuntamento>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:TipoAppuntamento>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or &amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/cognomeReferente,'dk')&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $DTUElement/tns3:DTUElement[last()]]/valoreAttributo)]/progressivoReferente&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/nomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/cognomeReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoFissoReferente,'dk')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/telefonoMobileReferente,'dk')&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:DataAppuntamento>&lt;/tns:NotificaSLU>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SLUMapper-input" name="SLUMapper"
