                <bpws:sources>
                    <bpws:source linkName="GenericNotificationInToGenericNotificationOut_Name">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GenericNotificationInToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDAnagraficaCausale)) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDAnagraficaCausale)) = 0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
