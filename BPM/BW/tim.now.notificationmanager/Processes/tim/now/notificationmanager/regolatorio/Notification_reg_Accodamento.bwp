            <bpws:reply name="GenericNotificationOut"
                operation="GenericNotification"
                partnerLink="Notification_reg_Accodamento"
                portType="ns9:Notification_reg_Accodamento"
                tibex:xpdlId="73b68c3a-0c09-469b-b064-d02ed947f997" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns="http://xsd.telecomitalia.it/crm/regolatorio" version="2.0"&gt;&lt;xsl:param name="GenericNotificationIn"/&gt;&lt;xsl:param name="SLUMapper"/&gt;&lt;xsl:param name="ULLMapper"/&gt;&lt;xsl:param name="WLRMapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns4:GenericNotificationResponse&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns3:NotificaGenericaResponse&gt;&lt;xsl:choose&gt;&lt;xsl:when test="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Offerta, &amp;quot;WLR&amp;quot;)"&gt;&lt;xsl:copy-of select="$WLRMapper"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Offerta, &amp;quot;SLU&amp;quot;)"&gt;&lt;xsl:copy-of select="$SLUMapper"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:copy-of select="$ULLMapper"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns3:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns4:GenericNotificationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;SLUMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;ULLMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;WLRMapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NotificaGenericaResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Offerta, &amp;quot;WLR&amp;quot;)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$WLRMapper&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Offerta, &amp;quot;SLU&amp;quot;)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$SLUMapper&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:copy-of select=&quot;$ULLMapper&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="MapperToGenericNotificationOut"/>
                    <bpws:target linkName="MapperToGenericNotificationOut1"/>
                    <bpws:target linkName="MapperToGenericNotificationOut2"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:template name=&quot;ULLMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaULL>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:Accodamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUACCODAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DPS&amp;quot;]/valoreAttributo) > 0&quot;>&lt;tns:DataPrevistaSoluzione>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUACCODAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DPS&amp;quot;]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataPrevistaSoluzione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataPrevistaSoluzione>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataPrevistaSoluzione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CodiceCausaleAccodamento>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceCausaleAccodamento>&lt;tns:DescrizioneCausaleAccodamento>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:DescrizioneCausaleAccodamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUACCODAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONECODA&amp;quot;]/valoreAttributo) > 0&quot;>&lt;tns:PosizioneCoda>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUACCODAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;POSIZIONECODA&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:PosizioneCoda>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:PosizioneCoda>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:PosizioneCoda>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUACCODAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;LUNGHEZZACODA&amp;quot;]/valoreAttributo) > 0&quot;>&lt;tns:DimensioneCoda>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUACCODAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;LUNGHEZZACODA&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DimensioneCoda>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DimensioneCoda>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:DimensioneCoda>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Accodamento>&lt;/tns:NotificaULL>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ULLMapper-input" name="ULLMapper"
                    outputVariable="ULLMapper"
                    tibex:xpdlId="2b2c2276-9e99-4f2b-909e-c6bc56807032" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_ULLULLDatiVULL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:template name=&quot;ULLMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaULL>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:Accodamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUACCODAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DPS&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataPrevistaSoluzione>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns3:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;qu