                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+edc64a8e-cd5e-480d-b207-ec126473091f+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_DataValidazioneTecnicoGestionale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO_DTU>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_DTU>&#xa;            &lt;ID_RICH_OLO_NOW_WHLS>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO_NOW_WHLS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta, &amp;quot;WLR&amp;quot;)&quot;>&#xa;                    &lt;DESCR_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NI_PRENOTAZIONE_NUMERO&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_EVENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;&quot;/>&#xa;                    &lt;/DESCR_EVENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DATA_ESITO&#xd;&#xa;&#x9;FROM EVENTO_DTU EDTU, EVENTO_ORDN_NOW_WHLS ENOW, TIPOLG_EVENTO TIPEV&#xd;&#xa;&#x9;WHERE EDTU.IDTPLG_STATO_EVENTO_DTU = '6' AND EDTU.ID_RICH_OLO = ? AND&#xd;&#xa;&#x9;EDTU.ID_EVENTO_ORDN_NOW_WHLS = ENOW.ID_EVENTO_ORDN_NOW_WHLS AND ENOW.ID_RICH_OLO = ?&#xd;&#xa;&#x9;AND ENOW.IDTPLG_EVENTO = TIPEV.IDTPLG_EVENTO AND TIPEV.DESCR_EVENTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_DTU"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_EVENTO"/>
                                    <columnMetadata
                                    columnName="DATA_ESITO"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&lt;xsl:template name=&quot;WLRMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaWLR>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:StatoAvanzamento>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/created)) > 0&quot;>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneFormaleContrattuale>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneFormaleContrattuale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataValidazioneTecnicoGestionale>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataValidazioneTecnicoGestionale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo&quot;>&lt;tns:OrarioDataEspletamento>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo&quot;/>&lt;/tns:OrarioDataEspletamento>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DACRimodulata)&quot;>&lt;tns:NuovaDAC>&lt;xsl:value-of select=&quot;format-date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NuovaDAC>&lt;xsl:value-of select=&quot;format-date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NuovaDAC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Rifiuto>&lt;tns:TipoCausaleRifiuto>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:TipoCausaleRifiuto>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/tns:Rifiuto>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema) > 0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/notedaSistema&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/noteCliente&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente)&quot;>&lt;tns:Referente>&lt;tns:QualificaRef>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/qualificaReferente&quot;/>&lt;/tns:QualificaRef>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&lt;/tns:CognomeReferente>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/nomeReferente&quot;>&lt;tns:NomeReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/nomeReferente&quot;/>&lt;/tns:NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;>&lt;tns:TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&lt;/tns:TelefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/tns:Referente>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;tns:Referente>&lt;tns:QualificaRef>&lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&lt;/tns:QualificaRef>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tns:CognomeReferente>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/tns:Referente>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='GNR' or upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;/>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico)&quot;>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico]&quot;>&lt;tns:NumerazioneAggiuntiva>&lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&lt;/tns:NumerazioneAggiuntiva>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:StatoAvanzamento>&lt;/tns:NotificaWLR>&lt;/tns:NotificaOloRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="WLRMapper-input" name="WLRMapper"
                    outputVariable="WLRMapper"
                    tibex:xpdlId="e255e7b5-831f-4fe7-ae5e-1909168d8fd8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_DataValidazioneTecnicoGestionaleToWLRMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DataValidazioneTecnicoGestionale&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUFoniaElement&quot;/>&#xa;    &lt;xsl:template name=&quot;WLRMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaWLR>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:StatoAvanzamento>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;>&#xa;                        &lt;tns:DN>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:DN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/created)) > 0&quot;>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/created, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneFormaleContrattuale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneFormaleContrattuale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DataValidazioneTecnicoGestionale/Record)&quot;>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($JDBC_DataValidazioneTecnicoGestionale/Record[1]/DATA_ESITO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:DataValidazioneTecnicoGestionale>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataValidazioneTecnicoGestionale>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns:DataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;format-date(tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;DES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:DataEspletamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo&quot;>&#xa;                        &lt;tns:OrarioDataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ORADES&amp;quot; and string(created) = $DTUFoniaElement/tns1:DTUElement[last()]]/valoreAttributo&quot;/>&#xa;                        &lt;/tns:OrarioDataEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata)&quot;>&#xa;                            &lt;tns:NuovaDAC>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDAC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NuovaDAC>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDAC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:Rifiuto>&#xa;                        &lt;tns:TipoCausaleRifiuto>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                        &lt;/tns:TipoCausaleRifiuto>&#xa;                        &lt;tns:CodiceMotivoRifiuto>&#xa;                            &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                        &lt;/tns:CodiceMotivoRifiuto>&#xa;                        &lt;tns:MotivoRifiuto>&#xa;                            &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                        &lt;/tns:MotivoRifiuto>&#xa;                    &lt;/tns:Rifiuto>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;tns:Referente>&#xa;                                &lt;tns:QualificaRef>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/qualificaReferente&quot;/>&#xa;                                &lt;/tns:QualificaRef>&#xa;                                &lt;tns:CognomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/cognomeReferente&quot;/>&#xa;                                &lt;/tns:CognomeReferente>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/nomeReferente&quot;>&#xa;                                    &lt;tns:NomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/nomeReferente&quot;/>&#xa;                                    &lt;/tns:NomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;>&#xa;                                    &lt;tns:TelefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;>&#xa;                                    &lt;tns:TelefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&#xa;                                    &lt;/tns:TelefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;>&#xa;                                    &lt;tns:Progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/progressivoReferente&quot;/>&#xa;                                    &lt;/tns:Progressivo>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:Referente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                            &lt;tns:Referente>&#xa;                                &lt;tns:QualificaRef>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                                &lt;/tns:QualificaRef>&#xa;                                &lt;tns:CognomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                                &lt;/tns:CognomeReferente>&#xa;                                &lt;tns:TelefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&#xa;                                &lt;/tns:TelefonoFissoReferente>&#xa;                            &lt;/tns:Referente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='GNR' or upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='STRUTTURALINEA']/valoreAttributo)='PBX'&quot;/>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;AGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot; and valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot;]/valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUPRENOTAZIONEAGGIUNTIVO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TELAGGIUNTIVO&amp;quot; and valoreAttributo != $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico]&quot;>&#xa;                                &lt;tns:NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/tns:NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:StatoAvanzamento>&#xa;            &lt;/tns:NotificaWLR>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:regolatorio="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="regolatorio:NotificaOloRegolatorio" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
