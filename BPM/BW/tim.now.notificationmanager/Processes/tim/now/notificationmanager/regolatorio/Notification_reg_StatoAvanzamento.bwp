                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+edc64a8e-cd5e-480d-b207-ec126473091f+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;JDBC_DataValidazioneTecnicoGestionale-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO_DTU>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO_DTU>&lt;ID_RICH_OLO_NOW_WHLS>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO_NOW_WHLS>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta, &amp;quot;WLR&amp;quot;)&quot;>&lt;DESCR_EVENTO>&lt;xsl:value-of select=&quot;&amp;quot;NI_PRENOTAZIONE_NUMERO&amp;quot;&quot;/>&lt;/DESCR_EVENTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_EVENTO>&lt;xsl:value-of select=&quot;&amp;quot;NI_VERIFICA_TECNICA_E_TOPONOMASTICA&amp;quot;&quot;/>&lt;/DESCR_EVENTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_DataValidazioneTecnicoGestionale-input"
