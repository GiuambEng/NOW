>&lt;ID_RICH_OLO_EVENTO>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO_EVENTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
