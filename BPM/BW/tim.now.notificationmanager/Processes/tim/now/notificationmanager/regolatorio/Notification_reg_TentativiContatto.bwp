            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_DATI_REFERENTE&quot;/>&lt;xsl:template name=&quot;ULLMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaULL>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:TentativiContatto>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/COGNOMEREFERENTE) > 0&quot;>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/COGNOMEREFERENTE&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE) > 0&quot;>&lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE&quot;>&lt;tns:NomeReferente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE&quot;/>&lt;/tns:NomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/TELEFONOFISSOREFERENTE) > 0&quot;>&lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[1]/TELEFONOFISSOREFERENTE&quot;>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/TELEFONOFISSOREFERENTE&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/TELEFONOMOBILEREFERENTE) > 0&quot;/>&lt;xsl:otherwise>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/TELEFONOMOBILEREFERENTE) > 0&quot;>&lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[1]/TELEFONOMOBILEREFERENTE&quot;>&lt;tns:TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/TELEFONOMOBILEREFERENTE&quot;/>&lt;/tns:TelefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length(string($JDBC_DATI_REFERENTE/Record[1]/DATA_TELEFONATA)) > 0&quot;>&lt;tns:DataContattoCliente>&lt;xsl:value-of select=&quot;format-dateTime($JDBC_DATI_REFERENTE/Record[1]/DATA_TELEFONATA, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContattoCliente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataContattoCliente>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataContattoCliente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/ORA_TELEFONATA) > 0&quot;>&lt;tns:OraContattoCliente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/ORA_TELEFONATA&quot;/>&lt;/tns:OraContattoCliente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:OraContattoCliente>&lt;xsl:value-of select=&quot;substring(string(current-time()), 1, 5)&quot;/>&lt;/tns:OraContattoCliente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;starts-with($JDBC_DATI_REFERENTE/Record[1]/COGNOMEREFERENTE, 'dk') or starts-with($JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE, 'dk') or starts-with($JDBC_DATI_REFERENTE/Record[1]/TELEFONOMOBILEREFERENTE, 'dk') or starts-with($JDBC_DATI_REFERENTE/Record[1]/TELEFONOFISSOREFERENTE, 'dk') &quot;>&lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[1]/PROGRESSIVOREFERENTE&quot;>&lt;tns:Progressivo>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/PROGRESSIVOREFERENTE&quot;/>&lt;/tns:Progressivo>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($JDBC_DATI_REFERENTE/Record[2]) and $JDBC_DATI_REFERENTE/Record[2]/ID_EVENTO_ORDN_NOW_WHLS = $JDBC_DATI_REFERENTE/Record[1]/ID_EVENTO_ORDN_NOW_WHLS&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBC_DATI_REFERENTE/Record[2]/COGNOMEREFERENTE) > 0&quot;>&lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[2]/COGNOMEREFERENTE&quot;>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[2]/COGNOMEREFERENTE&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($JDBC_DATI_REFERENTE/Record[2]) and $JDBC_DATI_REFERENTE/Record[2]/ID_EVENTO_ORDN_NOW_WHLS = $JDBC_DATI_REFERENTE/Record[1]/ID_EVENTO_ORDN_NOW_WHLS&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBC_DATI_REFERENTE/Record[2]/NOMEREFERENTE) > 0&quot;>&lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[2]/NO