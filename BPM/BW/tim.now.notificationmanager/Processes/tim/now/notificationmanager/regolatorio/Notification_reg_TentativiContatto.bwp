                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DATI_REFERENTE&quot;/>&#xa;    &lt;xsl:template name=&quot;SLUMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOloRegolatorio>&#xa;            &lt;tns:NotificaSLU>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:TentativiContatto>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/COGNOMEREFERENTE) > 0&quot;>&#xa;                            &lt;tns:CognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/COGNOMEREFERENTE&quot;/>&#xa;                            &lt;/tns:CognomeReferente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                            &lt;/tns:CognomeReferente>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE&quot;>&#xa;                                &lt;tns:NomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE&quot;/>&#xa;                                &lt;/tns:NomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/TELEFONOFISSOREFERENTE) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[1]/TELEFONOFISSOREFERENTE&quot;>&#xa;                                &lt;tns:TelefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/TELEFONOFISSOREFERENTE&quot;/>&#xa;                                &lt;/tns:TelefonoFissoReferente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/TELEFONOMOBILEREFERENTE) > 0&quot;/>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:TelefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot