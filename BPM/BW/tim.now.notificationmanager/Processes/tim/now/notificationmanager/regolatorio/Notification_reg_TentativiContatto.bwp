                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_DATI_REFERENTE&quot;/>&lt;xsl:template name=&quot;SLUMapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOloRegolatorio>&lt;tns:NotificaSLU>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:TestataNotifica/tns3:TestataRegolatorio/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:TentativiContatto>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/COGNOMEREFERENTE) > 0&quot;>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/COGNOMEREFERENTE&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record) and string-length($JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE) > 0&quot;>&lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[1]/NOMEREFERENTE&quot;>&lt;tns:NomeReferente>&lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[1]/NOME