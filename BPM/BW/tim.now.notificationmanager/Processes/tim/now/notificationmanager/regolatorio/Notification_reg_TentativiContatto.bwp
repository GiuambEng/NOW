ose>&#xa;                            &lt;xsl:when test=&quot;string-length(string($JDBC_DATI_REFERENTE/Record[3]/ORA_TELEFONATA)) > 0&quot;>&#xa;                                &lt;tns:OraContattoCliente>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[3]/ORA_TELEFONATA&quot;/>&#xa;                                &lt;/tns:OraContattoCliente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:OraContattoCliente>&#xa;                                    &lt;xsl:value-of select=&quot;substring(string(current-time()), 1, 5)&quot;/>&#xa;                                &lt;/tns:OraContattoCliente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:TentativiContatto>&#xa;            &lt;/tns:NotificaWLR>&#xa;        &lt;/tns:NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
