   &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBC_DATI_REFERENTE/Record[2]/TELEFONOFISSOREFERENTE) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[2]/TELEFONOFISSOREFERENTE&quot;>&#xa;                                    &lt;tns:TelefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[2]/TELEFONOFISSOREFERENTE&quot;/>&#xa;                                    &lt;/tns:TelefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBC_DATI_REFERENTE/Record[2]/TELEFONOMOBILEREFERENTE) > 0&quot;/>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:TelefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;XXXXXXXXXXXX&amp;quot;&quot;/>&#xa;                                &lt;/tns:TelefonoFissoReferente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($JDBC_DATI_REFERENTE/Record[2]) and $JDBC_DATI_REFERENTE/Record[2]/ID_EVENTO_ORDN_NOW_WHLS = $JDBC_DATI_REFERENTE/Record[1]/ID_EVENTO_ORDN_NOW_WHLS&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($JDBC_DATI_REFERENTE/Record[2]/TELEFONOMOBILEREFERENTE) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBC_DATI_REFERENTE/Record[2]/TELEFONOMOBILEREFERENTE&quot;>&#xa;                                    &lt;tns:TelefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_DATI_REFERENTE/Record[2]/TELEFONOMOBILEREFERENTE&quot;/>&#xa;                                    &lt;/tns:TelefonoMo