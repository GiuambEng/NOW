&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns="http://xsd.telecomitalia.it/crm/regolatorio" version="2.0"&gt;&lt;xsl:param name="GenericNotificationIn"/&gt;&lt;xsl:param name="SLUMapper"/&gt;&lt;xsl:param name="ULLMapper"/&gt;&lt;xsl:param name="WLRMapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns3:GenericNotificationResponse&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns4:NotificaGenericaResponse&gt;&lt;xsl:choose&gt;&lt;xsl:when test="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns4:NotificaGenericaRequest/tns4:Offerta, &amp;quot;WLR&amp;quot;)"&gt;&lt;xsl:copy-of select="$WLRMapper"/&gt;&lt;/xsl:when&gt;&lt;xsl:when test="starts-with($GenericNotificationIn/NotificaGenericaRichiesta/tns4:NotificaGenericaRequest/tns4:Offerta, &amp;quot;SLU&amp;quot;)"&gt;&lt;xsl:copy-of select="$SLUMapper"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:copy-of select="$ULLMapper"/&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns4:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns3:GenericNotificationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
