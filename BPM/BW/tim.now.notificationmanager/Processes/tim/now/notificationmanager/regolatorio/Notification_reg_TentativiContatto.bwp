   &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_EVENTO_ORDN_NOW_WHLS xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns2:IDEventoOrdineNOW)) > 0&quot;>&#xa;                    &lt;ID_RICH_OLO_EVENTO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RICH_OLO_EVENTO>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                    &lt;/ID_RICH_OLO_EVENTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
