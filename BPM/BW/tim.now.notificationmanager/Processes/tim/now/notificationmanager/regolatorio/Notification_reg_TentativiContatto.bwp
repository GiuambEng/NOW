                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DTU.ID_EVENTO_ORDN_NOW_WHLS, REFTE.COGNOMEREFERENTE, REFTE.NOMEREFERENTE, REFTE.TELEFONOFISSOREFERENTE, REFTE.TELEFONOMOBILEREFERENTE, DTU.DATA_TELEFONATA, DTU.ORA_TELEFONATA,REFTE.PROGRESSIVOREFERENTE&#xa;FROM CONTATTO_REFTE_DTU DTU, BDS_1_CASEDATA_REFERENTE REFTE&#xa;WHERE DTU.ID_RICH_OLO = ?&#xa;AND REFTE.IDRICHIESTAOLO = DTU.ID_RICH_OLO&#xa;AND (ID_EVENTO_ORDN_NOW_WHLS = ? OR ID_EVENTO_ORDN_NOW_WHLS = (SELECT MAX(ID_EVENTO_ORDN_NOW_WHLS)&#xa;FROM CONTATTO_REFTE_DTU WHERE ID_RICH_OLO = ?))&#xa;AND REFTE.PROGRESSIVOREFERENTE = DTU.PROGRS_REFTE&#xa;ORDER BY DTU.ID_EVENTO_ORDN_NOW_WHLS, DTU.PROGRS_REFTE" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_EVENTO"/>
                                    <columnMetadata
                                    columnName="ID_EVENTO_ORDN_NOW_WHLS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COGNOMEREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TELEFONOFISSOREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="TELEFONOMOBILEREFERENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_TELEFONATA"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ORA_TELEFONATA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROGRESSIVOREFERENTE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
