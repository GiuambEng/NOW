                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ToolScarto&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ToolScarto&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ToolScarto&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ToolScarto&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:DatiNotificaScarto/tns2:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Dati in input: &amp;quot;, tib:render-xml($Start/tns2:DatiNotificaScarto, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Input-input" name="LOG_Input"
                    tibex:xpdlId="4a73a0ee-739d-435d-aafc-b29618d5c134"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLOG_Input"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_InputToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ToolScarto&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ToolScarto&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ToolScarto&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ToolScarto&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:DatiNotificaScarto/tns2:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Dati in input: &amp;quot;, tib:render-xml($Start/tns2:DatiNotificaScarto, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ToolScarto&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ToolScartoUtil&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperoTracciatoCallProcess-input&quot; match=&quot;/&quot;>&lt;tns1:ToolScartoRecuperoTracciatoInput>&lt;tns1:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:DatiNotificaScarto/tns:IDRichiestaOLO&quot;/>&lt;/tns1:IDRichiestaOLO>&lt;/tns1:ToolScartoRecuperoTracciatoInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RecuperoTracciatoCallProcess-input"
                    name="RecuperoTracciatoCallProcess"
                    outputVariable="RecuperoTracciatoCallProcess"
                    tibex:xpdlId="fe5600ad-63df-43c3-a27b-0c177fbc745b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_InputToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperoTracciatoCallProcessToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ToolScarto&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ToolScartoUtil&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperoTracciatoCallProcess-input&quot; match=&quot;/&quot;>&lt;tns1:ToolScartoRecuperoTracciatoInput>&lt;tns1:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:DatiNotificaScarto/tns:IDRichiestaOLO&quot;/>&lt;/tns1:IDRichiestaOLO>&lt;/tns1:ToolScartoRecuperoTracciatoInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.notificationmanager.tool.scarto.ToolScartoRecuperoTracciato" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while"
                tibex:indexToGlobal="false" tibex:xpdlId="3c0fcad0-f32a-4c29-83ed-fbea9453ef7b">
                <bpws:targets>
                    <bpws:target linkName="CalcoloNotificheCallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCallProcess"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($CalcoloNotificheCallProcess/ns23:NotificaDaInviare)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($CalcoloNotificheCallProcess/ns23:NotificaDaInviare)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="MapperNotificationToInvokeNotification" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvokeNotificationToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToMapperNotification" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="InvokeNotificationToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="AssignToMapperNotification" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToMapperNotification1_NPDONATINGoDONOR"
                                    tibex:label="!= NP DONATING o DONOR" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="71b800e4-bc23-4c16-996b-36fa00279861">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapperNotification">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RecuperoTracciatoCallProcess/ns25:RichiestaElement/strutturaRichiesta = &quot;NPG&quot; and ($CalcoloNotificheCallProcess/ns23:NotificaDaInviare[number($index)]/ns23:TipologiaDestinatario = &quot;DONATING&quot; or $CalcoloNotificheCallProcess/ns23:NotificaDaInviare[number($index)]/ns23:TipologiaDestinatario = &quot;DONOR&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$RecuperoTracciatoCallProcess/ns25:RichiestaElement/strutturaRichiesta = "NPG" and ($CalcoloNotificheCallProcess/ns23:NotificaDaInviare[number($index)]/ns23:TipologiaDestinatario = "DONATING" or $CalcoloNotificheCallProcess/ns23:NotificaDaInviare[number($index)]/ns23:TipologiaDestinatario = "DONOR")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToMapperNotification1_NPDONATINGoDONOR">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="8a85f6f2-cbe2-47b6-9559-c1336b6e3ee3">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    <bpws:target linkName="InvokeNotificationToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ToolScarto&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ToolScartoUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RecuperoTracciatoCallProcess&quot;/>&lt;xsl:param name=&quot;CalcoloNotificheCallProcess&quot;/>&lt;xsl:param name=&quot;CodificaOLOAGCOMDestinatario&quot;/>&lt;xsl:template name=&quot;MapperNotification-input&quot; match=&quot;/&quot;>&lt;tns:NotificationRequest>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;$CalcoloNotificheCallProcess/tns2:NotificaDaInviare[number($index)]/tns2:StatoRichiesta&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/statoRichiestaNOW&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;xsl:if test=&quot;$CalcoloNotificheCallProcess/tns2:NotificaDaInviare[number($index)]/tns2:StatoRichiesta&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$CalcoloNotificheCallProcess/tns2:NotificaDaInviare[number($index)]/tns2:StatoRichiesta&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/statoRichiestaOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/statoRichiestaOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/ambito&quot;>&lt;ambito>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/ambito&quot;/>&lt;/ambito>&lt;/xsl:if>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/canaleRichiesta&quot;/>&lt;/canaleRichiesta>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/progressivoRichiestaFile&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/progressivoRichiestaFile&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/strutturaRichiesta&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/tipoRichiesta&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/IDRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codificaOLONOW&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codificaOLONOW&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineOLOTarget&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineOLOTarget&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineOLOPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineOLOPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$RecuperoTracciatoCallProcess/ns:RichiestaElement/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=