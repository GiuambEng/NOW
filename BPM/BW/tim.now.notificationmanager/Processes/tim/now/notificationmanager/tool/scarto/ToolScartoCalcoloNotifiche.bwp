                    <bpws:sources>
                        <bpws:source linkName="NotificaEspletamentoKOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ToolScartoUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryKO-KD&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQueryPreDelivery&quot;/>&lt;xsl:template name=&quot;CalcoloNotificaDaInviare&quot; match=&quot;/&quot;>&lt;tns:CalcoloPostPreDelivery>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_RECIPIENT)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_RECIPIENT&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_DONOR)) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $Start/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;) and $Start/codificaOLOAGCOM != &amp;quot;TLC&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONOR&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo) > 0 and $Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo != &amp;quot;TLC&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONOR&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_DONATING)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_DONATING&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryKO-KD/Record[1]/COMPONENTE_DONATING = &amp;quot;CONSISTENZAFONIA&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryKO-KD/Record[1]/COMPONENTE_DONATING = &amp;quot;CONSISTENZADATI&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_DPP_DONATING)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KD/Record[1]/COD_TIPOLG_NOTF_DPP_DONATING&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:DoppioDonating>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryKO-KD/Record[1]/COMPONENTE_DPP_DONATING = &amp;quot;CONSISTENZAFONIA&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryKO-KD/Record[1]/COMPONENTE_DPP_DONATING = &amp;quot;CONSISTENZADATI&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;/tns:CalcoloPostPreDelivery>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CalcoloNotificaDaInviare" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryKO-KC-input"
                    name="JDBCQueryKO-KC"
                    outputVariable="JDBCQueryKO-KC"
                    tibex:xpdlId="966dc61a-4c3d-4def-b6f6-095fb2a6a3b5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQueryKO-KC"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToNotificaAccettazioneKO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+966dc61a-4c3d-4def-b6f6-095fb2a6a3b5+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryKO-KC-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_OFFERTA_ESTERNA>&lt;TIPOLG_LAVRZ>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/lavorazione)&quot;>&lt;xsl:value-of select=&quot;$Start/lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPOLG_LAVRZ>&lt;SCENARIO_BPM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tipologiaScenario)&quot;>&lt;xsl:value-of select=&quot;$Start/tipologiaScenario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SCENARIO_BPM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT A.COD_MACCHINA_STATI_DTU, A.COD_TIPOLG_NOTF_RECIPIENT, A.COD_TIPOLG_NOTF_DONOR, A.COD_TIPOLG_NOTF_DONATING, A.COD_TIPOLG_NOTF_DPP_DONATING, A.COMPONENTE_DONATING, A.COMPONENTE_DPP_DONATING&#xa;FROM APPUSER.MACCHINA_STATI_DTU A, APPUSER.TIPOLG_RICH_COMSTNOW B&#xa;WHERE B.IDRICH_COM_STRC = A.IDRICH_COM_STRC_SUCCV&#xa;AND B.STATO_RICH_NOW = 'SCARTATO'&#xa;AND A.COD_MACCHINA_STATI_DTU = (SELECT A.COD_MACCHINA_A_STATI_DTU&#xa;FROM AMBITO_DTU A, TIPOLG_LAVRZ LAV, TRASCODFC_OFFERTA OFFR&#xa;WHERE OFFR.NOME_OFFERTA_ESTERNA = ? AND OFFR.PROVENIENZA = 'BPM' AND OFFR.ID_OFFERTA = A.ID_OFFERTA&#xa;AND LAV.TIPOLG_LAVRZ = ? AND LAV.IDTPLG_LAVRZ = A.IDTPLG_LAVRZ&#xa;AND A.ID_SCENARIO = (SELECT ID_SCENARIO&#xa;FROM TIPOLG_SCENARIO&#xa;WHERE SCENARIO_BPM = ?))&#xa;AND ((A.IDTPLG_EVENTO = 'ESPLETAMENTO_KO' AND A.STRUTTURA_RICH_RECIPIENT IN ('XDSL','NGA') AND COD_TIPOLG_NOTF_RECIPIENT IN ('KD','KO'))&#xa;    OR (A.IDTPLG_EVENTO = 'ESPLETAMENTO_KO' AND A.STRUTTURA_RICH_RECIPIENT IN ('REGOLATORIO') AND COD_TIPOLG_NOTF_RECIPIENT = 'KC'))&#xa;ORDER BY A.COD_MACCHINA_STATI_DTU" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SCENARIO_BPM"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_MACCHINA_STATI_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_TIPOLG_NOTF_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="COD_TIPOLG_NOTF_DONOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="COD_TIPOLG_NOTF_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="COD_TIPOLG_NOTF_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="COMPONENTE_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="COMPONENTE_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Output-input"
                    name="LOG_Output"
                    tibex:xpdlId="a136ea2a-edfe-4c25-8a53-16d7ae31bcee"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NotificaAccettazioneKOToCallProcess"/>
                        <bpws:target linkName="NotificaEspletamentoKOToCallProcess"/>
                        <bpws:target linkName="NotificaAcquisitoKOToCallProcess"/>
                        <bpws:target linkName="AssignToLOG_Output"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;CalcoloNotificaDaInviare&quot;/>&lt;xsl:template name=&quot;LOG_Output-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ToolScartoRecuperoTracciato&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ToolScartoRecuperoTracciato&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ToolScartoRecuperoTracciato&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output CalcoloNotifiche: &amp;quot;, tib:render-xml($CalcoloNotificaDaInviare, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="b5b1cc55-2b0e-40ed-93da-8df493801e21">
                <bpws:targets>
                    <bpws:target linkName="LOG_PreDeliveryToJDBCQuery1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($JDBCQueryNotf/Record[COD_TIPOLG_NOTF = &quot;AC&quot; and IDTPLG_STNTF_FILE_ORARIO != 3 and IDTPLG_STNTF_FILE_ORARIO != 6]) or $Start/strutturaRichiesta = &quot;NPG&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($JDBCQueryNotf/Record[COD_TIPOLG_NOTF = "AC" and IDTPLG_STNTF_FILE_ORARIO != 3 and IDTPLG_STNTF_FILE_ORARIO != 6]) or $Start/strutturaRichiesta = "NPG"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBCQueryKO-KC">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="Empty1" tibex:xpdlId="e4affdd1-4ca5-49a0-bf29-d6f288c4ac88">
                <bpws:targets>
                    <bpws:target linkName="EmptyToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToJDBCQueryKO-KD">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToJDBCQuery_DEL103">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/flagDelibera103='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/flagDelibera103='Y']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="03b84773-ecde-454d-ad8e-0fb979a9f81e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToJDBCQuery_DEL103"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToAssign1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+03b84773-ecde-454d-ad8e-0fb979a9f81e+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_OFFERTA_ESTERNA>&lt;TIPOLG_LAVRZ>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/lavorazione)&quot;>&lt;xsl:value-of select=&quot;$Start/lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPOLG_LAVRZ>&lt;SCENARIO_BPM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tipologiaScenario)&quot;>&lt;xsl:value-of select=&quot;$Start/tipologiaScenario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SCENARIO_BPM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT A.COD_MACCHINA_STATI_DTU, A.COD_TIPOLG_NOTF_RECIPIENT, A.COD_TIPOLG_NOTF_DONOR, A.COD_TIPOLG_NOTF_DONATING, A.COD_TIPOLG_NOTF_DPP_DONATING, A.COMPONENTE_DONATING, A.COMPONENTE_DPP_DONATING&#xa;FROM APPUSER.MACCHINA_STATI_DTU A, APPUSER.TIPOLG_RICH_COMSTNOW B&#xa;WHERE B.IDRICH_COM_STRC = A.IDRICH_COM_STRC_SUCCV&#xa;AND B.STATO_RICH_NOW = 'ESPLETAMENTOTECNICOKO'&#xa;AND A.COD_MACCHINA_STATI_DTU = (SELECT A.COD_MACCHINA_A_STATI_DTU&#xa;FROM AMBITO_DTU A, TIPOLG_LAVRZ LAV, TRASCODFC_OFFERTA OFFR&#xa;WHERE OFFR.NOME_OFFERTA_ESTERNA = ? AND OFFR.PROVENIENZA = 'BPM' AND OFFR.ID_OFFERTA = A.ID_OFFERTA&#xa;AND LAV.TIPOLG_LAVRZ = ? AND LAV.IDTPLG_LAVRZ = A.IDTPLG_LAVRZ&#xa;AND A.ID_SCENARIO = (SELECT ID_SCENARIO&#xa;FROM TIPOLG_SCENARIO&#xa;WHERE SCENARIO_BPM = ?))&#xa;AND (A.IDTPLG_EVENTO = 'ESPLETAMENTO_KO_NP103' AND A.STRUTTURA_RICH_RECIPIENT IN ('NPG') AND (COD_TIPOLG_NOTF_RECIPIENT = 'TC18' OR COD_TIPOLG_NOTF_RECIPIENT is null))&#xa;ORDER BY A.COD_MACCHINA_STATI_DTU&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SCENARIO_BPM"/>
                                    <columnMetadata
                                    columnName="COD_MACCHINA_STATI_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF_DONOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COMPONENTE_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COMPONENTE_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CalcoloNotificaDaInviare"
                    name="NotificaEspletamentoKO_DEL103"
                    outputVariable="CalcoloNotificaDaInviare"
                    tibex:xpdlId="61f0a140-ee04-4fb2-89ca-17fd86660d5d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLOG_Output"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ToolScartoUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQueryPreDelivery&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;CalcoloNotificaDaInviare&quot; match=&quot;/&quot;>&lt;tns:CalcoloPostPreDelivery>&lt;xsl:if test=&quot;string-length(string($JDBCQuery/Record[1]/COD_TIPOLG_NOTF_RECIPIENT)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF_RECIPIENT&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQuery/Record[1]/COD_TIPOLG_NOTF_DONOR)) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $Start/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;) and $Start/codificaOLOAGCOM != &amp;quot;TLC&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONOR&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo) > 0 and $Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo != &amp;quot;TLC&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONOR&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQuery/Record[1]/COD_TIPOLG_NOTF_DONATING)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF_DONATING&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COMPONENTE_DONATING = &amp;quot;CONSISTENZAFONIA&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COMPONENTE_DONATING = &amp;quot;CONSISTENZADATI&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQuery/Record[1]/COD_TIPOLG_NOTF_DPP_DONATING)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF_DPP_DONATING&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta='NPG' and count($JDBCQueryPreDelivery/Record)=0&quot;>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTOTECNICOKO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:DoppioDonating>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COMPONENTE_DPP_DONATING = &amp;quot;CONSISTENZAFONIA&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/COMPONENTE_DPP_DONATING = &amp;quot;CONSISTENZADATI&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;/tns:CalcoloPostPreDelivery>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CalcoloNotificaDaInviare" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
