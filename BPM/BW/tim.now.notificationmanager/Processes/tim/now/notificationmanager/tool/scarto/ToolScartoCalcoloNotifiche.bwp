                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_TIPOLG_NOTF, IDTPLG_STNTF_FILE_ORARIO, IDTPLG_DESTNRIO_NOTF&#xa;FROM RICH_ORDN_COMUNIC_NOTF&#xa;WHERE ID_RICH_OLO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
