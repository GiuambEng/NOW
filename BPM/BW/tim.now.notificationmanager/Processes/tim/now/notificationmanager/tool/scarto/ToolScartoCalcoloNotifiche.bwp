            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CalcoloNotificaDaInviare"
                    name="NotificaEspletamentoKO"
                    outputVariable="CalcoloNotificaDaInviare"
                    tibex:xpdlId="cfdc81de-4c0f-4197-8de7-2b72a209ed04" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToAssign"/>
