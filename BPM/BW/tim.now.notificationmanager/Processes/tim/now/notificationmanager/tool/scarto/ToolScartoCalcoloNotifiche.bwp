            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryPreDelivery-input"
                    name="JDBCQueryPreDelivery"
                    outputVariable="JDBCQueryPreDelivery"
                    tibex:xpdlId="7081a3b9-7b68-4a85-b994-9ea0dab9158c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryPreDeliveryToJDBCQueryNotf"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7081a3b9-7b68-4a85-b994-9ea0dab9158c+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryPreDelivery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_RICH_OLO&#xa;FROM STAG_RISPOSTA_DTU&#xa;WHERE ID_RICH_OLO = ? AND ID_STATO_ELAB_STAG = '11' AND IDTPLG_EVENTO = '1'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_PreDelivery-input"
                    name="LOG_PreDelivery"
                    tibex:xpdlId="3a9e1be4-a338-4e16-80b8-2d852612a322"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryNotfToLOG_PreDelivery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_PreDeliveryToJDBCQuery1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBCQueryPreDelivery/Record) or (not(exists($JDBCQueryPreDelivery/Record)) and exists($JDBCQueryNotf/Record[IDTPLG_DESTNRIO_NOTF = 3 and IDTPLG_STNTF_FILE_ORARIO != 3 and IDTPLG_STNTF_FILE_ORARIO != 6]))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($JDBCQueryPreDelivery/Record) or (not(exists($JDBCQueryPreDelivery/Record)) and exists($JDBCQueryNotf/Record[IDTPLG_DESTNRIO_NOTF = 3 and IDTPLG_STNTF_FILE_ORARIO != 3 and IDTPLG_STNTF_FILE_ORARIO != 6]))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_PREDELIVERY">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQueryPreDelivery&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:template name=&quot;LOG_PreDelivery-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ToolScartoRecuperoTracciato&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ToolScartoRecuperoTracciato&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ToolScartoRecuperoTracciato&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryPreDelivery/Record)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;QueryPreDelivery: &amp;quot;, tib:render-xml($JDBCQueryPreDelivery/Record[1], true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record recuperato per la QueryPreDelivery.&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryKO-KD-input"
                    name="JDBCQueryKO-KD"
                    outputVariable="JDBCQueryKO-KD"
                    tibex:xpdlId="c6102478-694a-4266-a629-647ee372ffce" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToJDBCQueryKO-KD"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c6102478-694a-4266-a629-647ee372ffce+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryKO-KD-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_OFFERTA_ESTERNA>&lt;TIPOLG_LAVRZ>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/lavorazione)&quot;>&lt;xsl:value-of select=&quot;$Start/lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIPOLG_LAVRZ>&lt;SCENARIO_BPM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tipologiaScenario)&quot;>&lt;xsl:value-of select=&quot;$Start/tipologiaScenario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SCENARIO_BPM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT A.COD_MACCHINA_STATI_DTU, A.COD_TIPOLG_NOTF_RECIPIENT, A.COD_TIPOLG_NOTF_DONOR, A.COD_TIPOLG_NOTF_DONATING, A.COD_TIPOLG_NOTF_DPP_DONATING, A.COMPONENTE_DONATING, A.COMPONENTE_DPP_DONATING&#xa;FROM APPUSER.MACCHINA_STATI_DTU A, APPUSER.TIPOLG_RICH_COMSTNOW B&#xa;WHERE B.IDRICH_COM_STRC = A.IDRICH_COM_STRC_SUCCV&#xa;AND B.STATO_RICH_NOW = 'ESPLETAMENTOTECNICOKO'&#xa;AND A.COD_MACCHINA_STATI_DTU = (SELECT A.COD_MACCHINA_A_STATI_DTU&#xa;FROM AMBITO_DTU A, TIPOLG_LAVRZ LAV, TRASCODFC_OFFERTA OFFR&#xa;WHERE OFFR.NOME_OFFERTA_ESTERNA = ? AND OFFR.PROVENIENZA = 'BPM' AND OFFR.ID_OFFERTA = A.ID_OFFERTA&#xa;AND LAV.TIPOLG_LAVRZ = ? AND LAV.IDTPLG_LAVRZ = A.IDTPLG_LAVRZ&#xa;AND A.ID_SCENARIO = (SELECT ID_SCENARIO&#xa;FROM TIPOLG_SCENARIO&#xa;WHERE SCENARIO_BPM = ?))&#xa;AND ((A.IDTPLG_EVENTO = 'ESPLETAMENTO_KO' AND A.STRUTTURA_RICH_RECIPIENT IN ('XDSL','NGA') AND COD_TIPOLG_NOTF_RECIPIENT IN ('KO','KD'))&#xa;    OR (A.IDTPLG_EVENTO = 'ESPLETAMENTO_KO' AND A.STRUTTURA_RICH_RECIPIENT IN ('REGOLATORIO') AND COD_TIPOLG_NOTF_RECIPIENT = 'KD')&#xa;    OR (A.IDTPLG_EVENTO = 'ESPLETAMENTO_KO_NP' AND A.STRUTTURA_RICH_RECIPIENT IN ('NPG') AND COD_TIPOLG_NOTF_RECIPIENT = 'TC6'))&#xa;AND (A.COD_TIPOLG_NOTF_DONOR IS NULL OR A.COD_TIPOLG_NOTF_DONOR = 'KD')&#xa;AND NOT(A.COD_MACCHINA_STATI_DTU LIKE 'MIGREG_RIENTROTI_DONATINGBTS%' AND COD_TIPOLG_NOTF_DONATING = 'KO')&#xa;AND NOT(A.COD_MACCHINA_STATI_DTU = 'VDECRULLNP' AND COD_TIPOLG_NOTF_RECIPIENT = 'TC6')&#xa;AND NOT(A.COD_MACCHINA_STATI_DTU = 'VDECRULLDNP' AND COD_TIPOLG_NOTF_RECIPIENT = 'TC6')&#xa;AND NOT(A.COD_MACCHINA_STATI_DTU = 'VDECRSLUNP' AND COD_TIPOLG_NOTF_RECIPIENT = 'TC6')&#xa;ORDER BY A.COD_MACCHINA_STATI_DTU" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SCENARIO_BPM"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_MACCHINA_STATI_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_TIPOLG_NOTF_RECIPIENT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="COD_TIPOLG_NOTF_DONOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="COD_TIPOLG_NOTF_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="COD_TIPOLG_NOTF_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="COMPONENTE_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="COMPONENTE_DPP_DONATING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CalcoloNotificaDaInviare"
                    name="NotificaAcquisitoKO"
                    outputVariable="CalcoloNotificaDaInviare"
                    tibex:xpdlId="f1afae34-3c3f-46d8-ba6d-14b5fe946853" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_PREDELIVERY"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NotificaAcquisitoKOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ToolScartoUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CalcoloNotificaDaInviare&quot; match=&quot;/&quot;>&lt;tns:CalcoloPostPreDelivery>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tipologiaScenario = &amp;quot;CNPCROLO&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;&amp;quot;TC12&amp;quot;&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;&amp;quot;TC12&amp;quot;&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;&amp;quot;TC12&amp;quot;&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tipoComunicazioneNP = &amp;quot;PORTIN&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;&amp;quot;TC2&amp;quot;&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;&amp;quot;TC4&amp;quot;&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONOR&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:CalcoloPostPreDelivery>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
