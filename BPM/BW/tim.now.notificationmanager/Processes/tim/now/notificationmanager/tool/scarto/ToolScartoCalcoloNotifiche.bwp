                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ToolScartoUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBCQueryKO-KC&quot;/>&lt;xsl:template name=&quot;CalcoloNotificaDaInviare&quot; match=&quot;/&quot;>&lt;tns:CalcoloPostPreDelivery>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_RECIPIENT)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_RECIPIENT&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_DONOR)) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $Start/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;) and $Start/codificaOLOAGCOM != &amp;quot;TLC&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONOR&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo) > 0 and $Start/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONOR&amp;quot;]/valoreAttributo != &amp;quot;TLC&amp;quot;&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_DONOR&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONOR&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;/tns:NotificaDaInviare>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_DONATING)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_DONATING&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:DoppioDonating>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryKO-KC/Record[1]/COMPONENTE_DONATING = &amp;quot;CONSISTENZAFONIA&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryKO-KC/Record[1]/COMPONENTE_DONATING = &amp;quot;CONSISTENZADATI&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_DPP_DONATING)) > 0&quot;>&lt;tns:NotificaDaInviare>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQueryKO-KC/Record[1]/COD_TIPOLG_NOTF_DPP_DONATING&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:TipologiaDestinatario>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/tns:TipologiaDestinatario>&lt;tns:StatoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;SCARTATO&amp;quot;&quot;/>&lt;/tns:StatoRichiesta>&lt;tns:DoppioDonating>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:DoppioDonating>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQueryKO-KC/Record[1]/COMPONENTE_DPP_DONATING = &amp;quot;CONSISTENZAFONIA&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQueryKO-KC/Record[1]/COMPONENTE_DPP_DONATING = &amp;quot;CONSISTENZADATI&amp;quot;&quot;>&lt;tns:IDAssetConsistenza>&lt;xsl:value-of select=&quot;xsd:long($Start/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:IDAssetConsistenza>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:NotificaDaInviare>&lt;/xsl:if>&lt;/tns:CalcoloPostPreDelivery>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
