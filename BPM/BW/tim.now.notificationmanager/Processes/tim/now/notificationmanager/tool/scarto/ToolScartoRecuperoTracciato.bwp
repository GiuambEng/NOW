            name="JDBCQueryTracciamento-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet"
            name="JDBCQueryTracciamento" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
