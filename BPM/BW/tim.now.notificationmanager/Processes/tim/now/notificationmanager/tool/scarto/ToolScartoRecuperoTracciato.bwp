                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CONTENUTO_TRACC, ID_EVENTO_ORDN_NOW_WHLS, ID_TRACC&#xa;FROM RICH_ORDN_COMUNIC_TRACC&#xa;WHERE ID_RICH_OLO = ?&#xa;ORDER BY TIMSTP_TRACC DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
