                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LOG_TracciamentoToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseXmlToEnd" tibex:linkType="SUCCESS"/>
