                                    tibex:xpdlId="3053199b-c7a9-4ca1-ad8e-853114f9a023" variable="ReplyNotificationInterfaccia-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns12="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceName" version="2.0"&gt;
    &lt;xsl:param name="CreateNotification"/&gt;
    &lt;xsl:param name="ServiceNameInvoke"/&gt;
    &lt;xsl:template name="ReplyNotificationInterfaccia-input" match="/"&gt;
        &lt;tns12:CreateNotificationFault&gt;
            &lt;NotificaFault&gt;
                &lt;tns1:NotificationFault&gt;
                    &lt;tns1:Codice&gt;
                        &lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;
                    &lt;/tns1:Codice&gt;
                    &lt;tns1:Descrizione&gt;
                        &lt;xsl:value-of select="concat(&amp;quot;Tipologia notifica '&amp;quot;, $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica, &amp;quot;' non gestita in ambito &amp;quot;, $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta, &amp;quot; per lavorazione &amp;quot;, $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Lavorazione, &amp;quot;.&amp;quot;)"/&gt;
                    &lt;/tns1:Descrizione&gt;
                &lt;/tns1:NotificationFault&gt;
            &lt;/NotificaFault&gt;
        &lt;/tns12:CreateNotificationFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationManager/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyNotificationInterfaccia-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificationFault>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;tns1:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Tipologia notifica '&amp;quot;, $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica, &amp;quot;' non gestita in ambito &amp;quot;, $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta, &amp;quot; per lavorazione &amp;quot;, $ServiceNameInvoke.Ouptut/tns:Lavorazione, &amp;quot;.&amp;quot;)&quot;/>&#xa;            &lt;/tns1:Descrizione>&#xa;        &lt;/tns1:NotificationFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="SetEPR_NotificationToReplyNotificationInterfaccia"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ReplyNotificationInterfacciaToExit2"/>
                                    </bpws:sources>
                                    </bpws:reply>
                                    <bpws:invoke
                                    inputVariable="ServiceNameInvoke-input"
                                    name="ServiceNameInvoke"
                                    operation="ServiceName"
                                    outputVariable="ServiceNameInvoke"
                                    partnerLink="ServiceName"
                                    portType="ns44:ServiceNamePortType" tibex:xpdlId="fe20beae-8693-4300-b2c8-6fb0fae371d6">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:tns12="http://www.tim.com/NOW/wsdl/abstract/ServiceName/" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceName" version="2.0"&gt;
    &lt;xsl:param name="CreateNotification"/&gt;
    &lt;xsl:param name="Donor-Donating"/&gt;
    &lt;xsl:param name="ServiceName"/&gt;
    &lt;xsl:template name="ServiceNameInvoke-input" match="/"&gt;
        &lt;tns12:ServiceNameRequest&gt;
            &lt;input&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="$Donor-Donating = true()"&gt;
                        &lt;tns:ServiceNameRequest&gt;
                            &lt;!--DONOR/DONATING != NP--&gt;
                            &lt;tns:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$ServiceName/tns:StrutturaRichiesta"/&gt;
                            &lt;/tns:StrutturaRichiesta&gt;
                            &lt;tns:TipologiaNotifica&gt;
                                &lt;xsl:value-of select="$ServiceName/tns:TipologiaNotifica"/&gt;
                            &lt;/tns:TipologiaNotifica&gt;
                            &lt;xsl:if test="$ServiceName/tns:Offerta"&gt;
                                &lt;tns:Offerta&gt;
                                    &lt;xsl:value-of select="$ServiceName/tns:Offerta"/&gt;
                                &lt;/tns:Offerta&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns:Lavorazione&gt;
                                &lt;xsl:value-of select="$ServiceName/tns:Lavorazione"/&gt;
                            &lt;/tns:Lavorazione&gt;
                            &lt;tns:TipologiaOLODestinatario&gt;
                                &lt;xsl:value-of select="$ServiceName/tns:TipologiaOLODestinatario"/&gt;
                            &lt;/tns:TipologiaOLODestinatario&gt;
                            &lt;xsl:if test="$ServiceName/tns:CodificaOLOAGCOMDestinatario"&gt;
                                &lt;tns:CodificaOLOAGCOMDestinatario&gt;
                                    &lt;xsl:value-of select="$ServiceName/tns:CodificaOLOAGCOMDestinatario"/&gt;
                                &lt;/tns:CodificaOLOAGCOMDestinatario&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ServiceName/tns:IDRichiestaOLO"&gt;
                                &lt;tns:IDRichiestaOLO&gt;
                                    &lt;xsl:value-of select="$ServiceName/tns:IDRichiestaOLO"/&gt;
                                &lt;/tns:IDRichiestaOLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$ServiceName/tns:IDAsset"&gt;
                                &lt;tns:IDAsset&gt;
                                    &lt;xsl:value-of select="$ServiceName/tns:IDAsset"/&gt;
                                &lt;/tns:IDAsset&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:ServiceNameRequest&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns:ServiceNameRequest&gt;
                            &lt;!--RECIPIENT o NP--&gt;
                            &lt;tns:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta"/&gt;
                            &lt;/tns:StrutturaRichiesta&gt;
                            &lt;tns:TipologiaNotifica&gt;
                                &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica"/&gt;
                            &lt;/tns:TipologiaNotifica&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta) = 0 or exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta) = false()"&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta = &amp;quot;FWA&amp;quot;"&gt;
                                            &lt;tns:Offerta&gt;
                                                &lt;xsl:value-of select="'FIXEDWIRELESSACCESS'"/&gt;
                                            &lt;/tns:Offerta&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;"&gt;
                                            &lt;tns:Offerta&gt;
                                                &lt;xsl:value-of select="&amp;quot;ULLLINEANONATTIVA&amp;quot;"/&gt;
                                            &lt;/tns:Offerta&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta = &amp;quot;NGA&amp;quot;"&gt;
                                            &lt;tns:Offerta&gt;
                                                &lt;xsl:value-of select="&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;"/&gt;
                                            &lt;/tns:Offerta&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns:Offerta&gt;
                                                &lt;xsl:value-of select="&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;"/&gt;
                                            &lt;/tns:Offerta&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta"&gt;
                                        &lt;tns:Offerta&gt;
                                            &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta"/&gt;
                                        &lt;/tns:Offerta&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;"&gt;
                                    &lt;tns:Lavorazione&gt;
                                        &lt;xsl:value-of select="&amp;quot;ATTIVAZIONE&amp;quot;"/&gt;
                                    &lt;/tns:Lavorazione&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns:Lavorazione&gt;
                                        &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/lavorazione"/&gt;
                                    &lt;/tns:Lavorazione&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaOLODestinatario) = false() or string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaOLODestinatario) = 0"&gt;
                                    &lt;tns:TipologiaOLODestinatario&gt;
                                        &lt;xsl:value-of select="&amp;quot;RECIPIENT&amp;quot;"/&gt;
                                    &lt;/tns:TipologiaOLODestinatario&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns:TipologiaOLODestinatario&gt;
                                        &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaOLODestinatario"/&gt;
                                    &lt;/tns:TipologiaOLODestinatario&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipologiaScenario = &amp;quot;NPSUWLR&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipologiaScenario = &amp;quot;NPSUVULL&amp;quot;)"&gt;
                                    &lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo"&gt;
                                        &lt;tns:CodificaOLOAGCOMDestinatario&gt;
                                            &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo"/&gt;
                                        &lt;/tns:CodificaOLOAGCOMDestinatario&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:CodificaOLOAGCOMDestinatario) and string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:CodificaOLOAGCOMDestinatario) &gt; 0"&gt;
                                    &lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:CodificaOLOAGCOMDestinatario"&gt;
                                        &lt;tns:CodificaOLOAGCOMDestinatario&gt;
                                            &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:CodificaOLOAGCOMDestinatario"/&gt;
                                        &lt;/tns:CodificaOLOAGCOMDestinatario&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns:CodificaOLOAGCOMDestinatario&gt;
                                        &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codificaOLOAGCOM"/&gt;
                                    &lt;/tns:CodificaOLOAGCOMDestinatario&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns:IDRichiestaOLO&gt;
                                &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO"/&gt;
                            &lt;/tns:IDRichiestaOLO&gt;
                            &lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDAssetConsistenza"&gt;
                                &lt;tns:IDAsset&gt;
                                    &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDAssetConsistenza"/&gt;
                                &lt;/tns:IDAsset&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103"&gt;
                                &lt;tns:Flag103&gt;
                                    &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103"/&gt;
                                &lt;/tns:Flag103&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:ServiceNameRequest&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/input&gt;
        &lt;/tns12:ServiceNameRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/wsdl/abstract/ServiceName/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Donor-Donating&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceName&quot;/>&#xa;    &lt;xsl:template name=&quot;ServiceNameInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$Donor-Donating = true()&quot;>&#xa;                &lt;tns:ServiceNameRequest>&#xa;                    &lt;!--DONOR/DONATING != NP-->&#xa;                    &lt;tns:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceName/tns:StrutturaRichiesta&quot;/>&#xa;                    &lt;/tns:StrutturaRichiesta>&#xa;                    &lt;tns:TipologiaNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceName/tns:TipologiaNotifica&quot;/>&#xa;                    &lt;/tns:TipologiaNotifica>&#xa;                    &lt;xsl:if test=&quot;$ServiceName/tns:Offerta&quot;>&#xa;                        &lt;tns:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;$ServiceName/tns:Offerta&quot;/>&#xa;                        &lt;/tns:Offerta>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceName/tns:Lavorazione&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                    &lt;tns:TipologiaOLODestinatario>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceName/tns:TipologiaOLODestinatario&quot;/>&#xa;                    &lt;/tns:TipologiaOLODestinatario>&#xa;                    &lt;xsl:if test=&quot;$ServiceName/tns:CodificaOLOAGCOMDestinatario&quot;>&#xa;                        &lt;tns:CodificaOLOAGCOMDestinatario>&#xa;                            &lt;xsl:value-of select=&quot;$ServiceName/tns:CodificaOLOAGCOMDestinatario&quot;/>&#xa;                        &lt;/tns:CodificaOLOAGCOMDestinatario>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ServiceName/tns:IDRichiestaOLO&quot;>&#xa;                        &lt;tns:IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ServiceName/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$ServiceName/tns:IDAsset&quot;>&#xa;                        &lt;tns:IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$ServiceName/tns:IDAsset&quot;/>&#xa;                        &lt;/tns:IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:ServiceNameRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:ServiceNameRequest>&#xa;                    &lt;!--RECIPIENT o NP-->&#xa;                    &lt;tns:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta&quot;/>&#xa;                    &lt;/tns:StrutturaRichiesta>&#xa;                    &lt;tns:TipologiaNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica&quot;/>&#xa;                    &lt;/tns:TipologiaNotifica>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta) = 0 or exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta) = false()&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                                    &lt;tns:Offerta>&#xa;                                        &lt;xsl:value-of select=&quot;'FIXEDWIRELESSACCESS'&quot;/>&#xa;                                    &lt;/tns:Offerta>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                                    &lt;tns:Offerta>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&#xa;                                    &lt;/tns:Offerta>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                                    &lt;tns:Offerta>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&#xa;                                    &lt;/tns:Offerta>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:Offerta>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                                    &lt;/tns:Offerta>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                            &lt;tns:Lavorazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                            &lt;/tns:Lavorazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Lavorazione>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione&quot;/>&#xa;                            &lt;/tns:Lavorazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/tns1:TipologiaOLODestinatario) = false() or string-length($CreateNotification.NotificaRichiesta/tns1:TipologiaOLODestinatario) = 0&quot;>&#xa;                            &lt;tns:TipologiaOLODestinatario>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;RECIPIENT&amp;quot;&quot;/>&#xa;                            &lt;/tns:TipologiaOLODestinatario>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:TipologiaOLODestinatario>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaOLODestinatario&quot;/>&#xa;                            &lt;/tns:TipologiaOLODestinatario>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/tipologiaScenario = &amp;quot;NPSUWLR&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/tipologiaScenario = &amp;quot;NPSUVULL&amp;quot;)&quot;>&#xa;                            &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;tns:CodificaOLOAGCOMDestinatario>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/tns:CodificaOLOAGCOMDestinatario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/tns1:CodificaOLOAGCOMDestinatario) and string-length($CreateNotification.NotificaRichiesta/tns1:CodificaOLOAGCOMDestinatario) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/tns1:CodificaOLOAGCOMDestinatario&quot;>&#xa;                                &lt;tns:CodificaOLOAGCOMDestinatario>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:CodificaOLOAGCOMDestinatario&quot;/>&#xa;                                &lt;/tns:CodificaOLOAGCOMDestinatario>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:CodificaOLOAGCOMDestinatario>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;                            &lt;/tns:CodificaOLOAGCOMDestinatario>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:IDRichiestaOLO>&#xa;                    &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/tns1:IDAssetConsistenza&quot;>&#xa;                        &lt;tns:IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:IDAssetConsistenza&quot;/>&#xa;                        &lt;/tns:IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103&quot;>&#xa;                        &lt;tns:Flag103>&#xa;                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103&quot;/>&#xa;                        &lt;/tns:Flag103>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:ServiceNameRequest>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
