                                    expression="$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;SCARTATO&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;ACCODATO&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;SOSPESO&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;ESPLETAMENTOTECNICOKO&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;ANNULLATO&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;SOSPESOCONNOTIFICAFS&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO = "SCARTATO" or $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO = "ACCODATO" or $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO = "SOSPESO" or $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO = "ESPLETAMENTOTECNICOKO" or $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO = "ANNULLATO" or $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO = "SOSPESOCONNOTIFICAFS"]]></bpws:transitionCondition>
