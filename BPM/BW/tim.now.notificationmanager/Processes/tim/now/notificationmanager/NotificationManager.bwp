                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CreateNotification&quot;/>&lt;xsl:param name=&quot;NotificationInvoke&quot;/>&lt;xsl:param name=&quot;JDBC_ID_NOTIFICA&quot;/>&lt;xsl:param name=&quot;ServiceNameInvoke&quot;/>&lt;xsl:param name=&quot;JDBC_CODIFICA_OLO_NOW&quot;/>&lt;xsl:param name=&quot;CheckSendFile&quot;/>&lt;xsl:template name=&quot;SendEmailInvoke-input&quot; match=&quot;/&quot;>&lt;tns2:EmailRequest>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:TipologiaNotifica !=&amp;quot;ON&amp;quot; and $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:TipologiaNotifica !=&amp;quot;OFF&amp;quot; and $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta!='FWA' and $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta!='FWAITALIA1GIGASARDEGNA'&quot;>&lt;tns2:RichiestaGenerica>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio)&quot;>&lt;xsl:copy-of select=&quot;$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns2:RICHIESTA_NGA)&quot;>&lt;xsl:copy-of select=&quot;$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns2: