otification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/routingNumber"/&gt;&lt;/routingNumber&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/progressivoEmissioneDTU"&gt;&lt;progressivoEmissioneDTU&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/progressivoEmissioneDTU"/&gt;&lt;/progressivoEmissioneDTU&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagAttesaDesospOLO"&gt;&lt;flagAttesaDesospOLO&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagAttesaDesospOLO"/&gt;&lt;/flagAttesaDesospOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDeliveryExposed"&gt;&lt;flagDeliveryExposed&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDeliveryExposed"/&gt;&lt;/flagDeliveryExposed&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/disaggregato"&gt;&lt;disaggregato&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/disaggregato"/&gt;&lt;/disaggregato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/exDisaggregato"&gt;&lt;exDisaggregato&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/exDisaggregato"/&gt;&lt;/exDisaggregato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/FFACQKO"&gt;&lt;FFACQKO&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/FFACQKO"/&gt;&lt;/FFACQKO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/idProgressivoNotificheFF"&gt;&lt;idProgressivoNotificheFF&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/idProgressivoNotificheFF"/&gt;&lt;/idProgressivoNotificheFF&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103"&gt;&lt;flagDelibera103&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103"/&gt;&lt;/flagDelibera103&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOperatoreReturning"&gt;&lt;codiceOperatoreReturning&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOperatoreReturning"/&gt;&lt;/codiceOperatoreReturning&gt;&lt;/xsl:if&gt;&lt;/tns2:Richiesta&gt;&lt;xsl:if test="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta"&gt;&lt;tns2:Offerta&gt;&lt;xsl:value-of select="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta"/&gt;&lt;/tns2:Offerta&gt;&lt;/xsl:if&gt;&lt;tns2:TipologiaNotifica&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica"/&gt;&lt;/tns2:TipologiaNotifica&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDEventoOrdineNOW)"&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDEventoOrdineNOW"&gt;&lt;tns2:IDEventoOrdineNOW&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDEventoOrdineNOW"/&gt;&lt;/tns2:IDEventoOrdineNOW&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;tns2:TipologiaOLODestinatario&gt;&lt;xsl:value-of select="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:TipologiaOLODestinatario"/&gt;&lt;/tns2:TipologiaOLODestinatario&gt;&lt;xsl:if test="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:CodificaOLOAGCOMDestinatario"&gt;&lt;tns2:CodificaOLOAGCOMDestinatario&gt;&lt;xsl:value-of select="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:CodificaOLOAGCOMDestinatario"/&gt;&lt;/tns2:CodificaOLOAGCOMDestinatario&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:FlagKORiscontroCodiceSessione"&gt;&lt;tns2:FlagKORiscontroCodiceSessione&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:FlagKORiscontroCodiceSessione"/&gt;&lt;/tns2:FlagKORiscontroCodiceSessione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDAssetConsistenza"&gt;&lt;tns2:IDAssetConsistenza&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDAssetConsistenza"/&gt;&lt;/tns2:IDAssetConsistenza&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($StatoOrdine) and string-length($StatoOrdine) &gt; 0"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="$StatoOrdine"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/cowCodeOLO) &gt; 0 and string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/cowCodeOLO2) &gt; 0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/cowCodeOLO = $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/cowCodeOLO2"&gt;&lt;xsl:if test="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:IDAsset"&gt;&lt;tns2:IDAssetDoppioDonating&gt;&lt;xsl:value-of select="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:IDAsset"/&gt;&lt;/tns2:IDAssetDoppioDonating&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;/tns2:NotificaGenericaRequest&gt;&lt;/NotificaGenericaRichiesta&gt;&lt;/tns7:GenericNotificationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns6=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataRegolatorio&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;NotificationInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NotificaGenericaRequest>&#xa;            &lt;tns2:TestataNotifica>&#xa;                &lt;xsl:if test=&quot;exists($TestataRegolatorio/tns2:TestataRegolatorio) and $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta !=&amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$TestataRegolatorio/tns2:TestataRegolatorio&quot;/>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TestataRegolatorio/tns2:TestataVsRecipient)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$TestataRegolatorio/tns2:TestataVsRecipient&quot;/>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TestataRegolatorio/tns2:TestataVsDonorDonating)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$TestataRegolatorio/tns2:TestataVsDonorDonating&quot;/>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TestataRegolatorio/tns2:Testata) and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta !='FWA'&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$TestataRegolatorio/tns2:Testata&quot;/>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($TestataRegolatorio/tns2:Testata) and $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;tns2:TestataFWA>&#xa;                        &lt;tns2:CodiceFornitore>&#xa;                            &lt;xsl:value-of select=&quot;$TestataRegolatorio/tns2:Testata/tns6:CodiceFornitore&quot;/>&#xa;                        &lt;/tns2:CodiceFornitore>&#xa;                        &lt;xsl:if test=&quot;$TestataRegolatorio/tns2:Testata/tns6:CodiceOrdineFornitore&quot;>&#xa;                            &lt;tns2:CodiceOrdineFornitore>&#xa;                                &lt;xsl:value-of select=&quot;$TestataRegolatorio/tns2:Testata/tns6:CodiceOrdineFornitore&quot;/>&#xa;                            &lt;/tns2:CodiceOrdineFornitore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:CodiceOrdineRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$TestataRegolatorio/tns2:Testata/tns6:CodiceOrdineRichiedente&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineRichiedente>&#xa;                        &lt;tns2:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;substring($TestataRegolatorio/tns2:Testata/tns6:DataNotifica,1,10)&quot;/>&#xa;                        &lt;/tns2:DataNotifica>&#xa;                        &lt;tns2:StatoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$TestataRegolatorio/tns2:Testata/tns6:StatoOrdine&quot;/>&#xa;                        &lt;/tns2:StatoOrdine>&#xa;                        &lt;xsl:if test=&quot;$TestataRegolatorio/tns2:Testata/tns6:DataDRO&quot;>&#xa;                            &lt;tns2:DataDRO>&#xa;                                &lt;xsl:value-of select=&quot;$TestataRegolatorio/tns2:Testata/tns6:DataDRO&quot;/>&#xa;                            &lt;/tns2:DataDRO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:TestataFWA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&#xa;                    &lt;tns2:TestataFBS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=0 and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/codificaOLOAGCOM='TLC'&quot;>&#xa;                                &lt;tns2:CodiceFornitore>&#xa;                                    &lt;xsl:value-of select=&quot;'FOP'&quot;/>&#xa;                                &lt;/tns2:CodiceFornitore>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:CodiceFornitore>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;                                &lt;/tns2:CodiceFornitore>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('RA','RR','RS','OR')&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;>&#xa;                                    &lt;tns2:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;/>&#xa;                                    &lt;/tns2:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;>&#xa;                                    &lt;tns2:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;/>&#xa;                                    &lt;/tns2:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('RA','RR','RS','OR')&quot;>&#xa;                                &lt;tns2:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                &lt;/tns2:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/codiceOrdineOLO&quot;/>&#xa;                                &lt;/tns2:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;substring(format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;),1,10)&quot;/>&#xa;                        &lt;/tns2:DataNotifica>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('AQ','OR','KO')) or ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('PA','RD') and not($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO')) and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOF='ACQUISITOOK') or ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='RS' and not($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW='SCARTATO'))&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('RR','RA') or ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='RS' and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW='SCARTATO')&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('AC','KC')) or ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('PA','RD') and not($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO')) and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOF='ACCETTATOOK')&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'2'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='CO'&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'3'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('AT','EK')) or ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='SU' and not($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO')))&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'4'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='OK'&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'5'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='KD' and not($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW='ANNULLATO')&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'6'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='KD' and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW='ANNULLATO'&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'7'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('TC','SP')) or ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica=('PA','RD','SU') and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO'))&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'8'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='DS'&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'9'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='FS'&quot;>&#xa;                                &lt;tns2:StatoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;'10'&quot;/>&#xa;                                &lt;/tns2:StatoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='KO'&quot;>&#xa;                                &lt;tns2:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataDRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;concat(format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),' 00:00')&quot;/>&#xa;                                &lt;/tns2:DataDRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/codiceOrdineOpenFiber)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;>&#xa;                                &lt;tns2:CodiceOrdineOF>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/codiceOrdineOpenFiber&quot;/>&#xa;                                &lt;/tns2:CodiceOrdineOF>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOF)=0&quot;/>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOF=('ESPLETATOOK','ESPLETATOKO','ANNULLATOOF')&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/note&quot;>&#xa;                                    &lt;tns2:Note>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/note&quot;/>&#xa;                                    &lt;/tns2:Note>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/noteFiberStream)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/noteFiberStream&quot;>&#xa;                                            &lt;tns2:Note>&#xa;                                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/noteFiberStream&quot;/>&#xa;                                            &lt;/tns2:Note>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/note&quot;>&#xa;                                            &lt;tns2:Note>&#xa;                                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/note&quot;/>&#xa;                                            &lt;/tns2:Note>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:TimestampOrigine>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:TimestampOrigine>&#xa;                    &lt;/tns2:TestataFBS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:TestataNotifica>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaPrecedNOW&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaPrecedNOW&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO&quot;>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaPrecedOLO&quot;>&#xa;                    &lt;statoRichiestaPrecedOLO>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaPrecedOLO&quot;/>&#xa;                    &lt;/statoRichiestaPrecedOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/sottostatoLavorManuale&quot;>&#xa;                    &lt;sottostatoLavorManuale>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/sottostatoLavorManuale&quot;/>&#xa;                    &lt;/sottostatoLavorManuale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDFileInput&quot;>&#xa;                    &lt;IDFileInput>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDFileInput&quot;/>&#xa;                    &lt;/IDFileInput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDFileOutput&quot;>&#xa;                    &lt;IDFileOutput>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDFileOutput&quot;/>&#xa;                    &lt;/IDFileOutput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ambito&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ambito&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:if>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/canaleRichiesta&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta='CPS' or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta='CESSAZIONECPS' or $ServiceNameInvoke.Ouptut/tns:Offerta='CPS') and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione='MIGRAZIONE'&quot;>&#xa;                        &lt;lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                        &lt;/lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;(starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta, 'ULL') or starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta, 'SLU')) and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione='ATTIVAZIONE' and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOMDONATING']/valoreAttributo='TLC' and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='CONSISTENZADATI']/attributiDettaglioOrdine[nomeAttributo='OFFERTA']/valoreAttributo='VULAFTTCAB' and $CreateNotification.NotificaRichiesta/tns1:TipologiaOLODestinatario='DONATING'&quot;>&#xa;                        &lt;lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;'MIGRAZIONE'&quot;/>&#xa;                        &lt;/lavorazione>&#xa;                    &lt;/xsl:when>&#xa;             