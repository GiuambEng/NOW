iesta/ns:RichiestaElement/cowCodeOLO2) > 0 and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO = $CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO2&quot;>&#xa;                &lt;xsl:if test=&quot;$ServiceNameInvoke.Ouptut/tns:IDAsset&quot;>&#xa;                    &lt;tns2:IDAssetDoppioDonating>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:IDAsset&quot;/>&#xa;                    &lt;/tns2:IDAssetDoppioDonating>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:NotificaGenericaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
