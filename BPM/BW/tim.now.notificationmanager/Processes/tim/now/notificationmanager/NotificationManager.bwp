                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CreateNotification&quot;/>&lt;xsl:param name=&quot;StatoOrdine&quot;/>&lt;xsl:param name=&quot;ServiceNameInvoke&quot;/>&lt;xsl:param name=&quot;CodiceOperatoreDonating&quot;/>&lt;xsl:param name=&quot;CodiceOrdineOLO&quot;/>&lt;xsl:param name=&quot;ContenutoXML&quot;/>&lt;xsl:param name=&quot;CodiceRisorsa&quot;/>&lt;xsl:template name=&quot;TestataRegolatorio&quot; match=&quot;/&quot;>&lt;tns2:TestataRegolatorio>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&lt;tns2:Testata>&lt;tns6:CodiceFornitore>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns6:CodiceFornitore>&lt;xsl:if test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO&quot;>&lt;tns6:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/tns6:CodiceOrdineFornitore>&lt;/xsl:if>&lt;tns6:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;substring($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&lt;/tns6:CodiceOrdineRichiedente>&lt;tns6:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns6:DataNotifica>&lt;tns6:StatoOrdine>&lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&lt;/tns6:StatoOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&lt;tns6:DataDRO>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns6:DataDRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns6:DataDRO>&lt;xsl:value-of select=&quot;format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns6:DataDRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:Testata>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='UBBSEMIGPON'  or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='UBBFULLGPON'&quot;>&lt;tns2:Testata>&lt;tns6:CodiceFornitore>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns6:CodiceFornitore>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&lt;xsl:if test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO&quot;>&lt;tns6:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/tns6:CodiceOrdineFornitore>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&lt;xsl:if test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTITarget&quot;>&lt;tns6:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTITarget&quot;/>&lt;/tns6:CodiceOrdineFornitore>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTI&quot;>&lt;tns6:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTI&quot;/>&lt;/tns6:CodiceOrdineFornitore>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($CodiceOrdineOLO/Record)>0&quot;>&lt;tns6:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;substring($CodiceOrdineOLO/Record[1]/CODICEORDINEOLO, 1, 11)&quot;/>&lt;/tns6:CodiceOrdineRichiedente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns6:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;substring($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&lt;/tns6:CodiceOrdineRichiedente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns6:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns6:DataNotifica>&lt;tns6:StatoOrdine>&lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&lt;/tns6:StatoOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&lt;tns6:DataDRO>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns6:DataDRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns6:DataDRO>&lt;xsl:value-of select=&quot;format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns6:DataDRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:Testata>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='SEMIGPON1BPNRR' or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='FULLGPON1BPNRR'&quot;>&lt;tns2:Testata>&lt;tns6:CodiceFornitore>&lt;xsl:value-of select=&quot;'FOP'&quot;/>&lt;/tns6:CodiceFornitore>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&lt;xsl:if test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO&quot;>&lt;tns6:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/tns6:CodiceOrdineFornitore>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&lt;xsl:if