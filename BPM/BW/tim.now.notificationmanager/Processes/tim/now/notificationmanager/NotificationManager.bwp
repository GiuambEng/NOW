                                    <bpws:invoke
                                    inputVariable="NotificationInvoke-input"
                                    name="NotificationInvoke"
                                    operation="GenericNotification"
                                    outputVariable="NotificationInvoke"
                                    partnerLink="Notification_Interfaccia"
                                    portType="ns35:Notification_reg_RimodulazioneDPS" tibex:xpdlId="554957fb-8b5a-471f-9cd2-5ef2ca81eba9">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns2="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceName" xmlns:tns6="http://xsd.telecomitalia.it/crm/fibercop" version="2.0"&gt;&lt;xsl:param name="CreateNotification"/&gt;&lt;xsl:param name="TestataRegolatorio"/&gt;&lt;xsl:param name="StatoOrdine"/&gt;&lt;xsl:param name="ServiceNameInvoke"/&gt;&lt;xsl:param name="ContenutoXML"/&gt;&lt;xsl:param name="Oscuramento"/&gt;&lt;xsl:template name="NotificationInvoke-input" match="/"&gt;&lt;tns7:GenericNotificationRequest&gt;&lt;NotificaGenericaRichiesta&gt;&lt;tns2:NotificaGenericaRequest&gt;&lt;tns2:TestataNotifica&gt;&lt;xsl:if test="exists($TestataRegolatorio/tns2:TestataRegolatorio) and $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta !=&amp;quot;FWA&amp;quot;"&gt;&lt;xsl:copy-of select="$TestataRegolatorio/tns2:TestataRegolatorio"/&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($TestataRegolatorio/tns2:TestataVsRecipient)"&gt;&lt;xsl:copy-of select="$TestataRegolatorio/tns2:TestataVsRecipient"/&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($TestataRegolatorio/tns2:TestataVsDonorDonating)"&gt;&lt;xsl:copy-of select="$TestataRegolatorio/tns2:TestataVsDonorDonating"/&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($TestataRegolatorio/tns2:Testata) and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta !='FWA'"&gt;&lt;xsl:copy-of select="$TestataRegolatorio/tns2:Testata"/&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($TestataRegolatorio/tns2:Testata) and $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;FWA&amp;quot;"&gt;&lt;tns2:TestataFWA&gt;&lt;tns2:CodiceFornitore&gt;&lt;xsl:value-of select="$TestataRegolatorio/tns2:Testata/tns6:CodiceFornitore"/&gt;&lt;/tns2:CodiceFornitore&gt;&lt;xsl:if test="$TestataRegolatorio/tns2:Testata/tns6:CodiceOrdineFornitore"&gt;&lt;tns2:CodiceOrdineFornitore&gt;&lt;xsl:value-of select="$TestataRegolatorio/tns2:Testata/tns6:CodiceOrdineFornitore"/&gt;&lt;/tns2:CodiceOrdineFornitore&gt;&lt;/xsl:if&gt;&lt;tns2:CodiceOrdineRichiedente&gt;&lt;xsl:value-of select="$TestataRegolatorio/tns2:Testata/tns6:CodiceOrdineRichiedente"/&gt;&lt;/tns2:CodiceOrdineRichiedente&gt;&lt;tns2:DataNotifica&gt;&lt;xsl:value-of select="substring($TestataRegolatorio/tns2:Testata/tns6:DataNotifica,1,10)"/&gt;&lt;/tns2:DataNotifica&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="$TestataRegolatorio/tns2:Testata/tns6:StatoOrdine"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;xsl:if test="$TestataRegolatorio/tns2:Testata/tns6:DataDRO"&gt;&lt;tns2:DataDRO&gt;&lt;xsl:value-of select="$TestataRegolatorio/tns2:Testata/tns6:DataDRO"/&gt;&lt;/tns2:DataDRO&gt;&lt;/xsl:if&gt;&lt;/tns2:TestataFWA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;"&gt;&lt;tns2:TestataFBS&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($Oscuramento/Record[COD_AGESP='T1PRJ0014959'])=0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codificaOLOAGCOM='TLC'"&gt;&lt;tns2:CodiceFornitore&gt;&lt;xsl:value-of select="'FOP'"/&gt;&lt;/tns2:CodiceFornitore&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:CodiceFornitore&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codificaOLOAGCOM"/&gt;&lt;/tns2:CodiceFornitore&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('RA','RR','RS','OR')"&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTITarget"&gt;&lt;tns2:CodiceOrdineFornitore&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTITarget"/&gt;&lt;/tns2:CodiceOrdineFornitore&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTI"&gt;&lt;tns2:CodiceOrdineFornitore&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTI"/&gt;&lt;/tns2:CodiceOrdineFornitore&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('RA','RR','RS','OR')"&gt;&lt;tns2:CodiceOrdineRichiedente&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO"/&gt;&lt;/tns2:CodiceOrdineRichiedente&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:CodiceOrdineRichiedente&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/codiceOrdineOLO"/&gt;&lt;/tns2:CodiceOrdineRichiedente&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns2:DataNotifica&gt;&lt;xsl:value-of select="substring(format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;),1,10)"/&gt;&lt;/tns2:DataNotifica&gt;&lt;xsl:choose&gt;&lt;xsl:when test="($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('AQ','OR','KO')) or ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('PA','RD') and not($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO')) and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOF='ACQUISITOOK') or ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='RS' and not($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW='SCARTATO'))"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'0'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('RR','RA') or ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='RS' and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW='SCARTATO')"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('AC','KC')) or ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('PA','RD') and not($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO')) and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOF='ACCETTATOOK')"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'2'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='CO'"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'3'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('AT','EK')) or ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='SU' and not($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO')))"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'4'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='OK'"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'5'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='KD' and not($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW='ANNULLATO')"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'6'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='KD' and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW='ANNULLATO'"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'7'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('TC','SP')) or ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica=('PA','RD','SU') and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW=('SOSPESO','SOSPESOAPPUNTAMENTO'))"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'8'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='DS'"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'9'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='FS'"&gt;&lt;tns2:StatoOrdine&gt;&lt;xsl:value-of select="'10'"/&gt;&lt;/tns2:StatoOrdine&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='KO'"&gt;&lt;tns2:DataDRO&gt;&lt;xsl:value-of select="format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)"/&gt;&lt;/tns2:DataDRO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:DataDRO&gt;&lt;xsl:value-of select="concat(format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),' 00:00')"/&gt;&lt;/tns2:DataDRO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/codiceOrdineOpenFiber)&gt;0"&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/codiceOrdineOpenFiber"&gt;&lt;tns2:CodiceOrdineOF&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/codiceOrdineOpenFiber"/&gt;&lt;/tns2:CodiceOrdineOF&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOF)=0"/&gt;&lt;xsl:when test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOF=('ESPLETATOOK','ESPLETATOKO','ANNULLATOOF')"&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/note"&gt;&lt;tns2:Note&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/note"/&gt;&lt;/tns2:Note&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/noteFiberStream)&gt;0"&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/noteFiberStream"&gt;&lt;tns2:Note&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/noteFiberStream"/&g