Query/Record[1]/ID_ANAG_CAUS)&quot;>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record ID_ANAG_CAUS Trovato&amp;quot;, tib:render-xml($JDBCQuery, true(), true()))&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Record ID_ANAG_CAUS non  Trovato'&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
