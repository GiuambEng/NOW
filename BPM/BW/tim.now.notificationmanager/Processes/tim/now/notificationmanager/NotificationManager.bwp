                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+519a5ebe-f861-49dc-9bbe-49ad425d2a2e+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ID_NOTIFICA&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:jdbcUpdateActivityInput>&#xa;            &lt;IDNOTIFICADONATING>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_ID_NOTIFICA/Record[1]/NEXTVAL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_ID_NOTIFICA/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDNOTIFICADONATING>&#xa;            &lt;IDANAGRAFICACAUSALEGUI>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationResponse/tns1:IdAnagraficaCausaleGUI)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$NotificationResponse/tns1:IdAnagraficaCausaleGUI&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>