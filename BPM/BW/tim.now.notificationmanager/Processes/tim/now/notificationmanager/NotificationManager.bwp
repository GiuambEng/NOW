                                    expression="$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:ServiceName = &quot;Notification_Interfaccia&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
