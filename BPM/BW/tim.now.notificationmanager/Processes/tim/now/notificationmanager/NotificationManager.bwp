                                    expression="if(($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;RD&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;ON&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;OFF&quot; &#xd;&#xa;and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;XDSL&quot;) or&#xd;&#xa;(($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;AQ&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;AK&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;AC&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;RR&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;SP&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;FS&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;CO&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;OK&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;KO&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;SU&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;KA&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;NL&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;SC&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;NP&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;TM&