                                    <bpws:reply faultName="fault"
                                    name="ReplyMapperFault"
                                    operation="CreateNotification"
                                    partnerLink="NotificationManagerPortType"
                                    portType="ns1:NotificationManagerPortType"
                                    tibex:xpdlId="f886a9b8-e8e8-4e24-9b8b-80e9eb868ff2" variable="ReplyMapperFault-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns12="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationManager/" version="2.0"&gt;
    &lt;xsl:param name="ErrorMapper"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns12:CreateNotificationFault&gt;
            &lt;NotificaFault&gt;
                &lt;tns1:NotificationFault&gt;
                    &lt;tns1:Codice&gt;
                        &lt;xsl:value-of select="$ErrorMapper/tns1:Codice"/&gt;
                    &lt;/tns1:Codice&gt;
                    &lt;xsl:if test="$ErrorMapper/tns1:Descrizione"&gt;
                        &lt;tns1:Descrizione&gt;
                            &lt;xsl:value-of select="$ErrorMapper/tns1:Descrizione"/&gt;
                        &lt;/tns1:Descrizione&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns1:NotificationFault&gt;
            &lt;/NotificaFault&gt;
        &lt;/tns12:CreateNotificationFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationManager/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ErrorMapper&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificationFault>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;$ErrorMapper/tns1:Codice&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;xsl:if test=&quot;$ErrorMapper/tns1:Descrizione&quot;>&#xa;                &lt;tns1:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;$ErrorMapper/tns1:Descrizione&quot;/>&#xa;                &lt;/tns1:Descrizione>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:NotificationFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <bpws:targets>
                                    <bpws:target linkName="LOG_ErrorToReplyMapperFault"/>
                                    </bpws:targets>
                                    </bpws:reply>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificationFault>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta) = 0&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo strutturaRichiesta deve essere valorizzato.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO) = 0&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo statoRichiestaOLO deve essere valorizzato.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO) = 0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo codiceOrdineOLO deve essere valorizzato per le notifiche in REGOLATORIO.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO)) = 0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica !=&amp;quot;KO&amp;quot; and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo DRO deve essere valorizzato per le notifiche in REGOLATORIO diverse dalla notifica di KO.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo statoRichiestaOLO in input (&amp;quot;, $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO,&amp;quot;) è valorizzato in modo errato.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:NotificationFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ErrorMapper-input"
                                    name="ErrorMapper"
                                    outputVariable="ErrorMapper"
                                    tibex:xpdlId="f1f4a964-2f97-4dab-8530-539eb3eaca6d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
