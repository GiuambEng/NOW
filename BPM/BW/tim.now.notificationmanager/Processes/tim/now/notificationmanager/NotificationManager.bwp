                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a6d4626c-12d3-47fb-9b52-770eafb77c61+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;ContenutoXML-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO,'_ANN')&quot;>&#xa;                    &lt;ID_RICHIESTA_OLO>&#xa;                        &lt;xsl:value-of select=&quot;substring-before($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO,'_ANN')&quot;/>&#xa;                    &lt;/ID_RICHIESTA_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RICHIESTA_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                    &lt;/ID_RICHIESTA_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns12:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CONTENUTO_XML_OLO,XML_CASEDATA_RICHIESTA_ANN FROM ACQUISIZIONE_RICHIESTE WHERE ID_RICHIESTA_OLO=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICHIESTA_OLO"/>

                                    <columnMetadata
                                    columnName="CONTENUTO_XML_OLO"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>

                                    <columnMetadata
                                    columnName="XML_CASEDATA_RICHIESTA_ANN"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:template name=&quot;LogContenutoXML-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($ContenutoXML/Record)>0&quot;>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ContenutoXML trovato&amp;quot;, tib:render-xml($ContenutoXML,true(),true()))&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;'ContenutoXML non trovato'&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogContenutoXML-input"
                                    name="LogContenutoXML"
                                    tibex:xpdlId="fda52feb-81fe-4347-9938-291e49134147"
