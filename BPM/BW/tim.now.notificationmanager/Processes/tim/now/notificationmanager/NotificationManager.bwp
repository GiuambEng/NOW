                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke.NotificaGenericaRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ID_NOTIFICA&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CODIFICA_OLO_NOW&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckSendFile&quot;/>&#xa;    &lt;xsl:template name=&quot;SendEmailInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:EmailRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:TipologiaNotifica !=&amp;quot;ON&amp;quot; and $ServiceNameInvoke.Ouptut/tns:TipologiaNotifica !=&amp;quot;OFF&amp;quot; and $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta!='FWA' and $ServiceNameInvoke.Ouptut/tns:Offerta!='FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                    &lt;tns2:RichiestaGenerica>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns2:RICHIESTA_NGA)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$NotificationInvoke.NotificaGenericaRisposta/tns2:RICHIESTA_NGA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:copy-of select=&quot;$NotificationInvoke.NotificaGenericaRisposta/tns2:RICHIESTA_XDSL&quot;/>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:RichiestaGenerica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement&quot;/>&#xa;            &lt;tns2:TipologiaNotifica>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica&quot;/>&#xa;            &lt;/tns2:TipologiaNotifica>&#xa;            &lt;tns2:IDNotifica>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_NOTIFICA/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/tns2:IDNotifica>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/tns1:IDEventoOrdineNOW)&quot;>&#xa;                    &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/tns1:IDEventoOrdineNOW&quot;>&#xa;                        &lt;tns2:IDEventoOrdineNOW>&#xa;                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:IDEventoOrdineNOW&quot;/>&#xa;                        &lt;/tns2:IDEventoOrdineNOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns2:StrutturaRichiesta>&#xa;            &lt;tns2:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:Offerta&quot;/>&#xa;            &lt;/tns2:Offerta>&#xa;            &lt;tns2:CodificaOLOAGCOMDestinatario>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns2:CodificaOLOAGCOMDestinatario>&#xa;            &lt;xsl:if test=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/COD_OLO&quot;>&#xa;                &lt;tns2:CodificaOLONOWDestinatario>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/tns2:CodificaOLONOWDestinatario>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CheckSendFile/Record[1]/COUNT>0 and  exists($CheckSendFile/Record) and $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica !=&amp;quot;TM&amp;quot;&quot;>&#xa;                    &lt;tns2:StatoNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                    &lt;/tns2:StatoNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:StatoNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&#xa;                    &lt;/tns2:StatoNotifica>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:EmailRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
