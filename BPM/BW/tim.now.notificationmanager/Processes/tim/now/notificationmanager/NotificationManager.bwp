le/Record) and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica !=&amp;quot;TM&amp;quot;&quot;>&lt;tns2:StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&lt;/tns2:StatoNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&lt;/tns2:StatoNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:EmailRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
