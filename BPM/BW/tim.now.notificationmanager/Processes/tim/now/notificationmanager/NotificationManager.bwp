ot;>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;IDNotifica&amp;quot;, tib:render-xml($JDBC_ID_NOTIFICA, true(), true()))&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;'IDNotifica record non trovato'&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="GenericLogger5-input"
                                    name="GenericLogger5"
                                    tibex:xpdlId="ca30917c-b3d4-4ae0-bc57-73427ad31350"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBC_ID_NOTIFICAToGenericLogger5"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger5ToRemoveNamespaceInvoke">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;REGOLATORIO&quot; or $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;NPG&quot;) and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica != &quot;ON&quot; and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica != &quot;OFF&quot; and exists($NotificationInvoke/NotificaGenericaRisposta/ns34:NotificaGenericaResponse)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "REGOLATORIO" or $ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "NPG") and $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica != "ON" and $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica != "OFF" and exists($NotificationInvoke.NotificaGenericaRisposta)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLogger5ToJDBC_CODIFICA_OLO_Name">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLogger5ToEmpty8">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta != &quot;REGOLATORIO&quot; and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta != &quot;NPG&quot; and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica != &quot;ON&quot; and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica != &quot;OFF&quot;  and exists($NotificationInvoke/NotificaGenericaRisposta/ns34:NotificaGenericaResponse)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta != "REGOLATORIO" and $ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta != "NPG" and $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica != "ON" and $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica != "OFF"  and exists($NotificationInvoke.NotificaGenericaRisposta)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLogger5ToEmpty9">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;NPNG&quot;) or ($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;FWA&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica='PA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "NPNG") or ($ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "FWA" and $CreateNotification.NotificaRichiesta/tns:TipologiaNotifica='PA')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLogger5ToFW">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;FWA&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica!='PA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "FWA" and $CreateNotification.NotificaRichiesta/tns:TipologiaNotifica!='PA']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ID_NOTIFICA&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBC_ID_NOTIFICA/Record) > 0&quot;>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;IDNotifica&amp;quot;, tib:render-xml($JDBC_ID_NOTIFICA, true(), true()))&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;'IDNotifica record non trovato'&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty8" tibex:xpdlId="c80dcf6e-526b-4a3c-a63c-ea4ee428bd25">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLogger5ToEmpty8"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty8ToRemoveNamespaceMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty8ToRemoveNamespaceInvoke">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($NotificationInvoke/NotificaGenericaRisposta/ns34:NotificaGenericaResponse/tns4:NotificaOAO) or $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;FIBERSTREAM&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($NotificationInvoke.NotificaGenericaRisposta/tns4:NotificaOAO) or $ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "FIBERSTREAM"]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://tns.tibco.com/bw/activity/render/xsd/+f19b07bd-a923-485c-8e49-588d9bc7b86d+input&quot; xmlns:tns13=&quot;http://www.example.org/notificanpng&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery2&quot;/>&#xa;    &lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:Rows>&#xa;            &lt;tns13:NotificaNPNG>&#xa;                &lt;tns13:CODE_GEST_FOR>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','TLC','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_GEST_FOR>&#xa;                &lt;tns13:CODE_ORD_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineTI,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_ORD_TI>&#xa;                &lt;tns13:DATA_NOTIF>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_NOTIF>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:ServiceName,'npng_Accettazione') and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='INVIATOADELIVERY'&quot;>&#xa;                        &lt;tns13:TIPO_NOTIF>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TIPO_NOTIF>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:ServiceName,'npng_Acquisizione')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='ACQUISITO'&quot;>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','0','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='SCARTATO'&quot;>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICOKO'&quot;>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','2','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:ServiceName,'npng_Espletamento')&quot;>&#xa;                        &lt;tns13:TIPO_NOTIF>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','2','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TIPO_NOTIF>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:TIPO_NOTIF>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TIPO_NOTIF>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:CODE_GEST_RICH>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codificaOLOAGCOM,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_GEST_RICH>&#xa;                &lt;tns13:CODE_ORD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_ORD_OLO>&#xa;                &lt;tns13:DN_CDS_SAC>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRisorsa,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DN_CDS_SAC>&#xa;                &lt;tns13:TIPO_PRESTAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:TIPO_PRESTAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:ServiceName,'npng_Accettazione')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='INVIATOADELIVERY'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','2','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:ServiceName,'npng_Acquisizione')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='ACQUISITO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','0','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='SCARTATO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICOKO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','4','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:ServiceName,'npng_Espletamento')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','3','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICOKO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','4','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:DATA_DVTC>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-dateTime($JDBCQuery1/Record[1]/TRUNCTIMSTPTRACC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_DVTC>&#xa;                &lt;tns13:DATA_DES>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_DES>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/ORA_DES))>0&quot;>&#xa;                        &lt;tns13:ORA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',substring(string($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/ORA_DES), 1, 5),'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORA_ESPLETAMENTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:ORA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORA_ESPLETAMENTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:ServiceName,'npng_Accettazione') and string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='DATACUTOVER']/valoreAttributo)>0&quot;>&#xa;                        &lt;tns13:Data_estrazione_Waiting_List>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='DATACUTOVER']/valoreAttributo,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:Data_estrazione_Waiting_List>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:Data_estrazione_Waiting_List>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:Data_estrazione_Waiting_List>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='ORACUTOVER']/valoreAttributo)>0&quot;>&#xa;                        &lt;tns13:ORARIO_CUT_OVER>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='ORACUTOVER']/valoreAttributo,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORARIO_CUT_OVER>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:ORARIO_CUT_OVER>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORARIO_CUT_OVER>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:CAUSALE_RIFIUTO>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',string($JDBCQuery2/Record[1]/ID_TIPO_CAUS_RIF_CPS),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CAUSALE_RIFIUTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Acquisizione)&quot;>&#xa;                        &lt;tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Acquisizione/tns5:RichiestaNok/tns5:CodiceMotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Accettazione)&quot;>&#xa;                        &lt;tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Accettazione/tns5:RichiestaNok/tns5:CodiceMotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Espletamento/tns5:RichiestaNok/tns5:CodiceMotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Acquisizione)&quot;>&#xa;                        &lt;tns13:MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Acquisizione/tns5:RichiestaNok/tns5:MotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Accettazione)&quot;>&#xa;                        &lt;tns13:MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Accettazione/tns5:RichiestaNok/tns5:MotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Espletamento/tns5:RichiestaNok/tns5:MotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:NOME_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/referente[1]/nomeReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NOME_REFER_TI>&#xa;                &lt;tns13:COGNOME_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/referente[1]/cognomeReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:COGNOME_REFER_TI>&#xa;                &lt;tns13:INDR_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:INDR_REFER_TI>&#xa;                &lt;tns13:TEL_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:TEL_REFER_TI>&#xa;                &lt;tns13:FAX_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/referente[1]/faxReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:FAX_REFER_TI>&#xa;                &lt;tns13:EMAIL_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/referente[1]/emailReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:EMAIL_REFER_TI>&#xa;                &lt;tns13:COMUNE_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:COMUNE_REFER_TI>&#xa;                &lt;tns13:CAP_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CAP_REFER_TI>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='NOTEAGGIUNTIVE']/valoreAttributo)>0&quot;>&#xa;                        &lt;tns13:TEXT_NOTE>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='NOTEAGGIUNTIVE']/valoreAttributo,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TEXT_NOTE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:TEXT_NOTE>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/note,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TEXT_NOTE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:DATA_DRO>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_DRO>&#xa;                &lt;tns13:DATA_DVF>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_DVF>&#xa;                &lt;tns13:Classificazione_ordine>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:Classificazione_ordine>&#xa;                &lt;tns13:NUM_AGGIUNTIVA_PORTATA_1>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NUM_AGGIUNTIVA_PORTATA_1>&#xa;                &lt;tns13:NUM_AGGIUNTIVA_PORTATA_2>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NUM_AGGIUNTIVA_PORTATA_2>&#xa;                &lt;tns13:NUM_AGGIUNTIVA_PORTATA_3>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NUM_AGGIUNTIVA_PORTATA_3>&#xa;                &lt;tns13:NUM_AGGIUNTIVA_PORTATA_4>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NUM_AGGIUNTIVA_PORTATA_4>&#xa;                &lt;tns13:NUM_AGGIUNTIVA_PORTATA_5>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NUM_AGGIUNTIVA_PORTATA_5>&#xa;                &lt;tns13:NUM_AGGIUNTIVA_PORTATA_6>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NUM_AGGIUNTIVA_PORTATA_6>&#xa;                &lt;tns13:NUM_AGGIUNTIVA_PORTATA_7>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NUM_AGGIUNTIVA_PORTATA_7>&#xa;            &lt;/tns13:NotificaNPNG>&#xa;        &lt;/tns12:Rows>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Renderdata-input"
                                    name="Renderdata"
                                    outputVariable="Renderdata"
                                    tibex:xpdlId="f19b07bd-a923-485c-8e49-588d9bc7b86d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery2ToRenderdata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderdataToCheckSendFile"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://tns.tibco.com/bw/activity/render/xsd/+f19b07bd-a923-485c-8e49-588d9bc7b86d+input&quot; xmlns:tns13=&quot;http://www.example.org/notificanpng&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke.NotificaGenericaRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery2&quot;/>&#xa;    &lt;xsl:template name=&quot;Renderdata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:Rows>&#xa;            &lt;tns13:NotificaNPNG>&#xa;                &lt;tns13:CODE_GEST_FOR>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','TLC','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_GEST_FOR>&#xa;                &lt;tns13:CODE_ORD_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_ORD_TI>&#xa;                &lt;tns13:DATA_NOTIF>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_NOTIF>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke.Ouptut/tns:ServiceName,'npng_Accettazione') and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='INVIATOADELIVERY'&quot;>&#xa;                        &lt;tns13:TIPO_NOTIF>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TIPO_NOTIF>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke.Ouptut/tns:ServiceName,'npng_Acquisizione')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='ACQUISITO'&quot;>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','0','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='SCARTATO'&quot;>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICOKO'&quot;>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','2','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:TIPO_NOTIF>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:TIPO_NOTIF>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke.Ouptut/tns:ServiceName,'npng_Espletamento')&quot;>&#xa;                        &lt;tns13:TIPO_NOTIF>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','2','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TIPO_NOTIF>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:TIPO_NOTIF>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:TIPO_NOTIF>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:CODE_GEST_RICH>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codificaOLOAGCOM,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_GEST_RICH>&#xa;                &lt;tns13:CODE_ORD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CODE_ORD_OLO>&#xa;                &lt;tns13:DN_CDS_SAC>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRisorsa,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DN_CDS_SAC>&#xa;                &lt;tns13:TIPO_PRESTAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:TIPO_PRESTAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke.Ouptut/tns:ServiceName,'npng_Accettazione')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='INVIATOADELIVERY'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','2','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke.Ouptut/tns:ServiceName,'npng_Acquisizione')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='ACQUISITO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','0','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='SCARTATO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','1','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICOKO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','4','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke.Ouptut/tns:ServiceName,'npng_Espletamento')&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','3','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO='ESPLETAMENTOTECNICOKO'&quot;>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','4','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns13:STATO_ORD>&#xa;                                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                                &lt;/tns13:STATO_ORD>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:DATA_DVTC>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-dateTime($JDBCQuery1/Record[1]/TRUNCTIMSTPTRACC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_DVTC>&#xa;                &lt;tns13:DATA_DES>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:DATA_DES>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/ORA_DES))>0&quot;>&#xa;                        &lt;tns13:ORA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',substring(string($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/ORA_DES), 1, 5),'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORA_ESPLETAMENTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:ORA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORA_ESPLETAMENTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;contains($ServiceNameInvoke.Ouptut/tns:ServiceName,'npng_Accettazione') and string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='DATACUTOVER']/valoreAttributo)>0&quot;>&#xa;                        &lt;tns13:Data_estrazione_Waiting_List>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='DATACUTOVER']/valoreAttributo,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:Data_estrazione_Waiting_List>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:Data_estrazione_Waiting_List>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:Data_estrazione_Waiting_List>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='ORACUTOVER']/valoreAttributo)>0&quot;>&#xa;                        &lt;tns13:ORARIO_CUT_OVER>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='ACCESSONPNG']/attributiDettaglioOrdine[nomeAttributo='ORACUTOVER']/valoreAttributo,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORARIO_CUT_OVER>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:ORARIO_CUT_OVER>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:ORARIO_CUT_OVER>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:CAUSALE_RIFIUTO>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',string($JDBCQuery2/Record[1]/ID_TIPO_CAUS_RIF_CPS),'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CAUSALE_RIFIUTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Acquisizione)&quot;>&#xa;                        &lt;tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Acquisizione/tns5:RichiestaNok/tns5:CodiceMotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Accettazione)&quot;>&#xa;                        &lt;tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Accettazione/tns5:RichiestaNok/tns5:CodiceMotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Espletamento/tns5:RichiestaNok/tns5:CodiceMotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:CODICE_MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Acquisizione)&quot;>&#xa;                        &lt;tns13:MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Acquisizione/tns5:RichiestaNok/tns5:MotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient/tns5:Accettazione)&quot;>&#xa;                        &lt;tns13:MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Accettazione/tns5:RichiestaNok/tns5:MotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns13:MOTIVO_RIFIUTO>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;quot;',$NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaVsRecipient[1]/tns5:Espletamento/tns5:RichiestaNok/tns5:MotivoRifiutoMig,'&amp;quot;')&quot;/>&#xa;                        &lt;/tns13:MOTIVO_RIFIUTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns13:NOME_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/referente[1]/nomeReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:NOME_REFER_TI>&#xa;                &lt;tns13:COGNOME_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/referente[1]/cognomeReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:COGNOME_REFER_TI>&#xa;                &lt;tns13:INDR_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:INDR_REFER_TI>&#xa;                &lt;tns13:TEL_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/referente[1]/telefonoFissoReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:TEL_REFER_TI>&#xa;                &lt;tns13:FAX_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/referente[1]/faxReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:FAX_REFER_TI>&#xa;                &lt;tns13:EMAIL_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;',$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/referente[1]/emailReferente,'&amp;quot;')&quot;/>&#xa;                &lt;/tns13:EMAIL_REFER_TI>&#xa;                &lt;tns13:COMUNE_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:COMUNE_REFER_TI>&#xa;                &lt;tns13:CAP_REFER_TI>&#xa;                    &lt;xsl:value-of select=&quot;concat('&amp;quot;','','&amp;quot;')&quot;/>&#xa;                &lt;/tns13:CAP_REFER_TI>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quo