onse/tns2:TipologiaNotifica='KD' or  $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica='SP' or  $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica='RS'))) then true() else false()"
