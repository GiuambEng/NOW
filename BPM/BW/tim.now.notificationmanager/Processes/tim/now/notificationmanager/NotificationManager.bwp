nating>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and contains($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta, &amp;quot;LINEAATTIVA&amp;quot;)&quot;>&lt;tns2:CodiceDonating>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/tns2:CodiceDonating>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:CodiceDonating>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:CodiceDonating>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:CodiceDonating>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:CodiceDonating>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:CodiceDonating>&lt;xsl:value-of select=&quot;$CodiceOperatoreDonating/tns2:DTUElement[1]&quot;/>&lt;/tns2:CodiceDonating>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:CodiceOrdineRiferimentoTI>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/codiceOrdineTI&quot;/>&lt;/tns2:CodiceOrdineRiferimentoTI>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta = &amp;quot;ULLLINEAATTIVANP&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta = &amp;quot;SLULINEAATTIVANP&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;) and ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]) = 1&quot;>&lt;tns2:CodiceRisorsa1>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and progressivo = 1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:CodiceRisorsa1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:CodiceRisorsa1>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:CodiceRisorsa1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceRisorsaDonating) > 0&quot;>&lt;tns2:CodiceRisorsa1>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceRisorsaDonating&quot;/>&lt;/tns2:CodiceRisorsa1>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo)>0 and&amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo=$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:CodificaOLOAGCOMDestinatario&quot;>&lt;tns2:CodiceRisorsa1>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/numeroTelefonico&quot;/>&lt;/tns2:CodiceRisorsa1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:CodiceRisorsa1>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRisorsa&quot;/>&lt;/tns2:CodiceRisorsa1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns2:CodiceSessione1>&lt;xsl:value-of select=&quot;&amp;quot;XXXXXX&amp;quot;&quot;/>&lt;/tns2:CodiceSessione1>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and ($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta = &amp;quot;ULLLINEAATTIVANP&amp;quot; or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta = &amp;quot;SLULINEAATTIVANP&amp;quot; or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;) and ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;)&quot;>&lt;tns2:CodiceSessione1>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns2:CodiceSessione1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:CodiceSessione1>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceSessione&quot;/>&lt;/tns2:CodiceSessione1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns2:DataNotifica>&lt;tns2:DataDRO>&lt;xsl:value-of select=&quot;format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns2:DataDRO>&lt;/tns2:TestataVsDonorDonating>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:TestataRegolatorio>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="TestataRegolatorio"
                                    name="TestataRegolatorioAssign"
                                    outputVariable="TestataRegolatorio"
                                    tibex:xpdlId="e99c331d-a3b5-4694-acdd-7904a6fcb82b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToTestataRegolatorioAssign"/>
                                    <bpws:target linkName="Control_KRToTestataRegolatorioAssign"/>
                                    <bpws:target linkName="LogNotificaFWAToTestataRegolatorioAssign_FWA"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TestataRegolatorioAssignToLOG_TestataRegolatorio"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoOrdine&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceOperatoreDonating&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceOrdineOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;TestataRegolatorio&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:TestataRegolatorio>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;tns2:Testata>&#xa;                        &lt;tns6:CodiceFornitore>&#xa;                            &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                        &lt;/tns6:CodiceFornitore>&#xa;                        &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                            &lt;tns6:CodiceOrdineFornitore>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                            &lt;/tns6:CodiceOrdineFornitore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns6:CodiceOrdineRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&#xa;                        &lt;/tns6:CodiceOrdineRichiedente>&#xa;                        &lt;tns6:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:DataNotifica>&#xa;                        &lt;tns6:StatoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&#xa;                        &lt;/tns6:StatoOrdine>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;tns6:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns6:DataDRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns6:DataDRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:Testata>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:Offerta='UBBSEMIGPON'  or $ServiceNameInvoke.Ouptut/tns:Offerta='UBBFULLGPON'&quot;>&#xa;                    &lt;tns2:Testata>&#xa;                        &lt;tns6:CodiceFornitore>&#xa;                            &lt;xsl:value-of select=&quot;'TLC'&quot;/>&#xa;                        &lt;/tns6:CodiceFornitore>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                    &lt;tns6:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/tns6:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;>&#xa;                                    &lt;tns6:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;/>&#xa;                                    &lt;/tns6:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;>&#xa;                                    &lt;tns6:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;/>&#xa;                                    &lt;/tns6:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($CodiceOrdineOLO/Record)>0&quot;>&#xa;                                &lt;tns6:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;substring($CodiceOrdineOLO/Record[1]/CODICEORDINEOLO, 1, 11)&quot;/>&#xa;                                &lt;/tns6:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&#xa;                                &lt;/tns6:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns6:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:DataNotifica>&#xa;                        &lt;tns6:StatoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&#xa;                        &lt;/tns6:StatoOrdine>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;tns6:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns6:DataDRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns6:DataDRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:Testata>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:Offerta='SEMIGPON1BPNRR' or $ServiceNameInvoke.Ouptut/tns:Offerta='FULLGPON1BPNRR'&quot;>&#xa;                    &lt;tns2:Testata>&#xa;                        &lt;tns6:CodiceFornitore>&#xa;                            &lt;xsl:value-of select=&quot;'FOP'&quot;/>&#xa;                        &lt;/tns6:CodiceFornitore>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                    &lt;tns6:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/tns6:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;>&#xa;                                    &lt;tns6:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;/>&#xa;                                    &lt;/tns6:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;>&#xa;                                    &lt;tns6:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;/>&#xa;                                    &lt;/tns6:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($CodiceOrdineOLO/Record)>0&quot;>&#xa;                                &lt;tns6:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;substring($CodiceOrdineOLO/Record[1]/CODICEORDINEOLO, 1, 11)&quot;/>&#xa;                                &lt;/tns6:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&#xa;                                &lt;/tns6:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns6:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/tns6:DataNotifica>&#xa;                        &lt;tns6:StatoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&#xa;                        &lt;/tns6:StatoOrdine>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;tns6:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns6:DataDRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns6:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns6:DataDRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:Testata>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(($ServiceNameInvoke.Ouptut/tns:Lavorazione !=&amp;quot;MIGRAZIONE&amp;quot; and not(($ServiceNameInvoke.Ouptut/tns:Lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and $ServiceNameInvoke.Ouptut/tns:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $ServiceNameInvoke.Ouptut/tns:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;) or ($ServiceNameInvoke.Ouptut/tns:Lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and $ServiceNameInvoke.Ouptut/tns:TipologiaOLODestinatario = &amp;quot;DONOR&amp;quot;))) &amp;#xD;&amp;#xA;or $ServiceNameInvoke.Ouptut/tns:TipologiaNotifica = &amp;quot;SM&amp;quot; or $ServiceNameInvoke.Ouptut/tns:TipologiaNotifica = &amp;quot;RA&amp;quot; or ($ServiceNameInvoke.Ouptut/tns:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and  $CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta='REGOLATORIO' and $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='KR')) and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta !='NPNG'&quot;>&#xa;                    &lt;tns2:TestataRegolatorio>&#xa;                        &lt;tns5:CodiceFornitore>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                        &lt;/tns5:CodiceFornitore>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                    &lt;tns5:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/tns5:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;>&#xa;                                    &lt;tns5:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTITarget&quot;/>&#xa;                                    &lt;/tns5:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;>&#xa;                                    &lt;tns5:CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineTI&quot;/>&#xa;                                    &lt;/tns5:CodiceOrdineFornitore>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($CodiceOrdineOLO/Record)>0&quot;>&#xa;                                &lt;tns5:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;substring($CodiceOrdineOLO/Record[1]/CODICEORDINEOLO, 1, 11)&quot;/>&#xa;                                &lt;/tns5:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:CodiceOrdineRichiedente>&#xa;                                    &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&#xa;                                &lt;/tns5:CodiceOrdineRichiedente>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns5:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/tns5:DataNotifica>&#xa;                        &lt;tns5:StatoOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&#xa;                        &lt;/tns5:StatoOrdine>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;tns5:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns5:DataDRO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns5:DataDRO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:TestataRegolatorio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;($ServiceNameInvoke.Ouptut/tns:TipologiaOLODestinatario !=&amp;quot;DONOR&amp;quot; and $ServiceNameInvoke.Ouptut/tns:TipologiaOLODestinatario !=&amp;quot;DONATING&amp;quot;) or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta ='NPNG'&quot;>&#xa;                    &lt;tns2:TestataVsRecipient>&#xa;                        &lt;tns2:CodiceRecipient>&#xa;                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns2:CodiceRecipient>&#xa;                        &lt;tns2:CodiceOrdineRecipient>&#xa;                            &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineRecipient>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta='NPNG'&quot;>&#xa;                                &lt;tns2:CodiceRisorsa1>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                &lt;/tns2:CodiceRisorsa1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot;&quot;>&#xa;                                &lt;tns2:CodiceRisorsa1>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                &lt;/tns2:CodiceRisorsa1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/contenutoXML)>0&quot;>&#xa;                                        &lt;tns2:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(substring-after($CreateNotification.NotificaRichiesta/ns:RichiestaElement/contenutoXML, &amp;quot;&amp;lt;CodiceRisorsa1>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa1>&amp;quot;)&quot;/>&#xa;                                        &lt;/tns2:CodiceRisorsa1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione='MIGRAZIONE' and string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordineAssetWhiteList)>0 and string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/numeroTelefonico)>0&quot;>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/numeroTelefonico&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO,'_ANN')&quot;>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before(substring-after($ContenutoXML/Record[1]/XML_CASEDATA_RICHIESTA_ANN, &amp;quot;&amp;lt;CodiceRisorsa1>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa1>&amp;quot;)&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;substring-before(substring-after($ContenutoXML/Record[1]/CONTENUTO_XML_OLO, &amp;quot;&amp;lt;CodiceRisorsa1>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa1>&amp;quot;)&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(substring-before(substring-after($CreateNotification.NotificaRichiesta/ns:RichiestaElement/contenutoXML, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)) > 0 and string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/contenutoXML)>0&quot;>&#xa;                                &lt;tns2:CodiceRisorsa2>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(substring-after($CreateNotification.NotificaRichiesta/ns:RichiestaElement/contenutoXML, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:CodiceRisorsa2>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO,'_ANN')&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(substring-before(substring-after($ContenutoXML/Record[1]/XML_CASEDATA_RICHIESTA_ANN, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)) > 0&quot;>&#xa;                                        &lt;tns2:CodiceRisorsa2>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(substring-after($ContenutoXML/Record[1]/XML_CASEDATA_RICHIESTA_ANN, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)&quot;/>&#xa;                                        &lt;/tns2:CodiceRisorsa2>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length(substring-before(substring-after($ContenutoXML/Record[1]/CONTENUTO_XML_OLO, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)) > 0&quot;>&#xa;                                &lt;tns2:CodiceRisorsa2>&#xa;                                    &lt;xsl:value-of select=&quot;substring-before(substring-after($ContenutoXML/Record[1]/CONTENUTO_XML_OLO, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:CodiceRisorsa2>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:DataNotifica>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:DataNotifica>&#xa;                        &lt;tns2:DataDRO>&#xa;                            &lt;xsl:value-of select=&quot;format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                        &lt;/tns2:DataDRO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/notedaSistema) > 0&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;AC&amp;quot; and (starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta, &amp;quot;ULL&amp;quot;) or starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta, &amp;quot;SLU&amp;quot;))&quot;>&#xa;                                        &lt;tns2:Note>&#xa;                                            &lt;xsl:value-of select=&quot;substring(concat(&amp;quot;##&amp;quot;, $CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRisorsa, &amp;quot;## &amp;quot;, $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/notedaSistema), 1, 255)&quot;/>&#xa;                                        &lt;/tns2:Note>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:Note>&#xa;                                            &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/notedaSistema, 1, 255)&quot;/>&#xa;                                        &lt;/tns2:Note>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;AC&amp;quot; and (starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta, &amp;quot;ULL&amp;quot;) or starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta, &amp;quot;SLU&amp;quot;))&quot;>&#xa;                                        &lt;tns2:Note>&#xa;                                            &lt;xsl:value-of select=&quot;substring(concat(&amp;quot;##&amp;quot;, $CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRisorsa, &amp;quot;## &amp;quot;, $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/noteCliente), 1, 255)&quot;/>&#xa;                                        &lt;/tns2:Note>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:Note>&#xa;                                            &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/noteCliente, 1, 255)&quot;/>&#xa;                                        &lt;/tns2:Note>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:TestataVsRecipient>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot;&quot;>&#xa;                            &lt;tns2:TestataVsDonorDonating>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and contains($ServiceNameInvoke.Ouptut/tns:Offerta, &amp;quot;LINEAATTIVA&amp;quot;)&quot;>&#xa;                                        &lt;tns2:CodiceDonating>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                                        &lt;/tns2:CodiceDonating>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:CodiceDonating>&#xa;                                            &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:CodificaOLOAGCOMDestinatario&quot;/>&#xa;                                        &lt;/tns2:CodiceDonating>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tns2:CodiceOrdineRiferimentoTI>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/codiceOrdineTI&quot;/>&#xa;                                &lt;/tns2:CodiceOrdineRiferimentoTI>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;(($CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;and contains($ServiceNameInvoke.Ouptut/tns:Offerta, &amp;quot;LINEAATTIVA&amp;quot;)) or &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/tipologiaSottolav = &amp;quot;ATTIVAZIONE274&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/tipologiaSottolav = &amp;quot;USCITADATI&amp;quot;) and&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA; ($CreateNotification.NotificaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $ServiceNameInvoke.Ouptut/tns:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/numeroTelefonico) > 0&quot;>&#xa;                                        &lt;tns2:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/numeroTelefonico&quot;/>&#xa;                                        &lt;/tns2:CodiceRisorsa1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO) > 0 and string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO2) > 0 and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO = $CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO2&quot;>&#xa;                                        &lt;tns2:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;$CodiceRisorsa&quot;/>&#xa;                                        &lt;/tns2:CodiceRisorsa1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;CONSISTENZA&amp;quot;) and attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo = $ServiceNameInvoke.Ouptut/tns:IDAsset]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;COWCODE&amp;quot;]/valoreAttributo = $CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO&quot;>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceRisorsaDonating&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;CONSISTENZA&amp;quot;) and attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo = $ServiceNameInvoke.Ouptut/tns:IDAsset]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;COWCODE&amp;quot;]/valoreAttributo = $CreateNotification.NotificaRichiesta/ns:RichiestaElement/cowCodeOLO2&quot;>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceRisorsaDonating2&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;CONSISTENZA&amp;quot;) and attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo = $ServiceNameInvoke.Ouptut/tns:IDAsset]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDRISORSA&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&#xa;                                        &lt;tns2:CodiceSessione1>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;XXXXXX&amp;quot;&quot;/>&#xa;                                        &lt;/tns2:CodiceSessione1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:CodiceSessione1>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;CONSISTENZA&amp;quot;) and attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOASSET&amp;quot;]/valoreAttributo = $ServiceNameInvoke.Ouptut/tns:IDAsset]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICESESSIONE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/tns2:CodiceSessione1>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tns2:DataNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataNotifica>&#xa;                                &lt;tns2:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataDRO>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;AC&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;OK&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KC&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KD&amp;quot;or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot;) and $ServiceNameInvoke.Ouptut/tns:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot; and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/codificaOLOAGCOM !=&amp;quot;TLC&amp;quot;&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLLINEAATTIVA&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLLINEANONATTIVA&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLLINEAATTIVANP&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLDATILINEAATTIVA&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLDATILINEANONATTIVA&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLDATILINEAATTIVANP&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;SLULINEAATTIVA&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;SLULINEANONATTIVA&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;SLULINEAATTIVANP&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;WLRLINEAATTIVA&amp;quot; or&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;VULL&amp;quot; or ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagNaked = &amp;quot;S&amp;quot; and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta = &amp;quot;NGA&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta = &amp;quot;XDSL&amp;quot;)))&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo) > 0 and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot;)&quot;>&#xa;                                                        &lt;tns2:Note>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;MANTENIMENTOPRODOTTI:1|BANDADACESSARE:F+D|&amp;quot;&quot;/>&#xa;                                                        &lt;/tns2:Note>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;tns2:Note>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;MANTENIMENTOPRODOTTI:0|BANDADACESSARE:F+D|&amp;quot;&quot;/>&#xa;                                                        &lt;/tns2:Note>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo) > 0 and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo = &amp;quot;1&amp;quot;)&quot;>&#xa;                                                        &lt;tns2:Note>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;MANTENIMENTOPRODOTTI:1|BANDADACESSARE:D|&amp;quot;&quot;/>&#xa;                                                        &lt;/tns2:Note>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;tns2:Note>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;MANTENIMENTOPRODOTTI:0|BANDADACESSARE:D|&amp;quot;&quot;/>&#xa;                                                        &lt;/tns2:Note>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/notedaSistema) > 0&quot;>&#xa;                                        &lt;tns2:Note>&#xa;                                            &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/notedaSistema, 1, 255)&quot;/>&#xa;                                        &lt;/tns2:Note>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:Note>&#xa;                                            &lt;xsl:value-of select=&quot;substring($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/noteCliente, 1, 255)&quot;/>&#xa;                                        &lt;/tns2:Note>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns2:TestataVsDonorDonating>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:TestataVsDonorDonating>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and contains($ServiceNameInvoke.Ouptut/tns:Offerta, &amp;quot;LINEAATTIVA&amp;quot;)&quot;>&#xa;                                        &lt;tns2:CodiceDonating>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                                        &lt;/tns2:CodiceDonating>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                        &lt;tns2:CodiceDonating>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/tns2:CodiceDonating>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                        &lt;tns2:CodiceDonating>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/tns2:CodiceDonating>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:CodiceDonating>&#xa;                                            &lt;xsl:value-of select=&quot;$CodiceOperatoreDonating/tns2:DTUElement[1]&quot;/>&#xa;                                        &lt;/tns2:CodiceDonating>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tns2:CodiceOrdineRiferimentoTI>&#xa;                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/codiceOrdineTI&quot;/>&#xa;                                &lt;/tns2:CodiceOrdineRiferimentoTI>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLLINEAATTIVANP&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;SLULINEAATTIVANP&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;) and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;)&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;]) = 1&quot;>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and progressivo = 1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;tns2:CodiceRisorsa1>&#xa;                                                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/tns2:CodiceRisorsa1>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceRisorsaDonating) > 0&quot;>&#xa;                                        &lt;tns2:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceRisorsaDonating&quot;/>&#xa;                                        &lt;/tns2:CodiceRisorsa1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo)>0 and&amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='CODICEOPERATOREDONOR']/valoreAttributo=$CreateNotification.NotificaRichiesta/tns1:CodificaOLOAGCOMDestinatario&quot;>&#xa;                                        &lt;tns2:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/numeroTelefonico&quot;/>&#xa;                                        &lt;/tns2:CodiceRisorsa1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:CodiceRisorsa1>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                        &lt;/tns2:CodiceRisorsa1>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&#xa;                                        &lt;tns2:CodiceSessione1>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;XXXXXX&amp;quot;&quot;/>&#xa;                                        &lt;/tns2:CodiceSessione1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:Lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and ($ServiceNameInvoke.Ouptut/tns:Offerta = &amp;quot;ULLLINEAATTIVANP&amp;quot; or $ServiceNameInvoke.Ouptut/tns:Offerta = &amp;quot;SLULINEAATTIVANP&amp;quot; or $ServiceNameInvoke.Ouptut/tns:Offerta = &amp;quot;ULLDATILINEAATTIVANP&amp;quot;) and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot; or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;FLAGDNDONOROLO&amp;quot;]/valoreAttributo = &amp;quot;Y&amp;quot;)&quot;>&#xa;                                        &lt;tns2:CodiceSessione1>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/tns2:CodiceSessione1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:CodiceSessione1>&#xa;                                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceSessione&quot;/>&#xa;                                        &lt;/tns2:CodiceSessione1>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;tns2:DataNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataNotifica>&#xa;                                &lt;tns2:DataDRO>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataDRO>&#xa;                            &lt;/tns2:TestataVsDonorDonating>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:TestataRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
