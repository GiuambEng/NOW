                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>

                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_ORDN_COMUNIC_NOTF (COD_TIPOLG_NOTF, ID_ANAG_CAUS,&#xa;&#x9;&#x9;&#x9;ID_EVENTO_ORDN_NOW_WHLS, ID_FILE_PROCSTO_INPUT, ID_NOTF,&#xa;&#x9;&#x9;&#x9;ID_RICH_OLO, IDRICH_COM_STRC, IDTPLG_STNTF_FLGIORN, IDTPLG_STNTF_FLMENS, IDTPLG_STNTF_FILE_ORARIO, ORIGINE_NOTF,&#xa;&#x9;&#x9;&#x9;STRUTTURA_RICH, TIMSTP_CREAZIONE, TRACCIATO_FILE,&#xa;&#x9;&#x9;&#x9;CODFC_OLO_NOW, CODFC_OLO_AGCOM, OPERATORE, DESCR_ERRORE, IDTPLG_DESTNRIO_NOTF, LAVORAZIONE,NGA_GPON, FLAG_NP103)&#xa;VALUES(?, ?, ?, ?, ?, ?, (SELECT IDRICH_COM_STRC FROM TIPOLG_RICH_COMSTOLO WHERE STATO_RICH_OLO = ? AND STATO_RICH_NOW = ?), (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), ?, ?, ?, ?, ?, ?, ?, ?, (SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR = ?), ?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

