                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+bafb658f-2a59-485f-8343-d098c6926083+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryRICH_ORDN_COMUNIC_NOTF-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/cowCodeOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/cowCodeOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_TIPOLG_NOTF>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica&quot;/>&#xa;            &lt;/COD_TIPOLG_NOTF>&#xa;            &lt;DESCR>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&#xa;            &lt;/DESCR>&#xa;        &lt;/tns12:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQueryRICH_ORDN_COMUNIC_NOTF-input"
                                    name="JDBCQueryRICH_ORDN_COMUNIC_NOTF"
                                    outputVariable="JDBCQueryRICH_ORDN_COMUNIC_NOTF"
                                    tibex:xpdlId="bafb658f-2a59-485f-8343-d098c6926083" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
