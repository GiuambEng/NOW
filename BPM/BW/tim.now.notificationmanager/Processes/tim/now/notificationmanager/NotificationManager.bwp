                                    sca-bpel:internal="true" type="xsd:string"/>
                                    <bpws:variable
                                    element="ns:FaultDetail"
                                    name="FaultDetails1" sca-bpel:internal="true"/>
                                </bpws:variables>
                                <bpws:faultHandlers>
                                    <bpws:catchAll
                                    tibex:faultDetailsVar="FaultDetails1"
                                    tibex:faultNameVar="FaultName1" tibex:xpdlId="86846c6e-9818-4ffe-becc-1e7faf4f5905">
                                    <bpws:scope name="scope2">
                                    <bpws:flow name="flow4">
                                    <bpws:links>
                                    <bpws:link
                                    name="LOG_Fault1ToJDBC_ID_NOTIFICA_ERROR" tibex:linkType="SUCCESS"/>
