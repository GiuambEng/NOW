                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0ccdb26a-4921-4c29-a468-adc765b5b3a8+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke.NotificaGenericaRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaREG&quot;/>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaDati&quot;/>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaNP&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistemaOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistemaFENP&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CODIFICA_OLO_NOW&quot;/>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaFWA&quot;/>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaFBS&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckSendFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta=&amp;quot;FWAITALIA1GIGASARDEGNA&amp;quot;&quot;>&#xa;                    &lt;ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;448&quot;/>&#xa;                    &lt;/ID_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta=&amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$IDInterfacciaFWA&quot;/>&#xa;                    &lt;/ID_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta=&amp;quot;FIBERSTREAM&amp;quot;&quot;>&#xa;                    &lt;ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$IDInterfacciaFBS&quot;/>&#xa;                    &lt;/ID_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta=&amp;quot;NPG&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103='Y'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;419&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$IDInterfacciaNP&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta=&amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaCPS) and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta='CPS' or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta='CESSAZIONECPS' or $ServiceNameInvoke.Ouptut/tns:Offerta='CPS' or $ServiceNameInvoke.Ouptut/tns:Offerta='CESSAZIONECPS' )&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;244&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$IDInterfacciaREG&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta=&amp;quot;XDSL&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$IDInterfacciaDati&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$IDInterfacciaNGA&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta=&amp;quot;NPG&amp;quot;&quot;>&#xa;                    &lt;ID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;$IDSistemaFENP&quot;/>&#xa;                    &lt;/ID_SISTEMA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;$IDSistemaOLO&quot;/>&#xa;                    &lt;/ID_SISTEMA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_CODIFICA_OLO_NOW/Record[1]/CODFC_OLO_AGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;        &lt;/tns9:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*)&#xa;FROM OLO OLO, SISTEMA_IP_INTRFC INTR&#xa;WHERE OLO.CODFC_OLO_AGCOM = INTR.CODFC_OLO_AGCOM&#xa;AND INTR.ID_INTRFC = ?&#xa;AND INTR.ID_SISTEMA = ?&#xa;AND INTR.CODFC_OLO_AGCOM = ?&#xa;AND FLAG_ENABLED = 'Y'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_INTRFC"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_SISTEMA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
