                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;SCARTATO&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SCARTATO/Record) > 0 and exists($SCARTATO/Record[1]/ID_ANAG_CAUS)&quot;>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record ID_ANAG_CAUS Trovato&amp;quot;, tib:render-xml($SCARTATO, true(), true()))&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Record ID_ANAG_CAUS non  Trovato'&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="GenericLogger1-input"
                                    name="GenericLogger1"
                                    tibex:xpdlId="926e2d07-f361-40ce-8ad8-886198c72f5d"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SCARTATOToGenericLogger1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger1ToResponseAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SCARTATO&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SCARTATO/Record) > 0 and exists($SCARTATO/Record[1]/ID_ANAG_CAUS)&quot;>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record ID_ANAG_CAUS Trovato&amp;quot;, tib:render-xml($SCARTATO, true(), true()))&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Record ID_ANAG_CAUS non  Trovato'&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
