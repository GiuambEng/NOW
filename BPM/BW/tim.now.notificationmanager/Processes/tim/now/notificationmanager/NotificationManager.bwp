                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;ErrorMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificationFault>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta) = 0&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo strutturaRichiesta deve essere valorizzato.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO) = 0&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo statoRichiestaOLO deve essere valorizzato.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO) = 0 and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo codiceOrdineOLO deve essere valorizzato per le notifiche in REGOLATORIO.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($CreateNotification.NotificaRichiesta/ns:RichiestaElement/DRO)) = 0 and $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica !=&amp;quot;KO&amp;quot; and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo DRO deve essere valorizzato per le notifiche in REGOLATORIO diverse dalla notifica di KO.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Il campo statoRichiestaOLO in input (&amp;quot;, $CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO,&amp;quot;) è valorizzato in modo errato.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:NotificationFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
