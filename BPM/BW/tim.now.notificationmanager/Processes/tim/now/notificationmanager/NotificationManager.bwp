t;xsl:value-of select=&quot;substring-before(substring-after($ContenutoXML/Record[1]/XML_CASEDATA_RICHIESTA_ANN, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)&quot;/>&lt;/tns2:CodiceRisorsa2>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($ContenutoXML/Record[1]/CONTENUTO_XML_OLO, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)) > 0&quot;>&lt;tns2:CodiceRisorsa2>&lt;xsl:value-of select=&quot;substring-before(substring-after($ContenutoXML/Record[1]/CONTENUTO_XML_OLO, &amp;quot;&amp;lt;CodiceRisorsa2>&amp;quot;), &amp;quot;&amp;lt;/CodiceRisorsa2>&amp;quot;)&quot;/>&lt;/tns2:CodiceRisorsa2>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns2:DataNotifica>&lt;tns2:DataDRO>&lt;xsl:value-of select=&quot;format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns2:DataDRO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/ordine/notedaSistema) > 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;AC&amp;quot; and (starts-with($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta, &amp;quot;ULL&amp;quot;) or starts-with($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta, &amp;quot;SLU&amp;quot;))&quot;>&lt;tns2:Note>&lt;xsl:value-of select=&quot;substring(concat(&amp;quot;##&amp;quot;, $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRisorsa, &amp;quot;## &amp;quot;, $