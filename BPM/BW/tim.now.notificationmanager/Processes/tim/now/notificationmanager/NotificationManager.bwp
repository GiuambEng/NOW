                                    </bpws:sources>
                                    </bpws:reply>
                                    <bpws:exit name="Exit1" tibex:xpdlId="6f79f666-ac06-44d5-b00f-6c815124c383">
                                    <bpws:targets>
                                    <bpws:target linkName="ReplyToExit1"/>
                                    </bpws:targets>
                                    </bpws:exit>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
