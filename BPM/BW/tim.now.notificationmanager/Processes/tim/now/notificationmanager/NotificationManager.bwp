                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/ParseSchema/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/RemoveNamespace&quot; xmlns:tns6=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceInvoke.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke.NotificaGenericaRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataDati&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;FWa&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:ParseSchemaRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta='FWA'&quot;>&#xa;                    &lt;tns8:StringaNotifica>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($FWa, true(), false())&quot;/>&#xa;                    &lt;/tns8:StringaNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot;  or $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot; or exists($NotificationInvoke.NotificaGenericaRisposta/tns6:NotificaOAO)&quot;>&#xa;                    &lt;tns8:StringaNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceInvoke.Output&quot;/>&#xa;                    &lt;/tns8:StringaNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns8:StringaNotifica>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataDati, substring-after($RemoveNamespaceMapper, &amp;quot;>&amp;quot;))&quot;/>&#xa;                    &lt;/tns8:StringaNotifica>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;((not(exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103)) or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103!='Y') and ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC3&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC11&amp;quot;)) or ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103='Y' and ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC3&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC10&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC17&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC18&amp;quot;))&quot;>&#xa;                            &lt;tns8:StrutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NPN&amp;quot;&quot;/>&#xa;                            &lt;/tns8:StrutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns8:StrutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NPR&amp;quot;&quot;/>&#xa;                            &lt;/tns8:StrutturaRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns8:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta&quot;/>&#xa;                    &lt;/tns8:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns8:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns8:IDRichiestaOLO>&#xa;            &lt;xsl:if test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns6:NotificaOAO)&quot;>&#xa;                &lt;tns8:GPON>&#xa;                    &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                &lt;/tns8:GPON>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103&quot;>&#xa;                &lt;tns8:Flag103>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103&quot;/>&#xa;                &lt;/tns8:Flag103>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns8:ParseSchemaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
