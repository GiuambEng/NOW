sl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDConsuntivo"&gt;&lt;IDConsuntivo&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDConsuntivo"/&gt;&lt;/IDConsuntivo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/noteAltreLavorazioni"&gt;&lt;noteAltreLavorazioni&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/noteAltreLavorazioni"/&gt;&lt;/noteAltreLavorazioni&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codicePacchettoNOW"&gt;&lt;codicePacchettoNOW&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codicePacchettoNOW"/&gt;&lt;/codicePacchettoNOW&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/assetTarget"&gt;&lt;assetTarget&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;flagInLavorazione&gt;&lt;xsl:value-of select="flagInLavorazione"/&gt;&lt;/flagInLavorazione&gt;&lt;/assetTarget&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/operatoreRete"&gt;&lt;operatoreRete&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/operatoreRete"/&gt;&lt;/operatoreRete&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/transactionIDLocator"&gt;&lt;transactionIDLocator&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/transactionIDLocator"/&gt;&lt;/transactionIDLocator&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:Notifi