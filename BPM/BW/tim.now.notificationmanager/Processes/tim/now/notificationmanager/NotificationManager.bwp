                                    <tibex:expression
                                    expression="$ServiceName/tns2:TipologiaNotifica = &quot;TM&quot; and false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ServiceName/tns2:TipologiaNotifica = "TM" and false()]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogContenutoXMLToStatoOrdineAssign_FWA">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;FWA&quot; and ($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;OK&quot; or $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;KO&quot;or $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;KF&quot; or $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;OF&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;AQ&quot; or&#xd;&#xa;$ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica = &quot;PA&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "FWA" and ($ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica = "OK" or $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica = "KO"or $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica = "KF" or $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica = "OF" or
$ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica = "AQ" or
$ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica = "PA")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:template name=&quot;LogContenutoXML-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($ContenutoXML/Record)>0&quot;>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;ContenutoXML trovato&amp;quot;, tib:render-xml($ContenutoXML,true(),true()))&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:Message>&#xa;                            &lt;xsl:value-of select=&quot;'ContenutoXML non trovato'&quot;/>&#xa;                        &lt;/tns10:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
