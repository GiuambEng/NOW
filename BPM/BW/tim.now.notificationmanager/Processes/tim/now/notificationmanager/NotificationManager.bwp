                                portType="ns18:RemoveNamespacePortType" tibex:xpdlId="cf9967b2-6d29-49e2-a7fe-04a219fc9e37">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns12="http://www.tim.com/NOW/wsdl/abstract/RemoveNamespace" xmlns:tns4="http://www.tim.com/NOW/xsd/RemoveNamespace" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:tns2="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceName" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" version="2.0"&gt;
    &lt;xsl:param name="CreateNotification"/&gt;
    &lt;xsl:param name="NotificationInvoke"/&gt;
    &lt;xsl:param name="ServiceNameInvoke"/&gt;
    &lt;xsl:template name="RemoveNamespaceInvoke-input" match="/"&gt;
        &lt;tns12:RemoveNamespaceRequest&gt;
            &lt;Input&gt;
                &lt;tns4:RemoveNamespaceRequest&gt;
                    &lt;xsl:copy-of select="$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot;"&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="((not(exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103)) or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103!='Y') and ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TC3&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TC11&amp;quot;)) or ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103='Y' and ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TC3&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TC10&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TC17&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TC18&amp;quot;))"&gt;
                                    &lt;tns4:StrutturaRichiesta&gt;
                                        &lt;xsl:value-of select="&amp;quot;NPN&amp;quot;"/&gt;
                                    &lt;/tns4:StrutturaRichiesta&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns4:StrutturaRichiesta&gt;
                                        &lt;xsl:value-of select="&amp;quot;NPR&amp;quot;"/&gt;
                                    &lt;/tns4:StrutturaRichiesta&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns4:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta"/&gt;
                            &lt;/tns4:StrutturaRichiesta&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns4:TipologiaNotifica&gt;
                        &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica"/&gt;
                    &lt;/tns4:TipologiaNotifica&gt;
                    &lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103"&gt;
                        &lt;tns4:flag103&gt;
                            &lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103"/&gt;
                        &lt;/tns4:flag103&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns4:RemoveNamespaceRequest&gt;
            &lt;/Input&gt;
        &lt;/tns12:RemoveNamespaceRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/wsdl/abstract/RemoveNamespace&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/RemoveNamespace&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke.NotificaGenericaRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:template name=&quot;RemoveNamespaceInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:RemoveNamespaceRequest>&#xa;            &lt;xsl:copy-of select=&quot;$NotificationInvoke.NotificaGenericaRisposta&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;((not(exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103)) or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103!='Y') and ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC3&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC11&amp;quot;)) or ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103='Y' and ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC3&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC10&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC17&amp;quot; or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TC18&amp;quot;))&quot;>&#xa;                            &lt;tns4:StrutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NPN&amp;quot;&quot;/>&#xa;                            &lt;/tns4:StrutturaRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:StrutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NPR&amp;quot;&quot;/>&#xa;                            &lt;/tns4:StrutturaRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta&quot;/>&#xa;                    &lt;/tns4:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:TipologiaNotifica>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica&quot;/>&#xa;            &lt;/tns4:TipologiaNotifica>&#xa;            &lt;xsl:if test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103&quot;>&#xa;                &lt;tns4:flag103>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103&quot;/>&#xa;                &lt;/tns4:flag103>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:RemoveNamespaceRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
