eOrdineRichiedente>&lt;xsl:value-of select=&quot;substring($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO, 1, 11)&quot;/>&lt;/tns5:CodiceOrdineRichiedente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns5:DataNotifica>&lt;tns5:StatoOrdine>&lt;xsl:value-of select=&quot;$StatoOrdine&quot;/>&lt;/tns5:StatoOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or  $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&lt;tns5:DataDRO>&lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns5:DataDRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:DataDRO>&lt;xsl:value-of select=&quot;format-date($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns5:DataDRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:TestataRegolatorio>&lt;/xsl:when>&lt;xsl:when test=&quot;($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:TipologiaOLODestinatario !=&amp;quot;DONOR&amp;quot; and $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:TipologiaOLODestinatario !=&amp;quot;DONATING&amp;quot;) or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta ='NPNG'&quot;>&lt;tns2:TestataVsRecipient>&lt;tns2:CodiceRecipient>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement