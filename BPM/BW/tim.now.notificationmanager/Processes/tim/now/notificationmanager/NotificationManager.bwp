                                    <bpws:source linkName="LogContenutoXMLToEmpty1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;REGOLATORIO&quot; or $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta = &quot;NPNG&quot;) and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica != &quot;ON&quot; and $ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:TipologiaNotifica != &quot;OFF&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "REGOLATORIO" or $ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta = "NPNG") and $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica != "ON" and $ServiceNameInvoke.Ouptut/tns2:TipologiaNotifica != "OFF"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogContenutoXMLToEmpty7">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
