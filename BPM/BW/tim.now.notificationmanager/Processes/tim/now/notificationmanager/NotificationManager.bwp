                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="if(($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;AQ&quot;) or (($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;RR&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;RA&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;RS&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;OD&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;OR&quot;) and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;SCARTATO&quot;))&#xd;&#xa;then &quot;0&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;AC&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;PA&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;ID&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;SU&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;IA&quot;)&#xd;&#xa;then &quot;2&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;OK&quot;)&#xd;&#xa;then &quot;3&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;KD&quot;)&#xd;&#xa;then &quot;4&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;AN&quot;)&#xd;&#xa;then &quot;5&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;SC&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;TC&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;SM&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;SP&quot;)&#xd;&#xa;then &quot;6&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;CO&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;DP&quot;)&#xd;&#xa;then &quot;7&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;RD&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;ST&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;O5&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;O6&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;OS&quot;)&#xd;&#xa;then &#xd;&#xa;if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;SCARTATO&quot;)&#xd;&#xa;then &quot;1&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;ACQUISITO&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;INDELIVERY&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;INVIATOADELIVERY&quot;)&#xd;&#xa;then &quot;2&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;ESPLETAMENTOTECNICO&quot; or&#xd;&#xa;$CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;CHIUSO&quot;)&#xd;&#xa;then &quot;3&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;ESPLETAMENTOTECNICOKO&quot;)&#xd;&#xa;then &quot;4&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;ANNULLATO&quot;)&#xd;&#xa;then &quot;5&quot;&#xd;&#xa;else if($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO = &quot;SOSPESO&quot;)&#xd;&#xa;then &quot;6&quot;&#xd;&#xa;else &quot;7&quot;&#xd;&#xa;else &quot;1&quot;"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="StatoOrdine"
