elato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLOGenerante"&gt;&lt;IDRichiestaOLOGenerante&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLOGenerante"/&gt;&lt;/IDRichiestaOLOGenerante&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipoComunicazioneNP"&gt;&lt;tipoComunicazioneNP&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipoComunicazioneNP"/&gt;&lt;/tipoComunicazioneNP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/servizioOrigine"&gt;&lt;servizioOrigine&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/servizioOrigine"/&gt;&lt;/servizioOrigine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceSTS"&gt;&lt;codiceSTS&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceSTS"/&gt;&lt;/codiceSTS&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/caratteristica"&gt;&lt;caratteristica&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/caratteristica"/&gt;&lt;/caratteristica&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceRisorsaDonating"&gt;&lt;codiceRisorsaDonating&gt;&lt;xsl:value-of select="$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceRisorsaDonating"/&gt;&lt;/codiceRisorsaDonating&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$CreateNotification/NotificaRichiesta/tns1:Notifi