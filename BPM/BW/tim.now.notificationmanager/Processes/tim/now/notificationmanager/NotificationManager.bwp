                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;tns10:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore: &amp;quot;, $ErrorMapper/tns1:Descrizione)&quot;/>&#xa;                &lt;/tns10:Message>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;            &lt;tns10:ActiveLoggerServices>&#xa;                &lt;tns10:Envelope>&#xa;                    &lt;tns10:Identifier>&#xa;                        &lt;tns10:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager&amp;quot;&quot;/>&#xa;                        &lt;/tns10:ServiceName>&#xa;                        &lt;tns10:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Operation>&#xa;                        &lt;tns10:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Source>&#xa;                        &lt;tns10:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns10:BusinessID>&#xa;                        &lt;tns10:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification_ERROR&amp;quot;&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;CreateNotification_&amp;quot;,$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                    &lt;tns10:ErrorLog>&#xa;                        &lt;tns10:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns10:TimeStamp>&#xa;                        &lt;tns10:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore su CreateNotification, id_richiesta: &amp;quot;, $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns10:Descrizione>&#xa;                        &lt;tns10:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                        &lt;/tns10:Codice>&#xa;                        &lt;tns10:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns10:track_position>&#xa;                        &lt;tns10:ErrorReport>&#xa;                            &lt;tns10:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/StackTrace&quot;/>&#xa;                            &lt;/tns10:StackTrace>&#xa;                            &lt;tns10:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/Msg&quot;/>&#xa;                            &lt;/tns10:Msg>&#xa;                            &lt;tns10:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/ProcessStack&quot;/>&#xa;                            &lt;/tns10:ProcessStack>&#xa;                            &lt;tns10:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                            &lt;/tns10:MsgCode>&#xa;                            &lt;tns10:Data>&#xa;                                &lt;xsl:copy-of select=&quot;$FaultDetails1/Data/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;$FaultDetails1/Data/@*&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;$FaultDetails1/Data/node()&quot;/>&#xa;                            &lt;/tns10:Data>&#xa;                        &lt;/tns10:ErrorReport>&#xa;                    &lt;/tns10:ErrorLog>&#xa;                &lt;/tns10:Envelope>&#xa;                &lt;tns10:Playload/>&#xa;            &lt;/tns10:ActiveLoggerServices>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LOG_Error-input"
                                    name="LOG_Error"
                                    tibex:xpdlId="2f032a35-3def-467a-a277-57ede2abd8a5"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ErrorMapperToLOG_Error"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LOG_ErrorToReplyMapperFault"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ErrorMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;tns10:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore: &amp;quot;, $ErrorMapper/tns1:Descrizione)&quot;/>&#xa;                &lt;/tns10:Message>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;            &lt;tns10:ActiveLoggerServices>&#xa;                &lt;tns10:Envelope>&#xa;                    &lt;tns10:Identifier>&#xa;                        &lt;tns10:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager&amp;quot;&quot;/>&#xa;                        &lt;/tns10:ServiceName>&#xa;                        &lt;tns10:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Operation>&#xa;                        &lt;tns10:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Source>&#xa;                        &lt;tns10:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns10:BusinessID>&#xa;                        &lt;tns10:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification_ERROR&amp;quot;&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;CreateNotification_&amp;quot;,$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                    &lt;tns10:ErrorLog>&#xa;                        &lt;tns10:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns10:TimeStamp>&#xa;                        &lt;tns10:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore su CreateNotification, id_richiesta: &amp;quot;, $CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns10:Descrizione>&#xa;                        &lt;tns10:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                        &lt;/tns10:Codice>&#xa;                        &lt;tns10:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns10:track_position>&#xa;                        &lt;tns10:ErrorReport>&#xa;                            &lt;tns10:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/StackTrace&quot;/>&#xa;                            &lt;/tns10:StackTrace>&#xa;                            &lt;tns10:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/Msg&quot;/>&#xa;                            &lt;/tns10:Msg>&#xa;                            &lt;tns10:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/ProcessStack&quot;/>&#xa;                            &lt;/tns10:ProcessStack>&#xa;                            &lt;tns10:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails1/MsgCode&quot;/>&#xa;                            &lt;/tns10:MsgCode>&#xa;                            &lt;tns10:Data>&#xa;                                &lt;xsl:copy-of select=&quot;$FaultDetails1/Data/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;$FaultDetails1/Data/@*&quot;/>&#xa;                                &lt;xsl:copy-of select=&quot;$FaultDetails1/Data/node()&quot;/>&#xa;                            &lt;/tns10:Data>&#xa;                        &lt;/tns10:ErrorReport>&#xa;                    &lt;/tns10:ErrorLog>&#xa;                &lt;/tns10:Envelope>&#xa;                &lt;tns10:Playload/>&#xa;            &lt;/tns10:ActiveLoggerServices>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;tns10:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Dati in input: &amp;quot;, tib:render-xml($CreateNotification/NotificaRichiesta/tns1:NotificationRequest, true(), true()))&quot;/>&#xa;                &lt;/tns10:Message>&#xa;                &lt;tns10:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns10:LoggerName>&#xa;                &lt;tns10:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns10:LogLevel>&#xa;                &lt;tns10:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns10:LogJMS>&#xa;            &lt;/tns10:GenericLogger>&#xa;            &lt;tns10:ActiveLoggerServices>&#xa;                &lt;tns10:Envelope>&#xa;                    &lt;tns10:Identifier>&#xa;                        &lt;tns10:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager&amp;quot;&quot;/>&#xa;                        &lt;/tns10:ServiceName>&#xa;                        &lt;tns10:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Operation>&#xa;                        &lt;tns10:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns10:Source>&#xa;                        &lt;tns10:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns10:BusinessID>&#xa;                        &lt;tns10:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns10:EventType>&#xa;                        &lt;tns10:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;CreateNotification_&amp;quot;,$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns10:trackID>&#xa;                    &lt;/tns10:Identifier>&#xa;                    &lt;tns10:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns10:track_position>&#xa;                    &lt;tns10:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns10:Timestamp>&#xa;                &lt;/tns10:Envelope>&#xa;                &lt;tns10:Playload>&#xa;                    &lt;tns10:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($CreateNotification/NotificaRichiesta/tns1:NotificationRequest)))&quot;/>&#xa;                    &lt;/tns10:Binary>&#xa;                    &lt;tns10:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($CreateNotification/NotificaRichiesta/tns1:NotificationRequest, true(), true())&quot;/>&#xa;                    &lt;/tns10:XMLString>&#xa;                &lt;/tns10:Playload>&#xa;            &lt;/tns10:ActiveLoggerServices>&#xa;        &lt;/tns10:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LOG_Input-input"
                                    name="LOG_Input"
                                    tibex:xpdlId="4a3a95bc-5262-4c55-a7f3-0d31b1dcf0f0"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToLOG_Input"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LOG_Name">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/strutturaRichiesta) = 0 or string-length($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO) = 0 or ($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;ACQUISITO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;SCARTATO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;INVIATOADELIVERY&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;INDELIVERY&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;ACCODATO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;SOSPESO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;ESPLETAMENTOTECNICOKO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;ESPLETAMENTOTECNICO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO != &quot;ANNULLATO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO !='ASSEGNATOADIMPRESA' and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO !='SOSPESOCONNOTIFICAFS' and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO !='INANNULLAMENTOSUDTUPEROF' and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/statoRichiestaOLO !='INANNULLAMENTOSUDTUPERKOOF') or (string-length($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/codiceOrdineOLO) = 0 and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/strutturaRichiesta = &quot;REGOLATORIO&quot;) or (string-length(string($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/DRO)) = 0 and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica != &quot;KO&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/strutturaRichiesta = &quot;REGOLATORIO&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($CreateNotification.NotificaRichiesta/tns1:RichiestaElement/strutturaRichiesta) = 0 or string-length($CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO) = 0 or ($CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "ACQUISITO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "SCARTATO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "INVIATOADELIVERY" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "INDELIVERY" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "ACCODATO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "SOSPESO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "ESPLETAMENTOTECNICOKO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "ESPLETAMENTOTECNICO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO != "ANNULLATO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO !='ASSEGNATOADIMPRESA' and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO !='SOSPESOCONNOTIFICAFS' and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO !='INANNULLAMENTOSUDTUPEROF' and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/statoRichiestaOLO !='INANNULLAMENTOSUDTUPERKOOF') or (string-length($CreateNotification.NotificaRichiesta/tns1:RichiestaElement/codiceOrdineOLO) = 0 and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/strutturaRichiesta = "REGOLATORIO") or (string-length(string($CreateNotification.NotificaRichiesta/tns1:RichiestaElement/DRO)) = 0 and $CreateNotification.NotificaRichiesta/tns:TipologiaNotifica != "KO" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/strutturaRichiesta = "REGOLATORIO")]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LOG_InputToServiceNameInvoke">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LOG_InputToAssign">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="(($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaOLODestinatario = &quot;DONOR&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaOLODestinatario = &quot;DONATING&quot;) and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/strutturaRichiesta != &quot;NPG&quot;) or ($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaOLODestinatario = &quot;DONATING&quot; and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/strutturaRichiesta = &quot;NPG&quot; and ($CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;O5&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica = &quot;O6&quot; or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica='NC')) and $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns:TipologiaNotifica != &quot;SM&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(($CreateNotification.NotificaRichiesta/tns:TipologiaOLODestinatario = "DONOR" or $CreateNotification.NotificaRichiesta/tns:TipologiaOLODestinatario = "DONATING") and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/strutturaRichiesta != "NPG") or ($CreateNotification.NotificaRichiesta/tns:TipologiaOLODestinatario = "DONATING" and $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/strutturaRichiesta = "NPG" and ($CreateNotification.NotificaRichiesta/tns:TipologiaNotifica = "O5" or $CreateNotification.NotificaRichiesta/tns:TipologiaNotifica = "O6" or $CreateNotification.NotificaRichiesta/tns:TipologiaNotifica='NC')) and $CreateNotification.NotificaRichiesta/tns:TipologiaNotifica != "SM"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:CW_BUS_MESSAGE>&#xa;            &lt;tns10:GenericLogger>&#xa;                &lt;tns10:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns10:Application>&#xa;                &lt;tns10:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManager&amp;quot;&quot;/>&#xa;                &lt;/tns10:Process>&#xa;                &lt;tns10:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NotificationManagerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns10:Service>&#xa;                &lt;tns10:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                &lt;/tns10:Operation>&#xa;                &lt;tns10:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns10:BusinessID>&#xa;                &lt;tns10:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Dati in input: &amp;quot;, 