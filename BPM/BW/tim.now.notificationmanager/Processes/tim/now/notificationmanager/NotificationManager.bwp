                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/ParseSchema/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/RemoveNamespace&quot; xmlns:tns6=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CreateNotification&quot;/>&lt;xsl:param name=&quot;TestataDati&quot;/>&lt;xsl:param name=&quot;RemoveNamespaceMapper&quot;/>&lt;xsl:param name=&quot;RemoveNamespaceInvoke&quot;/>&lt;xsl:param name=&quot;ServiceNameInvoke&quot;/>&lt;xsl:param name=&quot;NotificationInvoke&quot;/>&lt;xsl:param name=&quot;FWa&quot;/>&lt;xsl:template name=&quot;ParseInvoke-input&quot; match=&quot;/&quot;>&lt;tns8:ParseSchemaRequest>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta='FWA'&quot;>&lt;tns8:StringaNotifica>&lt;xsl:value-of select=&quot;tib:render-xml($FWa, true(), false())&quot;/>&lt;/tns8:StringaNotifica>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot;  or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot; or exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns6:NotificaOAO)&quot;>&lt;tns8:StringaNotifica>&lt;xsl:value-of select=&quot;$RemoveNamespaceInvoke/Output/tns4:NotificaXM