                                    <bpws:link
                                    name="JDBCQueryToJDBC_STORICIZZAZIONE_ERROR" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns12=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+26aaa845-c600-457f-8cf7-cc923c0ec833+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ID_NOTIFICA_ERROR&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CODIFICA_OLO_NOW_ERROR&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_STORICIZZAZIONE_ERROR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns12:jdbcUpdateActivityInput>&#xa;            &lt;TipologiaNotifica>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica&quot;/>&#xa;            &lt;/TipologiaNotifica>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDAnagraficaCausale)&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns2:IDAnagraficaCausale)) > 0&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns2:IDAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns2:IDAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDAnagraficaCausale xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDEventoOrdineNOW)) > 0&quot;>&#xa;                    &lt;IDEventoOrdineNOW>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDEventoOrdineNOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:IDEventoOrdineNOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDEventoOrdineNOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDEventoOrdineNOW xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDFileInput)&quot;>&#xa;                    &lt;IDFile>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDFileInput)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDFileInput&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDFile xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDNotifica>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_NOTIFICA_ERROR/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/IDNotifica>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO) > 0&quot;>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDRichiestaOLO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;StatoRichiestaOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/StatoRichiestaOLO>&#xa;            &lt;StatoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/statoRichiestaNOW&quot;/>&#xa;            &lt;/StatoRichiestaNOW>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                    &lt;StatoNotificaGiorno xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;StatoNotificaGiorno>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INFO HALTED&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaGiorno>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TM&amp;quot;&quot;>&#xa;                    &lt;StatoNotificaMensile>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INFO HALTED&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaMensile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;StatoNotificaMensile xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;StatoNotificaOrario>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INFO HALTED&amp;quot;&quot;/>&#xa;            &lt;/StatoNotificaOrario>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:OrigineNotifica = &amp;quot;GUI GENERA NOTIFICA&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:OrigineNotifica)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:OrigineNotifica&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;AQ&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;KB&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;AK&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RICHIESTA OLO&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO) > 0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipoRichiesta = &amp;quot;ORDINE&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ORDINE NOW WHOLESALE&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO) > 0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipoRichiesta = &amp;quot;ALTRO&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;COMUNICAZIONE SU ORDINE WHOLESALE&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FILE PROCESSATO INPUT&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;TimestampCreazione>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TimestampCreazione>&#xa;            &lt;TracciatoFile>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;DATI IN INPUT: &amp;#xA;&amp;quot;, tib:render-xml($CreateNotification/NotificaRichiesta/tns1:NotificationRequest))&quot;/>&#xa;            &lt;/TracciatoFile>&#xa;            &lt;CodiceOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_CODIFICA_OLO_NOW_ERROR/Record[1]/COD_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW_ERROR/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceOLO>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_CODIFICA_OLO_NOW_ERROR/Record[1]/CODFC_OLO_AGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW_ERROR/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;Operatore>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/operatore&quot;/>&#xa;            &lt;/Operatore>&#xa;            &lt;CodiceErrore>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails1)&quot;/>&#xa;            &lt;/CodiceErrore>&#xa;            &lt;TipologiaDestinatario>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:TipologiaOLODestinatario&quot;/>&#xa;            &lt;/TipologiaDestinatario>&#xa;            &lt;Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Lavorazione&quot;/>&#xa;            &lt;/Lavorazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta='UBBSEMIGPON' or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta='UBBFULLGPON'&quot;>&#xa;                    &lt;NGA_GPON>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/NGA_GPON>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NGA_GPON xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103= 'Y'&quot;>&#xa;                    &lt;FLAG_NP103>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/FLAG_NP103>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_NP103 xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns12:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
