ication/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO, 'MVG-') or starts-with($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO, 'MVGE-'))&quot;>&lt;StatoNotificaGiorno>&lt;xsl:value-of select=&quot;'DA NON INVIARE OLO'&quot;/>&lt;/StatoNotificaGiorno>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot; or (exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaCPS) and ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta='CPS' or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/offerta='CESSAZIONECPS' or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='CPS' or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='CESSAZIONECPS')) or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&lt;StatoNotificaGiorno xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TM&amp;quot;&quot;>&lt;StatoNotificaGiorno>&lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&lt;/StatoNotificaGiorno>&lt;/xsl:when>&lt;xsl:when test=&quot;$CheckSendFile/Record[1]/COUNT>0 and  exists($CheckSendFile/Record)&quot;>&lt;StatoNotificaGiorno>&lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&lt;/StatoNotificaGiorno>&lt;/xsl:when>&lt;xsl:when test=&quot;$SendMail=true()&quot;>&lt;StatoNotificaGiorno>&lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&lt;/StatoNotificaGiorno>&lt;/xsl:when>&lt;xsl:otherwise>&lt;StatoNotificaGiorno>&lt;xsl:value-of select=&quot;&amp;quot;SOLO GUI&amp;quot;&quot;/>&lt;/StatoNotificaGiorno>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta='REGOLATORIO' and (starts-with($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO, 'MVG-') or starts-with($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/codiceOrdineOLO, 'MVGE-'))&quot;>&lt;StatoNotificaOrario>&lt;xsl:value-of select=&quot;'DA NON INVIARE OLO'&quot;/>&lt;/StatoNotificaOrario>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&lt;StatoNotificaOrario xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TM&amp;quot;&quot;>&lt;StatoNotificaOrario>&lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&lt;/StatoNotificaOrario>&lt;/xsl:when>&lt;xsl:when test=&quot;$CheckSendFile/Record[1]/COUNT>0 and  exists($CheckSendFile/Record)&quot;>&lt;StatoNotificaOrario>&lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&lt;/StatoNotificaOrario>&lt;/xsl:when>&lt;xsl:when test=&quot;$SendMail=true()&quot;>&lt;StatoNotificaOrario>&lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&lt;/StatoNotificaOrario>&lt;/xsl:when>&lt;xsl:otherwise>&lt;StatoNotificaOrario>&lt;xsl:value-of select=&quot;&amp;quot;SOLO GUI&amp;quot;&quot;/>&lt;/StatoNotificaOrario>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:OrigineNotifica = &amp;quot;GUI GENERA NOTIFICA&amp;quot;&quot;>&lt;OrigineNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:OrigineNotifica)&quot;>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:OrigineNotifica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/OrigineNotifica>&lt;/xsl:when>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;AQ&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;KB&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;AK&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&lt;OrigineNotifica>&lt;xsl:value-of select=&quot;&amp;quot;RICHIESTA OLO&amp;quot;&quot;/>&lt;/OrigineNotifica>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO) > 0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipoRichiesta = &amp;quot;ORDINE&amp;quot;&quot;>&lt;OrigineNotifica>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE NOW WHOLESALE&amp;quot;&quot;/>&lt;/OrigineNotifica>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/IDRichiestaOLO) > 0 and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/tipoRichiesta = &amp;quot;ALTRO&amp;quot;&quot;>&lt;OrigineNotifica>&lt;xsl:value-of select=&quot;&amp;quot;COMUNICAZIONE SU ORDINE WHOLESALE&amp;quot;&quot;/>&lt;/OrigineNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;OrigineNotifica>&lt;xsl:value-of select=&quot;&amp;quot;FILE PROCESSATO INPUT&amp;quot;&quot;/>&lt;/OrigineNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;StrutturaRichiesta>&lt;xsl:value-of select=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta&quot;/>&lt;/StrutturaRichiesta>&lt;TimestampCreazione>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TimestampCreazione>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta=&amp;quot;FWA&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='PA'&quot;>&lt;TracciatoFile xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TracciatoFile>&lt;xsl:value-of select=&quot;tib:render-xml($FWa, true(), true())&quot;/>&lt;/TracciatoFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&lt;TracciatoFile>&lt;xsl:value-of select=&quot;tib:trim($Renderdata)&quot;/>&lt;/TracciatoFile>&lt;/xsl:when>&lt;xsl:when test=&quot;(($ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot;) and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica !=&amp;quot;ON&amp;quot;  and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica !=&amp;quot;OFF&amp;quot;) or exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns6:NotificaOAO) or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns6:NotificaOAO) or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&lt;TracciatoFile>&lt;xsl:value-of select=&quot;substring-before(substring-after($RemoveNamespaceInvoke/Output/tns4:NotificaXMLString, '&amp;lt;NotificaOAO>'), '&amp;lt;/NotificaOAO>')&quot;/>&lt;/TracciatoFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TracciatoFile>&lt;xsl:value-of select=&quot;$RemoveNamespaceInvoke/Output/tns4:NotificaXMLString&quot;/>&lt;/TracciatoFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='VP' or $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;AK&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;TM&amp;quot; or&amp;#xD;&amp;#xA; $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;ON&amp;quot; or &amp;#xD;&amp;#xA; $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica = &amp;quot;OFF&amp;quot;  or &amp;#xD;&amp;#xA; ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/strutturaRichiesta=&amp;quot;FWA&amp;quot; and &amp;#xD;&amp;#xA; ($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='KO' or&amp;#xD;&amp;#xA; $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='OK' or  $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='OF' or  $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/tns1:TipologiaNotifica='KF')) or $ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Offerta='FWAITALIA1GIGASARDEGNA'&quot;>&lt;TracciatoFile xsi:nil=&quot;true&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TracciatoFile>&lt;xsl:value-of select=&quot;concat($TestataDati, substring-after($RemoveNamespaceMapper, &amp;quot;>&amp;quot;))&quot;/>&lt;/TracciatoFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CodiceOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CODIFICA_OLO_NOW/Record[1]/COD_OLO)&quot;>&lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/COD_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceOLO>&lt;CodiceOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CODIFICA_OLO_NOW/Record[1]/CODFC_OLO_AGCOM)&quot;>&lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceOLOAGCOM>&lt;Operatore>&lt;xsl:value-of select=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/operatore&quot;/>&lt;/Operatore>&lt;TipologiaDestinatario>&lt;xsl:value-of select=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:TipologiaOLODestinatario&quot;/>&lt;/TipologiaDestinatario>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Lavorazione='MIGRAZIONE' and exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns5:NotificaOloRegolatorio/tns5:NotificaCPS)&quot;>&lt;Lavorazione>&lt;xsl:value-of select=&quot;'MIGRAZIONERIENTROCPS'&quot;/>&lt;/Lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Lavorazione>&lt;xsl:value-of select=&quot;$ServiceNameInvoke/Ouptut/tns:ServiceNameResponse/tns:Lavorazione&quot;/>&lt;/Lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns6:NotificaOAO) and not($CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagNewGpon='SI')&quot;>&lt;NGA_GPON>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/NGA_GPON>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NGA_GPON xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagDelibera103= 'Y'&quot;>&lt;FLAG_NP103>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/FLAG_NP103>&lt;/xsl:when>&lt;xsl:otherwise>&lt;FLAG_NP103 xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NotificationInvoke/NotificaGenericaRisposta/tns2:NotificaGenericaResponse/tns6:NotificaOAO) and $CreateNotification/NotificaRichiesta/tns1:NotificationRequest/ns:RichiestaElement/flagNewGpon='SI'&quot;>&lt;NEW_GPON>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/NEW_GPON>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NEW_GPON xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns3:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBC_STORICIZZAZIONE-input"
                                    name="JDBC_STORICIZZAZIONE"
                                    outputVariable="JDBC_STORICIZZAZIONE"
                                    tibex:xpdlId="a627d27b-f030-43a7-97b4-c18b1e5a9a3f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToJDBC_STORICIZZAZIONE"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBC_STORICIZZAZIONEToLOG_EMAIL">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($SendMail=true() and not($SkipNotfMail = true())) or ($ServiceNameInvoke/Ouptut/tns2:ServiceNameResponse/tns2:StrutturaRichiesta=&quot;FWA&quot;) or $CreateNotification/NotificaRichiesta/tns:NotificationRequest/tns1:RichiestaElement/offerta='FWAITALIA1GIGASARDEGNA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SendMail=true() and not($SkipNotfMail = true())) or ($ServiceNameInvoke.Ouptut/tns2:StrutturaRichiesta="FWA") or $CreateNotification.NotificaRichiesta/tns1:RichiestaElement/offerta='FWAITALIA1GIGASARDEGNA']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBC_STORICIZZAZIONEToLOG_NOTEMAIL">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a627d27b-f030-43a7-97b4-c18b1e5a9a3f+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/RemoveNamespace&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns5=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; xmlns:tns6=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateNotification.NotificaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceInvoke.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificationInvoke.NotificaGenericaRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceNameInvoke.Ouptut&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceMapper&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ID_NOTIFICA&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataDati&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CODIFICA_OLO_NOW&quot;/>&#xa;    &lt;xsl:param name=&quot;SendMail&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckSendFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Renderdata&quot;/>&#xa;    &lt;xsl:param name=&quot;FWa&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_STORICIZZAZIONE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;TipologiaNotifica>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica&quot;/>&#xa;            &lt;/TipologiaNotifica>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDAnagraficaCausale)&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length(string($NotificationInvoke.NotificaGenericaRisposta/tns2:IDAnagraficaCausale)) > 0&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns2:IDAnagraficaCausale)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$NotificationInvoke.NotificaGenericaRisposta/tns2:IDAnagraficaCausale&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDAnagraficaCausale xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($CreateNotification.NotificaRichiesta/tns1:IDEventoOrdineNOW)) > 0&quot;>&#xa;                    &lt;IDEventoOrdineNOW>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/tns1:IDEventoOrdineNOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:IDEventoOrdineNOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDEventoOrdineNOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDEventoOrdineNOW xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDFileInput)&quot;>&#xa;                    &lt;IDFile>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDFileInput)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDFileInput&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDFile xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDNotifica>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBC_ID_NOTIFICA/Record[1]/NEXTVAL)&quot;/>&#xa;            &lt;/IDNotifica>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO) > 0&quot;>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDRichiestaOLO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;StatoRichiestaOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/StatoRichiestaOLO>&#xa;            &lt;StatoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/statoRichiestaNOW&quot;/>&#xa;            &lt;/StatoRichiestaNOW>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta='REGOLATORIO' and (starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 'MVG-') or starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 'MVGE-'))&quot;>&#xa;                    &lt;StatoNotificaGiorno>&#xa;                        &lt;xsl:value-of select=&quot;'DA NON INVIARE OLO'&quot;/>&#xa;                    &lt;/StatoNotificaGiorno>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot; or (exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaCPS) and ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta='CPS' or $CreateNotification.NotificaRichiesta/ns:RichiestaElement/offerta='CESSAZIONECPS' or $ServiceNameInvoke.Ouptut/tns:Offerta='CPS' or $ServiceNameInvoke.Ouptut/tns:Offerta='CESSAZIONECPS')) or $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&#xa;                    &lt;StatoNotificaGiorno xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TM&amp;quot;&quot;>&#xa;                    &lt;StatoNotificaGiorno>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaGiorno>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CheckSendFile/Record[1]/COUNT>0 and  exists($CheckSendFile/Record)&quot;>&#xa;                    &lt;StatoNotificaGiorno>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaGiorno>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendMail=true()&quot;>&#xa;                    &lt;StatoNotificaGiorno>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaGiorno>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;StatoNotificaGiorno>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SOLO GUI&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaGiorno>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta='REGOLATORIO' and (starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 'MVG-') or starts-with($CreateNotification.NotificaRichiesta/ns:RichiestaElement/codiceOrdineOLO, 'MVGE-'))&quot;>&#xa;                    &lt;StatoNotificaOrario>&#xa;                        &lt;xsl:value-of select=&quot;'DA NON INVIARE OLO'&quot;/>&#xa;                    &lt;/StatoNotificaOrario>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                    &lt;StatoNotificaOrario xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TM&amp;quot;&quot;>&#xa;                    &lt;StatoNotificaOrario>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaOrario>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CheckSendFile/Record[1]/COUNT>0 and  exists($CheckSendFile/Record)&quot;>&#xa;                    &lt;StatoNotificaOrario>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaOrario>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendMail=true()&quot;>&#xa;                    &lt;StatoNotificaOrario>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SOLO VIA EMAIL&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaOrario>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;StatoNotificaOrario>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SOLO GUI&amp;quot;&quot;/>&#xa;                    &lt;/StatoNotificaOrario>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:OrigineNotifica = &amp;quot;GUI GENERA NOTIFICA&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CreateNotification.NotificaRichiesta/tns1:OrigineNotifica)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/tns1:OrigineNotifica&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;AQ&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;KB&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;AK&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RICHIESTA OLO&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO) > 0 and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/tipoRichiesta = &amp;quot;ORDINE&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ORDINE NOW WHOLESALE&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CreateNotification.NotificaRichiesta/ns:RichiestaElement/IDRichiestaOLO) > 0 and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/tipoRichiesta = &amp;quot;ALTRO&amp;quot;&quot;>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;COMUNICAZIONE SU ORDINE WHOLESALE&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;OrigineNotifica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FILE PROCESSATO INPUT&amp;quot;&quot;/>&#xa;                    &lt;/OrigineNotifica>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;TimestampCreazione>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TimestampCreazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta=&amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='PA'&quot;>&#xa;                            &lt;TracciatoFile xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TracciatoFile>&#xa;                                &lt;xsl:value-of select=&quot;tib:render-xml($FWa, true(), true())&quot;/>&#xa;                            &lt;/TracciatoFile>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                    &lt;TracciatoFile>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($Renderdata)&quot;/>&#xa;                    &lt;/TracciatoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(($ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;NPG&amp;quot;) and $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica !=&amp;quot;ON&amp;quot;  and $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica !=&amp;quot;OFF&amp;quot;) or exists($NotificationInvoke.NotificaGenericaRisposta/tns6:NotificaOAO) or $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns6:NotificaOAO) or $ServiceNameInvoke.Ouptut/tns:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&#xa;                            &lt;TracciatoFile>&#xa;                                &lt;xsl:value-of select=&quot;substring-before(substring-after($RemoveNamespaceInvoke.Output, '&amp;lt;NotificaOAO>'), '&amp;lt;/NotificaOAO>')&quot;/>&#xa;                            &lt;/TracciatoFile>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TracciatoFile>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceInvoke.Output&quot;/>&#xa;                            &lt;/TracciatoFile>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:Offerta='VP' or $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;AK&amp;quot; or &amp;#xD;&amp;#xA;$CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;TM&amp;quot; or&amp;#xD;&amp;#xA; $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;ON&amp;quot; or &amp;#xD;&amp;#xA; $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica = &amp;quot;OFF&amp;quot;  or &amp;#xD;&amp;#xA; ($CreateNotification.NotificaRichiesta/ns:RichiestaElement/strutturaRichiesta=&amp;quot;FWA&amp;quot; and &amp;#xD;&amp;#xA; ($CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='KO' or&amp;#xD;&amp;#xA; $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='OK' or  $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='OF' or  $CreateNotification.NotificaRichiesta/tns1:TipologiaNotifica='KF')) or $ServiceNameInvoke.Ouptut/tns:Offerta='FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                    &lt;TracciatoFile xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TracciatoFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataDati, substring-after($RemoveNamespaceMapper, &amp;quot;>&amp;quot;))&quot;/>&#xa;                    &lt;/TracciatoFile>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CodiceOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_CODIFICA_OLO_NOW/Record[1]/COD_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceOLO>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_CODIFICA_OLO_NOW/Record[1]/CODFC_OLO_AGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_CODIFICA_OLO_NOW/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;Operatore>&#xa;                &lt;xsl:value-of select=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/operatore&quot;/>&#xa;            &lt;/Operatore>&#xa;            &lt;TipologiaDestinatario>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:TipologiaOLODestinatario&quot;/>&#xa;            &lt;/TipologiaDestinatario>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ServiceNameInvoke.Ouptut/tns:Lavorazione='MIGRAZIONE' and exists($NotificationInvoke.NotificaGenericaRisposta/tns5:NotificaOloRegolatorio/tns5:NotificaCPS)&quot;>&#xa;                    &lt;Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'MIGRAZIONERIENTROCPS'&quot;/>&#xa;                    &lt;/Lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ServiceNameInvoke.Ouptut/tns:Lavorazione&quot;/>&#xa;                    &lt;/Lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns6:NotificaOAO) and not($CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagNewGpon='SI')&quot;>&#xa;                    &lt;NGA_GPON>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/NGA_GPON>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NGA_GPON xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagDelibera103= 'Y'&quot;>&#xa;                    &lt;FLAG_NP103>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/FLAG_NP103>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;FLAG_NP103 xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NotificationInvoke.NotificaGenericaRisposta/tns6:NotificaOAO) and $CreateNotification.NotificaRichiesta/ns:RichiestaElement/flagNewGpon='SI'&quot;>&#xa;                    &lt;NEW_GPON>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/NEW_GPON>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NEW_GPON xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_ORDN_COMUNIC_NOTF (COD_TIPOLG_NOTF, ID_ANAG_CAUS,&#xa;&#x9;&#x9;&#x9;ID_EVENTO_ORDN_NOW_WHLS, ID_FILE_PROCSTO_INPUT, ID_NOTF,&#xa;&#x9;&#x9;&#x9;ID_RICH_OLO, IDRICH_COM_STRC, IDTPLG_STNTF_FLGIORN,IDTPLG_STNTF_FILE_ORARIO, ORIGINE_NOTF,&#xa;&#x9;&#x9;&#x9;STRUTTURA_RICH, TIMSTP_CREAZIONE, TRACCIATO_FILE,&#xa;&#x9;&#x9;&#x9;CODFC_OLO_NOW, CODFC_OLO_AGCOM, OPERATORE, IDTPLG_DESTNRIO_NOTF, LAVORAZIONE,NGA_GPON, FLAG_NP103, NEW_GPON)&#xa;VALUES(?, ?, ?, ?, ?, ?, (SELECT IDRICH_COM_STRC FROM TIPOLG_RICH_COMSTOLO WHERE STATO_RICH_OLO = ? AND STATO_RICH_NOW = ?),(SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), ?, ?, ?, ?, ?, ?, ?, (SELECT IDTPLG_DESTNRIO_NOTF FROM TIPOLG_DESTNRIO_NOTF WHERE DESCR = ?), ?,?, ?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TipologiaNotifica"/>

                                    <PreparedParameters
