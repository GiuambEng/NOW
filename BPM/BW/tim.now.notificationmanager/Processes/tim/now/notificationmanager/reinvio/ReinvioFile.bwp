                                    <tibex:expression
                                    expression="exists($JDBC_FILE_PROCSTO/Record) = false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($JDBC_FILE_PROCSTO/Record) = false()]]></bpws:transitionCondition>
