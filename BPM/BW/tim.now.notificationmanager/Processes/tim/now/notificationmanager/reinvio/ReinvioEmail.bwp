                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3e5c6c10-57af-4220-bfba-5553a076feb9+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReinvioEmailOperationIn.ReinvioEmailInput&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_NOTIFICA_EMAIL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_NOTF>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_NOTF>&#xa;            &lt;TIMSTP_INVIO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIMSTP_INVIO>&#xa;            &lt;ID_NOTF>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_NOTF>&#xa;            &lt;TIMSTP_INVIO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn.ReinvioEmailInput/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIMSTP_INVIO>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT EMAIL.DESTNRIO_EMAIL_A, EMAIL.DESTNRIO_EMAIL_CC, EMAIL.ID_EMAIL_TEMPLATE, EMAIL.ID_NOTF, EMAIL.OGGETTO, EMAIL.CONTENUTO_MAIL, NOTF.COD_TIPOLG_NOTF&#xa;FROM EMAIL_NOTF EMAIL, RICH_ORDN_COMUNIC_NOTF NOTF&#xa;WHERE EMAIL.ID_NOTF = ?&#xa;AND EMAIL.TIMSTP_INVIO = ?&#xa;AND EMAIL.ROWID = (SELECT MAX(ROWID) FROM EMAIL_NOTF WHERE ID_NOTF = ? AND TIMSTP_INVIO = ?)&#xa;AND NOTF.ID_NOTF = EMAIL.ID_NOTF" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_NOTF"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INVIO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_NOTF"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INVIO"/>
                                    <columnMetadata
                                    columnName="DESTNRIO_EMAIL_A"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESTNRIO_EMAIL_CC"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_EMAIL_TEMPLATE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OGGETTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CONTENUTO_MAIL"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
