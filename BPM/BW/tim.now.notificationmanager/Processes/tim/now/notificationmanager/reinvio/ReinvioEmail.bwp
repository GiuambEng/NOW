                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3e5c6c10-57af-4220-bfba-5553a076feb9+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ReinvioEmailOperationIn&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;JDBC_NOTIFICA_EMAIL-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_NOTF>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica)&quot;>&lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_NOTF>&lt;TIMSTP_INVIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica)&quot;>&lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIMSTP_INVIO>&lt;ID_NOTF>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica)&quot;>&lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:IDNotifica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_NOTF>&lt;TIMSTP_INVIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica)&quot;>&lt;xsl:value-of select=&quot;$ReinvioEmailOperationIn/ReinvioEmailInput/tns2:ReinvioEmailRequest/tns2:DatiNotificheEmail[number($index)]/tns2:DataInvioNotifica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/TIMSTP_INVIO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBC_NOTIFICA_EMAIL-input"
                                    name="JDBC_NOTIFICA_EMAIL"
                                    outputVariable="JDBC_NOTIFICA_EMAIL"
                                    tibex:xpdlId="3e5c6c10-57af-4220-bfba-5553a076feb9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBC_NOTIFICA_EMAIL"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBC_NOTIFICA_EMAILToJDBCQuery"/>
