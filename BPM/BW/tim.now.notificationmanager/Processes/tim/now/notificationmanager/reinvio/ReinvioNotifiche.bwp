     &lt;TIMSTP_CREAZIONE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_CREAZIONE>&#xa;            &lt;TRACCIATO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_RecuperaNotifica/Record[1]/TRACCIATO_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_RecuperaNotifica/Record[1]/TRACCIATO_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TRACCIATO_FILE>&#xa;            &lt;TRACCIATO_MAIL>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_RecuperaNotifica/Record[1]/TRACCIATO_MAIL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_RecuperaNotifica/Record[1]/TRACCIATO_MAIL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TRACCIATO_MAIL>&#xa;            &lt;DESCR_ERRORE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_RecuperaNotifica/Record[1]/DESCR_ERRORE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_RecuperaNotifica/Record[1]/DESCR_ERRORE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESCR_ERRORE>&#xa;            &lt;IDTPLG_DESTNRIO_NOTF>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_RecuperaNotifica/Record[1]/IDTPLG_DESTNRIO_NOTF)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_RecuperaNotifica/Record[1]/IDTPLG_DESTNRIO_NOTF&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDTPLG_DESTNRIO_NOTF>&#xa;            &lt;TIMSTP_AGGTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_AGGTO>&#xa;            &lt;LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_RecuperaNotifica/Record[1]/LAVORAZIONE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_RecuperaNotifica/Record[1]/LAVORAZIONE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LAVORAZIONE>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
