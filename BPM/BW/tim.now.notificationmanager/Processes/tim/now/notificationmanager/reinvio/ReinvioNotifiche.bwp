length($ReinvioNotificheIn.parameters/tns2:DatiNotifiche[1]/tns2:IDRichiestaOLO)>0&quot;>&#xa;                                &lt;tns:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ReinvioNotificheOperation&amp;quot; ,$ReinvioNotificheIn.parameters/tns2:DatiNotifiche[1]/tns2:IDRichiestaOLO)&quot;/>&#xa;                                &lt;/tns:trackID>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:trackID>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ReinvioNotificheOperation&amp;quot;&quot;/>&#xa;                                &lt;/tns:trackID>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload/>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
