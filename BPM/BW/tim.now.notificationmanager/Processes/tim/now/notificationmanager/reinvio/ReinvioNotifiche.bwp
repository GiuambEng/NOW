                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO RICH_ORDN_COMUNIC_NOTF (COD_TIPOLG_NOTF, CODFC_OLO_AGCOM, CODFC_OLO_NOW,&#xa;ID_ANAG_CAUS, ID_EVENTO_ORDN_NOW_WHLS, ID_FILE_PROCSTO_INPUT, ID_NOTF, ID_RICH_OLO,&#xa;IDRICH_COM_STRC, IDTPLG_STNTF_FLGIORN, IDTPLG_STNTF_FLMENS, IDTPLG_STNTF_FILE_ORARIO,&#xa;OPERATORE, ORIGINE_NOTF, STRUTTURA_RICH, TIMSTP_CREAZIONE, TRACCIATO_FILE, TRACCIATO_MAIL,&#xa;DESCR_ERRORE, IDTPLG_DESTNRIO_NOTF, TIMSTP_AGGTO, LAVORAZIONE)&#xa;VALUES(?, ?, ?, ?, ?, ?, ?, ?, ?, (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

