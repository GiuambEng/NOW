            <bpws:invoke inputVariable="ReinvioEmailInvoke-input"
                name="ReinvioEmailInvoke" operation="ReinvioEmail"
                outputVariable="ReinvioEmailInvoke"
                partnerLink="ReinvioEmailPortType"
                portType="ns6:ReinvioEmailPortType" tibex:xpdlId="609b17e1-7758-4a65-b4a8-ca77d682b7a8">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/Reinvio" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/FileStraordinario" xmlns:tns2="http://www.tim.com/NOW/xsd/FileStraordinario" xmlns:tns3="http://www.tim.com/NOW/xsd/ReinvioScheduler" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ReinvioScheduler/" version="2.0"&gt;&lt;xsl:param name="ReinvioSchedulerIn"/&gt;&lt;xsl:template name="ReinvioEmailInvoke-input" match="/"&gt;&lt;tns4:ReinvioEmailRequest&gt;&lt;ReinvioEmailInput&gt;&lt;tns3:ReinvioEmailRequest&gt;&lt;xsl:for-each select="$ReinvioSchedulerIn/ReinvioSchedulerInput/tns3:ReinvioSchedulerRequest/tns3:ReinvioDaGUI/tns3:Reinvio/tns3:ReinvioEmail/tns3:DatiNotificheEmail"&gt;&lt;tns3:DatiNotificheEmail&gt;&lt;tns3:IDNotifica&gt;&lt;xsl:value-of select="tns3:IDNotifica"/&gt;&lt;/tns3:IDNotifica&gt;&lt;tns3:DataInvioNotifica&gt;&lt;xsl:value-of select="tns3:DataInvioNotifica"/&gt;&lt;/tns3:DataInvioNotifica&gt;&lt;/tns3:DatiNotificheEmail&gt;&lt;/xsl:for-each&gt;&lt;/tns3:ReinvioEmailRequest&gt;&lt;/ReinvioEmailInput&gt;&lt;/tns4:ReinvioEmailRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
