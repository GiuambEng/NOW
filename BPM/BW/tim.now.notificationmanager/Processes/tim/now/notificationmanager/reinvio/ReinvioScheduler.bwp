                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/ReinvioScheduler" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/ReinvioScheduler/" version="2.0"&gt;&lt;xsl:param name="Response"/&gt;&lt;xsl:template name="ReinvioSchedulerOut-input" match="/"&gt;&lt;tns2:ReinvioSchedulerResponse&gt;&lt;ReinvioSchedulerOutput&gt;&lt;tns1:ReinvioSchedulerResponse&gt;&lt;xsl:copy-of select="$Response/tns1:Response"/&gt;&lt;/tns1:ReinvioSchedulerResponse&gt;&lt;/ReinvioSchedulerOutput&gt;&lt;/tns2:ReinvioSchedulerResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/ReinvioScheduler/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Response&quot;/>&#xa;    &lt;xsl:template name=&quot;ReinvioSchedulerOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ReinvioSchedulerResponse>&#xa;            &lt;xsl:copy-of select=&quot;$Response/tns1:Response&quot;/>&#xa;        &lt;/tns1:ReinvioSchedulerResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
