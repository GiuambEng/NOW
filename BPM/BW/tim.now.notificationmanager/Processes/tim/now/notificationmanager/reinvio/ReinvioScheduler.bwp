                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ReinvioSchedulerIn&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:ReinvioSchedulerResponse>&lt;xsl:for-each select=&quot;$Response/tns:Response&quot;>&lt;tns:Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;tns:Codice&quot;/>&lt;/tns:Codice>&lt;xsl:if test=&quot;tns:Descrizione&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;tns:Descrizione&quot;/>&lt;/tns:Descrizione>&lt;/xsl:if>&lt;/tns:Response>&lt;/xsl:for-each>&lt;tns:Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica per IDRichiestaOLO: &amp;quot;, $ReinvioSchedulerIn/ReinvioSchedulerInput/tns:ReinvioSchedulerRequest/tns:ReinvioDaGUI/tns:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/IDRichiestaOLO, &amp;quot; non generata.&amp;quot;)&quot;/>&lt;/tns:Descrizione>&lt;/tns:Response>&lt;/tns:ReinvioSchedulerResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>"
