            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;ReinvioSchedulerIn&quot;/>&lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerReinvio&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioSchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Dati in input Scheduler Reinvio: &amp;quot;, tib:render-xml($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.reinvio&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:Reinvio)&quot;>&lt;xsl:if test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:Reinvio/tns2:ReinvioNotifiche/tns2:DatiNotifiche/tns2:IDRichiestaOLO)&quot;>&lt;xsl:if test=&quot;$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:Reinvio/tns2:ReinvioNotifiche/tns2:DatiNotifiche/tns2:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:Reinvio/tns2:ReinvioNotifiche/tns2:DatiNotifiche/tns2:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:GenerazioneNotifiche)&quot;>&lt;xsl:if test=&quot;string-length($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO)>0&quot;>&lt;xsl:if test=&quot;$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaFILE)&quot;>&lt;xsl:if test=&quot;string-length($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaFILE/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO)>0&quot;>&lt;xsl:if test=&quot;$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaFILE/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaFILE/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler_SUB-PROCESS&amp;quot;&quot;/>&lt;/tns:EventType>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:Reinvio)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:Reinvio/tns2:ReinvioNotifiche/tns2:DatiNotifiche[1]/tns2:IDRichiestaOLO)>0&quot;>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;ReinvioScheduler_&amp;quot;,$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:Reinvio/tns2:ReinvioNotifiche/tns2:DatiNotifiche[1]/tns2:IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:trackID>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler&amp;quot;&quot;/>&lt;/tns:trackID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:GenerazioneNotifiche)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO)>0&quot;>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;ReinvioScheduler_&amp;quot;,$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaGUI/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:trackID>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler&amp;quot;&quot;/>&lt;/tns:trackID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:trackID>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler&amp;quot;&quot;/>&lt;/tns:trackID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaFILE)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaFILE/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO)>0&quot;>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;ReinvioScheduler_&amp;quot;,$ReinvioSchedulerIn/ReinvioSchedulerInput/tns2:ReinvioSchedulerRequest/tns2:ReinvioDaFILE/tns2:GenerazioneNotifiche[1]/ns:RichiestaElement/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:trackID>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler&amp;quot;&quot;/>&lt;/tns:trackID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:trackID>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioScheduler&amp;quot;&quot;/>&lt;/tns:trackID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload/>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
