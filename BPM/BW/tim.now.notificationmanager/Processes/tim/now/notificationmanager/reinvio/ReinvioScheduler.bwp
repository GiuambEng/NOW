                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if(exists($ReinvioSchedulerIn.ReinvioSchedulerInput/ns7:ReinvioDaGUI/ns7:GenerazioneNotifiche)) then $index <= count($ReinvioSchedulerIn.ReinvioSchedulerInput/ns7:ReinvioDaGUI/ns7:GenerazioneNotifiche) else $index <= count($ReinvioSchedulerIn.ReinvioSchedulerInput/ns7:ReinvioDaFILE/ns7:GenerazioneNotifiche)]]></bpws:condition>
