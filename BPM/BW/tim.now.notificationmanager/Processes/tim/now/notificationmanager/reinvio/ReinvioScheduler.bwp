                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationManager/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ReinvioScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReinvioSchedulerIn.ReinvioSchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;NotificationManagerInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche)&quot;>&#xa;                &lt;tns2:NotificationRequest>&#xa;                    &lt;ns:RichiestaElement>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DIFFIDA AGCOM&amp;quot;&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;statoRichiestaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/statoRichiestaNOW&quot;/>&#xa;                        &lt;/statoRichiestaNOW>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/statoRichiestaPrecedNOW&quot;>&#xa;                            &lt;statoRichiestaPrecedNOW>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/statoRichiestaPrecedNOW&quot;/>&#xa;                            &lt;/statoRichiestaPrecedNOW>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/statoRichiestaOLO&quot;>&#xa;                            &lt;statoRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/statoRichiestaOLO&quot;/>&#xa;                            &lt;/statoRichiestaOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/statoRichiestaPrecedOLO&quot;>&#xa;                            &lt;statoRichiestaPrecedOLO>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/statoRichiestaPrecedOLO