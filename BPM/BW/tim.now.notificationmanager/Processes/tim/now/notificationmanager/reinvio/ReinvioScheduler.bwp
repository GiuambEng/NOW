            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/NotificationManager/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ReinvioScheduler/"/>
        </wsdl:definitions>
