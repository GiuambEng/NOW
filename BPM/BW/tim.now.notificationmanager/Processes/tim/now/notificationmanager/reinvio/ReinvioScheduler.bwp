                                    expression="exists($ReinvioSchedulerIn/ReinvioSchedulerInput/ns7:ReinvioSchedulerRequest/ns7:ReinvioDaGUI)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
