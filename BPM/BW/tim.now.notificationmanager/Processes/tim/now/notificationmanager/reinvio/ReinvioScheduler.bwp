            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType1">
                <plnk:role name="use" portType="ptyp5:ReinvioSchedulerPortType"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType6">
