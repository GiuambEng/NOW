  &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/IDCorrelazione&quot;>&#xa;                            &lt;IDCorrelazione>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/IDCorrelazione&quot;/>&#xa;                            &lt;/IDCorrelazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/totaleRichiestePacchetto&quot;>&#xa;                            &lt;totaleRichiestePacchetto>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/totaleRichiestePacchetto&quot;/>&#xa;                            &lt;/totaleRichiestePacchetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/tipoPacchetto&quot;>&#xa;                            &lt;tipoPacchetto>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/tipoPacchetto&quot;/>&#xa;                            &lt;/tipoPacchetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/IDPacchettoNOW&quot;>&#xa;                            &lt;IDPacchettoNOW>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/IDPacchettoNOW&quot;/>&#xa;                            &lt;/IDPacchettoNOW>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/contenutoXML&quot;>&#xa;                            &lt;contenutoXML>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/contenutoXML&quot;/>&#xa;                            &lt;/contenutoXML>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/note&quot;>&#xa;                            &lt;note>&#xa;                                &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/note&quot;/>&#xa;                            &lt;/note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ordine>&#xa;                            &lt;xsl:if test=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/ordine/offertaCatalogo&quot;>&#xa;                                &lt;offertaCatalogo>&#xa;                                    &lt;xsl:value-of select=&quot;$ReinvioSchedulerIn.ReinvioSchedulerInput/tns3:ReinvioDaGUI/tns3:GenerazioneNotifiche[number($index)]/ns:RichiestaElement/ordine/offertaCatalogo&quot;/>&#xa;                                &lt;/offertaCatalogo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$Reinvio