ferente[3]&quot;>&lt;CognomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:CognomeReferente[3]&quot;/>&lt;/CognomeReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:NomeReferente[3]) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:NomeReferente[3]&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:NomeReferente[3]&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:TelefonoFissoReferente[3]) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:TelefonoFissoReferente[3]&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:TelefonoFissoReferente[3]&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:TelefonoMobileReferente[3]) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:TelefonoMobileReferente[3]&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:TelefonoMobileReferente[3]&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:DataContattoCliente[3])>0&quot;>&lt;DataContattoCliente>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:DataContattoCliente[3]&quot;/>&lt;/DataContattoCliente>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:OraContattoCliente[3])>0&quot;>&lt;OraContattoCliente>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:TentativiContatto/tns:OraContattoCliente[3]&quot;/>&lt;/OraContattoCliente>&lt;/xsl:if>&lt;/TentativiContatto>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:AccessoGPON/tns:NotificaRifiutoAnnullamento)&quot;>&lt;NotificaRifiutoAnnullamento>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:NotificaRifiutoAnnullamento/tns:CodiceOrdineFornitore&quot;/>&lt;/CodiceOrdineFornitore>&lt;xsl:for-each select=&quot;$Start/tns:AccessoGPON[1]/tns:NotificaRifiutoAnnullamento/tns:Rifiuto&quot;>&lt;Rifiuto>&lt;CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;tns:CodiceMotivoRifiuto&quot;/>&lt;/CodiceMotivoRifiuto>&lt;MotivoRifiuto>&lt;xsl:value-of select=&quot;tns:MotivoRifiuto&quot;/>&lt;/MotivoRifiuto>&lt;/Rifiuto>&lt;/xsl:for-each>&lt;/NotificaRifiutoAnnullamento>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:AccessoGPON[1]/tns:NotificaRimodAppuntamento)&quot;>&lt;NotificaRimodAppuntamento>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:NotificaRimodAppuntamento/tns:CodiceOrdineFornitore&quot;/>&lt;/CodiceOrdineFornitore>&lt;xsl:for-each select=&quot;$Start/tns:AccessoGPON[1]/tns:NotificaRimodAppuntamento/tns:Rifiuto&quot;>&lt;Rifiuto>&lt;CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;tns:CodiceMotivoRifiuto&quot;/>&lt;/CodiceMotivoRifiuto>&lt;MotivoRifiuto>&lt;xsl:value-of select=&quot;tns:MotivoRifiuto&quot;/>&lt;/MotivoRifiuto>&lt;/Rifiuto>&lt;/xsl:for-each>&lt;/NotificaRimodAppuntamento>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:AccessoGPON/tns:NotificaInterrSospensione)&quot;>&lt;NotificaInterrSospensione>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:NotificaInterrSospensione/tns:CodiceOrdineFornitore&quot;/>&lt;/CodiceOrdineFornitore>&lt;xsl:for-each select=&quot;$Start/tns:AccessoGPON[1]/tns:NotificaInterrSospensione/tns:Rifiuto&quot;>&lt;Rifiuto>&lt;CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;tns:CodiceMotivoRifiuto&quot;/>&lt;/CodiceMotivoRifiuto>&lt;MotivoRifiuto>&lt;xsl:value-of select=&quot;tns:MotivoRifiuto&quot;/>&lt;/MotivoRifiuto>&lt;/Rifiuto>&lt;/xsl:for-each>&lt;/NotificaInterrSospensione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:AccessoGPON[1]/tns:InizioAttivita)&quot;>&lt;InizioAttivita>&lt;DataInizioAttivita>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:InizioAttivita/tns:DataInizioAttivita&quot;/>&lt;/DataInizioAttivita>&lt;xsl:if test=&quot;string-length($Start/tns:AccessoGPON[1]/tns:InizioAttivita/tns:OraInizioAttivita)&quot;>&lt;xsl:if test=&quot;$Start/tns:AccessoGPON[1]/tns:InizioAttivita/tns:OraInizioAttivita&quot;>&lt;OraInizioAttivita>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:InizioAttivita/tns:OraInizioAttivita&quot;/>&lt;/OraInizioAttivita>&lt;/xsl:if>&lt;/xsl:if>&lt;RagioneSocialeDitta>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:InizioAttivita/tns:RagioneSocialeDitta&quot;/>&lt;/RagioneSocialeDitta>&lt;/InizioAttivita>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:AccessoGPON[1]/tns:Info)&quot;>&lt;Info>&lt;TipoEvento>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:Info/tns:TipoEvento&quot;/>&lt;/TipoEvento>&lt;/Info>&lt;/xsl:when>&lt;xsl:otherwise>&lt;RimodulazioneDAI>&lt;NuovaDAI>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:RimodulazioneDAI/tns:NuovaDAI&quot;/>&lt;/NuovaDAI>&lt;xsl:if test=&quot;$Start/tns:AccessoGPON[1]/tns:RimodulazioneDAI/tns:FasciaOraria&quot;>&lt;FasciaOraria>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:RimodulazioneDAI/tns:FasciaOraria&quot;/>&lt;/FasciaOraria>&lt;/xsl:if>&lt;CodiceCausaleRimodulazione>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:RimodulazioneDAI/tns:CodiceCausaleRimodulazione&quot;/>&lt;/CodiceCausaleRimodulazione>&lt;DescrizioneCausaleRimodulazione>&lt;xsl:value-of select=&quot;$Start/tns:AccessoGPON[1]/tns:RimodulazioneDAI/tns:DescrizioneCausaleRimodulazione&quot;/>&lt;/DescrizioneCausaleRimodulazione>&lt;/RimodulazioneDAI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/AccessoGPON>&lt;/NotificaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.renderxml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value encoding="UTF-8"
                                    inputElementQName="NotificaOAO"
                                    outputStyle="text"
                                    validateInput="true" xsi:type="palettexml:RenderXml"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TransformXml-input"
                    name="TransformXml" outputVariable="TransformXml"
                    tibex:xpdlId="1c0530b9-c902-48e2-94c9-ab6476dd2301" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderXmlToTransformXml"/>
                        <bpws:target linkName="GenericLogger2ToTransformXml"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="TransformXmlToGenericLogger1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/transformxml&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Render&quot;/>&#xa;    &lt;xsl:template name=&quot;TransformXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:textInput>&#xa;            &lt;tns1:xmlString>&#xa;                &lt;xsl:value-of select=&quot;$Render&quot;/>&#xa;            &lt;/tns1:xmlString>&#xa;        &lt;/tns1:textInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.xml.transformxml"
                            version="6.0.0.20121128"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//TransformXml"/>
                                    <value inputOutputStyle="text"
                                    stylesheet="Resources/tim/now/notificationmanager/RemoveNamespace.xslt"
                                    xsi:type="palettexml:TransformXml" xsltEngine="TIBCO GenXDM XSLT 2.0"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TentativoContatto" name="Assign"
                    outputVariable="TentativoContatto"
                    tibex:xpdlId="4a3f0115-157b-411b-b19d-121618ad45fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenderToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToGenericLogger2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat(tib:substring-before-last(substring-after(tib:render-xml($Start),'>'),'&lt;'),'&lt;/tns:NotificaOAO>')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="TentativoContatto" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger2-input"
                    name="GenericLogger2"
                    tibex:xpdlId="266c5cdb-84eb-4421-aee0-8ed3e8251831"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToGenericLogger2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogger2ToTransformXml"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;TentativoContatto&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceGPON&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceGPON&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceGPON&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;TentativoContatto&amp;quot;, $TentativoContatto)&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
