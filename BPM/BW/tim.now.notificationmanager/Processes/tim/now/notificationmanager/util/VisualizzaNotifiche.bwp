                                    <bpws:from variable="ParseXDSL"/>
                                    <bpws:to variable="ParseXDSL"/>
                                    </bpws:copy>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="MapperXDSL"/>
                                    <bpws:to variable="MapperXDSL"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="8736d3dd-4b75-4a8e-b8d4-8e08847fb472" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperResponseToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperResponse</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="ParseREG-input"
                                    name="ParseREG"
                                    outputVariable="ParseREG"
                                    tibex:xpdlId="3852be23-f6a9-4b2a-a051-73410704ff3d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLogger1ToParseREG"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ParseREGToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;ParseREG-input&quot; match=&quot;/&quot;>&lt;tns:xmlString>&lt;xsl:value-of select=&quot;concat('&amp;lt;?xml version=&amp;quot;1.0&amp;quot; encoding=&amp;quot;UTF-8&amp;quot;?>', '&amp;lt;NotificaOloRegolatorio>', string($currentElement/column[name='TRACCIATO_FILE']/value), &amp;quot;&amp;#xA;&amp;quot;, '&amp;lt;/NotificaOloRegolatorio>')&quot;/>&lt;/tns:xmlString>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.parsexml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>

                                    <value
                                    inputStyle="text"
                                    outputElementQName="NotificaOloRegolatorio"
                                    validateOutput="true" xsi:type="palettexml:ParseXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    inputVariable="MapperREG-input"
                                    name="MapperREG"
                                    outputVariable="MapperREG"
                                    tibex:xpdlId="bacfba34-958f-47f5-975a-125f4e5f676f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseREGToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperREGToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseREG&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperREG-input&quot; match=&quot;/&quot;>&#xa;        &lt;NotificaOloRegolatorio>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseREG/NotificaCPS)&quot;>&#xa;                    &lt;NotificaCPS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($ParseREG/NotificaCPS/EsitoVerifiche)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseREG/NotificaCPS/EsitoVerifiche&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($ParseREG/NotificaCPS/EsitoValidazione)&quot;>&#xa;                                &lt;EsitoValidazione>&#xa;                                    &lt;CodiceFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/CodiceFornitore&quot;/>&#xa;                                    &lt;/CodiceFornitore>&#xa;                                    &lt;CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/CodiceOrdineFornitore&quot;/>&#xa;                                    &lt;/CodiceOrdineFornitore>&#xa;                                    &lt;CodiceRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/CodiceRichiedente&quot;/>&#xa;                                    &lt;/CodiceRichiedente>&#xa;                                    &lt;CodiceOrdineRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/CodiceOrdineRichiedente&quot;/>&#xa;                                    &lt;/CodiceOrdineRichiedente>&#xa;                                    &lt;DataDRO>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/DataDRO&quot;/>&#xa;                                    &lt;/DataDRO>&#xa;                                    &lt;DataNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/DataNotifica&quot;/>&#xa;                                    &lt;/DataNotifica>&#xa;                                    &lt;StatoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/StatoOrdine&quot;/>&#xa;                                    &lt;/StatoOrdine>&#xa;                                    &lt;DN>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/DN&quot;/>&#xa;                                    &lt;/DN>&#xa;                                    &lt;DataValidazioneFormaleContrattuale>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/DataValidazioneFormaleContrattuale&quot;/>&#xa;                                    &lt;/DataValidazioneFormaleContrattuale>&#xa;                                    &lt;DataValidazioneTecnicoGestionale>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/DataValidazioneTecnicoGestionale&quot;/>&#xa;                                    &lt;/DataValidazioneTecnicoGestionale>&#xa;                                    &lt;DataEstrazioneWL>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/DataEstrazioneWL&quot;/>&#xa;                                    &lt;/DataEstrazioneWL>&#xa;                                    &lt;xsl:copy-of select=&quot;$ParseREG/NotificaCPS/EsitoValidazione/Rifiuto&quot;/>&#xa;                                    &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Note&quot;>&#xa;                                        &lt;Note>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Note&quot;/>&#xa;                                        &lt;/Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ClassificazioneOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/ClassificazioneOrdine&quot;/>&#xa;                                    &lt;/ClassificazioneOrdine>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;((starts-with($ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente, 'kk') and string-length($ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente)>0))&quot;>&#xa;                                            &lt;Referente>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/NomeReferente&quot;>&#xa;                                                    &lt;NomeReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;'***'&quot;/>&#xa;                                                    &lt;/NomeReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;CognomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;'***'&quot;/>&#xa;                                                &lt;/CognomeReferente>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/IndirizzoReferente&quot;>&#xa;                                                    &lt;IndirizzoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/IndirizzoReferente&quot;/>&#xa;                                                    &lt;/IndirizzoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente&quot;>&#xa;                                                    &lt;TelefonoFissoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente&quot;/>&#xa;                                                    &lt;/TelefonoFissoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/FaxReferente&quot;>&#xa;                                                    &lt;FaxReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/FaxReferente&quot;/>&#xa;                                                    &lt;/FaxReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/EmailReferente&quot;>&#xa;                                                    &lt;EmailReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/EmailReferente&quot;/>&#xa;                                                    &lt;/EmailReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CapReferente&quot;>&#xa;                                                    &lt;CapReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CapReferente&quot;/>&#xa;                                                    &lt;/CapReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CodiceComuneReferente&quot;>&#xa;                                                    &lt;CodiceComuneReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CodiceComuneReferente&quot;/>&#xa;                                                    &lt;/CodiceComuneReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/Referente>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;((starts-with($ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente, 'kk') and string-length($ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente)=0))&quot;>&#xa;                                            &lt;Referente>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/NomeReferente&quot;>&#xa;                                                    &lt;NomeReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;'***'&quot;/>&#xa;                                                    &lt;/NomeReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;CognomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;'***'&quot;/>&#xa;                                                &lt;/CognomeReferente>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/IndirizzoReferente&quot;>&#xa;                                                    &lt;IndirizzoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/IndirizzoReferente&quot;/>&#xa;                                                    &lt;/IndirizzoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente&quot;>&#xa;                                                    &lt;TelefonoFissoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/TelefonoFissoReferente&quot;/>&#xa;                                                    &lt;/TelefonoFissoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/FaxReferente&quot;>&#xa;                                                    &lt;FaxReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/FaxReferente&quot;/>&#xa;                                                    &lt;/FaxReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/EmailReferente&quot;>&#xa;                                                    &lt;EmailReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/EmailReferente&quot;/>&#xa;                                                    &lt;/EmailReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CapReferente&quot;>&#xa;                                                    &lt;CapReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CapReferente&quot;/>&#xa;                                                    &lt;/CapReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CodiceComuneReferente&quot;>&#xa;                                                    &lt;CodiceComuneReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/Referente/CodiceComuneReferente&quot;/>&#xa;                                                    &lt;/CodiceComuneReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/Referente>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:copy-of select=&quot;$ParseREG/NotificaCPS/EsitoValidazione/Referente&quot;/>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/A375&quot;>&#xa;                                        &lt;A375>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/EsitoValidazione/A375&quot;/>&#xa;                                        &lt;/A375>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/EsitoValidazione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($ParseREG/NotificaCPS/EsitoEspletamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseREG/NotificaCPS/EsitoEspletamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($ParseREG/NotificaCPS/StatoAvanzamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseREG/NotificaCPS/StatoAvanzamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($ParseREG/NotificaCPS/PreAvvisoCessazione)&quot;>&#xa;                                &lt;PreAvvisoCessazione>&#xa;                                    &lt;CodiceFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/CodiceFornitore&quot;/>&#xa;                                    &lt;/CodiceFornitore>&#xa;                                    &lt;CodiceOrdineFornitore>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/CodiceOrdineFornitore&quot;/>&#xa;                                    &lt;/CodiceOrdineFornitore>&#xa;                                    &lt;DataNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/DataNotifica&quot;/>&#xa;                                    &lt;/DataNotifica>&#xa;                                    &lt;DN>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/DN&quot;/>&#xa;                                    &lt;/DN>&#xa;                                    &lt;DataSottoscrizioneContratto>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/DataSottoscrizioneContratto&quot;/>&#xa;                                    &lt;/DataSottoscrizioneContratto>&#xa;                                    &lt;DataPrevistaCessazione>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/DataPrevistaCessazione&quot;/>&#xa;                                    &lt;/DataPrevistaCessazione>&#xa;                                    &lt;CognomeRagSoc>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/CognomeRagSoc&quot;/>&#xa;                                    &lt;/CognomeRagSoc>&#xa;                                    &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Nome&quot;>&#xa;                                        &lt;Nome>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Nome&quot;/>&#xa;                                        &lt;/Nome>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;((starts-with($ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/TelefonoFissoReferente, 'kk') and string-length($ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/TelefonoFissoReferente)>0))&quot;>&#xa;                                            &lt;Referente>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/NomeReferente&quot;>&#xa;                                                    &lt;NomeReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;'***'&quot;/>&#xa;                                                    &lt;/NomeReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;CognomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;'***'&quot;/>&#xa;                                                &lt;/CognomeReferente>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/IndirizzoReferente&quot;>&#xa;                                                    &lt;IndirizzoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/IndirizzoReferente&quot;/>&#xa;                                                    &lt;/IndirizzoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/TelefonoFissoReferente&quot;>&#xa;                                                    &lt;TelefonoFissoReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/TelefonoFissoReferente&quot;/>&#xa;                                                    &lt;/TelefonoFissoReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/FaxReferente&quot;>&#xa;                                                    &lt;FaxReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/FaxReferente&quot;/>&#xa;                                                    &lt;/FaxReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/EmailReferente&quot;>&#xa;                                                    &lt;EmailReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/EmailReferente&quot;/>&#xa;                                                    &lt;/EmailReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/CapReferente&quot;>&#xa;                                                    &lt;CapReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/CapReferente&quot;/>&#xa;                                                    &lt;/CapReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/CodiceComuneReferente&quot;>&#xa;                                                    &lt;CodiceComuneReferente>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseREG/NotificaCPS[1]/PreAvvisoCessazione/Referente/CodiceComuneReferente&quot;/>&#xa;                                                    &lt;/CodiceComuneReferente>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/Referente>&#