                                    <bpws:extensionActivity>

                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;VisualizzaNotifiche&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperREG&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperXDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$currentElement/column[name='STRUTTURA_RICH']/value='REGOLATORIO'&quot;>&#xa;                    &lt;tns:DatiNotificheResponse>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($MapperREG/NotificaTrasformazioneULL)&quot;>&#xa;                                &lt;tns:contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperREG/NotificaTrasformazioneULL[1])&quot;/>&#xa;                                &lt;/tns:contenutoXML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MapperREG/NotificaULL)&quot;>&#xa;                                &lt;tns:contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperREG/NotificaULL[1])&quot;/>&#xa;                                &lt;/tns:contenutoXML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MapperREG/NotificaWLR)&quot;>&#xa;                                &lt;tns:contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperREG/NotificaWLR[1])&quot;/>&#xa;                                &lt;/tns:contenutoXML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MapperREG/NotificaCPS)&quot;>&#xa;                                &lt;tns:contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperREG/NotificaCPS[1])&quot;/>&#xa;                                &lt;/tns:contenutoXML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MapperREG/NotificaVsRecipient)&quot;>&#xa;                                &lt;tns:contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperREG/NotificaVsRecipient[1])&quot;/>&#xa;                                &lt;/tns:contenutoXML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MapperREG/NotificaVsDonorDonating)&quot;>&#xa;                                &lt;tns:contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperREG/NotificaVsDonorDonating[1])&quot;/>&#xa;                                &lt;/tns:contenutoXML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($MapperREG/NotificaSLU)&quot;>&#xa;                                &lt;tns:contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperREG/NotificaSLU[1])&quot;/>&#xa;                                &lt;/tns:contenutoXML>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:contenutoXML>&#xa;              