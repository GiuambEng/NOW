                                    </bpws:copy>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="ParseREG"/>
                                    <bpws:to variable="ParseREG"/>
                                    </bpws:copy>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="MapperREG"/>
                                    <bpws:to variable="MapperREG"/>
                                    </bpws:copy>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="ParseNGA"/>
                                    <bpws:to variable="ParseNGA"/>
                                    </bpws:copy>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="MapperNGA"/>
                                    <bpws:to variable="MapperNGA"/>
                                    </bpws:copy>
