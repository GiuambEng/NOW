                                <bpws:sequence name="sequence" tibex:group="iterate">
                                    <bpws:assign name="GroupInit"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+8736d3dd-4b75-4a8e-b8d4-8e08847fb472" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:forEach counterName="index"
                                    name="iterate" parallel="no" tibex:group="iterate">
                                    <tibex:DesignExpression name="variableList">
                                    <tibex:expression
                                    expression="$SQLDirect/unknownResultset[1]/row" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                                    <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SQLDirect/unknownResultset[1]/row)]]></bpws:finalCounterValue>
                                    <bpws:scope name="innerScope">
                                    <bpws:variables>
                                    <bpws:variable
                                    element="ns4:Iterate_Current_Element_row"
                                    name="currentElement" sca-bpel:internal="true"/>
                                    </bpws:variables>
                                    <bpws:flow name="flow2">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStartToGenericLogger1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="ParseREGToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToGenericLogger2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="ParseXmlToMapper1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperNGAToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperREGToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperResponseToAccumulate" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GenericLogger2ToParseNGA" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GenericLogger1ToParseREG" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToGenericLogger3" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GenericLogger3ToMapperResponse" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToEmpty1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Empty1ToMapperResponse" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="ParseXmlToMapperResponse" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="MapperToMapperResponse" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="9275a224-7513-4eef-836f-4ebdcae670a1" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToGenericLogger1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$currentElement/column[name='STRUTTURA_RICH']/value='REGOLATORIO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$currentElement/column[name='STRUTTURA_RICH']/value='REGOLATORIO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToGenericLogger2">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$currentElement/column[name='STRUTTURA_RICH']/value='NGA' and $currentElement/column[name='NGA_GPON']/value!='SI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$currentElement/column[name='STRUTTURA_RICH']/value='NGA' and $currentElement/column[name='NGA_GPON']/value!='SI']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToGenericLogger3">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$currentElement/column[name='STRUTTURA_RICH']/value='XDSL'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$currentElement/column[name='STRUTTURA_RICH']/value='XDSL']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEmpty1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($SQLDirect/unknownResultset[1]/row)[number($index)]]]></bpws:from>
