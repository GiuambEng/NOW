                                    outputVariable="SQLDirect"
                                    tibex:xpdlId="42d8ca91-eff0-4db6-9f34-f907ae9dad08" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
