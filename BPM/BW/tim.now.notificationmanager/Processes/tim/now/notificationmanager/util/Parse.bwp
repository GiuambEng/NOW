                                <tibex:expression
                                    expression="$Start/ns0:StrutturaRichiesta = &quot;XDSL&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:StrutturaRichiesta = "XDSL"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:StrutturaRichiesta = &quot;NPN&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:StrutturaRichiesta = "NPN"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToEmpty2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToParseXml1">
                            <tibex:DesignExpression>
