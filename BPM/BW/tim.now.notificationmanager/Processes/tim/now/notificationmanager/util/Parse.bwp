            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="b7484e6c-ad99-44b8-9c37-ec16ace11505"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToParseXml">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:StrutturaRichiesta = &quot;REGOLATORIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:StrutturaRichiesta = "REGOLATORIO"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:StrutturaRichiesta = &quot;NGA&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/ns0:StrutturaRichiesta = "NGA"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToParseXml2">
