                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT &#xa;RA.CODICE_ADR as CODICEAREARACCOLTA,&#xa;RA.DESCRIZIONE_AREA as DESCRIZIONEAREA, &#xa;RA.ID_MACROAREA, &#xa;RA.TIPOLOGIA_ADR, &#xa;RM.CODICE_ADR as CODICEMACROAREA, &#xa;nvl(RM.DESCRIZIONE_AREA, RA.DESCRIZIONE_AREA )  as DESCRIZIONEMACROAREA&#xa;FROM ANAGRAFICA_ADR RA, ANAGRAFICA_ADR RM&#xa;WHERE &#xa;RA.ID_ADR_CRMWS=? &#xa;and RA.ID_MACROAREA=RM.ID_ADR_CRMWS " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ADR_CRMWS"/>
                                    <columnMetadata
                                    columnName="CODICEAREARACCOLTA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONEAREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_MACROAREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIA_ADR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEMACROAREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCRIZIONEMACROAREA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
