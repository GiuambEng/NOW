lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:QuotaVariabile&gt;&lt;/xsl:if&gt;&lt;tns1:LunghezzaTotaleLinea&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/QTA_ARTICOLO)"/&gt;&lt;/tns1:LunghezzaTotaleLinea&gt;&lt;tns1:PrezzoTotale&gt;&lt;xsl:value-of select="xsd:double(string($JDBC_IDConsuntivo/Record[1]/IMPORTO_TOT))"/&gt;&lt;/tns1:PrezzoTotale&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;])"&gt;&lt;tns1:Altro&gt;&lt;tns1:DescrizioneOpera&gt;&lt;xsl:value-of select="$JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;]/DESCR_ARTICOLO_DTU"/&gt;&lt;/tns1:DescrizioneOpera&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:Altro&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/tns1:DescrizioneOpere&gt;&lt;tns1:GiorniPrevisti&gt;&lt;xsl:value-of select="xsd:int($JDBC_IDConsuntivo/Record[1]/NUMERO_GIORNI_PREVISTO)"/&gt;&lt;/tns1:GiorniPrevisti&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$JDBC_IDConsuntivo/Record[1]/FLAG_PERMESSI=&amp;quot;Y&amp;quot;"&gt;&lt;tns1:FlagPermessi&gt;&lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;&lt;/tns1:FlagPermessi&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:FlagPermessi&gt;&lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;&lt;/tns1:FlagPermessi&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:PreventivoOpereSpecialiResponse&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:PreventivoOpereSpecialiResponse&gt;&lt;tns1:DescrizioneOpere&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;])"&gt;&lt;tns1:Tubazione&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:Tubazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;])"&gt;&lt;tns1:Pozzetto&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:Pozzetto&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;])"&gt;&lt;tns1:Ripristini&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:Ripristini&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;])"&gt;&lt;tns1:PosaPaloInTerrenoStandard&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:PosaPaloInTerrenoStandard&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;])"&gt;&lt;tns1:PosaPaloInRoccia&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:PosaPaloInRoccia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;])"&gt;&lt;tns1:ScavoRinterroConDisfacimentoPavimentazione&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:ScavoRinterroConDisfacimentoPavimentazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;])"&gt;&lt;tns1:ScavoRinterroInTerrenoSterrato&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:ScavoRinterroInTerrenoSterrato&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;])"&gt;&lt;tns1:SupplementoPerScavoInRoccia&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:SupplementoPerScavoInRoccia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;QUOTAFISSA&amp;quot;])"&gt;&lt;tns1:QuotaFissa&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;QUOTAFISSA&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:QuotaFissa&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;])"&gt;&lt;tns1:QuotaVariabile&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:QuotaVariabile&gt;&lt;/xsl:if&gt;&lt;tns1:LunghezzaTotaleLinea&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/QT_ARTICOLO)"/&gt;&lt;/tns1:LunghezzaTotaleLinea&gt;&lt;tns1:PrezzoTotale&gt;&lt;xsl:value-of select="xsd:double(string($JDBC_IDPreventivo/Record[1]/IMPORTO_TOT))"/&gt;&lt;/tns1:PrezzoTotale&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;])"&gt;&lt;tns1:Altro&gt;&lt;tns1:DescrizioneOpera&gt;&lt;xsl:value-of select="$JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;]/DESCR_ARTICOLO_DTU"/&gt;&lt;/tns1:DescrizioneOpera&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:Altro&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;/tns1:DescrizioneOpere&gt;&lt;tns1:GiorniPrevisti&gt;&lt;xsl:value-of select="xsd:int($JDBC_IDPreventivo/Record[1]/NUMERO_GIORNI_PREVISTO)"/&gt;&lt;/tns1:GiorniPrevisti&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$JDBC_IDPreventivo/Record[1]/FLAG_PERMESSI=&amp;quot;Y&amp;quot;"&gt;&lt;tns1:FlagPermessi&gt;&lt;xsl:value-of select="&amp;quot;1&amp;quot;"/&gt;&lt;/tns1:FlagPermessi&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:FlagPermessi&gt;&lt;xsl:value-of select="&amp;quot;0&amp;quot;"/&gt;&lt;/tns1:FlagPermessi&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:PreventivoOpereSpecialiResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/output&gt;&lt;/tns:PreventivoOpereSpecialiResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstarct/PreventivoOpereSpeciali/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;PreventivoOpereSpecialiInput.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DettaglioPreventivo&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_IDPreventivo&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_IDConsuntivo&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DettaglioConsuntivo&quot;/>&#xa;    &lt;xsl:template name=&quot;PreventivoOpereSpecialiOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($PreventivoOpereSpecialiInput.input/tns1:IDConsuntivo)&quot;>&#xa;                &lt;tns1:PreventivoOpereSpecialiResponse>&#xa;                    &lt;tns1:DescrizioneOpere>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;])&quot;>&#xa;                            &lt;tns1:Tubazione>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:Tubazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;])&quot;>&#xa;                            &lt;tns1:Pozzetto>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:Pozzetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;])&quot;>&#xa;                            &lt;tns1:Ripristini>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:Ripristini>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;])&quot;>&#xa;                            &lt;tns1:PosaPaloInTerrenoStandard>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:PosaPaloInTerrenoStandard>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;])&quot;>&#xa;                            &lt;tns1:PosaPaloInRoccia>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:PosaPaloInRoccia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;])&quot;>&#xa;                            &lt;tns1:ScavoRinterroConDisfacimentoPavimentazione>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:ScavoRinterroConDisfacimentoPavimentazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;])&quot;>&#xa;                            &lt;tns1:ScavoRinterroInTerrenoSterrato>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:ScavoRinterroInTerrenoSterrato>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;])&quot;>&#xa;                            &lt;tns1:SupplementoPerScavoInRoccia>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:SupplementoPerScavoInRoccia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;QUOTAFISSA&amp;quot;])&quot;>&#xa;                            &lt;tns1:QuotaFissa>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;QUOTAFISSA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:QuotaFissa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;])&quot;>&#xa;                            &lt;tns1:QuotaVariabile>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:QuotaVariabile>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:LunghezzaTotaleLinea>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/QTA_ARTICOLO)&quot;/>&#xa;                        &lt;/tns1:LunghezzaTotaleLinea>&#xa;                        &lt;tns1:PrezzoTotale>&#xa;                            &lt;xsl:value-of select=&quot;xsd:double(string($JDBC_IDConsuntivo/Record[1]/IMPORTO_TOT))&quot;/>&#xa;                        &lt;/tns1:PrezzoTotale>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;])&quot;>&#xa;                                &lt;tns1:Altro>&#xa;                                    &lt;tns1:DescrizioneOpera>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;]/DESCR_ARTICOLO_DTU&quot;/>&#xa;                                    &lt;/tns1:DescrizioneOpera>&#xa;                                    &lt;tns1:MisuraOpera>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:MisuraOpera>&#xa;                                    &lt;tns1:Prezzo>&#xa;                                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                    &lt;/tns1:Prezzo>&#xa;                                &lt;/tns1:Altro>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:DescrizioneOpere>&#xa;                    &lt;tns1:GiorniPrevisti>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBC_IDConsuntivo/Record[1]/NUMERO_GIORNI_PREVISTO)&quot;/>&#xa;                    &lt;/tns1:GiorniPrevisti>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBC_IDConsuntivo/Record[1]/FLAG_PERMESSI=&amp;quot;Y&amp;quot;&quot;>&#xa;                            &lt;tns1:FlagPermessi>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/tns1:FlagPermessi>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:FlagPermessi>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns1:FlagPermessi>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:PreventivoOpereSpecialiResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:PreventivoOpereSpecialiResponse>&#xa;                    &lt;tns1:DescrizioneOpere>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;])&quot;>&#xa;                            &lt;tns1:Tubazione>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;TUBAZIONE&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:Tubazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;])&quot;>&#xa;                            &lt;tns1:Pozzetto>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POZZETTO&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:Pozzetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;])&quot;>&#xa;                            &lt;tns1:Ripristini>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:Ripristini>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;])&quot;>&#xa;                            &lt;tns1:PosaPaloInTerrenoStandard>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:PosaPaloInTerrenoStandard>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;])&quot;>&#xa;                            &lt;tns1:PosaPaloInRoccia>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:PosaPaloInRoccia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;])&quot;>&#xa;                            &lt;tns1:ScavoRinterroConDisfacimentoPavimentazione>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:ScavoRinterroConDisfacimentoPavimentazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;])&quot;>&#xa;                            &lt;tns1:ScavoRinterroInTerrenoSterrato>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOTERRENO&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:ScavoRinterroInTerrenoSterrato>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;])&quot;>&#xa;                            &lt;tns1:SupplementoPerScavoInRoccia>&#xa;                                &lt;tns1:MisuraOpera>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:MisuraOpera>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOROCCIA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:SupplementoPerScavoInRoccia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;QUOTAFISSA&amp;quot;])&quot;>&#xa;                            &lt;tns1:QuotaFissa>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;QUOTAFISSA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:QuotaFissa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;])&quot;>&#xa;                            &lt;tns1:QuotaVariabile>&#xa;                                &lt;tns1:Prezzo>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:double($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/IMPORTO_ARTICOLO)&quot;/>&#xa;                                &lt;/tns1:Prezzo>&#xa;                            &lt;/tns1:QuotaVariabile>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:LunghezzaTotaleLinea>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;LUNGHEZZATOTALELINEA&amp;quot;]/QT_ARTICOLO)&quot;/>&#xa;                        &lt;/tns1:LunghezzaTotaleLinea>&#xa;                        &lt;tns1:PrezzoTotale>&#xa;                            &lt;xsl:value-of select=&quot;xsd:double(string($JDBC_IDPreventivo/Record[1]/IMPORTO_TOT))&quot;/>&#xa;                        &lt;/tns1:PrezzoTotale>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;])&quot;>&#xa;                                &lt;tns1:Altro>&#xa;                                    &lt;tns1:DescrizioneOpera>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_DettaglioPreventivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;DESCRIZIONEARTICOLONOW&amp;quot;]/DESCR_ARTICOLO_DTU&quot;/>&#xa;                                    &lt;/tns1:DescrizioneOpera>&#xa;                                    &lt;tns1:MisuraOpera>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:MisuraOpera>&#xa;                                    &lt;tns1:Prezzo>&#xa;                                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                    &lt;/tns1:Prezzo>&#xa;                                &lt;/tns1:Altro>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:DescrizioneOpere>&#xa;                    &lt;tns1:GiorniPrevisti>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($JDBC_IDPreventivo/Record[1]/NUMERO_GIORNI_PREVISTO)&quot;/>&#xa;                    &lt;/tns1:GiorniPrevisti>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBC_IDPreventivo/Record[1]/FLAG_PERMESSI=&amp;quot;Y&amp;quot;&quot;>&#xa;                            &lt;tns1:FlagPermessi>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/tns1:FlagPermessi>&#xa;                        &lt;/xsl:when>&#xa;                        &