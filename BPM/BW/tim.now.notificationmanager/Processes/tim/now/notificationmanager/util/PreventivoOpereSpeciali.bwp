                                <tibex:expression
                                    expression="exists($PreventivoOpereSpecialiInput/input/tns:PreventivoOpereSpecialiRequest/tns:IDConsuntivo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
