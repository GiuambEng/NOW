                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToPreventivoOpereSpecialiOutput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;PreventivoOpereSpecialiInput.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_IDPreventivo&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DettaglioConsuntivo&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_PreventivoOpereSpecialiOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PreventivoOpereSpeciali&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PreventivoOpereSpecialiPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PreventivoOpereSpeciali&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$PreventivoOpereSpecialiInput.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($PreventivoOpereSpecialiInput.input/tns1:IDConsuntivo)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_DettaglioConsuntivo/Record)&quot;>&#xa;                                &lt;tns:Message>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Trovati record JDBC_DettaglioConsuntivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput.input/tns1:IDConsuntivo))&quot;/>&#xa;                                &lt;/tns:Message>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:Message>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Non trovati record JDBC_DettaglioConsuntivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput.input/tns1:IDConsuntivo))&quot;/>&#xa;                                &lt;/tns:Message>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_IDPreventivo/Record)&quot;>&#xa;                                &lt;tns:Message>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Trovati record JDBC_DettaglioPreventivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput.input/tns1:IDPreventivo))&quot;/>&#xa;                                &lt;/tns:Message>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:Message>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Non trovati record JDBC_DettaglioPreventivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput.input/tns1:IDPreventivo))&quot;/>&#xa;                                &lt;/tns:Message>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
