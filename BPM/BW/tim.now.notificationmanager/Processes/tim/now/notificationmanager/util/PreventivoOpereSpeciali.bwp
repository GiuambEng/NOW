LO_DTU = &amp;quot;RIPRISTINI&amp;quot;])"&gt;&lt;tns1:Ripristini&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/QTA_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;RIPRISTINI&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:Ripristini&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;])"&gt;&lt;tns1:PosaPaloInTerrenoStandard&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/QTA_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOTERRENOSTANDARD&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:PosaPaloInTerrenoStandard&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;])"&gt;&lt;tns1:PosaPaloInRoccia&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/QTA_ARTICOLO)"/&gt;&lt;/tns1:MisuraOpera&gt;&lt;tns1:Prezzo&gt;&lt;xsl:value-of select="xsd:double($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;POSAPALOROCCIA&amp;quot;]/IMPORTO_ARTICOLO)"/&gt;&lt;/tns1:Prezzo&gt;&lt;/tns1:PosaPaloInRoccia&gt;&lt;/xsl:if&gt;&lt;xsl:if test="exists($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;])"&gt;&lt;tns1:ScavoRinterroConDisfacimentoPavimentazione&gt;&lt;tns1:MisuraOpera&gt;&lt;xsl:value-of select="xsd:int($JDBC_DettaglioConsuntivo/Record[DESCR_ARTICOLO_DTU = &amp;quot;SCAVOPAVIMENTAZIONE&amp;quot;]/Q