                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4cf469c2-a365-40ad-9348-2adc2a558553+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PreventivoOpereSpecialiInput&quot;/>&lt;xsl:template name=&quot;JDBC_DettaglioConsuntivo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_CONSUNTIVO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDConsuntivo)&quot;>&lt;xsl:value-of select=&quot;$PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDConsuntivo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_CONSUNTIVO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_DettaglioConsuntivo-input"
                    name="JDBC_DettaglioConsuntivo"
                    outputVariable="JDBC_DettaglioConsuntivo"
                    tibex:xpdlId="4cf469c2-a365-40ad-9348-2adc2a558553" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery3ToJDBCQuery4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_DettaglioConsuntivoToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4cf469c2-a365-40ad-9348-2adc2a558553+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;PreventivoOpereSpecialiInput.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_DettaglioConsuntivo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_CONSUNTIVO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($PreventivoOpereSpecialiInput.input/tns1:IDConsuntivo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$PreventivoOpereSpecialiInput.input/tns1:IDConsuntivo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CONSUNTIVO>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TR.DESCR_ARTICOLO_DTU, DC.QTA_ARTICOLO, DC.IMPORTO_ARTICOLO&#xa;  FROM TRASCODFC_ARTICOLI_DTU_JPUB TR, DETT_CONSUNTIVO DC&#xa;  WHERE DC.ID_CONSUNTIVO = ? AND TR.COD_ARTICOLO_JPUB = DC.COD_ARTICOLO_JPUB" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_CONSUNTIVO"/>
                                    <columnMetadata
                                    columnName="DESCR_ARTICOLO_DTU"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="QTA_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IMPORTO_ARTICOLO"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;JDBC_IDPreventivo&quot;/>&lt;xsl:param name=&quot;PreventivoOpereSpecialiInput&quot;/>&lt;xsl:param name=&quot;JDBC_DettaglioConsuntivo&quot;/>&lt;xsl:template name=&quot;LOG_PreventivoOpereSpecialiOutput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;PreventivoOpereSpeciali&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;PreventivoOpereSpecialiPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;PreventivoOpereSpeciali&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDConsuntivo)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DettaglioConsuntivo/Record)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Trovati record JDBC_DettaglioConsuntivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDConsuntivo))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Non trovati record JDBC_DettaglioConsuntivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDConsuntivo))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_IDPreventivo/Record)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Trovati record JDBC_DettaglioPreventivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDPreventivo))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Non trovati record JDBC_DettaglioPreventivo per l'ID: &amp;quot;, string($PreventivoOpereSpecialiInput/input/tns1:PreventivoOpereSpecialiRequest/tns1:IDPreventivo))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_PreventivoOpereSpecialiOutput-input"
                    name="LOG_PreventivoOpereSpecialiOutput"
