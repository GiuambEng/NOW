                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npn&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceNPNIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;Prenotifica_DonatingRenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;Prenotifica_Donating>&#xa;            &lt;TipoComunicazione>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:TipoComunicazione&quot;/>&#xa;            &lt;/TipoComunicazione>&#xa;            &lt;CodiceOrdine>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:CodiceOrdine&quot;/>&#xa;            &lt;/CodiceOrdine>&#xa;            &lt;DataOrdine>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:DataOrdine&quot;/>&#xa;            &lt;/DataOrdine>&#xa;            &lt;DirectoryNumber>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:DirectoryNumber&quot;/>&#xa;            &lt;/DirectoryNumber>&#xa;            &lt;xsl:if test=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:TipoLinea&quot;>&#xa;                &lt;TipoLinea>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:TipoLinea&quot;/>&#xa;                &lt;/TipoLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:Note&quot;>&#xa;                &lt;Note>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:Note&quot;/>&#xa;                &lt;/Note>&#xa;            &lt;/xsl:if>&#xa;            &lt;DataInvioMessaggio>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:DataInvioMessaggio&quot;/>&#xa;            &lt;/DataInvioMessaggio>&#xa;            &lt;IdentificativoOperatoreDonor>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:IdentificativoOperatoreDonor&quot;/>&#xa;            &lt;/IdentificativoOperatoreDonor>&#xa;            &lt;xsl:if test=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:NomeCliente&quot;>&#xa;                &lt;NomeCliente>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:NomeCliente&quot;/>&#xa;                &lt;/NomeCliente>&#xa;            &lt;/xsl:if>&#xa;            &lt;CognomeCliente_RagioneSociale>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:CognomeCliente_RagioneSociale&quot;/>&#xa;            &lt;/CognomeCliente_RagioneSociale>&#xa;            &lt;TelefonoReferenteRichiedente>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:TelefonoReferenteRichiedente&quot;/>&#xa;            &lt;/TelefonoReferenteRichiedente>&#xa;            &lt;EmailReferenteRichiedente>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:EmailReferenteRichiedente&quot;/>&#xa;            &lt;/EmailReferenteRichiedente>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:Correlazioni)&quot;>&#xa;                    &lt;Correlazioni>&#xa;                        &lt;IdentificativoCorrelazioni>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:Correlazioni/tns:IdentificativoCorrelazioni&quot;/>&#xa;                        &lt;/IdentificativoCorrelazioni>&#xa;                        &lt;TotaleRichieste>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:Correlazioni/tns:TotaleRichieste&quot;/>&#xa;                        &lt;/TotaleRichieste>&#xa;                    &lt;/Correlazioni>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CodiceOpRecipient>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:CodiceOpRecipient&quot;/>&#xa;            &lt;/CodiceOpRecipient>&#xa;            &lt;DataAttesaConsegnaServizio>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:DataAttesaConsegnaServizio&quot;/>&#xa;            &lt;/DataAttesaConsegnaServizio>&#xa;            &lt;xsl:if test=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:CodiceProgetto&quot;>&#xa;                &lt;CodiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:CodiceProgetto&quot;/>&#xa;                &lt;/CodiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:FlagNPNumerazioniAggiuntive&quot;>&#xa;                &lt;FlagNPNumerazioniAggiuntive>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:FlagNPNumerazioniAggiuntive&quot;/>&#xa;                &lt;/FlagNPNumerazioniAggiuntive>&#xa;            &lt;/xsl:if>&#xa;            &lt;CodiceSegreto>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:CodiceSegreto&quot;/>&#xa;            &lt;/CodiceSegreto>&#xa;            &lt;IdentificativoOperatoreDonating>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPNIn.Input/tns:Prenotifica_Donating/tns:IdentificativoOperatoreDonating&