    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToRenderXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenderXmlToTransformXml" tibex:linkType="SUCCESS"/>
                <bpws:link name="TransformXmlToGenericLogger1" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLogger1ToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="aa92a238-18c7-46ca-94ad-51fe5588b3ea"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToGenericLogger"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="d1abf57a-e483-448e-a579-d78e704e3d41" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLogger1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RemoveNamespace&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TransformXml&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns3:NotificaXMLString>&lt;xsl:value-of select=&quot;$TransformXml&quot;/>&lt;/tns3:NotificaXMLString>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger-input"
                    name="GenericLogger"
                    tibex:xpdlId="56465ae8-8d77-4de1-8804-764a3dc532db"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToRenderXml"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceFBS&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceFBS&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceFBS&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in input:&amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="RenderXml-input"
                    name="RenderXml" outputVariable="RenderXml"
                    tibex:xpdlId="82d01d10-0825-462a-8993-0c6fdfdebe7e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToRenderXml"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenderXmlToTransformXml"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/fiberstream&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;NotificaOAO>&lt;Accesso>&lt;TestataNotifica>&lt;CodiceFornitore>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:CodiceFornitore&quot;/>&lt;/CodiceFornitore>&lt;xsl:if test=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;>&lt;CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;/>&lt;/CodiceOrdineFornitore>&lt;/xsl:if>&lt;CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:CodiceOrdineRichiedente&quot;/>&lt;/CodiceOrdineRichiedente>&lt;DataNotifica>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:DataNotifica&quot;/>&lt;/DataNotifica>&lt;StatoOrdine>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:StatoOrdine&quot;/>&lt;/StatoOrdine>&lt;xsl:if test=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:DataDRO&quot;>&lt;DataDRO>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:DataDRO&quot;/>&lt;/DataDRO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:CodiceOrdineOF&quot;>&lt;CodiceOrdineOF>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:CodiceOrdineOF&quot;/>&lt;/CodiceOrdineOF>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:Note&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:Note&quot;/>&lt;/Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:Accesso[1]/tns:TestataNotifica/tns:TimestampOrigine&quot;>&lt;