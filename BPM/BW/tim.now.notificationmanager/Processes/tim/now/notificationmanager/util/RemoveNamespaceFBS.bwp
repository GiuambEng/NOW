        <bpws:variable element="ns1:NotificaOAO" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="NotificaOAO" name="RenderXml-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:xmlString" name="RenderXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityErrorData"
            name="_error_RenderXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:textInput" name="TransformXml-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:xmlString" name="TransformXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:ActivityErrorData"
            name="_error_TransformXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
