                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TransformXml&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:template name=&quot;GenericLogger1-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceFBS&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceFBS&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RemoveNamespaceFBS&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in output&amp;quot;, tib:render-xml($TransformXml, true(), true()))&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
