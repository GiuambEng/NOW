    name="tim.now.notificationmanager.util.RemoveNamespace"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20160919161918"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://xmlns.example.com/20160919161918PLT"
    xmlns:ns0="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns1="http://www.tim.com/NOW/wsdl/abstract/RemoveNamespace"
    xmlns:ns2="http://xsd.telecomitalia.it/crm/fibercop"
