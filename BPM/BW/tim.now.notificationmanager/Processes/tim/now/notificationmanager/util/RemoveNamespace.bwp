            xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:RemoveNamespacePortType"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType1">
                <plnk:role name="use" portType="ptyp:RemoveNamespaceREGPortType"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType2">
                <plnk:role name="use" portType="ptyp:RemoveNamespaceNPNPortType"/>
            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType3">
                <plnk:role name="use" portType="ptyp:RemoveNamespaceNPRPortType"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/RemoveNamespace"/>
        </wsdl:definitions>
    </tibex:Types>
