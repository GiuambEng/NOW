                <bpws:sources>
                    <bpws:source linkName="StartToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RemoveNamespaceIn/Input/tns:RemoveNamespaceRequest/tns:StrutturaRichiesta = &quot;NPN&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$RemoveNamespaceIn.Input/tns:StrutturaRichiesta = "NPN"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RemoveNamespaceIn/Input/tns:RemoveNamespaceRequest/tns:StrutturaRichiesta = &quot;REGOLATORIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$RemoveNamespaceIn.Input/tns:StrutturaRichiesta = "REGOLATORIO"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToRemoveNamespaceGPON">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RemoveNamespaceIn/Input/tns:RemoveNamespaceRequest/tns:StrutturaRichiesta = &quot;NGA&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$RemoveNamespaceIn.Input/tns:StrutturaRichiesta = "NGA"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="StartToRemoveNamespaceFBS">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RemoveNamespaceIn/Input/tns:RemoveNamespaceRequest/tns:StrutturaRichiesta = &quot;FIBERSTREAM&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$RemoveNamespaceIn.Input/tns:StrutturaRichiesta = "FIBERSTREAM"]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
