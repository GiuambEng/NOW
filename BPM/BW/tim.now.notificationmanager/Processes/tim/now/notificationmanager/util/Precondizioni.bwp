            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if(&#xd;&#xa;&#xd;&#xa;tib:compare-date(tib:parse-date(&quot;yyyy-MM-dd&quot;,format-date($Start/ns1:RichiestaElement/DAC,&quot;[Y0001]-[M01]-[D01]&quot;)),tib:parse-date(&quot;yyyy-MM-dd&quot;,format-date($DRO5/parameters/tns:Response/tns:outputDate,&quot;[Y0001]-[M01]-[D01]&quot;)))&lt;0&#xd;&#xa;&#xd;&#xa;or&#xd;&#xa;&#xd;&#xa;tib:compare-date(tib:parse-date(&quot;yyyy-MM-dd&quot;,format-date($Start/ns1:RichiestaElement/DAC,&quot;[Y0001]-[M01]-[D01]&quot;)),tib:parse-date(&quot;yyyy-MM-dd&quot;,format-date($DRO5/parameters/tns:Response/tns:outputDate,&quot;[Y0001]-[M01]-[D01]&quot;)))=0&#xd;&#xa;&#xd;&#xa;) then 'False' else 'True'"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="CheckRDAC" name="Assign"
                    outputVariable="CheckRDAC"
                    tibex:xpdlId="007bef88-b0a2-48b0-8d99-c4f9e9eeefbc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
