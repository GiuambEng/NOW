                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:ns1="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns="http://www.tim.com/NOW/xsd/GetNextDate" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
