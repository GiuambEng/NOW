            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+52c594f9-b217-42de-9016-c49e55b5addc+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryCheck_TC3-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_TIPOLG_NOTF>&lt;xsl:value-of select=&quot;&amp;quot;TC3&amp;quot;&quot;/>&lt;/COD_TIPOLG_NOTF>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodificaOLOAGCOMDestinatario)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAGCOMDestinatario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;DESCR>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/DESCR>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCQueryCheck_TC3-input"
                    name="JDBCQueryCheck_TC3"
                    outputVariable="JDBCQueryCheck_TC3"
                    tibex:xpdlId="52c594f9-b217-42de-9016-c49e55b5addc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQueryCheck_TC3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryCheck_Name">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryCheck_TC3ToLogOutput1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="if($Start/ns0:CodificaOLOAGCOMDestinatario = &quot;TLC&quot; and not($Start/ns1:RichiestaElement/flagDelibera103='Y')) then count($JDBCQueryCheck_TC3/Record) >= 2 else count($JDBCQueryCheck_TC3/Record) >= 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[if($Start/ns0:CodificaOLOAGCOMDestinatario = "TLC" and not($Start/ns1:RichiestaElement/flagDelibera103='Y')) then count($JDBCQueryCheck_TC3/Record) >= 2 else count($JDBCQueryCheck_TC3/Record) >= 1]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+52c594f9-b217-42de-9016-c49e55b5addc+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryCheck_TC3-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_TIPOLG_NOTF>&lt;xsl:value-of select=&quot;&amp;quot;TC3&amp;quot;&quot;/>&lt;/COD_TIPOLG_NOTF>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodificaOLOAGCOMDestinatario)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodificaOLOAGCOMDestinatario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;DESCR>&lt;xsl:value-of select=&quot;&amp;quot;DONATING&amp;quot;&quot;/>&lt;/DESCR>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOTF.ID_NOTF&#xa;  FROM RICH_ORDN_COMUNIC_NOTF NOTF, TIPOLG_DESTNRIO_NOTF TIP&#xa;  WHERE NOTF.COD_TIPOLG_NOTF = ? AND NOTF.ID_RICH_OLO = ?&#xa;  AND NOTF.CODFC_OLO_AGCOM = ? AND NOTF.IDTPLG_DESTNRIO_NOTF = TIP.IDTPLG_DESTNRIO_NOTF&#xa;  AND TIP.DESCR = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_TIPOLG_NOTF"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
