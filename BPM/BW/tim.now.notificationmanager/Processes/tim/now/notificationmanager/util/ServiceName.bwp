                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ServiceName/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ServiceName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ServiceNameIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;ServiceName&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO_NORM&quot;/>&#xa;    &lt;xsl:template name=&quot;ServiceNameOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ServiceNameResponse>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameIn.input/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:TipologiaNotifica>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameIn.input/tns1:TipologiaNotifica&quot;/>&#xa;            &lt;/tns1:TipologiaNotifica>&#xa;            &lt;xsl:if test=&quot;$ServiceNameIn.input/tns1:Offerta&quot;>&#xa;                &lt;tns1:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;$ServiceNameIn.input/tns1:Offerta&quot;/>&#xa;                &lt;/tns1:Offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameIn.input/tns1:Lavorazione&quot;/>&#xa;            &lt;/tns1:Lavorazione>&#xa;            &lt;tns1:TipologiaOLODestinatario>&#xa;                &lt;xsl:value-of select=&quot;$ServiceNameIn.input/tns1:TipologiaOLODestinatario&quot;/>&#xa;            &lt;/tns1:TipologiaOLODestinatario>&#xa;            &lt;xsl:if test=&quot;$ServiceNameIn.input/tns1:IDRichiestaOLO&quot;>&#xa;                &lt;tns1:IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$ServiceNameIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;  