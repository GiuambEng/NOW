            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="ptyp:ServiceNamePortType"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/ServiceName/"/>
        </wsdl:definitions>
