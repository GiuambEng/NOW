                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/transformxml&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;TRASFORMAZIONESLURenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;WLRRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;SLURenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;DONORRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;RECIPIENTRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ULLRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;TrasformazioneULLRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;TentativiContatto&quot;/>&#xa;    &lt;xsl:template name=&quot;RevomeNamespaceTransform-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:textInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaTrasformazioneULL)&quot;>&#xa;                    &lt;tns2:xmlString>&#xa;                        &lt;xsl:value-of select=&quot;$TrasformazioneULLRenderXml&quot;/>&#xa;                    &lt;/tns2:xmlString>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaULL)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaULL/tns:TentativiContatto)&quot;>&#xa;                            &lt;tns2:xmlString>&#xa;                                &lt;xsl:value-of select=&quot;$TentativiContatto&quot;/>&#xa;                            &lt;/tns2:xmlString>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:xmlString>&#xa;                                &lt;xsl:value-of select=&quot;$ULLRenderXml&quot;/>&#xa;                            &lt;/tns2:xmlString>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaWLR)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TentativiContatto)&quot;>&#xa;                            &lt;tns2:xmlString>&#xa;                                &lt;xsl:value-of select=&quot;$TentativiContatto&quot;/>&#xa;                            &lt;/tns2:xmlString>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:xmlString>&#xa;                                &lt;xsl:value-of select=&quot;$WLRRenderXml&quot;/>&#xa;                            &lt;/tns2:xmlString>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaCPS)&quot;>&#xa;                    &lt;tns2:xmlString>&#xa;                        &lt;xsl:value-of select=&quot;$CPSRenderXml&quot;/>&#xa;                    &lt;/tns2:xmlString>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaVsRecipient)&quot;>&#xa;                    &lt;tns2:xmlString>&#xa;                        &lt;xsl:value-of select=&quot;$RECIPIENTRenderXml&quot;/>&#xa;                    &lt;/tns2:xmlString>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaVsDonorDonating)&quot;>&#xa;                    &lt;tns2:xmlString>&#xa;                        &lt;