                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;CPSRenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;NotificaCPS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche)&quot;>&#xa;                    &lt;EsitoVerifiche>&#xa;                        &lt;CodiceFornitore>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:CodiceFornitore&quot;/>&#xa;                        &lt;/CodiceFornitore>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:CodiceOrdineFornitore&quot;>&#xa;                            &lt;CodiceOrdineFornitore>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:CodiceOrdineFornitore&quot;/>&#xa;                            &lt;/CodiceOrdineFornitore>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CodiceRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:CodiceRichiedente&quot;/>&#xa;                        &lt;/CodiceRichiedente>&#xa;                        &lt;CodiceOrdineRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:CodiceOrdineRichiedente&quot;/>&#xa;                        &lt;/CodiceOrdineRichiedente>&#xa;                        &lt;DataNotifica>&#xa;                            &lt;xsl:value-of s