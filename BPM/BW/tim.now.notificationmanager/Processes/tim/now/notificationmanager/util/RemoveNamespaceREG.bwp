                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;SLURenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;NotificaSLU>&#xa;            &lt;TestataNotifica>&#xa;                &lt;CodiceFornitore>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:CodiceFornitore&quot;/>&#xa;                &lt;/CodiceFornitore>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;>&#xa;                    &lt;CodiceOrdineFornitore>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;/>&#xa;                    &lt;/CodiceOrdineFornitore>&#xa;                &lt;/xsl:if>&#xa;                &lt;CodiceOrdineRichiedente>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:CodiceOrdineRichiedente&quot;/>&#xa;                &lt;/CodiceOrdineRichiedente>&#xa;                &lt;DataNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:DataNotifica&quot;/>&#xa;                &lt;/DataNotifica>&#xa;                &lt;StatoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:StatoOrdine&quot;/>&#xa;                &lt;/StatoOrdine>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:DataDRO&quot;>&#xa;                    &lt;DataDRO>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:TestataNotifica/tns:DataDRO&quot;/>&#xa;                    &lt;/DataDRO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/TestataNotifica>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Acquisizione)&quot;>&#xa;                    &lt;Acquisizione>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Acquisizione/tns:Note&quot;>&#xa;                            &lt;Note>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Acquisizione/tns:Note&quot;/>&#xa;                            &lt;/Note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Acquisizione/tns:Rifiuto)&quot;>&#xa;                                &lt;Rifiuto>&#xa;                                    &lt;TipoCausaleRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Acquisizione/tns:Rifiuto/tns:TipoCausaleRifiuto&quot;/>&#xa;                                    &lt;/TipoCausaleRifiuto>&#xa;                                    &lt;CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Acquisizione/tns:Rifiuto/tns:CodiceMotivoRifiuto&quot;/>&#xa;                                    &lt;/CodiceMotivoRifiuto>&#xa;                                    &lt;MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Acquisizione/tns:Rifiuto/tns:MotivoRifiuto&quot;/>&#xa;                                    &lt;/MotivoRifiuto>&#xa;                                &lt;/Rifiuto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Acquisizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione)&quot;>&#xa;                    &lt;Accettazione>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:IdRisorsa&quot;>&#xa;                            &lt;IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:IdRisorsa&quot;/>&#xa;                            &lt;/IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DataValidazioneFormaleContrattuale>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:DataValidazioneFormaleContrattuale&quot;/>&#xa;                        &lt;/DataValidazioneFormaleContrattuale>&#xa;                        &lt;DataValidazioneTecnicoGestionale>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:DataValidazioneTecnicoGestionale&quot;/>&#xa;                        &lt;/DataValidazioneTecnicoGestionale>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Note&quot;>&#xa;                            &lt;Note>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Note&quot;/>&#xa;                            &lt;/Note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Rifiuto)&quot;>&#xa;                                &lt;Rifiuto>&#xa;                                    &lt;TipoCausaleRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Rifiuto/tns:TipoCausaleRifiuto&quot;/>&#xa;                                    &lt;/TipoCausaleRifiuto>&#xa;                                    &lt;CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Rifiuto/tns:CodiceMotivoRifiuto&quot;/>&#xa;                                    &lt;/CodiceMotivoRifiuto>&#xa;                                    &lt;MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Rifiuto/tns:MotivoRifiuto&quot;/>&#xa;                                    &lt;/MotivoRifiuto>&#xa;                                &lt;/Rifiuto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente)&quot;>&#xa;                            &lt;Referente>&#xa;                                &lt;QualificaRef>&#xa;                                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:QualificaRef&quot;/>&#xa;                                &lt;/QualificaRef>&#xa;                                &lt;CognomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:CognomeReferente&quot;/>&#xa;                                &lt;/CognomeReferente>&#xa;                                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:NomeReferente&quot;>&#xa;                                    &lt;NomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:NomeReferente&quot;/>&#xa;                                    &lt;/NomeReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:TelefonoFissoReferente&quot;>&#xa;                                    &lt;TelefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:TelefonoFissoReferente&quot;/>&#xa;                                    &lt;/TelefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:TelefonoMobileReferente&quot;>&#xa;                                    &lt;TelefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:TelefonoMobileReferente&quot;/>&#xa;                                    &lt;/TelefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:Progressivo&quot;>&#xa;                                    &lt;Progressivo>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:Referente/tns:Progressivo&quot;/>&#xa;                                    &lt;/Progressivo>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/Referente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:BitRate&quot;>&#xa;                            &lt;BitRate>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:BitRate&quot;/>&#xa;                            &lt;/BitRate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:NumerazioneAggiuntiva&quot;>&#xa;                            &lt;NumerazioneAggiuntiva>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/NumerazioneAggiuntiva>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:NuovoIdRisorsa&quot;>&#xa;                            &lt;NuovoIdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Accettazione/tns:NuovoIdRisorsa&quot;/>&#xa;                            &lt;/NuovoIdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Accettazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento)&quot;>&#xa;                    &lt;Espletamento>&#xa;                        &lt;IdRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:IdRisorsa&quot;/>&#xa;                        &lt;/IdRisorsa>&#xa;                        &lt;DataValidazioneFormaleContrattuale>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:DataValidazioneFormaleContrattuale&quot;/>&#xa;                        &lt;/DataValidazioneFormaleContrattuale>&#xa;                        &lt;DataValidazioneTecnicoGestionale>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:DataValidazioneTecnicoGestionale&quot;/>&#xa;                        &lt;/DataValidazioneTecnicoGestionale>&#xa;                        &lt;DataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:DataEspletamento&quot;/>&#xa;                        &lt;/DataEspletamento>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:OrarioDataEspletamento&quot;>&#xa;                            &lt;OrarioDataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:OrarioDataEspletamento&quot;/>&#xa;                            &lt;/OrarioDataEspletamento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:Note&quot;>&#xa;                            &lt;Note>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:Note&quot;/>&#xa;                            &lt;/Note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:Rifiuto)&quot;>&#xa;                                &lt;Rifiuto>&#xa;                                    &lt;TipoCausaleRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:Rifiuto/tns:TipoCausaleRifiuto&quot;/>&#xa;                                    &lt;/TipoCausaleRifiuto>&#xa;                                    &lt;CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:Rifiuto/tns:CodiceMotivoRifiuto&quot;/>&#xa;                                    &lt;/CodiceMotivoRifiuto>&#xa;                                    &lt;MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:Rifiuto/tns:MotivoRifiuto&quot;/>&#xa;                                    &lt;/MotivoRifiuto>&#xa;                                &lt;/Rifiuto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:for-each select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:NumerazioneAggiuntiva&quot;>&#xa;                            &lt;NumerazioneAggiuntiva>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/NumerazioneAggiuntiva>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:NuovoIdRisorsa&quot;>&#xa;                            &lt;NuovoIdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:NuovoIdRisorsa&quot;/>&#xa;                            &lt;/NuovoIdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns:Espletamento/tns:IdArlTI&quot;>&#xa;                            &lt;IdArlTI>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaSLU[1]/tns