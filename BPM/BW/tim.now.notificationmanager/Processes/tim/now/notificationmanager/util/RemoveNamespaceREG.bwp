                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;WLRRenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;NotificaWLR>&#xa;            &lt;TestataNotifica>&#xa;                &lt;CodiceFornitore>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:CodiceFornitore&quot;/>&#xa;                &lt;/CodiceFornitore>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;>&#xa;                    &lt;CodiceOrdineFornitore>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;/>&#xa;                    &lt;/CodiceOrdineFornitore>&#xa;                &lt;/xsl:if>&#xa;                &lt;CodiceOrdineRichiedente>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:CodiceOrdineRichiedente&quot;/>&#xa;                &lt;/CodiceOrdineRichiedente>&#xa;                &lt;DataNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:DataNotifica&quot;/>&#xa;                &lt;/DataNotifica>&#xa;                &lt;StatoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:StatoOrdine&quot;/>&#xa;                &lt;/StatoOrdine>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:DataDRO&quot;>&#xa;                    &lt;DataDRO>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:TestataNotifica/tns:DataDRO&quot;/>&#xa;                    &lt;/DataDRO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/TestataNotifica>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione)&quot;>&#xa;                    &lt;Acquisizione>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:FlagLineaBtsNaked&quot;>&#xa;                            &lt;FlagLineaBtsNaked>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:FlagLineaBtsNaked&quot;/>&#xa;                            &lt;/FlagLineaBtsNaked>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:Note&quot;>&#xa;                            &lt;Note>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:Note&quot;/>&#xa;                            &lt;/Note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:Rifiuto)&quot;>&#xa;                                &lt;Rifiuto>&#xa;                                    &lt;TipoCausaleRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:Rifiuto/tns:TipoCausaleRifiuto&quot;/>&#xa;                                    &lt;/TipoCausaleRifiuto>&#xa;                                    &lt;CodiceMotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:Rifiuto/tns:CodiceMotivoRifiuto&quot;/>&#xa;                                    &lt;/CodiceMotivoRifiuto>&#xa;                                    &lt;MotivoRifiuto>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:Rifiuto/tns:MotivoRifiuto&quot;/>&#xa;                                    &lt;/MotivoRifiuto>&#xa;                                &lt;/Rifiuto>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:BorchiaISDN&quot;>&#xa;                            &lt;BorchiaISDN>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Acquisizione/tns:BorchiaISDN&quot;/>&#xa;                            &lt;/BorchiaISDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Acquisizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Accettazione)&quot;>&#xa;                    &lt;Accettazione>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Accettazione/tns:DN&quot;>&#xa;                            &lt;DN>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Accettazione/tns:DN&quot;/>&#xa;                            &lt;/DN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Accettazione/tns:FlagLineaBtsNaked&quot;>&#xa;                            &lt;FlagLineaBtsNaked>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaWLR[1]/tns:Accett