                                    expression="exists($RemoveNamespaceIn/Input/tns2:NotificaOloRegolatorio/tns2:NotificaULL/tns2:TentativiContatto)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
