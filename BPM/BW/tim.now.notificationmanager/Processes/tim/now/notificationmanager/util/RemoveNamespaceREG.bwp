ot;/>&#xa;                                &lt;/MotivoRifiuto>&#xa;                            &lt;/Rifiuto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DataValidazioneFormaleContrattuale>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:DataValidazioneFormaleContrattuale&quot;/>&#xa;                        &lt;/DataValidazioneFormaleContrattuale>&#xa;                        &lt;DataDRO>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:DataDRO&quot;/>&#xa;                        &lt;/DataDRO>&#xa;                        &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:A375&quot;>&#xa;                            &lt;A375>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoVerifiche/tns:A375&quot;/>&#xa;                            &lt;/A375>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/EsitoVerifiche>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoValidazione)&quot;>&#xa;                    &lt;EsitoValidazione>&#xa;                        &lt;CodiceFornitore>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoValidazione/tns:CodiceFornitore&quot;/>&#xa;                        &lt;/CodiceFornitore>&#xa;                        &lt;CodiceOrdineFornitore>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaCPS[1]/tns:EsitoValidazione/tns:CodiceOrdineFornitore&quot;/>&#xa;                        &lt;/CodiceOrdineFornitore>&#xa;                        &lt;CodiceRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input