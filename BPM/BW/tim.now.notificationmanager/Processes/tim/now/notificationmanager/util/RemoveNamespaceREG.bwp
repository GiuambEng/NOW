                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://xsd.telecomitalia.it/crm/xdsl/regolatorio&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/regolatorio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;TRASFORMAZIONESLURenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;NotificaTrasformazioneSLU>&#xa;            &lt;TestataNotifica>&#xa;                &lt;CodiceFornitore>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:TestataNotifica/tns:CodiceFornitore&quot;/>&#xa;                &lt;/CodiceFornitore>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;>&#xa;                    &lt;CodiceOrdineFornitore>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:TestataNotifica/tns:CodiceOrdineFornitore&quot;/>&#xa;                    &lt;/CodiceOrdineFornitore>&#xa;                &lt;/xsl:if>&#xa;                &lt;DataNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:TestataNotifica/tns:DataNotifica&quot;/>&#xa;                &lt;/DataNotifica>&#xa;                &lt;StatoOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:TestataNotifica/tns:StatoOrdine&quot;/>&#xa;                &lt;/StatoOrdine>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:TestataNotifica/tns:DataDRO&quot;>&#xa;                    &lt;DataDRO>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:TestataNotifica/tns:DataDRO&quot;/>&#xa;                    &lt;/DataDRO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/TestataNotifica>&#xa;            &lt;CessSLU-NPperSLU>&#xa;                &lt;IdRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:CessSLU-NPperSLU/tns:IdRisorsa&quot;/>&#xa;                &lt;/IdRisorsa>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:CessSLU-NPperSLU/tns:DataValidazioneFormaleContrattuale&quot;>&#xa;                    &lt;DataValidazioneFormaleContrattuale>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:CessSLU-NPperSLU/tns:DataValidazioneFormaleContrattuale&quot;/>&#xa;                    &lt;/DataValidazioneFormaleContrattuale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:CessSLU-NPperSLU/tns:DataValidazioneTecnicoGestionale&quot;>&#xa;                    &lt;DataValidazioneTecnicoGestionale>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:CessSLU-NPperSLU/tns:DataValidazioneTecnicoGestionale&quot;/>&#xa;                    &lt;/DataValidazioneTecnicoGestionale>&#xa;                &lt;/xsl:if>&#xa;                &lt;DataEspletamento>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:CessSLU-NPperSLU/tns:DataEspletamento&quot;/>&#xa;                &lt;/DataEspletamento>&#xa;                &lt;xsl:if test=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasformazioneSLU[1]/tns:CessSLU-NPperSLU/tns:Note&quot;>&#xa;                    &lt;Note>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceIn.Input/tns:NotificaTrasforma