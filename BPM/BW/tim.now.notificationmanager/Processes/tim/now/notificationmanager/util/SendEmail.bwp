Char>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns1:RichiestaGenerica/tns1:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ISP) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;$SendEmailOperationIn.SendEmailInput/tns1:RichiestaGenerica/tns1:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ISP&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns1:RichiestaGenerica/tns1:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ORDINE_ISP) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$SendEmailOperationIn.SendEmailInput/tns1:RichiestaGenerica/tns1:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ORDINE_ISP&quot;>&#xa;                                        &lt;tns:NewChar>&#xa;                                            &lt;xsl:value-of select=&quot;$SendEmailOperationIn.SendEmailInput/tns1:RichiestaGenerica/tns1:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ORDINE_ISP&quot;/>&#xa;                                        &lt;/tns:NewChar>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;             