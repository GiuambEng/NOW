                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendEmailOperationIn.SendEmailInput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&#xa;    &lt;xsl:template name=&quot;TemplateReplaceStringProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                &lt;tns:InputString>&#xa;                    &lt;tns:OldString>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                    &lt;/tns:OldString>&#xa;                    &lt;tns:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SOCIALE_OLO$&amp;quot;&quot;/>&#xa;                    &lt;/tns:OldChar>&#xa;                    &lt;tns:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_RICEZIONE_ORDINE$&amp;quot;&quot;/>&#xa;                    &lt;/tns:OldChar>&#xa;                    &lt;tns:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$CODICE_ORDINE_OLO$&amp;quot;&quot;/>&#xa;                    &lt;/tns:OldChar>&#xa;                    &lt;tns:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_DAC_OLD$&amp;quot;&quot;/>&#xa;                    &lt;/tns:OldChar>&#xa;                    &lt;tns:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_DAC_NEW$&amp;quot;&quot;/>&#xa;                    &lt;/tns:OldChar>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/ordine/cognomeRagioneSociale) > 0&quot;>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;$SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                &lt;tns:NewChar>&#xa;                                    &lt;xsl:value-of select=&quot;$SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                &lt;/tns:NewChar>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date($SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:InputString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot; or ($SendEmailOperationIn.SendEmailInput/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; and $SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;)&quot;>&#xa;                        &lt;tns:InputString>&#xa;                            &lt;tns:OldString>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                            &lt;/tns:OldString>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROT_CODICE_ISP$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROT_CODICE_ORDINE_ISP$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$CODICE_PROGETTO$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$NOME_LINEA$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Cognome_Linea$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Distretto_Linea$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Numero_Linea$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Linea$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Codice_Ordine_CRM$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Richiesta$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Ordine$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Servizio$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Data_Notifica$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Codice_Causale_Errore$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Descrizione_errore$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Note$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Numero_UserVlan$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$TAGGING_ACCESSO$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROFILO$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROFILO_UP$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROFILO_DOWN$&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TIPO_RECORD !900000001!: B&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TIPO_RECORD !900000001!: D&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Stato !900000015!: AQ&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;tns:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Stato !900000015!: AK&amp;quot;&quot;/>&#xa;                            &lt;/tns:OldChar>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ISP) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ISP, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ORDINE_ISP) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_ORDINE_ISP, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_PROGETTO) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:CODICE_PROGETTO, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:NOME) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:NOME, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:COGNOME) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:COGNOME, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:DISTRETTO) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:DISTRETTO, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:NUMERO) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:NUMERO, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;    