&lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:VCI_RETE) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:VCI_RETE, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:DLCI_CLIENTE) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:DLCI_CLIENTE, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:CODE_VP) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:CODE_VP, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:KIT_CONSEGNA) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VC/ns01:VC[5]/ns01:KIT_CONSEGNA, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:PRESENZA_RILANCIO) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:PRESENZA_RILANCIO, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:MODEM_SEDE_CLIENTE) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:MODEM_SEDE_CLIENTE, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:NUMERO_COPPIE_RAME) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:NUMERO_COPPIE_RAME, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:ATTRIBUTO_MODEM_SEDE_CLIENTE) > 0&quot;>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($SendEmailOperationIn.SendEmailInput/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_ACCESSO/ns01:ATTRIBUTO_MODEM_SEDE_CLIENTE, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Tipo_Record !900000001!: B&amp;lt;br/>&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                            &lt;tns:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Tipo_Record !900000001!: D&amp;lt;br/>&amp;quot;&quot;/>&#xa;                            &lt;/tns:NewChar>&#xa;                        &lt;/tns:InputString>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.ReplaceMoreString" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperResponse-input"
                    name="MapperResponse"
                    outputVariable="MapperResponse"
                    tibex:xpdlId="53995df7-ad87-416f-a8c3-283135a68710" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_EmailInviataToMapperResponse"/>
                        <bpws:target linkName="LOG_EmailNonInviataToMapperResponse"/>
                        <bpws:target linkName="LOG_TemplateToMapperResponse"/>
                        <bpws:target linkName="LOG_EmailToMapperResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToSendEmailOperationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TemplateReplaceStringProcess&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;MapperResponse-input&quot; match=&quot;/&quot;>&lt;tns:EmailResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_OLO_ABILITATO_EMAIL/Record) = false() or string-length($JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL) = 0&quot;>&lt;tns:Response>&lt;tns:ContenutoEmail>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE - OLO non abilitato a ricevere email.&amp;quot;&quot;/>&lt;/tns:ContenutoEmail>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:DataNotifica>&lt;/tns:Response>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($JDBC_EMAIL_TEMPLATE/Record) = false()&quot;>&lt;tns:Response>&lt;tns:ContenutoEmail>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE - Nessun template presente per l'email da inviare.&amp;quot;&quot;/>&lt;/tns:ContenutoEmail>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:DataNotifica>&lt;/tns:Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Response>&lt;tns:ContenutoEmail>&lt;xsl:value-of select=&quot;$TemplateReplaceStringProcess/tns1:NewString&quot;/>&lt;/tns:ContenutoEmail>&lt;tns:DataNotifica>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:DataNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($_error/Msg) > 0&quot;>&lt;tns:StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE&amp;quot;&quot;/>&lt;/tns:StatoNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;INVIATA&amp;quot;&quot;/>&lt;/tns:StatoNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:EmailResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:GenericNotification="http://www.tim.com/NOW/xsd/GenericNotification"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="GenericNotification:EmailResponse" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;SendEmailOperationIn&quot;/>&lt;xsl:template name=&quot;LOG_Email-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SendEmail&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;SendEmailPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;SendEmailOperation&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$SendEmailOperationIn/SendEmailInput/tns1:EmailRequest/ns1:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_OLO_ABILITATO_EMAIL/Record) and string-length($JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Email dell'OLO: &amp;quot;, $JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL, &amp;quot; NOTIFICA : &amp;quot;, tib:render-xml($SendEmailOperationIn/SendEmailInput/tns1:EmailRequest, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;OLO non abilitato a ricevere email.&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Email-input" name="LOG_Email"
                    tibex:xpdlId="565e2be8-81cf-49e7-999d-6d49b391a9be"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_OLO_ABILITATO_EMAILToLOG_Email"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_EmailToMapperResponse">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_EmailToJDBC_EMAIL_TEMPLATE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBC_OLO_ABILITATO_EMAIL/Record) and string-length($JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($JDBC_OLO_ABILITATO_EMAIL/Record) and string-length($JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendEmailOperationIn.SendEmailInput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Email-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmail&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailOperation&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$SendEmailOperationIn.SendEmailInput/ns1:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_OLO_ABILITATO_EMAIL/Record) and string-length($JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL)>0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Email dell'OLO: &amp;quot;, $JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL, &amp;quot; NOTIFICA : &amp;quot;, tib:render-xml($SendEmailOperationIn.SendEmailInput, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OLO non abilitato a ricevere email.&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
