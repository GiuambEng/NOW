                        <bpws:source linkName="LOG_TemplateToMapperResponse">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_TemplateToReplaceMoreStringProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBC_EMAIL_TEMPLATE/Record) and ($SendEmailOperationIn/SendEmailInput/ns13:EmailRequest/ns14:RichiestaElement/strutturaRichiesta = &quot;REGOLATORIO&quot; or ($SendEmailOperationIn/SendEmailInput/ns13:EmailRequest/ns14:RichiestaElement/strutturaRichiesta != &quot;REGOLATORIO&quot; and $SendEmailOperationIn/SendEmailInput/ns13:EmailRequest/ns13:TipologiaNotifica != &quot;SC&quot; and $SendEmailOperationIn/SendEmailInput/ns13:EmailRequest/ns13:TipologiaNotifica != &quot;SP&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($JDBC_EMAIL_TEMPLATE/Record) and ($SendEmailOperationIn.SendEmailInput/ns14:RichiestaElement/strutturaRichiesta = "REGOLATORIO" or ($SendEmailOperationIn.SendEmailInput/ns14:RichiestaElement/strutturaRichiesta != "REGOLATORIO" and $SendEmailOperationIn.SendEmailInput/ns13:TipologiaNotifica != "SC" and $SendEmailOperationIn.SendEmailInput/ns13:TipologiaNotifica != "SP"))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_TemplateToCalcoloReferenteInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBC_EMAIL_TEMPLATE/Record) and $SendEmailOperationIn/SendEmailInput/ns13:EmailRequest/ns13:StrutturaRichiesta != &quot;REGOLATORIO&quot; and ($SendEmailOperationIn/SendEmailInput/ns13:EmailRequest/ns13:TipologiaNotifica = &quot;SC&quot; or $SendEmailOperationIn/SendEmailInput/ns13:EmailRequest/ns13:TipologiaNotifica = &quot;SP&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($JDBC_EMAIL_TEMPLATE/Record) and $SendEmailOperationIn.SendEmailInput/ns13:StrutturaRichiesta != "REGOLATORIO" and ($SendEmailOperationIn.SendEmailInput/ns13:TipologiaNotifica = "SC" or $SendEmailOperationIn.SendEmailInput/ns13:TipologiaNotifica = "SP")]]></bpws:transitionCondition>
                        </bpws:source>
