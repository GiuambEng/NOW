                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3eb0dcc3-8751-4988-92e1-6f75dbf4edc9+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendEmailOperationIn&quot;/>&lt;xsl:template name=&quot;JDBC_OLO_ABILITATO_EMAIL-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:CodificaOLOAGCOMDestinatario&quot;/>&lt;/CodiceOLOAGCOM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_OLO_ABILITATO_EMAIL-input"
                    name="JDBC_OLO_ABILITATO_EMAIL"
                    outputVariable="JDBC_OLO_ABILITATO_EMAIL"
                    tibex:xpdlId="3eb0dcc3-8751-4988-92e1-6f75dbf4edc9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBC_OLO_ABILITATO_EMAIL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_OLO_ABILITATO_EMAILToLOG_Email"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3eb0dcc3-8751-4988-92e1-6f75dbf4edc9+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendEmailOperationIn.SendEmailInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_OLO_ABILITATO_EMAIL-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$SendEmailOperationIn.SendEmailInput/tns2:CodificaOLOAGCOMDestinatario&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RFCT.EMAIL&#xa;  FROM CONTATTO CT, CONTATTO_OLO CTOLO, RIF_CONTATTO RFCT&#xa;  WHERE RFCT.ID_CONTATTO = CT.ID_CONTATTO AND CT.ID_CONTATTO = CTOLO.ID_CONTATTO&#xa;  &#x9;AND CT.FLAG_PRIMARIO = 'Y' AND CTOLO.CODFC_OLO_AGCOM = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAGCOM"/>
                                    <columnMetadata
                                    columnName="EMAIL"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ddc85bf7-6368-4b35-b01b-7d6d4b16323c+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendEmailOperationIn&quot;/>&lt;xsl:template name=&quot;JDBC_EMAIL_TEMPLATE-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:TipologiaNotifica = &amp;quot;RR&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;&quot;>&lt;TipologiaNotifica>&lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AK&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&lt;/TipologiaNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TipologiaNotifica>&lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AQ&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&lt;/TipologiaNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; and $SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;&quot;>&lt;TipologiaNotifica>&lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AK&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&lt;/TipologiaNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TipologiaNotifica>&lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, $SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:TipologiaNotifica, &amp;quot;%&amp;quot;)&quot;/>&lt;/TipologiaNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;Offerta>&lt;xsl:value-of select=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:Offerta&quot;/>&lt;/Offerta>&lt;Provenienza>&lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&lt;/Provenienza>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_EMAIL_TEMPLATE-input"
                    name="JDBC_EMAIL_TEMPLATE"
                    outputVariable="JDBC_EMAIL_TEMPLATE"
                    tibex:xpdlId="ddc85bf7-6368-4b35-b01b-7d6d4b16323c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_EmailToJDBC_EMAIL_TEMPLATE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_EMAIL_TEMPLATEToLOG_Template"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ddc85bf7-6368-4b35-b01b-7d6d4b16323c+input&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendEmailOperationIn.SendEmailInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_EMAIL_TEMPLATE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:TipologiaNotifica = &amp;quot;RR&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;&quot;>&#xa;                            &lt;TipologiaNotifica>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AK&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&#xa;                            &lt;/TipologiaNotifica>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TipologiaNotifica>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AQ&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&#xa;                            &lt;/TipologiaNotifica>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; and $SendEmailOperationIn.SendEmailInput/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;&quot;>&#xa;                    &lt;TipologiaNotifica>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AK&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&#xa;                    &lt;/TipologiaNotifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TipologiaNotifica>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, $SendEmailOperationIn.SendEmailInput/tns2:TipologiaNotifica, &amp;quot;%&amp;quot;)&quot;/>&#xa;                    &lt;/TipologiaNotifica>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;Offerta>&#xa;                &lt;xsl:value-of select=&quot;$SendEmailOperationIn.SendEmailInput/tns2:Offerta&quot;/>&#xa;            &lt;/Offerta>&#xa;            &lt;Provenienza>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/Provenienza>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TMP.TEMPLATE_EMAIL, TMP.OGGETTO, TMP.ID_EMAIL_TEMPLATE&#xa;  FROM APPUSER.EMAIL_TEMPLATE TMP, APPUSER.OFFERTA OFF,&#xa;       APPUSER.TRASCODFC_OFFERTA TRASOFF&#xa;  WHERE TMP.ID_FAMIG_OFFERTA = OFF.ID_FAMIG_OFFERTA AND TMP.COD_TIPOLG_NOTF LIKE ?&#xa;    AND OFF.ID_OFFERTA = TRASOFF.ID_OFFERTA AND TRASOFF.NOME_OFFERTA_ESTERNA = ?&#xa;    AND TRASOFF.PROVENIENZA = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TipologiaNotifica"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Offerta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Provenienza"/>
                                    <columnMetadata
                                    columnName="TEMPLATE_EMAIL"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="OGGETTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_EMAIL_TEMPLATE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sendmail/xsd/input+2c09f860-829b-4384-8dc2-6036b7e67bb9+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&lt;xsl:param name=&quot;smtpPropertyFrom&quot;/>&lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&lt;xsl:param name=&quot;TemplateReplaceStringProcess&quot;/>&lt;xsl:param name=&quot;DestinatarioEmailCC&quot;/>&lt;xsl:param name=&quot;OggettoReplaceStringProcess&quot;/>&lt;xsl:param name=&quot;SendEmailOperationIn&quot;/>&lt;xsl:param name=&quot;CalceEmail&quot;/>&lt;xsl:param name=&quot;CalceEmailDati&quot;/>&lt;xsl:template name=&quot;SendMail-input&quot; match=&quot;/&quot;>&lt;tns:mailActivityInput>&lt;from>&lt;xsl:value-of select=&quot;$smtpPropertyFrom&quot;/>&lt;/from>&lt;xsl:if test=&quot;$JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL&quot;>&lt;to>&lt;xsl:value-of select=&quot;$JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL&quot;/>&lt;/to>&lt;/xsl:if>&lt;cc>&lt;xsl:value-of select=&quot;$DestinatarioEmailCC&quot;/>&lt;/cc>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;xsl:if test=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;>&lt;subject>&lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;/>&lt;/subject>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&lt;subject>&lt;xsl:value-of select=&quot;$OggettoReplaceStringProcess/tns1:NewString&quot;/>&lt;/subject>&lt;/xsl:when>&lt;xsl:otherwise>&lt;subject>&lt;xsl:value-of select=&quot;$OggettoReplaceStringProcess/tns1:NewString&quot;/>&lt;/subject>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;bodyElement>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns1:NewString, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, $CalceEmail)&quot;/>&lt;/bodyText>&lt;/xsl:when>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns1:NewString, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, $CalceEmailDati)&quot;/>&lt;/bodyText>&lt;/xsl:when>&lt;xsl:otherwise>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns1:NewString, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, $CalceEmailDati)&quot;/>&lt;/bodyText>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/bodyElement>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&lt;Headers>&lt;Content-Type>&lt;xsl:value-of select=&quot;&amp;quot;text/html&amp;quot;&quot;/>&lt;/Content-Type>&lt;/Headers>&lt;/xsl:when>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;XDSL&amp;quot;&quot;>&lt;Headers>&lt;Content-Type>&lt;xsl:value-of select=&quot;&amp;quot;text/html&amp;quot;&quot;/>&lt;/Content-Type>&lt;/Headers>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Headers/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:mailActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SendMail-input" name="SendMail"
                    tibex:xpdlId="2c09f860-829b-4384-8dc2-6036b7e67bb9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToSendMail"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SendMailToLOG_EmailInviata"/>
                        <bpws:source
                            linkName="SendMailToLOG_EmailNonInviata"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://tns.tibco.com/bw/activity/sendmail/xsd/input+2c09f860-829b-4384-8dc2-6036b7e67bb9+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendEmailOperationIn.SendEmailInput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&#xa;    &lt;xsl:param name=&quot;smtpPropertyFrom&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&#xa;    &lt;xsl:param name=&quot;TemplateReplaceStringProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;DestinatarioEmailCC&quot;/>&#xa;    &lt;xsl:param name=&quot;OggettoReplaceStringProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;CalceEmail&quot;/>&#xa;    &lt;xsl:param name=&quot;CalceEmailDati&quot;/>&#xa;    &lt;xsl:template name=&quot;SendMail-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:mailActivityInput>&#xa;            &lt;from>&#xa;                &lt;xsl:value-of select=&quot;$smtpPropertyFrom&quot;/>&#xa;            &lt;/from>&#xa;            &lt;xsl:if test=&quot;$JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL&quot;>&#xa;                &lt;to>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL&quot;/>&#xa;                &lt;/to>&#xa;            &lt;/xsl:if>&#xa;            &lt;cc>&#xa;                &lt;xsl:value-of select=&quot;$DestinatarioEmailCC&quot;/>&#xa;            &lt;/cc>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;xsl:if test=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;>&#xa;                        &lt;subject>&#xa;                            &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;/>&#xa;                        &lt;/subject>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;subject>&#xa;                        &lt;xsl:value-of select=&quot;$OggettoReplaceStringProcess/tns1:NewString&quot;/>&#xa;                    &lt;/subject>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;subject>&#xa;                        &lt;xsl:value-of select=&quot;$OggettoReplaceStringProcess/tns1:NewString&quot;/>&#xa;                    &lt;/subject>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;bodyElement>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                        &lt;bodyText>&#xa;                            &lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns1:NewString, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, $CalceEmail)&quot;/>&#xa;                        &lt;/bodyText>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                        &lt;bodyText>&#xa;                            &lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns1:NewString, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, $CalceEmailDati)&quot;/>&#xa;                        &lt;/bodyText>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;bodyText>&#xa;                            &lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns1:NewString, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, $CalceEmailDati)&quot;/>&#xa;                        &lt;/bodyText>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/bodyElement>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;Headers>&#xa;                        &lt;Content-Type>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;text/html&amp;quot;&quot;/>&#xa;                        &lt;/Content-Type>&#xa;                    &lt;/Headers>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$SendEmailOperationIn.SendEmailInput/tns2:StrutturaRichiesta = &amp;quot;XDSL&amp;quot;&quot;>&#xa;                    &lt;Headers>&#xa;                        &lt;Content-Type>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;text/html&amp;quot;&quot;/>&#xa;                        &lt;/Content-Type>&#xa;                    &lt;/Headers>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Headers/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:mailActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.mail.send"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:input="http://tns.tibco.com/bw/activity/sendmail/xsd/input+2c09f860-829b-4384-8dc2-6036b7e67bb9+input"
                            xmlns:mail="http://ns.tibco.com/bw/palette/mail" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/mail#//SendMail"/>
                                    <value
                                    inputHeadersQName="input:headersType"
                                    newActivity="true"
                                    smtpProperty="smtpProperty" xsi:type="mail:SendMail"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SendEmailOperationIn&quot;/>&lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&lt;xsl:param name=&quot;CalcoloReferenteInvoke&quot;/>&lt;xsl:template name=&quot;TemplateReplaceStringProcess-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;tns:InputString>&lt;tns:OldString>&lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&lt;/tns:OldString>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SOCIALE_OLO$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$DATA_RICEZIONE_ORDINE$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$CODICE_ORDINE_OLO$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$DATA_DAC_OLD$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$DATA_DAC_NEW$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/ordine/cognomeRagioneSociale) > 0&quot;>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&lt;/tns:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(format-date($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;format-date($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&lt;xsl:if test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/codiceOrdineOLO&quot;>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/tns:NewChar>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(format-date($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0&quot;>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;format-date($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(format-date($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0&quot;>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;format-date($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:InputString>&lt;/xsl:when>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot; or ($SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; and $SendEmailOperationIn/SendEmailInput/tns2:EmailRequest/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;)&quot;>&lt;tns:InputString>&lt;tns:OldString>&lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&lt;/tns:OldString>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$PROT_CODICE_ISP$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$PROT_CODICE_ORDINE_ISP$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$CODICE_PROGETTO$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$NOME_LINEA$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Cognome_Linea$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Distretto_Linea$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Numero_Linea$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Linea$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Codice_Ordine_CRM$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Richiesta$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Ordine$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Servizio$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Data_Notifica$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Codice_Causale_Errore$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Descrizione_errore$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Note$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Numero_UserVlan$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$TAGGING_ACCESSO$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$PROFILO$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$PROFILO_UP$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$PROFILO_DOWN$&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;TIPO_RECORD !900000001!: B&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;TIPO_RECORD !900000001!: D&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;Stato !900000015!: AQ&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;Stato !900000015!: AK&amp;quot;&quot;/>&lt;/tns:OldChar>&lt