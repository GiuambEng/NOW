                                    sqlStatement="INSERT INTO EMAIL_NOTF (CONTENUTO_MAIL, DESTNRIO_EMAIL_A, DESTNRIO_EMAIL_CC, ID_EMAIL_TEMPLATE, ID_NOTF, IDTPLG_STNTF, OGGETTO, TIMSTP_INVIO)&#xa;  VALUES (?, ?, ?, ?, ?, (SELECT IDTPLG_STNTF FROM TIPOLG_STNTF WHERE STNTF = ?), ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CONTENUTO_MAIL"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESTNRIO_EMAIL_A"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESTNRIO_EMAIL_CC"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EMAIL_TEMPLATE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_NOTF"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDTPLG_STNTF"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OGGETTO"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="TIMSTP_INVIO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
