&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/CalcoloReferente/" xmlns:tns1="http://www.tim.com/NOW/xsd/NGA_XDSL_Util" version="2.0"&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:CalcoloReferenteFault&gt;&lt;fault&gt;&lt;tns1:ReferenteFault&gt;&lt;tns1:Codice&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:Codice&gt;&lt;tns1:Descrizione&gt;&lt;xsl:value-of select="&amp;quot;Notifica non creata correttamente - Incongruenza dati referente tra DTU e ORDINE NOW.&amp;quot;"/&gt;&lt;/tns1:Descrizione&gt;&lt;/tns1:ReferenteFault&gt;&lt;/fault&gt;&lt;/tns:CalcoloReferenteFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
