                tibex:xpdlId="a2b5b530-0eb4-452d-a4c1-eb949ee54e0b" variable="CalcoloReferenteOutput-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/CalcoloReferente/" xmlns:tns1="http://www.tim.com/NOW/xsd/NGA_XDSL_Util" version="2.0"&gt;&lt;xsl:param name="Referente"/&gt;&lt;xsl:param name="JDBC_DATI_REFERENTE"/&gt;&lt;xsl:template name="CalcoloReferenteOutput-input" match="/"&gt;&lt;tns:CalcoloReferenteResponse&gt;&lt;output&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($JDBC_DATI_REFERENTE/Record)"&gt;&lt;xsl:copy-of select="$Referente"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:Referente&gt;&lt;tns1:PresenzaReferente&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns1:PresenzaReferente&gt;&lt;/tns1:Referente&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/output&gt;&lt;/tns:CalcoloReferenteResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/CalcoloReferente/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DATI_REFERENTE&quot;/>&#xa;    &lt;xsl:template name=&quot;CalcoloReferenteOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($JDBC_DATI_REFERENTE/Record)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$Referente&quot;/>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Referente>&#xa;                    &lt;tns1:PresenzaReferente>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:PresenzaReferente>&#xa;                &lt;/tns1:Referente>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
