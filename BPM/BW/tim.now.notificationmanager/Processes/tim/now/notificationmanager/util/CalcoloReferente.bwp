            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+53fee7ba-7cae-4c87-801c-c199cee57ad0+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CalcoloReferenteInput&quot;/>&lt;xsl:template name=&quot;JDBC_DATI_REFERENTE-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:value-of select=&quot;$CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDRichiestaOLO&quot;/>&lt;/ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDEventoOrdineNOW)) > 0&quot;>&lt;ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDEventoOrdineNOW)&quot;>&lt;xsl:value-of select=&quot;$CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDEventoOrdineNOW&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_EVENTO_ORDN_NOW_WHLS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_EVENTO_ORDN_NOW_WHLS xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDRichiestaOLOEvento) > 0&quot;>&lt;ID_RICH_OLO_EVENTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDRichiestaOLOEvento)&quot;>&lt;xsl:value-of select=&quot;$CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDRichiestaOLOEvento&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO_EVENTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RICH_OLO_EVENTO xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_DATI_REFERENTE-input"
                    name="JDBC_DATI_REFERENTE"
                    outputVariable="JDBC_DATI_REFERENTE"
                    tibex:xpdlId="53fee7ba-7cae-4c87-801c-c199cee57ad0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBC_DATI_REFERENTE"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_DATI_REFERENTEToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+53fee7ba-7cae-4c87-801c-c199cee57ad0+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInput.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_DATI_REFERENTE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$CalcoloReferenteInput.input/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($CalcoloReferenteInput.input/tns1:IDEventoOrdineNOW)) > 0&quot;>&#xa;                    &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CalcoloReferenteInput.input/tns1:IDEventoOrdineNOW)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CalcoloReferenteInput.input/tns1:IDEventoOrdineNOW&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_EVENTO_ORDN_NOW_WHLS xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CalcoloReferenteInput.input/tns1:IDRichiestaOLOEvento) > 0&quot;>&#xa;                    &lt;ID_RICH_OLO_EVENTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CalcoloReferenteInput.input/tns1:IDRichiestaOLOEvento)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CalcoloReferenteInput.input/tns1:IDRichiestaOLOEvento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RICH_OLO_EVENTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RICH_OLO_EVENTO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PROGRS_REFTE, TELF_FISSO_REFTE, TELF_MOBL_REFTE, DATA_TELEFONATA, ORA_TELEFONATA&#xa;FROM CONTATTO_REFTE_DTU&#xa;WHERE ID_RICH_OLO = ? AND (ID_EVENTO_ORDN_NOW_WHLS = ? OR ID_EVENTO_ORDN_NOW_WHLS = (SELECT MAX(ID_EVENTO_ORDN_NOW_WHLS) &#xa;FROM CONTATTO_REFTE_DTU WHERE ID_RICH_OLO = ?))" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO_EVENTO"/>
                                    <columnMetadata
                                    columnName="PROGRS_REFTE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TELF_FISSO_REFTE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TELF_MOBL_REFTE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_TELEFONATA"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ORA_TELEFONATA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="0108a0b4-bae9-4b8d-9f7c-2ef375107d88">
                <bpws:targets>
                    <bpws:target linkName="JDBC_DATI_REFERENTEToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCalcoloReferenteOutput"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBC_DATI_REFERENTE/Record) and count($Referente/ns2:ReferenteRipetitivo) &lt; 4" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_DATI_REFERENTE/Record) and count($Referente/ns2:ReferenteRipetitivo) < 4]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="JDBCQueryToReferenteAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ReferenteAssignToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="cfacedcc-36cb-4e7a-8940-3194ae9048d4">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
