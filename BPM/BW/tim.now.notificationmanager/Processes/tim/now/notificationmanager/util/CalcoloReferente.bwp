                                    sqlStatement="SELECT PROGRESSIVOREFERENTE, COGNOMEREFERENTE, NOMEREFERENTE, TELEFONOFISSOREFERENTE, TELEFONOMOBILEREFERENTE&#xa;  FROM BDS_1_CASEDATA_REFERENTE&#xa;  WHERE IDRICHIESTAOLO = ? AND PROGRESSIVOREFERENTE = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

