&amp;quot;CalcoloReferente&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;CalcoloReferente_SUB-PROCESS&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;CalcoloReferente&amp;quot;,$CalcoloReferenteInput/input/tns1:ReferenteRequest/tns1:IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload/>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
