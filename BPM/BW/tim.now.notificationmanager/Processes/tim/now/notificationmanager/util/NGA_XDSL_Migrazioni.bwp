            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;NGA_XDSL_MigrazioniInput&quot;/>&lt;xsl:param name=&quot;JDBC_RICH_ORDN_COMUNIC_NOTF&quot;/>&lt;xsl:template name=&quot;LOG_JDBC_RICH_ORD_COMUNIC_NOTF-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NGA_XDSL_Migrazioni&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;NGA_XDSL_MigrazioniPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;NGA_XDSL_Migrazioni&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/tns1:MigrazioniRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBC_RICH_ORDN_COMUNIC_NOTF/Record)>0&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Esiste già una notifica generata per l'IDRichiestaOLO: &amp;quot;, tib:render-xml($JDBC_RICH_ORDN_COMUNIC_NOTF,true(),true()))&quot;/>&lt;/tns:MsgCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Non esiste alcuna notifica generata per l'IDRichiestaOLO: &amp;quot;, $NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/tns1:MigrazioniRequest/tns1:IDRichiestaOLO)&quot;/>&lt;/tns:MsgCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt