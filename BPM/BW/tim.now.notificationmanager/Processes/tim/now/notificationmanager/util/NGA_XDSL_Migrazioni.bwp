            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaOLODestinatario = &quot;RECIPIENT&quot;)&#xd;&#xa;then&#xd;&#xa;if(($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;AC&quot;) and exists($JDBC_RICH_ORDN_COMUNIC_NOTF/Record[COD_TIPOLG_NOTF = &quot;AQ&quot; and IDTPLG_DESTNRIO_NOTF = 1]))&#xd;&#xa;then &quot;6&quot;&#xd;&#xa;&#xd;&#xa;else if(($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;OK&quot; or $NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;KO&quot;) and exists($JDBC_RICH_ORDN_COMUNIC_NOTF/Record[COD_TIPOLG_NOTF = &quot;AC&quot; and IDTPLG_DESTNRIO_NOTF = 1]))&#xd;&#xa;then &quot;7&quot;&#xd;&#xa;&#xd;&#xa;else if(($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;KO&quot;) and exists($JDBC_RICH_ORDN_COMUNIC_NOTF/Record[COD_TIPOLG_NOTF = &quot;AQ&quot; and IDTPLG_DESTNRIO_NOTF = 1]))&#xd;&#xa;then &quot;6&quot;&#xd;&#xa;&#xd;&#xa;else if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;RD&quot;)&#xd;&#xa;then &quot;8&quot;&#xd;&#xa;else if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;KO&quot; and $NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:statoRichiestaOLO = &quot;ANNULLATO&quot;)&#xd;&#xa;then &quot;17&quot;&#xd;&#xa;else if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;AQ&quot; or $NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;KO&quot;)&#xd;&#xa;then &quot;5&quot;&#xd;&#xa;else &quot;0&quot;&#xd;&#xa;else if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaOLODestinatario = &quot;DONATING&quot;)&#xd;&#xa;then&#xd;&#xa;if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;CS&quot;)&#xd;&#xa;then &quot;10&quot;&#xd;&#xa;else if(($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;OK&quot; or $NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;KO&quot;) and exists($JDBC_RICH_ORDN_COMUNIC_NOTF/Record[COD_TIPOLG_NOTF = &quot;AC&quot; and IDTPLG_DESTNRIO_NOTF = 3]))&#xd;&#xa;then &quot;12&quot;&#xd;&#xa;else if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;AC&quot; or $NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;KO&quot;)&#xd;&#xa;then &quot;11&quot;&#xd;&#xa;else if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;RD&quot;)&#xd;&#xa;then &quot;13&quot;&#xd;&#xa;else if($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;AN&quot;)&#xd;&#xa;then &quot;18&quot;&#xd;&#xa;else &quot;0&quot;&#xd;&#xa;else &quot;0&quot;"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
