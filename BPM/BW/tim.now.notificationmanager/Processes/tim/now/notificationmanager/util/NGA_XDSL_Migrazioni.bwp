                <tibex:activityExtension
                    expression="if($TIPO_COMUNICAZIONE = &quot;8&quot; or $TIPO_COMUNICAZIONE = &quot;13&quot;) then &quot;&quot; else if($TIPO_COMUNICAZIONE = &quot;17&quot; or $TIPO_COMUNICAZIONE = &quot;18&quot; or ($NGA_XDSL_MigrazioniInput/MigrazioniRichiesta/ns7:MigrazioniRequest/ns7:TipologiaNotifica = &quot;KO&quot; and ($TIPO_COMUNICAZIONE = &quot;5&quot; or $TIPO_COMUNICAZIONE = &quot;6&quot; or $TIPO_COMUNICAZIONE = &quot;7&quot; or $TIPO_COMUNICAZIONE = &quot;11&quot; or $TIPO_COMUNICAZIONE = &quot;12&quot;))) then &quot;KO&quot; else &quot;OK&quot;"
