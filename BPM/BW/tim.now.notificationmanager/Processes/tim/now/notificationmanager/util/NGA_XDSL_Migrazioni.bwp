>&#xa;                            &lt;tns1:CAUSALE_RIFIUTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                            &lt;/tns1:CAUSALE_RIFIUTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$TIPO_COMUNICAZIONE = &amp;quot;6&amp;quot; or $TIPO_COMUNICAZIONE = &amp;quot;7&amp;quot; or $TIPO_COMUNICAZIONE = &amp;quot;17&amp;quot;&quot;>&#xa;                            &lt;tns1:CAUSALE_RIFIUTO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/tns1:CAUSALE_RIFIUTO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$DIRECTORY_NUMBER/tns1:DIRECTORY_NUMBER&quot;>&#xa;                &lt;tns1:DIRECTORY_NUMBER>&#xa;                    &lt;xsl:if test=&quot;tns1:DIRECTORY_NUMBER&quot;>&#xa;                        &lt;tns1:DIRECTORY_NUMBER>&#xa;                            &lt;xsl:value-of select=&quot;tns1:DIRECTORY_NUMBER&quot;/>&#xa;                        &lt;/tns1:DIRECTORY_NUMBER>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:DIRECTORY_NUMBER>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:MigrazioniResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
