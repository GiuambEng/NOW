                    name="JDBC_EMAIL_TEMPLATE"
                    outputVariable="JDBC_EMAIL_TEMPLATE"
                    tibex:xpdlId="4a57d16e-2150-4b81-a4c9-986be404769d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
