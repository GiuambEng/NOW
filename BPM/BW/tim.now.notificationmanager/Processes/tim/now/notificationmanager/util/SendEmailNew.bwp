            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CalcoloReferenteInvoke&quot;/>&lt;xsl:param name=&quot;JDBC_FILENAME&quot;/>&lt;xsl:param name=&quot;RagioneSociale&quot;/>&lt;xsl:param name=&quot;CODE_CAUSALE&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;TemplateReplaceStringProcess-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;PA&amp;quot;) and $Start/ns:RichiestaElement/strutturaRichiesta='FWA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot;&quot;>&lt;tns4:InputString>&lt;tns4:OldString>&lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&lt;/tns4:OldString>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SOCIALE_OLO$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$CODICE_ORDINE_OLO$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$TIMESTAMP_INSERIMENTO$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$DATA_ACCENSIONE$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$IDRISORSA$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;xsl:choose>&lt;xsl:when test=&quot;count($RagioneSociale/Record)>0&quot;>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;concat($RagioneSociale/Record[1]/RAGIONE_SOCIALE,'&amp;#xA;')&quot;/>&lt;/tns4:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;'&amp;#xA;'&quot;/>&lt;/tns4:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/tns4:NewChar>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns4:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;concat(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;),'&amp;#xA;')&quot;/>&lt;/tns4:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;'&amp;#x