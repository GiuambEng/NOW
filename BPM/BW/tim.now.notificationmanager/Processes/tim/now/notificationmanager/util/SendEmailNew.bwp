            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_TEST/ns0:QUALIFICA/ns0:MBR_UP) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_TEST/ns0:QUALIFICA/ns0:MBR_UP, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_TEST/ns0:QUALIFICA/ns0:CBR_DOWN) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_TEST/ns0:QUALIFICA/ns0:CBR_DOWN, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_TEST/ns0:QUALIFICA/ns0:CBR_UP) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_TEST/ns0:QUALIFICA/ns0:CBR_UP, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Tipo_Record !900000001!: B&amp;lt;br/>&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Tipo_Record !900000001!: D&amp;lt;br/>&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/tns4:InputString>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.ReplaceMoreString" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
