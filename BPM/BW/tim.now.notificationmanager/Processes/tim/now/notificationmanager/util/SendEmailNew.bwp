ERIMENTO $&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$ TIMESTAMP INSERIMENTO$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$TIMESTAMP INSERIMENTO $&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$TIMESTAMP INSERIMENTO$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA ACCENSIONE$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$IDRISORSA$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;DATIRICARICA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOTIPOLOGIARICARICA&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;DATIRICARICA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;IDENTIFICATIVOTIPOLOGIARICARICA&amp;quot;]/valoreAttributo&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;               