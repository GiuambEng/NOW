 &lt;xsl:value-of select=&quot;&amp;quot;Stato !900000015!: AQ&amp;lt;br/>&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Stato !900000015!: AK&amp;lt;br/>&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/tns4:InputString>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;TM&amp;quot;&quot;>&#xa;                        &lt;tns4:InputString>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$code_isp$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$descrizione_isp$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&