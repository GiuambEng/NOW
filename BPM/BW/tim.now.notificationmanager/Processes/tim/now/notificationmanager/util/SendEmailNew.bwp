ateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($Start/ns:RichiestaElement/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0 and string-length(format-time($Start/ns:RichiestaElement/ordine/ORA_DES, &amp;quot;[H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;concat(format-date($Start/ns:RichiestaElement/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;), &amp;quot; &amp;quot;, format-time($Start/ns:RichiestaElement/ordine/ORA_DES, &amp;quot;[H01]:[m01]:[s01]&amp;quot;))&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/IDRisorsa) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;>&#xa;                                &lt;tns4:NewChar>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                &lt;/tns4:NewChar>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns4:InputString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                &lt;tns4:InputString>&#xa;                    &lt;tns4:OldString>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                    &lt;/tns4:OldString>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SOCIALE_OLO$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_RICEZIONE_ORDINE$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$CODICE_ORDINE_OLO$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_DAC_OLD$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_DAC_NEW$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/cognomeRagioneSociale) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/ordine/cognomeRagioneSociale&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($Start/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date($Start/ns:RichiestaElement/DRO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                &lt;tns4:NewChar>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                &lt;/tns4:NewChar>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($Start/ns:RichiestaElement/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date($Start/ns:RichiestaElement/DAC, &amp;quot;[D01]/[M01]/[Y0