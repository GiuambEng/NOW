;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:BANDA_CoS_3) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:BANDA_CoS_3, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:BANDA_CoS_5) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:BANDA_CoS_5, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt