                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://tns.tibco.com/bw/activity/sendmail/xsd/input+effb6a25-d6ec-49ee-ac82-506a8160b255+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&lt;xsl:param name=&quot;smtpPropertyFrom&quot;/>&lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&lt;xsl:param name=&quot;TemplateReplaceStringProcess&quot;/>&lt;xsl:param name=&quot;DestinatarioEmailCC&quot;/>&lt;xsl:param name=&quot;OggettoReplaceStringProcess&quot;/>&lt;xsl:param name=&quot;CalceEmail&quot;/>&lt;xsl:param name=&quot;CalceEmailDati&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL_FWAEOLO&quot;/>&lt;xsl:template name=&quot;SendMail-input&quot; match=&quot;/&quot;>&lt;tns5:mailActivityInput>&lt;from>&lt;xsl:value-of select=&quot;$smtpPropertyFrom&quot;/>&lt;/from>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta='FWAITALIA1GIGASARDEGNA'&quot;>&lt;to>&lt;xsl:value-of select=&quot;tib:concat-sequence-format($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO/Record, &amp;quot;; &amp;quot;)&quot;/>&lt;/to>&lt;/xsl:when>&lt;xsl:otherwise>&lt;to>&lt;xsl:value-of select=&quot;tib:concat-sequence-format($JDBC_OLO_ABILITATO_EMAIL/Record, &amp;quot;; &amp;quot;)&quot;/>&lt;/to>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;cc>&lt;xsl:value-of select=&quot;$DestinatarioEmailCC&quot;/>&lt;/cc>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;ON&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OFF&amp;quot;&quot;>&lt;xsl:if test=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;>&lt;subject>&lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;/>&lt;/subject>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;subject>&lt;xsl:value-of select=&quot;$OggettoReplaceStringProcess/tns4:NewString&quot;/>&lt;/subject>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;bodyElement>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;ON&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OFF&amp;quot; or  $Start/ns:RichiestaElement/strutturaRichiesta='FWA'&quot;>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns4:NewString, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, $CalceEmail)&quot;/>&lt;/bodyText>&lt;/xsl:when>&lt;xsl:otherwise>&lt;bodyText>&lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns4:NewString, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, &amp;quot;&amp;lt;br/>&amp;quot;, $CalceEmailDati)&quot;/>&lt;/bodyText>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/bodyElement>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;ON&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OFF&amp;quot; or $Start/ns:RichiestaElement/strutturaRichiesta='FWA'&quot;>&lt;Headers/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Headers>&lt;Content-Type>&lt;xsl:value-of select=&quot;&amp;quot;text/html&amp;quot;&quot;/>&lt;/Content-Type>&lt;/Headers>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns5:mailActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.mail.send"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
