eEmailDati)&quot;/>&lt;/CONTENUTO_MAIL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Variable='False'&quot;>&lt;CONTENUTO_MAIL>&lt;xsl:value-of select=&quot;'Email non inviata per Tokenizzazione non riuscita'&quot;/>&lt;/CONTENUTO_MAIL>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;ON&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OFF&amp;quot;&quot;>&lt;CONTENUTO_MAIL>&lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns4:NewString, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, $CalceEmail)&quot;/>&lt;/CONTENUTO_MAIL>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CONTENUTO_MAIL>&lt;xsl:value-of select=&quot;concat($TemplateReplaceStringProcess/tns4:NewString, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;&amp;#xA;&amp;quot;, $CalceEmailDati)&quot;/>&lt;/CONTENUTO_MAIL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DESTNRIO_EMAIL_A>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(EMAIL)&quot;>&lt;xsl:value-of select=&quot;EMAIL&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESTNRIO_EMAIL_A>&lt;DESTNRIO_EMAIL_CC>&lt;xsl:value-of select=&quot;$DestinatarioEmailCC&quot;/>&lt;/DESTNRIO_EMAIL_CC>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&lt;ID_EMAIL_TEMPLATE>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_EMAIL_TEMPLATE)&quot;/>&lt;/ID_EMAIL_TEMPLATE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_EMAIL_TEMPLATE>&lt;xsl:value-of select=&quot;xsd:int($JDBC_EMAIL_TEMPLATE/Record[1]/ID_EMAIL_TEMPLATE)&quot;/>&lt;/ID_EMAIL_TEMPLATE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_NOTF>&lt;xsl:value-of select=&quot;$Start/tns2:IDNotifica&quot;/>&lt;/ID_NOTF>&lt;IDTPLG_STNTF>&lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&lt;/IDTP