ect=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                &lt;tns4:NewChar>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                &lt;/tns4:NewChar>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($Start/ns:RichiestaElement/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date($Start/ns:RichiestaElement/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(format-date($Start/ns:RichiestaElement/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)) > 0&quot;>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date($Start/ns:RichiestaElement/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns4:NewChar>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns4:InputString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot; and $Start/ns:RichiestaElement/offerta!='FWAITALIA1GIGASARDEGNA'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot;) and exists($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN)&quot;>&#xa;                        &lt;tns4:InputString>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Codice_OLO$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Codice_Ordine_OLO$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Data_Acquisizione$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Tipo_Ordine$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Servizio$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Area_Raccolta$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$CLLI_Centrale$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$MacroArea$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$ID_COMMERCIALE_VLAN$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$TipoVLAN$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$ID_VLAN_OLO$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$FamigliaVLAN$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Cos$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Stato$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Banda_COS_3$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Banda_COS_5$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$CAR$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$TD_KdC$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$Causale_Scarto$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$BMC_Light$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Tipo_Record !900000001!: B&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Tipo_Record !900000001!: B&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:CODICE_ISP) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:CODICE_ISP, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:CODICE_ORDINE_ISP) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:CODICE_ORDINE_ISP, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:DATA_NOTIFICA) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:DATA_NOTIFICA, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:TIPO_RICHIESTA) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:TIPO_RICHIESTA, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/offerta)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta='VLANNGA'&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat('NGA', &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat('VULA', &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='NOMEAREARACCOLTA']/valoreAttributo)>0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='NOMEAREARACCOLTA']/valoreAttributo, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:CLLI_Centrale) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:CLLI_Centrale, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:MacroArea) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_NGA/ns01:RICHIESTA/ns01:DATI_VLAN/ns01:MacroArea, &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                          