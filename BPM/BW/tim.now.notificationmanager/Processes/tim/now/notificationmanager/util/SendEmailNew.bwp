                     &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:PROTOCOLLO) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:PROTOCOLLO , &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:NUMERO_VC) > 0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/tns2:RichiestaGenerica/tns2:RICHIESTA_XDSL/ns0:RICHIESTA/ns0:DATI_ACCESSO/ns0:NUMERO_VC , &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:ot