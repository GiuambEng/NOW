            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="0d8a7f8e-0ab8-4d17-bdd3-3fa679554f5f">
                <bpws:targets>
                    <bpws:target linkName="GetLocalIPToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEmpty2"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="FaultName1"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns:FaultDetail"
                        name="FaultDetails" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:faultHandlers>
                    <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                        tibex:faultNameVar="FaultName1" tibex:xpdlId="205d9bd5-69ac-4581-afbe-1ee19f87fb4a">
                        <bpws:scope name="scope1">
                            <bpws:flow name="flow2">
                                <bpws:links>
                                    <bpws:link
                                    name="GenericLogger1ToAssign1" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="GenericLogger1-input"
                                    name="GenericLogger1"
                                    tibex:xpdlId="7fd1ec3c-58e1-4557-a2ce-8f928667c599"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLogger1ToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns7:Application>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmail&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailPortType&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailOperation&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;tns7:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns7:BusinessID>&#xa;                &lt;tns7:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName, $FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/MsgCode,$FaultDetails/Msg)&quot;/>&#xa;                &lt;/tns7:Message>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign1"
                                    outputVariable="Variable"
                                    tibex:xpdlId="387f4bd1-4bcd-4768-9d27-37ccda651467" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLogger1ToAssign1"/>
                                    </bpws:targets>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="'False'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:catchAll>
                </bpws:faultHandlers>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+29f9f796-df7e-4223-91c9-bb4411aa362e" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($CalcoloReferenteInvoke/output/tns:Referente/tns:ReferenteRipetitivo)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($CalcoloReferenteInvoke.output/tns:ReferenteRipetitivo)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="AssignToToken" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="TokenToMapper" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="AssignToMapper" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="MapperToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLoggerToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="TokenToThrow" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="5c1d0ae5-c39c-47f2-bae5-7854cafe8654">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="29f9f796-df7e-4223-91c9-bb4411aa362e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLoggerToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns10=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Request>&#xa;            &lt;tns9:RequestDecode_token>&#xa;                &lt;tns9:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns9:CodificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codificaOLONOW&quot;>&#xa;                    &lt;tns9:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codificaOLONOW&quot;/>&#xa;                    &lt;/tns9:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'VALNOTF'&quot;/>&#xa;                &lt;/tns9:Funzione>&#xa;                &lt;tns9:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/codiceOrdineOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns9:ChiaveRiferimento>&#xa;                &lt;tns9:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns9:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns10:IPAddress&quot;>&#xa;                    &lt;tns9:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns10:IPAddress&quot;/>&#xa;                    &lt;/tns9:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns9:Token>&#xa;                                &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns9:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns9:Token>&#xa;                                &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns9:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns9:RequestDecode_token>&#xa;            &lt;tns9:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns9:ProcessIstance>&#xa;        &lt;/tns9:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Token-input"
                                    name="Token" outputVariable="Token"
                                    tibex:xpdlId="5a928787-3587-4066-8b1a-b6e6f6bd352c"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToToken"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TokenToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Token/ns24:ResponseDecode_token/ns24:ESITO='OK'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Token/ns24:ResponseDecode_token/ns24:ESITO='OK']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="TokenToThrow">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns10=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Request>&#xa;            &lt;tns9:RequestDecode_token>&#xa;                &lt;tns9:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns9:CodificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codificaOLONOW&quot;>&#xa;                    &lt;tns9:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codificaOLONOW&quot;/>&#xa;                    &lt;/tns9:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'VALNOTF'&quot;/>&#xa;                &lt;/tns9:Funzione>&#xa;                &lt;tns9:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/codiceOrdineOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns9:ChiaveRiferimento>&#xa;                &lt;tns9:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns9:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns10:IPAddress&quot;>&#xa;                    &lt;tns9:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns10:IPAddress&quot;/>&#xa;                    &lt;/tns9:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns9:Token>&#xa;                                &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns9:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns9:Token>&#xa;                                &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns9:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns9:RequestDecode_token>&#xa;            &lt;tns9:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns9:ProcessIstance>&#xa;        &lt;/tns9:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.notificationmanager.util.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;Token&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Referente>&#xa;            &lt;tns6:PresenzaReferente>&#xa;                &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:PresenzaReferente&quot;/>&#xa;            &lt;/tns6:PresenzaReferente>&#xa;            &lt;tns6:ReferenteRipetitivo>&#xa;                &lt;tns6:ProgressivoReferente>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:ProgressivoReferente&quot;/>&#xa;                &lt;/tns6:ProgressivoReferente>&#xa;                &lt;tns6:CognomeReferente>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:CognomeReferente&quot;/>&#xa;                &lt;/tns6:CognomeReferente>&#xa;                &lt;tns6:NomeReferente>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:NomeReferente&quot;/>&#xa;                &lt;/tns6:NomeReferente>&#xa;                &lt;tns6:TelefonoFisso>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFisso&quot;/>&#xa;                &lt;/tns6:TelefonoFisso>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente)>0&quot;>&#xa;                        &lt;tns6:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente&quot;/>&#xa;                        &lt;/tns6:TelefonoFissoReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente&quot;/>&#xa;                        &lt;/tns6:TelefonoFissoReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns6:TelefonoMobile>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobile&quot;/>&#xa;                &lt;/tns6:TelefonoMobile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente_ALT)>0&quot;>&#xa;                        &lt;tns6:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente_ALT&quot;/>&#xa;                        &lt;/tns6:TelefonoMobileReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobileReferente&quot;/>&#xa;                        &lt;/tns6:TelefonoMobileReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:DataContatto&quot;>&#xa;                    &lt;tns6:DataContatto>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke/output/tns6:Referente/tns6:ReferenteRipetitivo[$index]/tns6:DataContatto&quot;/>&#xa;                    &lt;/tns6:DataContatto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns6:ReferenteRipetitivo>&#xa;        &lt;/tns6:Referente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="65ef5f40-1e22-4274-8e47-6c50a2388c2e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="TokenToMapper"/>
                                    <bpws:target linkName="AssignToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Referente>&#xa;            &lt;tns6:PresenzaReferente>&#xa;                &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:PresenzaReferente&quot;/>&#xa;            &lt;/tns6:PresenzaReferente>&#xa;            &lt;tns6:ReferenteRipetitivo>&#xa;                &lt;tns6:ProgressivoReferente>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:ProgressivoReferente&quot;/>&#xa;                &lt;/tns6:ProgressivoReferente>&#xa;                &lt;tns6:CognomeReferente>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:CognomeReferente&quot;/>&#xa;                &lt;/tns6:CognomeReferente>&#xa;                &lt;tns6:NomeReferente>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:NomeReferente&quot;/>&#xa;                &lt;/tns6:NomeReferente>&#xa;                &lt;tns6:TelefonoFisso>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFisso&quot;/>&#xa;                &lt;/tns6:TelefonoFisso>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente)>0&quot;>&#xa;                        &lt;tns6:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente&quot;/>&#xa;                        &lt;/tns6:TelefonoFissoReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoFissoReferente&quot;/>&#xa;                        &lt;/tns6:TelefonoFissoReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns6:TelefonoMobile>&#xa;                    &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobile&quot;/>&#xa;                &lt;/tns6:TelefonoMobile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente_ALT)>0&quot;>&#xa;                        &lt;tns6:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns9:ResponseDecode_token/tns9:N_Recap_Cliente_ALT&quot;/>&#xa;                        &lt;/tns6:TelefonoMobileReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns6:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:TelefonoMobileReferente&quot;/>&#xa;                        &lt;/tns6:TelefonoMobileReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:DataContatto&quot;>&#xa;                    &lt;tns6:DataContatto>&#xa;                        &lt;xsl:value-of select=&quot;$CalcoloReferenteInvoke.output/tns6:ReferenteRipetitivo[$index]/tns6:DataContatto&quot;/>&#xa;                    &lt;/tns6:DataContatto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns6:ReferenteRipetitivo>&#xa;        &lt;/tns6:Referente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:NGA_XDSL_Util="http://www.tim.com/NOW/xsd/NGA_XDSL_Util"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NGA_XDSL_Util:Referente" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="GenericLogger-input"
                                    name="GenericLogger"
                                    tibex:xpdlId="db8901bb-5112-4d2a-8b64-8da790057768"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToAccumulate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns7:Application>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmail&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailPortType&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailOperation&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;tns7:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns7:BusinessID>&#xa;                &lt;tns7:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Detoken&amp;quot;, tib:render-xml($Mapper, true(), true()))&quot;/>&#xa;                &lt;/tns7:Message>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:throw faultName="ns27:DefaultFault"
                                faultVariable="Throw-input" name="Throw" tibex:xpdlId="deb57466-1b41-46d6-bb5e-f903daf0548c">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Token&quot;/>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:DefaultFault>&#xa;            &lt;xsl:if test=&quot;$Token/tns10:ResponseDecode_token/tns10:ESITO&quot;>&#xa;                &lt;message>&#xa;                    &lt;xsl:value-of select=&quot;$Token/tns10:ResponseDecode_token/tns10:ESITO&quot;/>&#xa;                &lt;/message>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Token/tns10:ResponseDecode_token/tns10:DESCRIZIONE&quot;>&#xa;                &lt;msgCode>&#xa;                    &lt;xsl:value-of select=&quot;$Token/tns10:ResponseDecode_token/tns10:DESCRIZIONE&quot;/>&#xa;                &lt;/msgCode>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns9:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="TokenToThrow"/>
                                </bpws:targets>
                            </bpws:throw>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Variable"
                                    name="Assign"
                                    outputVariable="Variable"
                                    tibex:xpdlId="6c20be3f-78a2-4339-b907-0c1ec175f65f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToToken">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($CalcoloReferenteInvoke/output/tns:Referente/tns:ReferenteRipetitivo[$index]/tns:TelefonoFisso='SI' and contains($CalcoloReferenteInvoke/output/tns:Referente/tns:ReferenteRipetitivo[$index]/tns:TelefonoFissoReferente,'kk')) or ($CalcoloReferenteInvoke/output/tns:Referente/tns:ReferenteRipetitivo[$index]/tns:TelefonoMobile='SI' and contains($CalcoloReferenteInvoke/output/tns:Referente/tns:ReferenteRipetitivo[$index]/tns:TelefonoMobileReferente,'kk'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($CalcoloReferenteInvoke.output/tns:ReferenteRipetitivo[$index]/tns:TelefonoFisso='SI' and contains($CalcoloReferenteInvoke.output/tns:ReferenteRipetitivo[$index]/tns:TelefonoFissoReferente,'kk')) or ($CalcoloReferenteInvoke.output/tns:ReferenteRipetitivo[$index]/tns:TelefonoMobile='SI' and contains($CalcoloReferenteInvoke.output/tns:ReferenteRipetitivo[$index]/tns:TelefonoMobileReferente,'kk'))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AssignToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="'True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Variable" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:empty name="Empty2" tibex:xpdlId="e9c2a5f0-a104-46f4-b88d-a637fcd118aa">
                <bpws:targets>
                    <bpws:target linkName="WhileToEmpty2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty2ToTemplateReplaceStringProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty2ToGenericLogger2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Variable='False'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Variable='False']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger2-input"
                    name="GenericLogger2"
                    tibex:xpdlId="fcf8ef26-eed3-4a68-ad48-cad41d17aba6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToGenericLogger2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLogger2ToEmpty3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns7:Application>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmail&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailPortType&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailOperation&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;tns7:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns7:BusinessID>&#xa;                &lt;tns7:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Email non inviata per Tokenizzazione non riuscita'&quot;/>&#xa;                &lt;/tns7:Message>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty3" tibex:xpdlId="b9e92c8d-6dbb-4582-8a0e-0e7d97992978">
                <bpws:targets>
                    <bpws:target linkName="GenericLogger2ToEmpty3"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty3ToOggettoReplaceStringProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty3ToLOG_ReplaceString">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns9:StrutturaRichiesta = &quot;REGOLATORIO&quot; or $Start/ns9:TipologiaNotifica = &quot;ON&quot; or $Start/ns9:TipologiaNotifica = &quot;OFF&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns9:StrutturaRichiesta = "REGOLATORIO" or $Start/ns9:TipologiaNotifica = "ON" or $Start/ns9:TipologiaNotifica = "OFF"]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
