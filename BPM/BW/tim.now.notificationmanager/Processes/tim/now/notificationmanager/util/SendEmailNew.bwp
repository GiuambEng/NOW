>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($CODE_CAUSALE/Record)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($CODE_CAUSALE/Record[1]/DESCR_CAUS_OLO,'.','&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat('.','&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns4:InputString>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;ON&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OFF&amp;quot;&quot;>&#xa;                &lt;tns4:InputString>&#xa;                    &lt;tns4:OldString>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                    &lt;/tns4:OldString>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$TIPOLOGIA RICARICA$&amp;quot;&quot;/>&#xa;                    &lt;/tns4:OldChar>&#xa;                    &lt;tns4:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;$ TIMESTAMP INSERIMENTO $&amp;