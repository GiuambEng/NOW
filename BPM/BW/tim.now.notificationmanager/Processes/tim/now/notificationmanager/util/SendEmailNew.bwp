            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperResponse-input"
                    name="MapperResponse"
                    outputVariable="MapperResponse"
                    tibex:xpdlId="82e6627f-9cd4-44cc-8b13-05f02171afda" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="__Link3"/>
                        <bpws:target linkName="__Link5"/>
                        <bpws:target linkName="__Link8"/>
                        <bpws:target linkName="__Link9"/>
                        <bpws:target linkName="JDBC_STORICIZZAZIONE_EMAILToMapperResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="__EMAILSI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MapperResponseToJDBCUpdate_EMAILNO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(starts-with($MapperResponse/ns9:Response/ns9:ContenutoEmail,&quot;ERRORE&quot;)) and $Start/ns9:StatoNotifica!=&quot;DA INVIARE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(starts-with($MapperResponse/ns9:Response/ns9:ContenutoEmail,"ERRORE")) and $Start/ns9:StatoNotifica!="DA INVIARE"]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TemplateReplaceStringProcess&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;ReplaceMoreString&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL_FWAEOLO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapperResponse-input&quot; match=&quot;/&quot;>&lt;tns2:EmailResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;((exists($JDBC_OLO_ABILITATO_EMAIL/Record) = false() or string-length($JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL) = 0) and $Start/ns:RichiestaElement/offerta!='FWAITALIA1GIGASARDEGNA') or ((exists($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO/Record) = false() or string-length($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO/Record[1]/EMAIL_OFFERTAFWA1GIGASARDEGNA) = 0) and $Start/ns:RichiestaElement/offerta='FWAITALIA1GIGASARDEGNA')&quot;>&lt;tns2:Response>&lt;tns2:ContenutoEmail>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE - OLO non abilitato a ricevere email.&amp;quot;&quot;/>&lt;/tns2:ContenutoEmail>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns2:DataNotifica>&lt;/tns2:Response>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($JDBC_EMAIL_TEMPLATE/Record) = false() and count($JDBCQuery/Record)=0&quot;>&lt;tns2:Response>&lt;tns2:ContenutoEmail>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE - Nessun template presente per l'email da inviare.&amp;quot;&quot;/>&lt;/tns2:ContenutoEmail>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns2:DataNotifica>&lt;/tns2:Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Response>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ReplaceMoreString/tns4:NewString)>0&quot;>&lt;tns2:ContenutoEmail>&lt;xsl:value-of select=&quot;$ReplaceMoreString/tns4:NewString&quot;/>&lt;/tns2:ContenutoEmail>&lt;/xsl:when>&lt;xsl:when test=&quot;$Variable='False'&quot;>&lt;tns2:ContenutoEmail>&lt;xsl:value-of select=&quot;'Email non inviata per Tokenizzazione non riuscita'&quot;/>&lt;/tns2:ContenutoEmail>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContenutoEmail>&lt;xsl:value-of select=&quot;$TemplateReplaceStringProcess/tns4:NewString&quot;/>&lt;/tns2:ContenutoEmail>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns2:DataNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($_error/Msg) > 0 or $Variable='False'&quot;>&lt;tns2:StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;ERRORE&amp;quot;&quot;/>&lt;/tns2:StatoNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:StatoNotifica>&lt;xsl:value-of select=&quot;&amp;quot;INVIATA&amp;quot;&quot;/>&lt;/tns2:StatoNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:EmailResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:GenericNotification="http://www.tim.com/NOW/xsd/GenericNotification"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="GenericNotification:EmailResponse" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Email-input"
                    name="LOG_Email"
                    tibex:xpdlId="d7b11b7d-3cb2-4b37-816b-7b0ae0b3e487"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="__Link1"/>
                        <bpws:target linkName="JDBC_OLO_ABILITATO_EMAIL_FWAEOLOToLOG_Email"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_EmailToEmpty4">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBC_OLO_ABILITATO_EMAIL/Record) or exists($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($JDBC_OLO_ABILITATO_EMAIL/Record) or exists($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO/Record)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="__Link3">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_ABILITATO_EMAIL_FWAEOLO&quot;/>&lt;xsl:template name=&quot;LOG_Email-input&quot; match=&quot;/&quot;>&lt;tns7:CW_BUS_MESSAGE>&lt;tns7:GenericLogger>&lt;tns7:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns7:Application>&lt;tns7:Process>&lt;xsl:value-of select=&quot;&amp;quot;SendEmail&amp;quot;&quot;/>&lt;/tns7:Process>&lt;tns7:Service>&lt;xsl:value-of select=&quot;&amp;quot;SendEmailPortType&amp;quot;&quot;/>&lt;/tns7:Service>&lt;tns7:Operation>&lt;xsl:value-of select=&quot;&amp;quot;SendEmailOperation&amp;quot;&quot;/>&lt;/tns7:Operation>&lt;tns7:BusinessID>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&lt;/tns7:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_OLO_ABILITATO_EMAIL/Record) and string-length($JDBC_OLO_ABILITATO_EMAIL/Record[1]/EMAIL)>0&quot;>&lt;tns7:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Email dell'OLO: &amp;quot;, tib:render-xml($JDBC_OLO_ABILITATO_EMAIL, true(),true()), &amp;quot; NOTIFICA : &amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&lt;/tns7:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO/Record) and string-length($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO/Record[1]/EMAIL_OFFERTAFWA1GIGASARDEGNA)>0&quot;>&lt;tns7:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Email dell'OLO: &amp;quot;, tib:render-xml($JDBC_OLO_ABILITATO_EMAIL_FWAEOLO, true(),true()), &amp;quot; NOTIFICA : &amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&lt;/tns7:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns7:Message>&lt;xsl:value-of select=&quot;&amp;quot;OLO non abilitato a ricevere email.&amp;quot;&quot;/>&lt;/tns7:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns7:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns7:LoggerName>&lt;tns7:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns7:LogLevel>&lt;tns7:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns7:LogJMS>&lt;/tns7:GenericLogger>&lt;/tns7:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Template-input"
                    name="LOG_Template"
                    tibex:xpdlId="5686908a-2d5b-4eb5-8390-aa00f724971e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="__Link4"/>
                        <bpws:target linkName="JDBCQueryToLOG_Template"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="__Link5">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_TemplateTocheckTestMode">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(exists($JDBC_EMAIL_TEMPLATE/Record) or exists($JDBCQuery/Record)) and ($Start/ns9:StrutturaRichiesta = &quot;REGOLATORIO&quot; or ($Start/ns9:StrutturaRichiesta != &quot;REGOLATORIO&quot; and $Start/ns9:TipologiaNotifica != &quot;SC&quot; and $Start/ns9:TipologiaNotifica != &quot;SP&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(exists($JDBC_EMAIL_TEMPLATE/Record) or exists($JDBCQuery/Record)) and ($Start/ns9:StrutturaRichiesta = "REGOLATORIO" or ($Start/ns9:StrutturaRichiesta != "REGOLATORIO" and $Start/ns9:TipologiaNotifica != "SC" and $Start/ns9:TipologiaNotifica != "SP"))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_SC-SP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(exists($JDBC_EMAIL_TEMPLATE/Record) or exists($JDBCQuery/Record))and $Start/ns9:StrutturaRichiesta != &quot;REGOLATORIO&quot; and ($Start/ns9:TipologiaNotifica = &quot;SC&quot; or $Start/ns9:TipologiaNotifica = &quot;SP&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(exists($JDBC_EMAIL_TEMPLATE/Record) or exists($JDBCQuery/Record))and $Start/ns9:StrutturaRichiesta != "REGOLATORIO" and ($Start/ns9:TipologiaNotifica = "SC" or $Start/ns9:TipologiaNotifica = "SP")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Template-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:CW_BUS_MESSAGE>&#xa;            &lt;tns7:GenericLogger>&#xa;                &lt;tns7:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns7:Application>&#xa;                &lt;tns7:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmail&amp;quot;&quot;/>&#xa;                &lt;/tns7:Process>&#xa;                &lt;tns7:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailPortType&amp;quot;&quot;/>&#xa;                &lt;/tns7:Service>&#xa;                &lt;tns7:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendEmailOperation&amp;quot;&quot;/>&#xa;                &lt;/tns7:Operation>&#xa;                &lt;tns7:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns7:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Email template: &amp;quot;, $JDBCQuery/Record[1]/TEMPLATE_EMAIL)&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_EMAIL_TEMPLATE/Record)&quot;>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Email template: &amp;quot;, $JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL)&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun template presente per l'email da inviare.&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
