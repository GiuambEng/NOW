                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBC_FILENAME&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;OggettoReplaceStringProcess-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;PA&amp;quot;) and $Start/ns:RichiestaElement/strutturaRichiesta='FWA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;PA&amp;quot;&quot;>&lt;tns4:InputString>&lt;tns4:OldString>&lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;/>&lt;/tns4:OldString>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Prot_Codice_ISP$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Prot_Codice_Ordine_ISP$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Stato$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codificaOLONOW)>0&quot;>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codificaOLONOW&quot;/>&lt;/tns4:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns4:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;/>&lt;/tns4:NewChar>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns4:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;PA&amp;quot;&quot;>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;PA&amp;quot;&quot;/>&lt;/tns4:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns4:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns4:InputString>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:InputString>&lt;tns4:OldString>&lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/OGGETTO&quot;/>&lt;/tns4:OldString>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Prot_Codice_ISP$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Prot_Codice_Ordine_ISP$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;tns4:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;$Stato$&amp;quot;&quot;/>&lt;/tns4:OldChar>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codificaOLONOW)>0&quot;>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codificaOLONOW&quot;/>&lt;/tns4:NewChar>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:NewChar>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns4:NewChar>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when