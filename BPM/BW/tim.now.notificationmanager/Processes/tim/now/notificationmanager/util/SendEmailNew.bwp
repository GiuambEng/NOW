select=&quot;&amp;quot;$TAGGING_ACCESSO$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROFILO$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROFILO_UP$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$PROFILO_DOWN$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$INTERMEDIATE_AGENT_REMOTE_ID_1$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$DHCP_OPTION_82_REMOTE_ID_1$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$INTERMEDIATE_AGENT_REMOTE_ID_2$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$DHCP_OPTION_82_REMOTE_ID_2$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$INTERMEDIATE_AGENT_REMOTE_ID_3$&amp;quot;&quot;/>&#xa;                            &lt;/tns4:OldChar>&#xa;                            &lt;tns4:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;$DHCP_OPT