                    outputVariable="GetLocalIP"
                    tibex:xpdlId="490cd99d-dbf1-441b-a21c-ffa2b490b2aa"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToGetLocalIP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetLocalIPToWhile"/>
                    </bpws:sources>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.GetLocalIP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="fd7a1e19-ef8d-42c1-9e2d-d562796b300d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty4ToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLOG_Template"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fd7a1e19-ef8d-42c1-9e2d-d562796b300d+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;RR&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;&quot;>&#xa;                            &lt;COD_TIPOLG_NOTF>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AK&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&#xa;                            &lt;/COD_TIPOLG_NOTF>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;COD_TIPOLG_NOTF>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, &amp;quot;AQ&amp;quot;, &amp;quot;%&amp;quot;)&quot;/>&#xa;                            &lt;/COD_TIPOLG_NOTF>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; and $Start/ns:RichiestaElement/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot;&quot;>&#xa;                    &lt;COD_TIPOLG_NOTF>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;,$Start/tns2:TipologiaNotifica, &amp;quot;%&amp;quot;)&quot;/>&#xa;                    &lt;/COD_TIPOLG_NOTF>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COD_TIPOLG_NOTF>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;%&amp;quot;, $Start/tns2:TipologiaNotifica, &amp;quot;%&amp;quot;)&quot;/>&#xa;                    &lt;/COD_TIPOLG_NOTF>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;OFFERTA>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:Offerta&quot;/>&#xa;            &lt;/OFFERTA>&#xa;        &lt;/tns9:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TEMPLATE_EMAIL, OGGETTO, ID_EMAIL_TEMPLATE&#xa;  FROM APPUSER.EMAIL_TEMPLATE &#xa;  WHERE  COD_TIPOLG_NOTF LIKE ?&#xa;    AND OFFERTA= ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_TIPOLG_NOTF"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OFFERTA"/>
                                    <columnMetadata
                                    columnName="TEMPLATE_EMAIL"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="OGGETTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_EMAIL_TEMPLATE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty4" tibex:xpdlId="960ced91-8e61-4318-a171-e0d8492a9719">
                <bpws:targets>
                    <bpws:target linkName="LOG_EmailToEmpty4"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty4ToJDBC_EMAIL_TEMPLATE">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty4ToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($Start/ns9:RichiestaGenerica/ns9:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VLAN) or exists($Start/ns9:RichiestaGenerica/ns9:RICHIESTA_NGA/ns02:RICHIESTA/ns02:DATI_VLAN) or $Start/ns21:RichiestaElement/offerta='FWAITALIA1GIGASARDEGNA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[exists($Start/ns9:RichiestaGenerica/ns9:RICHIESTA_XDSL/ns01:RICHIESTA/ns01:DATI_VLAN) or exists($Start/ns9:RichiestaGenerica/ns9:RICHIESTA_NGA/ns02:RICHIESTA/ns02:DATI_VLAN) or $Start/ns21:RichiestaElement/offerta='FWAITALIA1GIGASARDEGNA']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="Empty5" tibex:xpdlId="a1c02645-d6d0-478a-8e80-e277fa25f313">
                <bpws:targets>
                    <bpws:target linkName="LOG_ReplaceStringToEmpty5"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty5ToJDBC_STORICIZZAZIONE_EMAIL">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty5ToReplaceMoreString">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($CalcoloReferenteInvoke/output/tns:Referente/tns:ReferenteRipetitivo[contains(tns:TelefonoFissoReferente,'kk') or contains(tns:TelefonoMobileReferente,'kk')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($CalcoloReferenteInvoke.output/tns:ReferenteRipetitivo[contains(tns:TelefonoFissoReferente,'kk') or contains(tns:TelefonoMobileReferente,'kk')])>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_FILENAME&quot;/>&#xa;    &lt;xsl:param name=&quot;RagioneSociale&quot;/>&#xa;    &lt;xsl:param name=&quot;CODE_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplaceMoreString-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;($Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot; ) and $Start/ns:RichiestaElement/strutturaRichiesta='FWA'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot;&quot;>&#xa;                                &lt;tns4:InputString>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SOCIALE_OLO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$CODICE_ORDINE_OLO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$TIMESTAMP_INSERIMENTO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_ACCENSIONE$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$IDRISORSA$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$IMEI$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$IMSI$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$MSISDN$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$SERIALNUMBER$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($RagioneSociale/Record)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($RagioneSociale/Record[1]/RAGIONE_SOCIALE,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;'&amp;#xA;'&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                                &lt;tns4:NewChar>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                                &lt;/tns4:NewChar>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;),'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;'&amp;#xA;'&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/DES)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/ORA_DES)&quot;>&#xa;                                                    &lt;tns4:NewChar>&#xa;                                                        &lt;xsl:value-of select=&quot;format-dateTime(tib:create-dateTime(year-from-date($Start/ns:RichiestaElement/ordine/DES), month-from-date($Start/ns:RichiestaElement/ordine/DES), day-from-date($Start/ns:RichiestaElement/ordine/DES), hours-from-time($Start/ns:RichiestaElement/ordine/ORA_DES), minutes-from-time($Start/ns:RichiestaElement/ordine/ORA_DES), xsd:int(seconds-from-time($Start/ns:RichiestaElement/ordine/ORA_DES))),&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                                                    &lt;/tns4:NewChar>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns4:NewChar>&#xa;                                                        &lt;xsl:value-of select=&quot;format-dateTime(tib:create-dateTime(year-from-date($Start/ns:RichiestaElement/ordine/DES), &amp;#xD;&amp;#xA;month-from-date($Start/ns:RichiestaElement/ordine/DES),day-from-date($Start/ns:RichiestaElement/ordine/DES),00,00,00),&amp;#xD;&amp;#xA;&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                                                    &lt;/tns4:NewChar>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/IDRisorsa) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;>&#xa;                                                &lt;tns4:NewChar>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                                &lt;/tns4:NewChar>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMEI']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMEI']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMSI']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMSI']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='MSISDN']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='MSISDN']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SERIALNUMBER']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SERIALNUMBER']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns4:InputString>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:Inpu