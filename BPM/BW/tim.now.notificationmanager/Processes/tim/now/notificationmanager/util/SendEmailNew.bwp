rror_SendMail/tns9:InvalidInputException/msg,$_error_SendMail/tns9:InvalidInputException/msgCode,$_error_SendMail/tns9:UnknownHostException/msg,$_error_SendMail/tns9:UnknownHostException/msgCode,$_error_SendMail/tns9:UnknownHostException/hostName,$_error_SendMail/tns9:SendFailedException/msg,$_error_SendMail/tns9:SendFailedException/msgCode)&quot;/>&#xa;                &lt;/tns7:Message>&#xa;                &lt;tns7:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns7:LoggerName>&#xa;                &lt;tns7:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns7:LogLevel>&#xa;                &lt;tns7:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns7:LogJMS>&#xa;            &lt;/tns7:GenericLogger>&#xa;        &lt;/tns7:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
