                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_EMAIL_TEMPLATE&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_FILENAME&quot;/>&#xa;    &lt;xsl:param name=&quot;RagioneSociale&quot;/>&#xa;    &lt;xsl:param name=&quot;CODE_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;TemplateReplaceStringProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;($Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;KF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;PA&amp;quot;) and $Start/ns:RichiestaElement/strutturaRichiesta='FWA'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;OF&amp;quot; or $Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns4:InputString>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SOCIALE_OLO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$CODICE_ORDINE_OLO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$TIMESTAMP_INSERIMENTO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_ACCENSIONE$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$IDRISORSA$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($RagioneSociale/Record)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($RagioneSociale/Record[1]/RAGIONE_SOCIALE,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;'&amp;#xA;'&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                                &lt;tns4:NewChar>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                                &lt;/tns4:NewChar>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;),'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;'&amp;#xA;'&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns2:RichiestaGenerica/ns02:NotificaOLOFWA/ns02:Intestazione/ns02:DataNotifica)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/tns2:RichiestaGenerica/ns02:NotificaOLOFWA/ns02:Intestazione/ns02:DataNotifica&quot;>&#xa;                                                &lt;tns4:NewChar>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/tns2:RichiestaGenerica/ns02:NotificaOLOFWA/ns02:Intestazione/ns02:DataNotifica&quot;/>&#xa;                                                &lt;/tns4:NewChar>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/IDRisorsa) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;>&#xa;                                                &lt;tns4:NewChar>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                                &lt;/tns4:NewChar>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns4:InputString>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Start/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot;&quot;>&#xa;                                &lt;tns4:InputString>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SOCIALE_OLO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$CODICE_ORDINE_OLO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$TIMESTAMP_INSERIMENTO$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$DATA_ACCENSIONE$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$IDRISORSA$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$IMEI$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$IMSI$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$MSISDN$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$SERIALNUMBER$&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:OldChar>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($RagioneSociale/Record)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($RagioneSociale/Record[1]/RAGIONE_SOCIALE,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;'&amp;#xA;'&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/codiceOrdineOLO) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;>&#xa;                                                &lt;tns4:NewChar>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/codiceOrdineOLO&quot;/>&#xa;                                                &lt;/tns4:NewChar>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)) > 0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat(format-dateTime($Start/ns:RichiestaElement/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;),'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;'&amp;#xA;'&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/DES)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($Start/ns:RichiestaElement/ordine/ORA_DES)&quot;>&#xa;                                                    &lt;tns4:NewChar>&#xa;                                                        &lt;xsl:value-of select=&quot;format-dateTime(tib:create-dateTime(year-from-date($Start/ns:RichiestaElement/ordine/DES), month-from-date($Start/ns:RichiestaElement/ordine/DES), day-from-date($Start/ns:RichiestaElement/ordine/DES), hours-from-time($Start/ns:RichiestaElement/ordine/ORA_DES), minutes-from-time($Start/ns:RichiestaElement/ordine/ORA_DES), xsd:int(seconds-from-time($Start/ns:RichiestaElement/ordine/ORA_DES))),&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                                                    &lt;/tns4:NewChar>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;tns4:NewChar>&#xa;                                                        &lt;xsl:value-of select=&quot;format-dateTime(tib:create-dateTime(year-from-date($Start/ns:RichiestaElement/ordine/DES), &amp;#xD;&amp;#xA;month-from-date($Start/ns:RichiestaElement/ordine/DES),day-from-date($Start/ns:RichiestaElement/ordine/DES),00,00,00),&amp;#xD;&amp;#xA;&amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                                                    &lt;/tns4:NewChar>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/IDRisorsa) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;>&#xa;                                                &lt;tns4:NewChar>&#xa;                                                    &lt;xsl:value-of select=&quot;$Start/ns:RichiestaElement/IDRisorsa&quot;/>&#xa;                                                &lt;/tns4:NewChar>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMEI']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMEI']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMSI']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IMSI']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='MSISDN']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='MSISDN']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SERIALNUMBER']/valoreAttributo)>0&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SERIALNUMBER']/valoreAttributo,'&amp;#xA;')&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns4:InputString>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns4:InputString>&#xa;                                    &lt;tns4:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_EMAIL_TEMPLATE/Record[1]/TEMPLATE_EMAIL&quot;/>&#xa;                                    &lt;/tns4:OldString>&#xa;                                    &lt;tns4:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;$NOME_RAGIONE_SO