ferta)>0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$Start/ns:RichiestaElement/offerta='VLANNGA'&quot;>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat('NGA', &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns4:NewChar>&#xa;                                                &lt;xsl:value-of select=&quot;concat('VULA', &amp;quot;&amp;lt;br/>&amp;quot;)&quot;/>&#xa;                                            &lt;/tns4:NewChar>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;lt;br/>&amp;quot;&quot;/>&#xa;                                    &lt;/tns4:NewChar>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Start/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='NOMEAREARACCOLTA']/valoreAttributo)>0&quot;>&#xa;                                    &lt;tns4:NewChar>&#xa;                                        &lt;xsl:value-of select=&quot;concat($Start/ns:RichiestaElement/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='NOMEAREARACCO