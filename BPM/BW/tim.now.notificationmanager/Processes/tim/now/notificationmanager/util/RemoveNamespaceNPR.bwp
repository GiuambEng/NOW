                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npr&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceNPRIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;ValidFormaleCessazioneRenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;Valid_Formale_Cessazione>&#xa;            &lt;TipoComunicazione>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:TipoComunicazione&quot;/>&#xa;            &lt;/TipoComunicazione>&#xa;            &lt;CodiceOrdine>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:CodiceOrdine&quot;/>&#xa;            &lt;/CodiceOrdine>&#xa;            &lt;DataOrdine>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:DataOrdine&quot;/>&#xa;            &lt;/DataOrdine>&#xa;            &lt;DirectoryNumber>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:DirectoryNumber&quot;/>&#xa;            &lt;/DirectoryNumber>&#xa;            &lt;IdentificativoOperatoreDonor>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:IdentificativoOperatoreDonor&quot;/>&#xa;            &lt;/IdentificativoOperatoreDonor>&#xa;            &lt;DataInvioMessaggio>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:DataInvioMessaggio&quot;/>&#xa;            &lt;/DataInvioMessaggio>&#xa;            &lt;xsl:if test=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:Note&quot;>&#xa;                &lt;Note>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid