          &lt;/tns:DataAttesaConsegnaServizio>&#xa;                                    &lt;tns:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/tns:CognomeCliente_RagioneSociale>&#xa;                                    &lt;xsl:if test=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:NomeCliente&quot;>&#xa;                                        &lt;tns:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:NomeCliente&quot;/>&#xa;                                        &lt;/tns:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns:TelefonoReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:TelefonoReferenteRichiedente&quot;/>&#xa;                                    &lt;/tns:TelefonoReferenteRichiedente>&#xa;                                    &lt;tns:EmailReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:EmailReferenteRichiedente&quot;/>&#xa;                                    &lt;/tns:EmailReferenteRichiedente>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:Correlazioni)&quot;>&#xa;                                            &lt;tns:Correlazioni>&#xa;                                                &lt;tns:IdentificativoCorrelazioni>&#xa;                                                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:Correlazioni/tns:IdentificativoCorrelazioni&quot;/>&#xa;                                                &lt;/tns:IdentificativoCorrelazioni>&#xa;                                                &lt;tns:TotaleRichieste>&#xa;                                                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:Rientro/tns:Correlazioni/tns:TotaleRichieste&quot;/>&#xa;                                                &lt;/tns:TotaleRichieste>&#xa;                                            &lt;/tns:Correlazioni>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns:Rientro>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:NPAggiuntive)&quot;>&#xa;                                &lt;tns:NPAggiuntive>&#xa;                                    &lt;xsl:for-each select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Telecom/tns:NPAggiuntive/tns:NumAggiuntivaPortata&quot;>&#xa;                                        &lt;tns:NumAggiuntivaPortata>&#xa;                                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                        &lt;/tns:NumAggiuntivaPortata>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/tns:NPAggiuntive>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns:Telecom>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:DataEspletamentoOrdine>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:DataEspletamentoOrdine&quot;/>&#xa;            &lt;/tns:DataEspletamentoOrdine>&#xa;        &lt;/tns:Espletamento_Cessazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
