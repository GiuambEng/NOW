select=&quot;$RemoveNamespaceNPRIn.Input/tns:Com_Esito_Donor_Recipient/tns:DatiNotifica/tns:Correlazioni/tns:IdentificativoCorrelazioni&quot;/>&#xa;                            &lt;/IdentificativoCorrelazioni>&#xa;                            &lt;TotaleRichieste>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Com_Esito_Donor_Recipient/tns:DatiNotifica/tns:Correlazioni/tns:TotaleRichieste&quot;/>&#xa;                            &lt;/TotaleRichieste>&#xa;                        &lt;/Correlazioni>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DatiNotifica>&#xa;            &lt;EsitoVerifica>&#xa;                &lt;EsitoKO>&#xa;                    &lt;EsitoVerificaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Com_Esito_Donor_Recipient/tns:EsitoVerifica/tns:EsitoKO/tns:EsitoVerificaRichiesta&quot;/>&#xa;                    &lt;/EsitoVerificaRichiesta>&#xa;                    &lt;CodiceMotivoRifiuto>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Com_Esito_Donor_Recipient/tns:EsitoVerifica/tns:EsitoKO/tns:CodiceMotivoRifiuto&quot;/>&#xa;                    &lt;/CodiceMotivoRifiuto>&#xa;                    &lt;DescrizioneRifiuto>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Com_Esito_Donor_Recipient/tns:EsitoVerifica/tns:EsitoKO/tns:DescrizioneRifiuto&quot;/>&#xa;                    &lt;/DescrizioneRifiuto>&#xa;                &lt;/EsitoKO>&#xa;            &lt;/EsitoVerifica>&#xa;        &lt;/Com_Esito_Donor_Recipient>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
