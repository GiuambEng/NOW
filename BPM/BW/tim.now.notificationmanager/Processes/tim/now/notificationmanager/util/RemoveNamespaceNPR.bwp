                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npr&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceNPRIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;ValidTecnicaDonatingDonorRenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;Valid_Tecnica_Donating_Donor>&#xa;            &lt;TipoComunicazione>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:TipoComunicazione&quot;/>&#xa;            &lt;/TipoComunicazione>&#xa;            &lt;DatiNotifica>&#xa;                &lt;CodiceOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:DatiNotifica/tns:CodiceOrdine&quot;/>&#xa;                &lt;/CodiceOrdine>&#xa;                &lt;DataOrdine>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:DatiNotifica/tns:DataOrdine&quot;/>&#xa;                &lt;/DataOrdine>&#xa;                &lt;DirectoryNumber>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:DatiNotifica/tns:DirectoryNumber&quot;/>&#xa;                &lt;/DirectoryNumber>&#xa;                &lt;IdentificativoOperatoreDonor>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:DatiNotifica/tns:IdentificativoOperatoreDonor&quot;/>&#xa;                &lt;/IdentificativoOperatoreDonor>&#xa;                &lt;DataInvioMessaggio>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:DatiNotifica/tns:DataInvioMessaggio&quot;/>&#xa;                &lt;/DataInvioMessaggio>&#xa;                &l