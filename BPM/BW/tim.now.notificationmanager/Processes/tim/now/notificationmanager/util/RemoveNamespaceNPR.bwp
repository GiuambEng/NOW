    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://xmlns.example.com/20160919173115PLT"
    xmlns:ns0="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns1="http://www.tim.com/NOW/wsdl/abstract/RemoveNamespace"
    xmlns:ns2="http://www.tim.com/NOW/xsd/GenericLogger"
