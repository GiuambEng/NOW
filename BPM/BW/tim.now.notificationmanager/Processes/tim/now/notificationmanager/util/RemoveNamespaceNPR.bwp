amespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:Telecom/tns:Rientro/tns:Correlazioni/tns:IdentificativoCorrelazioni&quot;/>&#xa;                                                &lt;/IdentificativoCorrelazioni>&#xa;                                                &lt;TotaleRichieste>&#xa;                                                    &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:Telecom/tns:Rientro/tns:Correlazioni/tns:TotaleRichieste&quot;/>&#xa;                                                &lt;/TotaleRichieste>&#xa;                                            &lt;/Correlazioni>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/Rientro>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:Telecom/tns:NPAggiuntive)&quot;>&#xa;                                &lt;NPAggiuntive>&#xa;                                    &lt;xsl:for-each select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:Telecom/tns:NPAggiuntive/tns:NumAggiuntivaPortata&quot;>&#xa;                                        &lt;NumAggiuntivaPortata>&#xa;                                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                        &lt;/NumAggiuntivaPortata>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/NPAggiuntive>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Telecom>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;EsitoVerifica>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:EsitoVerifica/tns:EsitoKO)&quot;>&#xa;                        &lt;EsitoKO>&#xa;                            &lt;EsitoVerificaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:EsitoVerifica/tns:EsitoKO/tns:EsitoVerificaRichiesta&quot;/>&#xa;                            &lt;/EsitoVerificaRichiesta>&#xa;                            &lt;CodiceMotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:EsitoVerifica/tns:EsitoKO/tns:CodiceMotivoRifiuto&quot;/>&#xa;                            &lt;/CodiceMotivoRifiuto>&#xa;                            &lt;DescrizioneRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:EsitoVerifica/tns:EsitoKO/tns:DescrizioneRifiuto&quot;/>&#xa;                            &lt;/DescrizioneRifiuto>&#xa;                        &lt;/EsitoKO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;EsitoOK>&#xa;                            &lt;EsitoVerificaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Formale_Cessazione/tns:EsitoVerifica/tns:EsitoOK/tns:EsitoVerificaRichiesta&quot;/>&#xa;                            &lt;/EsitoVerificaRichiesta>&#xa;                        &lt;/EsitoOK>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/EsitoVerifica>&#xa;        &lt;/Valid_Formale_Cessazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
