                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npr&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RemoveNamespaceNPRIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;EspletamentoCessazioneRenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Espletamento_Cessazione>&#xa;            &lt;tns:TipoComunicazione>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:TipoComunicazione&quot;/>&#xa;            &lt;/tns:TipoComunicazione>&#xa;            &lt;tns:CodiceOrdine>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:CodiceOrdine&quot;/>&#xa;            &lt;/tns:CodiceOrdine>&#xa;            &lt;tns:DataOrdine>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:DataOrdine&quot;/>&#xa;            &lt;/tns:DataOrdine>&#xa;            &lt;tns:DirectoryNumber>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:DirectoryNumber&quot;/>&#xa;            &lt;/tns:DirectoryNumber>&#xa;            &lt;tns:IdentificativoOperatoreDonor>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:IdentificativoOperatoreDonor&quot;/>&#xa;            &lt;/tns:IdentificativoOperatoreDonor>&#xa;            &lt;tns:DataInvioMessaggio>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:DataInvioMessaggio&quot;/>&#xa;            &lt;/tns:DataInvioMessaggio>&#xa;            &lt;xsl:if test=&quot;$RemoveNamespaceNPRIn.Input/tns:Espletamento_Cessazione/tns:Note&quot;>&#xa;                &lt;tns:Note>&#xa;                    &lt;xsl:value-of se