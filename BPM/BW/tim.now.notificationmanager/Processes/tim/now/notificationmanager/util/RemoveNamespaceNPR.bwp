IdentificativoCorrelazioni>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:DatiNotifica/tns:Correlazioni/tns:IdentificativoCorrelazioni&quot;/>&#xa;                            &lt;/IdentificativoCorrelazioni>&#xa;                            &lt;TotaleRichieste>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:DatiNotifica/tns:Correlazioni/tns:TotaleRichieste&quot;/>&#xa;                            &lt;/TotaleRichieste>&#xa;                        &lt;/Correlazioni>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DatiNotifica>&#xa;            &lt;IdentificativoOperatoreDonating>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:IdentificativoOperatoreDonating&quot;/>&#xa;            &lt;/IdentificativoOperatoreDonating>&#xa;            &lt;EsitoVerifica>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:EsitoVerifica/tns:EsitoKO)&quot;>&#xa;                        &lt;EsitoKO>&#xa;                            &lt;EsitoVerificaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:EsitoVerifica/tns:EsitoKO/tns:EsitoVerificaRichiesta&quot;/>&#xa;                            &lt;/EsitoVerificaRichiesta>&#xa;                            &lt;CodiceMotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$RemoveNamespaceNPRIn.Input/tns:Valid_Tecnica_Donating_Donor/tns:EsitoVerifica/tns:EsitoKO/tns:CodiceMotivoRifiuto&quot;/>&#xa;                            &lt;/CodiceMotivoRifiuto>&#xa;                            &lt;DescrizioneRifiuto>&#xa;    