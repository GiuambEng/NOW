                                <bpws:sources>
                                    <bpws:source linkName="While2ToEmpty8"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence2" tibex:group="while">
                                    <bpws:assign name="GroupInit2"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+c644f457-e8e0-46a6-98f2-0ae684facd90" version="2.0"> <xsl:template name="Accumulate2" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate2"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while2" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($Mapper4/ns10:NumeriTelefonici)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($Mapper4/ns10:NumeriTelefonici)]]></bpws:condition>
                                    <bpws:flow name="flow4">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart2ToToken2" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Token2ToMapper5" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Mapper5ToGenericLogger13" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Token2ToGenericLogger12" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="GenericLogger12ToMapper5" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GenericLogger13ToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart2ToMapper5" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart2"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="fa0bedbf-f053-4efc-adf2-0f341e6e30b8" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToToken2">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="(contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoFissoReferente,'kk') or contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoMobileReferente,'kk'))&#xd;&#xa;or&#xd;&#xa;((contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoFissoReferente,'dk') or contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoMobileReferente,'dk') or&#xd;&#xa;contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:NomeReferente,'dk') or&#xd;&#xa;contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:CognomeReferente,'dk')) and $VisualizzazioneNotificheOperationIn/Input/tns:Request/tns:DatiNotifiche[$index]/tns:isOLO=false())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoFissoReferente,'kk') or contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoMobileReferente,'kk'))
or
((contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoFissoReferente,'dk') or contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:TelefonoMobileReferente,'dk') or
contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:NomeReferente,'dk') or
contains($Mapper4/ns10:NumeriTelefonici[$index1]/ns10:CognomeReferente,'dk')) and $VisualizzazioneNotificheOperationIn.Input/tns:DatiNotifiche[$index]/tns:isOLO=false())]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart2ToMapper5"/>
                                    </bpws:sources>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="Token2"/>
                                    <bpws:to variable="Token2"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate2"
                                    outputVariable="Accumulate2"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="c644f457-e8e0-46a6-98f2-0ae684facd90" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLogger13ToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>

                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper5</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Mapper4&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;VisualizzazioneNotificheOperationIn&quot;/>&lt;xsl:template name=&quot;Token2-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:RequestDecode_token>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery2/Record[1]/CODICEORDINEOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$JDBCQuery2/Record[1]/CODICEORDINEOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;/>&lt;/tns:Funzione>&lt;/xsl:if>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($JDBCQuery2/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&lt;/tns:ChiaveRiferimento>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;/>&lt;/tns:Operatore>&lt;/xsl:if>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente,'kk'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente,'dk'))&quot;>&lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente,'kk'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente,'dk'))&quot;>&lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'kk'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'dk'))&quot;>&lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RequestDecode_token>&lt;tns:ProcessIstance>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:ProcessIstance>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Token2-input"
                                    name="Token2"
                                    outputVariable="Token2"
                                    tibex:xpdlId="14bf752a-0242-48ff-8e9e-5c433ed6ac9e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
