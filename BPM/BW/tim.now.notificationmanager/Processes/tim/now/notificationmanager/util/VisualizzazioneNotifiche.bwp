                tibex:xpdlId="65b26e3f-fcaa-4358-acb7-86cdff035841" variable="VisualizzazioneNotificheOperationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/VisualizzazioneNotifiche/" xmlns:tns1="http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/" version="2.0"&gt;&lt;xsl:param name="Accumulate"/&gt;&lt;xsl:template name="VisualizzazioneNotificheOperationOut-input" match="/"&gt;&lt;tns:VisualizzazioneNotificheOperationResponse&gt;&lt;Output&gt;&lt;tns1:Response&gt;&lt;xsl:for-each select="$Accumulate/tns1:Response[tns1:DatiNotificheResponse[1]/tns1:contenutoXML!='FALSE']"&gt;&lt;tns1:DatiNotificheResponse&gt;&lt;xsl:if test="tns1:DatiNotificheResponse[1]/tns1:contenutoXML"&gt;&lt;tns1:contenutoXML&gt;&lt;xsl:value-of select="tns1:DatiNotificheResponse[1]/tns1:contenutoXML"/&gt;&lt;/tns1:contenutoXML&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns1:DatiNotificheResponse[1]/tns1:IDNotifica"&gt;&lt;tns1:IDNotifica&gt;&lt;xsl:value-of select="tns1:DatiNotificheResponse[1]/tns1:IDNotifica"/&gt;&lt;/tns1:IDNotifica&gt;&lt;/xsl:if&gt;&lt;/tns1:DatiNotificheResponse&gt;&lt;/xsl:for-each&gt;&lt;/tns1:Response&gt;&lt;/Output&gt;&lt;/tns:VisualizzazioneNotificheOperationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/VisualizzazioneNotifiche/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;VisualizzazioneNotificheOperationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate/tns1:Response[tns1:DatiNotificheResponse[1]/tns1:contenutoXML!='FALSE']&quot;>&#xa;                &lt;tns1:DatiNotificheResponse>&#xa;                    &lt;xsl:if test=&quot;tns1:DatiNotificheResponse[1]/tns1:contenutoXML&quot;>&#xa;                        &lt;tns1:contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;tns1:DatiNotificheResponse[1]/tns1:contenutoXML&quot;/>&#xa;                        &lt;/tns1:contenutoXML>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:DatiNotificheResponse[1]/tns1:IDNotifica&quot;>&#xa;                        &lt;tns1:IDNotifica>&#xa;                            &lt;xsl:value-of select=&quot;tns1:DatiNotificheResponse[1]/tns1:IDNotifica&quot;/>&#xa;                        &lt;/tns1:IDNotifica>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:DatiNotificheResponse>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
