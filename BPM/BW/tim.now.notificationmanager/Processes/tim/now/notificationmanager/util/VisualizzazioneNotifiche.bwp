                                    <bpws:target linkName="GenericLogger10ToEmpty4"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty4ToMapper1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty4ToMapper4">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'kk') or contains(ns15:MOB_REF, 'kk')])>0)&#xd;&#xa;or&#xd;&#xa;(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'dk') or contains(ns15:MOB_REF, 'dk')])>0)&#xd;&#xa;or &#xd;&#xa;(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:NOME_REF,'dk') or contains(ns15:COGNOME_REF, 'dk')])>0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'kk') or contains(ns15:MOB_REF, 'kk')])>0)
or
(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'dk') or contains(ns15:MOB_REF, 'dk')])>0)
or 
(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:NOME_REF,'dk') or contains(ns15:COGNOME_REF, 'dk')])>0)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty4ToToken5">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="((count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'kk') or contains(ns15:MOB_REF, 'kk')])=0)&#xd;&#xa;or&#xd;&#xa;(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'dk') or contains(ns15:MOB_REF, 'dk')])=0)&#xd;&#xa;or &#xd;&#xa;(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:NOME_REF,'dk') or contains(ns15:COGNOME_REF, 'dk')])=0)) &#xd;&#xa;and &#xd;&#xa;(starts-with($ParseXml1/ns15:DATI_ACCESSO/ns15:NOME, 'dk') or starts-with($ParseXml1/ns15:DATI_ACCESSO/ns15:COGNOME, 'dk'))&#xd;&#xa;and&#xd;&#xa;$VisualizzazioneNotificheOperationIn/Input/tns:Request/tns:DatiNotifiche[$index]/tns:isOLO=false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[((count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'kk') or contains(ns15:MOB_REF, 'kk')])=0)
or
(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:TEL_REF,'dk') or contains(ns15:MOB_REF, 'dk')])=0)
or 
(count($ParseXml1/ns15:DATI_REFERENTE/ns15:REFERENTE[contains(ns15:NOME_REF,'dk') or contains(ns15:COGNOME_REF, 'dk')])=0)) 
and 
(starts-with($ParseXml1/ns15:DATI_ACCESSO/ns15:NOME, 'dk') or starts-with($ParseXml1/ns15:DATI_ACCESSO/ns15:COGNOME, 'dk'))
and
$VisualizzazioneNotificheOperationIn.Input/tns:DatiNotifiche[$index]/tns:isOLO=false()]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
