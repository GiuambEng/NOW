                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOperationIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ReplaceMoreString&quot;/>&#xa;    &lt;xsl:param name=&quot;ReplaceMoreString1&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:param name=&quot;ReplaceMoreStringNP&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Response>&#xa;            &lt;tns:DatiNotificheResponse>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQuery/Record)=0&quot;>&#xa;                        &lt;tns:contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;'FALSE'&quot;/>&#xa;                        &lt;/tns:contenutoXML>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($TransformXml)>0 and $Variable='TRUE'&quot;>&#xa;                        &lt;tns:contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;$TransformXml&quot;/>&#xa;                        &lt;/tns:contenutoXML>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ReplaceMoreString/tns2:NewString)>0&quot;>&#xa;                        &lt;tns:contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;lt;ns0:RICHIESTA>', substring-after(substring-after($ReplaceMoreString/tns2:NewString, &amp;quot;>&amp;quot;),'>'))&quot;/>&#xa;                        &lt;/tns:contenutoXML>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ReplaceMoreString1/tns2:NewString)>0&quot;>&#xa;                        &lt;tns:contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;concat('&amp;lt;ns0:RICHIESTA>', substring-after($ReplaceMoreString1/tns2:NewString, &amp;quot;>&amp;quot;))&quot;/>&#xa;                        &lt;/tns:contenutoXML>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ReplaceMoreStringNP/tns2:NewString)>0&quot;>&#xa;                        &lt;tns:contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;$ReplaceMoreStringNP/tns2:NewString&quot;/>&#xa;                        &lt;/tns:contenutoXML>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/TRACCIATO_FILE&quot;>&#xa;                            &lt;tns:contenutoXML>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/TRACCIATO_FILE&quot;/>&#xa;                            &lt;/tns:contenutoXML>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns:DatiNotifiche[$index]/tns:IDNotifica&quot;>&#xa;                    &lt;tns:IDNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns:DatiNotifiche[$index]/tns:IDNotifica&quot;/>&#xa;                    &lt;/tns:IDNotifica>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:DatiNotificheResponse>&#xa;        &lt;/tns:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
