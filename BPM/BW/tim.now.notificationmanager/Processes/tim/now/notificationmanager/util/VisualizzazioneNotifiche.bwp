                                 &lt;xsl:if test=&quot;string-length($Token/tns:ResponseDecode_token/tns:Nome)>0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$Token/tns:ResponseDecode_token/tns:Nome&quot;>&#xa;                                            &lt;NomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:Nome&quot;/>&#xa;                                            &lt;/NomeReferente>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente&quot;>&#xa;                                                &lt;TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/Accettazione/Referente/Progressivo&quot;>&#xa;                                        &lt;Progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/Accettazione/Referente/Progressivo&quot;/>&#xa;                                        &lt;/Progressivo>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/Referente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/Accettazione/BitRate&quot;>&#xa;                                &lt;BitRate>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/Accettazione/BitRate&quot;/>&#xa;                                &lt;/BitRate>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$ParseXml/NotificaSLU/Accettazione/NumerazioneAggiuntiva&quot;>&#xa;                                &lt;NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/Accettazione/NuovoIdRisorsa&quot;>&#xa;                                &lt;NuovoIdRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/Accettazione/NuovoIdRisorsa&quot;/>&#xa;                                &lt;/NuovoIdRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/Accettazione>&#xa;                    &lt;/NotificaSLU>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseXml/NotificaSLU/StatoAvanzamento)&quot;>&#xa;                    &lt;NotificaSLU>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseXml/NotificaSLU/TestataNotifica&quot;/>&#xa;                        &lt;StatoAvanzamento>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/IdRisorsa&quot;>&#xa;                                &lt;IdRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/IdRisorsa&quot;/>&#xa;                                &lt;/IdRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/DataValidazioneFormaleContrattuale&quot;>&#xa;                                &lt;DataValidazioneFormaleContrattuale>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/DataValidazioneFormaleContrattuale&quot;/>&#xa;                                &lt;/DataValidazioneFormaleContrattuale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/DataValidazioneTecnicoGestionale&quot;>&#xa;                                &lt;DataValidazioneTecnicoGestionale>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/DataValidazioneTecnicoGestionale&quot;/>&#xa;                                &lt;/DataValidazioneTecnicoGestionale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/DataEspletamento&quot;>&#xa;                                &lt;DataEspletamento>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/DataEspletamento&quot;/>&#xa;                                &lt;/DataEspletamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/OrarioDataEspletamento&quot;>&#xa;                                &lt;OrarioDataEspletamento>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/OrarioDataEspletamento&quot;/>&#xa;                                &lt;/OrarioDataEspletamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ParseXml/NotificaSLU[1]/StatoAvanzamento/Rifiuto)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Rifiuto&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;exists($ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente)&quot;>&#xa;                                &lt;Referente>&#xa;                                    &lt;QualificaRef>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/QualificaRef&quot;/>&#xa;                                    &lt;/QualificaRef>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:C