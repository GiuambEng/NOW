                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NumeriTelefonici>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseXml/NotificaULL[1]/TentativiContatto) or&amp;#xD;&amp;#xA;exists($ParseXml/NotificaSLU[1]/TentativiContatto) or&amp;#xD;&amp;#xA;exists($ParseXml/NotificaWLR[1]/TentativiContatto)&quot;>&#xa;                    &lt;xsl:if test=&quot;contains(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;TelefonoFissoReferente>') or contains(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;TelefonoMobileReferente>')&quot;>&#xa;                        &lt;tns:NumeriTelefonici>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/TelefonoFissoReferente>'),'&amp;lt;TelefonoFissoReferente>'))>0&quot;>&#xa;                                    &lt;tns:TelefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/TelefonoFissoReferente>'),'&amp;lt;TelefonoFissoReferente>')&quot;/>&#xa;                                    &lt;/tns:TelefonoFissoReferente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/TelefonoMobileReferente>'),'&amp;lt;TelefonoMobileReferente>'))>0&quot;>&#xa;                                    &lt;tns:TelefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/TelefonoMobileReferente>'),'&amp;lt;TelefonoMobileReferente>')&quot;/>&#xa;                                    &lt;/tns:TelefonoMobileReferente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/NomeReferente>'),'&amp;lt;NomeReferente>'))>0&quot;>&#xa;                                    &lt;tns:NomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/NomeReferente>'),'&amp;lt;NomeReferente>')&quot;/>&#xa;                                    &lt;/tns:NomeReferente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/CognomeReferente>'),'&amp;lt;CognomeReferente>'))>0&quot;>&#xa;                                    &lt;tns:CognomeReferente>&#xa;                                        &lt;xsl:value-of select=&quot;substring-after(substring-before(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[1],'&amp;lt;/CognomeReferente>'),'&amp;lt;CognomeReferente>')&quot;/>&#xa;                                    &lt;/tns:CognomeReferente>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns:NumeriTelefonici>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;contains(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/TentativiContatto>'),'&amp;lt;TentativiContatto>'), '&amp;lt;OraContattoCliente>')[2],'&amp;lt;TelefonoFissoReferente>') or contains(tokenize(substring-after(substring-before($JDBCQuery/Record[1]/TRACCIATO_FILE, '&amp;lt;/Tentat