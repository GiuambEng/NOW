                                    expression="exists($ParseXml/NotificaULL/DataAppuntamento) or exists($ParseXml/NotificaULL/TentativiContatto) or exists($ParseXml/NotificaSLU/DataAppuntamento) or exists($ParseXml/NotificaSLU/TentativiContatto) or exists($ParseXml/NotificaWLR/Accettazione) or exists($ParseXml/NotificaWLR/StatoAvanzamento) or exists($ParseXml/NotificaWLR/DataAppuntamento) or exists($ParseXml/NotificaWLR/TentativiContatto) or exists($ParseXml/NotificaULL/Accettazione) or exists($ParseXml/NotificaULL/StatoAvanzamento) or exists($ParseXml/NotificaSLU/Accettazione) or exists($ParseXml/NotificaSLU/StatoAvanzamento)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
