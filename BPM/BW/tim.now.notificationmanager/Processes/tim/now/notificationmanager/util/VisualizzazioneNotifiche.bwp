eferente>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente&quot;>&#xa;                                                &lt;TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/Progressivo&quot;>&#xa;                                        &lt;Progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/Referente/Progressivo&quot;/>&#xa;                                        &lt;/Progressivo>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/Referente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:for-each select=&quot;$ParseXml/NotificaWLR[1]/StatoAvanzamento/NumerazioneAggiuntiva&quot;>&#xa;                                &lt;NumerazioneAggiuntiva>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/NumerazioneAggiuntiva>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/StatoAvanzamento>&#xa;                    &lt;/NotificaWLR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NotificaWLR>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseXml/NotificaWLR/TestataNotifica&quot;/>&#xa;                        &lt;DataAppuntamento>&#xa;                            &lt;NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/NuovaDA&quot;/>&#xa;                            &lt;/NuovaDA>&#xa;                            &lt;OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/OraAppuntamento&quot;/>&#xa;                            &lt;/OraAppuntamento>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:CognomeRagioneSociale)>0&quot;>&#xa;                                    &lt;ReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:CognomeRagioneSociale&quot;/>&#xa;                                    &lt;/ReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/ReferenteContattato&quot;/>&#xa;                                    &lt;/ReferenteContattato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente)>0 and string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT)>0&quot;>&#xa;                                    &lt;TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente&quot;/>&#xa;                                    &lt;/TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente)>0&quot;>&#xa;                                    &lt;TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente&quot;/>&#xa;                                    &lt;/TelefonoReferenteContattato>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;TelefonoReferenteContattato>&#xa;                                        &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT&quot;/>&#xa;                                    &lt;/TelefonoReferenteContattato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/DataContatto&quot;/>&#xa;                            &lt;/DataContatto>&#xa;                            &lt;OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/OraContatto&quot;/>&#xa;                            &lt;/OraContatto>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/TipoAppuntamento&quot;>&#xa;                                &lt;TipoAppuntamento>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/TipoAppuntamento&quot;/>&#xa;                                &lt;/TipoAppuntamento>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/Progressivo&quot;>&#xa;                                &lt;Progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXml/NotificaWLR[1]/DataAppuntamento/Progressivo&quot;/>&#xa;                                &lt;/Progressivo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/DataAppuntamento>&#xa;                    &lt;/NotificaWLR>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/NotificaOloRegolatorio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
