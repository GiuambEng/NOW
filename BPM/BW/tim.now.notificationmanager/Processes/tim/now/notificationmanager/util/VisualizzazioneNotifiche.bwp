                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseNPG_Risp&quot;/>&#xa;    &lt;xsl:param name=&quot;TokenNPG_Risp&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper11-input&quot; match=&quot;/&quot;>&#xa;        &lt;Risposta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseNPG_Risp/Valid_Formale_DonorRecipient)&quot;>&#xa;                    &lt;Valid_Formale_DonorRecipient>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;DatiNotifica>&#xa;                            &lt;CodiceOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/CodiceOrdine&quot;/>&#xa;                            &lt;/CodiceOrdine>&#xa;                            &lt;DataOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/DataOrdine&quot;/>&#xa;                            &lt;/DataOrdine>&#xa;                            &lt;DirectoryNumber>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/DirectoryNumber&quot;/>&#xa;                            &lt;/DirectoryNumber>&#xa;                            &lt;IdentificativoOperatoreDonor>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/IdentificativoOperatoreDonor&quot;/>&#xa;                            &lt;/IdentificativoOperatoreDonor>&#xa;                            &lt;DataInvioMessaggio>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/DataInvioMessaggio&quot;/>&#xa;                            &lt;/DataInvioMessaggio>&#xa;                            &lt;xsl:if test=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;CodiceOpRecipient>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/CodiceOpRecipient&quot;/>&#xa;                            &lt;/CodiceOpRecipient>&#xa;                            &lt;CodiceSegreto>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/CodiceSegreto&quot;/>&#xa;                            &lt;/CodiceSegreto>&#xa;                            &lt;xsl:if test=&quot;exists($ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/TipoLinea)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/TipoLinea&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DataAttesaConsegnaServizio>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/DataAttesaConsegnaServizio&quot;/>&#xa;                            &lt;/DataAttesaConsegnaServizio>&#xa;                            &lt;CognomeCliente_RagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$TokenNPG_Risp/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale&quot;/>&#xa;                            &lt;/CognomeCliente_RagioneSociale>&#xa;                            &lt;xsl:if test=&quot;$TokenNPG_Risp/tns1:ResponseDecode_token/tns1:Nome&quot;>&#xa;                                &lt;NomeCliente>&#xa;                                    &lt;xsl:value-of select=&quot;$TokenNPG_Risp/tns1:ResponseDecode_token/tns1:Nome&quot;/>&#xa;                                &lt;/NomeCliente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/CodiceProgetto&quot;>&#xa;                                &lt;CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/CodiceProgetto&quot;/>&#xa;                                &lt;/CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;EmailReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/EmailReferenteRichiedente&quot;/>&#xa;                            &lt;/EmailReferenteRichiedente>&#xa;                            &lt;TelefonoReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/TelefonoReferenteRichiedente&quot;/>&#xa;                            &lt;/TelefonoReferenteRichiedente>&#xa;                            &lt;xsl:if test=&quot;exists($ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/Correlazioni)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/DatiNotifica/Correlazioni&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/DatiNotifica>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Formale_DonorRecipient/EsitoVerifica&quot;/>&#xa;                    &lt;/Valid_Formale_DonorRecipient>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseNPG_Risp/Valid_Formale_Donating_Donor)&quot;>&#xa;                    &lt;Valid_Formale_Donating_Donor>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;DatiNotifica>&#xa;                            &lt;CodiceOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/CodiceOrdine&quot;/>&#xa;                            &lt;/CodiceOrdine>&#xa;                            &lt;DataOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/DataOrdine&quot;/>&#xa;                            &lt;/DataOrdine>&#xa;                            &lt;DirectoryNumber>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/DirectoryNumber&quot;/>&#xa;                            &lt;/DirectoryNumber>&#xa;                            &lt;IdentificativoOperatoreDonor>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/IdentificativoOperatoreDonor&quot;/>&#xa;                            &lt;/IdentificativoOperatoreDonor>&#xa;                            &lt;DataInvioMessaggio>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/DataInvioMessaggio&quot;/>&#xa;                            &lt;/DataInvioMessaggio>&#xa;                            &lt;xsl:if test=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;CodiceOpRecipient>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/CodiceOpRecipient&quot;/>&#xa;                            &lt;/CodiceOpRecipient>&#xa;                            &lt;CodiceSegreto>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/CodiceSegreto&quot;/>&#xa;                            &lt;/CodiceSegreto>&#xa;                            &lt;xsl:if test=&quot;exists($ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/TipoLinea)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/TipoLinea&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;DataAttesaConsegnaServizio>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/DataAttesaConsegnaServizio&quot;/>&#xa;                            &lt;/DataAttesaConsegnaServizio>&#xa;                            &lt;CognomeCliente_RagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$TokenNPG_Risp/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale&quot;/>&#xa;                            &lt;/CognomeCliente_RagioneSociale>&#xa;                            &lt;xsl:if test=&quot;$TokenNPG_Risp/tns1:ResponseDecode_token/tns1:Nome&quot;>&#xa;                                &lt;NomeCliente>&#xa;                                    &lt;xsl:value-of select=&quot;$TokenNPG_Risp/tns1:ResponseDecode_token/tns1:Nome&quot;/>&#xa;                                &lt;/NomeCliente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/CodiceProgetto&quot;>&#xa;                                &lt;CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/CodiceProgetto&quot;/>&#xa;                                &lt;/CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;EmailReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/EmailReferenteRichiedente&quot;/>&#xa;                            &lt;/EmailReferenteRichiedente>&#xa;                            &lt;TelefonoReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/TelefonoReferenteRichiedente&quot;/>&#xa;                            &lt;/TelefonoReferenteRichiedente>&#xa;                            &lt;xsl:if test=&quot;exists($ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/Correlazioni)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/DatiNotifica/Correlazioni&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/DatiNotifica>&#xa;                        &lt;IdentificativoOperatoreDonating>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/IdentificativoOperatoreDonating&quot;/>&#xa;                        &lt;/IdentificativoOperatoreDonating>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Formale_Donating_Donor/EsitoVerifica&quot;/>&#xa;                    &lt;/Valid_Formale_Donating_Donor>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseNPG_Risp/Valid_Tecnica_Donating_Donor)&quot;>&#xa;                    &lt;Valid_Tecnica_Donating_Donor>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;DatiNotifica>&#xa;                            &lt;CodiceOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/CodiceOrdine&quot;/>&#xa;                            &lt;/CodiceOrdine>&#xa;                            &lt;DataOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/DataOrdine&quot;/>&#xa;                            &lt;/DataOrdine>&#xa;                            &lt;DirectoryNumber>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/DirectoryNumber&quot;/>&#xa;                            &lt;/DirectoryNumber>&#xa;                            &lt;IdentificativoOperatoreDonor>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/IdentificativoOperatoreDonor&quot;/>&#xa;                            &lt;/IdentificativoOperatoreDonor>&#xa;                            &lt;DataInvioMessaggio>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/DataInvioMessaggio&quot;/>&#xa;                            &lt;/DataInvioMessaggio>&#xa;                            &lt;xsl:if test=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#x