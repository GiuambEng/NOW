                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper10ToCopy_4_GenericLogger16"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseNPG_Rich&quot;/>&#xa;    &lt;xsl:param name=&quot;TokenNPG_Rich&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper10-input&quot; match=&quot;/&quot;>&#xa;        &lt;Richiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseNPG_Rich/Portin)&quot;>&#xa;                    &lt;Portin>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;CodiceOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/CodiceOrdine&quot;/>&#xa;                        &lt;/CodiceOrdine>&#xa;                        &lt;DataOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/DataOrdine&quot;/>&#xa;                        &lt;/DataOrdine>&#xa;                        &lt;DirectoryNumber>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/DirectoryNumber&quot;/>&#xa;                        &lt;/DirectoryNumber>&#xa;                        &lt;xsl:if test=&quot;$ParseNPG_Rich/Portin/TipoLinea&quot;>&#xa;                            &lt;TipoLinea>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/TipoLinea&quot;/>&#xa;                            &lt;/TipoLinea>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$ParseNPG_Rich/Portin/Note&quot;>&#xa;                            &lt;Note>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/Note&quot;/>&#xa;                            &lt;/Note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/DataInvioMessaggio&quot;/>&#xa;                        &lt;/DataInvioMessaggio>&#xa;                        &lt;IdentificativoOperatoreDonor>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/IdentificativoOperatoreDonor&quot;/>&#xa;                        &lt;/IdentificativoOperatoreDonor>&#xa;                        &lt;xsl:if test=&quot;$TokenNPG_Rich/tns1:ResponseDecode_token/tns1:Nome&quot;>&#xa;                            &lt;NomeCliente>&#xa;                                &lt;xsl:value-of select=&quot;$TokenNPG_Rich/tns1:ResponseDecode_token/tns1:Nome&quot;/>&#xa;                            &lt;/NomeCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CognomeCliente_RagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$TokenNPG_Rich/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/CognomeCliente_RagioneSociale>&#xa;                        &lt;TelefonoReferenteRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/TelefonoReferenteRichiedente&quot;/>&#xa;                        &lt;/TelefonoReferenteRichiedente>&#xa;                        &lt;EmailReferenteRichiedente>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/EmailReferenteRichiedente&quot;/>&#xa;                        &lt;/EmailReferenteRichiedente>&#xa;                        &lt;xsl:if test=&quot;exists($ParseNPG_Rich/Portin/Correlazioni)&quot;>&#xa;                            &lt;Correlazioni>&#xa;                                &lt;IdentificativoCorrelazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseNPG_Rich/Portin/Correlazioni/Iden