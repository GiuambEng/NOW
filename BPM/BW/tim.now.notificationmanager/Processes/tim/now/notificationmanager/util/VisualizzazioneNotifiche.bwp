                                <tibex:activityExtension
                                    inputVariable="JDBCQuery4-input"
                                    name="JDBCQuery4"
                                    outputVariable="JDBCQuery4"
                                    tibex:xpdlId="8ef375a3-a119-4000-83a2-95743451113b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Copy_2_GenericLogger16ToJDBCQuery4"/>
                                    <bpws:target linkName="Copy_1_GenericLogger16ToJDBCQuery4"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery4ToTokenNPG_Rich">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VisualizzazioneNotificheOperationIn/Input/tns:Request/tns:DatiNotifiche[$index]/tns:isOLO=false() and &#xd;&#xa;(contains($ParseNPG_Rich/Portin/NomeCliente,'dk') or &#xd;&#xa;contains($ParseNPG_Rich/Portin/CognomeCliente_RagioneSociale,'dk') or &#xd;&#xa;contains($ParseNPG_Rich/Prenotifica_Donating/NomeCliente,'dk') or &#xd;&#xa;contains($ParseNPG_Rich/Prenotifica_Donating/CognomeCliente_RagioneSociale,'dk') or &#xd;&#xa;contains($ParseNPG_Rich/Cessazione/Rientro/NomeCliente,'dk') or &#xd;&#xa;contains($ParseNPG_Rich/Cessazione/Rientro/CognomeCliente_RagioneSociale,'dk') or &#xd;&#xa;contains($ParseNPG_Rich/Annullamento/NomeCliente,'dk') or &#xd;&#xa;contains($ParseNPG_Rich/Annullamento/CognomeCliente_RagioneSociale,'dk'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VisualizzazioneNotificheOperationIn.Input/tns:DatiNotifiche[$index]/tns:isOLO=false() and 
(contains($ParseNPG_Rich/Portin/NomeCliente,'dk') or 
contains($ParseNPG_Rich/Portin/CognomeCliente_RagioneSociale,'dk') or 
contains($ParseNPG_Rich/Prenotifica_Donating/NomeCliente,'dk') or 
contains($ParseNPG_Rich/Prenotifica_Donating/CognomeCliente_RagioneSociale,'dk') or 
contains($ParseNPG_Rich/Cessazione/Rientro/NomeCliente,'dk') or 
contains($ParseNPG_Rich/Cessazione/Rientro/CognomeCliente_RagioneSociale,'dk') or 
contains($ParseNPG_Rich/Annullamento/NomeCliente,'dk') or 
contains($ParseNPG_Rich/Annullamento/CognomeCliente_RagioneSociale,'dk'))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBCQuery4ToTokenNPG_Risp">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8ef375a3-a119-4000-83a2-95743451113b+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;JDBCQuery4-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/ID_RICH_OLO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/ID_RICH_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDRICHIESTAOLO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICEORDINEOLO&#xa;FROM BDS_1_CASEDATA_RICHIESTA &#xa;WHERE IDRICHIESTAOLO=?&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <columnMetadata
                                    columnName="CODICEORDINEOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
