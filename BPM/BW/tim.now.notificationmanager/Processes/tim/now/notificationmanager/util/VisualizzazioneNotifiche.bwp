                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(contains($Mapper7/ns10:NumeriTelefonici[$index1]/ns10:TelefonoFissoReferente,'kk') or contains($Mapper7/ns10:NumeriTelefonici[$index1]/ns10:TelefonoMobileReferente,'kk'))
