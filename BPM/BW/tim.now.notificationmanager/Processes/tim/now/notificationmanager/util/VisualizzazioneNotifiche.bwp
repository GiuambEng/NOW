                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;VisualizzazioneNotificheOperationIn&quot;/>&lt;xsl:template name=&quot;Token1-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:RequestDecode_token>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery1/Record[1]/CODICEORDINEOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/CODICEORDINEOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;/>&lt;/tns:Funzione>&lt;/xsl:if>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($JDBCQuery1/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&lt;/tns:ChiaveRiferimento>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;/>&lt;/tns:Operatore>&lt;/xsl:if>&lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn/Input/tns3:Request/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'kk')&quot;>&lt;xsl:if test=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;>&lt;tns:Token>&lt;xsl:value-of select=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;/>&lt;/tns:Token>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RequestDecode_token>&lt;tns:ProcessIstance>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:ProcessIstance>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>"
