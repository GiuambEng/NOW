                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOperationIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:RequestDecode_token>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery1/Record[1]/CODICEORDINEOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns1:DatiNotifiche[$index]/tns1:FunzioneChiamante&quot;>&#xa;                    &lt;tns:Funzione>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns1:DatiNotifiche[$index]/tns1:FunzioneChiamante&quot;/>&#xa;                    &lt;/tns:Funzione>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($JDBCQuery1/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns:ChiaveRiferimento>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns1:DatiNotifiche[$index]/tns1:Operatore&quot;>&#xa;                    &lt;tns:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns1:DatiNotifiche[$index]/tns1:Operatore&quot;/>&#xa;                    &lt;/tns:Operatore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns1:DatiNotifiche[$index]/tns1:IPClient&quot;>&#xa;                    &lt;tns:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns1:DatiNotifiche[$index]/tns1:IPClient&quot;/>&#xa;                    &lt;/tns:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/TelefonoMobileReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/TelefonoMobileReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/TelefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/TelefonoFissoReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;            