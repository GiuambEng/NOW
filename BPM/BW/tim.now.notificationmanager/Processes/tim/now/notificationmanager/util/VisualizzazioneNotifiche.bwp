                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOperationIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Token1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:RequestDecode_token>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery1/Record[1]/CODICEORDINEOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;>&#xa;                    &lt;tns:Funzione>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;/>&#xa;                    &lt;/tns:Funzione>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($JDBCQuery1/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns:ChiaveRiferimento>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;>&#xa;                    &lt;tns:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;/>&#xa;                    &lt;/tns:Operatore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;>&#xa;                    &lt;tns:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;/>&#xa;                    &lt;/tns:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'kk')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:RequestDecode_token>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
