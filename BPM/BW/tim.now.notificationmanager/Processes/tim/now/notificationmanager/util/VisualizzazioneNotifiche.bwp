                            <bpws:scope name="While1"
                                tibex:group="while" tibex:xpdlId="cc70b72a-598d-4cc4-bbb7-8f6eab6b5089">
                                <bpws:targets>
                                    <bpws:target linkName="GenericLogger5ToWhile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="While1ToMapper2"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence1" tibex:group="while">
                                    <bpws:assign name="GroupInit1"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+cbd6a328-3104-4c41-adc4-377dda25827a" version="2.0"> <xsl:template name="Accumulate1" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate1"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while1" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($Mapper/ns10:NumeriTelefonici)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($Mapper/ns10:NumeriTelefonici)]]></bpws:condition>
                                    <bpws:flow name="flow3">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToToken1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Token1ToMapper3" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Mapper3ToGenericLogger7" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GenericLogger7ToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToMapper3" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Token1ToGenericLogger8" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="GenericLogger8ToMapper3" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="3743ba81-0757-47ce-83e3-2413829c30e3" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToToken1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="(contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoFissoReferente,'kk') or contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoMobileReferente,'kk'))&#xd;&#xa;or&#xd;&#xa;(contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoFissoReferente,'dk') or contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoMobileReferente,'dk') and $VisualizzazioneNotificheOperationIn/Input/tns:Request/tns:DatiNotifiche[$index]/tns:isOLO=false())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoFissoReferente,'kk') or contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoMobileReferente,'kk'))
or
(contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoFissoReferente,'dk') or contains($Mapper/ns10:NumeriTelefonici[$index]/ns10:TelefonoMobileReferente,'dk') and $VisualizzazioneNotificheOperationIn.Input/tns:DatiNotifiche[$index]/tns:isOLO=false())]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToMapper3">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="Token1"/>
                                    <bpws:to variable="Token1"/>
                                    </bpws:copy>
