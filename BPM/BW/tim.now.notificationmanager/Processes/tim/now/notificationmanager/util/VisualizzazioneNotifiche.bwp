                                    <bpws:sources>
                                    <bpws:source linkName="Token2ToMapper5"/>
                                    <bpws:source
                                    linkName="Token2ToGenericLogger12"
                                    tibex:faultDetailsVar="Token2" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>

                                    <tibex:expression
