                                    sqlStatement="SELECT COD_TIPOLG_NOTF, ID_NOTF, ID_RICH_OLO, STRUTTURA_RICH, TIMSTP_CREAZIONE, TRACCIATO_FILE, CODFC_OLO_NOW, CODFC_OLO_AGCOM, NGA_GPON&#xa;  FROM RICH_ORDN_COMUNIC_NOTF&#xa;  WHERE ID_NOTF=? " xsi:type="jdbcPalette:JDBCQueryActivity">

