                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VisualizzazioneNotificheOperationIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery2&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper4&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Token2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:RequestDecode_token>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery2/Record[1]/CODICEORDINEOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery2/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;>&#xa;                    &lt;tns:Funzione>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:FunzioneChiamante&quot;/>&#xa;                    &lt;/tns:Funzione>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($JDBCQuery2/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns:ChiaveRiferimento>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;>&#xa;                    &lt;tns:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:Operatore&quot;/>&#xa;                    &lt;/tns:Operatore>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;>&#xa;                    &lt;tns:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$VisualizzazioneNotificheOperationIn.Input/tns3:DatiNotifiche[$index]/tns3:IPClient&quot;/>&#xa;                    &lt;/tns:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente,'kk'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente,'dk'))&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:CognomeReferente&quot;/>&#xa;                            &lt;/tns:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente,'kk'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente,'dk'))&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:NomeReferente&quot;/>&#xa;                            &lt;/tns:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'kk'))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;(string-length($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente)>0 and contains($Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente,'dk'))&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper4/tns1:NumeriTelefonici[$index1]/tns1:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:RequestDecode_token>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.notificationmanager.util.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Mapper5-input"
                                    name="Mapper5"
                                    outputVariable="Mapper5"
                                    tibex:xpdlId="8adcc07c-bda4-49b8-9d05-a140c182f674" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token2ToMapper5"/>
                                    <bpws:target linkName="GenericLogger12ToMapper5"/>
                                    <bpws:target linkName="GroupStart2ToMapper5"/>
