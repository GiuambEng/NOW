            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="fe9b1394-1c5f-478e-a6dc-b0b6af847a75">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="GenericLogger2ToReply" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="GenericLogger2-input"
                                name="GenericLogger2"
                                tibex:xpdlId="8338f711-6f5a-40f5-8ef3-6da2083214ad"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="GenericLogger2ToReply"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VisualizzazioneNotifiche&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;VisualizzazioneNotifichePortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VisualizzazioneNotificheOperation&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName, $FaultDetails/Msg,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/MsgCode,$FaultDetails/Class)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:reply faultName="fault" name="Reply"
                            operation="VisualizzazioneNotificheOperation"
                            partnerLink="VisualizzazioneNotifichePortType"
                            portType="ns1:VisualizzazioneNotifichePortType"
                            tibex:xpdlId="1d3f6e8e-503a-4d47-b7c6-31a63ceface8" variable="Reply-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/VisualizzazioneNotifiche/" xmlns:tns1="http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:VisualizzazioneNotificheOperationFault&gt;&lt;Fault&gt;&lt;tns1:Fault&gt;&lt;tns1:Msg&gt;&lt;xsl:value-of select="concat($FaultDetails/ActivityName, $FaultDetails/Msg,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/MsgCode,$FaultDetails/Class)"/&gt;&lt;/tns1:Msg&gt;&lt;tns1:MsgCode&gt;&lt;xsl:value-of select="concat($FaultDetails/ActivityName, $FaultDetails/Msg,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/MsgCode,$FaultDetails/Class)"/&gt;&lt;/tns1:MsgCode&gt;&lt;/tns1:Fault&gt;&lt;/Fault&gt;&lt;/tns:VisualizzazioneNotificheOperationFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/VisualizzazioneNotifiche/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VisualizzazioneNotifiche/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Fault>&#xa;            &lt;tns1:Msg>&#xa;                &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName, $FaultDetails/Msg,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/MsgCode,$FaultDetails/Class)&quot;/>&#xa;            &lt;/tns1:Msg>&#xa;            &lt;tns1:MsgCode>&#xa;                &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName, $FaultDetails/Msg,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/MsgCode,$FaultDetails/Class)&quot;/>&#xa;            &lt;/tns1:MsgCode>&#xa;        &lt;/tns1:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="GenericLogger2ToReply"/>
                            </bpws:targets>
                        </bpws:reply>
                    </bpws:flow>
