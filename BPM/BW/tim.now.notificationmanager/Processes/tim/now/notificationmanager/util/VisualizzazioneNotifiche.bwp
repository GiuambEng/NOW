             &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/CodiceProgetto&quot;/>&#xa;                                &lt;/CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;EmailReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/EmailReferenteRichiedente&quot;/>&#xa;                            &lt;/EmailReferenteRichiedente>&#xa;                            &lt;TelefonoReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/TelefonoReferenteRichiedente&quot;/>&#xa;                            &lt;/TelefonoReferenteRichiedente>&#xa;                            &lt;xsl:if test=&quot;exists($ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/Correlazioni)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/DatiNotifica/Correlazioni&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/DatiNotifica>&#xa;                        &lt;IdentificativoOperatoreDonating>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/IdentificativoOperatoreDonating&quot;/>&#xa;                        &lt;/IdentificativoOperatoreDonating>&#xa;                        &lt;xsl:copy-of select=&quot;$ParseNPG_Risp/Valid_Tecnica_Donating_Donor/EsitoVerifica&quot;/>&#xa;                    &lt;/Valid_Tecnica_Donating_Donor>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseNPG_Risp/Com_Esito_Donor_Recipient)&quot;>&#xa;                    &lt;Com_Esito_Donor_Recipient>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$ParseNPG_Risp/Com_Esito_Donor_Recipient/TipoComunicazione&quo