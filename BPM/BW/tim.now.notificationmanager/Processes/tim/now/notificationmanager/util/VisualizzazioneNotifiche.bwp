_token/tns:N_Recap_Cliente&quot;/>&#xa;                                                &lt;/TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT&quot;>&#xa;                                                &lt;TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$Token/tns:ResponseDecode_token/tns:N_Recap_Cliente_ALT&quot;/>&#xa;                                                &lt;/TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/Progressivo&quot;>&#xa;                                        &lt;Progressivo>&#xa;                                            &lt;xsl:value-of select=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/Referente/Progressivo&quot;/>&#xa;                                        &lt;/Progressivo>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/Referente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXml/NotificaSLU[1]/StatoAvanzamento/BitRate&quot;>&#xa;                                &lt;BitRate>&#xa;                                