                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;Token1&quot;/>&lt;xsl:template name=&quot;Mapper3-input&quot; match=&quot;/&quot;>&lt;tns:NumeriTelefonici>&lt;tns:NumeriTelefonici>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Token1/tns1:ResponseDecode_token/tns1:N_Recap_Cliente)>0&quot;>&lt;xsl:if test=&quot;$Token1/tns1:ResponseDecode_token/tns1:N_Recap_Cliente&quot;>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Token1/tns1:ResponseDecode_token/tns1:N_Recap_Cliente&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:TelefonoFissoReferente&quot;>&lt;tns:TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:TelefonoFissoReferente&quot;/>&lt;/tns:TelefonoFissoReferente>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Token1/tns1:ResponseDecode_token/tns1:N_Recap_Cliente_ALT)>0&quot;>&lt;xsl:if test=&quot;$Token1/tns1:ResponseDecode_token/tns1:N_Recap_Cliente_ALT&quot;>&lt;tns:TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Token1/tns1:ResponseDecode_token/tns1:N_Recap_Cliente_ALT&quot;/>&lt;/tns:TelefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:TelefonoMobileReferente&quot;>&lt;tns:TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:TelefonoMobileReferente&quot;/>&lt;/tns:TelefonoMobileReferente>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Token1/tns1:ResponseDecode_token/tns1:Nome)>0&quot;>&lt;xsl:if test=&quot;$Token1/tns1:ResponseDecode_token/tns1:Nome&quot;>&lt;tns:NomeReferente>&lt;xsl:value-of select=&quot;$Token1/tns1:ResponseDecode_token/tns1:Nome&quot;/>&lt;/tns:NomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:NomeReferente&quot;>&lt;tns:NomeReferente>&lt;xsl:value-of select=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:NomeReferente&quot;/>&lt;/tns:NomeReferente>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Token1/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale)>0&quot;>&lt;xsl:if test=&quot;$Token1/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale&quot;>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$Token1/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:CognomeReferente&quot;>&lt;tns:CognomeReferente>&lt;xsl:value-of select=&quot;$Mapper/tns:NumeriTelefonici[$index1]/tns:CognomeReferente&quot;/>&lt;/tns:CognomeReferente>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:NumeriTelefonici>&lt;/tns:NumeriTelefonici>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
