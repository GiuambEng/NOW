            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper-input"
                    name="Mapper" outputVariable="Mapper"
                    tibex:xpdlId="61d12b2a-d6a1-4d41-bbdd-907d7c0624a6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="__Link5"/>
                        <bpws:target linkName="__Link7"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="__Link"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1672651479977&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_DATI_VERIFICA_CTRL&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_NORM_DONATING&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_NORM_DONOR&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:JDBCQueryResponse>&lt;tns:Group1>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/tns:DataInvioMessaggio>&lt;/tns:Group1>&lt;tns:Group2>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceOpRecipient>&amp;quot;)) > 0&quot;>&lt;tns:CodiceOLORecipient>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceOpRecipient>&amp;quot;)&quot;/>&lt;/tns:CodiceOLORecipient>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/CodiceOpRecipient>&amp;quot;)) > 0&quot;>&lt;tns:CodiceOLORecipient>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/CodiceOpRecipient>&amp;quot;)&quot;/>&lt;/tns:CodiceOLORecipient>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceSegreto>&amp;quot;)) > 0&quot;>&lt;tns:CodiceSegreto>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceSegreto>&amp;quot;)&quot;/>&lt;/tns:CodiceSegreto>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/CodiceSegreto>&amp;quot;)) > 0&quot;>&lt;tns:CodiceSegreto>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/CodiceSegreto>&amp;quot;)&quot;/>&lt;/tns:CodiceSegreto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/DataAttesaConsegnaServizio>&amp;quot;)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/DataAttesaConsegnaServizio>&amp;quot;))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataAttesaConsegnaServizio>&amp;quot;)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataAttesaConsegnaServizio>&amp;quot;))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns2:CognomeRagioneSociale) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns2:CognomeRagioneSociale&quot;>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$Start/tns2:CognomeRagioneSociale&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns2:Nome) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns2:Nome&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$Start/tns2:Nome&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:TelefonoReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:TelefonoReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/TelefonoReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/TelefonoReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:EmailReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:EmailReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/EmailReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/EmailReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Group2>&lt;tns:Group3>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_DATI_VERIFICA_CTRL/Record[NOME = &amp;quot;NUMEROTELEFONICO&amp;quot;]) or string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:RientroTI>&amp;quot;), &amp;quot;&amp;lt;/ns:RientroTI>&amp;quot;)) > 0&quot;>&lt;tns:Telecom>&lt;tns:Rientro>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:RientroTI>&amp;quot;), &amp;quot;&amp;lt;/ns:RientroTI>&amp;quot;)) > 0&quot;>&lt;tns:RientroTI>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:RientroTI>&amp;quot;), &amp;quot;&amp;lt;/ns:RientroTI>&amp;quot;)&quot;/>&lt;/tns:RientroTI>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataAttesaConsegnaServizio>&amp;quot;)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataAttesaConsegnaServizio>&amp;quot;))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns2:CognomeRagioneSociale) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns2:CognomeRagioneSociale&quot;>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$Start/tns2:CognomeRagioneSociale&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns2:Nome) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns2:Nome&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$Start/tns2:Nome&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:TelefonoReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:TelefonoReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:EmailReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:EmailReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;/xsl:if>&lt;/tns:Rientro>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:NumAggiuntivi)&quot;>&lt;tns:NPAggiuntive>&lt;xsl:for-each select=&quot;$Start/tns2:NumAggiuntivi&quot;>&lt;tns:NumAggiuntivaPortata>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:NumAggiuntivaPortata>&lt;/xsl:for-each>&lt;/tns:NPAggiuntive>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Telecom>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($JDBC_DATI_VERIFICA_CTRL/Record[NOME = &amp;quot;NUMEROTELEFONICO&amp;quot;]) or string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;RientroTI>&amp;quot;), &amp;quot;&amp;lt;/RientroTI>&amp;quot;)) > 0&quot;>&lt;tns:Telecom>&lt;tns:Rientro>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;RientroTI>&amp;quot;), &amp;quot;&amp;lt;/RientroTI>&amp;quot;)) > 0&quot;>&lt;tns:RientroTI>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;RientroTI>&amp;quot;), &amp;quot;&amp;lt;/RientroTI>&amp;quot;)&quot;/>&lt;/tns:RientroTI>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/DataAttesaConsegnaServizio>&amp;quot;)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/:DataAttesaConsegnaServizio>&amp;quot;))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns2:CognomeRagioneSociale) > 0&quot;>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;substring($Start/tns2:CognomeRagioneSociale, 1, 60)&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns2:Nome) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns2:Nome&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$Start/tns2:Nome&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/TelefonoReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/TelefonoReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/EmailReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/EmailReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;/xsl:if>&lt;/tns:Rientro>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:NumAggiuntivi)&quot;>&lt;tns:NPAggiuntive>&lt;xsl:for-each select=&quot;$Start/tns2:NumAggiuntivi&quot;>&lt;tns:NumAggiuntivaPortata>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:NumAggiuntivaPortata>&lt;/xsl:for-each>&lt;/tns:NPAggiuntive>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Telecom>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Group3>&lt;tns:DefTipoLinea>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:ISDN>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLineaID>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLineaID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:FlagNPNumerazioniAggiuntive>&amp;quot;), &amp;quot;&amp;lt;/ns:FlagNPNumerazioniAggiuntive>&amp;quot;)) > 0&quot;>&lt;tns:flagNPNumerazioniAggiuntive>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:FlagNPNumerazioniAggiuntive>&amp;quot;), &amp;quot;&amp;lt;/ns:FlagNPNumerazioniAggiuntive>&amp;quot;)&quot;/>&lt;/tns:flagNPNumerazioniAggiuntive>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:flagNPNumerazioniAggiuntive>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:flagNPNumerazioniAggiuntive>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:NumAggiuntivi)&quot;>&lt;tns:NumAggiuntiva>&lt;xsl:for-each select=&quot;$Start/tns2:NumAggiuntivi&quot;>&lt;tns:NumAggiuntivaPortata>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:NumAggiuntivaPortata>&lt;/xsl:for-each>&lt;/tns:NumAggiuntiva>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:ISDN>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:ISDN>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLineaID>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLineaID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;FlagNPNumerazioniAggiuntive>&amp;quot;), &amp;quot;&amp;lt;/FlagNPNumerazioniAggiuntive>&amp;quot;)) > 0&quot;>&lt;tns:flagNPNumerazioniAggiuntive>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;FlagNPNumerazioniAggiuntive>&amp;quot;), &amp;quot;&amp;lt;/FlagNPNumerazioniAggiuntive>&amp;quot;)&quot;/>&lt;/tns:flagNPNumerazioniAggiuntive>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:flagNPNumerazioniAggiuntive>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:flagNPNumerazioniAggiuntive>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:NumAggiuntivi)&quot;>&lt;tns:NumAggiuntiva>&lt;xsl:for-each select=&quot;$Start/tns2:NumAggiuntivi&quot;>&lt;tns:NumAggiuntivaPortata>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:NumAggiuntivaPortata>&lt;/xsl:for-each>&lt;/tns:NumAggiuntiva>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:ISDN>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:GNR>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLineaID>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLineaID>&lt;/xsl:if>&lt;/tns:GNR>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:GNR>&lt;xsl:if test=&quot;string-length(substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLineaID>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/tns2:contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLineaID>&lt;/xsl:if>&lt;/tns:GNR>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:DefTipoLinea>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_OLO_NORM_DONOR/Record)&quot;>&lt;xsl:if test=&quot;$JDBC_OLO_NORM_DONOR/Record[1]/CODFC_OLO_AGCOM_RICH&quot;>&lt;tns:CodificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$JDBC_OLO_NORM_DONOR/Record[1]/CODFC_OLO_AGCOM_RICH&quot;/>&lt;/tns:CodificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns2:CodOloAgcomDonor&quot;>&lt;tns:CodificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$Start/tns2:CodOloAgcomDonor&quot;/>&lt;/tns:CodificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_OLO_NORM_DONATING/Record)&quot;>&lt;xsl:if test=&quot;$JDBC_OLO_NORM_DONATING/Record[1]/CODFC_OLO_AGCOM_RICH&quot;>&lt;tns:CodificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$JDBC_OLO_NORM_DONATING/Record[1]/CODFC_OLO_AGCOM_RICH&quot;/>&lt;/tns:CodificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:tipologiaScenario = &amp;quot;NPSUWL