                            <bpws:transitionCondition><![CDATA[string-length($JDBCQueryIn.JDBCQueryInput/ns16:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOMDonor) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_JDBCToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
