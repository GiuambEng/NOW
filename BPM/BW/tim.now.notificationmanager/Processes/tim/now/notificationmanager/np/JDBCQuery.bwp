ichiesta/tipologiaScenario = &amp;quot;NPSUVULL&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;>&lt;tns:CodificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:CodificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo&quot;>&lt;tns:CodificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:CodificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOMDonating&quot;>&lt;tns:CodificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOMDonating&quot;/>&lt;/tns:CodificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOMDonating) > 0&quot;>&lt;xsl:if test=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOMDonating&quot;>&lt;tns:CodificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOMDonating&quot;/>&lt;/tns:CodificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and (IDDettaglioOrdine = IDDettaglioOrdineParent or string-length(string(IDDettaglioOrdineParent)) = 0 or attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICO&amp;quot;]/valoreAttributo = attributiDettaglioOrdine[nomeAttributo = &amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;]/valoreAttributo)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICEOPERATOREDONATING&amp;quot;]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot; and (IDDettag