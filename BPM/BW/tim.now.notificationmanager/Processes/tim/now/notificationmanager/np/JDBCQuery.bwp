                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.JDBCQueryInput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DATI_VERIFICA_CTRL&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO_NORM_DONATING&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO_NORM_DONOR&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:JDBCQueryResponse>&#xa;            &lt;tns:Group1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn.JDBCQueryInput/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/DataInvioMessaggio>&amp;quot;)) > 0&quot;>&#xa;                        &lt;tns:DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($JDBCQueryIn.JDBCQueryInput/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/DataInvioMessaggio>&amp;quot;))&quot;/>&#xa;                        &lt;/tns:DataInvioMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn.JDBCQueryInput/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataInvioMessaggio>&amp;quot;)) > 0&quot;>&#xa;                        &lt;tns:DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($JDBCQueryIn.JDBCQueryInput/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataInvioMessaggio>&amp;quot;))&quot;/>&#xa;                        &lt;/tns:DataInvioMessaggio>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&#xa;                        &lt;/tns:DataInvioMessaggio>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:Group1>&#xa;            &lt;tns:Group2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn.JDBCQueryInput/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceOpRecipient>&amp;quot;)) > 0&quot;>&#xa;                        &lt;tns:CodiceOLORecipient>&#xa;                            &lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn.JDBCQueryInput/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceOpRecipient>&amp;quot;)&quot;/>&#xa;                        &lt;/tns:CodiceOLORecipient>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn.JDBCQueryInput/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/CodiceOpRecipient>&amp;quot;)) > 0&quot;>&#xa;             