            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;JDBCQueryIn&quot;/>&lt;xsl:template name=&quot;LOG_Mapper-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Notification_np_JDBCQuery&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;JDBCQueryPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;JDBCQuery&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$JDBCQueryIn/JDBCQueryInput/tns1:JDBCQueryRequest/tns1:NotificaGenericaRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Mapper)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Dati in output: &amp;quot;, tib:render-xml($Mapper, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Non ci sono dati  per la struttura in output.&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Mapper-input" name="LOG_Mapper"
                    tibex:xpdlId="0571da5c-254c-4d19-9196-4e8d7667cf39"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToLOG_JDBC_Tipologia_AGGIUNTIVI_UNICA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBCQueryOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryIn.JDBCQueryInput&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_np_JDBCQuery&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQueryPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;JDBCQuery&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCQueryIn.JDBCQueryInput/tns1:NotificaGenericaRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper)&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Dati in output: &amp;quot;, tib:render-xml($Mapper, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono dati  per la struttura in output.&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_DATI_VERIFICA_CTRL&quot;/>&lt;xsl:param name=&quot;JDBCQueryIn&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_NORM_DONATING&quot;/>&lt;xsl:param name=&quot;JDBC_OLO_NORM_DONOR&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:JDBCQueryResponse>&lt;tns:Group1>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/DataInvioMessaggio>&amp;quot;)) > 0&quot;>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/DataInvioMessaggio>&amp;quot;))&quot;/>&lt;/tns:DataInvioMessaggio>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataInvioMessaggio>&amp;quot;)) > 0&quot;>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:DataInvioMessaggio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataInvioMessaggio>&amp;quot;))&quot;/>&lt;/tns:DataInvioMessaggio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/tns:DataInvioMessaggio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Group1>&lt;tns:Group2>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceOpRecipient>&amp;quot;)) > 0&quot;>&lt;tns:CodiceOLORecipient>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceOpRecipient>&amp;quot;)&quot;/>&lt;/tns:CodiceOLORecipient>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/CodiceOpRecipient>&amp;quot;)) > 0&quot;>&lt;tns:CodiceOLORecipient>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;CodiceOpRecipient>&amp;quot;), &amp;quot;&amp;lt;/CodiceOpRecipient>&amp;quot;)&quot;/>&lt;/tns:CodiceOLORecipient>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceSegreto>&amp;quot;)) > 0&quot;>&lt;tns:CodiceSegreto>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/ns:CodiceSegreto>&amp;quot;)&quot;/>&lt;/tns:CodiceSegreto>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/CodiceSegreto>&amp;quot;)) > 0&quot;>&lt;tns:CodiceSegreto>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;CodiceSegreto>&amp;quot;), &amp;quot;&amp;lt;/CodiceSegreto>&amp;quot;)&quot;/>&lt;/tns:CodiceSegreto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)) > 0&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/TipoLinea>&amp;quot;)&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/DataAttesaConsegnaServizio>&amp;quot;)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/DataAttesaConsegnaServizio>&amp;quot;))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataAttesaConsegnaServizio>&amp;quot;)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:DataAttesaConsegnaServizio>&amp;quot;), &amp;quot;&amp;lt;/ns:DataAttesaConsegnaServizio>&amp;quot;))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string(current-date()))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/cognomeRagioneSociale) > 0&quot;>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;substring($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/cognomeRagioneSociale, 1, 60)&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/nome) > 0&quot;>&lt;xsl:if test=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/nome&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/ordine/nome&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:TelefonoReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:TelefonoReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/TelefonoReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;TelefonoReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/TelefonoReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:EmailReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/ns:EmailReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/EmailReferenteRichiedente>&amp;quot;)) > 0&quot;>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;EmailReferenteRichiedente>&amp;quot;), &amp;quot;&amp;lt;/EmailReferenteRichiedente>&amp;quot;)&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Group2>&lt;tns:Group3>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(substring-before(substring-after($JDBCQueryIn/JDBCQueryInput/tns:JDBCQueryRequest/tns:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:T