                    <bpws:sources>
                        <bpws:source linkName="CallProcessToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($JDBCQueryIn/JDBCQueryInput/ns16:JDBCQueryRequest/ns16:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOMDonor) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
