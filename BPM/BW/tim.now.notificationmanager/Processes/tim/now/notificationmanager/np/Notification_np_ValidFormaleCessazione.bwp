                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/JDBCQuery/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeJDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:JDBCQueryRequest>&#xa;            &lt;tns2:NotificaGenericaRequest>&#xa;                &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/@*&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/node()&quot;/>&#xa;            &lt;/tns2:NotificaGenericaRequest>&#xa;        &lt;/tns2:JDBCQueryRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
