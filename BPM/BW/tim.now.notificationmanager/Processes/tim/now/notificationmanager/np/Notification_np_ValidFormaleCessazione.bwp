                <bpws:link name="LOG_ErrorIDCausaleToReply" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes"
                name="GenericNotificationIn"
                operation="GenericNotification"
                partnerLink="Notification_np_ValidFormaleCessazione"
                portType="ns2:Notification_np_ValidFormaleCessazione"
                tibex:xpdlId="4dc91d58-967c-40f3-a1ce-86ac117e4159" variable="GenericNotificationIn">
                <bpws:sources>
                    <bpws:source linkName="GenericNotificationInToInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GenericNotificationInToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/statoRichiestaOLO = &quot;SCARTATO&quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/statoRichiestaOLO = &quot;ANNULLATO&quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/statoRichiestaOLO = &quot;ESPLETAMENTOTECNICOKO&quot;) and string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/IDAnagraficaCausale)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/statoRichiestaOLO = "SCARTATO" or $GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/statoRichiestaOLO = "ANNULLATO" or $GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/statoRichiestaOLO = "ESPLETAMENTOTECNICOKO") and string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDAnagraficaCausale)) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GenericNotificationInToLOG_ErrorIDCausale">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/statoRichiestaOLO = &quot;SCARTATO&quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/statoRichiestaOLO = &quot;ANNULLATO&quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/statoRichiestaOLO = &quot;ESPLETAMENTOTECNICOKO&quot;) and string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns:NotificaGenericaRequest/tns:Richiesta/IDAnagraficaCausale)) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/statoRichiestaOLO = "SCARTATO" or $GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/statoRichiestaOLO = "ANNULLATO" or $GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/statoRichiestaOLO = "ESPLETAMENTOTECNICOKO") and string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDAnagraficaCausale)) = 0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="GenericNotificationOut"
                operation="GenericNotification"
                partnerLink="Notification_np_ValidFormaleCessazione"
                portType="ns2:Notification_np_ValidFormaleCessazione"
                tibex:xpdlId="03a2a9fe-aeb6-47a2-8581-ce1f7307528a" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns1="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns2="http://xsd.telecomitalia.it/crm/npr" version="2.0"&gt;&lt;xsl:param name="ValidFormaleCessazione_Mapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns:GenericNotificationResponse1&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns1:NotificaGenericaResponse&gt;&lt;tns2:Risposta&gt;&lt;xsl:copy-of select="$ValidFormaleCessazione_Mapper"/&gt;&lt;/tns2:Risposta&gt;&lt;/tns1:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns:GenericNotificationResponse1&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/npr&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ValidFormaleCessazione_Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificaGenericaResponse>&#xa;            &lt;tns2:Risposta>&#xa;                &lt;xsl:copy-of select=&quot;$ValidFormaleCessazione_Mapper&quot;/>&#xa;            &lt;/tns2:Risposta>&#xa;        &lt;/tns1:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="MapperToGenericNotificationOut"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npr&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;InvokeJDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:template name=&quot;ValidFormaleCessazione_Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Valid_Formale_Cessazione>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;12&quot;/>&lt;/tns:TipoComunicazione>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/tipologiaScenario = &amp;quot;NPSUTIF&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/tipologiaScenario = &amp;quot;NPDONOROLO&amp;quot;) and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaNOW = &amp;quot;INVERIFICADONATING&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineTI, 5)&quot;/>&lt;/tns:CodiceOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataOrdine>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/dataInvioRichiesta))&quot;/>&lt;/tns:DataOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:IdentificativoOperatoreDonor>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:CodificaOLOAGCOMDonor&quot;/>&lt;/tns:IdentificativoOperatoreDonor>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group1/tns2:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/note&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/note&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;tns:IdentificativoOperatoreDonating>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:CodificaOLOAGCOMDonating&quot;/>&lt;/tns:IdentificativoOperatoreDonating>&lt;xsl:choose>&lt;xsl:when test=&quot;(contains($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/contenutoXML,&amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;) and string-length(substring-before(substring-after($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) = 0) or (contains($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/contenutoXML,&amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;) and not(contains($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/contenutoXML,&amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;)))&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:TipoLinea='1' or $InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:TipoLinea='2'&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:TipoLinea='0' or $InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:TipoLinea='3'&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:TipoLinea&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:TipoLinea&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Telecom>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:RientroTI) > 0&quot;>&lt;tns:Rientro>&lt;tns:RientroTI>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:RientroTI&quot;/>&lt;/tns:RientroTI>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DACRimodulata)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DACRimodulata&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:DataAttesaConsegnaServizio&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:CognomeCliente_RagioneSociale&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;xsl:if test=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:NomeCliente&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:NomeCliente&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:TelefonoReferenteRichiedente&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:EmailReferenteRichiedente&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDCorrelazione) > 0 and string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/totaleRichiestePacchetto)) > 0&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDCorrelazione&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/totaleRichiestePacchetto&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Rientro>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive)&quot;>&lt;tns:NPAggiuntive>&lt;xsl:for-each select=&quot;$InvokeJDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive/tns2:NumAggiuntivaPortata&quot;>&lt;tns:NumAggiuntivaPortata>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:NumAggiuntivaPortata>&lt;/xsl:for-each>&lt;/tns:NPAggiuntive>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Telecom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&lt;tns:EsitoVerifica>&lt;tns:EsitoKO>&lt;tns:EsitoVerificaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:EsitoVerificaRichiesta>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;xsd:integer($JDBC_CAUSALE/Record[1]/COD_CAUS_OLO)&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:DescrizioneRifiuto>&lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:DescrizioneRifiuto>&lt;/tns:EsitoKO>&lt;/tns:EsitoVerifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:EsitoVerifica>&lt;tns:EsitoOK>&lt;tns:EsitoVerificaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/tns:EsitoVerificaRichiesta>&lt;/tns:EsitoOK>&lt;/tns:EsitoVerifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Valid_Formale_Cessazione>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ValidFormaleCessazione_Mapper-input"
                    name="ValidFormaleCessazione_Mapper"
                    outputVariable="ValidFormaleCessazione_Mapper"
                    tibex:xpdlId="58cc6276-8b22-4f34-873d-b4a06280a4e2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToValidFormaleCessazione_Mapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToGenericNotificationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npr&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeJDBCQuery.JDBCQueryOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:template name=&quot;ValidFormaleCessazione_Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Valid_Formale_Cessazione>&#xa;            &lt;tns:TipoComunicazione>&#xa;                &lt;xsl:value-of select=&quot;12&quot;/>&#xa;            &lt;/tns:TipoComunicazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/tipologiaScenario = &amp;quot;NPSUTIF&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/tipologiaScenario = &amp;quot;NPDONOROLO&amp;quot;) and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaNOW = &amp;quot;INVERIFICADONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&#xa;                    &lt;tns:CodiceOrdine>&#xa;                        &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI, 5)&quot;/>&#xa;                    &lt;/tns:CodiceOrdine>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:CodiceOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:DataOrdine>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/dataInvioRichiesta))&quot;/>&#xa;            &lt;/tns:DataOrdine>&#xa;            &lt;tns:DirectoryNumber>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico&quot;/>&#xa;            &lt;/tns:DirectoryNumber>&#xa;            &lt;tns:IdentificativoOperatoreDonor>&#xa;                &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:CodificaOLOAGCOMDonor&quot;/>&#xa;            &lt;/tns:IdentificativoOperatoreDonor>&#xa;            &lt;tns:DataInvioMessaggio>&#xa;                &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group1/tns2:DataInvioMessaggio&quot;/>&#xa;            &lt;/tns:DataInvioMessaggio>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;>&#xa;                &lt;tns:Note>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;/>&#xa;                &lt;/tns:Note>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:IdentificativoOperatoreDonating>&#xa;                &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:CodificaOLOAGCOMDonating&quot;/>&#xa;            &lt;/tns:IdentificativoOperatoreDonating>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(contains($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/contenutoXML,&amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;) and string-length(substring-before(substring-after($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/contenutoXML, &amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;), &amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;)) = 0) or (contains($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/contenutoXML,&amp;quot;&amp;lt;/ns:TipoLinea>&amp;quot;) and not(contains($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/contenutoXML,&amp;quot;&amp;lt;ns:TipoLinea>&amp;quot;)))&quot;>&#xa;                    &lt;tns:TipoLinea>&#xa;                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                    &lt;/tns:TipoLinea>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:TipoLinea='1' or $InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:TipoLinea='2'&quot;>&#xa;                    &lt;tns:TipoLinea>&#xa;                        &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                    &lt;/tns:TipoLinea>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:TipoLinea='0' or $InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:TipoLinea='3'&quot;>&#xa;                    &lt;tns:TipoLinea>&#xa;                        &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                    &lt;/tns:TipoLinea>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:TipoLinea&quot;>&#xa;                        &lt;tns:TipoLinea>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:TipoLinea&quot;/>&#xa;                        &lt;/tns:TipoLinea>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:Telecom>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:RientroTI) > 0&quot;>&#xa;                        &lt;tns:Rientro>&#xa;                            &lt;tns:RientroTI>&#xa;                                &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:RientroTI&quot;/>&#xa;                            &lt;/tns:RientroTI>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata)) > 0&quot;>&#xa;                                    &lt;tns:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata&quot;/>&#xa;                                    &lt;/tns:DataAttesaConsegnaServizio>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/tns:DataAttesaConsegnaServizio>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns:CognomeCliente_RagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:CognomeCliente_RagioneSociale&quot;/>&#xa;                            &lt;/tns:CognomeCliente_RagioneSociale>&#xa;                            &lt;xsl:if test=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:NomeCliente&quot;>&#xa;                                &lt;tns:NomeCliente>&#xa;                                    &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:NomeCliente&quot;/>&#xa;                                &lt;/tns:NomeCliente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:TelefonoReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:TelefonoReferenteRichiedente&quot;/>&#xa;                            &lt;/tns:TelefonoReferenteRichiedente>&#xa;                            &lt;tns:EmailReferenteRichiedente>&#xa;                                &lt;xsl:value-of select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:Rientro/tns2:EmailReferenteRichiedente&quot;/>&#xa;                            &lt;/tns:EmailReferenteRichiedente>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDCorrelazione) > 0 and string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/totaleRichiestePacchetto)) > 0&quot;>&#xa;                                    &lt;tns:Correlazioni>&#xa;                                        &lt;tns:IdentificativoCorrelazioni>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDCorrelazione&quot;/>&#xa;                                        &lt;/tns:IdentificativoCorrelazioni>&#xa;                                        &lt;tns:TotaleRichieste>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/totaleRichiestePacchetto&quot;/>&#xa;                                        &lt;/tns:TotaleRichieste>&#xa;                                    &lt;/tns:Correlazioni>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns:Rientro>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive)&quot;>&#xa;                        &lt;tns:NPAggiuntive>&#xa;                            &lt;xsl:for-each select=&quot;$InvokeJDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive/tns2:NumAggiuntivaPortata&quot;>&#xa;                                &lt;tns:NumAggiuntivaPortata>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/tns:NumAggiuntivaPortata>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/tns:NPAggiuntive>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:Telecom>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&#xa;                    &lt;tns:EsitoVerifica>&#xa;                        &lt;tns:EsitoKO>&#xa;                            &lt;tns:EsitoVerificaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                            &lt;/tns:EsitoVerificaRichiesta>&#xa;                            &lt;tns:CodiceMotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($JDBC_CAUSALE/Record[1]/COD_CAUS_OLO)&quot;/>&#xa;                            &lt;/tns:CodiceMotivoRifiuto>&#xa;                            &lt;tns:DescrizioneRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                            &lt;/tns:DescrizioneRifiuto>&#xa;                        &lt;/tns:EsitoKO>&#xa;                    &lt;/tns:EsitoVerifica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:EsitoVerifica>&#xa;                        &lt;tns:EsitoOK>&#xa;                            &lt;tns:EsitoVerificaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                            &lt;/tns:EsitoVerificaRichiesta>&#xa;                        &lt;/tns:EsitoOK>&#xa;                    &lt;/tns:EsitoVerifica>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:Valid_Formale_Cessazione>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:npr="http://xsd.telecomitalia.it/crm/npr" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="npr:Valid_Formale_Cessazione" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="InvokeJDBCQuery-input"
