            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npn&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;Invoke_JDBCQuery&quot;/>&lt;xsl:template name=&quot;Annulllamento_Mapper-input&quot; match=&quot;/&quot;>&lt;tns:Annullamento>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;&amp;quot;11&amp;quot;&quot;/>&lt;/tns:TipoComunicazione>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/tipologiaScenario = &amp;quot;NPSUTIF&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/tipologiaScenario = &amp;quot;NPDONOROLO&amp;quot;) and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/statoRichiestaNOW = &amp;quot;INVERIFICADONATING&amp;quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineTI, 5)&quot;/>&lt;/tns:CodiceOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdine>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DataOrdine>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/dataInvioRichiesta))&quot;/>&lt;/tns:DataOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/numeroTelefonico&quot;/>&lt;/tns:DirectoryNumber>&lt;xsl:if test=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:TipoLinea&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:TipoLinea&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/note&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/note&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group1/tns2:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;tns:IdentificativoOperatoreDonor>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:CodificaOLOAGCOMDonor&quot;/>&lt;/tns:IdentificativoOperatoreDonor>&lt;xsl:if test=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:NomeCliente&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:NomeCliente&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:CognomeCliente_RagioneSociale&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;tns:TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:TelefonoReferenteRichiedente&quot;/>&lt;/tns:TelefonoReferenteRichiedente>&lt;tns:EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:EmailReferenteRichiedente&quot;/>&lt;/tns:EmailReferenteRichiedente>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codificaOLOAGCOM) > 0 and string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/totaleRichiestePacchetto)) > 0&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDCorrelazione&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/totaleRichiestePacchetto&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:CodiceOpRecipient>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:CodiceOLORecipient&quot;/>&lt;/tns:CodiceOpRecipient>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DACRimodulata)) > 0&quot;>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DACRimodulata))&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:DataAttesaConsegnaServizio&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/codiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:DefTipoLinea/tns2:ISDN/tns2:flagNPNumerazioniAggiuntive&quot;>&lt;tns:FlagNPNumerazioniAggiuntive>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:DefTipoLinea/tns2:ISDN/tns2:flagNPNumerazioniAggiuntive&quot;/>&lt;/tns:FlagNPNumerazioniAggiuntive>&lt;/xsl:if>&lt;tns:CodiceSegreto>&lt;xsl:value-of select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group2/tns2:CodiceSegreto&quot;/>&lt;/tns:CodiceSegreto>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive)&quot;>&lt;tns:NPAggiuntive>&lt;xsl:for-each select=&quot;$Invoke_JDBCQuery/JDBCQueryOutput/tns2:JDBCQueryResponse/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive/tns2:NumAggiuntivaPortata&quot;>&lt;tns:NumAggiuntivaPortata>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:NumAggiuntivaPortata>&lt;/xsl:for-each>&lt;/tns:NPAggiuntive>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:Annullamento>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
