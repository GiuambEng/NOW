                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/npn&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/JDBCQuery&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Invoke_JDBCQuery.JDBCQueryOutput&quot;/>&#xa;    &lt;xsl:template name=&quot;Annulllamento_Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Annullamento>&#xa;            &lt;tns:TipoComunicazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;11&amp;quot;&quot;/>&#xa;            &lt;/tns:TipoComunicazione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/tipologiaScenario = &amp;quot;NPSUTIF&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/tipologiaScenario = &amp;quot;NPDONOROLO&amp;quot;) and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaNOW = &amp;quot;INVERIFICADONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:CodificaOLOAGCOMDestinatario = &amp;quot;TLC&amp;quot;&quot;>&#xa;                    &lt;tns:CodiceOrdine>&#xa;                        &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI, 5)&quot;/>&#xa;                    &lt;/tns:CodiceOrdine>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:CodiceOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdine>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:DataOrdine>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/dataInvioRichiesta))&quot;/>&#xa;            &lt;/tns:DataOrdine>&#xa;            &lt;tns:DirectoryNumber>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/numeroTelefonico&quot;/>&#xa;            &lt;/tns:DirectoryNumber>&#xa;            &lt;xsl:if test=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:TipoLinea&quot;>&#xa;                &lt;tns:TipoLinea>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:TipoLinea&quot;/>&#xa;                &lt;/tns:TipoLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;>&#xa;                &lt;tns:Note>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;/>&#xa;                &lt;/tns:Note>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:DataInvioMessaggio>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group1/tns2:DataInvioMessaggio&quot;/>&#xa;            &lt;/tns:DataInvioMessaggio>&#xa;            &lt;tns:IdentificativoOperatoreDonor>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:CodificaOLOAGCOMDonor&quot;/>&#xa;            &lt;/tns:IdentificativoOperatoreDonor>&#xa;            &lt;xsl:if test=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:NomeCliente&quot;>&#xa;                &lt;tns:NomeCliente>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:NomeCliente&quot;/>&#xa;                &lt;/tns:NomeCliente>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:CognomeCliente_RagioneSociale>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:CognomeCliente_RagioneSociale&quot;/>&#xa;            &lt;/tns:CognomeCliente_RagioneSociale>&#xa;            &lt;tns:TelefonoReferenteRichiedente>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:TelefonoReferenteRichiedente&quot;/>&#xa;            &lt;/tns:TelefonoReferenteRichiedente>&#xa;            &lt;tns:EmailReferenteRichiedente>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:EmailReferenteRichiedente&quot;/>&#xa;            &lt;/tns:EmailReferenteRichiedente>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codificaOLOAGCOM) > 0 and string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/totaleRichiestePacchetto)) > 0&quot;>&#xa;                    &lt;tns:Correlazioni>&#xa;                        &lt;tns:IdentificativoCorrelazioni>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDCorrelazione&quot;/>&#xa;                        &lt;/tns:IdentificativoCorrelazioni>&#xa;                        &lt;tns:TotaleRichieste>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/totaleRichiestePacchetto&quot;/>&#xa;                        &lt;/tns:TotaleRichieste>&#xa;                    &lt;/tns:Correlazioni>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:CodiceOpRecipient>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:CodiceOLORecipient&quot;/>&#xa;            &lt;/tns:CodiceOpRecipient>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata)) > 0&quot;>&#xa;                    &lt;tns:DataAttesaConsegnaServizio>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata))&quot;/>&#xa;                    &lt;/tns:DataAttesaConsegnaServizio>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:DataAttesaConsegnaServizio>&#xa;                        &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:DataAttesaConsegnaServizio&quot;/>&#xa;                    &lt;/tns:DataAttesaConsegnaServizio>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceProgetto&quot;>&#xa;                &lt;tns:CodiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                &lt;/tns:CodiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:DefTipoLinea/tns2:ISDN/tns2:flagNPNumerazioniAggiuntive&quot;>&#xa;                &lt;tns:FlagNPNumerazioniAggiuntive>&#xa;                    &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:DefTipoLinea/tns2:ISDN/tns2:flagNPNumerazioniAggiuntive&quot;/>&#xa;                &lt;/tns:FlagNPNumerazioniAggiuntive>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:CodiceSegreto>&#xa;                &lt;xsl:value-of select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group2/tns2:CodiceSegreto&quot;/>&#xa;            &lt;/tns:CodiceSegreto>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive)&quot;>&#xa;                    &lt;tns:NPAggiuntive>&#xa;                        &lt;xsl:for-each select=&quot;$Invoke_JDBCQuery.JDBCQueryOutput/tns2:Group3/tns2:Telecom/tns2:NPAggiuntive/tns2:NumAggiuntivaPortata&quot;>&#xa;                            &lt;tns:NumAggiuntivaPortata>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns:NumAggiuntivaPortata>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns:NPAggiuntive>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:Annullamento>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
