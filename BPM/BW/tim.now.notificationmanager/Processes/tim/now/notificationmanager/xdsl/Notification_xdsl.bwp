                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c567fea2-4066-4a06-952d-cae1589bed74+output&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateKitConsegna&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;DATI_VC&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:XDSL>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica='KO' and not(exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine))&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamATMAsimm)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamATMAsimm/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso)&quot;>&#xa;                                            &lt;xsl:for-each select=&quot;$ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/n