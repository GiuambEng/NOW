                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = "MIGRAZIONE" and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica != "CO") or ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLANVULA' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLAN' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLANNGA' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VP')]]></bpws:transitionCondition>
