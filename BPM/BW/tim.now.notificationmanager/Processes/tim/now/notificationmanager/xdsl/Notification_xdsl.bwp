&amp;quot;OK&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or&amp;#xD;&amp;#xA; $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaNotifica = &amp;quot;AN&amp;quot; or&amp;#xD;&amp;#xA; $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaNotifica = &amp;quot;AC&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaNotifica = &amp;quot;RD&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaNotifica = &amp;quot;CS&amp;quot;)) and ($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta!='VLANVULA' and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta!='VLAN'  and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta!='VLANNGA' and $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta!='VP')&quot;>&lt;ns0:DATI_MIGRAZIONI>&lt;ns0:TIPO_COMUNICAZIONE>&lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns2:MigrazioniResponse/tns2:TIPO_COMUNICAZIONE&quot;/>&lt;/ns0:TIPO_COMUNICAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot; and $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns2:MigrazioniResponse/tns2:TIPO_COMUNICAZIONE != &amp;quot;10&amp;quot; and $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns2:MigrazioniResponse/tns2:TIPO_COMUNICAZIONE != &amp;quot;11&amp;quot; and $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns2:MigrazioniResponse/tns2:TIPO_COMUNICAZIONE != &amp;quot;12&amp;quot;&quot;>&lt;ns0:CODICE_OPERATORE_RECIPIENT>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGener