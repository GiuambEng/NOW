                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstarct/PreventivoOpereSpeciali/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;PreventivoOpereSpecialiInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:PreventivoOpereSpecialiRequest>&#xa;            &lt;tns2:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns2:IDRichiestaOLO>&#xa;            &lt;xsl:if test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDPreventivo)&quot;>&#xa;                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDPreventivo&quot;>&#xa;                    &lt;tns2:IDPreventivo>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDPreventivo&quot;/>&#xa;                    &lt;/tns2:IDPreventivo>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDConsuntivo)&quot;>&#xa;                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDConsuntivo&quot;>&#xa;                    &lt;tns2:IDConsuntivo>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDConsuntivo&quot;/>&#xa;                    &lt;/tns2:IDConsuntivo>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:PreventivoOpereSpecialiRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
