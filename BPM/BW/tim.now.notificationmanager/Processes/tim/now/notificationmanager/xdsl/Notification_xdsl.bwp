est/tns1:Richiesta/codiceProgetto&quot;/>&lt;/ns0:CODICE_PROGETTO>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRisorsa&quot;>&lt;ns0:IDENTIFICATIVO_RISORSA>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/ns0:IDENTIFICATIVO_RISORSA>&lt;/xsl:if>&lt;ns0:NOME>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/nome, 1, 20)&quot;/>&lt;/ns0:NOME>&lt;xsl:if test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/cognomeRagioneSociale) > 0&quot;>&lt;ns0:COGNOME>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/cognomeRagioneSociale, 1, 70)&quot;/>&lt;/ns0:COGNOME>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Numeri/tns2:NUMERO) > 0&quot;>&lt;ns0:DISTRETTO>&lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, string(xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/distretto)))&quot;/>&lt;/ns0:DISTRETTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Numeri/tns2:NUMERO) > 0&quot;>&lt;xsl:if test=&quot;$Numeri/tns2:NUMERO&quot;>&lt;ns0:NUMERO>&lt;xsl:value-of select=&quot;$Numeri/tns2:NUMERO&quot;/>&lt;/ns0:NUMERO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or ($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/tipologiaSottolav  = &amp;quot;MIGRAZIONEOLO&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/tipologiaSottolav  = &amp;quot;ATTIVAZIONE274&amp;quot;) and ($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;BITSTREAMATMASIMMETRICOHL&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;EASYIPBASEPLUSFLAT&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;EASYIPBASEPLUSLITE&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;EASYIPSPECIALPROFILELITE&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;EASYIPBASEPLUS&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta = &amp;quot;EASYIPSPECIALPROFILE&amp;quot;))&quot;/>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAt