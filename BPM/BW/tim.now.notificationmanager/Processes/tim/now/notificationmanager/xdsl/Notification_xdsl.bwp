                                    expression="count($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &quot;ATMVC&quot; or nomeComponente = &quot;GBEVC&quot;]) > 0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica != &quot;SC&quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica != &quot;SP&quot; and $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica != &quot;SM&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
