t;ns0:OPTION_82_CIRCUIT_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;tns2:OPTION_82_CIRCUIT_ID&quot;/>&#xa;                                                    &lt;/ns0:OPTION_82_CIRCUIT_ID>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;tns2:OPTION_82_REMOTE_ID&quot;>&#xa;                                                    &lt;ns0:OPTION_82_REMOTE_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;tns2:OPTION_82_REMOTE_ID&quot;/>&#xa;                                                    &lt;/ns0:OPTION_82_REMOTE_ID>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/ns0:VC>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/ns0:DATI_VC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;(($GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;SC&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;SP&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;) and $CalcoloReferenteInvoke.output/tns2:PresenzaReferente = true())and ($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VLANVULA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VLAN'  and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VLANNGA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VP')&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;10&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;11&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;12&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;13&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;18&amp;quot;) and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica != &amp;quot;SM&amp;quot;&quot;/>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0:DATI_REFERENTE>&#xa;                                &lt;xsl:for-each select=&quot;$CalcoloReferenteInvoke.output/tns2:ReferenteRipetitivo&quot;>&#xa;                                    &lt;xsl:variable name=&quot;Progressivo&quot; select=&quot;tns2:ProgressivoReferente&quot;/>&#xa;                                    &lt;ns0:REFERENTE>&#xa;                                        &lt;ns0:NOME_REF>&#xa;                                            &lt;xsl:value-of select=&quot;tns2:NomeReferente&quot;/>&#xa;                                        &lt;/ns0:NOME_REF>&#xa;                                        &lt;ns0:COGNOME_REF>&#xa;                                            &lt;xsl:value-of select=&quot;tns2:CognomeReferente&quot;/>&#xa;                                        &lt;/ns0:COGNOME_REF>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;tns2:TelefonoFisso = &amp;quot;SI&amp;quot; and string-length(tns2:TelefonoFissoReferente) > 0&quot;>&#xa;                                                &lt;ns0:TEL_REF>&#xa;                                                    &lt;xsl:value-of select=&quot;tns2:TelefonoFissoReferente&quot;/>&#xa;                                                &lt;/ns0:TEL_REF>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;tns2:TelefonoMobile = &amp;quot;SI&amp;quot; and string-length(tns2:TelefonoMobileReferente) > 0&quot;>&#xa;                                                &lt;ns0:MOB_REF>&#xa;                                                    &lt;xsl:value-of select=&quot;tns2:TelefonoMobileReferente&quot;/>&#xa;                                                &lt;/ns0:MOB_REF>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;string-length(tns2:DataContatto) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;tns2:DataContatto&quot;>&#xa;                                                &lt;ns0:DATA_CONTATTO>&#xa;                                                    &lt;xsl:value-of select=&quot;tns2:DataContatto&quot;/>&#xa;                                                &lt;/ns0:DATA_CONTATTO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;starts-with(tns2:NomeReferente, 'dk') or starts-with(tns2:CognomeReferente, 'dk') or starts-with(tns2:TelefonoFissoReferente, 'dk') or starts-with(tns2:TelefonoMobileReferente, 'dk')&quot;>&#xa;                                            &lt;ns0:PROGRESSIVO>&#xa;                                                &lt;xsl:value-of select=&quot;$Progressivo&quot;/>&#xa;                                            &lt;/ns0:PROGRESSIVO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns0:REFERENTE>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/ns0:DATI_REFERENTE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot; (exists($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta) and ($GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;AQ&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;OK&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot; or&amp;#xD;&amp;#xA; $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;AN&amp;quot; or&amp;#xD;&amp;#xA; $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;AC&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RD&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;CS&amp;quot;)) and ($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VLANVULA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VLAN'  and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VLANNGA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta!='VP')&quot;>&#xa;                    &lt;ns0:DATI_MIGRAZIONI>&#xa;                        &lt;ns0:TIPO_COMUNICAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE&quot;/>&#xa;                        &lt;/ns0:TIPO_COMUNICAZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;10&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;11&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;12&amp;quot;&quot;>&#xa;                                &lt;ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:CodificaOLOAGCOMDestinatario&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;5&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;6&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;7&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                &lt;ns0:CODICE_OPERATORE_DONATING>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_DONATING>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_OPERATORE_DONATING>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_DONATING>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns0:CODICE_ORDINE_RECIPIENT>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                        &lt;/ns0:CODICE_ORDINE_RECIPIENT>&#xa;                        &lt;ns0:CODICE_ORDINE_TI_WH>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;/>&#xa;                        &lt;/ns0:CODICE_ORDINE_TI_WH>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario != &amp;quot;RECIPIENT&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/cowCodeOLO) > 0 and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/cowCodeOLO2) > 0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/cowCodeOLO = $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/cowCodeOLO2 &quot;>&#xa;                                &lt;ns0:CODICE_RISORSA_1>&#xa;                                    &lt;xsl:value-of select=&quot;$CodiceRisorsa&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/cowCodeOLO = $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;COWCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns0:CODICE_RISORSA_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceRisorsaDonating&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/cowCodeOLO2 = $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;COWCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns0:CODICE_RISORSA_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_RISORSA_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceRisorsaDonating&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_1>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICESESSIONE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                &lt;ns0:CODICE_SESSIONE_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICESESSIONE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/ns0:CODICE_SESSIONE_1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_SESSIONE_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceSessione&quot;/>&#xa;                                &lt;/ns0:CODICE_SESSIONE_1>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceRisorsaDonating2) > 0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot;&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceRisorsaDonating2&quot;>&#xa;                                &lt;ns0:CODICE_RISORSA_2>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_2>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceSessione2) > 0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot;&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceSessione2&quot;>&#xa;                                &lt;ns0:CODICE_SESSIONE_2>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceSessione2&quot;/>&#xa;                                &lt;/ns0:CODICE_SESSIONE_2>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:STATO&quot;>&#xa;                            &lt;ns0:STATO>&#xa;                                &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:STATO&quot;/>&#xa;                            &lt;/ns0:STATO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:CAUSALE_RIFIUTO&quot;>&#xa;                            &lt;ns0:CAUSALE_RIFIUTO>&#xa;                                &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:CAUSALE_RIFIUTO&quot;/>&#xa;                            &lt;/ns0:CAUSALE_RIFIUTO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ESPLETAMENTOTECNICOKO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ANNULLATO&amp;quot;) and exists($JDBC_CAUSALE/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                    &lt;ns0:CODICE_MOTIVO_RIFIUTO>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                    &lt;/ns0:CODICE_MOTIVO_RIFIUTO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ESPLETAMENTOTECNICOKO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ANNULLATO&amp;quot;) and exists($JDBC_CAUSALE/Record)&quot;>&#xa;                                &lt;ns0:MOTIVO_RIFIUTO>&#xa;                                    &lt;xsl:value-of select=&quot;substring($JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO, 1, 80)&quot;/>&#xa;                                &lt;/ns0:MOTIVO_RIFIUTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[1]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[1]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_1>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[1]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_1>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[2]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[2]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_2>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[2]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_2>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[3]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[3]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_3>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[3]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_3>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[4]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[4]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_4>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[4]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_4>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[5]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[5]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_5>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[5]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_5>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[6]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[6]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_6>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[6]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_6>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[7]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[7]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_7>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[7]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_7>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[8]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[8]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_8>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[8]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_8>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[9]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[9]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_9>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[9]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_9>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[10]/tns2:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[10]/tns2:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_10>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:DIRECTORY_NUMBER[10]/tns2:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_10>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codificaOLOAGCOMDonor != &amp;quot;TLC&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns0:ROUTING_NUMBER_RECIPIENT>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/ns0:ROUTING_NUMBER_RECIPIENT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES))&quot;>&#xa;                            &lt;ns0:DATA_ESPLETAMENTO_ORDINE>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/ns0:DATA_ESPLETAMENTO_ORDINE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;>&#xa;                            &lt;ns0:CODICE_ORDINE_PITAGORA>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;/>&#xa;                            &lt;/ns0:CODICE_ORDINE_PITAGORA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata))&quot;>&#xa;                                &lt;ns0:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/ns0:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DAC))&quot;>&#xa;                                    &lt;ns0:DAC>&#xa;                                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/ns0:DAC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns0:DATA_NOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/ns0:DATA_NOTIFICA>&#xa;                        &lt;ns0:DATA_RICEZIONE_ORDINE>&#xa;                            &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/dataInvioRichiesta, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                        &lt;/ns0:DATA_RICEZIONE_ORDINE>&#xa;                        &lt;xsl:if test=&quot; $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RD&amp;quot; and count($JDBC_CAUSALE/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                &lt;ns0:CodiceCausaleRimodulazione>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                &lt;/ns0:CodiceCausaleRimodulazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot; $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RD&amp;quot; and count($JDBC_CAUSALE/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;>&#xa;                                &lt;ns0:DescrizioneCausaleRimodulazione>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/ns0:DescrizioneCausaleRimodulazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns0:DATI_MIGRAZIONI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;])&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot; and azione != &amp;quot;D&amp;quot; and azione != &amp;quot;T&amp;quot;])&quot;>&#xa;                                    &lt;ns0:DATI_UserVlan>&#xa;                                        &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot; and azione != &amp;quot;D&amp;quot; and azione != &amp;quot;T&amp;quot;]&quot;>&#xa;                                            &lt;ns0:UserVlan>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo) > 0 and attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo != &amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                                        &lt;ns0:UserVlan>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                        &lt;/ns0:UserVlan>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo != &amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                                        &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                                            &lt;ns0:S_VLAN_CODE>&#xa;                                                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                            &lt;/ns0:S_VLAN_CODE>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANCODE&amp;quot;]/valoreAttributo) > 0 and attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANCODE&amp;quot;]/valoreAttributo != &amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                                        &lt;ns0:C_VLAN_CODE>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANCODE&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                        &lt;/ns0:C_VLAN_CODE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/ns0:UserVlan>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/ns0:DATI_UserVlan>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;10&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;11&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;12&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;13&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;18&amp;quot;)&quot;/>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns0:DATI_UserVlan>&#xa;                                        &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;]&quot;>&#xa;                                            &lt;ns0:UserVlan>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                                        &lt;ns0:UserVlan>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                        &lt;/ns0:UserVlan>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                                    &lt;ns0:S_VLAN_CODE>&#xa;                                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                    &lt;/ns0:S_VLAN_CODE>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                                        &lt;ns0:C_VLAN_CODE>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                        &lt;/ns0:C_VLAN_CODE>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/ns0:UserVlan>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/ns0:DATI_UserVlan>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta='VLAN' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta='VP') and ($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;10&amp;quot;and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;11&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;12&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE != &amp;quot;13&amp;quot; and$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE !=&amp;quot;18&amp;quot;)&quot;>&#xa;                &lt;ns0:DATI_VLAN>&#xa;                    &lt;ns0:CODICE_ISP>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/ns0:CODICE_ISP>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                            &lt;ns0:CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                            &lt;/ns0:CODICE_ORDINE_ISP>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0:CODICE_ORDINE_ISP>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CODICEASSENTE&amp;quot;&quot;/>&#xa;                            &lt;/ns0:CODICE_ORDINE_ISP>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceProgetto)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceProgetto&quot;>&#xa;                            &lt;ns0:CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                            &lt;/ns0:CODICE_PROGETTO>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;>&#xa;                            &lt;ns0:CODICE_ORDINE_PITAGORA>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;/>&#xa;                            &lt;/ns0:CODICE_ORDINE_PITAGORA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='CODICETDKIT']/valoreAttributo&quot;>&#xa;                        &lt;ns0:CODICETDKIT>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='CODICETDKIT']/valoreAttributo&quot;/>&#xa;                        &lt;/ns0:CODICETDKIT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione='ATTIVAZIONE'&quot;>&#xa;                            &lt;ns0:TIPO_RICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;'ATT'&quot;/>&#xa;                            &lt;/ns0:TIPO_RICHIESTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione='CESSAZIONE'&quot;>&#xa;                            &lt;ns0:TIPO_RICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;'DIS'&quot;/>&#xa;                            &lt;/ns0:TIPO_RICHIESTA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0:TIPO_RICHIESTA>&#xa;                                &lt;xsl:value-of select=&quot;'VAR'&quot;/>&#xa;                            &lt;/ns0:TIPO_RICHIESTA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica='KO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica='OK') and exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                    &lt;ns0:DATA_NOTIFICA>&#xa;                                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES,&amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/ns0:DATA_NOTIFICA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns0:DATA_NOTIFICA>&#xa;                                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES,&amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/ns0:DATA_NOTIFICA>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($JDBC_XDSL_EVENTO_ORDN/Record)&quot;>&#xa;                            &lt;ns0:DATA_NOTIFICA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(xsd:date($JDBC_XDSL_EVENTO_ORDN/Record[1]/TIMSTP_INSMTO_EVENTO), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/ns0:DATA_NOTIFICA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0:DATA_NOTIFICA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/ns0:DATA_NOTIFICA>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                            &lt;ns0:STATO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SP&amp;quot;&quot;/>&#xa;                            &lt;/ns0:STATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0:STATO>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica&quot;/>&#xa;                            &lt;/ns0:STATO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ESPLETAMENTOTECNICOKO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ANNULLATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ACCODATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot;) and exists($JDBC_CAUSALE/Record)&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                &lt;ns0:CODICE_CAUSALE_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                &lt;/ns0:CODICE_CAUSALE_ERRORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ESPLETAMENTOTECNICOKO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ANNULLATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/statoRichiestaOLO = &amp;quot;ACCODATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot;) and exists($JDBC_CAUSALE/Record)&quot;>&#xa;                            &lt;ns0:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;substring($JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO, 1, 80)&quot;/>&#xa;                            &lt;/ns0:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RR&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/noteAltreLavorazioni&quot;>&#xa;                                &lt;ns0:NOTE>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/noteAltreLavorazioni&quot;/>&#xa;                                &lt;/ns0:NOTE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;>&#xa;                                        &lt;ns0:NOTE>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/notedaSistema&quot;/>&#xa;                                        &lt;/ns0:NOTE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;>&#xa;                                        &lt;ns0:NOTE>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/noteCliente&quot;/>&#xa;                                        &lt;/ns0:NOTE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;>&#xa;                                                &lt;ns0:NOTE>&#xa;                                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;/>&#xa;                                                &lt;/ns0:NOTE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='TIPOVLAN']/valoreAttributo)>0&quot;>&#xa;                            &lt;ns0:TIPO_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='TIPOVLAN']/valoreAttributo&quot;/>&#xa;                            &lt;/ns0:TIPO_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'CONSISTENZA')]/attributiDettaglioOrdine[nomeAttributo='TIPOVLAN']/valoreAttributo)>0&quot;>&#xa;                            &lt;ns0:TIPO_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'CONSISTENZA')]/attributiDettaglioOrdine[nomeAttributo='TIPOVLAN']/valoreAttributo&quot;/>&#xa;                            &lt;/ns0:TIPO_VLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0:TIPO_VLAN>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/ns0:TIPO_VLAN>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FAMIGLIAVLAN']/valoreAttributo)>0&quot;>&#xa;                            &lt;ns0:FamigliaVLAN>&#xa;                                &lt;xsl:value-of select=&quot;xsd:integer($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'RACCOLTA')]/attributiDettaglioOrdine[nomeAttributo='FAMIGLIAVLAN']/valoreAttributo)&quot;/>&#xa;                            &lt;/ns0:FamigliaVLAN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($GenericNotif