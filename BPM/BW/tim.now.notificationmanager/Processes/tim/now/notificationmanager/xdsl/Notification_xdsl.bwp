                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/DATI_VLAN/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;MacroArea-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Request>&#xa;            &lt;tns1:IDrichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDrichiestaOLO>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Offerta&quot;>&#xa;                &lt;tns1:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns:Offerta&quot;/>&#xa;                &lt;/tns1:Offerta>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
