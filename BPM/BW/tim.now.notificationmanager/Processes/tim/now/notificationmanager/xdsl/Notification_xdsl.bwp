ne/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)='SI'  and string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROTOCOLLOPILA&amp;quot;]/valoreAttributo) >0 and upper-case(attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROTOCOLLOPILA&amp;quot;]/valoreAttributo)='IPOE'  and ((count($Oscuramento/Record[COD_AGESP='R1I-19-0291'])=0) or (count($Oscuramento/Record[COD_AGESP='R1I-19-0291'])>0 and $Oscuramento/Record[COD_AGESP='R1I-19-0291']/FLAG_OSCURMENTO='0'))&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo =&amp;quot;REMOTEID&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo =&amp;quot;REMOTEID&amp;quot;]/valoreAttributo&quot;>&#xa;                                                        &lt;tns2:OPTION_82_REMOTE_ID>&#xa;                                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo =&amp;quot;REMOTEID&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                        &lt;/tns2:OPTION_82_REMOTE_ID>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise/>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/tns2:DATI_VC>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:XDSL>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
