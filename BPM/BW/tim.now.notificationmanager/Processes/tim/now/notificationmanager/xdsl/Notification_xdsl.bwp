            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2467c837-ecb9-46ae-b171-1683b7c3591e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;JDBC_XDSL_EVENTO_ORDN-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;ID_EVENTO_ORDN_NOW_WHLS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:IDEventoOrdineNOW)&quot;>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:IDEventoOrdineNOW&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_EVENTO_ORDN_NOW_WHLS>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_XDSL_EVENTO_ORDN-input"
                    name="JDBC_XDSL_EVENTO_ORDN"
                    outputVariable="JDBC_XDSL_EVENTO_ORDN"
                    tibex:xpdlId="2467c837-ecb9-46ae-b171-1683b7c3591e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBC_XDSL_EVENTO_EventoPresente"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_XDSL_EVENTO_Operespeciali">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica = &quot;SP&quot; and ($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDAnagraficaCausale = 382 or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDAnagraficaCausale = 383)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = "SP" and ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDAnagraficaCausale = 382 or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDAnagraficaCausale = 383)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBC_XDSL_EVENTO_ORDNToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2467c837-ecb9-46ae-b171-1683b7c3591e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_XDSL_EVENTO_ORDN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;ID_EVENTO_ORDN_NOW_WHLS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:IDEventoOrdineNOW)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:IDEventoOrdineNOW&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_EVENTO_ORDN_NOW_WHLS>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TIMSTP_INSMTO_EVENTO&#xa;  FROM EVENTO_ORDN_NOW_WHLS&#xa;  WHERE ID_RICH_OLO = ? AND ID_EVENTO_ORDN_NOW_WHLS=? &#xa;  ORDER BY TIMSTP_INSMTO_EVENTO DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRichiestaOLO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_EVENTO_ORDN_NOW_WHLS"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO_EVENTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
