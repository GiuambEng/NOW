$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPBASEPLUSFLAT' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPBASEPLUSLITE' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPSPECIALPROFILEFLAT' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPSPECIALPROFILELITE']]></bpws:transitionCondition>
