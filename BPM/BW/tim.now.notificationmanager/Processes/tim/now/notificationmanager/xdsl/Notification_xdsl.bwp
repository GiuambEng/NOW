           &lt;xsl:value-of select=&quot;ns0:ProfiloVC/ns0:ABR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;/>&#xa;                                                                &lt;/tns2:KIT_CONSEGNA>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;exists(ns0:ProfiloVC/ns0:CBR/ns0:Consegna/ns0:BandaDedicata)&quot;>&#xa;                                                            &lt;xsl:if test=&quot;ns0:ProfiloVC/ns0:CBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;>&#xa;                                                                &lt;tns2:KIT_CONSEGNA>&#xa;                                                                    &lt;xsl:value-of select=&quot;ns0:ProfiloVC/ns0:CBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;/>&#xa;                                                                &lt;/tns2:KIT_CONSEGNA>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;exists(ns0:ProfiloVC/ns0:VBR/ns0:Consegna/ns0:BandaDedicata)&quot;>&#xa;                                                            &lt;xsl:if test=&quot;ns0:ProfiloVC/ns0:VBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;>&#xa;                                                                &lt;tns2:KIT_CONSEGNA>&#xa;                                                                    &lt;xsl:value-of select=&quot;ns0:ProfiloVC/ns0:VBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;/>&#xa;                                                                &lt;/tns2:KIT_CONSEGNA>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise/>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/tns2:DATI_VC>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamATMAsimm/ns0:TipoVariazione/ns0:IncrementoDecrementoVC)&quot;>&#xa;                                            &lt;xsl:for-each select=&quot;$ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamATMAsimm/ns0:TipoVariazione/ns0:IncrementoDecrementoVC/ns0:DatiVC&quot;>&#xa;                                                &lt;tns2:DATI_VC>&#xa;                                                    &lt;tns2:VPI_CLIENTE>&#xa;                                                        &lt;xsl:value-of select=&quot;ns0:VPI&quot;/>&#xa;                                                    &lt;/tns2:VPI_CLIENTE>&#xa;                                                    &lt;tns2:VCI_CLIENTE>&#xa;                                                        &lt;xsl:value-of select=&quot;ns0:VCI&quot;/>&#xa;                                                    &lt;/tns2:VCI_CLIENTE>&#xa;                                                    &lt;xsl:if test=&quot;exists(ns0:ProfiloVC/ns0:ABR/ns0:Consegna/ns0:BandaCondivisa)&quot;>&#xa;                                                        &lt;xsl:if test=&quot;ns0:ProfiloVC/ns0:ABR/ns0:Consegna/ns0:BandaCondivisa/ns0:CodiceVP&quot;>&#xa;                                                            &lt;tns2:CODE_VP>&#xa;                                                                &lt;xsl:value-of select=&quot;ns0:ProfiloVC/ns0:ABR/ns0:Consegna/ns0:BandaCondivisa/ns0:CodiceVP&quot;/>&#xa;                                                            &lt;/tns2:CODE_VP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;exists(ns0:ProfiloVC/ns0:ABR/ns0:Consegna/ns0:BandaDedicata)&quot;>&#xa;                                                            &lt;xsl:if test=&quot;ns0:ProfiloVC/ns0:ABR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;>&#xa;                                                                &lt;tns2:KIT_CONSEGNA>&#xa;                                                                    &lt;xsl:value-of select=&quot;ns0:ProfiloVC/ns0:ABR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;/>&#xa;                                                                &lt;/tns2:KIT_CONSEGNA>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;exists(ns0:ProfiloVC/ns0:CBR/ns0:Consegna/ns0:BandaDedicata)&quot;>&#xa;                                                            &lt;xsl:if test=&quot;ns0:ProfiloVC/ns0:CBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;>&#xa;                                                                &lt;tns2:KIT_CONSEGNA>&#xa;                                                                    &lt;xsl:value-of select=&quot;ns0:ProfiloVC/ns0:CBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;/>&#xa;                                                                &lt;/tns2:KIT_CONSEGNA>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:when test=&quot;exists(ns0:ProfiloVC/ns0:VBR/ns0:Consegna/ns0:BandaDedicata)&quot;>&#xa;                                                            &lt;xsl:if test=&quot;ns0:ProfiloVC/ns0:VBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;>&#xa;                                                                &lt;tns2:KIT_CONSEGNA>&#xa;                                                                    &lt;xsl:value-of select=&quot;ns0:ProfiloVC/ns0:VBR/ns0:Consegna/ns0:BandaDedicata/ns0:CodiceTD&quot;/>&#xa;                                                                &lt;/tns2:KIT_CONSEGNA>&#xa;                                                            &lt;/xsl:if>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise/>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/tns2:DATI_VC>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamATMSimm)&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamATMSimm/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($ParseXml/ns0:Richiesta[1]/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamATMSimm/ns0:TipoVariazione/ns0:RiconfigurazioneAccesso/ns0:DatiVC/ns0:ATM)&quot;>&#xa;                                            