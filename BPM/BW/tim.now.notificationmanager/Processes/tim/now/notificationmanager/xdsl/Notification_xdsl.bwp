            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/DATI_VLAN/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:param name=&quot;DTUAppuntamentoElement&quot;/>&lt;xsl:param name=&quot;DTUAccessoElement&quot;/>&lt;xsl:param name=&quot;JDBC_XDSL_EVENTO_ORDN&quot;/>&lt;xsl:param name=&quot;PreventivoOpereSpecialiInvoke&quot;/>&lt;xsl:param name=&quot;NGA_XDSL_MigrazioniInvoke&quot;/>&lt;xsl:param name=&quot;CalcoloReferenteInvoke&quot;/>&lt;xsl:param name=&quot;Numeri&quot;/>&lt;xsl:param name=&quot;DATI_VC&quot;/>&lt;xsl:param name=&quot;DataEsito&quot;/>&lt;xsl:param name=&quot;CodiceRisorsa&quot;/>&lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&lt;xsl:param name=&quot;SelectEVENTO&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;MacroArea&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:template name=&quot;XDSLMapper-input&quot; match=&quot;/&quot;>&lt;ns0:RICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns2:MigrazioniResponse/tns2:TIPO_COMUNICAZIONE = &amp;quot;10&amp;quot; or $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns2:MigrazioniResponse/tns2:TIPO_COMUN