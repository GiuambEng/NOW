OLITE') and  string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='QUALIFICA']/valoreAttributo)>0 and upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='QUALIFICA']/valoreAttributo)='SI' and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)>0 and  (upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='NAKED' or upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEA']/valoreAttributo)='LineaNonFonia' ) and exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO'])) and (count($Oscuramento/Record[COD_AGESP='R1I-20-0012'])=0 or (count($Oscuramento/Record[COD_AGESP='R1I-20-0012'])>0 and $Oscuramento/Record[COD_AGESP='R1I-20-0012']/FLAG_OSCURMENTO='0')) and ($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TipologiaNotifica='OK')&quot;>&lt;ns0:DATI_TEST>&lt;ns0:QUALIFICA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRDOWN']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRDOWN']/valoreAttributo&quot;>&lt;ns0:MBR_DOWN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRDOWN']/valoreAttributo&quot;/>&lt;/ns0:MBR_DOWN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRUP']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRUP']/valoreAttributo&quot;>&lt;ns0:MBR_UP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRUP']/valoreAttributo&quot;/>&lt;/ns0:MBR_UP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRDOWN']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRDOWN']/valoreAttributo&quot;>&lt;ns0:CBR_DOWN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRDOWN']/valoreAttributo&quot;/>&lt;/ns0:CBR_DOWN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRUP']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRUP']/valoreAttributo&quot;>&lt;ns0:CBR_UP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRUP']/valoreAttributo&quot;/>&lt;/ns0:CBR_UP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns0:QUALIFICA>&lt;/ns0:DATI_TEST>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns0:RICHIESTA>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="XDSLMapper-input" name="XDSLMapper"
                    outputVariable="XDSLMapper"
                    tibex:xpdlId="87c29b68-b67f-4724-8338-553cbbd27e65" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty3ToXDSLMapper"/>
                        <bpws:target linkName="GenericLoggerToXDSLMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="XDSLMapperToCopy_1_LogOutputOneStep"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/DATI_VLAN/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;PreventivoOpereSpecialiInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUAppuntamentoElement&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUAccessoElement&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_XDSL_EVENTO_ORDN&quot;/>&#xa;    &lt;xsl:param name=&quot;Numeri&quot;/>&#xa;    &lt;xsl:param name=&quot;DATI_VC&quot;/>&#xa;    &lt;xsl:param name=&quot;DataEsito&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectEVENTO&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;MacroArea&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;XDSLMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:RICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;10&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;11&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;12&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;13&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns2:TIPO_COMUNICAZIONE = &amp;quot;18&amp;quot;) and $GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica != &amp;quot;SM&amp;quot;) or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta='VLANVULA' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta='VLAN'  or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta='VLANNGA' or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta='VP'&quot;/>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns0:DATI_ACCESSO>&#xa;                        &lt;ns0:CODICE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codificaOLONOW&quot;/>&#xa;                        &lt;/ns0:CODICE_ISP>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;ns0:CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/ns0:CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;CODICEASSENTE&amp;quot;&quot;/>&#xa;                                &lt;/ns0:CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceProgetto&quot;>&#xa;                            &lt;ns0:CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceProgetto&quot;/>&#xa;                            &lt;/ns0:CODICE_PROGETTO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRisorsa&quot;>&#xa;                            &lt;ns0:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/ns0:IDENTIFICATIVO_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ns0:NOME>&#xa;                            &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/nome, 1, 20)&quot;/>&#xa;                        &lt;/ns0:NOME>&#xa;                        &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/cognomeRagioneSociale) > 0&quot;>&#xa;                            &lt;ns0:COGNOME>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/cognomeRagioneSociale, 1, 70)&quot;/>&#xa;                            &lt;/ns0:COGNOME>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Numeri/tns2:NUMERO) > 0&quot;>&#xa;                                &lt;ns0:DISTRETTO>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, string(xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/distretto)))&quot;/>&#xa;                                &lt;/ns0:DISTRETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Numeri/tns2:NUMERO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Numeri/tns2:NUMERO&quot;>&#xa;                                    &lt;ns0:NUMERO>&#xa;                                        &lt;xsl:value-of select=&quot;$Numeri/tns2:NUMERO&quot;/>&#xa;                                    &lt;/ns0:NUMERO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or ($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/tipologiaSottolav  = &amp;quot;MIGRAZIONEOLO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/tipologiaSottolav  = &amp;quot;ATTIVAZIONE274&amp;quot;) and ($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;BITSTREAMATMASIMMETRICOHL&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;EASYIPBASEPLUSFLAT&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;EASYIPBASEPLUSLITE&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;EASYIPSPECIALPROFILELITE&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;EASYIPBASEPLUS&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;EASYIPSPECIALPROFILE&amp;quot;))&quot;/>&#xa;                            &lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)), &amp;quot;POTS&amp;quot;)&quot;>&#xa;                                &lt;ns0:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_LINEA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo, &amp;quot;ISDN&amp;quot;)&quot;>&#xa;                                &lt;ns0:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_LINEA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TipologiaNotifica = &amp;quot;RA&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;>&#xa;                                    &lt;ns0:CODICE_ORDINE_PITAGORA>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/ns0:CODICE_ORDINE_PITAGORA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;>&#xa;                                    &lt;ns0:CODICE_ORDINE_PITAGORA>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/codiceOrdineTI&quot;/>&#xa;                                    &lt;/ns0:CODICE_ORDINE_PITAGORA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta = &amp;quot;BITSTREAMATMSIMMETRICOFLAT&amp;quot; or $GenericNotificationIn.NotificaGe