                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/fiberstream&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_PROFILI&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NotificaOAO>&#xa;            &lt;tns2:Accesso>&#xa;                &lt;tns2:TestataNotifica>&#xa;                    &lt;tns2:CodiceFornitore>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceFornitore&quot;/>&#xa;                    &lt;/tns2:CodiceFornitore>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;>&#xa;                        &lt;tns2:CodiceOrdineFornitore>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineFornitore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:CodiceOrdineRichiedente>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineRichiedente&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineRichiedente>&#xa;                    &lt;tns2:DataNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataNotifica&quot;/>&#xa;                    &lt;/tns2:DataNotifica>&#xa;                    &lt;tns2:StatoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:StatoOrdine&quot;/>&#xa;                    &lt;/tns2:StatoOrdine>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;>&#xa;                        &lt;tns2:DataDRO>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;/>&#xa;                        &lt;/tns2:DataDRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;>&#xa;                        &lt;tns2:CodiceOrdineOF>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineOF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;>&#xa;                        &lt;tns2:Note>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;/>&#xa;                        &lt;/tns2:Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;>&#xa;                        &lt;tns2:TimestampOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;/>&#xa;                        &lt;/tns2:TimestampOrigine>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:TestataNotifica>&#xa;                &lt;tns2:ConfigurazioneOK>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns2:CodiceISP>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/codificaOLONOW&quot;/>&#xa;                        &lt;/tns2:CodiceISP>&#xa;                        &lt;tns2:CodiceOrdineISP>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/codiceOrdineOLO&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineISP>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/IDRisorsa&quot;>&#xa;                            &lt;tns2:IdentificativoRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/IDRisorsa&quot;/>&#xa;                            &lt;/tns2:IdentificativoRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/nome&quot;>&#xa;                            &lt;tns2:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/nome&quot;/>&#xa;                            &lt;/tns2:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/cognomeRagioneSociale&quot;>&#xa;                            &lt;tns2:Cognome>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/cognomeRagioneSociale&quot;/>&#xa;                            &lt;/tns2:Cognome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:TipoLinea>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                        &lt;/tns2:TipoLinea>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/tipologiaLavorazione=&amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:TipoRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ATT&amp;quot;&quot;/>&#xa;                                &lt;/tns2:TipoRichiesta>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/tipologiaLavorazione=&amp;quot;ATTIVAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:TipoOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/tns2:TipoOrdine>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:TipoServizio>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&#xa;                        &lt;/tns2:TipoServizio>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                                &lt;tns2:DataNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;format-dateTime($JDBCQuery/Record[1]/TIMSTP_INSMTO_EVENTO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:DataNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                                &lt;/tns2:DataNotifica>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:Stato>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Stato>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;>&#xa;                            &lt;tns2:Note>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/note&quot;/>&#xa;                            &lt;/tns2:Note>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:NumeroUserVLAN>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                        &lt;/tns2:NumeroUserVLAN>&#xa;                        &lt;tns2:TaggingAccesso>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Tagged&amp;quot;&quot;/>&#xa;                        &lt;/tns2:TaggingAccesso>&#xa;                        &lt;tns2:Profilo>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ACCESSOFIBERSTREAM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/tns2:Profilo>&#xa;                        &lt;tns2:ProfiloUp>&#xa;                            &lt;xsl:value-of select=&quot;$JDBC_PROFILI/Record[1]/PROFILO_COMMERCIALE_UP&quot;/>&#xa;                        &lt;/tns2:ProfiloUp>&#xa;                        &lt;tns2:ProfiloDown>&#xa;                            &lt;xsl:value-of select=&quot;$JDBC_PROFILI/Record[1]/PROFILO_COMMERCIALE_DOWN&quot;/>&#xa;                        &lt;/tns2:ProfiloDown>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IPADDRESSNET']/valoreAttributo&quot;>&#xa;                            &lt;tns2:IpAddressNet>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IPADDRESSNET']/valoreAttributo&quot;/>&#xa;                            &lt;/tns2:IpAddressNet>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SUBNETMASKNET']/valoreAttributo&quot;>&#xa;                            &lt;tns2:SubnetMaskNet>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SUBNETMASKNET']/valoreAttributo&quot;/>&#xa;                            &lt;/tns2:SubnetMaskNet>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:RemoteID>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente)=&amp;quot;OFDATITECNICI&amp;quot;]/attributiDettaglioOrdine[upper-case(nomeAttributo)=&amp;quot;IDSERVIZIO&amp;quot;]/valoreAttributo&quot;/>&#xa;                        &lt;/tns2:RemoteID>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente)=&amp;quot;OFDATITECNICI&amp;quot;]/attributiDettaglioOrdine[upper-case(nomeAttributo)=&amp;quot;GPONDIATTESTAZIONE&amp;quot;]/valoreAttributo&quot;>&#xa;                            &lt;tns2:GponDiAttestazione>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente)=&amp;quot;OFDATITECNICI&amp;quot;]/attributiDettaglioOrdine[upper-case(nomeAttributo)=&amp;quot;GPONDIATTESTAZIONE&amp;quot;]/valoreAttributo&quot;/>&#xa;                            &lt;/tns2:GponDiAttestazione>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                    &lt;tns2:DatiUserVLAN>&#xa;                        &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIVC']&quot;>&#xa;                            &lt;tns2:UserVLAN>&#xa;                                &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo)>0&quot;>&#xa;                                    &lt;tns2:UserVLANID>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo)&quot;/>&#xa;                                    &lt;/tns2:UserVLANID>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='PROFILOVLAN']/valoreAttributo&quot;>&#xa;                                    &lt;tns2:ClasseServizio>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='PROFILOVLAN']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns2:ClasseServizio>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='VLANAGGREGANTE']/valoreAttributo&quot;>&#xa;                                    &lt;tns2:SVLANCode>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VLANAGGREGANTE']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns2:SVLANCode>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CVLAN']/valoreAttributo)>0&quot;>&#xa;                                    &lt;tns2:CVlanId>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='CVLAN']/valoreAttributo)&quot;/>&#xa;                                    &lt;/tns2:CVlanId>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns2:UserVLAN>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns2:DatiUserVLAN>&#xa;                &lt;/tns2:ConfigurazioneOK>&#xa;            &lt;/tns2:Accesso>&#xa;        &lt;/tns2:NotificaOAO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:fiberstream="http://xsd.telecomitalia.it/crm/fiberstream"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="fiberstream:NotificaOAO" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="GenericLogger1-input"
                    name="GenericLogger1"
                    tibex:xpdlId="7640f18a-836d-40b0-b8bf-cc5f3c4df059"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToGenericNotificationOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;loggername&quot;/>&#xa;    &lt;xsl:param name=&quot;loglevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('NotificaOAO',tib:render-xml($Mapper, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$loggername&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$loglevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d84ff003-9840-43aa-8714-23568a52caeb+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns4:jdbcQueryActivityInput>&lt;ProfiloTecnicoLinea>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ProfiloTecnicoLinea>&lt;Offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta)&quot;>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Offerta>&lt;Provenienza>&lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&lt;/Provenienza>&lt;/tns4:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_PROFILI-input"
                    name="JDBC_PROFILI" outputVariable="JDBC_PROFILI"
                    tibex:xpdlId="d84ff003-9840-43aa-8714-23568a52caeb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBC_PROFILI"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_PROFILIToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d84ff003-9840-43aa-8714-23568a52caeb+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;ProfiloTecnicoLinea>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ProfiloTecnicoLinea>&#xa;            &lt;Offerta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Offerta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Offerta>&#xa;            &lt;Provenienza>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/Provenienza>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PTL.PROFILO_COMMERCIALE_UP, PTL.PROFILO_COMMERCIALE_DOWN&#xa;  FROM PROFILO_TCNC_LINEA PTL, TRASCODFC_OFFERTA TROFF&#xa;  WHERE PTL.PROFILO_TCNC_LINEA = ? AND PTL.ID_OFFERTA = TROFF.ID_OFFERTA AND TROFF.NOME_OFFERTA_ESTERNA = ? AND TROFF.PROVENIENZA = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ProfiloTecnicoLinea"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Offerta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Provenienza"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="PROFILO_COMMERCIALE_UP"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="PROFILO_COMMERCIALE_DOWN"
                                    dataType="1111" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
