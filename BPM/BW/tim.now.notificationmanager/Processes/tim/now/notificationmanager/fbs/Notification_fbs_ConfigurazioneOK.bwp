        &lt;tns:GenericNotificationFault&gt;
            &lt;NotificaGenericaFault&gt;
                &lt;tns1:NotificaGenericaFault&gt;
                    &lt;tns1:Codice&gt;
                        &lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;
                    &lt;/tns1:Codice&gt;
                    &lt;tns1:Descrizione&gt;
                        &lt;xsl:value-of select="concat($FaultDetails/ActivityName,$FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/Class)"/&gt;
                    &lt;/tns1:Descrizione&gt;
                &lt;/tns1:NotificaGenericaFault&gt;
            &lt;/NotificaGenericaFault&gt;
        &lt;/tns:GenericNotificationFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificaGenericaFault>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;tns1:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName,$FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/Class)&quot;/>&#xa;            &lt;/tns1:Descrizione>&#xa;        &lt;/tns1:NotificaGenericaFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToReply1"/>
                            </bpws:targets>
                        </bpws:reply>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;loggername&quot;/>&#xa;    &lt;xsl:param name=&quot;loglevel&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName,$FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/Class)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$loggername&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$loglevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="GenericLogger2-input"
                                name="GenericLogger2"
                                tibex:xpdlId="75cdd61b-8580-4093-a83d-e0f541085a45"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToReply1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;loggername&quot;/>&#xa;    &lt;xsl:param name=&quot;loglevel&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName,$FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/FullClass,$FaultDetails/Class)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$loggername&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$loglevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="GenericNotificationInToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess1ToGenericNotificationOut" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBC_PROFILIToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToJDBC_PROFILI" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes"
                name="GenericNotificationIn"
                operation="GenericNotification"
                partnerLink="Notification_fbs_ConfigurazioneOK"
                portType="ns1:Notification_gpon_Accettazione"
                tibex:xpdlId="bef4288c-2930-4722-b9ed-40feb9537d33" variable="GenericNotificationIn">
                <bpws:sources>
                    <bpws:source linkName="GenericNotificationInToCallProcess"/>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="GenericNotificationOut"
                operation="GenericNotification"
                partnerLink="Notification_fbs_ConfigurazioneOK"
                portType="ns1:Notification_gpon_Accettazione"
                tibex:xpdlId="3727d8a5-b7ce-446f-bbca-5d9a94dd80d3" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns1="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns2="http://xsd.telecomitalia.it/crm/fiberstream" version="2.0"&gt;&lt;xsl:param name="GenericNotificationIn"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns:GenericNotificationResponse&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns1:NotificaGenericaResponse&gt;&lt;tns2:NotificaOAO&gt;&lt;xsl:copy-of select="$Mapper/tns2:Accesso"/&gt;&lt;/tns2:NotificaOAO&gt;&lt;xsl:if test="$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDAnagraficaCausale"&gt;&lt;tns1:IDAnagraficaCausale&gt;&lt;xsl:value-of select="$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDAnagraficaCausale"/&gt;&lt;/tns1:IDAnagraficaCausale&gt;&lt;/xsl:if&gt;&lt;/tns1:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns:GenericNotificationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/fiberstream&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificaGenericaResponse>&#xa;            &lt;tns2:NotificaOAO>&#xa;                &lt;xsl:copy-of select=&quot;$Mapper/tns2:Accesso&quot;/>&#xa;            &lt;/tns2:NotificaOAO>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDAnagraficaCausale&quot;>&#xa;                &lt;tns1:IDAnagraficaCausale>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDAnagraficaCausale&quot;/>&#xa;                &lt;/tns1:IDAnagraficaCausale>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToGenericNotificationOut"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;loggername&quot;/>&#xa;    &lt;xsl:param name=&quot;loglevel&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Notification_fbs_ConfigurazioneOK',tib:render-xml($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$loggername&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$loglevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="GenericLogger-input"
                    name="GenericLogger"
                    tibex:xpdlId="97ed2a46-24ac-4ad0-afcb-521fa08d9837"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericNotificationInToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;loggername&quot;/>&#xa;    &lt;xsl:param name=&quot;loglevel&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_ConfigurazioneOK&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Notification_fbs_ConfigurazioneOK',tib:render-xml($GenericNotificationIn.NotificaGenericaRichiesta, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$loggername&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$loglevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/fiberstream&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_PROFILI&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns2:NotificaOAO>&lt;tns2:Accesso>&lt;tns2:TestataNotifica>&lt;tns2:CodiceFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceFornitore&quot;/>&lt;/tns2:CodiceFornitore>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;>&lt;tns2:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;/>&lt;/tns2:CodiceOrdineFornitore>&lt;/xsl:if>&lt;tns2:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineRichiedente&quot;/>&lt;/tns2:CodiceOrdineRichiedente>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataNotifica&quot;/>&lt;/tns2:DataNotifica>&lt;tns2:StatoOrdine>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:StatoOrdine&quot;/>&lt;/tns2:StatoOrdine>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;>&lt;tns2:DataDRO>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;/>&lt;/tns2:DataDRO>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;>&lt;tns2:CodiceOrdineOF>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;/>&lt;/tns2:CodiceOrdineOF>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;>&lt;tns2:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;/>&lt;/tns2:Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;>&lt;tns2:TimestampOrigine>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;/>&lt;/tns2:TimestampOrigine>&lt;/xsl:if>&lt;/tns2:TestataNotifica>&lt;tns2:ConfigurazioneOK>&lt;tns2:DatiAccesso>&lt;tns2:CodiceISP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codificaOLONOW&quot;/>&lt;/tns2:CodiceISP>&lt;tns2:CodiceOrdineISP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/codiceOrdineOLO&quot;/>&lt;/tns2:CodiceOrdineISP>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/IDRisorsa&quot;>&lt;tns2:IdentificativoRisorsa>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/IDRisorsa&quot;/>&lt;/tns2:IdentificativoRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/nome&quot;>&lt;tns2:Nome>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/nome&quot;/>&lt;/tns2:Nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/cognomeRagioneSociale&quot;>&lt;tns2:Cognome>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/cognomeRagioneSociale&quot;/>&lt;/tns2:Cognome>&lt;/xsl:if>&lt;tns2:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns2:TipoLinea>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/tipologiaLavorazione=&amp;quot;ATTIVAZIONE&amp;quot;&quot;>&lt;tns2:TipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ATT&amp;quot;&quot;/>&lt;/tns2:TipoRichiesta>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/tipologiaLavorazione=&amp;quot;ATTIVAZIONE&amp;quot;&quot;>&lt;tns2:TipoOrdine>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns2:TipoOrdine>&lt;/xsl:when>&lt;/xsl:choose>&lt;tns2:TipoServizio>&lt;xsl:value-of select=&quot;&amp;quot;O&amp;quot;&quot;/>&lt;/tns2:TipoServizio>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime($JDBCQuery/Record[1]/TIMSTP_INSMTO_EVENTO, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns2:DataNotifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;format-dateTime($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/created, &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&lt;/tns2:DataNotifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:Stato>&lt;xsl:value-of select=&quot;&amp;quot;CO&amp;quot;&quot;/>&lt;/tns2:Stato>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/note&quot;>&lt;tns2:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/note&quot;/>&lt;/tns2:Note>&lt;/xsl:if>&lt;tns2:NumeroUserVLAN>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns2:NumeroUserVLAN>&lt;tns2:TaggingAccesso>&lt;xsl:value-of select=&quot;&amp;quot;Tagged&amp;quot;&quot;/>&lt;/tns2:TaggingAccesso>&lt;tns2:Profilo>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ACCESSOFIBERSTREAM&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;PROFILOTECNICOLINEA&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:Profilo>&lt;tns2:ProfiloUp>&lt;xsl:value-of select=&quot;$JDBC_PROFILI/Record[1]/PROFILO_COMMERCIALE_UP&quot;/>&lt;/tns2:ProfiloUp>&lt;tns2:ProfiloDown>&lt;xsl:value-of select=&quot;$JDBC_PROFILI/Record[1]/PROFILO_COMMERCIALE_DOWN&quot;/>&lt;/tns2:ProfiloDown>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IPADDRESSNET']/valoreAttributo&quot;>&lt;tns2:IpAddressNet>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='IPADDRESSNET']/valoreAttributo&quot;/>&lt;/tns2:IpAddressNet>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SUBNETMASKNET']/valoreAttributo&quot;>&lt;tns2:SubnetMaskNet>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIACCESSO']/attributiDettaglioOrdine[nomeAttributo='SUBNETMASKNET']/valoreAttributo&quot;/>&lt;/tns2:SubnetMaskNet>&lt;/xsl:if>&lt;tns2:RemoteID>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente)=&amp;quot;OFDATITECNICI&amp;quot;]/attributiDettaglioOrdine[upper-case(nomeAttributo)=&amp;quot;IDSERVIZIO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:RemoteID>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente)=&amp;quot;OFDATITECNICI&amp;quot;]/attributiDettaglioOrdine[upper-case(nomeAttributo)=&amp;quot;GPONDIATTESTAZIONE&amp;quot;]/valoreAttributo&quot;>&lt;tns2:GponDiAttestazione>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[upper-case(nomeComponente)=&amp;quot;OFDATITECNICI&amp;quot;]/attributiDettaglioOrdine[upper-case(nomeAttributo)=&amp;quot;GPONDIATTESTAZIONE&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:GponDiAttestazione>&lt;/xsl:if>&lt;/tns2:DatiAccesso>&lt;tns2:DatiUserVLAN>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUDATIVC']&quot;>&lt;tns2:UserVLAN>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo)>0&quot;>&lt;tns2:UserVLANID>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='USERVLAN']/valoreAttributo)&quot;/>&lt;/tns2:UserVLANID>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='PROFILOVLAN']/valoreAttributo&quot;>&lt;tns2:ClasseServizio>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='PROFILOVLAN']/valoreAttributo&quot;/>&lt;/tns2:ClasseServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='VLANAGGREGANTE']/valoreAttributo&quot;>&lt;tns2:SVLANCode>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VLANAGGREGANTE']/valoreAttributo&quot;/>&lt;/tns2:SVLANCode>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CVLAN']/valoreAttributo)>0&quot;>&lt;tns2:CVlanId>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='CVLAN']/valoreAttributo)&quot;/>&lt;/tns2:CVlanId>&lt;/xsl:if>&lt;/tns2:UserVLAN>&lt;/xsl:for-each>&lt;/tns2:DatiUserVLAN>&lt;/tns2:ConfigurazioneOK>&lt;/tns2:Accesso>&lt;/tns2:NotificaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
