                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/fiberstream&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificaGenericaResponse>&#xa;            &lt;tns2:NotificaOAO>&#xa;                &lt;xsl:copy-of select=&quot;$Mapper/tns2:Accesso&quot;/>&#xa;            &lt;/tns2:NotificaOAO>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDAnagraficaCausale&quot;>&#xa;                &lt;tns1:IDAnagraficaCausale>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDAnagraficaCausale&quot;/>&#xa;                &lt;/tns1:IDAnagraficaCausale>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToGenericNotificationOut"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;loggername&quot;/>&#xa;    &lt;xsl:param name=&quot;loglevel&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Notification_fbs_DataAppuntamento',tib:render-xml($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$loggername&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$loglevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="GenericLogger-input"
                    name="GenericLogger"
                    tibex:xpdlId="fad3580a-e583-4511-8352-5b45de469562"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericNotificationInToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;loggername&quot;/>&#xa;    &lt;xsl:param name=&quot;loglevel&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_fbs_DataAppuntamento&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Notification_fbs_DataAppuntamento',tib:render-xml($GenericNotificationIn.NotificaGenericaRichiesta, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$loggername&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$loglevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/fiberstream&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns2:NotificaOAO>&lt;tns2:Accesso>&lt;tns2:TestataNotifica>&lt;tns2:CodiceFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceFornitore&quot;/>&lt;/tns2:CodiceFornitore>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;>&lt;tns2:CodiceOrdineFornitore>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;/>&lt;/tns2:CodiceOrdineFornitore>&lt;/xsl:if>&lt;tns2:CodiceOrdineRichiedente>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineRichiedente&quot;/>&lt;/tns2:CodiceOrdineRichiedente>&lt;tns2:DataNotifica>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataNotifica&quot;/>&lt;/tns2:DataNotifica>&lt;tns2:StatoOrdine>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:StatoOrdine&quot;/>&lt;/tns2:StatoOrdine>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;>&lt;tns2:DataDRO>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;/>&lt;/tns2:DataDRO>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;>&lt;tns2:CodiceOrdineOF>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;/>&lt;/tns2:CodiceOrdineOF>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;>&lt;tns2:Note>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;/>&lt;/tns2:Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;>&lt;tns2:TimestampOrigine>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;/>&lt;/tns2:TimestampOrigine>&lt;/xsl:if>&lt;/tns2:TestataNotifica>&lt;tns2:DataAppuntamento>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAAPPUNTAMENTO&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:NuovaDA>&lt;xsl:value-of select=&quot;format-date(xsd:date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAAPPUNTAMENTO&amp;quot;]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns2:NuovaDA>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAPREVISTAATTIVAZIONE&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:NuovaDA>&lt;xsl:value-of select=&quot;format-date(xsd:date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAPREVISTAATTIVAZIONE&amp;quot;]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns2:NuovaDA>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORAAPPUNTAMENTO&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:OraAppuntamento>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORAAPPUNTAMENTO&amp;quot;]/valoreAttributo, 1, 2)&quot;/>&lt;/tns2:OraAppuntamento>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORARIOAPPUNTAMENTO&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:OraAppuntamento>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORARIOAPPUNTAMENTO&amp;quot;]/valoreAttributo, 1, 2)&quot;/>&lt;/tns2:OraAppuntamento>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo) > 0) and exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente)&quot;>&lt;tns2:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&lt;/tns2:ReferenteContattato>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ORFDAC&amp;quot;])>0&quot;>&lt;tns2:ReferenteContattato>&lt;xsl:value-of select=&quot;concat($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ORFDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;NOMECLIENTE&amp;quot;]/valoreAttributo,&amp;quot; &amp;quot;,$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ORFDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo= &amp;quot;COGNOMECLIENTE&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns2:ReferenteContattato>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente) and count($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;])>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo) = 0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;>&lt;tns2:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&lt;/tns2:TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;>&lt;tns2:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&lt;/tns2:TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;>&lt;tns2:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&lt;/tns2:TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;>&lt;tns2:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&lt;/tns2:TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;])>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE&amp;quot;]/valoreAttributo&quot;>&lt;tns2:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE2&amp;quot;]/valoreAttributo&quot;>&lt;tns2:TelefonoReferenteContattato>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE2&amp;quot;]/valoreAttributo&quot;/>&lt;/tns2:TelefonoReferenteContattato>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATADT&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:DataContatto>&lt;xsl:value-of select=&quot;format-date(xsd:date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATADT&amp;quot;]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns2:DataContatto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATAORA&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns2:OraContatto>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATAORA&amp;quot;]/valoreAttributo, 1, 5)&quot;/>&lt;/tns2:OraContatto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns2:TipoAppuntamento>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns2:TipoAppuntamento>&lt;/tns2:DataAppuntamento>&lt;/tns2:Accesso>&lt;/tns2:NotificaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Mapper-input" name="Mapper"
                    outputVariable="Mapper"
                    tibex:xpdlId="cbe0fdc8-ee0c-4186-a4e1-e6001b2db25d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/fiberstream&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NotificaOAO>&#xa;            &lt;tns2:Accesso>&#xa;                &lt;tns2:TestataNotifica>&#xa;                    &lt;tns2:CodiceFornitore>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceFornitore&quot;/>&#xa;                    &lt;/tns2:CodiceFornitore>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;>&#xa;                        &lt;tns2:CodiceOrdineFornitore>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineFornitore&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineFornitore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:CodiceOrdineRichiedente>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineRichiedente&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineRichiedente>&#xa;                    &lt;tns2:DataNotifica>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataNotifica&quot;/>&#xa;                    &lt;/tns2:DataNotifica>&#xa;                    &lt;tns2:StatoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:StatoOrdine&quot;/>&#xa;                    &lt;/tns2:StatoOrdine>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;>&#xa;                        &lt;tns2:DataDRO>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:DataDRO&quot;/>&#xa;                        &lt;/tns2:DataDRO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;>&#xa;                        &lt;tns2:CodiceOrdineOF>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:CodiceOrdineOF&quot;/>&#xa;                        &lt;/tns2:CodiceOrdineOF>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;>&#xa;                        &lt;tns2:Note>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:Note&quot;/>&#xa;                        &lt;/tns2:Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;>&#xa;                        &lt;tns2:TimestampOrigine>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:TestataFBS/tns1:TimestampOrigine&quot;/>&#xa;                        &lt;/tns2:TimestampOrigine>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:TestataNotifica>&#xa;                &lt;tns2:DataAppuntamento>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAAPPUNTAMENTO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;tns2:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(xsd:date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAAPPUNTAMENTO&amp;quot;]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:NuovaDA>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAPREVISTAATTIVAZIONE&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;tns2:NuovaDA>&#xa;                                &lt;xsl:value-of select=&quot;format-date(xsd:date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;DATAPREVISTAATTIVAZIONE&amp;quot;]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:NuovaDA>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORAAPPUNTAMENTO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;tns2:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORAAPPUNTAMENTO&amp;quot;]/valoreAttributo, 1, 2)&quot;/>&#xa;                            &lt;/tns2:OraAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORARIOAPPUNTAMENTO&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;tns2:OraAppuntamento>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;ORARIOAPPUNTAMENTO&amp;quot;]/valoreAttributo, 1, 2)&quot;/>&#xa;                            &lt;/tns2:OraAppuntamento>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo) > 0) and exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente)&quot;>&#xa;                            &lt;tns2:ReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot;]/valoreAttributo)]/cognomeReferente, &amp;quot; &amp;quot;, $GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/nomeReferente)&quot;/>&#xa;                            &lt;/tns2:ReferenteContattato>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ORFDAC&amp;quot;])>0&quot;>&#xa;                            &lt;tns2:ReferenteContattato>&#xa;                                &lt;xsl:value-of select=&quot;concat($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ORFDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;NOMECLIENTE&amp;quot;]/valoreAttributo,&amp;quot; &amp;quot;,$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ORFDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo= &amp;quot;COGNOMECLIENTE&amp;quot;]/valoreAttributo)&quot;/>&#xa;                            &lt;/tns2:ReferenteContattato>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente) and count($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;])>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo) = 0&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;>&#xa;                                                &lt;tns2:TelefonoReferenteContattato>&#xa;                                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoFissoReferente&quot;/>&#xa;                                                &lt;/tns2:TelefonoReferenteContattato>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;>&#xa;                                                &lt;tns2:TelefonoReferenteContattato>&#xa;                                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[1]/telefonoMobileReferente&quot;/>&#xa;                                                &lt;/tns2:TelefonoReferenteContattato>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;>&#xa;                                        &lt;tns2:TelefonoReferenteContattato>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoFissoReferente&quot;/>&#xa;                                        &lt;/tns2:TelefonoReferenteContattato>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;>&#xa;                                        &lt;tns2:TelefonoReferenteContattato>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/referente[progressivoReferente = xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;PROGRESSIVO&amp;quot; and string(created) = $Variable/tns1:DTUElement[last()]]/valoreAttributo)]/telefonoMobileReferente&quot;/>&#xa;                                        &lt;/tns2:TelefonoReferenteContattato>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;])>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;tns2:TelefonoReferenteContattato>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/tns2:TelefonoReferenteContattato>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE2&amp;quot;]/valoreAttributo&quot;>&#xa;                                        &lt;tns2:TelefonoReferenteContattato>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;OFRDAC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;RECAPITOTELEFONICOCLIENTE2&amp;quot;]/valoreAttributo&quot;/>&#xa;                                        &lt;/tns2:TelefonoReferenteContattato>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATADT&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;tns2:DataContatto>&#xa;                                &lt;xsl:value-of select=&quot;format-date(xsd:date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATADT&amp;quot;]/valoreAttributo), &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns2:DataContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATAORA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                            &lt;tns2:OraContatto>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;DTUAPPUNTAMENTO&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;TELEFONATAORA&amp;quot;]/valoreAttributo, 1, 5)&quot;/>&#xa;                            &lt;/tns2:OraContatto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns2:TipoAppuntamento>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TipoAppuntamento>&#xa;                &lt;/tns2:DataAppuntamento>&#xa;            &lt;/tns2:Accesso>&#xa;        &lt;/tns2:NotificaOAO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
