                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOAO>&#xa;            &lt;tns:AccessoGPON>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:Testata/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:Testata/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:Testata/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:InCaricoADelivery>&#xa;                    &lt;tns:DataInizioLavorazione>&#xa;                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/DRO, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataInizioLavorazione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;tib:compare-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata,$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DAC)=1&quot;>&#xa;                                    &lt;tns:NuovaDAI>&#xa;                                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NuovaDAI>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns:NuovaDAI>&#xa;                                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/tns:NuovaDAI>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:NuovaDAI>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns:NuovaDAI>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDFasciaOraria&quot;>&#xa;                        &lt;tns:FasciaOraria>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDFasciaOraria&quot;/>&#xa;                        &lt;/tns:FasciaOraria>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:InCaricoADelivery>&#xa;            &lt;/tns:AccessoGPON>&#xa;        &lt;/tns:NotificaOAO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
