            <bpws:receive createInstance="yes"
                name="GenericNotificationIn"
                operation="GenericNotification"
                partnerLink="Notification_gpon_NotificaRimodAppuntamento"
                portType="ns7:Notification_gpon_NotificaRimodAppuntamento"
                tibex:xpdlId="6921ca18-b58d-4e2b-b8e7-2776e5e5acf8" variable="GenericNotificationIn">
                <bpws:sources>
                    <bpws:source linkName="GenericNotificationInToLOG_RimodulazioneDAD">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GenericNotificationInToJDBC_KO">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TestataNotifica/tns2:Testata/ns9:StatoOrdine != &quot;0&quot; and string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDAnagraficaCausale)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TestataNotifica/tns2:Testata/ns9:StatoOrdine != "0" and string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDAnagraficaCausale)) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="GenericNotificationInToLOG_ErrorIDCausale">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TestataNotifica/tns2:Testata/ns9:StatoOrdine != &quot;0&quot; and string-length(string($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDAnagraficaCausale)) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TestataNotifica/tns2:Testata/ns9:StatoOrdine != "0" and string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDAnagraficaCausale)) = 0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="GenericNotificationOut"
                operation="GenericNotification"
                partnerLink="Notification_gpon_NotificaRimodAppuntamento"
                portType="ns7:Notification_gpon_NotificaRimodAppuntamento"
                tibex:xpdlId="cc43f4f2-9a90-4e3d-9e7e-c02d3bbeb9e2" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns2="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns="http://xsd.telecomitalia.it/crm/fibercop" version="2.0"&gt;&lt;xsl:param name="GPONMapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns4:GenericNotificationResponse&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns2:NotificaGenericaResponse&gt;&lt;xsl:copy-of select="$GPONMapper"/&gt;&lt;/tns2:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns4:GenericNotificationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GPONMapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NotificaGenericaResponse>&#xa;            &lt;xsl:copy-of select=&quot;$GPONMapper&quot;/>&#xa;        &lt;/tns2:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="MapperToGenericNotificationOut"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ecfe0524-b90d-41c1-88f4-26b27db39581+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:template name=&quot;JDBC_CAUSALE-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDAnagraficaCausale>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDAnagraficaCausale)&quot;>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns3:NotificaGenericaRequest/tns3:Richiesta/IDAnagraficaCausale&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDAnagraficaCausale>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_CAUSALE-input"
                    name="JDBC_CAUSALE" outputVariable="JDBC_CAUSALE"
