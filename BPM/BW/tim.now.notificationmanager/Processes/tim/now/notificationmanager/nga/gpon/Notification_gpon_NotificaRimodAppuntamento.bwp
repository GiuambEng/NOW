                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationManager/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationManager/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ReplyErrorIDCausale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NotificaGenericaFault>&#xa;            &lt;tns3:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns3:Codice>&#xa;            &lt;tns3:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;IDCausaleAnagrafica deve essere valorizzata in caso di rimodulazione data appuntamento con esito negativo.&amp;quot;&quot;/>&#xa;            &lt;/tns3:Descrizione>&#xa;        &lt;/tns3:NotificaGenericaFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LOG_ErrorIDCausaleToReplyErrorIDCausale"/>
