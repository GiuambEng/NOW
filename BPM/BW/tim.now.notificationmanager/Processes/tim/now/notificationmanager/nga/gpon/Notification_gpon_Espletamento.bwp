            <bpws:receive createInstance="yes"
                name="GenericNotificationIn"
                operation="GenericNotification"
                partnerLink="Notification_gpon_Espletamento"
                portType="ns1:Notification_gpon_Espletamento"
                tibex:xpdlId="bef4288c-2930-4722-b9ed-40feb9537d33" variable="GenericNotificationIn">
                <bpws:sources>
                    <bpws:source linkName="GenericNotificationInToGenericLogger">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:receive>
            <bpws:reply name="GenericNotificationOut"
                operation="GenericNotification"
                partnerLink="Notification_gpon_Espletamento"
                portType="ns1:Notification_gpon_Espletamento"
                tibex:xpdlId="3727d8a5-b7ce-446f-bbca-5d9a94dd80d3" variable="GenericNotificationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/GenericNotification/" xmlns:tns1="http://www.tim.com/NOW/xsd/GenericNotification" xmlns:tns2="http://xsd.telecomitalia.it/crm/fibercop" version="2.0"&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="GenericNotificationOut-input" match="/"&gt;&lt;tns:GenericNotificationResponse&gt;&lt;NotificaGenericaRisposta&gt;&lt;tns1:NotificaGenericaResponse&gt;&lt;tns2:NotificaOAO&gt;&lt;tns2:AccessoGPON&gt;&lt;xsl:copy-of select="$Mapper/tns2:AccessoGPON/tns2:TestataNotifica"/&gt;&lt;tns2:Espletamento&gt;&lt;tns2:IdRisorsa&gt;&lt;xsl:value-of select="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:IdRisorsa"/&gt;&lt;/tns2:IdRisorsa&gt;&lt;tns2:TipologiaAccessoUBB&gt;&lt;xsl:value-of select="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:TipologiaAccessoUBB"/&gt;&lt;/tns2:TipologiaAccessoUBB&gt;&lt;tns2:DataEspletamento&gt;&lt;xsl:value-of select="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:DataEspletamento"/&gt;&lt;/tns2:DataEspletamento&gt;&lt;xsl:if test="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:OrarioDataEspletamento"&gt;&lt;tns2:OrarioDataEspletamento&gt;&lt;xsl:value-of select="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:OrarioDataEspletamento"/&gt;&lt;/tns2:OrarioDataEspletamento&gt;&lt;/xsl:if&gt;&lt;xsl:copy-of select="$Mapper/tns2:AccessoGPON/tns2:Espletamento/tns2:Rifiuto"/&gt;&lt;xsl:for-each select="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:ServiziOpzionali[string-length(tns2:CodiceServizio)&gt;0]"&gt;&lt;tns2:ServiziOpzionali&gt;&lt;tns2:CodiceServizio&gt;&lt;xsl:value-of select="tns2:CodiceServizio"/&gt;&lt;/tns2:CodiceServizio&gt;&lt;xsl:if test="tns2:Esito"&gt;&lt;tns2:Esito&gt;&lt;xsl:value-of select="tns2:Esito"/&gt;&lt;/tns2:Esito&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:CausaleEsito"&gt;&lt;tns2:CausaleEsito&gt;&lt;xsl:value-of select="tns2:CausaleEsito"/&gt;&lt;/tns2:CausaleEsito&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:DescrizioneEsito"&gt;&lt;tns2:DescrizioneEsito&gt;&lt;xsl:value-of select="tns2:DescrizioneEsito"/&gt;&lt;/tns2:DescrizioneEsito&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns2:Note"&gt;&lt;tns2:Note&gt;&lt;xsl:value-of select="tns2:Note"/&gt;&lt;/tns2:Note&gt;&lt;/xsl:if&gt;&lt;/tns2:ServiziOpzionali&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:IdGPON"&gt;&lt;tns2:IdGPON&gt;&lt;xsl:value-of select="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:IdGPON"/&gt;&lt;/tns2:IdGPON&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:AltroIdGPON"&gt;&lt;tns2:AltroIdGPON&gt;&lt;xsl:value-of select="$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:AltroIdGPON"/&gt;&lt;/tns2:AltroIdGPON&gt;&lt;/xsl:if&gt;&lt;/tns2:Espletamento&gt;&lt;/tns2:AccessoGPON&gt;&lt;/tns2:NotificaOAO&gt;&lt;/tns1:NotificaGenericaResponse&gt;&lt;/NotificaGenericaRisposta&gt;&lt;/tns:GenericNotificationResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/GenericNotification/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns2=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericNotificationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NotificaGenericaResponse>&#xa;            &lt;tns2:NotificaOAO>&#xa;                &lt;tns2:AccessoGPON>&#xa;                    &lt;xsl:copy-of select=&quot;$Mapper/tns2:AccessoGPON/tns2:TestataNotifica&quot;/>&#xa;                    &lt;tns2:Espletamento>&#xa;                        &lt;tns2:IdRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:IdRisorsa&quot;/>&#xa;                        &lt;/tns2:IdRisorsa>&#xa;                        &lt;tns2:TipologiaAccessoUBB>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:TipologiaAccessoUBB&quot;/>&#xa;                        &lt;/tns2:TipologiaAccessoUBB>&#xa;                        &lt;tns2:DataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:DataEspletamento&quot;/>&#xa;                        &lt;/tns2:DataEspletamento>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:OrarioDataEspletamento&quot;>&#xa;                            &lt;tns2:OrarioDataEspletamento>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:OrarioDataEspletamento&quot;/>&#xa;                            &lt;/tns2:OrarioDataEspletamento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:copy-of select=&quot;$Mapper/tns2:AccessoGPON/tns2:Espletamento/tns2:Rifiuto&quot;/>&#xa;                        &lt;xsl:for-each select=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:ServiziOpzionali[string-length(tns2:CodiceServizio)>0]&quot;>&#xa;                            &lt;tns2:ServiziOpzionali>&#xa;                                &lt;tns2:CodiceServizio>&#xa;                                    &lt;xsl:value-of select=&quot;tns2:CodiceServizio&quot;/>&#xa;                                &lt;/tns2:CodiceServizio>&#xa;                                &lt;xsl:if test=&quot;tns2:Esito&quot;>&#xa;                                    &lt;tns2:Esito>&#xa;                                        &lt;xsl:value-of select=&quot;tns2:Esito&quot;/>&#xa;                                    &lt;/tns2:Esito>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns2:CausaleEsito&quot;>&#xa;                                    &lt;tns2:CausaleEsito>&#xa;                                        &lt;xsl:value-of select=&quot;tns2:CausaleEsito&quot;/>&#xa;                                    &lt;/tns2:CausaleEsito>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns2:DescrizioneEsito&quot;>&#xa;                                    &lt;tns2:DescrizioneEsito>&#xa;                                        &lt;xsl:value-of select=&quot;tns2:DescrizioneEsito&quot;/>&#xa;                                    &lt;/tns2:DescrizioneEsito>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;tns2:Note&quot;>&#xa;                                    &lt;tns2:Note>&#xa;                                        &lt;xsl:value-of select=&quot;tns2:Note&quot;/>&#xa;                                    &lt;/tns2:Note>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns2:ServiziOpzionali>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:IdGPON&quot;>&#xa;                            &lt;tns2:IdGPON>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:IdGPON&quot;/>&#xa;                            &lt;/tns2:IdGPON>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:AltroIdGPON&quot;>&#xa;                            &lt;tns2:AltroIdGPON>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns2:AccessoGPON[1]/tns2:Espletamento/tns2:AltroIdGPON&quot;/>&#xa;                            &lt;/tns2:AltroIdGPON>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:Espletamento>&#xa;                &lt;/tns2:AccessoGPON>&#xa;            &lt;/tns2:NotificaOAO>&#xa;        &lt;/tns1:NotificaGenericaResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GenericLogger1ToGenericNotificationOut"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQueryAnag_GPON&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:NotificaOAO>&lt;tns:AccessoGPON>&lt;tns:TestataNotifica>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:Testata/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:Testata/@*&quot;/>&lt;xsl:copy-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:TestataNotifica/tns1:Testata/node()&quot;/>&lt;/tns:TestataNotifica>&lt;tns:Espletamento>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/IDRisorsa&quot;/>&lt;/tns:IdRisorsa>&lt;tns:TipologiaAccessoUBB>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIAACCESSOUBB']/valoreAttributo&quot;/>&lt;/tns:TipologiaAccessoUBB>&lt;tns:DataEspletamento>&lt;xsl:value-of select=&quot;format-date($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&lt;/tns:DataEspletamento>&lt;xsl:if test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/ORA_DES)&quot;>&lt;tns:OrarioDataEspletamento>&lt;xsl:value-of select=&quot;substring(xsd:string($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/ORA_DES), 1, 5)&quot;/>&lt;/tns:OrarioDataEspletamento>&lt;/xsl:if>&lt;xsl:if test=&quot;count($JDBCQuery/Record)>0&quot;>&lt;tns:Rifiuto>&lt;tns:CodiceMotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_CAUS_OLO&quot;/>&lt;/tns:CodiceMotivoRifiuto>&lt;tns:MotivoRifiuto>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESCR_CAUS_OLO&quot;/>&lt;/tns:MotivoRifiuto>&lt;/tns:Rifiuto>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&lt;tns:ServiziOpzionali>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo)>0&quot;>&lt;tns:CodiceServizio>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&lt;/tns:CodiceServizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodiceServizio>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CodiceServizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;>&lt;tns:Esito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;/>&lt;/tns:Esito>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;>&lt;tns:CausaleEsito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;/>&lt;/tns:CausaleEsito>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;>&lt;tns:DescrizioneEsito>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;/>&lt;/tns:DescrizioneEsito>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:ServiziOpzionali>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQueryAnag_GPON/Record)>0&quot;>&lt;xsl:if test=&quot;$JDBCQueryAnag_GPON/Record[1]/IDENTIFICATIVO_GPON&quot;>&lt;tns:IdGPON>&lt;xsl:value-of select=&quot;$JDBCQueryAnag_GPON/Record[1]/IDENTIFICATIVO_GPON&quot;/>&lt;/tns:IdGPON>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDGPON']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDGPON']/valoreAttributo&quot;>&lt;tns:IdGPON>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDGPON']/valoreAttributo&quot;/>&lt;/tns:IdGPON>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUNOTIFICHEOLO']/attributiDettaglioOrdine[nomeAttributo='NOTEPEROLO']/valoreAttributo)>0 and $JDBCQuery/Record[1]/COD_CAUS_OLO='Z54'&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUNOTIFICHEOLO']/attributiDettaglioOrdine[nomeAttributo='NOTEPEROLO']/valoreAttributo&quot;>&lt;tns:AltroIdGPON>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns1:NotificaGenericaRequest/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUNOTIFICHEOLO']/attributiDettaglioOrdine[nomeAttributo='NOTEPEROLO']/valoreAttributo&quot;/>&lt;/tns:AltroIdGPON>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:Espletamento>&lt;/tns:AccessoGPON>&lt;/tns:NotificaOAO>&lt;/xsl:template>&lt;/xsl:stylesheet>"
