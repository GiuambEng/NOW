                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/fibercop&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryAnag_GPON&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NotificaOAO>&#xa;            &lt;tns:AccessoGPON>&#xa;                &lt;tns:TestataNotifica>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:Testata/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:Testata/@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:TestataNotifica/tns1:Testata/node()&quot;/>&#xa;                &lt;/tns:TestataNotifica>&#xa;                &lt;tns:Espletamento>&#xa;                    &lt;tns:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/IDRisorsa&quot;/>&#xa;                    &lt;/tns:IdRisorsa>&#xa;                    &lt;tns:TipologiaAccessoUBB>&#xa;                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLOGIAACCESSOUBB']/valoreAttributo&quot;/>&#xa;                    &lt;/tns:TipologiaAccessoUBB>&#xa;                    &lt;tns:DataEspletamento>&#xa;                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns:DataEspletamento>&#xa;                    &lt;xsl:if test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/ORA_DES)&quot;>&#xa;                        &lt;tns:OrarioDataEspletamento>&#xa;                            &lt;xsl:value-of select=&quot;substring(xsd:string($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/ORA_DES), 1, 5)&quot;/>&#xa;                        &lt;/tns:OrarioDataEspletamento>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                        &lt;tns:Rifiuto>&#xa;                            &lt;tns:CodiceMotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                            &lt;/tns:CodiceMotivoRifiuto>&#xa;                            &lt;tns:MotivoRifiuto>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                            &lt;/tns:MotivoRifiuto>&#xa;                        &lt;/tns:Rifiuto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&#xa;                        &lt;tns:ServiziOpzionali>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;tns:CodiceServizio>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[