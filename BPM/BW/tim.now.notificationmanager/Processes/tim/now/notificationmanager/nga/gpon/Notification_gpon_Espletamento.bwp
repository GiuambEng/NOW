                <bpws:link name="MapperToGenericLogger1" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBCQueryToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToReply" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="GenericLoggerToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLogger1ToGenericNotificationOut" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToJDBCQueryAnag_GPON" tibex:linkType="SUCCESSWITHCONDITION"/>
