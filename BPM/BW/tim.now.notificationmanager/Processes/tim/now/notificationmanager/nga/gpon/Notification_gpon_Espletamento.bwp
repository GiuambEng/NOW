                                &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;>&#xa;                                    &lt;tns:DescrizioneEsito>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;/>&#xa;                                    &lt;/tns:DescrizioneEsito>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&#xa;                                        &lt;tns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/tns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns:ServiziOpzionali>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($JDBCQueryAnag_GPON/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBCQueryAnag_GPON/Record[1]/IDENTIFICATIVO_GPON&quot;>&#xa;                                &lt;tns:IdGPON>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCQueryAnag_GPON/Record[1]/IDENTIFICATIVO_GPON&quot;/>&#xa;                                &lt;/tns:IdGPON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDGPON']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDGPON']/valoreAttributo&quot;>&#xa;                                &lt;tns:IdGPON>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='IDGPON']/valoreAttributo&quot;/>&#xa;                                &lt;/tns:IdGPON>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUNOTIFICHEOLO']/attributiDettaglioOrdine[nomeAttributo='NOTEPEROLO']/valoreAttributo)>0 and $JDBCQuery/Record[1]/COD_CAUS_OLO='Z54'&quot;>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUNOTIFICHEOLO']/attributiDettaglioOrdine[nomeAttributo='NOTEPEROLO']/valoreAttributo&quot;>&#xa;                            &lt;tns:AltroIdGPON>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns1:Richiesta/ordine/dettaglioordine[nomeComponente='DTUNOTIFICHEOLO']/attributiDettaglioOrdine[nomeAttributo='NOTEPEROLO']/valoreAttributo&quot;/>&#xa;                            &lt;/tns:AltroIdGPON>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Espletamento>&#xa;            &lt;/tns:AccessoGPON>&#xa;        &lt;/tns:NotificaOAO>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
