                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_NGA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_nga&amp;quot;&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_ngaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_CAUSALE/Record)&quot;>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in input:&amp;#xA;&amp;quot;, tib:render-xml($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest, true(), true()), &amp;quot;&amp;#xA;&amp;quot;, &amp;quot;Causale:&amp;#xA;&amp;quot;, $JDBC_CAUSALE/Record[1]/COD_CAUS_OLO, &amp;quot; &amp;quot;, $JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO)&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Notifica in input:&amp;#xA;&amp;quot;, tib:render-xml($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest,true(), true()))&quot;/>&#xa;                        &lt;/tns8:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns8:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns8:LoggerName>&#xa;                &lt;tns8:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns8:LogLevel>&#xa;                &lt;tns8:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns8:LogJMS>&#xa;            &lt;/tns8:GenericLogger>&#xa;            &lt;tns8:ActiveLoggerServices>&#xa;                &lt;tns8:Envelope>&#xa;                    &lt;tns8:Identifier>&#xa;                        &lt;tns8:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.nga&amp;quot;&quot;/>&#xa;                        &lt;/tns8:ServiceName>&#xa;                        &lt;tns8:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Operation>&#xa;                        &lt;tns8:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Source>&#xa;                        &lt;tns8:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns8:BusinessID>&#xa;                        &lt;tns8:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns8:EventType>&#xa;                        &lt;tns8:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;GenericNotification_&amp;quot;,$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns8:trackID>&#xa;                    &lt;/tns8:Identifier>&#xa;                    &lt;tns8:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns8:track_position>&#xa;                    &lt;tns8:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns8:Timestamp>&#xa;                &lt;/tns8:Envelope>&#xa;            &lt;/tns8:ActiveLoggerServices>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
