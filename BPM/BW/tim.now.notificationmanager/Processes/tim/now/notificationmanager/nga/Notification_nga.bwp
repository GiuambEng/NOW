                &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[7]/tns3:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[7]/tns3:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_7>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[7]/tns3:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_7>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[8]/tns3:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[8]/tns3:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_8>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[8]/tns3:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_8>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[9]/tns3:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[9]/tns3:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_9>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[9]/tns3:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_9>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[10]/tns3:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[10]/tns3:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_10>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[10]/tns3:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_10>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codificaOLOAGCOMDonor !=&amp;quot;TLC&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns0:ROUTING_NUMBER_RECIPIENT>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;NUMBERPORTABILITY&amp;quot;][1]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ROUTINGNUMBER&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/ns0:ROUTING_NUMBER_RECIPIENT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES))&quot;>&#xa;                            &lt;ns0:DATA_ESPLETAMENTO_ORDINE>&#xa;                                &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/ns0:DATA_ESPLETAMENTO_ORDINE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineTI&quot;>&#xa;                            &lt;ns0:CODICE_ORDINE_PITAGORA>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineTI&quot;/>&#xa;                            &lt;/ns0:CODICE_ORDINE_PITAGORA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DACRimodulata))&quot;>&#xa;                                &lt;ns0:DAC>&#xa;                                    &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DACRimodulata, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                &lt;/ns0:DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;string-length(string($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DAC))&quot;>&#xa;                                    &lt;ns0:DAC>&#xa;                                        &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DAC, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                                    &lt;/ns0:DAC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns0:DATA_NOTIFICA>&#xa;                            &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                        &lt;/ns0:DATA_NOTIFICA>&#xa;                        &lt;ns0:DATA_RICEZIONE_ORDINE>&#xa;                            &lt;xsl:value-of select=&quot;format-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/dataInvioRichiesta, &amp;quot;[D01]/[M01]/[Y0001]&amp;quot;)&quot;/>&#xa;                        &lt;/ns0:DATA_RICEZIONE_ORDINE>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica='RD' and count($JDBC_CAUSALE/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                &lt;ns0:CodiceCausaleRimodulazione>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                &lt;/ns0:CodiceCausaleRimodulazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica='RD' and count($JDBC_CAUSALE/Record)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;>&#xa;                                &lt;ns0:DescrizioneCausaleRimodulazione>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO&quot;/>&#xa;                                &lt;/ns0:DescrizioneCausaleRimodulazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns0:DATI_MIGRAZIONI>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot;])&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot; and azione !=&amp;quot;D&amp;quot; and azione !=&amp;quot;T&amp;quot;])&quot;>&#xa;                                    &lt;ns0:DATI_UserVlan>&#xa;                                        &lt;xsl:for-each select=&quot;$Dati_UserVlan/tns3:Dati_UserVlan&quot;>&#xa;                                            &lt;xsl:variable name=&quot;S_VLAN_CODE&quot; select=&quot;tns3:S_VLAN_CODE&quot;/>&#xa;                                            &lt;ns0:UserVlan>&#xa;                                                &lt;xsl:if test=&quot;tns3:UserVlan_ID&quot;>&#xa;                                                    &lt;ns0:UserVlan_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;tns3:UserVlan_ID&quot;/>&#xa;                                                    &lt;/ns0:UserVlan_ID>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:choose