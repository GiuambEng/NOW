/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUDATIVC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERAGENT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                        &lt;/tns3:DHCP_OPTION_82_CIRCUIT_ID>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;(((../../../tns2:Offerta='BITSTREAMNGAFTTH' or ../../../tns2:Offerta='BITSTREAMNGAFTTCAB')  and (string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)>0 and upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)='SI' and  string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo)>0 and $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot;]/valoreAttributo='SINGLETAG')) or ((../../../tns2:Offerta='VULAFTTH' or ../../../tns2:Offerta='VULAFTTCAB') and (string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)>0 and upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)='SI' and string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;REMOTEID&amp;quot;]/valoreAttributo)>0 ))) and ((count($Oscuramento/Record[COD_AGESP='R1I-19-0291'])=0) or (count($Oscuramento/Record[COD_AGESP='R1I-19-0291'])>0 and $Oscuramento/Record[COD_AGESP='R1I-19-0291']/FLAG_OSCURMENTO='0')) and (../../../tns2:TipologiaNotifica='OK' or ../../../tns2:TipologiaNotifica='CO' or ../../../tns2:TipologiaNotifica='AQ')&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;REMOTEID&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;REMOTEID&amp;quot;]/valoreAttributo&quot;>&#xa;                                                        &lt;tns3:DHCP_OPTION_82_REMOTE_ID>&#xa;                                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;REMOTEID&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                        &lt;/tns3:DHCP_OPTION_82_REMOTE_ID>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise/>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='FLAGMULTICAST']/valoreAttributo)>0 and attributiDettaglioOrdine[nomeAttributo='FLAGMULTICAST']/valoreAttributo!='ATTRIBUTO IN ELIMINAZIONE'&quot;>&#xa;                                        &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='FLAGMULTICAST']/valoreAttributo&quot;>&#xa;                                            &lt;tns3:FlagMulticast>&#xa;                                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='FLAGMULTICAST']/valoreAttributo&quot;/>&#xa;                                            &lt;/tns3:FlagMulticast>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns3:Dati_UserVlan>&#xa;                            &lt;/xsl:for-each>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:NGA>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Dati_UserVlan"
                    name="Dati_UserVlanAssign"
                    outputVariable="Dati_UserVlan"
                    tibex:xpdlId="c50d00e2-ce42-421d-9236-7dff6ba63e1e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_Result_JDBC_NGA_NOTIFICATIONToDati_COMPUSERVLANSI"/>
                        <bpws:target linkName="LOG_CalcoloReferenteInvokeToDati_COMPUSERVLANSI"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Dati_UserVlanAssignToLOG_Dati_UserVlanAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUAccessoElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;Dati_UserVlan&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:NGA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot; and azione !=&amp;quot;D&amp;quot; and azione !=&amp;quot;T&amp;quot;])&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;USERVLAN&amp;quot; and azione !=&amp;quot;D&amp;quot; and azione !=&amp;quot;T&amp;quot;]&quot;>&#xa;                                &lt;tns3:Dati_UserVlan>&#xa;                                    &lt;xsl:variable name=&quot;UserVlanID&quot; select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo&quot;/>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo) > 0 and attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                            &lt;tns3:UserVlan_ID>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:integer(attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLANID&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                            &lt;/tns3:UserVlan_ID>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                            &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                                &lt;tns3:S_VLAN_CODE>&#xa;                                                    &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo = &amp;quot;SVLANCODE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                &lt;/tns3:S_VLAN_CODE>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;ENCAPSULATION&amp;quot; and string(../created) = $DTUAccessoElement/tns2:DTUElement[last()]]/valoreAttributo = &amp;quot;DOUBLETAG&amp;quot;&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo) > 0 and attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo !=&amp;quot;ATTRIBUTO IN ELIMINAZIONE&amp;quot;&quot;>&#xa;                                                    &lt;tns3:CVLAN_ID>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:integer(attributiDettaglioOrdine[nomeAttributo = &amp;quot;CVLANID&amp;quot;]/valoreAttributo)&quot;/>&#xa;                                                    &lt;/tns3:CVLAN_ID>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise/>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;count($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUDATIVC&amp;quot;]) > 1&quot;>&#xa;                                            &lt;xsl:if test=&quot;((string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)>0 and upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)!='SI') or (string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)=0)) and ../../../tns2:TipologiaNotifica!='AQ'&quot;>&#xa;                                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUDATIVC&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN&amp;quot;]/valoreAttributo = $UserVlanID ]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERAGENT&amp;quot;]/valoreAttributo&quot;>&#xa;                                                    &lt;tns3:INTERMEDIATE_AGENT>&#xa;                                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUDATIVC&amp;quot; and attributiDettaglioOrdine[nomeAttributo = &amp;quot;USERVLAN&amp;quot;]/valoreAttributo = $UserVlanID ]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERAGENT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                    &lt;/tns3:INTERMEDIATE_AGENT>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;((string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)>0 and upper-case($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)!='SI') or (string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERMEDIATEAGENTFULL&amp;quot;]/valoreAttributo)=0)) and ../../../tns2:TipologiaNotifica!='AQ'&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUDATIVC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERAGENT&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                                                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUDATIVC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERAGENT&amp;quot;]/valoreAttributo&quot;>&#xa;                                                                &lt;tns3:INTERMEDIATE_AGENT>&#xa;                                                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;DTUDATIVC&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;INTERAGENT&amp;quot;]/valoreAttributo&quot;/>&#xa;                                                                &lt;/tns3:INTERMEDIATE_AGENT>&#xa;                                                            &lt;/xsl:if>&#xa;            