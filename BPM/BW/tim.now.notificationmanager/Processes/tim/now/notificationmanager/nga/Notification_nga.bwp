ificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRUP']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRUP']/valoreAttributo&quot;>&lt;ns0:MBR_UP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='MBRUP']/valoreAttributo&quot;/>&lt;/ns0:MBR_UP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRDOWN']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRDOWN']/valoreAttributo&quot;>&lt;ns0:CBR_DOWN>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRDOWN']/valoreAttributo&quot;/>&lt;/ns0:CBR_DOWN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRUP']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRUP']/valoreAttributo&quot;>&lt;ns0:CBR_UP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='CBRUP']/valoreAttributo&quot;/>&lt;/ns0:CBR_UP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns0:QUALIFICA>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione='MIGRAZIONE' or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') and  ($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='VULAFTTCAB' or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='BITSTREAMNGAFTTCAB') and  string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TEST2']/valoreAttributo)>0 and upper-case($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TEST2']/valoreAttributo)='SI' and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo)>0 and  $JDBCQuery/Record[1]/ONESTEP!='SI')&quot;>&lt;ns0:TEST2>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo&quot;>&lt;ns0:INDIRIZZO_IP_DESTINAZIONE>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo&quot;/>&lt;/ns0:INDIRIZZO_IP_DESTINAZIONE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns0:TEST2>&lt;/xsl:when>&lt;xsl:when test=&quot;(($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione='MIGRAZIONE' or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') and  ($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='VULAFTTCAB' or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='BITSTREAMNGAFTTCAB') and string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo)>0 and  $JDBCQuery/Record[1]/ONESTEP ='SI')&quot;>&lt;ns0:TEST2>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo&quot;>&lt;ns0:INDIRIZZO_IP_DESTINAZIONE>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo&quot;/>&lt;/ns0:INDIRIZZO_IP_DESTINAZIONE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns0:TEST2>&lt;/xsl:when>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione='MIGRAZIONE' or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione='ATTIVAZIONE') &amp;#xD;&amp;#xA;and $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='EASYIPNGAFTTCAB'&quot;>&lt;ns0:TEST2>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo&quot;>&lt;ns0:INDIRIZZO_IP_DESTINAZIONE>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']/attributiDettaglioOrdine[nomeAttributo='INDIRIZZOIPDESTINAZIONE']/valoreAttributo&quot;/>&lt;/ns0:INDIRIZZO_IP_DESTINAZIONE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns0:TEST2>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns0:DATI_TEST>&lt;/xsl:if>&lt;/ns0:RICHIESTA>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="NGAMapper-input" name="NGAMapper"
                    outputVariable="NGAMapper"
                    tibex:xpdlId="87c29b68-b67f-4724-8338-553cbbd27e65" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty4ToNGAMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NGAMapperToCopy_1_LogONESTEP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b63d3bf6-27a3-4dcb-b870-760a3bbb6ff3+output&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/DATI_VLAN/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn.NotificaGenericaRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;PreventivoOpereSpecialiInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcoloReferenteInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_NGA_EVENTO_ORDINE_NOW&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_NGA_NOTIFICATION&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUAppuntamentoElement&quot;/>&#xa;    &lt;xsl:param name=&quot;DTUAccessoElement&quot;/>&#xa;    &lt;xsl:param name=&quot;Numeri&quot;/>&#xa;    &lt;xsl:param name=&quot;Dati_UserVlan&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateDatiUservlan&quot;/>&#xa;    &lt;xsl:param name=&quot;DataEsito&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectEVENTO&quot;/>&#xa;    &lt;xsl:param name=&quot;MacroArea&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:template name=&quot;NGAMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:RICHIESTA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;10&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;11&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;12&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;13&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;18&amp;quot;) and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica !=&amp;quot;SM&amp;quot;) or ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLANVULA' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLAN'  or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLANNGA')&quot;/>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns0:DATI_ACCESSO>&#xa;                        &lt;ns0:CODICE_ISP>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codificaOLONOW&quot;/>&#xa;                        &lt;/ns0:CODICE_ISP>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineOLO) > 0&quot;>&#xa;                                &lt;ns0:CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                &lt;/ns0:CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_ORDINE_ISP>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;CODICEASSENTE&amp;quot;&quot;/>&#xa;                                &lt;/ns0:CODICE_ORDINE_ISP>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceProgetto&quot;>&#xa;                            &lt;ns0:CODICE_PROGETTO>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceProgetto&quot;/>&#xa;                            &lt;/ns0:CODICE_PROGETTO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica=(&amp;quot;KO&amp;quot;,&amp;quot;OR&amp;quot;,&amp;quot;RA&amp;quot;)&quot;>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDRisorsa&quot;>&#xa;                                    &lt;ns0:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDRisorsa&quot;/>&#xa;                                    &lt;/ns0:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/IDRisorsa&quot;>&#xa;                                    &lt;ns0:IDENTIFICATIVO_RISORSA>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/IDRisorsa&quot;/>&#xa;                                    &lt;/ns0:IDENTIFICATIVO_RISORSA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/nome&quot;>&#xa;                            &lt;ns0:NOME>&#xa;                                &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/nome&quot;/>&#xa;                            &lt;/ns0:NOME>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/cognomeRagioneSociale) > 0&quot;>&#xa;                            &lt;ns0:COGNOME>&#xa;                                &lt;xsl:value-of select=&quot;substring($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/cognomeRagioneSociale, 1, 70)&quot;/>&#xa;                            &lt;/ns0:COGNOME>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Numeri/tns3:NUMERO) > 0&quot;>&#xa;                                &lt;ns0:DISTRETTO>&#xa;                                    &lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, string(xsd:int($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/distretto)))&quot;/>&#xa;                                &lt;/ns0:DISTRETTO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Numeri/tns3:NUMERO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Numeri/tns3:NUMERO&quot;>&#xa;                                    &lt;ns0:NUMERO>&#xa;                                        &lt;xsl:value-of select=&quot;$Numeri/tns3:NUMERO&quot;/>&#xa;                                    &lt;/ns0:NUMERO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)), &amp;quot;POTS&amp;quot;)&quot;>&#xa;                                &lt;ns0:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_LINEA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)), &amp;quot;ISDN&amp;quot;)&quot;>&#xa;                                &lt;ns0:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_LINEA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:TIPO_LINEA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_LINEA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;RA&amp;quot;&quot;>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineOLO&quot;>&#xa;                                    &lt;ns0:CODICE_ORDINE_PITAGORA>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineOLO&quot;/>&#xa;                                    &lt;/ns0:CODICE_ORDINE_PITAGORA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineTI&quot;>&#xa;                                    &lt;ns0:CODICE_ORDINE_PITAGORA>&#xa;                                        &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineTI&quot;/>&#xa;                                    &lt;/ns0:CODICE_ORDINE_PITAGORA>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceTrasformazione='TCOND_NAKED' and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/tipologiaScenario='TCONDNAKED'&quot;>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;'VTR'&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ATT&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;MIG&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VAR&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;DIS&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ANN&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;RDA&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:TIPO_RICHIESTA>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;DES&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_RICHIESTA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_ORDINE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_ORDINE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_ORDINE>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_ORDINE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;SEMIEASYIPNGAFTTH&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;'Z'&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;'V'&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;SEMIVULAFTTH&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;'U'&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;RA&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;RR&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;R&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;EASYIPNGAFTTCAB&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;T&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;FULLGPONPLUS&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta = &amp;quot;FULLGPONPLUSNGA&amp;quot;&quot;>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;W&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:TIPO_SERVIZIO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                                &lt;/ns0:TIPO_SERVIZIO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica='KO' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica='OK') and exists($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES)&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/ORA_DES)&quot;>&#xa;                                        &lt;ns0:DATA_NOTIFICA>&#xa;                                            &lt;xsl:value-of select=&quot;format-dateTime(tib:create-dateTime(year-from-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES), month-from-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES), day-from-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES), hours-from-time($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/ORA_DES), minutes-from-time($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/ORA_DES))), &amp;quot;[D01][M01][Y0001][H01][m01]&amp;quot;)&quot;/>&#xa;                                        &lt;/ns0:DATA_NOTIFICA>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;ns0:DATA_NOTIFICA>&#xa;                                            &lt;xsl:value-of select=&quot;format-dateTime(tib:create-dateTime(year-from-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES), month-from-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES),day-from-date($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/DES),00,00,00), &amp;quot;[D01][M01][Y0001][H01][m01]&amp;quot;)&quot;/>&#xa;                                        &lt;/ns0:DATA_NOTIFICA>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_NGA_EVENTO_ORDINE_NOW/Record)&quot;>&#xa;                                &lt;ns0:DATA_NOTIFICA>&#xa;                                    &lt;xsl:value-of select=&quot;format-dateTime($JDBC_NGA_EVENTO_ORDINE_NOW/Record[1]/TIMSTP_INSMTO_EVENTO, &amp;quot;[D01][M01][Y0001][H01][m01]&amp;quot;)&quot;/>&#xa;                                &lt;/ns0:DATA_NOTIFICA>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:DATA_NOTIFICA>&#xa;                                    &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01][M01][Y0001][H01][m01]&amp;quot;)&quot;/>&#xa;                                &lt;/ns0:DATA_NOTIFICA>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&#xa;                                &lt;ns0:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SP&amp;quot;&quot;/>&#xa;                                &lt;/ns0:STATO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica&quot;/>&#xa;                                &lt;/ns0:STATO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;ESPLETAMENTOTECNICOKO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;ANNULLATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;ACCODATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;RA&amp;quot;) and exists($JDBC_CAUSALE/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                    &lt;ns0:CODICE_CAUSALE_ERRORE>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;/>&#xa;                                    &lt;/ns0:CODICE_CAUSALE_ERRORE>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;SCARTATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;ESPLETAMENTOTECNICOKO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;ANNULLATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;ACCODATO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;RA&amp;quot;) and exists($JDBC_CAUSALE/Record)&quot;>&#xa;                                &lt;ns0:DESCRIZIONE_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;substring($JDBC_CAUSALE/Record[1]/DESCR_CAUS_OLO, 1, 80)&quot;/>&#xa;                                &lt;/ns0:DESCRIZIONE_ERRORE>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SC&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SM&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SP&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;ST&amp;quot;) and ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO = &amp;quot;SOSPESO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO ='SOSPESOCONNOTIFICAFS' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRichiestaOLO='INDELIVERY') and exists($JDBC_CAUSALE/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBC_CAUSALE/Record[1]/COD_CAUS_OLO&quot;>&#xa;                                    &lt;ns0:CODICE_SOSPE