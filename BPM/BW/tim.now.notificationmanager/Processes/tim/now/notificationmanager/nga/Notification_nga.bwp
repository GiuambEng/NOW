s2:Offerta='FULLGPONPLUS') and&amp;#xD;&amp;#xA;(string-length(tns3:FlagMulticast)>0 and tns3:FlagMulticast='SI' )&quot;/>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;tns3:DHCP_OPTION_82_REMOTE_ID&quot;>&#xa;                                                            &lt;ns0:DHCP_OPTION_82_REMOTE_ID>&#xa;                                                                &lt;xsl:value-of select=&quot;tns3:DHCP_OPTION_82_REMOTE_ID&quot;/>&#xa;                                                            &lt;/ns0:DHCP_OPTION_82_REMOTE_ID>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:if test=&quot;tns3:FlagMulticast&quot;>&#xa;                                                    &lt;ns0:FlagMulticast>&#xa;                                                        &lt;xsl:value-of select=&quot;tns3:FlagMulticast&quot;/>&#xa;                                                    &lt;/ns0:FlagMulticast>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/ns0:UserVlan>&#xa;                                        &lt;/xsl:for-each>&#xa;                                    &lt;/ns0:DATI_UserVlan>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLANVULA' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VLAN'  or $Generi