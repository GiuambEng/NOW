/Record)>0 and $Oscuramento/Record[1]/FLAG_OSCURMENTO='1'&quot;>&#xa;                                        &lt;ns0:Altro>&#xa;                                            &lt;ns0:DescrizioneOpera>&#xa;                                                &lt;xsl:value-of select=&quot;$PreventivoOpereSpecialiInvoke.output/tns1:DescrizioneOpere/tns1:Altro/tns1:DescrizioneOpera&quot;/>&#xa;                                            &lt;/ns0:DescrizioneOpera>&#xa;                                            &lt;ns0:MisuraOpera>&#xa;                                                &lt;xsl:value-of select=&quot;$PreventivoOpereSpecialiInvoke.output/tns1:DescrizioneOpere/tns1:Altro/tns1:MisuraOpera&quot;/>&#xa;                                            &lt;/ns0:MisuraOpera>&#xa;                                            &lt;xsl:if test=&quot;$PreventivoOpereSpecialiInvoke.output/tns1:DescrizioneOpere/tns1:Altro/tns1:Prezzo&quot;>&#xa;                                                &lt;ns0:Prezzo>&#xa;                                                    &lt;xsl:value-of select=&quot;$PreventivoOpereSpecialiInvoke.output/tns1:DescrizioneOpere/tns1:Altro/tns1:Prezzo&quot;/>&#xa;                                                &lt;/ns0:Prezzo>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns0:Altro>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($PreventivoOpereSpecialiInvoke.output/tns1:DescrizioneOpere/tns1:Altro) and exists($PreventivoOpereSpecialiInvoke.output/tns1:DescrizioneOpere/tns1:Altro/tns1:Prezzo) and count($Oscuramento/Record)>0 and $Oscuramento/Record[1]/FLAG_OSCURMENTO='1'&quot;>&#xa;                                            &lt;ns0:PrezziEspostiIn>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;EURO&amp;quot;&quot;/>&#xa;  