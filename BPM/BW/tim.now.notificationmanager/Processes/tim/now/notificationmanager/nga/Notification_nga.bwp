uot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns8:Source>&#xa;                        &lt;tns8:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns8:BusinessID>&#xa;                        &lt;tns8:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns8:EventType>&#xa;                        &lt;tns8:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;GenericNotification_&amp;quot;,$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns8:trackID>&#xa;                    &lt;/tns8:Identifier>&#xa;                    &lt;tns8:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns8:track_position>&#xa;                    &lt;tns8:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns8:Timestamp>&#xa;                &lt;/tns8:Envelope>&#xa;            &lt;/tns8:ActiveLoggerServices>&#xa;        &lt;/tns8:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
