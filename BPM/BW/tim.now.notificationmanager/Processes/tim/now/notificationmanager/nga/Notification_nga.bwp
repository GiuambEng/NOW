            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/PreventivoOpereSpeciali&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NGA_XDSL_Util&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b63d3bf6-27a3-4dcb-b870-760a3bbb6ff3+output&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/DATI_VLAN/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PreventivoOpereSpecialiInvoke&quot;/>&lt;xsl:param name=&quot;JDBC_NGA_EVENTO_ORDINE_NOW&quot;/>&lt;xsl:param name=&quot;JDBC_NGA_NOTIFICATION&quot;/>&lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&lt;xsl:param name=&quot;JDBC_CAUSALE&quot;/>&lt;xsl:param name=&quot;DTUAppuntamentoElement&quot;/>&lt;xsl:param name=&quot;DTUAccessoElement&quot;/>&lt;xsl:param name=&quot;NGA_XDSL_MigrazioniInvoke&quot;/>&lt;xsl:param name=&quot;CalcoloReferenteInvoke&quot;/>&lt;xsl:param name=&quot;Numeri&quot;/>&lt;xsl:param name=&quot;Dati_UserVlan&quot;/>&lt;xsl:param name=&quot;AccumulateDatiUservlan&quot;/>&lt;xsl:param name=&quot;DataEsito&quot;/>&lt;xsl:param name=&quot;CodiceRisorsa&quot;/>&lt;xsl:param name=&quot;Offerta&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;SelectCAUS_ESITO&quot;/>&lt;xsl:param name=&quot;SelectEVENTO&quot;/>&lt;xsl:param name=&quot;MacroArea&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:template name=&quot;NGAMapper-input&quot; match=&quot;/&quot;>&lt;ns0:RICHIESTA>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns3:MigrazioniResponse/tns3:TIPO_COMUNICAZIONE = &amp;quot;10&amp;quot; or $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns3:MigrazioniResponse/tns3:TIPO_COMUNICAZIONE = &amp;quot;11&amp;quot; or $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns3:MigrazioniResponse/tns3:TIPO_COMUNICAZIONE = &amp;quot;12&amp;quot; or $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns3:MigrazioniResponse/tns3:TIPO_COMUNICAZIONE = &amp;quot;13&amp;quot; or $NGA_XDSL_MigrazioniInvoke/MigrazioniRisposta/tns3:MigrazioniResponse/tns3:TIPO_COMUNICAZIONE = &amp;quot;18&amp;quot;) and $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica !=&amp;quot;SM&amp;quot;) or ($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='VLANVULA' or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='VLAN'  or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta='VLANNGA')&quot;/>&lt;xsl:otherwise>&lt;ns0:DATI_ACCESSO>&lt;ns0:CODICE_ISP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codificaOLONOW&quot;/>&lt;/ns0:CODICE_ISP>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceOrdineOLO) > 0&quot;>&lt;ns0:CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceOrdineOLO&quot;/>&lt;/ns0:CODICE_ORDINE_ISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:CODICE_ORDINE_ISP>&lt;xsl:value-of select=&quot;&amp;quot;CODICEASSENTE&amp;quot;&quot;/>&lt;/ns0:CODICE_ORDINE_ISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceProgetto&quot;>&lt;ns0:CODICE_PROGETTO>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceProgetto&quot;/>&lt;/ns0:CODICE_PROGETTO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica=(&amp;quot;KO&amp;quot;,&amp;quot;OR&amp;quot;,&amp;quot;RA&amp;quot;)&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDRisorsa&quot;>&lt;ns0:IDENTIFICATIVO_RISORSA>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDRisorsa&quot;/>&lt;/ns0:IDENTIFICATIVO_RISORSA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/IDRisorsa&quot;>&lt;ns0:IDENTIFICATIVO_RISORSA>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/IDRisorsa&quot;/>&lt;/ns0:IDENTIFICATIVO_RISORSA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/nome&quot;>&lt;ns0:NOME>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/nome&quot;/>&lt;/ns0:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/cognomeRagioneSociale) > 0&quot;>&lt;ns0:COGNOME>&lt;xsl:value-of select=&quot;substring($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/cognomeRagioneSociale, 1, 70)&quot;/>&lt;/ns0:COGNOME>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Numeri/tns3:NUMERO) > 0&quot;>&lt;ns0:DISTRETTO>&lt;xsl:value-of select=&quot;concat(&amp;quot;0&amp;quot;, string(xsd:int($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/distretto)))&quot;/>&lt;/ns0:DISTRETTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Numeri/tns3:NUMERO) > 0&quot;>&lt;xsl:if test=&quot;$Numeri/tns3:NUMERO&quot;>&lt;ns0:NUMERO>&lt;xsl:value-of select=&quot;$Numeri/tns3:NUMERO&quot;/>&lt;/ns0:NUMERO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)), &amp;quot;POTS&amp;quot;)&quot;>&lt;ns0:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns0:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, &amp;quot;ACCESSO&amp;quot;)]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)), &amp;quot;ISDN&amp;quot;)&quot;>&lt;ns0:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ns0:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/ns0:TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica = &amp;quot;RA&amp;quot;&quot;>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceOrdineOLO&quot;>&lt;ns0:CODICE_ORDINE_PITAGORA>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceOrdineOLO&quot;/>&lt;/ns0:CODICE_ORDINE_PITAGORA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceOrdineTI&quot;>&lt;ns0:CODICE_ORDINE_PITAGORA>&lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceOrdineTI&quot;/>&lt;/ns0:CODICE_ORDINE_PITAGORA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/codiceTrasformazione='TCOND_NAKED' and $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/tipologiaScenario='TCONDNAKED'&quot;>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;'VTR'&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;ATT&amp;quot;&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;MIG&amp;quot;&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;VAR&amp;quot;&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;CESSAZIONE&amp;quot;&quot;>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;DIS&amp;quot;&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;&quot;>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;ANN&amp;quot;&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;RDA&amp;quot;&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:TIPO_RICHIESTA>&lt;xsl:value-of select=&quot;&amp;quot;DES&amp;quot;&quot;/>&lt;/ns0:TIPO_RICHIESTA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica = &amp;quot;SM&amp;quot;&quot;>&lt;ns0:TIPO_ORDINE>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ns0:TIPO_ORDINE>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&lt;ns0:TIPO_ORDINE>&lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&lt;/ns0:TIPO_ORDINE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;SEMIEASYIPNGAFTTH&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'Z'&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'V'&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;SEMIVULAFTTH&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;'U'&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica = &amp;quot;RA&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica = &amp;quot;RR&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica = &amp;quot;RS&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;R&amp;quot;&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;EASYIPNGAFTTCAB&amp;quot; or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;T&amp;quot;&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;FULLGPONPLUS&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Offerta = &amp;quot;FULLGPONPLUSNGA&amp;quot;&quot;>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;W&amp;quot;&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns0:TIPO_SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/ns0:TIPO_SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica='KO' or $GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:TipologiaNotifica='OK') and exists($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/ORA_DES)&quot;>&lt;ns0:DATA_NOTIFICA>&lt;xsl:value-of select=&quot;format-dateTime(tib:create-dateTime(year-from-date($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/DES), month-from-date($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/DES), day-from-date($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/DES), hours-from-time($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/ORA_DES), minutes-from-time($GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/ordine/ORA_DES), xsd:int(seconds-from-time($GenericNotificationIn/NotificaGenericaRichiesta/t