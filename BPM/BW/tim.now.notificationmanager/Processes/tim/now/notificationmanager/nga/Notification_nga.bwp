t=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[1]/tns3:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_1>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[1]/tns3:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_1>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[2]/tns3:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[2]/tns3:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_2>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[2]/tns3:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_2>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[3]/tns3:DIRECTORY_NUMBER)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[3]/tns3:DIRECTORY_NUMBER&quot;>&#xa;                                &lt;ns0:DIRECTORY_NUMBER_3>&#xa;                                    &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:DIRECTORY_NUMBER[3]/tns3:DIRECTORY_NUMBER&quot;/>&#xa;                                &lt;/ns0:DIRECTORY_NUMBER_3>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($NGA_XDSL_MigrazioniInvoke.M