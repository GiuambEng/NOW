                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;GenericNotificationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectEVENTO&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectEVENTO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:CW_BUS_MESSAGE>&#xa;            &lt;tns8:GenericLogger>&#xa;                &lt;tns8:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns8:Application>&#xa;                &lt;tns8:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_nga&amp;quot;&quot;/>&#xa;                &lt;/tns8:Process>&#xa;                &lt;tns8:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Notification_ngaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns8:Service>&#xa;                &lt;tns8:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenericNotification&amp;quot;&quot;/>&#xa;                &lt;/tns8:Operation>&#xa;                &lt;tns8:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenericNotificationIn/NotificaGenericaRichiesta/tns2:NotificaGenericaRequest/tns2:Richiesta/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns8:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectEVENTO/Record)>0&quot;>&#xa;                        &lt;tns8:Message>&#xa;                            &lt;xsl:valu