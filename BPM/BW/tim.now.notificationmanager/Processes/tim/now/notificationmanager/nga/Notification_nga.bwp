        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/cowCodeOLO = $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;COWCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns0:CODICE_RISORSA_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/cowCodeOLO2 = $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;COWCODE&amp;quot;]/valoreAttributo&quot;>&#xa;                                &lt;ns0:CODICE_RISORSA_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_RISORSA_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_1>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICESESSIONE&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                &lt;ns0:CODICE_SESSIONE_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODICESESSIONE&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/ns0:CODICE_SESSIONE_1>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_SESSIONE_1>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceSessione&quot;/>&#xa;                                &lt;/ns0:CODICE_SESSIONE_1>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating2) > 0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot;&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating2&quot;>&#xa;                                &lt;ns0:CODICE_RISORSA_2>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                                &lt;/ns0:CODICE_RISORSA_2>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceSessione2) > 0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot;&quot;>&#xa;                            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceSessione2&quot;>&#xa;                                &lt;ns0:CODICE_SESSIONE_2>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceSessione2&quot;/>&#xa;                                &lt;/ns0:CODICE_SESSIONE_2>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:STATO&quot;>&#xa;                            &lt;ns0:STATO>&#xa;                                &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:STATO&quot;/>&#xa;                            &lt;/ns0:STATO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:CAUSALE_RIFIUTO&quot;>&#xa;                            &lt;ns0:CAUSALE_RIFIUTO>&#xa;                                &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:CAUSALE_RIFIUTO&quot;/>&#xa;                            &lt;/ns0:CAUSALE_RIFIUTO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/statoRi