ricaRichiesta/tns2:Offerta='BITSTREAMGBEASIMMETRICOFLAT' or &amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VULAFTTCAB' or &amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTH' or &amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTCAB' or&amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='SEMIBITSTREAMNGAFTTH' or&amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='SEMIEASYIPNGAFTTH')&quot;>&#xa;                &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente='DTUSERVIZIOPZIONALI']&quot;>&#xa;                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo!='A001'&quot;>&#xa;                        &lt;ns0:Dati_ServiziOpzionali>&#xa;                            &lt;ns0:CodiceServizio>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/ns0:CodiceServizio>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:Esito>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:Esito>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:CausaleEsito>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:CausaleEsito>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:DescrizioneEsito>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DESCRIZIONEESITOOAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:DescrizioneEsito>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:Note>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='PARAMETRONONCONFORME']/valoreAttributo)>0 or string-length(attributiDettaglioOrdine[nomeAttributo='VALOREPARAMETRONONCONFORME']/valoreAttributo)>0&quot;>&#xa;                                &lt;ns0:NonConformitaONTOperatore>&#xa;                                    &lt;ns0:ParametroNonConforme>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='PARAMETRONONCONFORME']/valoreAttributo&quot;/>&#xa;                                    &lt;/ns0:ParametroNonConforme>&#xa;                                    &lt;ns0:ValoreParametroNonConforme>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VALOREPARAMETRONONCONFORME']/valoreAttributo&quot;/>&#xa;                                    &lt;/ns0:ValoreParametroNonConforme>&#xa;                                &lt;/ns0:NonConformitaONTOperatore>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:Dati_ServiziOpzionali>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='A001' and ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTH' or &amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTCAB')&quot;>&#xa;                        &lt;ns0:Dati_ServiziOpzionali>&#xa;                            &lt;ns0:CodiceServizio>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/ns0:CodiceServizio>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:Esito>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='ESITOOAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:Esito>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:CausaleEsito>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEESITOOAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:CausaleEsito>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo)>0 and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione='ATTIVAZIONE'&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:DescrizioneEsito>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:DescrizioneEsito>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;>&#xa;                                        &lt;ns0:Note>&#xa;                                            &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='NOTEPEROAO']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='PARAMETRONONCONFORME']/valoreAttributo)>0 or string-length(attributiDettaglioOrdine[nomeAttributo='VALOREPARAMETRONONCONFORME']/valoreAttributo)>0&quot;>&#xa;                                &lt;ns0:NonConformitaONTOperatore>&#xa;                                    &lt;ns0:ParametroNonConforme>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='PARAMETRONONCONFORME']/valoreAttributo&quot;/>&#xa;                                    &lt;/ns0:ParametroNonConforme>&#xa;                                    &lt;ns0:ValoreParametroNonConforme>&#xa;                                        &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='VALOREPARAMETRONONCONFORME']/valoreAttributo&quot;/>&#xa;                                    &lt;/ns0:ValoreParametroNonConforme>&#xa;                                &lt;/ns0:NonConformitaONTOperatore>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:Dati_ServiziOpzionali>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica='CO' and &amp;#xD;&amp;#xA;(($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione='MIGRAZIONE' &amp;#xD;&amp;#xA;and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot;) or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione='ATTIVAZIONE')  &amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTH' or &amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTCAB')&quot;>&#xa;                &lt;xsl:for-each select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI']&quot;>&#xa;                    &lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo='A001' and string-length(attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo)>0&quot;>&#xa;                        &lt;ns0:Dati_ServiziOpzionali>&#xa;                            &lt;ns0:CodiceServizio>&#xa;                                &lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICESERVIZIO']/valoreAttributo&quot;/>&#xa;                            &lt;/ns0:CodiceServizio>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo)>0&quot;>&#xa;                                    &lt;ns0:Note>&#xa;                                        &lt;xsl:value-of select=&quot;substring-before(substring-after(attributiDettaglioOrdine[nomeAttributo='DATITECNICI']/valoreAttributo, &amp;quot;USERNAMEMODEM: &amp;quot;), &amp;quot;,&amp;quot;)&quot;/>&#xa;                                    &lt;/ns0:Note>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns0:Dati_ServiziOpzionali>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica='OK' and &amp;#xD;&amp;#xA;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione='MIGRAZIONE' or &amp;#xD;&amp;#xA;&amp;#x9;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione='ATTIVAZIONE') and &amp;#xD;&amp;#xA;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTCAB' and&amp;#xD;&amp;#xA;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/codiceMigrazione) > 0 &amp;#xD;&amp;#xA;and (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])=0 or (count($Oscuramento/Record[COD_AGESP='T1PRJ0031945'])>0 and &amp;#xD;&amp;#xA;($Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='0' or $Oscuramento/Record[COD_AGESP='T1PRJ0031945']/FLAG_OSCURMENTO='N')))&quot;>&#xa;                &lt;ns0:Dati_ServiziOpzionali>&#xa;                    &lt;ns0:CodiceServizio>&#xa;                        &lt;xsl:value-of select=&quot;'A002'&quot;/>&#xa;                    &lt;/ns0:CodiceServizio>&#xa;                    &lt;ns0:Esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/ns0:Esito>&#xa;                    &lt;xsl:if test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/codiceMigrazione&quot;>&#xa;                        &lt;ns0:Note>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/codiceMigrazione&quot;/>&#xa;                        &lt;/ns0:Note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns0:Dati_ServiziOpzionali>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;(($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione='MIGRAZIONE' and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot;) &amp;#xD;&amp;#xA;or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione='ATTIVAZIONE') and  ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='VULAFTTCAB' or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='BITSTREAMNGAFTTCAB'  or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta='EASYIPNGAFTTCAB') and&amp;#xD;&amp;#xA;exists($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente= 'DTUDATICOLLAUDO']) &amp;#xD;&amp;#xA;and (count($Oscuramento/Record[COD_AGESP='R1I-20-0012'])=0 or (count($Oscuramento/Record[COD_AGESP='R1I-20-0012'])>0 and $Oscuramento/Record[COD_AGESP='R1