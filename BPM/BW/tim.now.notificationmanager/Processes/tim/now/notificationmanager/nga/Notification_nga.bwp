                   &lt;/ns0:CodiceIndirizzo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/ns0:DATI_ACCESSO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta!='VLANVULA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta!='VLAN'  and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta!='VLANNGA') and ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SC&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SP&amp;quot;or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;SM&amp;quot;) and $CalcoloReferenteInvoke.output/tns3:PresenzaReferente = true()&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;10&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;11&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;12&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;13&amp;quot; or $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE = &amp;quot;18&amp;quot;) and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica !=&amp;quot;SM&amp;quot;&quot;/>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns0:DATI_REFERENTE>&#xa;                                &lt;xsl:for-each select=&quot;$CalcoloReferenteInvoke.output/tns3:ReferenteRipetitivo&quot;>&#xa;                                    &lt;xsl:variable name=&quot;Progressivo&quot; select=&quot;tns3:ProgressivoReferente&quot;/>&#xa;                                    &lt;ns0:REFERENTE>&#xa;                                        &lt;ns0:NOME_REF>&#xa;                                            &lt;xsl:value-of select=&quot;tns3:NomeReferente&quot;/>&#xa;                                        &lt;/ns0:NOME_REF>&#xa;                                        &lt;ns0:COGNOME_REF>&#xa;                                            &lt;xsl:value-of select=&quot;tns3:CognomeReferente&quot;/>&#xa;                                        &lt;/ns0:COGNOME_REF>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;tns3:TelefonoFisso = &amp;quot;SI&amp;quot; and string-length(tns3:TelefonoFissoReferente) > 0&quot;>&#xa;                                                &lt;ns0:TEL_REF>&#xa;                                                    &lt;xsl:value-of select=&quot;tns3:TelefonoFissoReferente&quot;/>&#xa;                                                &lt;/ns0:TEL_REF>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;tns3:TelefonoMobile = &amp;quot;SI&amp;quot; and string-length(tns3:TelefonoMobileReferente) > 0&quot;>&#xa;                                                &lt;ns0:MOB_REF>&#xa;                                                    &lt;xsl:value-of select=&quot;tns3:TelefonoMobileReferente&quot;/>&#xa;                                                &lt;/ns0:MOB_REF>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;string-length(tns3:DataContatto) > 0&quot;>&#xa;                                            &lt;xsl:if test=&quot;tns3:DataContatto&quot;>&#xa;                                                &lt;ns0:DATA_CONTATTO>&#xa;                                                    &lt;xsl:value-of select=&quot;tns3:DataContatto&quot;/>&#xa;                                                &lt;/ns0:DATA_CONTATTO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;starts-with(tns3:NomeReferente, 'dk') or starts-with(tns3:CognomeReferente, 'dk') or starts-with(tns3:TelefonoFissoReferente, 'dk') or starts-with(tns3:TelefonoMobileReferente,'dk')&quot;>&#xa;                                            &lt;ns0:PROGRESSIVO>&#xa;                                                &lt;xsl:value-of select=&quot;$Progressivo&quot;/>&#xa;                                            &lt;/ns0:PROGRESSIVO>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns0:REFERENTE>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/ns0:DATI_REFERENTE>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta) and ($GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;AQ&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;OK&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;KO&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;AC&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;RD&amp;quot; or $GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaNotifica = &amp;quot;CS&amp;quot;) and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta!='VLANVULA' and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta!='VLAN'  and $GenericNotificationIn.NotificaGenericaRichiesta/tns2:Offerta!='VLANNGA'&quot;>&#xa;                    &lt;ns0:DATI_MIGRAZIONI>&#xa;                        &lt;ns0:TIPO_COMUNICAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE&quot;/>&#xa;                        &lt;/ns0:TIPO_COMUNICAZIONE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;RECIPIENT&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE !=&amp;quot;10&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE !=&amp;quot;11&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE !=&amp;quot;12&amp;quot;&quot;>&#xa;                                &lt;ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:CodificaOLOAGCOMDestinatario&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_RECIPIENT>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:TipologiaOLODestinatario = &amp;quot;DONATING&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE !=&amp;quot;5&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE !=&amp;quot;6&amp;quot; and $NGA_XDSL_MigrazioniInvoke.MigrazioniRisposta/tns3:TIPO_COMUNICAZIONE !=&amp;quot;7&amp;quot; and string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo) > 0&quot;>&#xa;                                &lt;ns0:CODICE_OPERATORE_DONATING>&#xa;                                    &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;CODIFICAOLOAGCOMDONATING&amp;quot;]/valoreAttributo&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_DONATING>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns0:CODICE_OPERATORE_DONATING>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/ns0:CODICE_OPERATORE_DONATING>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;ns0:CODICE_ORDINE_RECIPIENT>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineOLO&quot;/>&#xa;                        &lt;/ns0:CODICE_ORDINE_RECIPIENT>&#xa;                        &lt;ns0:CODICE_ORDINE_TI_WH>&#xa;                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceOrdineTI&quot;/>&#xa;                        &lt;/ns0:CODICE_ORDINE_TI_WH>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;(starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/offerta, 'ULL') or starts-with($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/offerta, 'SLU'))&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo)>0&quot;>&#xa;                                        &lt;ns0:CODICE_RISORSA_1>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/dettaglioordine[starts-with(nomeComponente, 'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='DN']/valoreAttributo&quot;/>&#xa;                                        &lt;/ns0:CODICE_RISORSA_1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/contenutoXML)>0 and string-length(substring-before(substring-after($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/contenutoXML, concat('CodiceRisorsa1&amp;amp;','gt;')), concat('&amp;amp;','lt;/CodiceRisorsa1')))>0&quot;>&#xa;                                        &lt;ns0:CODICE_RISORSA_1>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(substring-after($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/contenutoXML, concat('CodiceRisorsa1&amp;amp;','gt;')), concat('&amp;amp;','lt;/CodiceRisorsa1'))&quot;/>&#xa;                                        &lt;/ns0:CODICE_RISORSA_1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/contenutoXML)>0 and string-length(substring-before(substring-after($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/contenutoXML, concat('DN&amp;amp;','gt;')), concat('&amp;amp;','lt;/DN')))>0&quot;>&#xa;                                        &lt;ns0:CODICE_RISORSA_1>&#xa;                                            &lt;xsl:value-of select=&quot;substring-before(substring-after($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/contenutoXML, concat('DN&amp;amp;','gt;')), concat('&amp;amp;','lt;/DN'))&quot;/>&#xa;                                        &lt;/ns0:CODICE_RISORSA_1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating)>0&quot;>&#xa;                                        &lt;ns0:CODICE_RISORSA_1>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/codiceRisorsaDonating&quot;/>&#xa;                                        &lt;/ns0:CODICE_RISORSA_1>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length($GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/numeroTelefonico)>0&quot;>&#xa;                                        &lt;ns0:CODICE_RISORSA_1>&#xa;                                            &lt;xsl:value-of select=&quot;$GenericNotificationIn.NotificaGenericaRichiesta/tns2:Richiesta/ordine/numeroTelefonico&quot;/>&#xa;          