    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://xsd.telecomitalia.it/crm/xdsl/order"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/ParseSchema/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://xsd.telecomitalia.it/crm/regolatorio"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://NOW.it.telecomitalia.it/casedata"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://NOW.it.telecomitalia.it/casedata_v1"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/ReplaceAllString/"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:xmlString" name="ParseNGA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:RICHIESTA" name="ParseNGA" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:xmlString" name="ParseXDSL-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:RICHIESTA" name="ParseXDSL" sca-bpel:internal="true"/>
        <bpws:variable element="tns:ParseSchemaRequest" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="tns:ParseSchemaResponseStruttura"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns4:jdbcQueryActivityInput"
            name="JDBCQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:resultSet" name="JDBCQuery" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connection/JDBC/Timeout" type="xsd:int"/>
        <bpws:variable name="Tracciamento" type="xsd:string"/>
        <bpws:variable name="Intestazione" type="xsd:string">
            <bpws:from>
                <bpws:literal><![CDATA[<?xml version="1.0" encoding="UTF-8"?>]]></bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="AperturaTag" type="xsd:string">
            <bpws:from>
                <bpws:literal><![CDATA[<casedataV1:RichiestaElement xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:casedataV1="http://NOW.it.telecomitalia.it/casedata" xsi:type="casedataV1:Richiesta">]]></bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="ChiusuraTag" type="xsd:string">
            <bpws:from>
                <bpws:literal><![CDATA[</casedataV1:RichiestaElement>]]></bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns0:xmlString"
            name="ParseXmlRichiesta-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:RichiestaElement"
            name="ParseXmlRichiesta" sca-bpel:internal="true"/>
        <bpws:variable name="NamespaceNGA" type="xsd:string">
            <bpws:from>
                <bpws:literal><![CDATA[<ns0:RICHIESTA xmlns:ns0="http://xsd.telecomitalia.it/crm/xdsl/nga">]]></bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="NamespaceXDSL" type="xsd:string">
            <bpws:from>
                <bpws:literal><![CDATA[<ns0:RICHIESTA xmlns:ns0="http://xsd.telecomitalia.it/crm/xdsl/order">]]></bpws:literal>
            </bpws:from>
        </bpws:variable>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToParseXml1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToParseXml2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ParseNGAToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseXml2ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="TracciamentoAssignToParseXmlRichiesta" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseXmlToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="38ba898d-9738-4dc9-a6ea-44220a6a4dd7"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToParseXml1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:StrutturaRichiesta = &quot;NGA&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:StrutturaRichiesta = "NGA"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToParseXml2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:StrutturaRichiesta = &quot;XDSL&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:StrutturaRichiesta = "XDSL"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ParseSchema/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlRichiesta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseNGA&quot;/>&lt;xsl:param name=&quot;ParseXDSL&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:ParseSchemaResponseStruttura>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/statoRichiestaNOW&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;$ParseXmlRichiesta/statoRichiestaPrecedNOW&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/statoRichiestaPrecedNOW&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/statoRichiestaPrecedOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/statoRichiestaPrecedOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/ambito&quot;>&lt;ambito>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/ambito&quot;/>&lt;/ambito>&lt;/xsl:if>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/canaleRichiesta&quot;/>&lt;/canaleRichiesta>&lt;xsl:if test=&quot;$ParseXmlRichiesta/lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/progressivoRichiestaFile&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/progressivoRichiestaFile&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/strutturaRichiesta&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/tipoRichiesta&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$ParseXmlRichiesta/IDRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$ParseXmlRichiesta/codificaOLONOW&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/codificaOLONOW&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/codiceOrdineOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$ParseXmlRichiesta/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXmlRichiesta/codiceOrdineOLOTarget&quot;>&lt;