                tibex:xpdlId="d8746713-2f05-4324-9992-ae279f70cca6" variable="Reply-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/RigenerazioneEmail/" xmlns:tns1="http://www.tim.com/NOW/xsd/RigenerazioneEmail" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="_error"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:RigenerazioneEmailFault&gt;&lt;RigenerazioneEmailFault&gt;&lt;tns1:RigenerazioneEmailFault&gt;&lt;tns1:Codice&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:Codice&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error)"&gt;&lt;tns1:Descrizione&gt;&lt;xsl:value-of select="tib:render-xml($_error, true(), true())"/&gt;&lt;/tns1:Descrizione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:Descrizione&gt;&lt;xsl:value-of select="&amp;quot;Errore nell'invocazione del servizio.&amp;quot;"/&gt;&lt;/tns1:Descrizione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:RigenerazioneEmailFault&gt;&lt;/RigenerazioneEmailFault&gt;&lt;/tns:RigenerazioneEmailFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/RigenerazioneEmail/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RigenerazioneEmail&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RigenerazioneEmailFault>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($_error)&quot;>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($_error, true(), true())&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Errore nell'invocazione del servizio.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:RigenerazioneEmailFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
