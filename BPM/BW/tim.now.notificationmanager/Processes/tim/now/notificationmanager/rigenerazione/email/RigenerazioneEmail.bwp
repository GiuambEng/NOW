                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToParse">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;RD&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;ON&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;OFF&quot; &#xd;&#xa;and $JDBCQuery/Record[1]/STRUTTURA_RICH = &quot;XDSL&quot;) or&#xd;&#xa;(($JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;AQ&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;AK&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;AC&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;RR&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;SP&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;FS&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;CO&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;OK&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;KO&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;SU&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;KA&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;NL&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;SC&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;NP&quot; or&#xd;&#xa;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;TM&quot; or $JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;KR&quot; or $JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;IA&quot; or $JDBCQuery/Record[1]/COD_TIPOLG_NOTF = &quot;ST&quot;) and &#xd;&#xa;($JDBCQuery/Record[1]/STRUTTURA_RICH = &quot;NGA&quot; or &#xd;&#xa;$JDBCQuery/Record[1]/STRUTTURA_RICH = &quot;XDSL&quot;)) or &#xd;&#xa;($JDBCQuery/Record[1]/STRUTTURA_RICH=&quot;FWA&quot; and &#xd;&#xa;($JDBCQuery/Record[1]/COD_TIPOLG_NOTF='KO' or&#xd;&#xa; $JDBCQuery/Record[1]/COD_TIPOLG_NOTF='OK' or  $JDBCQuery/Record[1]/COD_TIPOLG_NOTF='OF' or  $JDBCQuery/Record[1]/COD_TIPOLG_NOTF='KF' ))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "RD" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "ON" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "OFF" 
and $JDBCQuery/Record[1]/STRUTTURA_RICH = "XDSL") or
(($JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "AQ" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "AK" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "AC" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "RR" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "SP" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "FS" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "CO" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "OK" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "KO" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "SU" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "KA" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "NL" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "SC" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "NP" or
$JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "TM" or $JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "KR" or $JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "IA" or $JDBCQuery/Record[1]/COD_TIPOLG_NOTF = "ST") and 
($JDBCQuery/Record[1]/STRUTTURA_RICH = "NGA" or 
$JDBCQuery/Record[1]/STRUTTURA_RICH = "XDSL")) or 
($JDBCQuery/Record[1]/STRUTTURA_RICH="FWA" and 
($JDBCQuery/Record[1]/COD_TIPOLG_NOTF='KO' or
 $JDBCQuery/Record[1]/COD_TIPOLG_NOTF='OK' or  $JDBCQuery/Record[1]/COD_TIPOLG_NOTF='OF' or  $JDBCQuery/Record[1]/COD_TIPOLG_NOTF='KF' ))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GenericLoggerToLOG_EmailCreata">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmail&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmailPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmail&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Record trovati su RICH_ORDN_COMUNIC_NOTF',tib:render-xml($JDBCQuery,true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Record non trovati su RICH_ORDN_COMUNIC_NOTF'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
