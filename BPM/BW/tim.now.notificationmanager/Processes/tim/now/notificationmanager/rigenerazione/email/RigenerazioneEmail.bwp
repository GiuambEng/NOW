                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RigenerazioneEmail&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;RigenerazioneEmailIn&quot;/>&lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmail&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmailPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmail&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Rigenerazione Email Input&amp;quot;, tib:render-xml($RigenerazioneEmailIn/RigenerazioneEmailRichiesta/tns2:RigenerazioneEmailRequest, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;CreateNotification_STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;RigenerazioneEmail_&amp;quot;,$_processContext/ProcessInstanceId)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($RigenerazioneEmailIn/RigenerazioneEmailRichiesta/tns2:RigenerazioneEmailRequest)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($RigenerazioneEmailIn/RigenerazioneEmailRichiesta/tns2:RigenerazioneEmailRequest, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Input-input" name="LOG_Input"
                    tibex:xpdlId="7efd9b32-8e52-42da-8774-a47c27f5e07b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RigenerazioneEmailInToCallProcess1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_InputToRigenerazioneEmailOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RigenerazioneEmail&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RigenerazioneEmailIn.RigenerazioneEmailRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmail&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmailPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RigenerazioneEmail&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Rigenerazione Email Input&amp;quot;, tib:render-xml($RigenerazioneEmailIn.RigenerazioneEmailRichiesta, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationmanager&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;tns:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                        &lt;/tns:BusinessID>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CreateNotification_STARTED&amp;quot;&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RigenerazioneEmail_&amp;quot;,$_processContext/ProcessInstanceId)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload>&#xa;                    &lt;tns:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($RigenerazioneEmailIn.RigenerazioneEmailRichiesta)))&quot;/>&#xa;                    &lt;/tns:Binary>&#xa;                    &lt;tns:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($RigenerazioneEmailIn.RigenerazioneEmailRichiesta, true(), true())&quot;/>&#xa;                    &lt;/tns:XMLString>&#xa;                &lt;/tns:Playload>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="b6acb6ea-6e51-4ea2-8dd5-a1f1cb6e9e30">
                <bpws:targets>
                    <bpws:target linkName="RigenerazioneEmailOutToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToExit"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($RigenerazioneEmailIn/RigenerazioneEmailRichiesta/tns:RigenerazioneEmailRequest/tns:IDNotifica)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($RigenerazioneEmailIn.RigenerazioneEmailRichiesta/tns:IDNotifica)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GenericLoggerToParse"
                                    tibex:label="EMAIL SI" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SendEmailInvokeToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ParseToSendEmailInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLoggerToLOG_EmailCreata"
                                    tibex:label="EMAIL NO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBCUpdateToLOG_EmailCreata" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQueryToGenericLogger" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="21ebcfb7-8572-4082-92dc-f743329a515f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="57b651dc-71b7-48ca-9c3e-045ef277394a">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ParseSchema/&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Parse&quot;/>&lt;xsl:template name=&quot;SendEmailInvoke-input&quot; match=&quot;/&quot;>&lt;tns:EmailRequest>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/STRUTTURA_RICH != &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;tns:RichiestaGenerica>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/STRUTTURA_RICH = &amp;quot;NGA&amp;quot;&quot;>&lt;tns:RICHIESTA_NGA>&lt;xsl:copy-of select=&quot;$Parse/tns1:Notifica/tns1:RICHIESTA_NGA/ns0:RICHIESTA&quot;/>&lt;/tns:RICHIESTA_NGA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RICHIESTA_XDSL>&lt;xsl:copy-of select=&quot;$Parse/tns1:Notifica/tns1:RICHIESTA_XDSL/ns01:RICHIESTA&quot;/>&lt;/tns:RICHIESTA_XDSL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($JDBCQuery/Record[1]/ID_ANAG_CAUS)) > 0&quot;>&lt;tns:IDAnagraficaCausale>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/tns:IDAnagraficaCausale>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:RichiestaGenerica>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:RichiestaElement>&lt;xsl:copy-of select=&quot;$Parse/ns1:RichiestaElement/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$Parse/ns1:RichiestaElement/@*&quot;/>&lt;xsl:copy-of select=&quot;$Parse/ns1:RichiestaElement/node()&quot;/>&lt;/ns:RichiestaElement>&lt;tns:TipologiaNotifica>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_TIPOLG_NOTF&quot;/>&lt;/tns:TipologiaNotifica>&lt;tns:IDNotifica>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_NOTF)&quot;/>&lt;/tns:IDNotifica>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($JDBCQuery/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)) > 0&quot;>&lt;tns:IDEventoOrdineNOW>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_EVENTO_ORDN_NOW_WHLS)&quot;/>&lt;/tns:IDEventoOrdineNOW>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:StrutturaRichiesta>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/STRUTTURA_RICH&quot;/>&lt;/tns:StrutturaRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/IDTPLG_DESTNRIO_NOTF = 1&quot;>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$Parse/ns1:RichiestaElement/offerta&quot;/>&lt;/tns:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/IDTPLG_DESTNRIO_NOTF = 2&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/STRUTTURA_RICH != &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&lt;/tns:Offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$Parse/ns1:RichiestaElement/offerta&quot;/>&lt;/tns:Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/STRUTTURA_RICH != &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$Parse/ns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZADATI&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;OFFERTA&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:Offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$Parse/ns1:RichiestaElement/ordine/dettaglioordine[nomeComponente = &amp;quot;CONSISTENZAFONIA&amp;quot;]/attributiDettaglioOrdine[nomeAttributo = &amp;quot;OFFERTA&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CodificaOLOAGCOMDestinatario>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:CodificaOLOAGCOMDestinatario>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODFC_OLO_NOW&quot;>&lt;tns:CodificaOLONOWDestinatario>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODFC_OLO_NOW&quot;/>&lt;/tns:CodificaOLONOWDestinatario>&lt;/xsl:if>&lt;/tns:EmailRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SendEmailInvoke-input"
                                    name="SendEmailInvoke"
                                    tibex:xpdlId="377ed31a-4d08-4e9d-ba99-686b880bfbe0"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseToSendEmailInvoke"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SendEmailInvokeToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericNotification&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ParseSchema/&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Parse&quot;/>&lt;xsl:template name=&quot;SendEmailInvoke-input&quot; match=&quot;/&quot;>&lt;tns:EmailRequest>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/STRUTTURA_RICH != &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;tns:RichiestaGenerica>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/STRUTTURA_RICH = &amp;quot;NGA&amp;quot;&quot;>&lt;tns:RICHIESTA_NGA>&lt;xsl:copy-of select=&quot;$Parse/tns1:Notifica/tns1:RICHIESTA_NGA/ns0:RICHIESTA&quot;/>&lt;/tns:RICHIESTA_NGA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RICHIESTA_XDSL>&lt;xsl:copy-of select=&quot;$Parse/tns1:Notifica/tns1:RICHIESTA_XDSL/ns01:RICHIESTA&quot;/>&lt;/tns:RICHIESTA_XDSL>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($JDBCQuery/Record[1]/ID_ANAG_CAUS)) > 0&quot;>&lt;tns:IDAnagraficaCausale>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[1]/ID_ANAG_CAUS)&quot;/>&lt;/tns:IDAnagraficaCausale>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:RichiestaGenerica>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:RichiestaElement>&lt;xsl:copy-of select=&quot;$Parse/ns1:RichiestaElement/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$Parse/ns1:RichiestaElement/@*&quot;/>&lt;xsl:copy-o