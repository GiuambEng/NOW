<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/ReinvioScheduler" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ReinvioScheduler" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">



	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="ReinvioEmailRequest">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="1"
					name="DatiNotificheEmail">
					<complexType>
						<sequence>
							<element name="IDNotifica" type="int" />
							<element name="DataInvioNotifica"
								type="dateTime" />
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioEmailResponse">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="1"
					name="Response">
					<complexType>
						<sequence>
							<element name="Codice" type="string" />
							<element maxOccurs="1" minOccurs="0"
								name="Descrizione" type="string">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioEmailFault">
		<complexType>
			<sequence>
				<element name="Codice" type="string" />
				<element maxOccurs="1" minOccurs="0" name="Descrizione"
					type="string" />
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioFileRequest">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="1"
					name="DatiFile">
					<complexType>
						<sequence>
							<element name="CodiceOLOAGCOM"
								type="string" />
							<element name="IDFileProcstoOutput"
								type="int">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioFileResponse">
		<complexType>
			<sequence>


				<element maxOccurs="unbounded" minOccurs="1"
					name="Response">
					<complexType>
						<sequence>

							<element name="Codice" type="string" />
							<element maxOccurs="1" minOccurs="0"
								name="Descrizione" type="string" />
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioFileFault">
		<complexType>
			<sequence>
				<element name="Codice" type="string" />
				<element maxOccurs="1" minOccurs="0" name="Descrizione"
					type="string" />
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioNotificheRequest">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="0"
					name="DatiNotifiche">
					<complexType>
						<sequence>
							<element maxOccurs="1" minOccurs="0"
								name="CodiceOrdineOLO" type="string" />
							<element maxOccurs="1" minOccurs="0"
								name="CodiceOrdineTI" type="string" />
							<element maxOccurs="1" minOccurs="0"
								name="IDRichiestaOLO" type="string" />
							<element name="IDNotifica" type="int" />
							<element name="MatricolaOperatore"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="CanaleRichiesta" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioNotificheResponse">
		<complexType>
			<sequence>


				<element name="Response" maxOccurs="unbounded"
					minOccurs="1">
					<complexType>
						<sequence>

							<element name="Codice" type="string" />
							<element maxOccurs="1" minOccurs="0"
								name="Descrizione" type="string" />
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ReinvioNotificheFault">
		<complexType>
			<sequence>
				<element name="Codice" type="string" />
				<element maxOccurs="1" minOccurs="0" name="Descrizione"
					type="string" />
			</sequence>
		</complexType>
	</element>

	<element name="ReinvioSchedulerRequest">
		<complexType>
			<choice>
				<element name="ReinvioDaGUI">
					<complexType>
						<choice>
							<element name="Reinvio">
								<complexType>
									<choice>
										<element name="ReinvioFile">

											<complexType>
												<sequence>
													<element
														name="DatiFile" maxOccurs="unbounded" minOccurs="1">
														<complexType>
															<sequence>
																<element
																	name="CodiceOLOAGCOM" type="string">
																</element>
																<element
																	name="IDFileProcstoOutput" type="int">
																</element>
															</sequence>
														</complexType>
													</element>
												</sequence>
											</complexType>
										</element>
										<element name="ReinvioEmail">
											<complexType>
												<sequence>
													<element
														name="DatiNotificheEmail" maxOccurs="unbounded" minOccurs="1">
														<complexType>
															<sequence>
																<element
																	name="IDNotifica" type="int">
																</element>
																<element
																	name="DataInvioNotifica" type="dateTime">
																</element>
															</sequence>
														</complexType>
													</element>
												</sequence>
											</complexType>
										</element>
										<element
											name="ReinvioNotifiche">
											<complexType>
												<sequence>
													<element
														name="DatiNotifiche" maxOccurs="unbounded" minOccurs="1">
														<complexType>
															<sequence>
																<element
																	name="CodiceOrdineOLO" type="string">
																</element>
																<element
																	name="CodiceOrdineTI" type="string" maxOccurs="1"
																	minOccurs="0">
																</element>
																<element
																	name="IDRichiestaOLO" type="string">
																</element>
																<element
																	name="IDNotifica" type="int">
																</element>
																<element
																	name="MatricolaOperatore" type="string">
																</element>
															</sequence>
														</complexType>
													</element>
												</sequence>
											</complexType>
										</element>
									</choice>
								</complexType>
							</element>
							<element name="GenerazioneNotifiche" maxOccurs="unbounded" minOccurs="0">
								<complexType>
									<sequence>
										<element
											ref="pref:RichiestaElement">
										</element>
										<element
											name="TipologiaNotifica" type="string">
										</element>
										<element name="OrigineNotifica"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element
											name="IDEventoOrdineNOW" type="int" maxOccurs="1"
											minOccurs="0">
										</element>
										<element
											name="TipologiaOLODestinatario" maxOccurs="1"
											minOccurs="0">
											<simpleType>
												<restriction
													base="string">
													<enumeration
														value="DONOR">
													</enumeration>
													<enumeration
														value="DONATING">
													</enumeration>
													<enumeration
														value="RECIPIENT">
													</enumeration>
												</restriction>
											</simpleType>
										</element>
										<element
											name="CodificaOLOAGCOMDestinatario" type="string"
											maxOccurs="1" minOccurs="0">
										</element>
										<element
											name="CodificaOLONOWDestinatario" type="string" maxOccurs="1"
											minOccurs="0">
										</element>


										<element
											name="FlagKORiscontroCodiceSessione" maxOccurs="1"
											minOccurs="0">
											<simpleType>
												<restriction
													base="string">
													<enumeration
														value="Y">
													</enumeration>
													<enumeration
														value="N">
													</enumeration>
												</restriction>
											</simpleType>
										</element>
										<element
											name="IDAssetConsistenza" type="long" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
						</choice>
					</complexType>
				</element>
				<element name="ReinvioDaFILE">
					<complexType>
						<sequence>
							<element name="GenerazioneNotifiche"
								maxOccurs="unbounded" minOccurs="0">
								<complexType>
									<sequence>


										<element
											ref="pref:RichiestaElement">
										</element>
										<element
											name="TipologiaNotifica" type="string">
										</element>
										<element name="OrigineNotifica"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element
											name="IDEventoOrdineNOW" type="int" maxOccurs="1"
											minOccurs="0">
										</element>
										<element
											name="TipologiaOLODestinatario" maxOccurs="1"
											minOccurs="0">
											<simpleType>
												<restriction
													base="string">
													<enumeration
														value="DONOR">
													</enumeration>
													<enumeration
														value="DONATING">
													</enumeration>
													<enumeration
														value="RECIPIENT">
													</enumeration>
												</restriction>
											</simpleType>
										</element>
										<element
											name="CodificaOLOAGCOMDestinatario" type="string"
											maxOccurs="1" minOccurs="0">
										</element>
										<element
											name="CodificaOLONOWDestinatario" type="string" maxOccurs="1"
											minOccurs="0">
										</element>


										<element
											name="FlagKORiscontroCodiceSessione" maxOccurs="1"
											minOccurs="0">
											<simpleType>
												<restriction
													base="string">
													<enumeration
														value="Y">
													</enumeration>
													<enumeration
														value="N">
													</enumeration>
												</restriction>
											</simpleType>
										</element>
										<element
											name="IDAssetConsistenza" type="long" maxOccurs="1"
											minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
							<element name="ReinvioNotifiche"
								maxOccurs="unbounded" minOccurs="0">
								<complexType>
									<sequence>
										<element name="IDNotifica"
											type="int">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
			</choice>
		</complexType>
	</element>

	<element name="ReinvioSchedulerResponse">
		<complexType>
			<sequence>
				<element name="Response" maxOccurs="unbounded" minOccurs="1">
					<complexType>
						<sequence>
							<element name="Codice" type="string"></element>
							<element name="Descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>

	<element name="ReinvioSchedulerFault">
		<complexType>
			<sequence>
				<element name="Codice" type="string"></element>
				<element name="Descrizione" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>
