<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/ToolScarto"
	elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/ToolScarto"
	xmlns:pref="http://NOW.it.telecomitalia.it/casedata" xmlns:pref1="http://www.tim.com/NOW/xsd/NotificationManager/">
	<element name="ToolScartoInput">
		<complexType>
			<sequence>
				<element name="DatiNotificaScarto">
					<complexType>
						<sequence>
							<element name="IDRichiestaOLO"
								type="string" />
							<element name="IDAnagraficaCausale"
								type="int" />
							<element name="IDAnagraficaCausaleDONOR"
								type="int" maxOccurs="1" minOccurs="0"/>
							<element name="IDAnagraficaCausaleDONATING"
								type="int" maxOccurs="1" minOccurs="0"/>
							<element name="IDAnagraficaCausaleDPPDONATING"
								type="int" maxOccurs="1" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ToolScartoOutput">
		<complexType>
			<sequence>
				<element name="Esito" type="tns:esito"></element>
			</sequence>
		</complexType>
	</element>
	<element name="ToolScartoFault" type="tns:esito"></element>
	<complexType name="output">
		<sequence>
			<element name="Codice" type="string" />
			<element minOccurs="0" name="Descrizione" type="string" />
		</sequence>
	</complexType>


	<complexType name="esito">
		<sequence>
			<element name="IDRichiestaOLO" type="string"></element>
			<element name="Esito" type="tns:output"></element>
		</sequence>
	</complexType>


</schema>
