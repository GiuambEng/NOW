<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/RigenerazioneEmail" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/RigenerazioneEmail">
	<element name="RigenerazioneEmailRequest">
    	<complexType>
    		<sequence>
    			<element name="IDNotifica" type="int" minOccurs="1" maxOccurs="unbounded"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="RigenerazioneEmailResponse">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="tns:output"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="RigenerazioneEmailFault" type="tns:output">
    </element>
    <complexType name="output">
		<sequence>
			<element name="Codice" type="string"/>
			<element minOccurs="0" name="Descrizione" type="string"/>
		</sequence>
	</complexType>
</schema>