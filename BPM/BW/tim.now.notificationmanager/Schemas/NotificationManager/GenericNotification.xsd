								<sequence>
									<element name="CodiceFornitore">
										<simpleType>
											<restriction base="string">
												<maxLength value="3" />
												<minLength value="3" />
											</restriction>
										</simpleType>
									</element>
									<element name="CodiceOrdineFornitore" minOccurs="0">
										<simpleType>
											<restriction base="string">
												<maxLength value="31" />
												<minLength value="1" />
											</restriction>
										</simpleType>
									</element>
									<element name="CodiceOrdineRichiedente">
										<simpleType>
											<restriction base="string">
												<maxLength value="11" />
												<minLength value="1" />
											</restriction>
										</simpleType>
									</element>
									<element name="DataNotifica" type="ns0:DataType" />
									<element name="StatoOrdine">
										<simpleType>
											<restriction base="string">
												<maxLength value="1" />
												<minLength value="1" />
												<enumeration value="0" />
												<enumeration value="1" />
												<enumeration value="2" />
												<enumeration value="3" />
											</restriction>
										</simpleType>
									</element>
									<element name="DataDRO" type="ns0:DataType" minOccurs="0" />
