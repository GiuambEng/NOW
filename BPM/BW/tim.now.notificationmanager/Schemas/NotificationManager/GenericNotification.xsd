										</restriction>
									</simpleType>
								</element>
							</sequence>
						</complexType>
					</element>
					<element name="TestataVsDonorDonating">
						<complexType>
							<sequence>
								<element name="CodiceDonating">
									<simpleType>
										<restriction base="string">
											<length value="3" />
										</restriction>
									</simpleType>
								</element>
								<element name="CodiceOrdineRiferimentoTI">
									<simpleType>
										<restriction base="string">
											<minLength value="1" />
											<maxLength value="31" />
										</restriction>
									</simpleType>
								</element>
								<choice>
									<element name="CodiceRisorsa1">
										<simpleType>
											<restriction base="string">
												<minLength value="1" />
												<maxLength value="12" />
											</restriction>
										</simpleType>
									</element>
									<element name="CodiceRisorsa2">
										<simpleType>
											<restriction base="string">
												<minLength value="1" />
												<maxLength value="12" />
											</restriction>
										</simpleType>
									</element>
								</choice>
								<choice>
									<element name="CodiceSessione1">
										<simpleType>
											<restriction base="string">
												<maxLength value="50" />
											</restriction>
										</simpleType>
									</element>
									<element name="CodiceSessione2">
										<simpleType>
											<restriction base="string">
												<maxLength value="50" />
											</restriction>
										</simpleType>
									</element>
								</choice>
								<element name="DataNotifica" type="pref2:DataTimeType" />
								<element name="DataDRO" type="pref2:DataType" />
								<element name="Note" minOccurs="0" maxOccurs="1">
									<simpleType>
										<restriction base="string">
											<maxLength value="255" />
										</restriction>
									</simpleType>
								</element>
							</sequence>
						</complexType>
					</element>
					<element name="Testata" type="pref7:TestataNotifica" />
				</choice>
			</sequence>
