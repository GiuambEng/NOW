									<element name="CodiceRisorsa2" type="string" minOccurs="0"
										maxOccurs="1" />
									<element name="DataNotifica" type="string" />
									<element name="DataDRO" type="string" />
									<element name="Note" type="string" minOccurs="0"
										maxOccurs="1" />
								</sequence>
							</complexType>
						</element>
						<element name="TestataVsDonorDonating" minOccurs="0"
							maxOccurs="1">
							<complexType>
								<sequence>
									<element name="CodiceDonating" type="string" />
									<element name="CodiceOrdineRiferimentoTI" type="string" />
