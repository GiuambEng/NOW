										<simpleType>
											<restriction base="string">
												<minLength value="1" />
												<maxLength value="5" />
											</restriction>
										</simpleType>
									</element>
								</sequence>
							</complexType>
						</element>
						<element name="TestataFBS" minOccurs="0">
