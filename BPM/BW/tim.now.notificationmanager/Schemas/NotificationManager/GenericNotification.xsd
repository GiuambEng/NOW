			<element name="Descrizione" type="string" minOccurs="0" />
		</sequence>
	</complexType>
	<element name="TestataRegolatorio">
		<complexType>
			<sequence>
				<choice>
					<element name="TestataRegolatorio" type="pref2:TestataNotifica" />
					<element name="TestataVsRecipient">
						<complexType>
							<sequence>
								<element name="CodiceRecipient">
									<simpleType>
										<restriction base="string">
											<length value="3" />
										</restriction>
									</simpleType>
								</element>
								<element name="CodiceOrdineRecipient">
									<simpleType>
										<restriction base="string">
											<minLength value="1" />
											<maxLength value="11" />
										</restriction>
									</simpleType>
								</element>
								<element name="CodiceRisorsa1">
									<simpleType>
										<restriction base="string">
											<minLength value="1" />
											<maxLength value="12" />
										</restriction>
									</simpleType>
								</element>
								<element name="CodiceRisorsa2" minOccurs="0" maxOccurs="1">
									<simpleType>
										<restriction base="string">
