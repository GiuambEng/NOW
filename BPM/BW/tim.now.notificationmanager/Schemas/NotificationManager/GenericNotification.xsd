									<choice>
										<element name="CodiceSessione1" type="string" />
										<element name="CodiceSessione2" type="string" />
									</choice>
									<element name="DataNotifica" type="string" />
									<element name="DataDRO" type="string" />
									<element name="Note" type="string" minOccurs="0"
										maxOccurs="1" />
								</sequence>
							</complexType>
						</element>
						<element name="Testata" type="pref7:TestataNotifica"
							minOccurs="0" maxOccurs="1" />
