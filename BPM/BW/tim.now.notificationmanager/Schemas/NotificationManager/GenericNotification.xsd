					minOccurs="0" maxOccurs="1" />
				<element name="StatoNotifica" type="string" minOccurs="0"
					maxOccurs="1" />
			</sequence>
		</complexType>
	</element>
	<complexType name="NotificaGenericaResponseType">
		<sequence>
			<choice>
				<element ref="pref8:NotificaOLOFWA" />
