											<restriction base="string">
												<length value="3"/>
											</restriction>
										</simpleType>
									</element>
									<element name="CodiceOrdineFornitore" minOccurs="0">
										<simpleType>
											<restriction base="string">
												<maxLength value="31"/>
												<minLength value="1"/>
											</restriction>
										</simpleType>
									</element>
									<element name="CodiceOrdineRichiedente">
										<simpleType>
											<restriction base="string">
												<maxLength value="11"/>
												<minLength value="1"/>
											</restriction>
										</simpleType>
									</element>
									<element name="DataNotifica" type="pref2:DataType"/>
									<element name="StatoOrdine">
										<simpleType>
											<restriction base="string">
												<maxLength value="2"/>
												<enumeration value="0"/>
												<enumeration value="1"/>
												<enumeration value="2"/>
												<enumeration value="3"/>
												<enumeration value="4"/>
												<enumeration value="5"/>
												<enumeration value="6"/>
												<enumeration value="7"/>
												<enumeration value="8"/>
												<enumeration value="9"/>
												<enumeration value="10"/>
											</restriction>
										</simpleType>
									</element>
									<element name="DataDRO" type="pref2:DataTimeType" minOccurs="0"/>
									<element name="CodiceOrdineOF" minOccurs="0">
										<simpleType>
											<restriction base="string">
												<maxLength value="18"/>
												<minLength value="1"/>
											</restriction>
										</simpleType>
									</element>
									<element name="Note" minOccurs="0">
										<simpleType>
											<restriction base="string">
												<maxLength value="255"/>
											</restriction>
										</simpleType>
									</element>
									<element name="TimestampOrigine" type="pref2:DataTimeType" minOccurs="0"/>
								</sequence>
							</complexType>
						</element>
					</sequence>
				</complexType>
			</element>
			<element name="Richiesta" type="tns1:Richiesta" />
			<element name="Offerta" type="tns1:OffertaEnumeration"
				minOccurs="0" />
			<element name="TipologiaNotifica" type="string" />
			<element name="IDEventoOrdineNOW" type="int" minOccurs="0"
				maxOccurs="1" />
			<element name="TipologiaOLODestinatario">
				<simpleType>
					<restriction base="string">
						<enumeration value="DONOR" />
						<enumeration value="DONATING" />
						<enumeration value="RECIPIENT" />
					</restriction>
				</simpleType>
			</element>
			<element name="CodificaOLOAGCOMDestinatario" type="string"
				minOccurs="0" maxOccurs="1" />
			<element name="FlagKORiscontroCodiceSessione" minOccurs="0"
				maxOccurs="1">
				<simpleType>
					<restriction base="string">
						<enumeration value="Y" />
