<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ToolScartoUtil"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/ToolScartoUtil"
	xmlns:pref="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:pref1="http://NOW.it.telecomitalia.it/casedata_v1">
	<import schemaLocation="NotificationManager.xsd"
		namespace="http://www.tim.com/NOW/xsd/NotificationManager/">
	</import>
	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="CalcoloPostPreDelivery">
		<complexType>
			<sequence>
				<element name="NotificaDaInviare" maxOccurs="unbounded"
					minOccurs="1">
					<complexType>
						<sequence>
							<element name="TipologiaNotifica"
								type="string">
							</element>
							<element name="TipologiaDestinatario"
								type="string">
							</element>
							<element name="StatoRichiesta"
								type="string">
							</element>
                            <element name="DoppioDonating" type="boolean" maxOccurs="1" minOccurs="0"></element>
                            <element name="IDAssetConsistenza"
								type="long" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ToolScartoAggiornamentoDBInput">
		<complexType>
			<sequence>
				<element ref="pref1:RichiestaElement"></element>
			</sequence>
		</complexType>
	</element>
	<element name="ToolScartoRecuperoTracciatoInput">
		<complexType>
			<sequence>
				<element name="IDRichiestaOLO" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="ToolScartoRecuperoTracciatoOutput">
		<complexType>
			<sequence>
				<element ref="pref1:RichiestaElement"></element>
				<element name="IDEventoOrdineNOW" type="int"
					maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
</schema>