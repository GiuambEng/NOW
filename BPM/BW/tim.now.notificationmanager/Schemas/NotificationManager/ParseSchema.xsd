<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ParseSchema/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/ParseSchema/"
	xmlns:ns0="http://xsd.telecomitalia.it/crm/xdsl/nga"
	xmlns:pref="http://xsd.telecomitalia.it/crm/xdsl/order"
	xmlns:pref1="http://xsd.telecomitalia.it/crm/regolatorio" xmlns:pref2="http://NOW.it.telecomitalia.it/casedata">
	<import
		schemaLocation="../SchemaOLO/NOW_Tracciato_OLO_ServiziNGA_v3.0.xsd"
		namespace="http://xsd.telecomitalia.it/crm/xdsl/nga">
	</import>
	<import
		schemaLocation="../SchemaOLO/NOW_Tracciato_OLO_ServizixDSL_v2.0.xsd"
		namespace="http://xsd.telecomitalia.it/crm/xdsl/order">
	</import>
	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata"></import>
	<element name="ParseSchemaRequest">
		<complexType>
			<sequence>
				<element name="StringaNotifica" type="string"></element>
				<element name="StrutturaRichiesta" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="IDRichiestaOLO" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="GPON" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="Flag103" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
	<element name="ParseSchemaResponse">
		<complexType>
			<sequence>
				<element name="Esito" type="string"></element>
			</sequence>
		</complexType>
	</element>
	<element name="ParseSchemaResponseStruttura">
		<complexType>
			<sequence>
				<element ref="pref2:RichiestaElement"></element>
				<element name="Notifica" maxOccurs="1" minOccurs="0">
					<complexType>
						<choice>
							<element name="RICHIESTA_NGA">
								<complexType>
									<sequence>
										<element
											ref="ns0:RICHIESTA">
										</element>
									</sequence>
								</complexType>
							</element>
							<element name="RICHIESTA_XDSL">
								<complexType>
									<sequence>
										<element
											ref="pref:RICHIESTA">
										</element>
									</sequence>
								</complexType>
							</element>
						</choice>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>