<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NotificationScheduler" targetNamespace="http://www.tim.com/NOW/xsd/NotificationScheduler" elementFormDefault="qualified">
	<element name="Record">
		<complexType>
			<sequence>
				<element name="RecordNotifiche" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="CodiceOLO" type="string"/>
							<element name="CodiceOLOAGCOM" type="string"/>
							<element name="IDNotifica" type="decimal"/>
							<element name="TipologiaNotifica" type="string"/>
							<element name="IDRichiestaOLO" type="string"/>
							<element name="TimestampNotifica" type="dateTime"/>
							<element name="StrutturaRichiesta" type="string"/>
							<element name="TracciatoFile" type="string"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="SchedulerOutput" type="string"/>
	<element name="SchedulerInput">
		<complexType>
			<sequence>
				<element name="TempoNotifica" type="string"/>
				<element name="StrutturaRichiesta" type="string"/>
				<element name="CodiceOLO" type="string"/>
				<element name="CodiceOLOAGCOM" type="string"/>
				<element name="FlagNamespaceFileNotifica" type="string" minOccurs="0"/>
				<element name="LocalPath" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="NomeFileCPS" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="SchedulerFault" type="string"/>
	<element name="NumeroNotificheGeneriche">
		<complexType>
			<sequence>
				<element name="NumeroNotifiche" type="tns:NumeroNotificheType"/>
				<element name="NumeroNotificheAQ" type="tns:NumeroNotificheType"/>
			</sequence>
		</complexType>
	</element>
	<complexType name="NumeroNotificheType">
		<sequence>
			<element name="NotificheTotali" type="int"/>
			<element name="NotificheOK" type="int"/>
			<element name="NoticheKO" type="int"/>
			<element name="NotificheIntermedie" type="int"/>
			<element name="NotificheMigrazioni" type="int"/>
			<element name="IDNotifica" type="int" minOccurs="0" maxOccurs="unbounded"/>
		</sequence>
	</complexType>
	<element name="IDNotifiche">
		<complexType>
			<sequence>
				<element name="IDNotifiche" type="int" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="Notifiche">
		<complexType>
			<sequence>
				<element name="Notifiche" type="string" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<element name="TimetoSecond">
		<complexType>
			<sequence>
				<element name="OraInvio" type="int"/>
				<element name="MinutiInvio" type="int"/>
				<element name="OraStart" type="int"/>
				<element name="MinutiStart" type="int"/>
				<element name="OraEnd" type="int"/>
				<element name="MinutiEnd" type="int"/>
			</sequence>
		</complexType>
	</element>
	<element name="ContenutoXML">
		<complexType>
			<sequence>
				<element name="ContenutoXML" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="ContenutoXML" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="IDNotifica" type="int" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="NumeriTelefonici">
		<complexType>
			<sequence>
				<element name="NumeriTelefonici" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="TelefonoFissoReferente" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="TelefonoMobileReferente" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="NomeReferente" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CognomeReferente" type="string" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
