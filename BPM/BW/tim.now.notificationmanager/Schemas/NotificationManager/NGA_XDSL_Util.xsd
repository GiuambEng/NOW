<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NGA_XDSL_Util" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1" targetNamespace="http://www.tim.com/NOW/xsd/NGA_XDSL_Util" elementFormDefault="qualified">
	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
	<element name="NGA">
		<complexType>
			<sequence>
				<element name="Dati_UserVlan" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="UserVlan_ID" type="integer" minOccurs="0" maxOccurs="1"/>
							<element name="S_VLAN_CODE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<minLength value="0"/>
										<maxLength value="16"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CVLAN_ID" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="integer">
										<minInclusive value="2"/>
										<maxInclusive value="4000"/>
									</restriction>
								</simpleType>
							</element>
							<element name="INTERMEDIATE_AGENT" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="50"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DHCP_OPTION_82" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="50"/>
									</restriction>
								</simpleType>
							</element>
							<element name="INTERMEDIATE_AGENT_CIRCUIT_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
							<element name="INTERMEDIATE_AGENT_REMOTE_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
							<element name="DHCP_OPTION_82_CIRCUIT_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
							<element name="DHCP_OPTION_82_REMOTE_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
							<element name="FlagMulticast" type="tns:FlagMuticast" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="XDSL">
		<complexType>
			<sequence>
				<element name="DATI_VC" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="VPI_CLIENTE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="5"/>
									</restriction>
								</simpleType>
							</element>
							<element name="VCI_CLIENTE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="5"/>
									</restriction>
								</simpleType>
							</element>
							<element name="VPI_RETE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="5"/>
									</restriction>
								</simpleType>
							</element>
							<element name="VCI_RETE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="5"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DLCI_CLIENTE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="5"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CODE_VP" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="16"/>
									</restriction>
								</simpleType>
							</element>
							<element name="KIT_CONSEGNA" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="9"/>
									</restriction>
								</simpleType>
							</element>
							<element name="INTERMEDIATE_AGENT" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="50"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CODE_VLAN_SINGLE_TAG" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="16"/>
									</restriction>
								</simpleType>
							</element>
							<element name="CLASSE_SERVIZIO" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="2"/>
									</restriction>
								</simpleType>
							</element>
							<element name="S_VLAN_CODE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<minLength value="0"/>
										<maxLength value="16"/>
									</restriction>
								</simpleType>
							</element>
							<element name="C_VLAN_CODE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="int">
										<minInclusive value="2"/>
										<maxInclusive value="4000"/>
									</restriction>
								</simpleType>
							</element>
							<element name="OPTION_82" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="50"/>
									</restriction>
								</simpleType>
							</element>
							<element name="INTERMEDIATE_AGENT_CIRCUIT_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
							<element name="INTERMEDIATE_AGENT_REMOTE_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
							<element name="OPTION_82_CIRCUIT_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
							<element name="OPTION_82_REMOTE_ID" type="tns:IntermediateAgentFullOUTType" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="Referente">
		<complexType>
			<sequence>
				<element name="PresenzaReferente" type="boolean"/>
				<element name="ReferenteRipetitivo" minOccurs="0" maxOccurs="4">
					<complexType>
						<sequence>
							<element name="ProgressivoReferente" type="int"/>
							<element name="CognomeReferente" type="string"/>
							<element name="NomeReferente" type="string"/>
							<element name="TelefonoFisso" type="string"/>
							<element name="TelefonoFissoReferente" type="string"/>
							<element name="TelefonoMobile" type="string"/>
							<element name="TelefonoMobileReferente" type="string"/>
							<element name="DataContatto" type="string" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="ReferenteRequest">
		<complexType>
			<sequence>
				<element name="IDRichiestaOLO" type="string"/>
				<element name="IDEventoOrdineNOW" type="int" minOccurs="0"/>
				<element name="IDRichiestaOLOEvento" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="ReferenteFault">
		<complexType>
			<sequence>
				<element name="Codice" type="string"/>
				<element name="Descrizione" type="string" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
	<element name="MigrazioniResponse">
		<complexType>
			<sequence>
				<element name="TIPO_COMUNICAZIONE">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="STATO" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
							<minLength value="1"/>
						</restriction>
					</simpleType>
				</element>
				<element name="CAUSALE_RIFIUTO" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<maxLength value="2"/>
						</restriction>
					</simpleType>
				</element>
				<element name="DIRECTORY_NUMBER" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="DIRECTORY_NUMBER" type="string" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
	<element name="MigrazioniRequest">
		<complexType>
			<sequence>
				<element name="IDRichiestaOLO" type="string"/>
				<element name="TipologiaNotifica" type="string"/>
				<element name="TipologiaOLODestinatario" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="statoRichiestaOLO" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="FlagKORiscontroCodiceSessione" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="CodificaOLOAgicomDestinatario" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="dettaglioordine" type="pref:DettaglioOrdine" minOccurs="0" maxOccurs="unbounded"/>
			</sequence>
		</complexType>
	</element>
	<simpleType name="DataType">
		<restriction base="string">
			<minLength value="10"/>
			<maxLength value="10"/>
			<pattern value="\d{2}/\d{2}/\d{4}"/>
		</restriction>
	</simpleType>
	<simpleType name="DataTypeDataNotifica">
		<restriction base="string">
			<minLength value="16"/>
			<maxLength value="16"/>
			<pattern value="\d{2}/\d{2}/\d{4} \d{2}:\d{2}"/>
		</restriction>
	</simpleType>
	<simpleType name="IntermediateAgentFullOUTType">
		<restriction base="string">
			<maxLength value="63"/>
		</restriction>
	</simpleType>
	<simpleType name="FlagMuticast">
		<restriction base="string">
			<enumeration value="SI"/>
		</restriction>
	</simpleType>
	<element name="Numeri">
		<complexType>
			<sequence>
				<element name="NUMERO" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="NUMERO_AGGIUNTIVO" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="DIRECTORY">
		<complexType>
			<sequence>
				<element name="DIRECTORY_NUMBER" minOccurs="0" maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="DIRECTORY_NUMBER" type="string" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
