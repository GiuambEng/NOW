<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ns0="http://xsd.telecomitalia.it/crm/xdsl/nga" xmlns:pref="http://www.tim.com/NOW/xsd/CommonSchema/" xmlns:pref1="http://www.tim.com/NOW/xsd/CRMWS_ServiziRegolamentati/" xmlns:pref2="http://xsd.telecomitalia.it/crm/xdsl/regolatorio" xmlns:pref3="http://xsd.telecomitalia.it/crm/xdsl/order" xmlns:tns="http://www.tim.com/NOW/xsd/NotificationManager/" xmlns:tns1="http://NOW.it.telecomitalia.it/casedata_v1" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NotificationManager/">



	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd">
	</import>
	
	<import namespace="http://www.tim.com/NOW/xsd/CommonSchema/" schemaLocation="../../../tim.now.shared_library/Schemas/CommonSchema/CommonSchema.xsd"/>
	<element name="NotificationRequest">
		<complexType>
			<sequence>
				<element ref="tns1:RichiestaElement" />
				<element name="TipologiaNotifica" type="string" />
				<element name="OrigineNotifica" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="IDEventoOrdineNOW" type="int"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="TipologiaOLODestinatario" maxOccurs="1"
					minOccurs="0">
					<simpleType>
						<restriction base="string">
							<enumeration value="DONOR"></enumeration>
							<enumeration value="DONATING"></enumeration>
							<enumeration value="RECIPIENT"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="CodificaOLOAGCOMDestinatario"
					type="string" maxOccurs="1" minOccurs="0">
				</element>
				<element name="CodificaOLONOWDestinatario" type="string"
					maxOccurs="1" minOccurs="0">
				</element>

				<element name="FlagKORiscontroCodiceSessione"
					maxOccurs="1" minOccurs="0">
					<simpleType>
						<restriction base="string">
							<enumeration value="Y"></enumeration>
							<enumeration value="N"></enumeration>
						</restriction>
					</simpleType>
				</element>
				<element name="IDAssetConsistenza" type="long" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="NotificationResponse">
		<complexType>
			<sequence>
				<element minOccurs="0" name="IdNotifica" type="int" />
                <element name="IdAnagraficaCausaleGUI" type="int" maxOccurs="1" minOccurs="0"></element>
                <element name="Esito" type="tns:output" />
			</sequence>
		</complexType>
	</element>
	<element name="NotificationFault" type="tns:output"/>
	<complexType name="output">
		<sequence>
			<element name="Codice" type="string"/>
			<element minOccurs="0" name="Descrizione" type="string"/>
		</sequence>
	</complexType>






</schema>
