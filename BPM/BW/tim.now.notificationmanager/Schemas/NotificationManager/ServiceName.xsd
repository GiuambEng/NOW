<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ServiceName" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceName" xmlns:Q1="http://NOW.it.telecomitalia.it/casedata_v1">

    <import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"></import>
    <element name="ServiceNameRequest">
    	<complexType>
    		<sequence>
    			<element name="StrutturaRichiesta" type="string"></element>
    			<element name="TipologiaNotifica" type="string"></element>
    			<element name="Offerta" type="Q1:OffertaEnumeration"
    				minOccurs="0">
    			</element>
    			<element name="Lavorazione"
    				type="Q1:LavorazioneEnumeration">
    			</element>
    			<element name="TipologiaOLODestinatario"
    				type="string">
    			</element>
    			<element name="CodificaOLOAGCOMDestinatario"
    				type="string" maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="IDRichiestaOLO" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="IDAsset" type="string" maxOccurs="1" minOccurs="0"/>
    			<element name="Flag103" type="string" maxOccurs="1" minOccurs="0"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="ServiceNameResponse">
    	<complexType>
    		<sequence>
    			<element name="StrutturaRichiesta" type="string"></element>
    			<element name="TipologiaNotifica" type="string"></element>
    			<element name="Offerta" type="Q1:OffertaEnumeration"
    				minOccurs="0">
    			</element>
    			<element name="Lavorazione"
    				type="Q1:LavorazioneEnumeration">
    			</element>
    			<element name="TipologiaOLODestinatario"
    				type="string">
    			</element>
    			<element name="IDRichiestaOLO" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="CodificaOLOAGCOMDestinatario"
    				type="string" maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="ServiceName" type="string"></element>
    			<element name="IDAsset" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>