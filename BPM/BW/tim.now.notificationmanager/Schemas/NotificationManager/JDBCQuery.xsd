<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/JDBCQuery"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/JDBCQuery" xmlns:pref="http://www.tim.com/NOW/xsd/GenericNotification">

	<import schemaLocation="GenericNotification.xsd" namespace="http://www.tim.com/NOW/xsd/GenericNotification"></import>
	<element name="JDBCQueryRequest">
		<complexType>
			<sequence>
				<element name="NotificaGenericaRequest" type="pref:NotificaGenericaRequestType"></element>
			</sequence>
		</complexType>
	</element>

	<element name="JDBCQueryResponse">
		<complexType>
			<sequence>
				<element name="Group1" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="DataInvioMessaggio"
								type="date" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="Group2" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="CodiceOLORecipient"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="CodiceSegreto" maxOccurs="1"
								minOccurs="0" type="string">
							</element>
							<element name="TipoLinea" minOccurs="0"
								maxOccurs="1" type="string">
							</element>
							<element name="DataAttesaConsegnaServizio"
								type="date" maxOccurs="1" minOccurs="0">
							</element>
							<element
								name="CognomeCliente_RagioneSociale" type="string" maxOccurs="1"
								minOccurs="0">
							</element>
							<element name="NomeCliente" type="string"
								minOccurs="0" maxOccurs="1">
							</element>
							<element name="TelefonoReferenteRichiedente"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
							<element name="EmailReferenteRichiedente"
								type="string" maxOccurs="1" minOccurs="0">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="Group3" maxOccurs="1" minOccurs="0">
					<complexType>
						<sequence>
							<element name="TipoLinea" type="string"
								minOccurs="0" maxOccurs="1">
							</element>
							<element name="Telecom" maxOccurs="1"
								minOccurs="0">
								<complexType>
									<sequence>
										<element name="Rientro"
											maxOccurs="1" minOccurs="0">
											<complexType>
												<sequence>
													<element
														name="RientroTI" type="string" maxOccurs="1"
														minOccurs="0">
													</element>
													<element
														name="DataAttesaConsegnaServizio" type="date"
														maxOccurs="1" minOccurs="0">
													</element>
													<element
														name="CognomeCliente_RagioneSociale" type="string"
														maxOccurs="1" minOccurs="0">
													</element>
													<element
														name="NomeCliente" type="string" minOccurs="0"
														maxOccurs="1">
													</element>
													<element
														name="TelefonoReferenteRichiedente" type="string"
														maxOccurs="1" minOccurs="0">
													</element>
													<element
														name="EmailReferenteRichiedente" type="string"
														maxOccurs="1" minOccurs="0">
													</element>
												</sequence>
											</complexType>
										</element>
										<element name="NPAggiuntive"
											maxOccurs="1" minOccurs="0">
											<complexType>
												<sequence>
													<element
														name="NumAggiuntivaPortata" type="string" minOccurs="0"
														maxOccurs="7">
													</element>
												</sequence>
											</complexType>
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="DefTipoLinea" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="ISDN" maxOccurs="1"
								minOccurs="0">
								<complexType>
									<sequence>
										<element name="TipoLineaID"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
										<element
											name="flagNPNumerazioniAggiuntive" type="string"
											maxOccurs="1" minOccurs="0">
										</element>
										<element name="NumAggiuntiva"
											minOccurs="0" maxOccurs="1">
											<complexType>
												<sequence>
													<element
														name="NumAggiuntivaPortata" type="string" minOccurs="0"
														maxOccurs="7">
													</element>
												</sequence>
											</complexType>
										</element>
									</sequence>
								</complexType>
							</element>
							<element name="GNR" maxOccurs="1"
								minOccurs="0">
								<complexType>
									<sequence>
										<element name="TipoLineaID"
											type="string" maxOccurs="1" minOccurs="0">
										</element>
									</sequence>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="CodificaOLOAGCOMDonor" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="CodificaOLOAGCOMDonating" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="JDBCQueryFault" type="string"></element>
</schema>