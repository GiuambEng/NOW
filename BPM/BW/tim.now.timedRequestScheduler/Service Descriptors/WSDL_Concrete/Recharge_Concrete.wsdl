<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<wsdl:definitions xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/Recharge/" xmlns:ns0="http://telecomitalia.it/Recharge/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="RechargePortType" targetNamespace="http://www.tim.com/NOW/wsdl/abstract/Recharge/">
	<wsdl:import namespace="http://telecomitalia.it/Recharge/" location="../../Schemas/Recharge.xsd"/>
	<wsdl:message name="RechargeRequest">
		<wsdl:part name="Request" element="ns0:Request"/>
	</wsdl:message>
	<wsdl:message name="RechargeResponse">
		<wsdl:part name="Response" element="ns0:Response"/>
	</wsdl:message>
	<wsdl:message name="RechargeFault">
		<wsdl:part name="Fault" element="ns0:Fault"/>
	</wsdl:message>
	<wsdl:portType name="RechargePortType">
		<wsdl:operation name="Recharge">
			<wsdl:input message="ns:RechargeRequest"/>
			<wsdl:output message="ns:RechargeResponse"/>
			<wsdl:fault name="fault" message="ns:RechargeFault"/>
		</wsdl:operation>
	</wsdl:portType>
	<wsdl:binding name="SOAPServiceBinding1" type="ns:RechargePortType">
		<soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
		<wsdl:operation name="Recharge">
			<soap:operation soapAction="Recharge" style="document"/>
			<wsdl:input>
				<soap:body parts="Request" use="literal"/>
			</wsdl:input>
			<wsdl:output>
				<soap:body parts="Response" use="literal"/>
			</wsdl:output>
			<wsdl:fault name="fault">
				<soap:fault name="fault" use="literal"/>
			</wsdl:fault>
		</wsdl:operation>
	</wsdl:binding>
	<wsdl:service name="RechargePortType">
		<wsdl:port name="RechargePortTypeSOAP" binding="ns:SOAPServiceBinding1">
			<soap:address location="https://localhost:9365/SOAPServiceBinding1/rechargePortType/"/>
		</wsdl:port>
	</wsdl:service>
</wsdl:definitions>
