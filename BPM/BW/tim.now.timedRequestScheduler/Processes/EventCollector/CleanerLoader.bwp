            </endingVariables>
        </task>
        <task name="LogContatore">
            <endingVariables>
                <variable>LogContatore-input</variable>
            </endingVariables>
        </task>
        <task name="Log2">
            <endingVariables>
                <variable>Log2-input</variable>
            </endingVariables>
        </task>
        <task name="InsertEC_PURGE">
            <endingVariables>
                <variable>InsertEC_PURGE-input</variable>
                <variable>InsertEC_PURGE</variable>
            </endingVariables>
        </task>
        <task name="LogError">
