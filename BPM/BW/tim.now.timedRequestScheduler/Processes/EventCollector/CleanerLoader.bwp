    <tibex:VariableDescriptor type="MemorySaving">
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
                <variable>LoggerName</variable>
                <variable>Start</variable>
            </endingVariables>
        </task>
        <task name="RepeatOnError">
            <endingVariables>
                <variable>Retry</variable>
                <variable>index</variable>
                <variable>EcSession</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="GroupEnd2">
            <endingVariables>
                <variable>EC_MANAGED_OBJ_LIFECYCLE</variable>
            </endingVariables>
        </task>
        <task name="EC_MANAGED_OBJ_LIFECYCLE">
            <endingVariables>
