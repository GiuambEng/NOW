                                    sqlStatement="SELECT /*+ PARALLEL (6) */ ID_RICH_OLO,TIMESTAMP_INS,TIMESTAMP_AGG,ID_TPLG_STATO_RICH_OLO_TIBCO FROM RICHIESTA_OLO_TIBCO &#xa;WHERE &#xa;ID_TPLG_STATO_RICH_OLO_TIBCO=(SELECT ID_TPLG_STATO_RICH_OLO_TIBCO &#xa;FROM TPLG_STATO_RICH_OLO_TIBCO  &#xa;WHERE DESC_TPLG_STATO_RICH_OLO_TIBCO='IN SVECCHIAMENTO')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
