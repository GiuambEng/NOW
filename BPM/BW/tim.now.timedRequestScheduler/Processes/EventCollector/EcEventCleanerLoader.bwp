            <bpws:throw faultName="ns29:DefaultFault"
                faultVariable="Throw-input" name="Throw" tibex:xpdlId="71dd0398-c4d3-43a2-bc27-06a34b4d8024">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;EC_MANAGED&quot;/>&lt;xsl:param name=&quot;UpdateRich_OLO_Tibco&quot;/>&lt;xsl:param name=&quot;EC_PURGE&quot;/>&lt;xsl:param name=&quot;RichOloTibco&quot;/>&lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&lt;tns:DefaultFault>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichOloTibco/outputSet/ERROR_CODE!='0'&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Procedura eseguita con errore:&amp;quot;, &amp;quot;Error Code:&amp;quot;, $RichOloTibco/outputSet/ERROR_CODE, &amp;quot;Error Message:&amp;quot;, $RichOloTibco/outputSet/ERROR_MESSAGE)&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:when test=&quot; $EC_MANAGED/outputSet/ERROR_CODE!='0'&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Procedura eseguita con errore:&amp;quot;, &amp;quot;Error Code:&amp;quot;, $EC_MANAGED/outputSet/ERROR_CODE, &amp;quot;Error Message:&amp;quot;, $EC_MANAGED/outputSet/ERROR_MESSAGE)&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:when test=&quot;$UpdateRich_OLO_Tibco/outputSet/ERROR_CODE !='0'&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Procedura eseguita con errore:&amp;quot;, &amp;quot;Error Code:&amp;quot;, $UpdateRich_OLO_Tibco/outputSet/ERROR_CODE, &amp;quot;Error Message:&amp;quot;, $UpdateRich_OLO_Tibco/outputSet/ERROR_MESSAGE)&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Procedura eseguita con errore:&amp;quot;, &amp;quot;Error Code:&amp;quot;, $EC_PURGE/outputSet/ERROR_CODE, &amp;quot;Error Message:&amp;quot;, $EC_PURGE/outputSet/ERROR_MESSAGE)&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichOloTibco/out