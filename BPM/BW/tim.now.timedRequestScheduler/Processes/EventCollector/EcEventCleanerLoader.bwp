            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogEC_MANAGED-input"
                    name="LogEC_MANAGED"
                    tibex:xpdlId="6aa75885-a1fd-44e1-829a-7e8a2f413929"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCCallProcedureToLog"/>
