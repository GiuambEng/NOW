                    <bpws:sources>
                        <bpws:source linkName="LogToMapper">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$EC_MANAGED/outputSet/ERROR_CODE = &quot;0&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$EC_MANAGED/outputSet/ERROR_CODE = "0"]]></bpws:transitionCondition>
