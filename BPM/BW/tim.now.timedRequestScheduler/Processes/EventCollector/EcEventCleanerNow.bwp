                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO LOG_FILE_PROCSTO (COD_PROCSO, ID_ESEC_PROCSO,&#xa;   LOG_LEVEL, LOG_MESSAGE, TIMSTP_INSMTO)&#xa;  VALUES (?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
