                        subProcessName="EventCollector.Log" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/NOW/B2BRicarica/Log/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Logger&quot;/>&lt;xsl:template name=&quot;LogLogger-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:msgCode>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;),  &amp;quot;PID: &amp;quot;, $_processContext/ProcessInstanceId )&quot;/>&lt;/tns:msgCode>&lt;tns:loggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:loggerName>&lt;tns:message>&lt;xsl:value-of select=&quot;concat('Procso no file',tib:render-xml($Logger/part1/ns:Output,true(), true()))&quot;/>&lt;/tns:message>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogLogger-input" name="LogLogger"
