                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROCSO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO"/>
