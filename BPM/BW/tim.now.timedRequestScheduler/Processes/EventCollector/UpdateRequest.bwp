    <tibex:VariableDescriptor type="MemorySaving">
        <task name="SVECCHIATA">
            <endingVariables>
                <variable>SVECCHIATA-input</variable>
                <variable>SVECCHIATA</variable>
            </endingVariables>
        </task>
        <task name="DeletePurgeSvecchiata">
            <endingVariables>
                <variable>DeletePurgeSvecchiata-input</variable>
                <variable>DeletePurgeSvecchiata</variable>
            </endingVariables>
        </task>
        <task name="DA_SVECCHIARE">
            <endingVariables>
