    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName1" tibex:xpdlId="1b9fdebd-a652-45bc-a810-1b2af1ee35ca">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow3">
                        <bpws:links>
                            <bpws:link name="LogToExit1" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:exit name="Exit1" tibex:xpdlId="2c3e49d0-d45b-4c24-8921-0b65233f36d7">
                            <bpws:targets>
                                <bpws:target linkName="LogToExit1"/>
                            </bpws:targets>
                        </bpws:exit>
                        <bpws:extensionActivity>
                            <tibex:extActivity inputVariable="Log-input"
                                name="Log"
                                tibex:xpdlId="593ca896-265f-46ce-a948-3f8019943b92"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogToExit1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/NOW/B2BRicarica/Log/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:msgCode>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;),  &amp;quot;PID: &amp;quot;, $_processContext/ProcessInstanceId )&quot;/>&lt;/tns:msgCode>&lt;tns:loggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:loggerName>&lt;tns:message>&lt;xsl:value-of select=&quot;concat('Fault EcEventCleaner',$FaultDetails/ActivityName,$FaultDetails/ProcessStack,$FaultDetails/StackTrace,$FaultDetails/MsgCode,$FaultDetails/Msg,$FaultDetails/FullClass,$FaultDetails/Class)&quot;/>&lt;/tns:message>&lt;tns:Error>&lt;xsl:value-of select=&quot;'error'&quot;/>&lt;/tns:Error>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess spawn="true"
