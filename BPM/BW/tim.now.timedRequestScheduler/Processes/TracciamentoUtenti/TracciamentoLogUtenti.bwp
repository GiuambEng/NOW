                portType="ns8:ServiceSecurity" tibex:xpdlId="c76da56c-f8d5-4a69-8c84-1ebac784feb4">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/LoggerServiceSecurityDataServices/" xmlns:tns1="http://www.example.org/ServicesSecurityData" xmlns:tns2="http://telecomitalia.it/NOW/BodyJMS/" xmlns:bw="http://www.tibco.com/bw/xpath/bw-custom-functions" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="COD_PROFILO"/&gt;&lt;xsl:param name="JMSReceiveMessage"/&gt;&lt;xsl:param name="LoggerName"/&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:param name="messageID"/&gt;&lt;xsl:template name="LogAccessiUtenti-input" match="/"&gt;&lt;tns:NewOperationRequest&gt;&lt;parameters&gt;&lt;tns1:LoggerSecurityInput&gt;&lt;tns1:LogInfo&gt;&lt;tns1:LoggerName&gt;&lt;xsl:value-of select="$LoggerName"/&gt;&lt;/tns1:LoggerName&gt;&lt;tns1:Application&gt;&lt;xsl:value-of select="bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)"/&gt;&lt;/tns1:Application&gt;&lt;tns1:LogLevel&gt;&lt;xsl:value-of select="'info'"/&gt;&lt;/tns1:LogLevel&gt;&lt;tns1:ServiceName&gt;&lt;xsl:value-of select="&amp;quot;TracciamentoLogUtenti&amp;quot;"/&gt;&lt;/tns1:ServiceName&gt;&lt;tns1:Operation&gt;&lt;xsl:value-of select="&amp;quot;TracciamentoLogUtenti&amp;quot;"/&gt;&lt;/tns1:Operation&gt;&lt;tns1:JMS&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns1:JMS&gt;&lt;/tns1:LogInfo&gt;&lt;tns1:InputDataUserLog&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$messageID = &amp;quot;WS_SECURITY_LOGOUT&amp;quot; or $messageID = &amp;quot;WS_SECURITY_LOGIN&amp;quot;"&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="'WORKSPACE'"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:APPLICAZIONE_CLIENT&gt;&lt;xsl:value-of select="'OPENSPACE'"/&gt;&lt;/tns1:APPLICAZIONE_CLIENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:COD_FUNZIONE&gt;&lt;xsl:value-of select="'TRACCIAMENTO LOG UTENTI'"/&gt;&lt;/tns1:COD_FUNZIONE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($COD_PROFILO/Record[COD_PROFILO='CRM_GA' or COD_PROFILO='CRM_PPS'])"&gt;&lt;tns1:COD_PROFILO&gt;&lt;xsl:value-of select="$COD_PROFILO/Record[1]/COD_PROFILO"/&gt;&lt;/tns1:COD_PROFILO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:COD_PROFILO&gt;&lt;xsl:value-of select="'CRM_GA'"/&gt;&lt;/tns1:COD_PROFILO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'clientIPAddr=`'),&amp;quot;`&amp;quot;))&gt;0"&gt;&lt;tns1:HOSTNAME_CLIENT&gt;&lt;xsl:value-of select="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'clientIPAddr=`'),&amp;quot;`&amp;quot;)"/&gt;&lt;/tns1:HOSTNAME_CLIENT&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:HOSTNAME_CLIENT&gt;&lt;xsl:value-of select="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostAddress=`'),&amp;quot;`&amp;quot;)"/&gt;&lt;/tns1:HOSTNAME_CLIENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$messageID = &amp;quot;WS_SECURITY_LOGOUT&amp;quot; or $messageID = &amp;quot;WS_SECURITY_LOGIN&amp;quot;"&gt;&lt;tns1:IP_CLIENT&gt;&lt;xsl:value-of select="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'clientIPAddr=`'),&amp;quot;`&amp;quot;)"/&gt;&lt;/tns1:IP_CLIENT&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:IP_CLIENT&gt;&lt;xsl:value-of select="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostAddress=`'),&amp;quot;`&amp;quot;)"/&gt;&lt;/tns1:IP_CLIENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:IP_SERVER&gt;&lt;xsl:value-of select="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostAddress=`'),&amp;quot;`&amp;quot;)"/&gt;&lt;/tns1:IP_SERVER&gt;&lt;tns1:SERVER_NAME&gt;&lt;xsl:value-of select="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostName=`'),&amp;quot;`&amp;quot;)"/&gt;&lt;/tns1:SERVER_NAME&gt;&lt;tns1:COD_INTRFC&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:COD_INTRFC&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($COD_PROFILO/Record)&gt;0"&gt;&lt;xsl:if test="$COD_PROFILO/Record[1]/USERID"&gt;&lt;tns1:USER_ID&gt;&lt;xsl:value-of select="$COD_PROFILO/Record[1]/USERID"/&gt;&lt;/tns1:USER_ID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:USER_ID&gt;&lt;xsl:value-of select="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'principalName=`'),&amp;quot;`&amp;quot;)"/&gt;&lt;/tns1:USER_ID&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:SESSION_ID&gt;&lt;xsl:value-of select="concat('LOGACCESSOUTENTI',$_processContext/ProcessInstanceId, string(tib:timestamp()))"/&gt;&lt;/tns1:SESSION_ID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$messageID = &amp;quot;OS_AUDIT_LOGIN&amp;quot; or $messageID = &amp;quot;WS_SECURITY_LOGIN&amp;quot;"&gt;&lt;tns1:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="&amp;quot;LOGIN&amp;quot;"/&gt;&lt;/tns1:TIPO_OPERAZIONE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:TIPO_OPERAZIONE&gt;&lt;xsl:value-of select="&amp;quot;LOGOUT&amp;quot;"/&gt;&lt;/tns1:TIPO_OPERAZIONE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:InputDataUserLog&gt;&lt;/tns1:LoggerSecurityInput&gt;&lt;/parameters&gt;&lt;/tns:NewOperationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/LoggerServiceSecurityDataServices/&quot; xmlns:tns1=&quot;http://www.example.org/ServicesSecurityData&quot; xmlns:tns2=&quot;http://telecomitalia.it/NOW/BodyJMS/&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;COD_PROFILO&quot;/>&#xa;    &lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;messageID&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAccessiUtenti-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:LoggerSecurityInput>&#xa;            &lt;tns1:LogInfo>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;)&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'info'&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:ServiceName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TracciamentoLogUtenti&amp;quot;&quot;/>&#xa;                &lt;/tns1:ServiceName>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;TracciamentoLogUtenti&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:JMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:JMS>&#xa;            &lt;/tns1:LogInfo>&#xa;            &lt;tns1:InputDataUserLog>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$messageID = &amp;quot;WS_SECURITY_LOGOUT&amp;quot; or $messageID = &amp;quot;WS_SECURITY_LOGIN&amp;quot;&quot;>&#xa;                        &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;'WORKSPACE'&quot;/>&#xa;                        &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:APPLICAZIONE_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;'OPENSPACE'&quot;/>&#xa;                        &lt;/tns1:APPLICAZIONE_CLIENT>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:COD_FUNZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'TRACCIAMENTO LOG UTENTI'&quot;/>&#xa;                &lt;/tns1:COD_FUNZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($COD_PROFILO/Record[COD_PROFILO='CRM_GA' or COD_PROFILO='CRM_PPS'])&quot;>&#xa;                        &lt;tns1:COD_PROFILO>&#xa;                            &lt;xsl:value-of select=&quot;$COD_PROFILO/Record[1]/COD_PROFILO&quot;/>&#xa;                        &lt;/tns1:COD_PROFILO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:COD_PROFILO>&#xa;                            &lt;xsl:value-of select=&quot;'CRM_GA'&quot;/>&#xa;                        &lt;/tns1:COD_PROFILO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'clientIPAddr=`'),&amp;quot;`&amp;quot;))>0&quot;>&#xa;                        &lt;tns1:HOSTNAME_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'clientIPAddr=`'),&amp;quot;`&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:HOSTNAME_CLIENT>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:HOSTNAME_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostAddress=`'),&amp;quot;`&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:HOSTNAME_CLIENT>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$messageID = &amp;quot;WS_SECURITY_LOGOUT&amp;quot; or $messageID = &amp;quot;WS_SECURITY_LOGIN&amp;quot;&quot;>&#xa;                        &lt;tns1:IP_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'clientIPAddr=`'),&amp;quot;`&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:IP_CLIENT>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:IP_CLIENT>&#xa;                            &lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostAddress=`'),&amp;quot;`&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:IP_CLIENT>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:IP_SERVER>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostAddress=`'),&amp;quot;`&amp;quot;)&quot;/>&#xa;                &lt;/tns1:IP_SERVER>&#xa;                &lt;tns1:SERVER_NAME>&#xa;                    &lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'hostName=`'),&amp;quot;`&amp;quot;)&quot;/>&#xa;                &lt;/tns1:SERVER_NAME>&#xa;                &lt;tns1:COD_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns1:COD_INTRFC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($COD_PROFILO/Record)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$COD_PROFILO/Record[1]/USERID&quot;>&#xa;                            &lt;tns1:USER_ID>&#xa;                                &lt;xsl:value-of select=&quot;$COD_PROFILO/Record[1]/USERID&quot;/>&#xa;                            &lt;/tns1:USER_ID>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:USER_ID>&#xa;                            &lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns2:_cl.msg,'principalName=`'),&amp;quot;`&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:USER_ID>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:SESSION_ID>&#xa;                    &lt;xsl:value-of select=&quot;concat('LOGACCESSOUTENTI',$_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns1:SESSION_ID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$messageID = &amp;quot;OS_AUDIT_LOGIN&amp;quot; or $messageID = &amp;quot;WS_SECURITY_LOGIN&amp;quot;&quot;>&#xa;                        &lt;tns1:TIPO_OPERAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;LOGIN&amp;quot;&quot;/>&#xa;                        &lt;/tns1:TIPO_OPERAZIONE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:TIPO_OPERAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;LOGOUT&amp;quot;&quot;/>&#xa;                        &lt;/tns1:TIPO_OPERAZIONE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:InputDataUserLog>&#xa;        &lt;/tns1:LoggerSecurityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogToLogAccessiUtenti"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LogAccessiUtentiToJDBCQuery">
                        <tibex:DesignExpression/>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="COD_PROFILO-input" name="COD_PROFILO"
                    outputVariable="COD_PROFILO"
                    tibex:xpdlId="5f9ab607-d3b7-4057-a3ae-2961bf993ad0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCOD_PROFILO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5f9ab607-d3b7-4057-a3ae-2961bf993ad0+input&quot; xmlns:tns1=&quot;http://telecomitalia.it/NOW/BodyJMS/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:template name=&quot;COD_PROFILO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;USER_ALIAS>&lt;xsl:value-of select=&quot;substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns1:_cl.msg,'principalName=`'),&amp;quot;`&amp;quot;)&quot;/>&lt;/USER_ALIAS>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COD_PROFILO,USERID FROM UTENTE WHERE USER_ALIAS=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="USER_ALIAS"/>
                                    <columnMetadata
                                    columnName="COD_PROFILO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="USERID"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm"
                    tibex:xpdlId="897d9d66-b1f5-449c-bb52-d79c20d4b0f6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToConfirm"/>
                        <bpws:target linkName="LogStartTracciamentoLogUtentiToConfirm"/>
                        <bpws:target linkName="AssignToConfirm"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ConfirmToLogEndTracciamentoLogUtenti"/>
                    </bpws:sources>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.confirm"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value
                                    confirmEvent="JMSReceiveMessage" xsi:type="generalactivities:Confirm"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="messageID"
                    name="Assign" outputVariable="messageID"
                    tibex:xpdlId="6f35228d-655c-48a9-8549-848985681a47" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartTracciamentoLogUtentiToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCOD_PROFILO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToConfirm">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$messageID != &quot;OS_AUDIT_LOGIN&quot; and $messageID != &quot;OS_AUDIT_LOGOUT&quot; and $messageID != &quot;WS_SECURITY_LOGIN&quot; and $messageID != &quot;WS_SECURITY_LOGOUT&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$messageID != "OS_AUDIT_LOGIN" and $messageID != "OS_AUDIT_LOGOUT" and $messageID != "WS_SECURITY_LOGIN" and $messageID != "WS_SECURITY_LOGOUT"]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns:_cl.msg,'messageId=`'),&quot;`&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="messageID" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateTRACC_ATTIVITA_UTENTE-input"
                    name="UpdateTRACC_ATTIVITA_UTENTE"
                    outputVariable="UpdateTRACC_ATTIVITA_UTENTE"
                    tibex:xpdlId="ff7c3a04-455d-4841-a13e-e68af1f37b30" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
