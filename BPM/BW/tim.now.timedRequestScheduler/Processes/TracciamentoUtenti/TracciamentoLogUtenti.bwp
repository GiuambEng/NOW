                        <bpws:source linkName="LogStartTracciamentoLogUtentiToConfirm">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="substring-before(tib:substring-after-last($JMSReceiveMessage/Body/tns:_cl.msg,'principalName=`'),&quot;`&quot;)='tibco-admin'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
