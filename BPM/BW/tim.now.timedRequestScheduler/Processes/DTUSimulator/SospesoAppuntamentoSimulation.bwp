        <bpws:variable element="ns6:ActivityInput"
            name="JMSSendSimulatedMessage-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:aEmptyOutputClass"
            name="JMSSendSimulatedMessage" sca-bpel:internal="true"/>
        <bpws:variable name="InboundDTU_queueName"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/DTUSimulator/InboundDTU_queueName" type="xsd:string"/>
        <bpws:variable element="ns1:ActivityInput"
