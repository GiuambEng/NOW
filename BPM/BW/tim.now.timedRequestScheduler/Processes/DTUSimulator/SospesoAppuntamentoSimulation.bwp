                    tibex:xpdlId="20e1bed0-0fe9-4301-b1fd-e4e26401bf8b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JMSReceiveMessageToLogMsgReceived"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogMsgReceivedToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;InternalQueueName&quot;/>&lt;xsl:template name=&quot;LogMsgReceived-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| PID: &amp;quot;, $_processContext/ProcessInstanceId, 'PVM: ', $JMSReceiveMessage/Body)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('RICEVUTO MESSAGGIO SULLA CODA: ', $InternalQueueName, &amp;quot;BODY TEXT: &amp;quot; ,$JMSReceiveMessage/Body)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateSIMULATION-input"
                    name="UpdateSIMULATION"
                    outputVariable="UpdateSIMULATION"
                    tibex:xpdlId="aaac27c9-bd34-4e7c-bf16-b22d2975e31f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogMsgReceivedToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateSIMULATIONToLogUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aaac27c9-bd34-4e7c-bf16-b22d2975e31f+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;TaskNameSospesoAppuntamento&quot;/>&lt;xsl:template name=&quot;UpdateSIMULATION-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body&quot;/>&lt;/IDRICHIESTAOLO>&lt;TASK>&lt;xsl:value-of select=&quot;$TaskNameSospesoAppuntamento&quot;/>&lt;/TASK>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE CTRL_RICHIESTE_TEMP&#xa;  SET STATO = 'DTU_SIMULATION' , LAST_UPDATE= SYSDATE&#xa;  WHERE IDRICHIESTAOLO=?  AND STATO='IN CODA' AND TASK=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TASK"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogUpdSIMULATION-input"
                    name="LogUpdSIMULATION"
                    tibex:xpdlId="d2f334a8-4377-42ef-9f68-d26b439366c8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateSIMULATIONToLogUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogUpdSIMULATIONToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;UpdateSIMULATION&quot;/>&lt;xsl:template name=&quot;LogUpdSIMULATION-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| PID: &amp;quot;, $_processContext/ProcessInstanceId, 'PVM: ', $JMSReceiveMessage/Body)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('UPDATE IDRICHIESTAOLO ', $JMSReceiveMessage/Body,  ' in SIMULATION_DTU - Numero di Update = ', xsd:string($UpdateSIMULATION/noOfUpdates))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperSoapEnvelope-input"
                    name="MapperSoapEnvelope"
                    outputVariable="MapperSoapEnvelope"
                    tibex:xpdlId="9f1863bd-ffab-4501-bd48-0243b43db6d1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogUpdSIMULATIONToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperSoapEnvelopeToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.xmlsoap.org/soap/envelope/&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; version=&quot;2.0&quot;>&lt;xsl:import-schema namespace=&quot;http://www.tim.com/NOW/xsd/Richiesta_Notifica_NOW_DTU/&quot; schema-location=&quot;../../../tim.now.integration_library/Schemas/DTU/Tracciati_Richiesta_Notifica_NOW_DTU.xsd&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;INTERNAL&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;CodiceEsito&quot;/>&lt;xsl:param name=&quot;CausaleEsito&quot;/>&lt;xsl:template name=&quot;MapperSoapEnvelope-input&quot; match=&quot;/&quot;>&lt;tns:Envelope>&lt;xsl:variable name=&quot;TRANSACTION_ID&quot; select=&quot;concat($INTERNAL,&amp;quot;_&amp;quot;,$_processContext/ProcessInstanceId,format-dateTime(current-dateTime(), &amp;quot;[Y0001][M01][D01][H01][m01][s01]&amp;quot;))&quot;/>&lt;tns:Header>&lt;h:Header>&lt;h:sourceSystem>&lt;xsl:value-of select=&quot;&amp;quot;DTU&amp;quot;&quot;/>&lt;/h:sourceSystem>&lt;h:transactionID>&lt;xsl:value-of select=&quot;$TRANSACTION_ID&quot;/>&lt;/h:transactionID>&lt;/h:Header>&lt;/tns:Header>&lt;tns:Body>&lt;ns:EVENTO_NOTIFICA>&lt;ns:TESTATA>&lt;ns:ID_RICHIESTA>&lt;xsl:value-of select=&quot;$JMSReceiveMessage/Body&quot;/>&lt;/ns:ID_RICHIESTA>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$TRANSACTION_ID&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TIPOLOGIA_NOTIFICA>&lt;xsl:value-of select=&quot;&amp;quot;NI_CONFIGURAZIONE_LOGICA&amp;quot;&quot;/>&lt;/ns:TIPOLOGIA_NOTIFICA>&lt;ns:DATA_INVIO_NOTIFICA_NOW>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:DATA_INVIO_NOTIFICA_NOW>&lt;ns:CODICE_ORDINE_OLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ns:CODICE_ORDINE_OLO>&lt;ns:CODICE_OLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ns:CODICE_OLO>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;ns:CODICE_ESITO>&lt;xsl:value-of select=&quot;$CodiceEsito&quot;/>&lt;/ns:CODICE_ESITO>&lt;ns:CAUSALE_ESITO>&lt;xsl:value-of select=&quot;$CausaleEsito&quot;/>&lt;/ns:CAUSALE_ESITO>&lt;ns:DATA_ESITO>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/ns:DATA_ESITO>&lt;/ns:TESTATA>&lt;ns:INTERMEDIA>&lt;ns:CONFIGURAZIONE/>&lt;/ns:INTERMEDIA>&lt;/ns:EVENTO_NOTIFICA>&lt;/tns:Body>&lt;/tns:Envelope>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:envelope="http://schemas.xmlsoap.org/soap/envelope/"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="envelope:Envelope" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogSimulatedMessage-input"
                    name="LogSimulatedMessage"
                    tibex:xpdlId="303fc635-3136-443e-9f44-95f148313a60" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperSoapEnvelopeToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogSimulatedMessageToJMSSendMessage"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;JMSReceiveMessage&quot;/>&lt;xsl:param name=&quot;MapperSoapEnvelope&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;), &amp;quot;| PID: &amp;quot;, $_processContext/ProcessInstanceId, 'PVM: ', $JMSReceiveMessage/Body)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Corpo del messaggio simulato: &amp;#xD;&amp;#xA;&amp;quot;,tib:render-xml($MapperSoapEnvelope))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
