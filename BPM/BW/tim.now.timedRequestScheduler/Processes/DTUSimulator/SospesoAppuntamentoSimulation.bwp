                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms+1152c6db-7e94-476b-95fa-1b53e878afdc+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperSoapEnvelope&quot;/>&lt;xsl:template name=&quot;JMSSendMessage-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;Body>&lt;xsl:copy-of select=&quot;$MapperSoapEnvelope&quot;/>&lt;/Body>&lt;DynamicProperties>&lt;tns:property>&lt;tns:name>&lt;xsl:value-of select=&quot;&amp;quot;soapaction&amp;quot;&quot;/>&lt;/tns:name>&lt;tns:value>&lt;xsl:value-of select=&quot;&amp;quot;GetNotifica&amp;quot;&quot;/>&lt;/tns:value>&lt;tns:type>&lt;xsl:value-of select=&quot;&amp;quot;string&amp;quot;&quot;/>&lt;/tns:type>&lt;/tns:property>&lt;/DynamicProperties>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity activityTypeID="bw.jms.send"
                            version="6.0.0.20132205"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:envelope="http://schemas.xmlsoap.org/soap/envelope/"
