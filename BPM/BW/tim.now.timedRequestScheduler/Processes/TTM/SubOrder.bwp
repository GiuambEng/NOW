                <bpws:link name="EmptyToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToJDBCUpdate1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="JDBCUpdate1ToLogEndSubOrder" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdateToLogEndSubOrder" tibex:linkType="SUCCESS"/>
                <bpws:link name="StatoRichiestaToInAttesaAggiornamento" tibex:linkType="ERROR"/>
                <bpws:link name="DaAggiornareToInAttesaAggiornamento" tibex:linkType="ERROR"/>
