    <tibex:VariableDescriptor type="MemorySaving">
        <task name="LogStartSubOrder">
            <endingVariables>
                <variable>LogStartSubOrder-input</variable>
            </endingVariables>
        </task>
        <task name="LogEndSubOrder">
            <endingVariables>
                <variable>LogEndSubOrder-input</variable>
                <variable>Start</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="StatoASSET">
            <endingVariables>
                <variable>StatoASSET-input</variable>
            </endingVariables>
        </task>
        <task name="LogStatoRichiesta">
            <endingVariables>
                <variable>LogStatoRichiesta-input</variable>
            </endingVariables>
        </task>
        <task name="DaAggiornare">
            <endingVariables>
                <variable>DaAggiornare-input</variable>
                <variable>DaAggiornare</variable>
                <variable>StatoASSET</variable>
            </endingVariables>
        </task>
        <task name="InAttesaAggiornamento">
            <endingVariables>
                <variable>InAttesaAggiornamento-input</variable>
                <variable>InAttesaAggiornamento</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
