            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connections/JDBC/Timeout" type="xsd:int"/>
        <bpws:variable element="ns1:ActivityInput"
            name="LogStatoRichiesta-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:jdbcUpdateActivityInput"
            name="DaAggiornare-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcUpdateActivityOutput"
            name="DaAggiornare" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:jdbcUpdateActivityInput"
            name="InAttesaAggiornamento-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcUpdateActivityOutput"
            name="InAttesaAggiornamento" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns:OptionalErrorReport"
            name="_errorOptional" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:ErrorLinkHandlerFaultData"
            name="_error_StatoASSET" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:ErrorLinkHandlerFaultData"
            name="_error_DaAggiornare" sca-bpel:internal="true"/>
