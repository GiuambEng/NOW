            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogEndUpdateAsset-input"
                    name="LogEndUpdateAsset"
                    tibex:xpdlId="ebe2d5c2-d393-47e6-b03b-0e6d9a97e9e7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToLogEndUpdateAsset"/>
