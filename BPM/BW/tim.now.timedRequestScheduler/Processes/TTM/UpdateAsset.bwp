                    inputVariable="LogStartUpdateAsset-input"
                    name="LogStartUpdateAsset"
                    tibex:xpdlId="522af90d-5751-43a9-ae63-5fdb661f6a7e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
