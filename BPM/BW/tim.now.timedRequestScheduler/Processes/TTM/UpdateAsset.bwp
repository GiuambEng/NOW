    <tibex:VariableDescriptor type="MemorySaving">
        <task name="Timer">
            <endingVariables>
                <variable>Timer</variable>
            </endingVariables>
        </task>
        <task name="LogStartUpdateAsset">
            <endingVariables>
                <variable>LogStartUpdateAsset-input</variable>
            </endingVariables>
        </task>
        <task name="LogEndUpdateAsset">
            <endingVariables>
                <variable>LogEndUpdateAsset-input</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="ALLINEAMENTO_ASSET">
            <endingVariables>
                <variable>ALLINEAMENTO_ASSET-input</variable>
            </endingVariables>
        </task>
        <task name="LogALLINEAMENTO_ASSET">
            <endingVariables>
                <variable>LogALLINEAMENTO_ASSET-input</variable>
            </endingVariables>
        </task>
        <task name="While">
            <endingVariables>
                <variable>ALLINEAMENTO_ASSET</variable>
                <variable>index</variable>
            </endingVariables>
        </task>
        <task name="SubAsset">
            <endingVariables>
                <variable>SubAsset-input</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
            </endingVariables>
        </task>
        <task name="JDBCUpdate">
            <endingVariables>
                <variable>JDBCUpdate-input</variable>
                <variable>JDBCUpdate</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:complexType block="extension restriction"
