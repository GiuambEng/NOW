    <tibex:VariableDescriptor type="MemorySaving">
        <task name="Timer">
            <endingVariables>
                <variable>Timer</variable>
            </endingVariables>
        </task>
        <task name="LogStartControlloOrdine">
            <endingVariables>
                <variable>LogStartControlloOrdine-input</variable>
            </endingVariables>
        </task>
        <task name="LogEndControlloOrdine">
            <endingVariables>
                <variable>LogEndControlloOrdine-input</variable>
            </endingVariables>
        </task>
        <task name="ALLINEAMENTO_ASSET">
            <endingVariables>
                <variable>ALLINEAMENTO_ASSET-input</variable>
            </endingVariables>
        </task>
        <task name="LogALLINEAMENTO_ASSET">
            <endingVariables>
                <variable>LogALLINEAMENTO_ASSET-input</variable>
            </endingVariables>
        </task>
        <task name="JDBCUpdate">
            <endingVariables>
                <variable>JDBCUpdate-input</variable>
                <variable>JDBCUpdate</variable>
            </endingVariables>
        </task>
        <task name="While">
            <endingVariables>
                <variable>ALLINEAMENTO_ASSET</variable>
                <variable>index</variable>
            </endingVariables>
        </task>
        <task name="SubOrder">
            <endingVariables>
                <variable>SubOrder-input</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
