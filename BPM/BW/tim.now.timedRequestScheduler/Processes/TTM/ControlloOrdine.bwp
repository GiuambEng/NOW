                                    sqlStatement="SELECT ID_RICH_ALLIN,ID_ESEC_PROCSO_NO_FILE,&#xd;&#xa; ID_ASSET&#xd;&#xa;FROM ALLINEAMENTO_ASSET_DA_TTM&#xd;&#xa;WHERE STATO_AGG_ASSET='IN ATTESA AGGIORNAMENTO'" xsi:type="jdbcPalette:JDBCQueryActivity">
