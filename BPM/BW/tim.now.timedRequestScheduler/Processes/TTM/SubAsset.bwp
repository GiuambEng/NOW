            <bpws:invoke inputVariable="SharedNowToRac-input"
                name="SharedNowToRac" operation="InvokeRac"
                outputVariable="SharedNowToRac"
                partnerLink="SharedNowToRac"
                portType="ns14:SharedNowToRacPortType" tibex:xpdlId="50da919d-8d99-43b5-89f2-41ced289fd0c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" xmlns:tns1="http://www.tibco.com/SharedNowToRac/" xmlns:tns2="http://www.tim.com/NOW/xsd/NowToRacService" version="2.0"&gt;&lt;xsl:param name="FindAsset"/&gt;&lt;xsl:param name="STAG_ALL_TTMTONOW"/&gt;&lt;xsl:template name="SharedNowToRac-input" match="/"&gt;&lt;tns1:InvokeRacRequest&gt;&lt;parameters&gt;&lt;tns2:NowToRacRequest&gt;&lt;tns2:NOWRequest&gt;&lt;tns2:NUMERO_LINEA&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/IDRisorsa"/&gt;&lt;/tns2:NUMERO_LINEA&gt;&lt;tns2:SERVIZIO&gt;&lt;xsl:value-of select="'FWA'"/&gt;&lt;/tns2:SERVIZIO&gt;&lt;tns2:SIGLA_OLO&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLOAGCOM"/&gt;&lt;/tns2:SIGLA_OLO&gt;&lt;tns2:DATA_ESPLETAMENTO&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/tns2:DATA_ESPLETAMENTO&gt;&lt;xsl:if test="$STAG_ALL_TTMTONOW/Record[1]/MSISDN"&gt;&lt;tns2:MSISDN&gt;&lt;xsl:value-of select="$STAG_ALL_TTMTONOW/Record[1]/MSISDN"/&gt;&lt;/tns2:MSISDN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$STAG_ALL_TTMTONOW/Record[1]/IMSI"&gt;&lt;tns2:IMSI&gt;&lt;xsl:value-of select="$STAG_ALL_TTMTONOW/Record[1]/IMSI"/&gt;&lt;/tns2:IMSI&gt;&lt;/xsl:if&gt;&lt;tns2:LAVORAZIONE&gt;&lt;xsl:value-of select="'VARIAZIONE'"/&gt;&lt;/tns2:LAVORAZIONE&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/lastUpdate"&gt;&lt;tns2:DATA_ESPLETAMENTOFWA&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/lastUpdate"/&gt;&lt;/tns2:DATA_ESPLETAMENTOFWA&gt;&lt;/xsl:if&gt;&lt;/tns2:NOWRequest&gt;&lt;tns2:IdRichiestaOLO&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/IDRichiestaOLO"/&gt;&lt;/tns2:IdRichiestaOLO&gt;&lt;/tns2:NowToRacRequest&gt;&lt;/parameters&gt;&lt;/tns1:InvokeRacRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:tns1=&quot;http://www.tibco.com/SharedNowToRac/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindAsset.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;STAG_ALL_TTMTONOW&quot;/>&#xa;    &lt;xsl:template name=&quot;SharedNowToRac-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NowToRacRequest>&#xa;            &lt;tns2:NOWRequest>&#xa;                &lt;tns2:NUMERO_LINEA>&#xa;                    &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/IDRisorsa&quot;/>&#xa;                &lt;/tns2:NUMERO_LINEA>&#xa;                &lt;tns2:SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;'FWA'&quot;/>&#xa;                &lt;/tns2:SERVIZIO>&#xa;                &lt;tns2:SIGLA_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns2:SIGLA_OLO>&#xa;                &lt;tns2:DATA_ESPLETAMENTO>&#xa;                    &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                &lt;/tns2:DATA_ESPLETAMENTO>&#xa;                &lt;xsl:if test=&quot;$STAG_ALL_TTMTONOW/Record[1]/MSISDN&quot;>&#xa;                    &lt;tns2:MSISDN>&#xa;                        &lt;xsl:value-of select=&quot;$STAG_ALL_TTMTONOW/Record[1]/MSISDN&quot;/>&#xa;                    &lt;/tns2:MSISDN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$STAG_ALL_TTMTONOW/Record[1]/IMSI&quot;>&#xa;                    &lt;tns2:IMSI>&#xa;                        &lt;xsl:value-of select=&quot;$STAG_ALL_TTMTONOW/Record[1]/IMSI&quot;/>&#xa;                    &lt;/tns2:IMSI>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:LAVORAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;'VARIAZIONE'&quot;/>&#xa;                &lt;/tns2:LAVORAZIONE>&#xa;                &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/lastUpdate&quot;>&#xa;                    &lt;tns2:DATA_ESPLETAMENTOFWA>&#xa;                        &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/lastUpdate&quot;/>&#xa;                    &lt;/tns2:DATA_ESPLETAMENTOFWA>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:NOWRequest>&#xa;            &lt;tns2:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/IDRichiestaOLO&quot;/>&#xa;            &lt;/tns2:IdRichiestaOLO>&#xa;        &lt;/tns2:NowToRacRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AGGIORNAMENTOOKToSharedNowToRac"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="SharedNowToRacToLogEndtSubAsset"/>
                </bpws:sources>
            </bpws:invoke>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
