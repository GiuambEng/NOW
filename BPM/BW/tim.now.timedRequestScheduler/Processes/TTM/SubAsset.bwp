                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b828b34a-397d-4b2e-b8d0-0c487994db77+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlloOrdine/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Variable&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName,$FaultDetails/ProcessStack,$FaultDetails/StackTrace,$FaultDetails/Msg,$FaultDetails/MsgCode,$FaultDetails/FullClass)&quot;/>&lt;/DESCR_ERRORE>&lt;STATO_AGG_ASSET>&lt;xsl:value-of select=&quot;'AGGIORNAMENTO KO'&quot;/>&lt;/STATO_AGG_ASSET>&lt;NUMERO_RETRY>&lt;xsl:value-of select=&quot;$Start/tns1:NUM_RETRY+1&quot;/>&lt;/NUMERO_RETRY>&lt;ID_RICH_ALLIN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ID_RICH_ALLIN)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ID_RICH_ALLIN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_ALLIN>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$Variable&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
