Asset.part1/tns:Find[1]/tns:Asset/DES&quot;/>&#xa;                        &lt;/DES>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/ORA_DES&quot;>&#xa;                            &lt;ORA_DES>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/ORA_DES&quot;/>&#xa;                            &lt;/ORA_DES>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipologiaAccesso>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/tipologiaAccesso&quot;/>&#xa;                        &lt;/tipologiaAccesso>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/RO&quot;>&#xa;                            &lt;RO>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/RO&quot;/>&#xa;                            &lt;/RO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;offerta>&#xa;                            &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/offerta&quot;/>&#xa;                        &lt;/offerta>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/lineaRiferimento&quot;>&#xa;                            &lt;lineaRiferimento>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/lineaRiferimento&quot;/>&#xa;                            &lt;/lineaRiferimento>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/complesso&quot;>&#xa;                            &lt;complesso>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/complesso&quot;/>&#xa;                            &lt;/complesso>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/interno&quot;>&#xa;                            &lt;interno>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/interno&quot;/>&#xa;                            &lt;/interno>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/piano&quot;>&#xa;                            &lt;piano>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/piano&quot;/>&#xa;                            &lt;/piano>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/scala&quot;>&#xa;                            &lt;scala>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/scala&quot;/>&#xa;                            &lt;/scala>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:for-each select=&quot;$FindAsset.part1/tns:Find/tns:Asset/dettaglioasset&quot;>&#xa;                            &lt;dettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                                    &lt;IDDettaglioAssetParent>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                                    &lt;/IDDettaglioAssetParent>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                                    &lt;IDDettaglioAssetRoot>&#xa;                                        &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                                    &lt;/IDDettaglioAssetRoot>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;integrationID>&#xa;                                    &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                                &lt;/integrationID>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                                &lt;nomeComponente>&#xa;                                    &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                                &lt;/nomeComponente>&#xa;                                &lt;xsl:for-each select=&quot;attributidettaglioasset[nomeAttributo!='IMEI' and nomeAttributo!='IMSI' and nomeAttributo!='MSISDN' ]&quot;>&#xa;                                    &lt;attributidettaglioasset>&#xa;                                        &lt;IDAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                        &lt;/IDAsset>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;nomeAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                        &lt;/nomeAttributo>&#xa;                                        &lt;valoreAttributo>&#xa;                                            &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                        &lt;/valoreAttributo>&#xa;                                        &lt;tipologiaDato>&#xa;                                            &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                        &lt;/tipologiaDato>&#xa;                                        &lt;IDDettaglioAsset>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                        &lt;/IDDettaglioAsset>&#xa;                                    &lt;/attributidettaglioasset>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'IMEI'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$STAG_ALL_TTMTONOW/Record[1]/IMEI&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/tipologiaDato&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'IMSI'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$STAG_ALL_TTMTONOW/Record[1]/IMSI&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/tipologiaDato&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                                &lt;attributidettaglioasset>&#xa;                                    &lt;IDAsset>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/IDAsset&quot;/>&#xa;                                    &lt;/IDAsset>&#xa;                                    &lt;created>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/created&quot;/>&#xa;                                    &lt;/created>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                    &lt;operatore>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/operatore&quot;/>&#xa;                                    &lt;/operatore>&#xa;                                    &lt;nomeAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;'MSISDN'&quot;/>&#xa;                                    &lt;/nomeAttributo>&#xa;                                    &lt;valoreAttributo>&#xa;                                        &lt;xsl:value-of select=&quot;$STAG_ALL_TTMTONOW/Record[1]/MSISDN&quot;/>&#xa;                                    &lt;/valoreAttributo>&#xa;                                    &lt;tipologiaDato>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/tipologiaDato&quot;/>&#xa;                                    &lt;/tipologiaDato>&#xa;                                    &lt;IDDettaglioAsset>&#xa;                                        &lt;xsl:value-of select=&quot;attributidettaglioasset[1]/IDDettaglioAsset&quot;/>&#xa;                                    &lt;/IDDettaglioAsset>&#xa;                                &lt;/attributidettaglioasset>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                                &lt;statoDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                                &lt;/statoDettaglioAsset>&#xa;                                &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/DESPrimoOrdine&quot;>&#xa;                            &lt;DESPrimoOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/DESPrimoOrdine&quot;/>&#xa;                            &lt;/DESPrimoOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/CAP&quot;>&#xa;                            &lt;CAP>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/CAP&quot;/>&#xa;                            &lt;/CAP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/codiceISTATComune&quot;>&#xa;                            &lt;codiceISTATComune>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/codiceISTATComune&quot;/>&#xa;                            &lt;/codiceISTATComune>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/codiceISTATProvincia&quot;>&#xa;                            &lt;codiceISTATProvincia>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns:Find[1]/tns:Asset/codiceISTATProvincia&quot;/>&#xa;                 