            <bpws:invoke inputVariable="UpdateAsset-input"
                name="UpdateAsset" operation="Invoke"
                outputVariable="UpdateAsset"
                partnerLink="FindUpdateCase"
                portType="ns9:FindUpdateCase" tibex:xpdlId="d62a5851-4b7d-4340-88da-b79a6f04818e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/FindUpdateResource/" xmlns:tns="http://www.tim.com/NOW/xsd/FindUpdateCase/" version="2.0"&gt;&lt;xsl:param name="FindAsset"/&gt;&lt;xsl:param name="STAG_ALL_TTMTONOW"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;ns:Request&gt;&lt;part1&gt;&lt;tns:Input&gt;&lt;tns:Update&gt;&lt;tns:Input&gt;&lt;tns:CaseReference&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:CaseReference"/&gt;&lt;/tns:CaseReference&gt;&lt;tns:Asset&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/IDAsset"&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/IDAsset"/&gt;&lt;/IDAsset&gt;&lt;/xsl:if&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/codiceOrdineOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/codiceOrdineTI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/codiceOrdineTI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/codificaOLOAGCOM"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/invariante"&gt;&lt;invariante&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/invariante"/&gt;&lt;/invariante&gt;&lt;/xsl:if&gt;&lt;created&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/created"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/operatore"/&gt;&lt;/operatore&gt;&lt;xsl:if test="$FindAsset/part1/tns:Output/tns:Find[1]/tns:Asset/IDRichiestaOLO"&gt;&lt;IDRichiestaOLO&gt;&lt;xsl:value-of se