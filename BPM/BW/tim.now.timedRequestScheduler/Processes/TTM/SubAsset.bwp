                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a7e7df00-7c3c-4803-be01-5b9a23e2c402+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FindUpdateCase/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlloOrdine/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FindAsset.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;StoricoAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find[1]/tns1:Asset/codificaOLOAGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FindAsset.part1/tns1:Find[1]/tns1:Asset/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;CONTENUTO_XML>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FindAsset.part1/tns1:Find[1]/tns1:Asset, true(),true())&quot;/>&#xa;            &lt;/CONTENUTO_XML>&#xa;            &lt;DES>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find[1]/tns1:Asset/DES)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FindAsset.part1/tns1:Find[1]/tns1:Asset/DES&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DES>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($FindAsset.part1/tns1:Find[1]/tns1:Asset/distretto)>0&quot;>&#xa;                    &lt;DISTR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find[1]/tns1:Asset/distretto)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns1:Find[1]/tns1:Asset/distretto&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DISTR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DISTR xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($FindAsset.part1/tns1:Find[1]/tns1:Asset/IDRisorsa)>0&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find[1]/tns1:Asset/IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns1:Find[1]/tns1:Asset/IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_RISORSA_NOW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find[1]/tns1:Asset/IDRisorsa)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FindAsset.part1/tns1:Find[1]/tns1:Asset/IDRisorsa&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RISORSA_NOW>&#xa;            &lt;ID_ASSET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns2:IDASSET)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:IDASSET&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ASSET>&#xa;            &lt;ID_STATO_ASSET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find[1]/tns1:Asset/statoAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FindAsset.part1/tns1:Find[1]/tns1:Asset/statoAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_STATO_ASSET>&#xa;            &lt;ID_STORICO_ASSET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCQuery/Record[1]/NEXTVAL)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/NEXTVAL&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_STORICO_ASSET>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($FindAsset.part1/tns1:Find[1]/tns1:Asset/numeroTelefonico)>0&quot;>&#xa;                    &lt;NUMERO_TELEFONICO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find[1]/tns1:Asset/numeroTelefonico)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$FindAsset.part1/tns1:Find[1]/tns1:Asset/numeroTelefonico&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMERO_TELEFONICO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMERO_TELEFONICO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($FindAsset.part1/tns1:Find/tns1:Asset/ORA_DES)&quot;>&#xa;                    &lt;ORA_DES>&#xa;                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($FindAsset.part1/tns1:Find[1]/tns1:Asset/DES), month-from-date($FindAsset.part1/tns1:Find[1]/tns1:Asset/DES), day-from-date($FindAsset.part1/tns1:Find[1]/tns1:Asset/DES), hours-from-time($FindAsset.part1/tns1:Find[1]/tns1:Asset/ORA_DES), minutes-from-time($FindAsset.part1/tns1:Find[1]/tns1:Asset/ORA_DES), xsd:int(seconds-from-time($FindAsset.part1/tns1:Find[1]/tns1:Asset/ORA_DES)))&quot;/>&#xa;                    &lt;/ORA_DES>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ORA_DES>&#xa;                        &lt;xsl:value-of select=&quot;tib:create-dateTime(year-from-date($FindAsset.part1/tns1:Find[1]/tns1:Asset/DES), month-from-date($FindAsset.part1/tns1:Find[1]/tns1:Asset/DES), day-from-date($FindAsset.part1/tns1:Find[1]/tns1:Asset/DES),00,00,00)&quot;/>&#xa;                    &lt;/ORA_DES>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_INSMTO_STORICO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO_STORICO>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT&#xa;INTO STORICO_ASSET&#xa;  (CODFC_OLO_AGCOM,CONTENUTO_XML,DES,DISTR,ID_RISORSA,ID_RISORSA_NOW,ID_ASSET,&#xa;  ID_STATO_ASSET,ID_STORICO_ASSET,NUMERO_TELEFONICO,ORA_DES,TIMSTP_INSMTO_STORICO)&#xa;  VALUES&#xa;  (?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="CONTENUTO_XML"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DES"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DISTR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA_NOW"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ASSET"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_STATO_ASSET"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STORICO_ASSET"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_TELEFONICO"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="ORA_DES"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO_STORICO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBCQuery-input"
                    name="JDBCQuery" outputVariable="JDBCQuery"
                    tibex:xpdlId="cd40b3c1-06a2-4ed5-a18a-cef4a05d54e2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
