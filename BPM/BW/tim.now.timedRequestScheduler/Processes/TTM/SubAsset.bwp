                                    sqlStatement="UPDATE ALLINEAMENTO_ASSET_DA_TTM&#xa;SET STATO_AGG_ASSET='AGGIORNAMENTO OK',TIMESTAMP_AGG=SYSDATE,ESITO_AGG='OK',NUMERO_RETRY=?&#xa;WHERE &#xa;ID_RICH_ALLIN =? AND ID_ESEC_PROCSO_NO_FILE =?&#xa;" xsi:type="jdbcPalette:JDBCUpdateActivity">
