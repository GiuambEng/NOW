                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT IDRICHIESTAOLO,TASK,SCADENZA,STATO,QUEUE_NAME,CREATED,LAST_UPDATE &#xd;&#xa;FROM CTRL_RICHIESTE_TEMP&#xd;&#xa;WHERE &#xd;&#xa;STATO IN ('ELABORATO','ANNULLATO','KO','BONIFICATO') &#xd;&#xa;AND&#xd;&#xa;trunc(LAST_UPDATE) &lt;= trunc(SYSDATE - ?) &#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
