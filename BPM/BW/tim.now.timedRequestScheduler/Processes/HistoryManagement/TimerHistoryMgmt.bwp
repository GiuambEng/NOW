                        outputVariable="Ins-STORRICHIESTETEMP"
                        tibex:xpdlId="bda514e8-1696-4b56-af77-e75e0710f7b3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                        <bpws:targets>
