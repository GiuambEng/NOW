            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="ec9d404e-824c-4e1b-b2e2-494877a8bb2f">
                <bpws:targets>
                    <bpws:target linkName="JDBCUpdateToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLogEndSendEvent"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($SelectEstrazioneStag/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($SelectEstrazioneStag/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToCheckState" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CheckStateToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CheckStateToLog" tibex:linkType="ERROR"/>
                                <bpws:link name="LogToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="2223b5a4-7695-4e53-a22a-bd79b2aaa02b">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCheckState"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="873bbe85-82c1-48ad-b772-5fd12e70694f">
                                <bpws:targets>
                                    <bpws:target linkName="CheckStateToGroupEnd"/>
                                    <bpws:target linkName="LogToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CheckState-input"
                                    name="CheckState"
                                    tibex:xpdlId="1588134f-d057-404c-a3a1-0bf09df6bfd2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCheckState"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckStateToGroupEnd"/>
                                    <bpws:source
                                    linkName="CheckStateToLog"
                                    tibex:faultDetailsVar="CheckState" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/NOW/CheckStateFastData/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelectEstrazioneStag&quot;/>&lt;xsl:template name=&quot;CheckState-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:ContenutoRequest>&lt;xsl:value-of select=&quot;$SelectEstrazioneStag/Record[$index]/CONT_REQUEST&quot;/>&lt;/tns:ContenutoRequest>&lt;tns:IDEsec>&lt;xsl:value-of select=&quot;xsd:integer($SelectEstrazioneStag/Record[$index]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&lt;/tns:IDEsec>&lt;tns:TransactionID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:TransactionID>&lt;xsl:if test=&quot;$SelectEstrazioneStag/Record[$index]/CODFC_OLO_AGCOM&quot;>&lt;tns:CodOloAgicom>&lt;xsl:value-of select=&quot;$SelectEstrazioneStag/Record[$index]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:CodOloAgicom>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectEstrazioneStag/Record[$index]/COD_ORD_OLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$SelectEstrazioneStag/Record[$index]/COD_ORD_OLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;tns:TipoNotifica>&lt;xsl:value-of select=&quot;xsd:integer($SelectEstrazioneStag/Record[$index]/ID_TPLG_EVNT_FASTDATA)&quot;/>&lt;/tns:TipoNotifica>&lt;xsl:if test=&quot;exists($SelectEstrazioneStag/Record/NUMERO_RETRY)&quot;>&lt;tns:NumeroRetry>&lt;xsl:value-of select=&quot;xsd:integer($SelectEstrazioneStag/Record[$index]/NUMERO_RETRY)&quot;/>&lt;/tns:NumeroRetry>&lt;/xsl:if>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="FastData.CheckState" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log-input" name="Log"
                                    tibex:xpdlId="068a568c-40f4-4790-bf01-4a5dc2ede021" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckStateToLog"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;),  &amp;quot;PID: &amp;quot;, $_processContext/ProcessInstanceId )&quot;/>&lt;/msgCode>&lt;loggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/loggerName>&lt;message>&lt;xsl:value-of select=&quot;concat($_error/StackTrace, $_error/ProcessStack,$_error/Class,$_error/FullClass,$_error/Msg,$_error/MsgCode)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCUpdate-input" name="JDBCUpdate"
                    outputVariable="JDBCUpdate"
                    tibex:xpdlId="15e09e28-dac0-4e8c-8fc5-093d73a6c215" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogSelectEstrazioneStagToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+15e09e28-dac0-4e8c-8fc5-093d73a6c215+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectEstrazioneStag&quot;/>&lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:for-each select=&quot;$SelectEstrazioneStag/Record&quot;>&lt;Record>&lt;ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;11&quot;/>&lt;/ID_STATO_ELAB_STAG>&lt;ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;ID_ESEC_PROCSO_NO_FILE&quot;/>&lt;/ID_ESEC_PROCSO_NO_FILE>&lt;/Record>&lt;/xsl:for-each>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE STAG_FASTDATA_INPUT_NO_FILE&#xa;SET TIMESTAMP_RISP=SYSDATE,ID_STATO_ELAB_STAG=?&#xa;WHERE &#xa;ID_ESEC_PROCSO_NO_FILE = ?  "
                                    timeout="10" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_STATO_ELAB_STAG"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_NO_FILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
