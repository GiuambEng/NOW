    <tibex:VariableDescriptor type="MemorySaving">
        <task name="Timer">
            <endingVariables>
                <variable>Timer</variable>
            </endingVariables>
        </task>
        <task name="LogStartSendEvent">
            <endingVariables>
                <variable>LogStartSendEvent-input</variable>
            </endingVariables>
        </task>
        <task name="LogEndSendEvent">
            <endingVariables>
                <variable>LogEndSendEvent-input</variable>
                <variable>LoggerName</variable>
            </endingVariables>
        </task>
        <task name="SelectEstrazioneStag">
            <endingVariables>
                <variable>SelectEstrazioneStag-input</variable>
            </endingVariables>
        </task>
        <task name="LogSelectEstrazioneStag">
            <endingVariables>
                <variable>LogSelectEstrazioneStag-input</variable>
            </endingVariables>
        </task>
        <task name="While">
            <endingVariables>
                <variable>SelectEstrazioneStag</variable>
                <variable>index</variable>
            </endingVariables>
        </task>
        <task name="CheckState">
            <endingVariables>
                <variable>CheckState-input</variable>
            </endingVariables>
        </task>
        <task name="Log">
            <endingVariables>
                <variable>Log-input</variable>
            </endingVariables>
        </task>
        <task name="JDBCUpdate">
            <endingVariables>
                <variable>JDBCUpdate-input</variable>
                <variable>JDBCUpdate</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:complexType block="extension restriction"
