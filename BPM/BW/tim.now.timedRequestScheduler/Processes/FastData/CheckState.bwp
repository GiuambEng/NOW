                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://olo2olo.npfibra.it/migrazione/&quot; xmlns:tns1=&quot;http://telecomitalia.it/NOW/CheckStateFastData/&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Request&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:param name=&quot;Asset2&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/Record[STATORICHIESTANOW='ACQUISITOB2B'])&quot;>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'ANNULLATOB2B'&quot;/>&lt;/statoRichiestaNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Request/Record[STATORICHIESTANOW='ACQUISITOB2B'])&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTOB2B'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'ANNULLATOB2B'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;INVIATOADELIVERY&amp;quot;&quot;/>&lt;/statoRichiestaOLO>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;B2B&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:tipoNotifica='03'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESECUZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:CodOloAgicom&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$JDBCQuery1/Record[1]/COD_OLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$JDBCQuery1/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:CodiceOrdineOLO&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOrdineOLO&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date('yyyy-MM-dd',format-date(xsd:date($ParseXml/tns3:OLO_NPRequest/tns3:dataNotifica), '[Y0001]-[M01]-[D01]'))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;string-length($ParseXml/tns3:OLO_NPRequest/tns3:note)>0&quot;>&lt;xsl:if test=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Asset2/Record)>0 and exists($Asset2/Record[1]/IDCONTRATTO)&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;xsd:int($Asset2/Record[1]/IDCONTRATTO)&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;IDOfferta>&lt;xsl:value-of select=&quot;20&quot;/>&lt;/IDOfferta>&lt;DRO>&lt;xsl:value-of select=&quot;xsd:date(substring-before(xsd:string(current-date()),'+'))&quot;/>&lt;/DRO>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_OLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$ParseXml/tns3:OLO_NPRequest/tns3:numerazioni/tns3:dn[1]&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;tipologiaScenario>&lt;xsl:value-of select=&quot;'NPSUNPDEL82'&quot;/>&lt;/tipologiaScenario>&lt;xsl:if test=&quot;$Start/tns1:CodOloAgicom&quot;>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/tns1:CodOloAgicom&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:if>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;'PORTABILITASUCCESSIVADEL82'&quot;/>&lt;/tipologiaSottolav>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="casedata:RichiestaElement" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogCreateRequest-input"
                    name="LogCreateRequest"
                    tibex:xpdlId="6bd10f6b-d00f-4743-a4c8-c3c3690568ab" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
