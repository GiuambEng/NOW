            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="TIPO_SRVZ" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="CONTENUTO_REQUEST" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="ID_ESEC_PROCSO_NO_FILE" type="decimal"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
