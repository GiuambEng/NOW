                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/SharedNowToRac/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RAC/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NowToRacServiceFWA/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXml1&quot;/>&#xa;    &lt;xsl:template name=&quot;SharedNowToRac-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NowToRacRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns2:TIPO_SERVIZIO='WILL-FWA'&quot;>&#xa;                    &lt;tns1:TransactionInfo>&#xa;                        &lt;tns1:Transaction_id>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml1/tns3:TransactionInfo/tns3:Transaction_id&quot;/>&#xa;                        &lt;/tns1:Transaction_id>&#xa;                        &lt;tns1:Transaction_date>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml1/tns3:TransactionInfo/tns3:Transaction_date&quot;/>&#xa;                        &lt;/tns1:Transaction_date>&#xa;                    &lt;/tns1:TransactionInfo>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:copy-of select=&quot;$ParseXml/tns1:TransactionInfo&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:NOWRequest>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml1)&quot;>&#xa;                        &lt;tns1:NUMERO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml1/tns3:NOWRequest/tns3:ID_RISORSA&quot;/>&#xa;                        &lt;/tns1:NUMERO_LINEA>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:NUMERO_LINEA>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/tns1:NOWRequest/tns1:NUMERO_LINEA&quot;/>&#xa;                        &lt;/tns1:NUMERO_LINEA>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;'FWA'&quot;/>&#xa;                &lt;/tns1:SERVIZIO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml1)&quot;>&#xa;                        &lt;tns1:SIGLA_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml1/tns3:NOWRequest/tns3:SIGLA_OAO&quot;/>&#xa;                        &lt;/tns1:SIGLA_OLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:SIGLA_OLO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/tns1:NOWRequest/tns1:SIGLA_OLO&quot;/>&#xa;                        &lt;/tns1:SIGLA_OLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml/tns1:NOWRequest/tns1:DATA_ESPLETAMENTO)&quot;>&#xa;                        &lt;tns1:DATA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;$ParseXml/tns1:NOWRequest/tns1:DATA_ESPLETAMENTO&quot;/>&#xa;                        &lt;/tns1:DATA_ESPLETAMENTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:DATA_ESPLETAMENTO>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns1:DATA_ESPLETAMENTO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml1)&quot;>&#xa;                        &lt;xsl:if test=&quot;$ParseXml1/tns3:NOWRequest/tns3:MSISDN&quot;>&#xa;                            &lt;tns1:MSISDN>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml1/tns3:NOWRequest/tns3:MSISDN&quot;/>&#xa;                            &lt;/tns1:MSISDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/tns1:NOWRequest/tns1:MSISDN&quot;>&#xa;                            &lt;tns1:MSISDN>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/tns1:NOWRequest/tns1:MSISDN&quot;/>&#xa;                            &lt;/tns1:MSISDN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml1)&quot;>&#xa;                        &lt;xsl:if test=&quot;$ParseXml1/tns3:NOWRequest/tns3:IMSI&quot;>&#xa;                            &lt;tns1:IMSI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml1/tns3:NOWRequest/tns3:IMSI&quot;/>&#xa;                            &lt;/tns1:IMSI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/tns1:NOWRequest/tns1:IMSI&quot;>&#xa;                            &lt;tns1:IMSI>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/tns1:NOWRequest/tns1:IMSI&quot;/>&#xa;                            &lt;/tns1:IMSI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml1)&quot;