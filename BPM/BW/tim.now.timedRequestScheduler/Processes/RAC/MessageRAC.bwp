           &lt;tns1:FlagScheduler>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns1:FlagScheduler>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:IDESEC&quot;>&#xa;                &lt;tns1:IDEsecProcsoNoFile>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:IDESEC&quot;/>&#xa;                &lt;/tns1:IDEsecProcsoNoFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:NowToRacRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
