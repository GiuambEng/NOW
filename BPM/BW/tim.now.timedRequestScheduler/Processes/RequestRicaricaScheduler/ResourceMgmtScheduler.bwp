                                    sqlStatement="UPDATE STAG_ESB_OUT_NO_FILE SET ID_STATO_ELAB_STAG=11,NUMERO_RETRY=?,DESCR_ERRORE=?,TIMESTAMP_AGG=SYSDATE&#xa;WHERE ID_STATO_ELAB_STAG=46 AND ID_ESEC_PROCSO_NO_FILE=? AND BUSINESS_ID=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

