                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c0afe560-d8e7-4e2a-be92-cfcac071b350+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:sm=&quot;http://telecomitalia.it/SOA/B2BDynamicResourceMgmtResponse/2019-06-17&quot; xmlns:tns1=&quot;http://schemas.tibco.com/bw/plugins/xml/5.0/xmlExceptions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ACK&quot;/>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;_error_ParseXml1&quot;/>&lt;xsl:param name=&quot;_error_ParseXml&quot;/>&lt;xsl:template name=&quot;JDBCUpdate1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;NUMERO_RETRY>&lt;xsl:value-of select=&quot;xsd:int($ACK/Record[$index]/NUMERO_RETRY)+1&quot;/>&lt;/NUMERO_RETRY>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/sm:resultOfRequirement)&quot;>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat($_error_ParseXml1/tns1:XMLParseException/msg, $_error_ParseXml1/tns1:XMLParseException/msgCode,$_error_ParseXml1/tns1:UnsupportedEncodingException/msg,$_error_ParseXml1/tns1:UnsupportedEncodingException/msgCode,$_error_ParseXml1/tns1:MissingByteCountException/msg,$_error_ParseXml1/tns1:MissingByteCountException/msgCode,$_error_ParseXml1/tns1:ValidationException/msg,$_error_ParseXml1/tns1:ValidationException/msgCode)&quot;/>&lt;/DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_ERRORE>&lt;xsl:value-of select=&quot;concat($_error_ParseXml/tns1:XMLParseException/msg, $_error_ParseXml/tns1:XMLParseException/msgCode,$_error_ParseXml/tns1:UnsupportedEncodingException/msg,$_error_ParseXml/tns1:UnsupportedEncodingException/msgCode,$_error_ParseXml/tns1:MissingByteCountException/msg,$_error_ParseXml/