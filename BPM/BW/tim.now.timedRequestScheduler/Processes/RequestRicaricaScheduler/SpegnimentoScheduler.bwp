e-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns1:ProcessID>&#xa;            &lt;tns1:FlagScheduler>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns1:FlagScheduler>&#xa;        &lt;/Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
