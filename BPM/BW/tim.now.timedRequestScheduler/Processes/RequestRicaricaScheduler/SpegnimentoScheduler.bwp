                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ServiceTimedRequest&quot; xmlns:bw=&quot;http://www.tibco.com/bw/xpath/bw-custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CreateRequestRicarica.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAssetRicarica&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCreateRequestRicarica-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(bw:getModuleProperty(&amp;quot;BW.PROCESS.NAME&amp;quot;), &amp;quot;|&amp;quot;, bw:getModuleProperty(&amp;quot;BW.APPLICATION.NAME&amp;quot;),  &amp;quot;PID: &amp;quot;, $_processContext/ProcessInstanceId,&amp;quot;IDASSETRICARICA: &amp;quot;, string($SelectAssetRicarica/Record[number($index)]/IDASSETRICARICA),&amp;quot;ID_RICH_OLO:  &amp;quot;,$CreateRequestRicarica.Output/tns1:IDRichiestaOLO)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;loggerName>&#xa;                &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;            &lt;/loggerName>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('CreateRequestRicarica',$CreateRequestRicarica.Output/tns1:Esito,$CreateRequestRicarica.Output/tns1:IDRichiestaOLO)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
