                        <bpws:target linkName="LogToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLog1_Name">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f1b3b704-e32f-44c5-9402-7ab68912cc81+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StatoAsset&quot;/>&lt;xsl:template name=&quot;SelectAssetRicarica-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;STATOASSET>&lt;xsl:value-of select=&quot;$StatoAsset&quot;/>&lt;/STATOASSET>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.IDASSETRICARICA ,A.IDASSET,A.DATAINIZIO ,A.DATAFINE ,A.TIPOLOGIARICARICA ,A.STATOASSET ,A.FAMIGLIAASSET ,&#xa;A.LASTUPDATE ,A.CREATED ,A.DATAACCENSIONE ,A.DATASPEGNIMENTO ,A.DATAANNULLAMENTO ,A.OPERATORE  &#xa;FROM BDS_1_CASEDATA_ASSETRICARICA A&#xa;  left outer JOIN PARAMETRI_CFGZ_NOW P ON P.CHIAVE = 'T_RITARDO_OFF_' || A.TIPOLOGIARICARICA&#xa;WHERE A.STATOASSET=? &#xa;AND (A.DATAFINE + numtodsinterval(NVL(VALORE_NUMERICO, 0), 'MINUTE')) &lt;=  SYSDATE" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATOASSET"/>
                                    <columnMetadata
                                    columnName="IDASSETRICARICA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DATAINIZIO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATAFINE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TIPOLOGIARICARICA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="STATOASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="FAMIGLIAASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LASTUPDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATAACCENSIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATASPEGNIMENTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="DATAANNULLAMENTO"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="OPERATORE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
