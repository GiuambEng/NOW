                                    nillable="false" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="CREATED" nillable="false" type="dateTime"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="DATAACCENSIONE"
                                    nillable="false" type="dateTime"/>
