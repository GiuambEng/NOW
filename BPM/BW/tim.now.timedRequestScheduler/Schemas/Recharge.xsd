<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://telecomitalia.it/Recharge/" elementFormDefault="qualified" targetNamespace="http://telecomitalia.it/Recharge/">
	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>

	<element name="Request">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="AssetRicarica" type="pref:AssetRicarica">
				</element>
				<element name="BusinessID" type="string"/>
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="0" name="Esito" type="string"/>
			</sequence>
		</complexType>
	</element>

	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Code" type="string"/>
				<element name="Msg" type="string"/>
			</sequence>
		</complexType>
	</element>

</schema>
