<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://telecomitalia.it/NOW/B2B_Ricarica"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://telecomitalia.it/NOW/B2B_Ricarica"
	xmlns:ns1="http://telecomitalia.it/NOW/B2BNOWRicarica" xmlns:h="http://telecomitalia.it/NOW/B2BRicarica/Header">
	<import schemaLocation="B2B_NOW_Ricarica.xsd"
		namespace="http://telecomitalia.it/NOW/B2BNOWRicarica">
	</import>
	<import schemaLocation="Header.xsd" namespace="http://telecomitalia.it/NOW/B2BRicarica/Header"></import>

	<element name="Request">
		<complexType>
			<sequence>
				<element name="RichiestaRicarica_Type">
					<complexType>
						<sequence>
							<element name="CodiceOrdineOLO"
								type="string" />
							<element name="DatiRisorsa">
								<complexType>
									<sequence>
										<element
											name="CodiceOloAgcom">
											<simpleType>
												<restriction
													base="string">
													<length value="3" />
												</restriction>
											</simpleType>
										</element>
										<element name="IdRisorsa"
											type="string" />
										<element name="Note"
											minOccurs="0">
											<simpleType>
												<restriction
													base="string">
													<maxLength
														value="255" />
												</restriction>
											</simpleType>
										</element>
									</sequence>
								</complexType>
							</element>
							<element name="TipoAzione">
								<complexType>
									<choice>
										<element name="Ricarica">
											<complexType>
												<sequence>
													<element
														name="NumeroOrdineRichiesta" type="string" minOccurs="0" />
													<element
														name="DataInizioRicarica" type="dateTime" minOccurs="0" />
													<element
														name="TaglioRicarica" type="ns1:TaglioRicaricaType" />
													<element
														name="TipologiaAccensioneRicarica"
														type="ns1:RicaricaType" />
												</sequence>
											</complexType>
										</element>
										<element name="Annullamento">
											<complexType>
												<sequence>
													<element
														name="NumeroOrdineRichiesta" type="string" />
												</sequence>
											</complexType>
										</element>
										<element
											name="ListaRicariche">
											<complexType>
												<sequence>
													<element
														name="DataInizioEstrazione" type="dateTime" minOccurs="0" />
													<element
														name="DataFineEstrazione" type="dateTime" minOccurs="0" />
												</sequence>
											</complexType>
										</element>
									</choice>
								</complexType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="Header" type="h:HeaderType" maxOccurs="1"
					minOccurs="0">
				</element>
				
			</sequence>
		</complexType>
	</element>

	<element name="Response">
		<complexType>
			<sequence>
				<element name="ACK" type="ns1:Ack_Type">
				</element>
				<element name="Header" type="h:HeaderType" maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
</schema>