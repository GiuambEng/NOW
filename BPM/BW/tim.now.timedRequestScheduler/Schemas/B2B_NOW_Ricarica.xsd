<xs:schema xmlns:ns1="http://telecomitalia.it/NOW/B2BNOWRicarica" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://telecomitalia.it/NOW/B2BNOWRicarica" elementFormDefault="qualified" version="1.0" id="NOW_Ricarica.xsd">
	<xs:element name="RichiestaRicarica_Type">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CodiceOrdineOLO" type="xs:string"/>
				<xs:element name="DatiRisorsa">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CodiceOloAgcom">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:length value="3"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="IdRisorsa" type="xs:string"/>
							<xs:element name="Note" minOccurs="0">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="255"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="TipoAzione">
					<xs:complexType>
						<xs:choice>
							<xs:element name="Ricarica">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="NumeroOrdineRichiesta" type="xs:string" minOccurs="0"/>
										<xs:element name="DataInizioRicarica" type="xs:dateTime" minOccurs="0"/>
										<xs:element name="TaglioRicarica" type="ns1:TaglioRicaricaType"/>
										<xs:element name="TipologiaAccensioneRicarica" type="ns1:RicaricaType"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="Annullamento">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="NumeroOrdineRichiesta" type="xs:string"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
							<xs:element name="ListaRicariche">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="DataInizioEstrazione" type="xs:dateTime" minOccurs="0"/>
										<xs:element name="DataFineEstrazione" type="xs:dateTime" minOccurs="0"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:choice>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RispostaRicarica">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CodiceOloAgcom">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="3"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="IdRisorsa" type="xs:string"/>
				<xs:element name="CodiceOrdineOLO" type="xs:string"/>
				<xs:element name="TipoAzione" type="ns1:EventoRicaricaType"/>
				<xs:element name="TipologiaAccensioneRicarica" type="ns1:RicaricaType" minOccurs="0"/>
				<xs:element name="NumeroOrdineRichiesta" type="xs:string" minOccurs="0"/>
				<xs:element name="EsitoRichiesta" type="ns1:Esito_Type"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="RispostaListaRicariche">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CodiceOloAgcom">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:length value="3"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="IdRisorsa" type="xs:string"/>
				<xs:element name="CodiceOrdineOLO" type="xs:string"/>
				<xs:element name="EsitoRichiesta" type="ns1:Esito_Type"/>
				<xs:element name="ListaRicariche" minOccurs="0">
					<xs:complexType>
						<xs:sequence maxOccurs="unbounded">
							<xs:element name="DataInizioRicarica" type="xs:dateTime"/>
							<xs:element name="DataFineRicarica" type="xs:dateTime"/>
							<xs:element name="StatoRicarica">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="SPENTA"/>
										<xs:enumeration value="ACCESA"/>
										<xs:enumeration value="ANNULLATA"/>
										<xs:enumeration value="SCARTATA"/>
										<xs:enumeration value="SCHEDULATA"/>
										<xs:enumeration value="PROLUNGATA"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="TipologiaAccensioneRicarica" type="ns1:RicaricaType"/>
							<xs:element name="CanaleRicezioneRichiesta">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="GUI"/>
										<xs:enumeration value="B2B"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="DataCreazioneRichiesta" type="xs:dateTime"/>
							<xs:element name="NumeroOrdineRichiesta" type="xs:string" minOccurs="0"/>
							<xs:element name="CodiceOrdineOLO" type="xs:string" minOccurs="0">
								<xs:annotation>
									<xs:documentation>Sarà valorizzato solo in caso di Richiesta di Ricarica pervenuta tramite canale B2B</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ACK" type="ns1:Ack_Type">
		<xs:annotation>
			<xs:documentation>Contiene le informazioni che indentificano l'evento con cui NOW fornisce l'ACK applicativo</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:simpleType name="TaglioRicaricaType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="2"/>
			<xs:enumeration value="7"/>
			<xs:enumeration value="28"/>
			<xs:enumeration value="30"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="RicaricaType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="NRT"/>
			<xs:enumeration value="SCHEDULATA"/>
			<xs:enumeration value="PROLUNGATA"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="Esito_Type">
		<xs:sequence>
			<xs:element name="Esito">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:enumeration value="OK"/>
						<xs:enumeration value="KO"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="Causale" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Valorizzato solo in caso di KO</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Descrizione" type="xs:string" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Valorizzato solo in caso di KO</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Ack_Type">
		<xs:sequence>
			<xs:element name="Data" type="xs:dateTime"/>
			<xs:element name="CausaleEsito" type="ns1:CausaleEsitoAckType">
				<xs:annotation>
					<xs:documentation>ESITO ACK:
						000 - OK
						001 - KO NOW NON RAGGIUNGIBILE
						002 - KO ERRORE GENERICO
					</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="TipoMessaggio" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="ns1:EventoRicaricaType"/>
				</xs:simpleType>
			</xs:element>
			<xs:element name="DescrizioneErrore" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:simpleType name="CausaleEsitoAckType">
		<xs:restriction base="xs:string">
			<xs:length value="3"/>
			<xs:enumeration value="000"/>
			<xs:enumeration value="001"/>
			<xs:enumeration value="002"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="EventoRicaricaType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="ACCENSIONE"/>
			<xs:enumeration value="ANNULLAMENTO"/>
			<xs:enumeration value="SCHEDULAZIONE"/>
			<xs:enumeration value="PROLUNGAMENTO"/>
			<xs:enumeration value="SCHEDULAZIONE"/>
			<xs:enumeration value="SPEGNIMENTO"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
