<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ControlloOrdine/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ControlloOrdine/">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="ID_RICH_ALLIN" type="integer" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ID_ESEC" type="integer" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="IDASSET" maxOccurs="1" minOccurs="0">
    				<simpleType>
    					<restriction base="integer">
    					 <totalDigits value="19"/>
    					
    					</restriction>
    				</simpleType>
    			</element>
    			<element name="NUM_RETRY" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="TransactionID" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>


</schema>