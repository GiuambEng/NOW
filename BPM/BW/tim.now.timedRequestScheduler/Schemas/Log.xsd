<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://telecomitalia.it/NOW/B2BRicarica/Log/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://telecomitalia.it/NOW/B2BRicarica/Log/">

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="msgCode" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="loggerName" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="message" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Error" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>