<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://tim.now/SospesoAppuntamentoMgmt" xmlns:tns="http://tim.now/SospesoAppuntamentoMgmt" elementFormDefault="qualified">

    <element name="InputSospesoAppuntamento" >
    	<complexType>
    		<sequence>
    			<element name="SospesoAppuntamentoData" >
    				<complexType>
    					<sequence>
    						<element name="IDRICHIESTAOLO" type="string" minOccurs="0"></element>
    						<element name="TASK" type="string"  minOccurs="0"></element>
    						<element name="SCADENZA" type="dateTime"  minOccurs="0"></element>
    						<element name="QUEUE_NAME" type="string"  minOccurs="0"></element>
    						
    					</sequence>
    				</complexType>
    			</element>
    			<element name="ProcessDataUtils" >
    				<complexType>
    					<sequence>
    						<element name="ProcessIstanceID" type="string" minOccurs="0"></element>
    					</sequence>
    		
    		
    		
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
     <element name="OuputSospesoAppuntamento" >
    	<complexType>
    		<sequence>
    			<element name="SospesoAppuntamentoData" >
    				<complexType>
    					<sequence>
    						<element name="ESITO" type="string" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    	
    		</sequence>
    	</complexType>
    </element>
</schema>