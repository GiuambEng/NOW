<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://olo2olo.npfibra.it/migrazione/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://olo2olo.npfibra.it/migrazione/" xmlns:h="http://telecomitalia.it/NOW/B2BRicarica/Header">
  <import schemaLocation="Header.xsd" namespace="http://telecomitalia.it/NOW/B2BRicarica/Header"></import>
	    <element name="NPRequest">
		<complexType>
			<sequence>
				<element name="OLO_NPRequest">
		<complexType>
			<sequence>
					<element name="codiceOperatoreRec" type="tns:codOperatore" maxOccurs="1" minOccurs="1"/>
					<element name="codiceOrdineWHS" type="tns:codOrdWHS" maxOccurs="1" minOccurs="1"/>
					<element name="idNotifica" type="tns:idNotifica" maxOccurs="1" minOccurs="1"/>
					<element name="dataNotifica" type="dateTime" maxOccurs="1" minOccurs="1"/>
					<element name="tipoNotifica" type="tns:tipoNotifica" maxOccurs="1" minOccurs="1"/>
					<element name="routingNumber" type="tns:routingNumber" maxOccurs="1" minOccurs="0"/>
					<element name="numerazioni" type="tns:numerazioni" maxOccurs="1" minOccurs="0"/>
					<element name="note" type="tns:note" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
				<element name="Header" type="h:HeaderType" maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
					<element name="NPNotification">
		<complexType>
			<sequence>
				<element name="OLO_NPNotification">
		<complexType>
			<sequence>
					<element name="codiceOperatoreDonor" type="tns:codOperatore" maxOccurs="1" minOccurs="1"/>
					<element name="codiceOrdineWHS" type="tns:codOrdWHS" maxOccurs="1" minOccurs="1"/>
					<element name="idNotifica" type="tns:idNotifica" maxOccurs="1" minOccurs="1"/>
					<element name="dataNotifica" type="dateTime" maxOccurs="1" minOccurs="1"/>
					<element name="tipoNotifica" type="tns:tipoNotifica" maxOccurs="1" minOccurs="1"/>
					<element name="numerazioniScartate" type="tns:numerazioni" maxOccurs="1" minOccurs="1"/>
					<element name="codiceMotivazione" type="tns:codMotivazione" maxOccurs="1" minOccurs="1"/>
					<element name="motivazione" type="tns:note" maxOccurs="1" minOccurs="1"/>
					<element name="note" type="tns:note" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
				<element name="Header" type="h:HeaderType" maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
						<element name="Response">
		<complexType>
			<sequence>
				<element name="Ack">
		<complexType>
			<sequence>
					<element name="idNotifica" type="tns:idNotifica" maxOccurs="1" minOccurs="1"/>
					<element name="esito" type="tns:esito" maxOccurs="1" minOccurs="1"/>
					<element name="codiceMotivazione" type="tns:codMotivazione" maxOccurs="1" minOccurs="0"/>
					<element name="motivazione" type="tns:note" maxOccurs="1" minOccurs="0"/>
			</sequence>
		</complexType>
	</element>
				<element name="Header" type="h:HeaderType" maxOccurs="1" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
			
			 <complexType name="numerazioni">
				<sequence>
				  <element name="dn" type="tns:dn" minOccurs="1" maxOccurs="10"/>
				</sequence>
			</complexType>
			<simpleType name="codOperatore">
				<restriction base="string">
				  <maxLength value="3"/>
				</restriction>
			</simpleType>
			<simpleType name="codOrdWHS">
				<restriction base="string">
				  <maxLength value="18"/>
				</restriction>
			</simpleType>
			<simpleType name="idNotifica">
				<restriction base="string">
				  <maxLength value="100"/>
				</restriction>
			</simpleType>
			<simpleType name="tipoNotifica">
				<restriction base="string">
				  <enumeration value="01"/>
				  <enumeration value="02"/>
				  <enumeration value="03"/>
				</restriction>
			</simpleType>
			<simpleType name="routingNumber">
				<restriction base="string">
				  <maxLength value="18"/>
				</restriction>
			</simpleType>
			<simpleType name="dn">
				<restriction base="string">
				  <maxLength value="20"/>
				</restriction>
			</simpleType>
			<simpleType name="note">
				<restriction base="string">
				  <maxLength value="255"/>
				</restriction>
			</simpleType>
			<simpleType name="codMotivazione">
				<restriction base="string">
				  <maxLength value="3"/>
				</restriction>
			</simpleType>
			<simpleType name="esito">
				<restriction base="string">
				  <maxLength value="1"/>
				</restriction>
			</simpleType>
       </schema>