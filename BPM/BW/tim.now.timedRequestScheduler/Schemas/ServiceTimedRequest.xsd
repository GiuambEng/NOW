<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:tns="http://www.tim.com/NOW/xsd/ServiceTimedRequest" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/ServiceTimedRequest">


	<import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"/>
	<complexType name="GestioneSospesoAppuntamento">
		<sequence>
			<element maxOccurs="1" minOccurs="1" name="IdirichiestaOLO"
				type="string" />
			<element maxOccurs="1" minOccurs="1" name="Scadenza"
				type="dateTime" />

			<element name="FLAG_ANNULLAMENTO_TIMER" type="string"
				maxOccurs="1" minOccurs="0">
			</element>
		</sequence>
	</complexType>

	<complexType name="GestioneSospesoAppuntamentoResponse">
		<sequence>
			<element maxOccurs="1" minOccurs="1" name="Esito">
				<simpleType>
					<restriction base="string">
						<enumeration value="OK" />
					</restriction>
				</simpleType>
			</element>
		</sequence>
	</complexType>

	<complexType name="GestioneAppuntamentoFault">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="FaultCode"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="FaultMessage"
				type="string" />
		</sequence>
	</complexType>

	<complexType name="CreateRequestRicarica">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="AssetRicarica"
				type="pref:AssetRicarica" />
			<element maxOccurs="1" minOccurs="0" name="ProcessID"
				type="string" />

			<element name="IDAssetRicarica" type="integer" maxOccurs="1"
				minOccurs="0" />
			<element name="CanaleRichiesta" type="string" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="FlagAccensione" type="boolean" maxOccurs="1"
				minOccurs="0">
			</element>
			<element name="FlagScheduler" type="boolean" maxOccurs="1"
				minOccurs="0">
			</element>
		</sequence>
	</complexType>

	<complexType name="CreateRequestRicaricaResponse">
		<sequence>

			<element maxOccurs="1" minOccurs="0" name="Esito"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="IDRichiestaOLO"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="ControlloFault"
				type="boolean" />
		</sequence>

	</complexType>

	<complexType name="CreateRequestRicaricaFault">
		<sequence>
			<element maxOccurs="1" minOccurs="0" name="FaultCode"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="FaultMessage"
				type="string" />
		</sequence>
	</complexType>

	<complexType name="StoricoRichiestaRicarica">
		<sequence>
			<element name="IDRichOLO" type="string" maxOccurs="1"
				minOccurs="1">
			</element>
			<element name="IDAssetRicarica" type="string"
				maxOccurs="unbounded" minOccurs="0">

			</element>
		</sequence>
	</complexType>

	<complexType name="StoricoRichiestaRicaricaResponse">
		<sequence>
			<element name="EsitoInserimento" type="string"></element>
		</sequence>
	</complexType>

	<complexType name="StoricoRichiestaRicaricaFault">

		<sequence>
			<element maxOccurs="1" minOccurs="0" name="FaultCode"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="FaultMessage"
				type="string" />
		</sequence>


	</complexType>



	<complexType name="FindUpdateRicarica">
		<sequence>
				<choice>
					<element name="Find">
						<complexType>
							<sequence>
								<element name="Input"
									type="tns:FindRisorsaRequest_type" />
							</sequence>
						</complexType>
					</element>
					<element name="Update">
						<complexType>
							<sequence>
								<element name="Input"
									maxOccurs="unbounded" minOccurs="1">
									<complexType>
										<sequence>
											<element
												name="CaseReference" type="string" />
											<element
												name="AssetRicarica" maxOccurs="1" minOccurs="0"
												type="pref:AssetRicarica">
											</element>
										</sequence>
									</complexType>
								</element>
							</sequence>
						</complexType>
					</element>
					<element name="Create">
						<complexType>
							<sequence>
								<element name="Input">
									<complexType>
										<sequence>
											<element name="caseType"
												type="string" />
											<element
												name="caseModelVersion" type="string" />
											<element
												name="AssetRicarica" maxOccurs="unbounded" minOccurs="0"
												type="pref:AssetRicarica" />
										</sequence>
									</complexType>
								</element>
							</sequence>
						</complexType>
					</element>

				</choice>

				<element name="Transaction_ID" type="string"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="DES" type="date" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="ORADES" type="time" maxOccurs="1"
					minOccurs="0">
				</element>
			</sequence>
	</complexType>

	<complexType name="FindUpdateRicaricaResponse">
		
			<choice>
				<element name="Find" minOccurs="0"
					maxOccurs="unbounded">
					<complexType>
						<sequence>
							<element name="CaseReference" type="string"
								minOccurs="0" />

							<element name="Response"
								type="tns:output_type" maxOccurs="1" minOccurs="0" />
							<element name="AssetRicarica"
								type="pref:AssetRicarica">
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="Update">
					<complexType>
						<sequence>
							<element name="Response"
								type="tns:output_type" />
						</sequence>
					</complexType>
				</element>
				<element name="Create">
					<complexType>
						<sequence>
							<element name="CaseReference" type="string"
								minOccurs="0" />
							<element name="AssetNow" type="string"
								minOccurs="0" />
							<element name="Response"
								type="tns:output_type" />
						</sequence>
					</complexType>
				</element>
			</choice>
		
	</complexType>

	<complexType name="FindUpdateRicaricaFault">

		<sequence>
			<element maxOccurs="1" minOccurs="0" name="FaultCode"
				type="string" />
			<element maxOccurs="1" minOccurs="0" name="FaultMessage"
				type="string" />
		</sequence>


	</complexType>


	<element name="operationRequest">
		<complexType>
			<sequence>
				<element name="in" type="string" />
			</sequence>
		</complexType>
	</element>
	<element name="operationResponse">
		<complexType>
			<sequence>
				<element name="out" type="string" />
			</sequence>
		</complexType>
	</element>

<complexType name="FindRisorsaRequest_type">
		<sequence>
			<element name="caseModelVersion" type="string" />
			<element name="caseType" type="string" />
			<element name="Criteria">
				<complexType>
					<sequence>
						<element name="queryString" type="string" />
						<element name="NamedParameterAssigned"
							minOccurs="0" maxOccurs="unbounded">
							<complexType>
								<sequence>
									<element name="name" type="string" />
									<element name="value" type="string"
										minOccurs="0" maxOccurs="unbounded" />
								</sequence>
							</complexType>
						</element>
						<element name="PaginationOption"
							minOccurs="0">
							<complexType>
								<sequence>
									<element name="startPosition"
										type="integer" minOccurs="0" />
									<element name="maxResult"
										type="integer" minOccurs="0" />
								</sequence>
							</complexType>
						</element>
					</sequence>
				</complexType>
			</element>
		</sequence>
	</complexType>

	<complexType name="output_type">
		<sequence>
			<element name="Esito" type="string" />
			<element name="DescrizioneEsito" type="string"
				minOccurs="0" />
		</sequence>
	</complexType>


</schema>
