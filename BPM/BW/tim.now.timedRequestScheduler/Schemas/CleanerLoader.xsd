<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://telecomitalia.it/NOW/CleanerLoader/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://telecomitalia.it/NOW/CleanerLoader/">

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="ID" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ID_RICH_OLO" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="TIMESTAMP_INS" type="dateTime"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="TIMESTAMP_AGG" type="dateTime"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="ID_TPLG_STATO_RICH_OLO_TIBCO" type="int"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="CONTATORE" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Counter" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="NEWCONTATORE" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="NEWCONTATORE"
    							maxOccurs="unbounded" minOccurs="0">
    							<complexType>
    								<sequence>
    									<element name="Counter"
    										type="string" maxOccurs="1" minOccurs="0">
    									</element>
    								</sequence>
    							</complexType>
    						</element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Counter">
    	<complexType>
    		<sequence>
    			<element name="COUNTER" maxOccurs="1" minOccurs="0"
    				type="string">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Response">
    	<complexType>
    		<sequence>
    			<element name="Counter" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="ControlPurge" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="CounterRichieste">
    	<complexType>
    		<sequence>
    			<element name="Counter" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="Counter" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ControlPurge" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="RequestEcEventCleaner">
    	<complexType>
    		<sequence>
    			<element name="IDRichOLO" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Status" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="TransactionID" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="LogUtenti">
    	<complexType>
    		<sequence>
    			<element name="LogUtenti" type="tns:NewType"
    				maxOccurs="unbounded" minOccurs="0">
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <complexType name="NewType">
    	<sequence>
    		<element name="Nome" type="string" maxOccurs="1" minOccurs="0"></element>
    		<element name="Valore" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>