<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Rendezvous/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Rendezvous/">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="CODFC_OLO_AGCOM" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="ID_OFFERTA" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CREATED" type="dateTime" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="TransactionID" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="Record" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="CODFC_OLO_AGCOM" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="ID_OFFERTA" type="int" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
</schema>