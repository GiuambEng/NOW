<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema elementFormDefault="qualified"
	targetNamespace="http://www.tim.com/NOW/xsd/REGstart"
	xmlns:extns="http://xsd.telecomitalia.it/crm/xdsl/nga"
	xmlns:extns1="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil"
	xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"
	xmlns:tns=" http://www.tim.com/NOW/xsd/NGAstart"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:Q1="http://NOW.it.telecomitalia.it/casedata" xmlns:Q2="http://www.tim.com/NOW/xsd/Lavorate">
    <xsd:import namespace="http://www.tim.com/NOW/xsd/Lavorate"></xsd:import>
    <xsd:import
		namespace="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil"
		schemaLocation="../BPM_Acquisition/AnalyzeOloRequestUtil.xsd" />

	<xsd:import schemaLocation="../SchemaOLO/NOW_ServiziRegolamentati_v2.5.xsd"></xsd:import>
	<xsd:element name="Element">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element minOccurs="0" ref="extns1:CodiciOlo" />
				<xsd:element name="CodOLOdaNome" type="xsd:string" />
				<xsd:element name="CodISPdaNome" type="xsd:string"
					minOccurs="0" maxOccurs="1">
				</xsd:element>
				<xsd:element name="ID_FILE" type="xsd:double" />
				<xsd:element name="DATA_FILE" type="xsd:dateTime" />
				<xsd:element name="NextWorkingDate" type="xsd:date" />

				<xsd:element minOccurs="1" ref="RichiestaOloRegolatorio"
					maxOccurs="1" />
				<xsd:element ref="Q2:RichiesteLavorate" minOccurs="0" maxOccurs="1"></xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
