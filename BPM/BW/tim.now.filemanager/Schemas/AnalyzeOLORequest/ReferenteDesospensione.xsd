<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ReferenteDesospensione/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ReferenteDesospensione/">

    <element name="ReferenteDesospensione">
    	<complexType>
    	  <sequence>
            <element name="QualificaRef">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="2" />
                        <enumeration value="O" />
                        <enumeration value="CF" />
                    </restriction>
                </simpleType>
            </element>
            <element name="CognomeReferente">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="50" />
                    </restriction>
                </simpleType>
            </element>
            <element name="NomeReferente" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="30" />
                    </restriction>
                </simpleType>
            </element>
            <element name="TelefonoFissoReferente" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="16" />
                    </restriction>
                </simpleType>
            </element>
            <element name="TelefonoMobileReferente" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="16" />
                    </restriction>
                </simpleType>
            </element>
        </sequence>
    	</complexType>
    </element>
</schema>