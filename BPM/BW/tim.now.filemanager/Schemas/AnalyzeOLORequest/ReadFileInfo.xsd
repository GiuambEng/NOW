<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ReadFileInfo" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ReadFileInfo">

    <complexType name="InputType">
    	<sequence>
    		<element name="FileFullName" type="string"></element>
    	</sequence>
    </complexType>
    
    <complexType name="OutputType">
    	<sequence>
    		<element name="FileName" type="string"></element>
    		<element name="FileFullName" type="string"></element>
    		<element name="Size" type="int"></element>
    		<element name="TextContent" type="string"></element>
    		<element name="CodISP" minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<length value="3"></length>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="CodAGCOM" minOccurs="0">
    			<simpleType>
    				<restriction base="string">
    					<length value="3"></length>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="DataFile" type="dateTime" minOccurs="0"></element>
    		<element name="Descr_Stato_File" type="string"></element>
    		<element name="IDfile" type="int"></element>
    		<element name="IDintrfc" type="int"></element>
    		<element name="IDtplg_file" type="int"></element>
    		<element name="TimestampAperturaFile" type="dateTime"></element>
    		<element name="VersoDelFile" type="string"></element>
    		<element name="IdEsecProcsoFile" type="int" minOccurs="0"></element>
    		<element name="Flag_Oscuramento" type="string"
    			minOccurs="0">
    		</element>
    		<element name="ContenutoXML" type="base64Binary" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>

    <element name="Input" type="tns:InputType"></element>

    <element name="Output" type="tns:OutputType"></element>
</schema>