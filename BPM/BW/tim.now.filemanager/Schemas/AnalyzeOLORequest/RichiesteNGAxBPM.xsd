<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema elementFormDefault="qualified"
	attributeFormDefault="unqualified"
	targetNamespace="http://www.example.org/RichiesteNGAxBPM"
	xmlns="http://www.example.org/RichiesteNGAxBPM"
	xmlns:Q1="http://NOW.it.telecomitalia.it/casedata"
	xmlns:pref="http://NOW.it.telecomitalia.it/casedata"
	xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns0="http://xsd.telecomitalia.it/crm/xdsl/nga">
	<!-- <xsd:include schemaLocation="SchemaOLO/NOW_ServiziRegolamentati_v2.2.xsd"/> -->


	<xsd:import namespace="http://NOW.it.telecomitalia.it/casedata"
		schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd" />

	<xsd:import schemaLocation="../SchemaOLO/NOW_Tracciato_OLO_ServiziNGA_v3.9.xsd" namespace="http://xsd.telecomitalia.it/crm/xdsl/nga"></xsd:import>
	<xsd:element name="RichiesteOLOSuddivise"
		type="RichiesteOLOSuddiviseType" />

	<xsd:complexType name="RichiesteOLOSuddiviseType">
		<xsd:sequence>
			<xsd:element maxOccurs="unbounded" minOccurs="0"
				name="Richieste" type="RichiesteOLOType" />

		</xsd:sequence>
	</xsd:complexType>


	<xsd:complexType name="RichiesteOLOType">
		<xsd:all>
			<xsd:element maxOccurs="1" minOccurs="0" name="RichiesteATT"
				type="RichiestaElementType" />
			<xsd:element maxOccurs="1" minOccurs="0"
				name="RichiesteATT_ANN" type="RichiestaElementType" />
			<!-- name="RichiesteALTRO" -->
			<xsd:element maxOccurs="1" minOccurs="0" xmlns=""
				ref="ns0:TracciatoOLONGA" />
				<xsd:element maxOccurs="1" minOccurs="0" name="ProgressiviAlt" type="xsd:int"/> 
		</xsd:all>
	</xsd:complexType>

	<xsd:complexType name="RichiestaElementType">
		<xsd:sequence>
			<xsd:element ref="Q1:RichiestaElement" />
		</xsd:sequence>
	</xsd:complexType>

</xsd:schema>
