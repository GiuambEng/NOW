<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/Token/" xmlns:pref="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:pref1="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" targetNamespace="http://www.tim.com/NOW/xsd/Token/" elementFormDefault="qualified">
	<import namespace="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" schemaLocation="NOW_SECOLO_ROLLOUT.xsd"/>
	<import namespace="http://www.tim.com/NOW/xsd/NOW_SECOLO/" schemaLocation="NOW_SECOLO.xsd"/>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="RequestVerificaRollout" minOccurs="0" maxOccurs="1">
					<complexType>
						<sequence>
							<element name="CodificaOLOAGCOM" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CodificaOloNumerico" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Offerta" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Lavorazione" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CodiceIstatComune" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="FlagReferente" type="boolean" minOccurs="0" maxOccurs="1"/>
							<element name="FlagClienteFinale" type="boolean" minOccurs="0" maxOccurs="1"/>
							<element name="CodiceOrdineOLO" type="string" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
				<element name="RequestCreate_token" minOccurs="0" maxOccurs="1">
					<complexType>
						<sequence>
							<element name="CodificaOLOAGCOM" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CodiceOrdineOLO" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Funzione" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="ChiaveRiferimento" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Operatore" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="IPClient" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="N_Recap_Cliente" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="N_Recap_Cliente_ALT" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Note" type="string" minOccurs="0"/>
							<element name="Nome" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CognomeRagioneSociale" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CodiceFiscale" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="PIVA" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="TOKENIZZAZIONE" minOccurs="0" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<enumeration value="C2PLUS"/>
										<enumeration value="D420"/>
									</restriction>
								</simpleType>
							</element>
						</sequence>
					</complexType>
				</element>
				<element name="RequestDecode_token" minOccurs="0" maxOccurs="1">
					<complexType>
						<sequence>
							<element name="CodificaOLOAGCOM" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CodiceOrdineOLO" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Funzione" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="ChiaveRiferimento" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Operatore" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="IPClient" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Token" type="string" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
				<element name="ProcessIstance" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="StrutturaRichiesta" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="NumeroLinea" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="IDRisorsa" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="OffertaBPM" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="CodiceOrdineRiferimentoTI" type="string" minOccurs="0" maxOccurs="1"/>
			</sequence>
		</complexType>
	</element>
	<element name="Response">
		<complexType>
			<sequence>
				<element name="ResponseCreate_token" minOccurs="0" maxOccurs="1">
					<complexType>
						<sequence>
							<element name="Token" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="N_Recap_Cliente" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="N_Recap_Cliente_ALT" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Note" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Nome" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CognomeRagioneSociale" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CodiceFiscale" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="PIVA" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="ESITO" minOccurs="1" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="2"/>
										<enumeration value="OK"/>
										<enumeration value="KO"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DESCRIZIONE" type="string" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
				<element name="ResponseDecode_token" minOccurs="0" maxOccurs="1">
					<complexType>
						<sequence>
							<element name="ESITO" minOccurs="1" maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="2"/>
										<enumeration value="OK"/>
										<enumeration value="KO"/>
									</restriction>
								</simpleType>
							</element>
							<element name="DESCRIZIONE" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="N_Recap_Cliente" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="N_Recap_Cliente_ALT" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="Note" type="string" minOccurs="0"/>
							<element name="Nome" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CognomeRagioneSociale" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="CodiceFiscale" type="string" minOccurs="0" maxOccurs="1"/>
							<element name="PIVA" type="string" minOccurs="0" maxOccurs="1"/>
						</sequence>
					</complexType>
				</element>
				<element name="Rollout" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="TOKENIZZAZIONE_RECAPITI" type="string" minOccurs="0" maxOccurs="1"/>
				<element name="TOKENIZZAZIONE" minOccurs="0" maxOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="C2PLUS"/>
							<enumeration value="D420"/>
						</restriction>
					</simpleType>
				</element>
			</sequence>
		</complexType>
	</element>
</schema>
