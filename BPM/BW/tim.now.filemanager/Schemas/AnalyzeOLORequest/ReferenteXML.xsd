<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/ReferenteXML/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ReferenteXML/">

  <element name="Referente">
      <complexType>
        <sequence>
        	<element name="Referente" maxOccurs="unbounded"
        		minOccurs="0">
        		<complexType>




        			<sequence>
        				 	<element name="Progressivo" maxOccurs="1" minOccurs="0">
        		<simpleType>
        			<restriction base="string">
        				<maxLength value="2" />
        				<enumeration value="1" />
        				<enumeration value="2" />
        				<enumeration value="3" />
        			</restriction>
        		</simpleType>
        	</element>
        	<element name="QualificaRef" maxOccurs="1" minOccurs="0">
        		<simpleType>
        			<restriction base="string">
        				<maxLength value="2" />
        				<enumeration value="O" />
        				<enumeration value="CF" />
        			</restriction>
        		</simpleType>
        	</element>
        	<element name="CognomeReferente" maxOccurs="1" minOccurs="0">
        		<simpleType>
        			<restriction base="string">
        				<maxLength value="50" />
        			</restriction>
        		</simpleType>
        	</element>
        	<element name="NomeReferente" minOccurs="0">
        		<simpleType>
        			<restriction base="string">
        				<maxLength value="30" />
        			</restriction>
        		</simpleType>
        	</element>
        	<element name="TelefonoFissoReferente" minOccurs="0">
        		<simpleType>
        			<restriction base="string">
        				<maxLength value="16" />
        			</restriction>
        		</simpleType>
        	</element>
        	<element name="TelefonoMobileReferente" minOccurs="0">
        		<simpleType>
        			<restriction base="string">
        				<maxLength value="16" />
        			</restriction>
        		</simpleType>
        	</element>
        	<element name="EmailReferente" minOccurs="0">
        		<simpleType>
        			<restriction base="string">
        				<maxLength value="255" />
        			</restriction>
        		</simpleType>
        	</element>
        	
            <element name="Qualifica" maxOccurs="1" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="2" />
                        <enumeration value="O" />
                        <enumeration value="CF" />
                    </restriction>
                </simpleType>
            </element>
            <element name="Nome" maxOccurs="1" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="30" />
                        <minLength value="1" />
                    </restriction>
                </simpleType>
            </element>
            <element name="Cognome" maxOccurs="1" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="50" />
                        <minLength value="1" />
                    </restriction>
                </simpleType>
            </element>
            <element name="Telefono" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="16" />
                    </restriction>
                </simpleType>
            </element>
            <element name="Mobile" minOccurs="0">
                <simpleType>
                    <restriction base="string">
                        <maxLength value="16" />
                    </restriction>
                </simpleType>
            </element>
             <element name="Email" minOccurs="0">
				<simpleType>
					<restriction base="string">
						<maxLength value="255"/>
					</restriction>
				</simpleType>
			</element>
        			</sequence>
        		</complexType>
        	</element>
        </sequence>
      </complexType>
  
  </element>

</schema>