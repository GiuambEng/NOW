<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/VerificaProgetto/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/VerificaProgetto/">

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="Codfc_Olo_Agicom" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="CodiceProgetto" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="Dro" type="date" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Response">
    	<complexType>
    		<sequence>
    			<element name="FlagFittizio" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>