<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Referenti/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/Referenti/" xmlns:pref="http://NOW.it.telecomitalia.it/casedata">

	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata"></import>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="Token" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Esito" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Descrizione" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="Referente" type="pref:Referente" maxOccurs="unbounded" minOccurs="0">
				</element>
			</sequence>
		</complexType>
	</element>
</schema>