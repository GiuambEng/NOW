<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile">

    <complexType name="InputType">
    	<sequence>
    		<element name="NomeFile" type="string"></element>
    		<element name="Ambito">
    			<simpleType>
    				<restriction base="string">
    					<enumeration value="SDR"></enumeration>
    					<enumeration value="CRMWS"></enumeration>
    					<enumeration value="WSDP"></enumeration>
    					<enumeration value="DBCFX"></enumeration>
    					<enumeration value="BAD"></enumeration>
    				</restriction>
    			</simpleType>
    		</element>
    		<element name="IntrfcInput" type="int" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <complexType name="OutputType">
    	<sequence>
    		<element name="IdIntrfc" type="int" minOccurs="0"></element>
    		<element name="IdProcsoFile" type="int" minOccurs="0"></element>
    	</sequence>
    </complexType>
    
    <element name="Input" type="tns:InputType"></element>

    <element name="Output" type="tns:OutputType"></element>

    <element name="Interfaccia" type="string"></element>
</schema>