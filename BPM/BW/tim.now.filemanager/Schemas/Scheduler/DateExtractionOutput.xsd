<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/DateExtractionOutput" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/DateExtractionOutput">

    <element name="Output" type="tns:OutputType"></element>

    <complexType name="OutputType">
    	<sequence>
    		<element name="DateFromFilename" type="date" maxOccurs="1" minOccurs="0"></element>
    		<element name="Status" type="string"></element>
    		<element name="Msg" type="string" maxOccurs="1" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>