<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/FileProcstoUpdate" xmlns:tns="http://www.example.org/FileProcstoUpdate" elementFormDefault="qualified">
	<element name="InsertDir">
    	<complexType>
    		<sequence>
    			<element ref="tns:Insert" maxOccurs="unbounded" minOccurs="0"/>
    		</sequence>
    	</complexType>
    </element>
	<element name="Insert">
    	<complexType>
    		<sequence>
    			<element name="TMSP_INIZIO_ELAB" type="dateTime" minOccurs="1" maxOccurs="1"/>
    			<element ref="tns:EsecuzioneProcessoFile" maxOccurs="1" minOccurs="0"/>
    			<element ref="tns:FileProcstoInput" maxOccurs="1" minOccurs="0"/>
    		</sequence>
    	</complexType>
    </element>
	<element name="EsecuzioneProcessoFile">
    	<complexType>
    		<sequence>
    			<element name="COD_PROCSO_FILE" type="string" maxOccurs="1" minOccurs="1"/>
    			<element name="ID_ESEC_PROCSO_FILE" type="int" maxOccurs="1" minOccurs="1"/>
    			<element name="STATO_ESEC" maxOccurs="1" minOccurs="1">
					<simpleType>
						<restriction base="string">
							<enumeration value="IN ELABORAZIONE"/>
							<enumeration value="CHIUSO"/>
						</restriction>
					</simpleType>
				</element>
    			<element name="TMSP_FINE_ELAB" type="dateTime" maxOccurs="1" minOccurs="1"/>
    		</sequence>
    	</complexType>
    </element>
    <element name="FileProcstoInput">
    	<complexType>
    		<sequence>
    			<element name="COD_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="CODFC_OLO_AGCOM" type="string"
    				maxOccurs="1" minOccurs="1">
    			</element>
    			<element name="DATA_FILE" type="date" maxOccurs="1"
    				minOccurs="0" />
    			<element name="DESCR_STATO_FILE" type="string"
    				maxOccurs="1" minOccurs="1" />
    			<element name="ESITO" type="string" maxOccurs="1"
    				minOccurs="1" />
    			<element name="ID_FILE" type="int" maxOccurs="1"
    				minOccurs="1" />
    			<element name="ID_INTRFC" type="int" maxOccurs="1"
    				minOccurs="1" />
    			<element name="TIMSTP_APERTURA_FILE" type="dateTime"
    				maxOccurs="1" minOccurs="1" />
    			<element name="VERSO_DEL_FILE" type="string"
    				maxOccurs="1" minOccurs="1" />
    			<element name="NOME_FILE" type="string" maxOccurs="1"
    				minOccurs="1" />
    			<element name="IDTPLG_FILE" type="string" maxOccurs="1"
    				minOccurs="1" />
    		</sequence>
    	</complexType>
    </element>
</schema>