<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/VerificaAllineamentoCRMWS">

    <complexType name="InputType">
    	<sequence>
    		<element minOccurs="0" name="CodiceOrdineOLO" type="string">
    		</element>
    		<element minOccurs="0" name="CodiceOrdineTI" type="string">
    		</element>
    		<element minOccurs="0" name="IdEsecProcsoNoFile" type="int">
    		</element>
    		<element minOccurs="0" name="IdRichiestaOLO" type="string">
    		</element>
    		<element minOccurs="0" name="IdRisorsa" type="string"/>
    		<element minOccurs="0" name="IdRisorsa2" type="string"/>
    		<element minOccurs="0" name="Telefonico" type="string"/>
    		<element maxOccurs="10" minOccurs="0" name="DN" type="string"/>
    	</sequence>
    </complexType>

    <element name="Input" type="tns:InputType"/>
    
    	<element name="Esito">
		<simpleType>
			<restriction base="string">
				<enumeration value="ALLINEATO"/>
				<enumeration value="DISALLINEATO"/>
			</restriction>
		</simpleType>
	</element>


    	<complexType name="EsitiType">
    		<sequence>
    		<element maxOccurs="13" minOccurs="0" ref="tns:Coppia"/>
    		</sequence>
    	</complexType>
    	
    	<element name="Esiti" type="tns:EsitiType"/>

    	<complexType name="CoppiaType">
    		<sequence>
    			<element name="Risorsa" type="string"/>
    			<element ref="tns:Esito"/>
    		</sequence>
    	</complexType>
    	
    	<element name="Coppia" type="tns:CoppiaType"/>
    	
    	    		<complexType name="TernaType">
    		<sequence>
    			<element name="Risorsa" type="string"/>
    			<element name="Esito">
    						<simpleType>
			<restriction base="string">
				<enumeration value="ALLINEATO"/>
				<enumeration value="DISALLINEATO"/>
				<enumeration value="CESSATO"/>
			</restriction>
		</simpleType>
    			</element>
    			    		<element minOccurs="0" name="CodiceOLOris">
    			<simpleType>
    				<restriction base="string">
    					<length value="3"/>
    				</restriction>
    			</simpleType>
    		</element>
    		</sequence>
    	</complexType>
    	
    	    	<element name="Terna" type="tns:TernaType"/>
    	
    	
    	<complexType name="OutputNota15Type">
    		<sequence>
    		<element maxOccurs="13" minOccurs="0" ref="tns:Terna">
    		</element>
    		</sequence>
    	</complexType>
    	
    	<element name="OutputNota15" type="tns:OutputNota15Type"/>
    	
</schema>
