<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil" xmlns:tns1="http://NOW.it.telecomitalia.it/casedata" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil">
	<import namespace="http://NOW.it.telecomitalia.it/casedata" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/Casedata.xsd"/>
	<element name="RichiestaMapper">
		<complexType>
			<sequence>
				<element maxOccurs="unbounded" minOccurs="1" name="Richiesta" type="tns1:Richiesta"/>
			</sequence>
		</complexType>
	</element>
    <element name="FileContentFiltrato" type="string"/>
    <element name="CodiciOlo">
    	<complexType>
	    	<sequence>
	    		<element maxOccurs="unbounded" minOccurs="0" name="codes" type="tns:CodiceOloType"/>
	    	</sequence>
    	</complexType>
    </element>
    <complexType name="CodiceOloType">
   		<sequence>
   			<element name="CodiceOLO">
   				<simpleType>
   					<restriction base="string">
   						<maxLength value="3"/>
   					</restriction>
   				</simpleType>
   			</element>
   			<element name="CodiceOLOAGCOM">
   				<simpleType>
   					<restriction base="string">
   						<maxLength value="3"/>
   					</restriction>
   				</simpleType>
   			</element>
   			<element name="AZIONE" maxOccurs="1" minOccurs="0">
   				<simpleType>
   					<restriction base="string">
   						<maxLength value="3"/>
   					</restriction>
   				</simpleType>
   			</element>
   		</sequence>
   	</complexType>
</schema>
