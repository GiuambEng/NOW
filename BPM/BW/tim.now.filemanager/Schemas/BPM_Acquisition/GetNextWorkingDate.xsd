<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/GetNextWorkingDate" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/GetNextWorkingDate">

    <complexType name="GetNextWorkingDateType">
    	<sequence>
    		<element name="InputDate" type="date"/>
    		<element minOccurs="0" name="InputDuration" type="string"/>
    		<element minOccurs="0" name="TipoData" type="string"/>
    		<element name="OutputDate" type="date"/>
    	</sequence>
    </complexType>

    <element name="GetNextWorkingDate" type="tns:GetNextWorkingDateType"/>

    <complexType name="ArrayNextDateType">
    	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0" ref="tns:GetNextWorkingDate"/>
    	</sequence>
    </complexType>

    <element name="ArrayNextDate" type="tns:ArrayNextDateType"/>

    <element name="OutputDate" type="date"/>

    <complexType name="GetNextDateByDurationType">
              <sequence>
            <element name="inputDate" type="date"/>
            <choice>
              <element name="inputDuration" type="string"/>
              <element name="GiorniLavorativi" type="int"/>
            </choice>
            <element name="OutputDate" type="date"/>
          </sequence>
    </complexType>

    <complexType name="ArrayByDurationType">
        	<sequence>
    		<element maxOccurs="unbounded" minOccurs="0" ref="tns:GetNextDateByDuration"/>
    	</sequence>
  </complexType>

<element name="ArrayByDuration" type="tns:ArrayByDurationType"/>

    <element name="GetNextDateByDuration" type="tns:GetNextDateByDurationType"/>
</schema>
