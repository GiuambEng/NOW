            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DatiFile-input"
                    name="DatiFile" outputVariable="DatiFile"
                    tibex:xpdlId="9a56d613-5624-4263-b64d-f9a07d874d16" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DatiFileToLog1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($DatiFile/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($DatiFile/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="DatiFileToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9a56d613-5624-4263-b64d-f9a07d874d16+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;$Start/ID_FILE&quot;/>&lt;/ID_FILE>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FP.COD_OLO, FP.CODFC_OLO_AGCOM, FP.DATA_FILE, FP.DESCR_STATO_FILE, FP.ID_FILE, FP.ID_INTRFC, FP.IDTPLG_FILE, FP.TIMSTP_APERTURA_FILE, FP.VERSO_DEL_FILE, FP.ID_ESEC_PROCSO_FILE, FP.NOME_FILE, SII.LOCAL_PATH&#xd;&#xa;  FROM FILE_PROCSTO FP LEFT JOIN SISTEMA_IP_INTRFC SII ON SII.ID_INTRFC=FP.ID_INTRFC AND FP.CODFC_OLO_AGCOM=SII.CODFC_OLO_AGCOM&#xd;&#xa;  WHERE FP.ID_FILE=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="DATA_FILE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="DESCR_STATO_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="ID_FILE"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="ID_INTRFC"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="IDTPLG_FILE"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="TIMSTP_APERTURA_FILE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata columnIndex="9"
                                    columnName="VERSO_DEL_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="10"
                                    columnName="ID_ESEC_PROCSO_FILE"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="11"
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="12"
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
