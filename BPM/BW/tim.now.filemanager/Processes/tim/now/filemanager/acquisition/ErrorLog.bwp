                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b0c88cef-6ef0-4139-87c1-8bbf8d4b1971+input&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1464255115306&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDfile>&lt;xsl:value-of select=&quot;$Start/tns1:ID_File&quot;/>&lt;/IDfile>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FP.ID_ESEC_PROCSO_FILE, PR.COD_PROCSO_FILE&#xa;  FROM FILE_PROCSTO FP, ESEC_PROCSO_FILE ES, PROCSO_FILE PR&#xa;  WHERE FP.ID_FILE=? AND FP.ID_ESEC_PROCSO_FILE=ES.ID_ESEC_PROCSO_FILE AND ES.ID_PROCSO_FILE=PR.ID_PROCSO_FILE&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDfile"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_FILE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_PROCSO_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+89650c27-573e-45b5-a94d-9aff06cf8dca+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1464255115306&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBC_LOG_DATA&quot;/>&lt;xsl:template name=&quot;JDBC_INSERT_LOG-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;CodiceProcesso>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_LOG_DATA/Record[1]/COD_PROCSO_FILE)&quot;>&lt;xsl:value-of select=&quot;$JDBC_LOG_DATA/Record[1]/COD_PROCSO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceProcesso>&lt;IdEsecuzioneProcesso>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_LOG_DATA/Record[1]/ID_ESEC_PROCSO_FILE)&quot;>&lt;xsl:value-of select=&quot;$JDBC_LOG_DATA/Record[1]/ID_ESEC_PROCSO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IdEsecuzioneProcesso>&lt;IdFile>&lt;xsl:value-of select=&quot;$Start/tns1:ID_File&quot;/>&lt;/IdFile>&lt;LogLevel>&lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&lt;/LogLevel>&lt;LogMessage>&lt;xsl:value-of select=&quot;$Start/tns1:Message&quot;/>&lt;/LogMessage>&lt;TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TimeStamp>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_INSERT_LOG-input"
                    name="JDBC_INSERT_LOG"
                    outputVariable="JDBC_INSERT_LOG"
                    tibex:xpdlId="89650c27-573e-45b5-a94d-9aff06cf8dca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_INSERT_LOGToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+89650c27-573e-45b5-a94d-9aff06cf8dca+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1464255115306&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBC_LOG_DATA&quot;/>&lt;xsl:template name=&quot;JDBC_INSERT_LOG-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;CodiceProcesso>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_LOG_DATA/Record[1]/COD_PROCSO_FILE)&quot;>&lt;xsl:value-of select=&quot;$JDBC_LOG_DATA/Record[1]/COD_PROCSO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodiceProcesso>&lt;IdEsecuzioneProcesso>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_LOG_DATA/Record[1]/ID_ESEC_PROCSO_FILE)&quot;>&lt;xsl:value-of select=&quot;$JDBC_LOG_DATA/Record[1]/ID_ESEC_PROCSO_FILE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IdEsecuzioneProcesso>&lt;IdFile>&lt;xsl:value-of select=&quot;$Start/tns1:ID_File&quot;/>&lt;/IdFile>&lt;LogLevel>&lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&lt;/LogLevel>&lt;LogMessage>&lt;xsl:value-of select=&quot;$Start/tns1:Message&quot;/>&lt;/LogMessage>&lt;TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TimeStamp>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO LOG_FILE_PROCSTO (COD_PROCSO,ID_ESEC_PROCSO,ID_FILE,LOG_LEVEL,LOG_MESSAGE,TIMSTP_INSMTO)&#xa;VALUES (?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceProcesso"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdEsecuzioneProcesso"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdFile"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LogLevel"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LogMessage"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TimeStamp"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
