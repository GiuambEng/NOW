                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (starts-with($Start/tns:NomeFile,$NGAPref)) then (concat($AcquisitionFolder,$Start/tns:CodificaOLOAgcom,$NGAfolder)) else (&#xd;&#xa;if(starts-with($Start/tns:NomeFile,$ADSLPref)) then (concat($AcquisitionFolder,$Start/tns:CodificaOLOAgcom,$XDSLfolder)) else(&#xd;&#xa;if(starts-with($Start/tns:NomeFile,$N_NP_pref) or starts-with($Start/tns:NomeFile,concat($T3_pref,$N_NP_pref))) then (concat($AcquisitionFolder,$Start/tns:CodificaOLOAgcom,$N_NPfolder)) else(&#xd;&#xa;if(starts-with($Start/tns:NomeFile,$R_NP_pref) or starts-with($Start/tns:NomeFile,concat($T3_pref,$R_NP_pref))) then (concat($AcquisitionFolder,$Start/tns:CodificaOLOAgcom,$R_NPfolder)) else(&#xd;&#xa;if (starts-with($Start/tns:NomeFile,$SDT_pref)) then (concat($AcquisitionFolder,$Start/tns:CodificaOLOAgcom,$SDT_folder)) else (if ($Start/tns:IdInterfaccia=$IdInterfacciaCPS) then (concat($AcquisitionFolder,$Start/tns:CodificaOLOAgcom,$CPSfolder)) else concat($AcquisitionFolder,$Start/tns:CodificaOLOAgcom,$REGfolder))))))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Path" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Path&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Appilcation: tim.now.filemanager.application | Process: InsertStagingRichieste | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;LocalPath: &amp;quot;,$Path)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
