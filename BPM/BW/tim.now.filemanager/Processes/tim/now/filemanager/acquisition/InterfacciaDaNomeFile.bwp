                    <bpws:targets>
                        <bpws:target linkName="Log2ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryIntrfc&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;tns:IdIntrfc>&lt;xsl:value-of select=&quot;xsd:int($QueryIntrfc/Record[1]/ID_INTRFC)&quot;/>&lt;/tns:IdIntrfc>&lt;tns:IdProcsoFile>&lt;xsl:value-of select=&quot;xsd:int($QueryIntrfc/Record[1]/ID_PROCSO_FILE)&quot;/>&lt;/tns:IdProcsoFile>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Intrfc-input"
                    name="Intrfc" outputVariable="Intrfc"
                    tibex:xpdlId="7bfb14fa-ce86-4ed1-a8c6-2f3c47d37ccc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToIntrfc"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;NGApref&quot;/>&lt;xsl:param name=&quot;ADSLpref&quot;/>&lt;xsl:param name=&quot;N_NPpref&quot;/>&lt;xsl:param name=&quot;R_NPpref&quot;/>&lt;xsl:param name=&quot;SDTpref&quot;/>&lt;xsl:param name=&quot;T3pref&quot;/>&lt;xsl:param name=&quot;InterfacciaCPSInput&quot;/>&lt;xsl:param name=&quot;T3NOWpref&quot;/>&lt;xsl:param name=&quot;T7NOW_pref&quot;/>&lt;xsl:template name=&quot;Intrfc-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Ambito=&amp;quot;SDR&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$NGApref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_SDR_NGA_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$ADSLpref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_SDR_XSDL_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_SDR_REG_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Ambito=&amp;quot;CRMWS&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$NGApref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_CRMWS_NGA_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$ADSLpref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_CRMWS_XSDL_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$N_NPpref) or starts-with($Start/tns:NomeFile,$R_NPpref) or starts-with($Start/tns:NomeFile,$T3pref) or starts-with($Start/tns:NomeFile, $T3NOWpref) or starts-with($Start/tns:NomeFile, $T7NOW_pref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_CRMWS_NP_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$SDTpref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_CRMWS_SDT_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:IntrfcInput=$InterfacciaCPSInput&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_CRMWS_CPS_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_CRMWS_REG_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Ambito=&amp;quot;WSDP&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$NGApref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_WSDPLUS_NGA_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile, $FIBERSTREAMPref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_WSDPLUS_Fiberstream_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_CRMWS_REG_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Ambito=&amp;quot;BAD&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$NGApref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_OLO_BAD_BATCH_NGA&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$ADSLpref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_OLO_BAD_BATCH_XDSL&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile,$N_NPpref) or starts-with($Start/tns:NomeFile,$R_NPpref) or starts-with($Start/tns:NomeFile,$T3pref) or starts-with($Start/tns:NomeFile, $T3NOWpref)  or starts-with($Start/tns:NomeFile, $T7NOW_pref)&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_OLO_BAD_BATCH_NP&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:IntrfcInput=$InterfacciaCPSInput&quot;>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_OLO_BAD_BATCH_REG_CPS&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_OLO_BAD_BATCH_REG&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Interfaccia>&lt;xsl:value-of select=&quot;&amp;quot;FILE_RICH_DBCFX_NP_BATCH&amp;quot;&quot;/>&lt;/tns:Interfaccia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:InterfacciaDaNomeFile="http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="InterfacciaDaNomeFile:Interfaccia" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryIntrfc-input" name="QueryIntrfc"
                    outputVariable="QueryIntrfc"
                    tibex:xpdlId="3b6fc334-cf5a-4404-a64f-523f06426cb8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log1ToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3b6fc334-cf5a-4404-a64f-523f06426cb8+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Intrfc&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:jdbcQueryActivityInput>&#xa;            &lt;Cod_Intrfc>&#xa;                &lt;xsl:value-of select=&quot;$Intrfc&quot;/>&#xa;            &lt;/Cod_Intrfc>&#xa;        &lt;/tns1:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_INTRFC, id_procso_file from intrfc WHERE COD_INTRFC=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Cod_Intrfc"/>
                                    <columnMetadata
                                    columnName="ID_INTRFC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_PROCSO_FILE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="5c84184b-9020-4bd3-808a-5c66f4d81937" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToIntrfc"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Input Interfaccia Da Nome File: &amp;quot;, tib:render-xml($Start,true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
