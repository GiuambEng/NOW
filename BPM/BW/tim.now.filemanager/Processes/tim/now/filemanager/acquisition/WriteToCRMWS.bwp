                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteToSDR_start&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NGAPref&quot;/>&lt;xsl:param name=&quot;ADSLPref&quot;/>&lt;xsl:param name=&quot;N_NPpref&quot;/>&lt;xsl:param name=&quot;R_NPpref&quot;/>&lt;xsl:param name=&quot;FullPathCRMWS&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;WriteFile-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;fileName>&lt;xsl:value-of select=&quot;$FullPathCRMWS&quot;/>&lt;/fileName>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns1:FileName,$NGAPref)&quot;>&lt;textContent>&lt;xsl:value-of select=&quot;concat('&amp;lt;?xml version=&amp;quot;1.0&amp;quot; encoding=&amp;quot;UTF-8&amp;quot;?>&amp;lt;TracciatoOLONGA xmlns=&amp;quot;http://xsd.telecomitalia.it/crm/xdsl/nga&amp;quot;>' ,$Start/tns1:SDRstring,'&amp;lt;/TracciatoOLONGA>')&quot;/>&lt;/textContent>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns1:FileName,$ADSLPref)&quot;>&lt;textContent>&lt;xsl:value-of select=&quot;concat('&amp;lt;?xml version=&amp;quot;1.0&amp;quot; encoding=&amp;quot;UTF-8&amp;quot;?>&amp;lt;TracciatoOLOxDSL xmlns=&amp;quot;http://xsd.telecomitalia.it/crm/xdsl/order&amp;quot;>' ,$Start/tns1:SDRstring,'&amp;lt;/TracciatoOLOxDSL>')&quot;/>&lt;/textContent>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns1:FileName,$N_NPpref)&quot;>&lt;textContent>&lt;xsl:value-of select=&quot;concat('&amp;lt;?xml version=&amp;quot;1.0&amp;quot; encoding=&amp;quot;UTF-8&amp;quot;?>&amp;lt;ComunicazioneNP>' ,$Start/tns1:SDRstring,'&amp;lt;/ComunicazioneNP>')&quot;/>&lt;/textContent>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($Start/tns1:FileName,$R_NPpref)&quot;>&lt;textContent>&lt;xsl:value