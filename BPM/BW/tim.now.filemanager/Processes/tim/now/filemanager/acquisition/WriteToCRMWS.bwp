                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat($Start/tns1:LocalPath, $PathCRMWS, $Start/tns1:FileName)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="FullPathCRMWS"
                    name="CreatePathString"
                    outputVariable="FullPathCRMWS"
                    tibex:xpdlId="1e430ca1-b2e8-4a9f-a02a-a813f911fa77" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
