                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/WriteToSDR_start" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="WriteFile"/&gt;&lt;xsl:param name="RecuperoInterfaccia"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RecuperoInterfaccia/tns2:IdProcsoFile)"&gt;&lt;xsl:if test="$RecuperoInterfaccia/tns2:IdProcsoFile"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$RecuperoInterfaccia/tns2:IdProcsoFile"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="&amp;quot;69&amp;quot;"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Start/tns1:CodiceOlo"/&gt;&lt;/ns:COD_OLO&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$Start/tns1:CodOloAGCOM"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="string(current-date())"/&gt;&lt;/ns:DATA_FILE&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;DA INVIARE&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="&amp;quot;CRMWS&amp;quot;"/&gt;&lt;/ns:ESITO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RecuperoInterfaccia/tns2:IdIntrfc)"&gt;&lt;xsl:if test="$RecuperoInterfaccia/tns2:IdIntrfc"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$RecuperoInterfaccia/tns2:IdIntrfc"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Start/tns1:IDintrfc_input"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Start/tns1:IDtplg_file"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$WriteFile/fileInfo/fileName"/&gt;&lt;/ns:NOME_FILE&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:FileProcessatoOutput&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$WriteFile/fileInfo/size"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;ns:QT_RECD_TOTALI&gt;&lt;xsl:value-of select="$Start/tns1:contatoreRichieste"/&gt;&lt;/ns:QT_RECD_TOTALI&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$WriteFile/fileInfo/fullName"/&gt;&lt;/ns:FullName&gt;&lt;ns:Size&gt;&lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;&lt;/ns:Size&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteToSDR_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoInterfaccia&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoInterfaccia/tns2:IdProcsoFile)&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoInterfaccia/tns2:IdProcsoFile&quot;>&#xa;                            &lt;ns:ID_PROCSO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoInterfaccia/tns2:IdProcsoFile&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_FILE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;69&amp;quot;&quot;/>&#xa;                        &lt;/ns:ID_PROCSO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:COD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOlo&quot;/>&#xa;                &lt;/ns:COD_OLO>&#xa;                &lt;ns:CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:CodOloAGCOM&quot;/>&#xa;                &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;ns:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-date())&quot;/>&#xa;                &lt;/ns:DATA_FILE>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoInterfaccia/tns2:IdIntrfc)&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoInterfaccia/tns2:IdIntrfc&quot;>&#xa;                            &lt;ns:ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoInterfaccia/tns2:IdIntrfc&quot;/>&#xa;                            &lt;/ns:ID_INTRFC>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_INTRFC>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:IDintrfc_input&quot;/>&#xa;                        &lt;/ns:ID_INTRFC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:IDTPLG_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:IDtplg_file&quot;/>&#xa;                &lt;/ns:IDTPLG_FILE>&#xa;                &lt;ns:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$WriteFile/fileInfo/fileName&quot;/>&#xa;                &lt;/ns:NOME_FILE>&#xa;                &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;ns:DIMENSIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$WriteFile/fileInfo/size&quot;/>&#xa;                &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;ns:QT_RECD_TOTALI>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:contatoreRichieste&quot;/>&#xa;                &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;ns:FullName>&#xa;                    &lt;xsl:value-of select=&quot;$WriteFile/fileInfo/fullName&quot;/>&#xa;                &lt;/ns:FullName>&#xa;                &lt;ns:Size>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;                &lt;/ns:Size>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
