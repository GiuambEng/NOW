                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GetNextWorkingDate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;calcNextWorkingDateIn&quot;/>&lt;xsl:param name=&quot;GetSharedVariable&quot;/>&lt;xsl:param name=&quot;GetNextDateFromBPM&quot;/>&lt;xsl:template name=&quot;SetSharedVariable-input&quot; match=&quot;/&quot;>&lt;tns:ArrayByDuration>&lt;xsl:copy-of select=&quot;$GetSharedVariable/tns:GetNextDateByDuration&quot;/>&lt;tns:GetNextDateByDuration>&lt;tns:inputDate>&lt;xsl:value-of select=&quot;$calcNextWorkingDateIn/parameters/tns1:Request/tns1:inputDate&quot;/>&lt;/tns:inputDate>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($calcNextWorkingDateIn/parameters/tns1:Request/tns1:inputDuration)&quot;>&lt;tns:inputDuration>&lt;xsl:value-of select=&quot;$calcNextWorkingDateIn/parameters/tns1:Request/tns1:inputDuration&quot;/>&lt;/tns:inputDuration>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:GiorniLavorativi>&lt;xsl:value-of select=&quot;$calcNextWorkingDateIn/parameters/tns1:Request/tns1:GiorniLavorativi&quot;/>&lt;/tns:GiorniLavorativi>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:OutputDate>&lt;xsl:value-of select=&quot;$GetNextDateFromBPM/parameters/tns1:Response/tns1:outputDate&quot;/>&lt;/tns:OutputDate>&lt;/tns:GetNextDateByDuration>&lt;/tns:ArrayByDuration>&lt;/xsl:template>&lt;/xsl:stylesheet>"
