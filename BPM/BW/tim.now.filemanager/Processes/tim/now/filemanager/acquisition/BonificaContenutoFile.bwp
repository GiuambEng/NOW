                                tibex:group="groupStart" tibex:xpdlId="d4d923d4-671d-4f1c-80a0-c47bb7c49e3e">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToSubContenutoFile"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="ac4d9e74-d5da-4df0-ba22-be31232fe5f7">
                                <bpws:targets>
                                    <bpws:target linkName="SubContenutoFileToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ContenutoFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;SubContenutoFile-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[$index]/ID_FILE)&quot;/>&lt;/tns:ID_FILE>&lt;tns:TransactionID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:TransactionID>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SubContenutoFile-input"
                                    name="SubContenutoFile"
                                    tibex:xpdlId="32647fc6-2e51-4b3f-bdb4-4483b6857cdb"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToSubContenutoFile"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SubContenutoFileToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ContenutoFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;SubContenutoFile-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:ID_FILE>&lt;xsl:value-of select=&quot;xsd:int($JDBCQuery/Record[$index]/ID_FILE)&quot;/>&lt;/tns:ID_FILE>&lt;tns:TransactionID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:TransactionID>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess spawn="true"
                                    subProcessName="tim.now.filemanager.acquisition.SubContenutoFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
