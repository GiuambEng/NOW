diceRifiuto>&lt;/xsl:if>&lt;flagDelibera103>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/flagDelibera103>&lt;xsl:if test=&quot;string-length(string($TimestampNP/Record[1]/TIMSTP_NP))>0&quot;>&lt;xsl:if test=&quot;$TimestampNP/Record[1]/TIMSTP_NP&quot;>&lt;tmpAckNpD103>&lt;xsl:value-of select=&quot;$TimestampNP/Record[1]/TIMSTP_NP&quot;/>&lt;/tmpAckNpD103>&lt;/xsl:if>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
