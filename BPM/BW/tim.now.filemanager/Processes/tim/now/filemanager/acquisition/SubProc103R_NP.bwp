                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: 103R_NP | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('Input SubProc103R_NP',tib:render-xml($Start, true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="50cd9c9d-4826-4ad2-a20f-abdabb09970d">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToWhile"/>
                    <bpws:target linkName="EmptyToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable element="ns4:RichiestaElement" name="RichiestaCasedata"/>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns25:ComunicazioneNP/ns25:Risposta)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns25:ComunicazioneNP/ns25:Risposta)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="NOWcounterToRenderRichiesta" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RenderXmlToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="createProcessInstanceToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToNOWcounter" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToEmpty2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="DROToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RenderRichiestaToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RemoveNSnowToPrimoCasedata" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty1ToRemoveNSnow" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="AssignToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GetNextDateByDurationToLog1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogToGetNextDateByDuration" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Assign1ToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogToRemoveNSnow" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="LogToRemoveNSnow1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogGetNextDateByDurationToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty2ToDRO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="Empty2ToRemoveNSnow_CalcoloDROskip"
                                    tibex:label="Calcolo DRO skip" tibex:linkType="SUCCESSWITHCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="18e8d9e4-1d59-4537-9196-132346c3d83d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty2">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="18774ed4-d48b-4830-8a0c-f48946dc2396">
                                <bpws:targets>
                                    <bpws:target linkName="LogToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="$subContatoreNOW+1"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="subContatoreNOW"
                                    name="NOWcounter"
                                    outputVariable="subContatoreNOW"
                                    tibex:xpdlId="ef9299d4-3ecd-4582-82d9-16b22301b26d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToNOWcounter"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="NOWcounterToRenderRichiesta"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="$subContatoreNOW+1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="subContatoreNOW" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/103R_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;OLO_NORM&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;TransitoryProperty&quot;/>&lt;xsl:param name=&quot;RemoveNSnow&quot;/>&lt;xsl:param name=&quot;TimestampNP&quot;/>&lt;xsl:template name=&quot;RichiestaCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Start/ns1:IDfile&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICADONATINGDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating) and $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='14'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTODONATINGDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTODONORRECIPIENTDONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICACESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$index&quot;/>&lt;/progressivoRichiestaFile>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DirectoryNumber)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns1:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Rispos