                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/103R_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;OLO_NORM&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;TransitoryProperty&quot;/>&lt;xsl:param name=&quot;RemoveNSnow&quot;/>&lt;xsl:param name=&quot;TimestampNP&quot;/>&lt;xsl:template name=&quot;RichiestaCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Start/ns1:IDfile&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICADONATINGDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating) and $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='14'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTODONATINGDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTODONORRECIPIENTDONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICACESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$index&quot;/>&lt;/progressivoRichiestaFile>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DirectoryNumber)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns1:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceProgetto)>0 or string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceProgetto)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceProgetto)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Cessazione/ns1:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Cessazione/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_Cessazione/ns1:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_Cessazione/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;(string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0 or string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0 ) and ($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:TipoComunicazione='8' or  $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Com_Esito_Donor_Recipient/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Com_Esito_Donor_Recipient/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Com_Esito_Donor_Recipient/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='8')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;(exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:Correlazioni/ns1:TotaleRichieste) or exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste) ) and ($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:TipoComunicazione='8' or  $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Tecnica_Donating_Donor/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Com_Esito_Donor_Recipient/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Com_Esito_Donor_Recipient/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Com_Esito_Donor_Recipient/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donor_RecipientDonating/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Espletamento_Donating/ns1:TipoComunicazione='8')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:Correlazioni/ns1:TotaleRichieste)&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;contenutoXML>&lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&lt;/contenutoXML>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(xsd:date($TimestampNP/Record[1]/DATA_FILE),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:EsitoVerifica/ns1:EsitoOK/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:EsitoVerifica/ns1:EsitoOK/ns1:IdentificativoOperatoreDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:EsitoVerifica/ns1:EsitoOK/ns1:IdentificativoOperatoreDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:IdentificativoOperatoreDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:IdentificativoOperatoreDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/node()/ns1:DatiNotifica/ns1:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)]/ns1:Valid_Formale_DonorRecipient/ns1:IdentificativoOperatoreDonor)>0  or string-length($Start/ns1:ComunicazioneNP/ns1:Risposta[number($index)