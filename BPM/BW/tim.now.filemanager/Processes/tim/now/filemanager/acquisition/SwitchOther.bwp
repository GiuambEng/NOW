            <bpws:invoke inputVariable="TracciaOutput-input"
                name="TracciaOutput" operation="Insert"
                outputVariable="TracciaOutput" partnerLink="ProcessLog"
                portType="ns6:ProcessLog" tibex:xpdlId="d1bfa17b-856d-4763-89d5-c864c29e3aed">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.example.org/SwitchOther" xmlns:tns1="http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Ambito"/&gt;&lt;xsl:param name="RenameFile"/&gt;&lt;xsl:param name="RecuperoInterfaccia"/&gt;&lt;xsl:template name="TracciaOutput-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RecuperoInterfaccia/tns1:IdProcsoFile)"&gt;&lt;xsl:if test="$RecuperoInterfaccia/tns1:IdProcsoFile"&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$RecuperoInterfaccia/tns1:IdProcsoFile"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="&amp;quot;69&amp;quot;"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;xsl:if test="$Start/tns2:CodiceISP"&gt;&lt;ns:COD_OLO&gt;&lt;xsl:value-of select="$Start/tns2:CodiceISP"/&gt;&lt;/ns:COD_OLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns2:CodificaOLOagcom"&gt;&lt;ns:CODFC_OLO_AGCOM&gt;&lt;xsl:value-of select="$Start/tns2:CodificaOLOagcom"/&gt;&lt;/ns:CODFC_OLO_AGCOM&gt;&lt;/xsl:if&gt;&lt;ns:DATA_FILE&gt;&lt;xsl:value-of select="string(current-date())"/&gt;&lt;/ns:DATA_FILE&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;DA INVIARE&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="$Ambito"/&gt;&lt;/ns:ESITO&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RecuperoInterfaccia/tns1:IdIntrfc)"&gt;&lt;xsl:if test="$RecuperoInterfaccia/tns1:IdIntrfc"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$RecuperoInterfaccia/tns1:IdIntrfc"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/tns2:IdIntrfc"&gt;&lt;ns:ID_INTRFC&gt;&lt;xsl:value-of select="$Start/tns2:IdIntrfc"/&gt;&lt;/ns:ID_INTRFC&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/tns2:IdTiplgFile"&gt;&lt;ns:IDTPLG_FILE&gt;&lt;xsl:value-of select="$Start/tns2:IdTiplgFile"/&gt;&lt;/ns:IDTPLG_FILE&gt;&lt;/xsl:if&gt;&lt;ns:NOME_FILE&gt;&lt;xsl:value-of select="$RenameFile/fileInfo/fileName"/&gt;&lt;/ns:NOME_FILE&gt;&lt;ns:TIMSTP_APERTURA_FILE&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TIMSTP_APERTURA_FILE&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;ns:VERSO_DEL_FILE&gt;&lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;&lt;/ns:VERSO_DEL_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:FileProcessatoOutput&gt;&lt;ns:DIMENSIONE_FILE&gt;&lt;xsl:value-of select="$RenameFile/fileInfo/size"/&gt;&lt;/ns:DIMENSIONE_FILE&gt;&lt;ns:TIMSTP_CREZIONE_FILE&gt;&lt;xsl:value-of select="string(current-dateTime())"/&gt;&lt;/ns:TIMSTP_CREZIONE_FILE&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;ns:ContenutoFile&gt;&lt;ns:FullName&gt;&lt;xsl:value-of select="$RenameFile/fileInfo/fullName"/&gt;&lt;/ns:FullName&gt;&lt;ns:Size&gt;&lt;xsl:value-of select="xsd:int($RenameFile/fileInfo/size)"/&gt;&lt;/ns:Size&gt;&lt;/ns:ContenutoFile&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/SwitchOther&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InterfacciaDaNomeFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Ambito&quot;/>&#xa;    &lt;xsl:param name=&quot;RenameFile&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoInterfaccia&quot;/>&#xa;    &lt;xsl:template name=&quot;TracciaOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoInterfaccia/tns1:IdProcsoFile)&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoInterfaccia/tns1:IdProcsoFile&quot;>&#xa;                            &lt;ns:ID_PROCSO_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoInterfaccia/tns1:IdProcsoFile&quot;/>&#xa;                            &lt;/ns:ID_PROCSO_FILE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ID_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;69&amp;quot;&quot;/>&#xa;                        &lt;/ns:ID_PROCSO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:CodiceISP&quot;>&#xa;                    &lt;ns:COD_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:CodiceISP&quot;/>&#xa;                    &lt;/ns:COD_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:CodificaOLOagcom&quot;>&#xa;                    &lt;ns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:CodificaOLOagcom&quot;/>&#xa;                    &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-date())&quot;/>&#xa;                &lt;/ns:DATA_FILE>&#xa;                &lt;ns:DESCR_STATO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns:DESCR_STATO_FILE>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;$Ambito&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperoInterfaccia/tns1:IdIntrfc)&quot;>&#xa;                        &lt;xsl:if test=&quot;$RecuperoInterfaccia/tns1:IdIntrfc&quot;>&#xa;                            &lt;ns:ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperoInterfaccia/tns1:IdIntrfc&quot;/>&#xa;                            &lt;/ns:ID_INTRFC>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/tns2:IdIntrfc&quot;>&#xa;                            &lt;ns:ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns2:IdIntrfc&quot;/>&#xa;                            &lt;/ns:ID_INTRFC>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:IdTiplgFile&quot;>&#xa;                    &lt;ns:IDTPLG_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:IdTiplgFile&quot;/>&#xa;                    &lt;/ns:IDTPLG_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:NOME_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/fileName&quot;/>&#xa;                &lt;/ns:NOME_FILE>&#xa;                &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;ns:DIMENSIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/size&quot;/>&#xa;                &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;ns:FullName>&#xa;                    &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/fullName&quot;/>&#xa;                &lt;/ns:FullName>&#xa;                &lt;ns:Size>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($RenameFile/fileInfo/size)&quot;/>&#xa;                &lt;/ns:Size>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
