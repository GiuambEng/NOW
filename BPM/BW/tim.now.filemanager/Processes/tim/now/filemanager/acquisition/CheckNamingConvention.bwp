            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/GPONPref" type="xsd:string"/>
        <bpws:variable element="ns:OptionalErrorReport"
            name="_errorOptional" sca-bpel:internal="true"/>
        <bpws:variable name="NPNGSuff" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/NPNGSuff" type="xsd:string"/>
        <bpws:variable name="FWAPref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/FWAPref" type="xsd:string"/>
        <bpws:variable name="Del103N_NP_pref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/Del103N_NP_pref" type="xsd:string"/>
        <bpws:variable name="Del103R_NP_pref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/Del103R_NP_pref" type="xsd:string"/>
        <bpws:variable name="FIBERSTREAMPref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/FIBERSTREAMPref" type="xsd:string"/>
        <bpws:variable name="NEWGPONPref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/NEWGPONPref" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="StartToEnd1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Assign1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="RegolatorioToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="DataToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="DateToAssign" tibex:linkType="ERROR"/>
                <bpws:link name="DateErrorToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToDateError" tibex:linkType="ERROR"/>
                <bpws:link name="StartToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="NPToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToDateError1" tibex:linkType="ERROR"/>
                <bpws:link name="AssignToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToAssign1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="GPONToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="ParseDataGPONToDateError" tibex:linkType="ERROR"/>
                <bpws:link name="ParseDataGPONToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToAssign2" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="AssignToAssign1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToDateError" tibex:linkType="ERROR"/>
                <bpws:link name="Assign1ToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToAssign3" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="AssignToAssign11" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToDateError1" tibex:linkType="ERROR"/>
                <bpws:link name="Assign1ToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToAssign4" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Del103NPToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="DataDel103NPToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="DataDel103NPToDateError" tibex:linkType="ERROR"/>
                <bpws:link name="StartToFIBERSTREAM" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="FIBERSTREAMToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="DataFIBERSTREAMToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="DataFIBERSTREAMToDateError" tibex:linkType="ERROR"/>
                <bpws:link name="StartToNEWGPON" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="NEWGPONToParseDataGPON" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="79a3546c-4827-492b-b8bb-0445486d2519"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToEnd1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start,$NGAPref) or starts-with($Start,$ADSLPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start,$NGAPref) or starts-with($Start,$ADSLPref)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start,$N_NP_pref) or starts-with($Start,$R_NP_pref) or starts-with($Start,$T3_pref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start,$N_NP_pref) or starts-with($Start,$R_NP_pref) or starts-with($Start,$T3_pref)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start,$GPONPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[starts-with($Start,$GPONPref)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="contains($Start,$NPNGSuff)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[contains($Start,$NPNGSuff)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign3">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start,$FWAPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start,$FWAPref)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToAssign4">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start,$Del103N_NP_pref) or starts-with($Start,$Del103R_NP_pref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start,$Del103N_NP_pref) or starts-with($Start,$Del103R_NP_pref)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToFIBERSTREAM">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start,$FIBERSTREAMPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[starts-with($Start,$FIBERSTREAMPref)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToNEWGPON">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start,$NEWGPONPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[starts-with($Start,$NEWGPONPref)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="0b3772ae-da27-4ac4-8a2b-4f97b61b938e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CheckNamingOutput&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Check&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Check>&#xa;            &lt;xsl:value-of select=&quot;$Check&quot;/>&#xa;        &lt;/tns1:Check>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Check"
                    name="Regolatorio" outputVariable="Check"
                    tibex:xpdlId="df3be8ee-5ce6-4389-8661-8efcf6299a00" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RegolatorioToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(matches($Start,'[a-zA-Z0-9]{3}[0-9]{10}.xml') or (if(starts-with($Start,$N_pref)) then matches(substring-after($Start,$N_pref),'[a-zA-Z0-9]{3}_[0-9]{8}_[0-9]*.xml') else false()) or (if(starts-with($Start,$R_pref)) then matches(substring-after($Start,$R_pref),'[a-zA-Z0-9]{3}_[0-9]{8}_[0-9]*.xml') else false())) then('OK')else('KO')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Check" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Check"
                    name="Dati" outputVariable="Check"
                    tibex:xpdlId="447f3270-a1a6-4a62-8984-6074176e714e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(if(starts-with($Start,$NGAPref))then(matches(substring-after($Start,$NGAPref),'[0-9]{3}_[0-9]{8}_[0-9]*.xml'))else(if(starts-with($Start,$ADSLPref))then(matches(substring-after($Start,$ADSLPref),'[0-9]{3}_[0-9]{8}_[0-9]*.xml'))else(false())))then('OK')else('KO')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Check" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-input"
                    name="Log"
                    tibex:xpdlId="aeba8975-5bf0-4883-91f9-e7b841738dab" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DateErrorToLog"/>
                        <bpws:target linkName="AssignToLog1"/>
                        <bpws:target linkName="DataToLog"/>
                        <bpws:target linkName="AssignToLog"/>
                        <bpws:target linkName="ParseDataGPONToLog"/>
                        <bpws:target linkName="Assign1ToLog"/>
                        <bpws:target linkName="Assign1ToLog1"/>
                        <bpws:target linkName="DataDel103NPToLog"/>
                        <bpws:target linkName="DataFIBERSTREAMToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Check&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: TimerSchedulerFileInput - CreateFileTappo | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Check='OK'&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;'Naming convention rispettata'&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;'Naming convention non rispettata: cambiare il nome del file.'&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Date"
                    name="Data" outputVariable="Date"
                    tibex:xpdlId="fcdda916-6f6c-4e7a-b749-28eb251f9720" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RegolatorioToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DataToLog"/>
                        <bpws:source linkName="DateToAssign"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Date&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;N_pref&quot;/>&lt;xsl:param name=&quot;R_pref&quot;/>&lt;xsl:template name=&quot;Date&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start,$N_pref) or starts-with($Start,$R_pref)&quot;>&lt;tns:Date>&lt;xsl:value-of select=&quot;tib:parse-date('yyyyMMdd',substring($Start,5+string-length($N_pref),8))&quot;/>&lt;/tns:Date>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Date>&lt;xsl:value-of select=&quot;tib:parse-date('yyyyMMdd',substring($Start,4,8))&quot;/>&lt;/tns:Date>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Date" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Check"
                    name="DateError" outputVariable="Check"
                    tibex:xpdlId="772a2468-990a-49b8-b34c-70bb2380cd87" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DateToAssign"/>
                        <bpws:target linkName="AssignToDateError"/>
                        <bpws:target linkName="AssignToDateError1"/>
                        <bpws:target linkName="ParseDataGPONToDateError"/>
                        <bpws:target linkName="Assign1ToDateError"/>
                        <bpws:target linkName="Assign1ToDateError1"/>
                        <bpws:target linkName="DataDel103NPToDateError"/>
                        <bpws:target linkName="DataFIBERSTREAMToDateError"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DateErrorToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="'KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
