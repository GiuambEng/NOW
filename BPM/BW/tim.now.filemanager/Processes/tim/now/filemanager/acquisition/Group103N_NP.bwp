ient/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:DataAttesaConsegnaRimodulata>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:DataAttesaConsegnaRimodulata&quot;/>&lt;/tns:DataAttesaConsegnaRimodulata>&lt;xsl:if test=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:CodiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:CodiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:Correlazioni&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:Correlazioni/ns:IdentificativoCorrelazioni&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:Correlazioni/ns:TotaleRichieste&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:for-each>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;/tns:Rimodulazione_DAC_Recipient>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Richiesta>&lt;/tns:ComunicazioneNP>&lt;/tns:RichiesteALT>&lt;/xsl:if>&lt;xsl:if test=&quot;$RTYPE='ATT'&quot;>&lt;tns:ProgressiviATT>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:ProgressiviATT>&lt;/xsl:if>&lt;xsl:if test=&quot;$RTYPE='ATTANN'&quot;>&lt;tns:ProgressiviATT_ANN>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:ProgressiviATT_ANN>&lt;/xsl:if>&lt;xsl:if test=&quot;$RTYPE='ALT'&quot;>&lt;tns:ProgressiviALT>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/tns:ProgressiviALT>&lt;/xsl:if>&lt;/tns:Richieste>&lt;/xsl:for-each>&lt;/tns:RichiesteOLOSuddivise>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperRaggruppamento-input"
                    name="MapperRaggruppamento"
                    outputVariable="MapperRaggruppamento"
                    tibex:xpdlId="89aaa17f-ca64-4a2a-b940-8c55279bc105" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InizializzaToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToAssignAttAnn">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($MapperRaggruppamento/ns6:Richieste/ns6:RichiesteATT_ANN/ns6:ComunicazioneNP/ns6:Richiesta)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($MapperRaggruppamento/ns6:Richieste/ns6:RichiesteATT_ANN/ns6:ComunicazioneNP/ns6:Richiesta)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MapperToEmpty2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/Richieste103NPxBPM&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapperRaggruppamento-input&quot; match=&quot;/&quot;>&lt;tns:RichiesteOLOSuddivise>&lt;xsl:for-each select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta&quot;>&lt;xsl:variable name=&quot;rich&quot; select=&quot;current()&quot;/>&lt;xsl:variable name=&quot;RTYPE&quot; select=&quot;if(exists(ns:Portin) or exists(ns:Prenotifica_Donating)) then &amp;#xD;&amp;#xA;&amp;#x9;if (exists(../ns:Richiesta/ns:Annullamento[ns:CodiceOrdine = $rich/ns:Portin/ns:CodiceOrdine or ns:CodiceOrdine = $rich/ns:Prenotifica_Donating/ns:CodiceOrdine])) then &amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATTANN' &amp;#xD;&amp;#xA;&amp;#x9;else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(ns:Annullamento)) then &amp;#xD;&amp;#xA;&amp;#x9;if (exists(../ns:Richiesta/ns:Portin[ns:CodiceOrdine = $rich/ns:Annullamento/ns:CodiceOrdine]) or exists(../ns:Richiesta/ns:Prenotifica_Donating[ns:CodiceOrdine = $rich/ns:Annullamento/ns:CodiceOrdine])) then &amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATTANN' &amp;#xD;&amp;#xA;&amp;#x9;else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;'ALT'&quot;/>&lt;tns:Richieste>&lt;xsl:if test=&quot;$RTYPE='ATT'&quot;>&lt;tns:RichiesteATT>&lt;tns:ComunicazioneNP>&lt;tns:Richiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:Portin)&quot;>&lt;tns:Portin>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:TipoComunicazione&quot;/>&lt;/tns:TipoComunicazione>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:CodiceOrdine&quot;/>&lt;/tns:CodiceOrdine>&lt;tns:DataOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:DataOrdine&quot;/>&lt;/tns:DataOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:TipoLinea&quot;/>&lt;/tns:TipoLinea>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;xsl:if test=&quot;$rich/ns:Portin/ns:NomeCliente&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:NomeCliente&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:CognomeCliente_RagioneSociale&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;xsl:for-each select=&quot;$rich/ns:Portin/ns:Correlazioni&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:Correlazioni/ns:IdentificativoCorrelazioni&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:Correlazioni/ns:TotaleRichieste&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:for-each>&lt;tns:CodiceOpRecipient>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:CodiceOpRecipient&quot;/>&lt;/tns:CodiceOpRecipient>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:DataAttesaConsegnaServizio&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;xsl:if test=&quot;$rich/ns:Portin/ns:CodiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:CodiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;tns:CodiceSegreto>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:CodiceSegreto&quot;/>&lt;/tns:CodiceSegreto>&lt;tns:RoutingNumber>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:RoutingNumber&quot;/>&lt;/tns:RoutingNumber>&lt;/tns:Portin>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(ns:Prenotifica_Donating)&quot;>&lt;tns:Prenotifica_Donating>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:TipoComunicazione&quot;/>&lt;/tns:TipoComunicazione>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:CodiceOrdine&quot;/>&lt;/tns:CodiceOrdine>&lt;tns:DataOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:DataOrdine&quot;/>&lt;/tns:DataOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:TipoLinea&quot;/>&lt;/tns:TipoLinea>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;tns:IdentificativoOperatoreDonor>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:IdentificativoOperatoreDonor&quot;/>&lt;/tns:IdentificativoOperatoreDonor>&lt;xsl:if test=&quot;$rich/ns:Prenotifica_Donating/ns:NomeCliente&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:NomeCliente&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:CognomeCliente_RagioneSociale&quot;/>&lt;/tns:CognomeCliente_RagioneSociale>&lt;xsl:for-each select=&quot;$rich/ns:Prenotifica_Donating/ns:Correlazioni&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:Correlazioni/ns:IdentificativoCorrelazioni&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:Correlazioni/ns:TotaleRichieste&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:for-each>&lt;tns:CodiceOpRecipient>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:CodiceOpRecipient&quot;/>&lt;/tns:CodiceOpRecipient>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:DataAttesaConsegnaServizio&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;xsl:if test=&quot;$rich/ns:Prenotifica_Donating/ns:CodiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:CodiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;tns:CodiceSegreto>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:CodiceSegreto&quot;/>&lt;/tns:CodiceSegreto>&lt;tns:IdentificativoOperatoreDonating>&lt;xsl:value-of select=&quot;$rich/ns:Prenotifica_Donating/ns:IdentificativoOperatoreDonating&quot;/>&lt;/tns:IdentificativoOperatoreDonating>&lt;/tns:Prenotifica_Donating>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(ns:Cessazione)&quot;>&lt;tns:Cessazione>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;$rich/ns:Cessazione/ns:TipoComunicazione&quot;/>&lt;/tns:TipoComunicazione>&lt;tns:DataOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Cessazione/ns:DataOrdine&quot;/>&lt;/tns:DataOrdine>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Cessazione/ns:CodiceOrdine&quot;/>&lt;/tns:CodiceOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$rich/ns:Cessazione/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Cessazione/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;/tns:Cessazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(ns:Annullamento)&quot;>&lt;tns:Annullamento>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:TipoComunicazione&quot;/>&lt;/tns:TipoComunicazione>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:CodiceOrdine&quot;/>&lt;/tns:CodiceOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;xsl:for-each select=&quot;$rich/ns:Annullamento/ns:Correlazioni&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:Correlazioni/ns:IdentificativoCorrelazioni&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:Correlazioni/ns:TotaleRichieste&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:for-each>&lt;tns:CodiceOpRecipient>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:CodiceOpRecipient&quot;/>&lt;/tns:CodiceOpRecipient>&lt;xsl:if test=&quot;$rich/ns:Annullamento/ns:CodiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;$rich/ns:Annullamento/ns:CodiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;/tns:Annullamento>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(ns:Rimodulazione_DAC)&quot;>&lt;tns:Rimodulazione_DAC>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:TipoComunicazione&quot;/>&lt;/tns:TipoComunicazione>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:CodiceOrdine&quot;/>&lt;/tns:CodiceOrdine>&lt;tns:DataOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:DataOrdine&quot;/>&lt;/tns:DataOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:TipoLinea&quot;/>&lt;/tns:TipoLinea>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;tns:CodiceOpRecipient>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:CodiceOpRecipient&quot;/>&lt;/tns:CodiceOpRecipient>&lt;tns:DataAttesaConsegnaServizio>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:DataAttesaConsegnaServizio&quot;/>&lt;/tns:DataAttesaConsegnaServizio>&lt;xsl:if test=&quot;$rich/ns:Rimodulazione_DAC/ns:CodiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:CodiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;tns:DataAttesaConsegnaRimodulata>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:DataAttesaConsegnaRimodulata&quot;/>&lt;/tns:DataAttesaConsegnaRimodulata>&lt;xsl:for-each select=&quot;$rich/ns:Rimodulazione_DAC/ns:Correlazioni&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:Correlazioni/ns:IdentificativoCorrelazioni&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC/ns:Correlazioni/ns:TotaleRichieste&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:for-each>&lt;/tns:Rimodulazione_DAC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Rimodulazione_DAC_Recipient>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:TipoComunicazione&quot;/>&lt;/tns:TipoComunicazione>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:CodiceOrdine&quot;/>&lt;/tns:CodiceOrdine>&lt;tns:CodiceOpRecipient>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:CodiceOpRecipient&quot;/>&lt;/tns:CodiceOpRecipient>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:DataAttesaConsegnaRimodulata>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:DataAttesaConsegnaRimodulata&quot;/>&lt;/tns:DataAttesaConsegnaRimodulata>&lt;xsl:if test=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:CodiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:CodiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:Correlazioni&quot;>&lt;tns:Correlazioni>&lt;tns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:Correlazioni/ns:IdentificativoCorrelazioni&quot;/>&lt;/tns:IdentificativoCorrelazioni>&lt;tns:TotaleRichieste>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:Correlazioni/ns:TotaleRichieste&quot;/>&lt;/tns:TotaleRichieste>&lt;/tns:Correlazioni>&lt;/xsl:for-each>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Rimodulazione_DAC_Recipient/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;/tns:Rimodulazione_DAC_Recipient>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Richiesta>&lt;/tns:ComunicazioneNP>&lt;/tns:RichiesteATT>&lt;/xsl:if>&lt;xsl:if test=&quot;$RTYPE='ATTANN'&quot;>&lt;tns:RichiesteATT_ANN>&lt;tns:ComunicazioneNP>&lt;tns:Richiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(ns:Portin)&quot;>&lt;tns:Portin>&lt;tns:TipoComunicazione>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:TipoComunicazione&quot;/>&lt;/tns:TipoComunicazione>&lt;tns:CodiceOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:CodiceOrdine&quot;/>&lt;/tns:CodiceOrdine>&lt;tns:DataOrdine>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:DataOrdine&quot;/>&lt;/tns:DataOrdine>&lt;tns:DirectoryNumber>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:DirectoryNumber&quot;/>&lt;/tns:DirectoryNumber>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:TipoLinea&quot;/>&lt;/tns:TipoLinea>&lt;tns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:DataInvioMessaggio&quot;/>&lt;/tns:DataInvioMessaggio>&lt;xsl:if test=&quot;$rich/ns:Portin/ns:NomeCliente&quot;>&lt;tns:NomeCliente>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:NomeCliente&quot;/>&lt;/tns:NomeCliente>&lt;/xsl:if>&lt;tns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$rich/ns:Portin/ns:Cogno