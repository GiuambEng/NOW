                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:ns1=&quot;http://www.example.org/Richieste103NPxBPM&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AltreLavorazioni&quot;/>&lt;xsl:param name=&quot;MapperRaggruppamento&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;OtherReq-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:IDfile>&lt;xsl:value-of select=&quot;$Start/ns:IDfile&quot;/>&lt;/ns:IDfile>&lt;ns:CodOloAgcomIntrfc>&lt;xsl:value-of select=&quot;$Start/ns:CodOloAgcomIntrfc&quot;/>&lt;/ns:CodOloAgcomIntrfc>&lt;ns:ComunicazioneNP>&lt;xsl:for-each select=&quot;$AltreLavorazioni/Richiesta&quot;>&lt;ns:Richiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Portin)&quot;>&lt;ns:Portin>&lt;ns:TipoComunicazione>&lt;xsl:value-of select=&quot;Portin/TipoComunicazione&quot;/>&lt;/ns:TipoComunicazione>&lt;ns:CodiceOrdine>&lt;xsl:value-of select=&quot;Portin/CodiceOrdine&quot;/>&lt;/ns:CodiceOrdine>&lt;ns:DataOrdine>&lt;xsl:value-of select=&quot;Portin/DataOrdine&quot;/>&lt;/ns:DataOrdine>&lt;ns:DirectoryNumber>&lt;xsl:value-of select=&quot;Portin/DirectoryNumber&quot;/>&lt;/ns:DirectoryNumber>&lt;ns:TipoLinea>&lt;xsl:value-of select=&quot;Portin/TipoLinea&quot;/>&lt;/ns:TipoLinea>&lt;ns:DataInvioMessaggio>&lt;xsl:value-of select=&quot;Portin/DataInvioMessaggio&quot;/>&lt;/ns:DataInvioMessaggio>&lt;xsl:if test=&quot;Portin/NomeCliente&quot;>&lt;ns:NomeCliente>&lt;xsl:value-of select=&quot;Portin/NomeCliente&quot;/>&lt;/ns:NomeCliente>&lt;/xsl:if>&lt;ns:CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;Portin/CognomeCliente_RagioneSociale&quot;/>&lt;/ns:CognomeCliente_RagioneSociale>&lt;xsl:for-each select=&quot;Portin/Correlazioni&quot;>&lt;ns:Correlazioni>&lt;ns:IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;Identific