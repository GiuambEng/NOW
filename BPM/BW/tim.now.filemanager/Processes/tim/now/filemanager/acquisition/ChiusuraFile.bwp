                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE ESEC_PROCSO_FILE&#xa;  SET STATO_ESEC = 'CHIUSO'&#xa;  WHERE ID_ESEC_PROCSO_FILE=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO_FILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
