                            name="ID_FILE" nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="LOG_LEVEL" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="LOG_MESSAGE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="TIMSTP_INSMTO" nillable="true" type="dateTime"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
