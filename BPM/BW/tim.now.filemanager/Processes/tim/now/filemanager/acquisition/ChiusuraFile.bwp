                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RenameFileToJDBCUpdate"/>
                        <bpws:source linkName="RenameFileToLog"
                            tibex:faultDetailsVar="RenameFile" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns=&quot;http://www.example.org/ChiusuraFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;PathNOW&quot;/>&#xa;    &lt;xsl:template name=&quot;RenameFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:RenameActivityConfig>&#xa;            &lt;fromFileName>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:FileFullName&quot;/>&#xa;            &lt;/fromFileName>&#xa;            &lt;toFileName>&#xa;                &lt;xsl:value-of select=&quot;concat($Start/tns:LocalPath,$PathNOW,$Start/tns:FileName)&quot;/>&#xa;            &lt;/toFileName>&#xa;        &lt;/tns3:RenameActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.file.rename"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value
                                    createDestinationDirectories="true"
                                    overwrite="true" xsi:type="file:RenameFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateFileProcsto-input"
                    name="UpdateFileProcsto"
                    outputVariable="UpdateFileProcsto"
                    tibex:xpdlId="e6bbd073-4cd9-4e56-99d4-abe12b04f492" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RenameFileToJDBCUpdate"/>
                        <bpws:target linkName="LogErrorRenameToUpdateFileProcsto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateFileProcstoToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e6bbd073-4cd9-4e56-99d4-abe12b04f492+input&quot; xmlns:tns=&quot;http://www.example.org/ChiusuraFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateFileProcsto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;TIMSTP_CHIUSURA_FILE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_CHIUSURA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Start/tns:FileName,'_NPNG')&quot;>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;concat(substring-before($Start/tns:FileName, &amp;quot;_NPNG.xml&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:FileName&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IDfile&quot;/>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO&#xa;  SET DESCR_STATO_FILE ='CHIUSO', TIMSTP_CHIUSURA_FILE = ?&#xa;  WHERE NOME_FILE = ? AND ID_FILE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_CHIUSURA_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="EndLog-input"
                    name="EndLog"
                    tibex:xpdlId="0a062221-e871-4012-8bdd-74ab58adb9d1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateFileProcstoToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EndLogToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns=&quot;http://www.example.org/ChiusuraFile&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;EndLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;File &amp;quot;,$Start/tns:FileName,&amp;quot; avente ID_FILE = &amp;quot;,string($Start/tns:IDfile),&amp;quot; processato con esito: &amp;quot;, $Start/tns:Esito, &amp;quot;&amp;#xA;Numero contatore OK: &amp;quot;, string($Start/tns:Contatori/tns2:ContatoreNOW), &amp;quot;&amp;#xA;Numero contatore KO: &amp;quot;, string($Start/tns:Contatori/tns2:ContatoreKO), &amp;quot;&amp;#xA;Numero contatore CRMWS: &amp;quot;, string($Start/tns:Contatori/tns2:ContatoreCRMWS), &amp;quot;&amp;#xA;Numero contatore SDR: &amp;quot;, string($Start/tns:Contatori/tns2:ContatoreSDR), &amp;quot;&amp;#xA;Numero righe totali: &amp;quot;, string($Start/tns:ContatoreRichieste))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns3:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateFileProcstoInput-input"
                    name="UpdateFileProcstoInput"
                    outputVariable="UpdateFileProcstoInput"
                    tibex:xpdlId="67bbad82-80f3-4224-a365-c3015d6b2afa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EndLogToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateFileProcstoInputToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+67bbad82-80f3-4224-a365-c3015d6b2afa+input&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns=&quot;http://www.example.org/ChiusuraFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;QT_RECD_NOW>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:Contatori/tns2:ContatoreNOW&quot;/>&#xa;            &lt;/QT_RECD_NOW>&#xa;            &lt;QT_RECD_TOTALI>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:ContatoreRichieste&quot;/>&#xa;            &lt;/QT_RECD_TOTALI>&#xa;            &lt;ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IDfile&quot;/>&#xa;            &lt;/ID_FILE_PROCSTO_INPUT>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO_INPUT &#xa;SET QT_RECD_NOW=?, QT_RECD_TOTALI=?&#xa;WHERE ID_FILE_PROCSTO_INPUT=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_NOW"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_TOTALI"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="InsertLogFileProcessato-input"
                    name="InsertLogFileProcessato"
                    outputVariable="InsertLogFileProcessato"
                    tibex:xpdlId="e6bb6f0e-78fc-4e19-a628-c59601da90fd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateFileProcstoInputToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.example.org/ChiusuraFile&quot; xmlns:ns0=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e6bb6f0e-78fc-4e19-a628-c59601da90fd+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:jdbcUpdateActivityInput>&#xa;            &lt;COD_PROCSO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ALIMENTATORE_NOW&amp;quot;&quot;/>&#xa;            &lt;/COD_PROCSO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns:IdEsecProcsoFile)&quot;>&#xa;                    &lt;ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdEsecProcsoFile&quot;/>&#xa;                    &lt;/ID_ESEC_PROCSO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ESEC_PROCSO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IDfile&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;LOG_LEVEL>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;            &lt;/LOG_LEVEL>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Esito = &amp;quot;NON IN AMBITO&amp;quot;&quot;>&#xa;                    &lt;LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;File inviato CRMWS.&amp;quot;&quot;/>&#xa;                    &lt;/LOG_MESSAGE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Esito = &amp;quot;BAD&amp;quot;&quot;>&#xa;                    &lt;LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;File scartato per esito BAD.&amp;quot;&quot;/>&#xa;                    &lt;/LOG_MESSAGE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:Esito = &amp;quot;DUPLICATO&amp;quot;&quot;>&#xa;                    &lt;LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;File scartato per esito DUPLICATO.&amp;quot;&quot;/>&#xa;                    &lt;/LOG_MESSAGE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;File analizzato.&amp;quot;&quot;/>&#xa;                    &lt;/LOG_MESSAGE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_INSMTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO>&#xa;        &lt;/ns0:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO LOG_FILE_PROCSTO(COD_PROCSO, ID_ESEC_PROCSO, ID_FILE, LOG_LEVEL, LOG_MESSAGE, TIMSTP_INSMTO)&#xa;VALUES(?, ?, ?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_PROCSO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LOG_LEVEL"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LOG_MESSAGE"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateEsecProcsoFile-input"
                    name="UpdateEsecProcsoFile"
                    outputVariable="UpdateEsecProcsoFile"
                    tibex:xpdlId="f01b52c0-3b7d-4050-aa29-2e8263e9dbb5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToEnd1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UpdateEsecProcsoFileToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Contatori/tns:StringaCRMWS)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns0:Contatori/tns:StringaCRMWS)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UpdateEsecProcsoFileToCallProcess1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Contatori/tns:StringaDBCFX)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns0:Contatori/tns:StringaDBCFX)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UpdateEsecProcsoFileToCallProcess2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Contatori/tns:StringaSDR)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length($Start/ns0:Contatori/tns:StringaSDR)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="UpdateEsecProcsoFileToWriteToWSDP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:Contatori/tns:StringaWSDP)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:Contatori/tns:StringaWSDP)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f01b52c0-3b7d-4050-aa29-2e8263e9dbb5+input&quot; xmlns:tns=&quot;http://www.example.org/ChiusuraFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:IdEsecProcsoFile&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
