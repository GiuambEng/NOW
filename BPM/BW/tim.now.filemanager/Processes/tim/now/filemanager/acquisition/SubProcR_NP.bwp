                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/R_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;OLO_NORM&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;TransitoryProperty&quot;/>&lt;xsl:param name=&quot;RemoveNSnow&quot;/>&lt;xsl:param name=&quot;CompareDate&quot;/>&lt;xsl:param name=&quot;Data&quot;/>&lt;xsl:param name=&quot;DRO&quot;/>&lt;xsl:template name=&quot;RichiestaCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;xsl:variable name=&quot;RoutingNumber&quot; select=&quot;substring-after(substring-before($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:Note,'|'),'RN=') &quot;/>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Start/ns2:IDfile&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VALIDFORMALEDONATINGDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICADONATINGDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTODONORRECIPIENTDONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAC&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICACESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$index&quot;/>&lt;/progressivoRichiestaFile>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns2:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:DatiNotifica/ns2:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:DatiNotifica/ns2:CodiceOrdine&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:DatiNotifica/ns2:CodiceOrdine&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:CodiceProgetto)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Correlazioni/ns2:IdentificativoCorrelazioni)>0 and ($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_DonorRecipient/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_DonorRecipient/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_DonorRecipient/ns2:TipoComunicazione='8' or  $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor/ns2:TipoComunicazione='3'or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Com_Esito_Donor_Recipient/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Com_Esito_Donor_Recipient/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Com_Esito_Donor_Recipient/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Cessazione/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Cessazione/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Cessazione/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Cessazione/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Cessazione/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Cessazione/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:TipoComunicazione='8')&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Correlazioni/ns2:IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Correlazioni/ns2:IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Correlazioni/ns2:TotaleRichieste) and ($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_DonorRecipient/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_DonorRecipient/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_DonorRecipient/ns2:TipoComunicazione='8' or  $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor/ns2:TipoComunicazione='3'or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Com_Esito_Donor_Recipient/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Com_Esito_Donor_Recipient/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Com_Esito_Donor_Recipient/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Cessazione/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Cessazione/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Cessazione/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Cessazione/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Cessazione/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Cessazione/ns2:TipoComunicazione='8' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:TipoComunicazione='1' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:TipoComunicazione='3' or $Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:TipoComunicazione='8')&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;xsd:int($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Correlazioni/ns2:TotaleRichieste)&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:if>&lt;contenutoXML>&lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&lt;/contenutoXML>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Note)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:Note)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:Note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:Note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CompareDate='OK'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[$index]/*/ns2:DatiNotifica/ns2:DataOrdine)&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[$index]/*/ns2:DatiNotifica/ns2:DataOrdine  ,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[$index]/*/ns2:DataOrdine   ,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($DRO/parameters/tns:Response/tns:outputDate) and (string-length($Start/ns2:FlagOscuramento)>0 or $CompareDate='KO'  or $Data='KO')&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DRO/parameters/tns:Response/tns:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1]&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1]&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])>0&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])]/tns1:CodiceOLO&amp;#xD;&amp;#xA;&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])]/tns1:CodiceOLO&amp;#xD;&amp;#xA;&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber)>0&quot;>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DirectoryNumber&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DirectoryNumber&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DataAttesaConsegnaRimodulata)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DataAttesaConsegnaRimodulata,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:Telecom/ns2:Rientro/ns2:DataAttesaConsegnaServizio)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:Telecom/ns2:Rientro/ns2:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:when>&lt;/xsl:choose>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/ns2:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOMRic>&lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/node()/ns2:EsitoVerificaRichiesta&quot;>&lt;esito>&lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/node()/ns2:EsitoVerificaRichiesta&quot;/>&lt;/esito>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:DataEspletamentoOrdine)&quot;>&lt;dataEspletamentoDONOR>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:DataEspletamentoOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataEspletamentoDONOR>&lt;/xsl:if>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&lt;/tipoComunicazioneNP>&lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&lt;transactionIDLocator>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&lt;/transactionIDLocator>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoKO/ns2:CodiceMotivoRifiuto))>0&quot;>&lt;codiceRifiuto>&lt;xsl:value-of select=&quot;string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoKO/ns2:CodiceMotivoRifiuto)&quot;/>&lt;/codiceRifiuto>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($RoutingNumber)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RoutingNumber)>18&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;substring($RoutingNumber,1,18)&quot;/>&lt;/routingNumber>&lt;/xsl:when>&lt;xsl:otherwise>&lt;routingNumber>&lt;xsl:value-of select=&quot;$RoutingNumber&quot;/>&lt;/routingNumber>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="RichiestaCasedata"
                                    name="PrimoCasedata"
                                    outputVariable="RichiestaCasedata"
                                    tibex:xpdlId="95a6a418-c45f-4881-84c1-a4682f891c5e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RemoveNSnowToPrimoCasedata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToLocator">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$TransitoryProperty = &quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$TransitoryProperty = "Y"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AssignToNOWcounter">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/R_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO_NORM&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSnow&quot;/>&#xa;    &lt;xsl:param name=&quot;CompareDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:template name=&quot;RichiestaCasedata&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;xsl:variable name=&quot;RoutingNumber&quot; select=&quot;substring-after(substring-before($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:Note,'|'),'RN=') &quot;/>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;IDFileInput>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns2:IDfile&quot;/>&#xa;            &lt;/IDFileInput>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Formale_Donating_Donor)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VALIDFORMALEDONATINGDONOR&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Donating_Donor)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICADONATINGDONOR&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ESPLETAMENTODONORRECIPIENTDONATING&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Rimodulazione_DAC)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAC&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VALIDTECNICACESSAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;progressivoRichiestaFile>&#xa;                &lt;xsl:value-of select=&quot;$index&quot;/>&#xa;            &lt;/progressivoRichiestaFile>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)