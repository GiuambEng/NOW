                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (hours-from-dateTime($Start/ns18:TimstpAperturaFile) > hours-from-dateTime($CalcoloDRO) or (hours-from-dateTime($Start/ns18:TimstpAperturaFile) = hours-from-dateTime($CalcoloDRO) and minutes-from-dateTime($Start/ns18:TimstpAperturaFile) > minutes-from-dateTime($CalcoloDRO)) or (hours-from-dateTime($Start/ns18:TimstpAperturaFile) = hours-from-dateTime($CalcoloDRO) and minutes-from-dateTime($Start/ns18:TimstpAperturaFile) = minutes-from-dateTime($CalcoloDRO) and seconds-from-dateTime($Start/ns18:TimstpAperturaFile) > seconds-from-dateTime($CalcoloDRO))) then &quot;KO&quot; else &quot;OK&quot;"
