'8')&quot;>&#xa;                &lt;totaleRichiestePacchetto>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Correlazioni/ns2:TotaleRichieste)&quot;/>&#xa;                &lt;/totaleRichiestePacchetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;contenutoXML>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&#xa;            &lt;/contenutoXML>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Note)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Note&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:Note&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:Note)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:Note&quot;>&#xa;                            &lt;note>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:Note&quot;/>&#xa;                            &lt;/note>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CompareDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[$index]/*/ns2:DatiNotifica/ns2:DataOrdine)&quot;>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[$index]/*/ns2:DatiNotifica/ns2:DataOrdine  ,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[$index]/*/ns2:DataOrdine   ,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DRO.parameters/tns:outputDate) and (string-length($Start/ns2:FlagOscuramento)>0 or $CompareDate='KO'  or $Data='KO')&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DRO.parameters/tns:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating&quot;>&#xa;                        &lt;codificaOLOAGCOMDonating>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating&quot;/>&#xa;                        &lt;/codificaOLOAGCOMDonating>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1]&quot;>&#xa;                        &lt;codificaOLOAGCOMDonating>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1]&quot;/>&#xa;                        &lt;/codificaOLOAGCOMDonating>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor&quot;>&#xa;                        &lt;codificaOLOAGCOMDonor>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor&quot;/>&#xa;                        &lt;/codificaOLOAGCOMDonor>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor&quot;>&#xa;                        &lt;codificaOLOAGCOMDonor>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor&quot;/>&#xa;                        &lt;/codificaOLOAGCOMDonor>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&#xa;                        &lt;codificaOLONOWDonating>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoOK/ns2:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&#xa;                        &lt;/codificaOLONOWDonating>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])]/tns1:CodiceOLO&amp;#xD;&amp;#xA;&quot;>&#xa;                        &lt;codificaOLONOWDonating>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonating[1])]/tns1:CodiceOLO&amp;#xD;&amp;#xA;&quot;/>&#xa;                        &lt;/codificaOLONOWDonating>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&#xa;                        &lt;codificaOLONOWDonor>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&#xa;                        &lt;/codificaOLONOWDonor>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&#xa;                        &lt;codificaOLONOWDonor>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&#xa;                        &lt;/codificaOLONOWDonor>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;>&#xa;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DatiNotifica/ns2:DirectoryNumber&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DirectoryNumber&quot;>&#xa;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DirectoryNumber&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DataAttesaConsegnaRimodulata)&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:DataAttesaConsegnaRimodulata,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:Telecom/ns2:Rientro/ns2:DataAttesaConsegnaServizio)&quot;>&#xa;                    &lt;DAC>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Valid_Tecnica_Cessazione/ns2:Telecom/ns2:Rientro/ns2:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/DAC>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns2:CodOloAgcomIntrfc&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;            &lt;xsl:if test=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/node()/ns2:EsitoVerificaRichiesta&quot;>&#xa;                &lt;esito>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/node()/ns2:EsitoVerificaRichiesta&quot;/>&#xa;                &lt;/esito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:DataEspletamentoOrdine)&quot;>&#xa;                &lt;dataEspletamentoDONOR>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/ns2:Espletamento_Donor_RecipientDonating/ns2:DataEspletamentoOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                &lt;/dataEspletamentoDONOR>&#xa;            &lt;/xsl:if>&#xa;            &lt;tipoComunicazioneNP>&#xa;                &lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&#xa;            &lt;/tipoComunicazioneNP>&#xa;            &lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&#xa;                &lt;transactionIDLocator>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/transactionIDLocator>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length(string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoKO/ns2:CodiceMotivoRifiuto))>0&quot;>&#xa;                &lt;codiceRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;string($Start/ns2:ComunicazioneNP/ns2:Risposta[number($index)]/node()/ns2:EsitoVerifica/ns2:EsitoKO/ns2:CodiceMotivoRifiuto)&quot;/>&#xa;                &lt;/codiceRifiuto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($RoutingNumber)>0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($RoutingNumber)>18&quot;>&#xa;                        &lt;routingNumber>&#xa;                            &lt;xsl:value-of select=&quot;substring($RoutingNumber,1,18)&quot;/>&#xa;                        &lt;/routingNumber>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;routingNumber>&#xa;                            &lt;xsl:value-of select=&quot;$RoutingNumber&quot;/>&#xa;                        &lt;/routingNumber>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="RichiestaCasedata" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichiestaCasedata&quot;/>&lt;xsl:template name=&quot;RichiestaCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;$RichiestaCasedata/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$RichiestaCasedata/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$RichiestaCasedata/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$RichiestaCasedata/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;$RichiestaCasedata/statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$RichiestaCasedata/statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$RichiestaCasedata/statoRichiestaPrecedOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;$RichiestaCasedata/statoRichiestaPrecedOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$RichiestaCasedata/sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;$RichiestaCasedata/sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;$RichiestaCasedata/IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$RichiestaCasedata/IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;$RichiestaCasedata/IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;$RichiestaCasedata/IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;ambito>&lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl: