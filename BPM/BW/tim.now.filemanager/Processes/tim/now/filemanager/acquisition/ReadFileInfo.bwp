                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;JDBC_INFORMATION_FILE_PROCESSATO&quot;/>&lt;xsl:param name=&quot;OPERATORE&quot;/>&lt;xsl:param name=&quot;GetLocalIP&quot;/>&lt;xsl:param name=&quot;CHIAVE&quot;/>&lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&lt;tns:Request>&lt;tns:RequestCreate_token>&lt;xsl:if test=&quot;$JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/COD_OLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/COD_OLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;tns:Funzione>&lt;xsl:value-of select=&quot;'ACQFILEIN'&quot;/>&lt;/tns:Funzione>&lt;tns:ChiaveRiferimento>&lt;xsl:value-of select=&quot;string(tib:timestamp())&quot;/>&lt;/tns:ChiaveRiferimento>&lt;tns:Operatore>&lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&lt;/tns:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&lt;tns:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&lt;/tns:IPClient>&lt;/xsl:if>&lt;tns:Note>&lt;xsl:value-of select=&quot;$CHIAVE&quot;/>&lt;/tns:Note>&lt;/tns:RequestCreate_token>&lt;tns:ProcessIstance>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:ProcessIstance>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
