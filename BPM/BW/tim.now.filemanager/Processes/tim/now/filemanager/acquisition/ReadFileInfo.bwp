                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEnd"/>
                        <bpws:source linkName="JDBC_INFORMATION_FILE_PROCESSATOToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBC_INFORMATION_FILE_PROCESSATO/Record) = false() or string-length(concat($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/COD_OLO, $JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/CODFC_OLO_AGCOM)) = 0 or string-length($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/DESCR_STATO_FILE) = 0 or string-length(string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE)) = 0 or string-length(string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_INTRFC)) = 0 or string-length(string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/IDTPLG_FILE)) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($JDBC_INFORMATION_FILE_PROCESSATO/Record) = false() or string-length(concat($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/COD_OLO, $JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/CODFC_OLO_AGCOM)) = 0 or string-length($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/DESCR_STATO_FILE) = 0 or string-length(string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE)) = 0 or string-length(string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_INTRFC)) = 0 or string-length(string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/IDTPLG_FILE)) = 0]]></bpws:transitionCondition>
