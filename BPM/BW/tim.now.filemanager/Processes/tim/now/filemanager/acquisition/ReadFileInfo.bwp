                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGetLocalIP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetLocalIPToAssign"/>
                    </bpws:sources>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.GetLocalIP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (string-length(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)))>32) then substring(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)),1, 32) else if  (string-length(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)))=32) then concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)) else tib:pad-front(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)), 32,'0')"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="CHIAVE" name="Assign"
                    outputVariable="CHIAVE"
                    tibex:xpdlId="eb277d7b-1f1d-493f-b6af-2ce231f84882" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetLocalIPToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLog2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (string-length(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)))>32) then substring(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)),1, 32) else if  (string-length(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)))=32) then concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)) else tib:pad-front(concat(xsd:string($JDBC_INFORMATION_FILE_PROCESSATO/Record[1]/ID_FILE),'_',xsd:string($JDBCQuery/Record[1]/NEXTVAL)), 32,'0')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
