                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="  SELECT fp.COD_OLO, fp.CODFC_OLO_AGCOM, fp.DATA_FILE, fp.DESCR_STATO_FILE, fp.ID_FILE, fp.ID_INTRFC, fp.IDTPLG_FILE, fp.TIMSTP_APERTURA_FILE, fp.VERSO_DEL_FILE, fp.ID_ESEC_PROCSO_FILE, ifc.COD_INTRFC&#xd;&#xa;  FROM FILE_PROCSTO fp, INTRFC ifc&#xd;&#xa;  WHERE NOME_FILE = ? AND ESITO = ? AND fp.ID_INTRFC=ifc.ID_INTRFC AND ( ? = ifc.COD_INTRFC OR ? IS NULL)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FileName"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Esito"/>
                                    <PreparedParameters
