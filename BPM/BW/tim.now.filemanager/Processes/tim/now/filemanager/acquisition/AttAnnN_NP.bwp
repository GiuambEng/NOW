                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AttivazioneCasedata&quot;/>&lt;xsl:param name=&quot;RemoveNSnow&quot;/>&lt;xsl:template name=&quot;AttivazioneCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;$AttivazioneCasedata/statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/statoRichiestaPrecedOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/statoRichiestaPrecedOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;SDR&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/canaleRichiesta&quot;/>&lt;/canaleRichiesta>&lt;xsl:if test=&quot;$AttivazioneCasedata/lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/progressivoRichiestaFile&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/progressivoRichiestaFile&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/strutturaRichiesta&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/tipoRichiesta&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$AttivazioneCasedata/codificaOLONOW&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLONOW&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineOLOTarget&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineOLOTarget&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineOLOPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineOLOPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineTITarget&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineTITarget&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/dataInvioRichiesta&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDAnagraficaCausale&quot;>&lt;IDAnagraficaCausale>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDAnagraficaCausale&quot;/>&lt;/IDAnagraficaCausale>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDCorrelazione&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDCorrelazione&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/totaleRichiestePacchetto&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/totaleRichiestePacchetto&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/tipoPacchetto&quot;>&lt;tipoPacchetto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/tipoPacchetto&quot;/>&lt;/tipoPacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDPacchettoNOW&quot;>&lt;IDPacchettoNOW>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDPacchettoNOW&quot;/>&lt;/IDPacchettoNOW>&lt;/xsl:if>&lt;contenutoXML>&lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&lt;/contenutoXML>&lt;xsl:if test=&quot;$AttivazioneCasedata/note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/note&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$AttivazioneCasedata/ordine&quot;/>&lt;xsl:if test=&quot;$AttivazioneCasedata/dataControlliFormali&quot;>&lt;dataControlliFormali>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/dataControlliFormali&quot;/>&lt;/dataControlliFormali>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/totaleRichiesteRilevPac&quot;>&lt;totaleRichiesteRilevPac>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/totaleRichiesteRilevPac&quot;/>&lt;/totaleRichiesteRilevPac>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDContratto&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDContratto&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/ISTATComune&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/ISTATComune&quot;/>&lt;/ISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/offerta&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/offerta&quot;/>&lt;/offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/flagNaked&quot;>&lt;flagNaked>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/flagNaked&quot;/>&lt;/flagNaked>&lt;/xsl:if>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDRichiestaLocalizzatore&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;$AttivazioneCasedata/testMode&quot;>&lt;testMode>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/testMode&quot;/>&lt;/testMode>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/DAD&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/DAD&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDFasciaOraria&quot;>&lt;IDFasciaOraria>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDFasciaOraria&quot;/>&lt;/IDFasciaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDOfferta&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDOfferta&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/DRO&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/DRO&quot;/>&lt;/DRO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDNotifica&quot;>&lt;IDNotifica>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDNotifica&quot;/>&lt;/IDNotifica>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codificaOLOAGCOMDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLOAGCOMDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codificaOLOAGCOMDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLOAGCOMDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codificaOLONOWDonating&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLONOWDonating&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codificaOLONOWDonor&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLONOWDonor&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/numeroTelefonico&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/numeroTelefonico&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/tipologiaScenario&quot;>&lt;tipologiaScenario>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/tipologiaScenario&quot;/>&lt;/tipologiaScenario>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/DAC&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/DAC&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codificaOLOAGCOMRic&quot;>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLOAGCOMRic&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/tipoComunicazioneNP&quot;>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/tipoComunicazioneNP&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/transactionIDLocator&quot;>&lt;transactionIDLocator>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/transactionIDLocator&quot;/>&lt;/transactionIDLocator>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/routingNumber&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/routingNumber&quot;/>&lt;/routingNumber>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="AttivazioneCasedata" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="concat($subStringaSDR,$RemoveNSnow,$RemNSnow2)"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="subStringaSDR"
                                    name="StringaSDR"
                                    outputVariable="subStringaSDR"
                                    tibex:xpdlId="05a35b7c-69b3-446f-817b-51aaaa3fec0b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AnnSDRToStringaSDR"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="StringaSDRToRenderRichiesta"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="concat($subStringaSDR,$RemoveNSnow,$RemNSnow2)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="subStringaSDR" xsi:type="generalactivities:BWAssign"/>
