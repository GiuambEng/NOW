                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AttivazioneCasedata&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:template name=&quot;Locator-input&quot; match=&quot;/&quot;>&lt;tns1:RichiestaLocalizzatore>&lt;tns1:Testata>&lt;tns1:Transaction_id>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/transactionIDLocator&quot;/>&lt;/tns1:Transaction_id>&lt;tns1:Transaction_date>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:Transaction_date>&lt;tns1:Sistema_origine>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns1:Sistema_origine>&lt;/tns1:Testata>&lt;tns1:Richiesta>&lt;tns1:DataRichiesta>&lt;xsl:value-of select=&quot;xsd:dateTime($AttivazioneCasedata/dataInvioRichiesta[1])&quot;/>&lt;/tns1:DataRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)>0 and string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)=&amp;quot;3&amp;quot;&quot;>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient&quot;>&lt;tns1:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient&quot;/>&lt;/tns1:CodiceOLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/ns:CodOloAgcomIntrfc&quot;/>&lt;/tns1:CodiceOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose