                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;DRO&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;OLO_NORM&quot;/>&lt;xsl:param name=&quot;Data&quot;/>&lt;xsl:param name=&quot;CompareDate&quot;/>&lt;xsl:template name=&quot;AnnullamentoCasedata&quot; match=&quot;/&quot;>&lt;xsl:variable name=&quot;richiesta&quot; select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[position() != number($index)][ns1:Annullamento/ns1:CodiceOrdine=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*/ns1:CodiceOrdine[1]]&quot;/>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Start/ns1:IDfile&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($richiesta/ns1:Annullamento)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns1:Cessazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns1:Portin)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PORTIN&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;-$Start/ns1:Progressivi/ns1:Progressivo[number($index)]&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;-$Start/ns1:Progressivi/ns1:Progressivo[number($index)]&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($richiesta/ns1:Annullamento)&quot;>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns1:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:CodiceProgetto)>0&quot;>&lt;xsl:if test=&quot;$richiesta/node()/ns1:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($richiesta/node()/ns1:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($richiesta/node()/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0 and ($richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8')&quot;>&lt;xsl:if test=&quot;$richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($richiesta/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0  and ($richiesta/ns1:Portin/ns1:TipoComunicazione='3' or $richiesta/ns1:Portin/ns1:TipoComunicazione='8' or $richiesta/ns1:Portin/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='3' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='8' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='1' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='3' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='8')&quot;>&lt;xsl:if test=&quot;$richiesta/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste) and ($richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8')&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;xsd:int($richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/node()/ns1:Correlazioni/ns1:TotaleRichieste) and ($richiesta/ns1:Portin/ns1:TipoComunicazione='3' or $richiesta/ns1:Portin/ns1:TipoComunicazione='8' or $richiesta/ns1:Portin/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='3' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='8' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='1' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='3' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='8')&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;xsd:int($richiesta/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($richiesta)&quot;/>&lt;/contenutoXML>&lt;xsl:if test=&quot;$richiesta/node()/ns1:Note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:Note&quot;/>&lt;/note>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CompareDate='OK'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*/ns1:DataOrdine),'+')&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(xsd:date(substring-before(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine),'+')),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($DRO/parameters/tns:Response/tns:outputDate) and (string-length($Start/ns1:FlagOscuramento)>0 or $CompareDate='KO'  or $Data='KO')&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DRO/parameters/tns:Response/tns:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($richiesta/node()/ns1:DataAttesaConsegnaServizio)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($richiesta/node()/ns1:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOMRic>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&lt;/tipoComunicazioneNP>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="AnnullamentoCasedata"
                                    name="AnnullamentoCasedata"
                                    outputVariable="AnnullamentoCasedata"
                                    tibex:xpdlId="bc4aff2e-e69f-41cd-865c-0fb594a0b394" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AttivazioneCasedataToAnnullamentoCasedata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AnnullamentoCasedataToRemoveNSnow"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO_NORM&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;CompareDate&quot;/>&#xa;    &lt;xsl:template name=&quot;AnnullamentoCasedata&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:variable name=&quot;richiesta&quot; select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[position() != number($index)][ns1:Annullamento/ns1:CodiceOrdine=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*/ns1:CodiceOrdine[1]]&quot;/>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;IDFileInput>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns1:IDfile&quot;/>&#xa;            &lt;/IDFileInput>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/ns1:Annullamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/ns1:Cessazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/ns1:Portin)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PORTIN&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADONATING&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;-$Start/ns1:Progressivi/ns1:Progressivo[number($index)]&quot;>&#xa;                &lt;progressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;-$Start/ns1:Progressivi/ns1:Progressivo[number($index)]&quot;/>&#xa;                &lt;/progressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/ns1:Annullamento)&quot;>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;codificaOLONOW>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns1:CodIspIntrfc&quot;/>&#xa;            &lt;/codificaOLONOW>&#xa;            &lt;xsl:if test=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:CodiceOrdine)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLOTarget>&#xa;                        &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:CodiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLOTarget>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:CodiceProgetto)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$richiesta/node()/ns1:CodiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:CodiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/node()/ns1:DataOrdine)&quot;>&#xa;                    &lt;dataInvioRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($richiesta/node()/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/dataInvioRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;dataInvioRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                    &lt;/dataInvioRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0 and ($richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;xsl:if test=&quot;$richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&#xa;                        &lt;IDCorrelazione>&#xa;                            &lt;xsl:value-of select=&quot;$richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&#xa;                        &lt;/IDCorrelazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($richiesta/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0  and ($richiesta/ns1:Portin/ns1:TipoComunicazione='3' or $richiesta/ns1:Portin/ns1:TipoComunicazione='8' or $richiesta/ns1:Portin/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='3' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='8' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='1' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='3' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;xsl:if test=&quot;$richiesta/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&#xa;                        &lt;IDCorrelazione>&#xa;                            &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&#xa;                        &lt;/IDCorrelazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste) and ($richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($richiesta/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/node()/ns1:Correlazioni/ns1:TotaleRichieste) and ($richiesta/ns1:Portin/ns1:TipoComunicazione='3' or $richiesta/ns1:Portin/ns1:TipoComunicazione='8' or $richiesta/ns1:Portin/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='1' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='3' or $richiesta/ns1:Prenotifica_Donating/ns1:TipoComunicazione='8' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='1' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='3' or $richiesta/ns1:Cessazione/ns1:TipoComunicazione='8' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='1' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='3' or $richiesta/ns1:Annullamento/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($richiesta/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;contenutoXML>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($richiesta)&quot;/>&#xa;            &lt;/contenutoXML>&#xa;            &lt;xsl:if test=&quot;$richiesta/node()/ns1:Note&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:Note&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CompareDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*/ns1:DataOrdine),'+')&quot;>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(xsd:date(substring-before(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine),'+')),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DRO.parameters/tns:outputDate) and (string-length($Start/ns1:FlagOscuramento)>0 or $CompareDate='KO'  or $Data='KO')&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DRO.parameters/tns:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonating&quot;>&#xa;                    &lt;codificaOLOAGCOMDonating>&#xa;                        &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonating&quot;/>&#xa;                    &lt;/codificaOLOAGCOMDonating>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($richiesta/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonor&quot;>&#xa;                    &lt;codificaOLOAGCOMDonor>&#xa;                        &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:IdentificativoOperatoreDonor&quot;/>&#xa;                    &lt;/codificaOLOAGCOMDonor>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&#xa;                &lt;codificaOLONOWDonating>&#xa;                    &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&#xa;                &lt;/codificaOLONOWDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&#xa;                &lt;codificaOLONOWDonor>&#xa;                    &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($richiesta/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&#xa;                &lt;/codificaOLONOWDonor>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$richiesta/node()/ns1:DirectoryNumber&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($richiesta/node()/ns1:DataAttesaConsegnaServizio)&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($richiesta/node()/ns1:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOMRic>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&#xa;            &lt;/codificaOLOAGCOMRic>&#xa;            &lt;tipoComunicazioneNP>&#xa;                &lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&#xa;            &lt;/tipoComunicazioneNP>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="AnnullamentoCasedata" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AnnullamentoCasedata&quot;/>&lt;xsl:param name=&quot;RemNSnow2&quot;/>&lt;xsl:template name=&quot;AnnullamentoCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;$AnnullamentoCasedata/statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AnnullamentoCasedata/statoRichiestaPrecedOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/statoRichiestaPrecedOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AnnullamentoCasedata/sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;$AnnullamentoCasedata/IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;$AnnullamentoCasedata/IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;$AnnullamentoCasedata/IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;am