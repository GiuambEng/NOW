th($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;>&#xa;                            &lt;codificaOLOAGCOMDonor>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;/>&#xa;                            &lt;/codificaOLOAGCOMDonor>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&#xa;                        &lt;codificaOLONOWDonating>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&#xa;                        &lt;/codificaOLONOWDonating>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&#xa;                        &lt;codificaOLONOWDonor>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&#xa;                        &lt;/codificaOLONOWDonor>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ordine>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CompareDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*/ns1:DataOrdine),'+')&quot;>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(xsd:date(substring-before(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine),'+')),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DRO.parameters/tns:outputDate) and (string-length($Start/ns1:FlagOscuramento)>0 or $CompareDate='KO'  or $Data='KO')&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DRO.parameters/tns:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;>&#xa;                    &lt;codificaOLOAGCOMDonating>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;/>&#xa;                    &lt;/codificaOLOAGCOMDonating>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;>&#xa;                    &lt;codificaOLOAGCOMDonor>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;/>&#xa;                    &lt;/codificaOLOAGCOMDonor>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&#xa;                &lt;codificaOLONOWDonating>&#xa;                    &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&#xa;                &lt;/codificaOLONOWDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&#xa;                &lt;codificaOLONOWDonor>&#xa;                    &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&#xa;                &lt;/codificaOLONOWDonor>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio)&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;>&#xa;                        &lt;codificaOLOAGCOMRic>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;/>&#xa;                        &lt;/codificaOLOAGCOMRic>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOMRic>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&#xa;                    &lt;/codificaOLOAGCOMRic>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tipoComunicazioneNP>&#xa;                &lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&#xa;            &lt;/tipoComunicazioneNP>&#xa;            &lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&#xa;                &lt;transactionIDLocator>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/transactionIDLocator>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;>&#xa;                    &lt;routingNumber>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;/>&#xa;                    &lt;/routingNumber>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="AttivazioneCasedata" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;AttivazioneCasedata&quot;/>&lt;xsl:param name=&quot;RemoveNSnow&quot;/>&lt;xsl:template name=&quot;AttivazioneCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;$AttivazioneCasedata/statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/statoRichiestaPrecedOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/statoRichiestaPrecedOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;ambito>&lt;xsl:value-of select=&quot;'CRMWS'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/canaleRichiesta&quot;/>&lt;/canaleRichiesta>&lt;xsl:if test=&quot;$AttivazioneCasedata/lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/progressivoRichiestaFile&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/progressivoRichiestaFile&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/strutturaRichiesta&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/tipoRichiesta&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$AttivazioneCasedata/codificaOLONOW&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLONOW&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineOLOTarget&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineOLOTarget&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineOLOPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineOLOPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineTITarget&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineTITarget&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/dataInvioRichiesta&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDAnagraficaCausale&quot;>&lt;IDAnagraficaCausale>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDAnagraficaCausale&quot;/>&lt;/IDAnagraficaCausale>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDCorrelazione&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDCorrelazione&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/totaleRichiestePacchetto&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/totaleRichiestePacchetto&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/tipoPacchetto&quot;>&lt;tipoPacchetto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/tipoPacchetto&quot;/>&lt;/tipoPacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDPacchettoNOW&quot;>&lt;IDPacchettoNOW>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDPacchettoNOW&quot;/>&lt;/IDPacchettoNOW>&lt;/xsl:if>&lt;contenutoXML>&lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&lt;/contenutoXML>&lt;xsl:if test=&quot;$AttivazioneCasedata/note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/note&quot;/>&lt;/note>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$AttivazioneCasedata/ordine&quot;/>&lt;xsl:if test=&quot;$AttivazioneCasedata/dataControlliFormali&quot;>&lt;dataControlliFormali>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/dataControlliFormali&quot;/>&lt;/dataControlliFormali>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/totaleRichiesteRilevPac&quot;>&lt;totaleRichiesteRilevPac>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/totaleRichiesteRilevPac&quot;/>&lt;/totaleRichiesteRilevPac>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDContratto&quot;>&lt;IDContratto>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDContratto&quot;/>&lt;/IDContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/ISTATComune&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/ISTATComune&quot;/>&lt;/ISTATComune>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/offerta&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/offerta&quot;/>&lt;/offerta>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/flagNaked&quot;>&lt;flagNaked>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/flagNaked&quot;/>&lt;/flagNaked>&lt;/xsl:if>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDRichiestaLocalizzatore&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;$AttivazioneCasedata/testMode&quot;>&lt;testMode>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/testMode&quot;/>&lt;/testMode>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/DAD&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/DAD&quot;/>&lt;/DAD>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDFasciaOraria&quot;>&lt;IDFasciaOraria>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDFasciaOraria&quot;/>&lt;/IDFasciaOraria>&lt;/xsl:if>&lt;xsl:if test=&quot;$AttivazioneCasedata/IDOfferta&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;$AttivazioneCasedata/IDOfferta&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:if test