>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodAGCOM&quot;/>&lt;/tns2:CodificaAGCOM>&lt;tns2:IDintrfc>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDintrfc&quot;/>&lt;/tns2:IDintrfc>&lt;tns2:IDtplg_file>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDtplg_file&quot;/>&lt;/tns2:IDtplg_file>&lt;xsl:if test=&quot;exists($Start/tns1:DatiFile/tns:DataFile)&quot;>&lt;tns2:DataFile>&lt;xsl:value-of select=&quot;xsd:date($Start/tns1:DatiFile/tns:DataFile)&quot;/>&lt;/tns2:DataFile>&lt;/xsl:if>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
