                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a8a8915b-59e5-4035-a87e-960f4ecb8b61+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;BadSuf&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBC_FILE_DUPLICATO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns2:DatiFile/tns1:FileName,'_NPNG')&quot;>&lt;NomeFile>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns2:DatiFile/tns1:FileName, &amp;quot;_NPNG.xml&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&lt;/NomeFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NomeFile>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:FileName&quot;/>&lt;/NomeFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;BadFileName>&lt;xsl:value-of select=&quot;concat($Start/tns2:DatiFile/tns1:FileName,$BadSuf)&quot;/>&lt;/BadFileName>&lt;IdIntrfc>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:IDintrfc&quot;/>&lt;/IdIntrfc>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="    SELECT ESITO, DESCR_STATO_FILE&#xa;  FROM FILE_PROCSTO&#xa;  WHERE (NOME_FILE = ? OR NOME_FILE=?) AND ID_INTRFC = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NomeFile"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BadFileName"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdIntrfc"/>
                                    <columnMetadata
                                    columnName="ESITO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
