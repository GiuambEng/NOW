            name="LOG_ANAGRAFATO-input" sca-bpel:internal="true"/>
        <bpws:variable name="ActivityTimeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Performance/ActivityTimeout" type="xsd:int"/>
        <bpws:variable element="ns19:jdbcQueryActivityInput"
            name="JDBC_FILE_DUPLICATO-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns20:resultSet"
            name="JDBC_FILE_DUPLICATO" sca-bpel:internal="true"/>
        <bpws:variable name="BadSuf" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/BADSuf" type="xsd:string"/>
        <bpws:variable element="ns11:Input"
            name="Bad_FILE_DUPLICATO-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns16:LogData"
            name="LOG_NON_DUPLICATO-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="N_pref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/N_pref" type="xsd:string"/>
        <bpws:variable name="R_pref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/R_pref" type="xsd:string"/>
        <bpws:variable name="T3_pref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/T3_pref" type="xsd:string"/>
        <bpws:variable element="ns23:Input"
            name="ControlloScadenza-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns23:Output" name="ControlloScadenza" sca-bpel:internal="true"/>
        <bpws:variable element="ns24:RenameActivityConfig"
            name="SpostaFileScaduto-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns24:RenameActivityOutput"
            name="SpostaFileScaduto" sca-bpel:internal="true"/>
        <bpws:variable name="PathScaduti" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/PathScaduti" type="xsd:string"/>
        <bpws:variable element="ns3:ActivityInput" name="Log-input" sca-bpel:internal="true"/>
        <bpws:variable name="GPONPref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/GPONPref" type="xsd:string"/>
        <bpws:variable name="FWAPref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/FWAPref" type="xsd:string"/>
        <bpws:variable name="Del103N_Pref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/Del103N_NP_pref" type="xsd:string"/>
        <bpws:variable name="Del103R_Pref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/Del103R_NP_pref" type="xsd:string"/>
        <bpws:variable name="FBSPref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/FIBERSTREAMPref" type="xsd:string"/>
        <bpws:variable name="NEWGPONPref" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/NEWGPONPref" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="QuerySwitchToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="SwitchToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToJDBCQuery" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="JDBC_AMBITOToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToSwitchOther" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogAmbitoFileToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CheckNamingConventionToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CheckNamingConventionToLog" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="DateMissingToBadNaming" tibex:linkType="SUCCESS"/>
                <bpws:link name="CheckNamingConventionToJDBCUpdate" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBC_VERSOToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="FILE_IN_AMBITOAssignToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBC_COD_OLO_AGCOMToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="JDBC_COD_OLO_AGCOMToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignOLOToEmpty" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="AssignOLOToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToCallProcess1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LOG_ANAGRAFATOToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToBad_FILE_DUPLICATO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogToLOG_NON_DUPLICATO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LOG_NON_DUPLICATOToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToJDBC_FILE_DUPLICATO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ControlloScadenzaToRenameFile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="JDBC_FILE_DUPLICATOToLog" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="ecfda626-a9e3-43ff-ac5d-c3fffcc42305"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QuerySwitch-input" name="QuerySwitch"
                    outputVariable="QuerySwitch"
                    tibex:xpdlId="8597e89a-3254-4eac-9e4e-9c6b8dae6568" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QuerySwitchToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8597e89a-3254-4eac-9e4e-9c6b8dae6568+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT VALORE_STRINGA&#xd;&#xa;  FROM APPUSER.PARAMETRI_CFGZ_NOW&#xd;&#xa;  WHERE CHIAVE = 'SWITCH_ON' AND NOME_PROCSO = 'ALIMENTATORE'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="VALORE_STRINGA"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Switch"
                    name="Switch" outputVariable="Switch"
                    tibex:xpdlId="4a800cff-0db3-49c9-a244-0ed75e126634" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QuerySwitchToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SwitchToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="$QuerySwitch/Record[1]/VALORE_STRINGA" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Switch" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogSwitch-input"
                    name="LogSwitch"
                    tibex:xpdlId="66bd10f5-a9b0-4f4f-8f5a-a91f2c16654b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SwitchToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Switch='S' and not(starts-with($Start/ns7:DatiFile/ns0:FileName, &quot;N_NP_TLC_KEA&quot;) and substring($Start/ns7:DatiFile/ns0:FileName, 23, 1)=&quot;5&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Switch='S' and not(starts-with($Start/ns7:DatiFile/ns0:FileName, "N_NP_TLC_KEA") and substring($Start/ns7:DatiFile/ns0:FileName, 23, 1)="5")]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Switch&quot;/>&lt;xsl:template name=&quot;LogSwitch-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: ControlliFormaliFile | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('Switch estratto con valore ',$Switch)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBC_AMBITO-input" name="JDBC_AMBITO"
                    outputVariable="JDBC_AMBITO"
                    tibex:xpdlId="e10e3f8e-6643-47b0-9cd3-e51145b3d823" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_AMBITOToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns0=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e10e3f8e-6643-47b0-9cd3-e51145b3d823+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBC_AMBITO-input&quot; match=&quot;/&quot;>&lt;ns0:jdbcQueryActivityInput>&lt;RadiceFile>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:FileName&quot;/>&lt;/RadiceFile>&lt;/ns0:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_SISTEMA, RADICE_FILE&#xa;  FROM AMBITO_FILE &#xa;  WHERE ? LIKE RADICE_FILE&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="RadiceFile"/>
                                    <columnMetadata
                                    columnName="ID_SISTEMA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="RADICE_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="SwitchOther-input"
                    name="SwitchOther"
                    tibex:xpdlId="e0ff6085-ba4c-41af-b698-97d6e89e34fd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToCallProcess"/>
                        <bpws:target linkName="LogToSwitchOther"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/SwitchOther&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Switch&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SwitchOther-input&quot; match=&quot;/&quot;>&lt;tns:Input>&lt;tns:Switch>&lt;xsl:value-of select=&quot;$Switch&quot;/>&lt;/tns:Switch>&lt;tns:FileName>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:FileName&quot;/>&lt;/tns:FileName>&lt;tns:FileFullName>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:FileFullName&quot;/>&lt;/tns:FileFullName>&lt;tns:IDfile>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:IDfile&quot;/>&lt;/tns:IDfile>&lt;xsl:if test=&quot;$Start/tns2:DatiFile/tns1:IdEsecProcsoFile&quot;>&lt;tns:IdEsecProcsoFile>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:IdEsecProcsoFile&quot;/>&lt;/tns:IdEsecProcsoFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:DatiFile/tns1:CodISP&quot;>&lt;tns:CodiceISP>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:CodISP&quot;/>&lt;/tns:CodiceISP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:DatiFile/tns1:CodAGCOM&quot;>&lt;tns:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:CodAGCOM&quot;/>&lt;/tns:CodificaOLOagcom>&lt;/xsl:if>&lt;tns:LocalPath>&lt;xsl:value-of select=&quot;$Start/tns2:LocalPath&quot;/>&lt;/tns:LocalPath>&lt;tns:IdTiplgFile>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:IDtplg_file&quot;/>&lt;/tns:IdTiplgFile>&lt;tns:IdIntrfc>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:IDintrfc&quot;/>&lt;/tns:IdIntrfc>&lt;/tns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SwitchOther" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogAmbitoFile-input"
                    name="LogAmbitoFile"
                    tibex:xpdlId="b1b49a36-daf4-49ad-aba6-ee654d58fb9a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_AMBITOToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToSwitchOther">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogAmbitoFileToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBC_AMBITO/Record)=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($JDBC_AMBITO/Record)=true()]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_AMBITO&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogAmbitoFile-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: ControlliFormaliFile | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;if (count($JDBC_AMBITO/Record)>0)&amp;#xD;&amp;#xA;then concat(&amp;quot;Ambito file: &amp;quot;, $JDBC_AMBITO/Record[1]/RADICE_FILE)&amp;#xD;&amp;#xA;else &amp;quot;Radice File non presente nella tabella AMBITO_FILE.&amp;quot;&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CheckNamingConvention-input"
                    name="CheckNamingConvention"
                    outputVariable="CheckNamingConvention"
                    tibex:xpdlId="16361ba4-52cf-4f45-83c6-6e773d373f92"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogAmbitoFileToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CheckNamingConventionToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckNamingConventionToLog">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(string($Start/ns7:DatiFile/ns0:DataFile)) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[string-length(string($Start/ns7:DatiFile/ns0:DataFile)) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CheckNamingConventionToJDBCUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CheckNamingConvention = &quot;OK&quot; and string-length(string($Start/ns7:DatiFile/ns0:DataFile)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$CheckNamingConvention = "OK" and string-length(string($Start/ns7:DatiFile/ns0:DataFile)) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CheckNamingInput&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CheckNamingConvention-input&quot; match=&quot;/&quot;>&lt;tns2:FileName>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileName&quot;/>&lt;/tns2:FileName>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.CheckNamingConvention" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="BadNaming-input"
                    name="BadNaming"
                    tibex:xpdlId="7f91fea3-57de-4967-9afe-d1cb41d215dd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckNamingConventionToCallProcess"/>
                        <bpws:target linkName="DateMissingToBadNaming"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns2=&quot;http://www.example.org/GenerateBadFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;BadNaming-input&quot; match=&quot;/&quot;>&lt;tns2:Input>&lt;tns2:IDfile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDfile&quot;/>&lt;/tns2:IDfile>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:IdEsecProcsoFile&quot;>&lt;tns2:IdEsecProcsoFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IdEsecProcsoFile&quot;/>&lt;/tns2:IdEsecProcsoFile>&lt;/xsl:if>&lt;tns2:NomeFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileName&quot;/>&lt;/tns2:NomeFile>&lt;tns2:FileFullName>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileFullName&quot;/>&lt;/tns2:FileFullName>&lt;tns2:FileSize>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:Size&quot;/>&lt;/tns2:FileSize>&lt;tns2:LocalPath>&lt;xsl:value-of select=&quot;$Start/tns1:LocalPath&quot;/>&lt;/tns2:LocalPath>&lt;tns2:LogMessage>&lt;xsl:value-of select=&quot;concat(&amp;quot;Il nome &amp;quot;,$Start/tns1:DatiFile/tns:FileName,&amp;quot; non rispetta la naming convention per l'interfaccia utilizzata.&amp;quot;)&quot;/>&lt;/tns2:LogMessage>&lt;tns2:ParentProcessInstanceID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:ParentProcessInstanceID>&lt;tns2:Esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns2:Esito>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;>&lt;tns2:CodiceISP>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;/>&lt;/tns2:CodiceISP>&lt;/xsl:if>&lt;tns2:CodificaAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodAGCOM&quot;/>&lt;/tns2:CodificaAGCOM>&lt;tns2:IDintrfc>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDintrfc&quot;/>&lt;/tns2:IDintrfc>&lt;tns2:IDtplg_file>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDtplg_file&quot;/>&lt;/tns2:IDtplg_file>&lt;xsl:if test=&quot;exists($Start/tns1:DatiFile/tns:DataFile)&quot;>&lt;tns2:DataFile>&lt;xsl:value-of select=&quot;xsd:date($Start/tns1:DatiFile/tns:DataFile)&quot;/>&lt;/tns2:DataFile>&lt;/xsl:if>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.GenerateBadFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="DateMissing-input" name="DateMissing"
                    tibex:xpdlId="c19525a1-cc12-4c3b-a5be-807379bb1609" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckNamingConventionToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DateMissingToBadNaming"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;DateMissing-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: ControlliFormaliFile | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;'Data mancante nel record della tabella FILE_PROCSTO'&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBC_VERSO-input" name="JDBC_VERSO"
                    outputVariable="JDBC_VERSO"
                    tibex:xpdlId="9da2496c-77cd-470c-ad90-627a245bb1c9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckNamingConventionToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_VERSOToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:ns0=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9da2496c-77cd-470c-ad90-627a245bb1c9+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBC_VERSO-input&quot; match=&quot;/&quot;>&lt;ns0:jdbcUpdateActivityInput>&lt;Esito>&lt;xsl:value-of select=&quot;&amp;quot;FILE IN AMBITO&amp;quot;&quot;/>&lt;/Esito>&lt;Verso>&lt;xsl:value-of select=&quot;&amp;quot;INPUT&amp;quot;&quot;/>&lt;/Verso>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns2:DatiFile/tns1:FileName,'_NPNG')&quot;>&lt;NomeFile>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns2:DatiFile/tns1:FileName, &amp;quot;_NPNG.xml&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&lt;/NomeFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NomeFile>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:FileName&quot;/>&lt;/NomeFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDFile>&lt;xsl:value-of select=&quot;$Start/tns2:DatiFile/tns1:IDfile&quot;/>&lt;/IDFile>&lt;/ns0:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO&#xd;&#xa;  SET ESITO = ?, VERSO_DEL_FILE = ?, DESCR_STATO_FILE ='IN ELABORAZIONE'&#xd;&#xa;  WHERE NOME_FILE = ? AND ID_FILE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Esito"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Verso"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NomeFile"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDFile"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Esito"
                    name="FILE_IN_AMBITOAssign" outputVariable="Esito"
                    tibex:xpdlId="55e81296-bb67-4c2a-9772-9298e06d7873" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_VERSOToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FILE_IN_AMBITOAssignToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequest/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;ns:AnalyzeOloEsito>&lt;ns:Esito>&lt;xsl:value-of select=&quot;&amp;quot;IN AMBITO&amp;quot;&quot;/>&lt;/ns:Esito>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;>&lt;ns:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;/>&lt;/ns:CodiceOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:CodAGCOM&quot;>&lt;ns:CodificaOLOAgcom>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodAGCOM&quot;/>&lt;/ns:CodificaOLOAgcom>&lt;/xsl:if>&lt;/ns:AnalyzeOloEsito>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBC_COD_OLO_AGCOM-input"
                    name="JDBC_COD_OLO_AGCOM"
                    outputVariable="JDBC_COD_OLO_AGCOM"
                    tibex:xpdlId="f0aa041d-5909-4fd3-97a0-82bdacdc6001" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FILE_IN_AMBITOAssignToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_COD_OLO_AGCOMToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBC_COD_OLO_AGCOM/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBC_COD_OLO_AGCOM/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBC_COD_OLO_AGCOMToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f0aa041d-5909-4fd3-97a0-82bdacdc6001+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequest/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Esito/ns:CodificaOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Esito/ns:CodificaOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Esito/ns:CodiceOLO)&quot;>&lt;xsl:value-of select=&quot;$Esito/ns:CodiceOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Esito/ns:CodificaOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Esito/ns:CodificaOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Esito/ns:CodiceOLO)&quot;>&lt;xsl:value-of select=&quot;$Esito/ns:CodiceOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Esito/ns:CodificaOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Esito/ns:CodificaOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Esito/ns:CodiceOLO)&quot;>&lt;xsl:value-of select=&quot;$Esito/ns:CodiceOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODFC_OLO_AGCOM, COD_OLO, COD_OLO_ACCORPANTE&#xa;FROM OLO&#xa;WHERE CODFC_OLO_AGCOM = ?&#xa;UNION&#xa;SELECT CODFC_OLO_AGCOM, COD_OLO, COD_OLO_ACCORPANTE&#xa;FROM OLO&#xa;WHERE COD_OLO = ? &#xa;  AND FLAG_OLO_PREVALENTE = 'Y'&#xa;  AND NOT EXISTS (SELECT 1&#xa;                  FROM OLO&#xa;                  WHERE CODFC_OLO_AGCOM = ?)&#xa;UNION&#xa;SELECT CODFC_OLO_AGCOM, COD_OLO, COD_OLO_ACCORPANTE&#xa;FROM OLO&#xa;WHERE COD_OLO = ? &#xa;  AND NOT EXISTS (SELECT 1&#xa;                  FROM OLO&#xa;                  WHERE CODFC_OLO_AGCOM = ? OR (COD_OLO = ? AND FLAG_OLO_PREVALENTE = 'Y'))&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO_ACCORPANTE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Esito"
                    name="AssignOLO" outputVariable="Esito"
                    tibex:xpdlId="fcadf4f4-72f2-46b8-98ba-c823ae190d0c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_COD_OLO_AGCOMToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignOLOToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $FBSPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($FBSPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or&#xd;&#xa;(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $Del103N_Pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($Del103N_Pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or&#xd;&#xa;(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $Del103R_Pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($Del103R_Pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false())&#xd;&#xa;or&#xd;&#xa;&#xd;&#xa;(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $FWAPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($FWAPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or&#xd;&#xa;&#xd;&#xa;(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $GPONPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($GPONPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or&#xd;&#xa;(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $NEWGPONPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($NEWGPONPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or&#xd;&#xa;(if ( starts-with($Start/ns7:DatiFile/ns0:FileName, $NGAPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($NGAPref)+1),3)=$Esito/ns8:CodiceOLO) else false()) or (if (starts-with($Start/ns7:DatiFile/ns0:FileName, $ADSLPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($ADSLPref)+1),3)=$Esito/ns8:CodiceOLO) else false()) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, $N_NP_pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($N_NP_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, $R_NP_pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($R_NP_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false())or starts-with($Start/ns7:DatiFile/ns0:FileName,$Esito/ns8:CodificaOLOAgcom) or starts-with($Start/ns7:DatiFile/ns0:FileName,concat($N_pref,$Esito/ns8:CodificaOLOAgcom)) or starts-with($Start/ns7:DatiFile/ns0:FileName,concat($R_pref,$Esito/ns8:CodificaOLOAgcom)) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, concat($T3_pref,$N_NP_pref))) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($N_NP_pref)+string-length($T3_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, concat($T3_pref,$R_NP_pref))) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($R_NP_pref)+string-length($T3_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $FBSPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($FBSPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $Del103N_Pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($Del103N_Pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $Del103R_Pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($Del103R_Pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false())or(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $FWAPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($FWAPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $GPONPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($GPONPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or(if (starts-with($Start/ns7:DatiFile/ns0:FileName, $NEWGPONPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($NEWGPONPref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or(if ( starts-with($Start/ns7:DatiFile/ns0:FileName, $NGAPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($NGAPref)+1),3)=$Esito/ns8:CodiceOLO) else false()) or (if (starts-with($Start/ns7:DatiFile/ns0:FileName, $ADSLPref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($ADSLPref)+1),3)=$Esito/ns8:CodiceOLO) else false()) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, $N_NP_pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($N_NP_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, $R_NP_pref)) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($R_NP_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false())or starts-with($Start/ns7:DatiFile/ns0:FileName,$Esito/ns8:CodificaOLOAgcom) or starts-with($Start/ns7:DatiFile/ns0:FileName,concat($N_pref,$Esito/ns8:CodificaOLOAgcom)) or starts-with($Start/ns7:DatiFile/ns0:FileName,concat($R_pref,$Esito/ns8:CodificaOLOAgcom)) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, concat($T3_pref,$N_NP_pref))) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($N_NP_pref)+string-length($T3_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false()) or (if ( starts-with($Start/ns7:DatiFile/ns0:FileName, concat($T3_pref,$R_NP_pref))) then (substring($Start/ns7:DatiFile/ns0:FileName,(string-length($R_NP_pref)+string-length($T3_pref)+1),3)=$Esito/ns8:CodificaOLOAgcom) else false())]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignOLOToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequest/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:param name=&quot;JDBC_COD_OLO_AGCOM&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;ns:AnalyzeOloEsito>&lt;ns:Esito>&lt;xsl:value-of select=&quot;$Esito/ns:Esito&quot;/>&lt;/ns:Esito>&lt;xsl:if test=&quot;$JDBC_COD_OLO_AGCOM/Record[1]/COD_OLO&quot;>&lt;ns:CodiceOLO>&lt;xsl:value-of select=&quot;$JDBC_COD_OLO_AGCOM/Record[1]/COD_OLO&quot;/>&lt;/ns:CodiceOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBC_COD_OLO_AGCOM/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;ns:CodificaOLOAgcom>&lt;xsl:value-of select=&quot;$JDBC_COD_OLO_AGCOM/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/ns:CodificaOLOAgcom>&lt;/xsl:if>&lt;/ns:AnalyzeOloEsito>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Bad_olo_non_censito-input"
                    name="Bad_olo_non_censito"
                    tibex:xpdlId="a0dd008d-0c7b-4d5b-a1b8-cefacf641d20"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_COD_OLO_AGCOMToCallProcess"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns2=&quot;http://www.example.org/GenerateBadFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequest/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:template name=&quot;Bad_olo_non_censito-input&quot; match=&quot;/&quot;>&lt;tns2:Input>&lt;tns2:IDfile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDfile&quot;/>&lt;/tns2:IDfile>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:IdEsecProcsoFile&quot;>&lt;tns2:IdEsecProcsoFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IdEsecProcsoFile&quot;/>&lt;/tns2:IdEsecProcsoFile>&lt;/xsl:if>&lt;tns2:NomeFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileName&quot;/>&lt;/tns2:NomeFile>&lt;tns2:FileFullName>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileFullName&quot;/>&lt;/tns2:FileFullName>&lt;tns2:FileSize>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:Size&quot;/>&lt;/tns2:FileSize>&lt;tns2:LocalPath>&lt;xsl:value-of select=&quot;$Start/tns1:LocalPath&quot;/>&lt;/tns2:LocalPath>&lt;tns2:LogMessage>&lt;xsl:value-of select=&quot;concat(&amp;quot;OLO non censito: nessun record estratto corrispondente al codice agcom &amp;quot;,$Esito/ns:CodificaOLOAgcom,&amp;quot; o al codice isp &amp;quot;, $Esito/ns:CodiceOLO)&quot;/>&lt;/tns2:LogMessage>&lt;tns2:ParentProcessInstanceID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:ParentProcessInstanceID>&lt;tns2:Esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns2:Esito>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;>&lt;tns2:CodiceISP>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;/>&lt;/tns2:CodiceISP>&lt;/xsl:if>&lt;tns2:CodificaAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodAGCOM&quot;/>&lt;/tns2:CodificaAGCOM>&lt;tns2:IDintrfc>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDintrfc&quot;/>&lt;/tns2:IDintrfc>&lt;tns2:IDtplg_file>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDtplg_file&quot;/>&lt;/tns2:IDtplg_file>&lt;xsl:if test=&quot;exists($Start/tns1:DatiFile/tns:DataFile)&quot;>&lt;tns2:DataFile>&lt;xsl:value-of select=&quot;xsd:date($Start/tns1:DatiFile/tns:DataFile)&quot;/>&lt;/tns2:DataFile>&lt;/xsl:if>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.GenerateBadFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="e02d26a7-2bb5-4937-b583-23f00305ba74">
                <bpws:targets>
                    <bpws:target linkName="AssignOLOToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$JDBC_COD_OLO_AGCOM/Record[1]/COD_OLO_ACCORPANTE = $JDBC_COD_OLO_AGCOM/Record[1]/CODFC_OLO_AGCOM or string-length($JDBC_COD_OLO_AGCOM/Record[1]/COD_OLO_ACCORPANTE) = 0 " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$JDBC_COD_OLO_AGCOM/Record[1]/COD_OLO_ACCORPANTE = $JDBC_COD_OLO_AGCOM/Record[1]/CODFC_OLO_AGCOM or string-length($JDBC_COD_OLO_AGCOM/Record[1]/COD_OLO_ACCORPANTE) = 0 ]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCallProcess1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Bad_Errore_OLO_nomeFileess-input"
                    name="Bad_Errore_OLO_nomeFileess"
                    tibex:xpdlId="40f0c4ed-1fc0-43b7-878b-d91eebf0ee33"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignOLOToCallProcess"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns2=&quot;http://www.example.org/GenerateBadFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequest/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:template name=&quot;Bad_Errore_OLO_nomeFileess-input&quot; match=&quot;/&quot;>&lt;tns2:Input>&lt;tns2:IDfile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDfile&quot;/>&lt;/tns2:IDfile>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:IdEsecProcsoFile&quot;>&lt;tns2:IdEsecProcsoFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IdEsecProcsoFile&quot;/>&lt;/tns2:IdEsecProcsoFile>&lt;/xsl:if>&lt;tns2:NomeFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileName&quot;/>&lt;/tns2:NomeFile>&lt;tns2:FileFullName>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileFullName&quot;/>&lt;/tns2:FileFullName>&lt;tns2:FileSize>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:Size&quot;/>&lt;/tns2:FileSize>&lt;tns2:LocalPath>&lt;xsl:value-of select=&quot;$Start/tns1:LocalPath&quot;/>&lt;/tns2:LocalPath>&lt;tns2:LogMessage>&lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nel codice OLO presente nel nome del file: il file e' stato caricato erroneamente nella cartella dell'OLO &amp;quot;,$Esito/ns:CodificaOLOAgcom,&amp;quot; oppure il codice OLO nel nome del file non e' censito nell'anagrafica OLO.&amp;quot;)&quot;/>&lt;/tns2:LogMessage>&lt;tns2:ParentProcessInstanceID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns2:ParentProcessInstanceID>&lt;tns2:Esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns2:Esito>&lt;xsl:if test=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;>&lt;tns2:CodiceISP>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodISP&quot;/>&lt;/tns2:CodiceISP>&lt;/xsl:if>&lt;tns2:CodificaAGCOM>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:CodAGCOM&quot;/>&lt;/tns2:CodificaAGCOM>&lt;tns2:IDintrfc>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDintrfc&quot;/>&lt;/tns2:IDintrfc>&lt;tns2:IDtplg_file>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDtplg_file&quot;/>&lt;/tns2:IDtplg_file>&lt;xsl:if test=&quot;exists($Start/tns1:DatiFile/tns:DataFile)&quot;>&lt;tns2:DataFile>&lt;xsl:value-of select=&quot;xsd:date($Start/tns1:DatiFile/tns:DataFile)&quot;/>&lt;/tns2:DataFile>&lt;/xsl:if>&lt;/tns2:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.GenerateBadFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_ANAGRAFATO-input"
                    name="LOG_ANAGRAFATO"
                    tibex:xpdlId="16897751-8432-4adf-bdb5-acb0d91363f4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
