                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/ControlloScadenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;ns:Input>&lt;ns:NomeFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:FileName&quot;/>&lt;/ns:NomeFile>&lt;ns:DataFile>&lt;xsl:value-of select=&quot;xsd:date($Start/tns1:DatiFile/tns:DataFile)&quot;/>&lt;/ns:DataFile>&lt;ns:IDFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IDfile&quot;/>&lt;/ns:IDFile>&lt;ns:IDEsecProcsoFile>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:IdEsecProcsoFile&quot;/>&lt;/ns:IDEsecProcsoFile>&lt;ns:Size>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns:Size&quot;/>&lt;/ns:Size>&lt;/ns:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
