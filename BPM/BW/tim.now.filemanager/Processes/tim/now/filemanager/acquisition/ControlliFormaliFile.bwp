                    <bpws:targets>
                        <bpws:target linkName="ControlloScadenzaToRenameFile"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;PathScaduti&quot;/>&lt;xsl:template name=&quot;SpostaFileScaduto-input&quot; match=&quot;/&quot;>&lt;tns:RenameActivityConfig>&lt;fromFileName>&lt;xsl:value-of select=&quot;$Start/tns1:DatiFile/tns2:FileFullName&quot;/>&lt;/fromFileName>&lt;toFileName>&lt;xsl:value-of select=&quot;concat($Start/tns1:LocalPath, $PathScaduti, $Start/tns1:DatiFile/tns2:FileName)&quot;/>&lt;/toFileName>&lt;/tns:RenameActivityConfig>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.file.rename"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RenameFile"/>
                                    <value
                                    createDestinationDirectories="true"
                                    overwrite="true" xsi:type="file:RenameFile"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-input"
                    name="Log"
                    tibex:xpdlId="4cae6921-0f58-4f38-a73f-18b19844362c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_FILE_DUPLICATOToLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToBad_FILE_DUPLICATO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBC_FILE_DUPLICATO/Record[DESCR_STATO_FILE!=&quot;IN ELABORAZIONE&quot; and (ESITO = &quot;FILE IN AMBITO&quot; or ESITO=&quot;ALTRO&quot; or ESITO = &quot;DUPLICATO&quot; or ESITO=&quot;KO&quot; or ESITO=&quot;BAD&quot; or ESITO=&quot;SWITCH&quot;)]) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBC_FILE_DUPLICATO/Record[DESCR_STATO_FILE!="IN ELABORAZIONE" and (ESITO = "FILE IN AMBITO" or ESITO="ALTRO" or ESITO = "DUPLICATO" or ESITO="KO" or ESITO="BAD" or ESITO="SWITCH")]) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogToLOG_NON_DUPLICATO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;JDBC_FILE_DUPLICATO&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: ControlliFormaliFile | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBC_FILE_DUPLICATO/Record)>0&quot;>&lt;message>&lt;xsl:value-of select=&quot;concat('Record trovati su FILE_DUPLICATO ',tib:render-xml($JDBC_FILE_DUPLICATO,true(),true()))&quot;/>&lt;/message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;message>&lt;xsl:value-of select=&quot;'Record non trovati su FILE_DUPLICATO'&quot;/>&lt;/message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
