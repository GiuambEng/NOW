                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO_NORM&quot;/>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSnow&quot;/>&#xa;    &lt;xsl:param name=&quot;CompareDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;Token&quot;/>&#xa;    &lt;xsl:template name=&quot;RichiestaCasedata&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;IDFileInput>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns1:IDfile&quot;/>&#xa;            &lt;/IDFileInput>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PORTIN&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADONATING&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/ns1:Progressivi/ns1:Progressivo[number($index)]&quot;>&#xa;                &lt;progressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:Progressivi/ns1:Progressivo[number($index)]&quot;/>&#xa;                &lt;/progressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento)&quot;>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:RientroTI)>0 and string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione)=&amp;quot;8&amp;quot;&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0 and string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:RientroTI)>0 and string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione)=&amp;quot;8&amp;quot;&quot;>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;002&amp;quot;&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:CodIspIntrfc&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceOrdine&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceOrdine&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:CodiceOrdine)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:CodiceOrdine&quot;>&#xa;                    &lt;codiceOrdineOLOTarget>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:CodiceOrdine&quot;/>&#xa;                    &lt;/codiceOrdineOLOTarget>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceProgetto)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/ns1:Annullamento)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tib:compare-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/ns1:Annullamento/ns1:DataOrdine, $Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/ns1:Annullamento/ns1:DataInvioMessaggio)=0&quot;>&#xa;                            &lt;dataInvioRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/ns1:Annullamento/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/dataInvioRichiesta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;dataInvioRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/ns1:Annullamento/ns1:DataInvioMessaggio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/dataInvioRichiesta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataOrdine)&quot;>&#xa;                    &lt;dataInvioRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/dataInvioRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;dataInvioRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                    &lt;/dataInvioRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0 and ($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&#xa;                        &lt;IDCorrelazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&#xa;                        &lt;/IDCorrelazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0 and ($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;>&#xa;                        &lt;IDCorrelazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&#xa;                        &lt;/IDCorrelazione>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste) and ($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste) and ($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione='8' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='1' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='3' or $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='8')&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;contenutoXML>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&#xa;            &lt;/contenutoXML>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;matches($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)') &quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;translate($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note, '0123456789', '         ')&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;not(exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento))&quot;>&#xa;                &lt;ordine>&#xa;                    &lt;offertaCatalogo>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;                    &lt;/offertaCatalogo>&#xa;                    &lt;xsl:if test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio)&quot;>&#xa;                        &lt;DAC>&#xa;                            &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                        &lt;/DAC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;$Token/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;>&#xa;                        &lt;cognomeRagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/cognomeRagioneSociale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Token/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                        &lt;nome>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                        &lt;/nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;matches($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)') &quot;>&#xa;                            &lt;noteCliente>&#xa;                                &lt;xsl:value-of select=&quot;translate($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note, '0123456789', '         ')&quot;/>&#xa;                            &lt;/noteCliente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note&quot;>&#xa;                                &lt;noteCliente>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Note&quot;/>&#xa;                                &lt;/noteCliente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                