test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:RientroTI)>0 and string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione)=&amp;quot;8&amp;quot;&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0 and string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:RientroTI)>0 and string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione)=&amp;quot;8&amp;quot;&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;&amp;quot;002&amp;quot;&quot;/>&lt;/codificaOLONOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns1:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/n