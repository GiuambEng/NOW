te>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;NUMEROTELEFONICO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;progressivo>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/progressivo>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;/dettaglioordine>&lt;/xsl:for-each>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;&amp;quot;FONIA&amp;quot;&quot;/>&lt;/tipologiaAccesso>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste)&quot;>&lt;totaleOrdiniPacchetto>&lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&lt;/totaleOrdiniPacchetto>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;>&lt;totaleOrdiniPacchetto>&lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&lt;/totaleOrdiniPacchetto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&lt;IDRisorsaNOW>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/IDRisorsaNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;/ordine>&lt;/xsl:if>&lt;offerta>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offerta>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&lt;IDOfferta>&lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&lt;/IDOfferta>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CompareDate='OK'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*/ns1:DataOrdine),'+')&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(xsd:date(substring-before(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine),'+')),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($DRO/parameters/tns:Response/tns:outputDate) and (string-length($Start/ns1:FlagOscuramento)>0 or $CompareDate='KO'  or $Data='KO')&quot;>&lt;DRO>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DRO/parameters/tns:Response/tns:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DRO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&lt;/tipoComunicazioneNP>&lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&lt;transactionIDLocator>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&lt;/transactionIDLocator>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;/>&lt;/routingNumber>&lt;/xsl:if>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
