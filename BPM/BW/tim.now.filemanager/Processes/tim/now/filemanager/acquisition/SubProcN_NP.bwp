                      &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                            &lt;IDRisorsaNOW>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                            &lt;/IDRisorsaNOW>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/dettaglioordine>&#xa;                    &lt;xsl:for-each select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:NPAggiuntive/ns1:NumAggiuntivaPortata[string-length(.)>0]&quot;>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position()+1)&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;IDDettaglioOrdineParent>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdineParent>&#xa;                            &lt;IDDettaglioOrdineRoot>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdineRoot>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;nomeComponente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;NUMERIAGGIUNTIVIOLO&amp;quot;&quot;/>&#xa;                            &lt;/nomeComponente>&#xa;                            &lt;integrationID>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/integrationID>&#xa;                            &lt;attributiDettaglioOrdine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NUMEROTELEFONICO&amp;quot;&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                            &lt;/attributiDettaglioOrdine>&#xa;                            &lt;attributiDettaglioOrdine>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/IDDettaglioOrdine>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                            &lt;/attributiDettaglioOrdine>&#xa;                            &lt;progressivo>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                            &lt;/progressivo>&#xa;                            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                                &lt;IDRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                                &lt;/IDRisorsaNOW>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/dettaglioordine>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tipologiaAccesso>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FONIA&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaAccesso>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;                    &lt;/offerta>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste)&quot;>&#xa;                            &lt;totaleOrdiniPacchetto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:Rientro/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&#xa;                            &lt;/totaleOrdiniPacchetto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;>&#xa;                            &lt;totaleOrdiniPacchetto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:Correlazioni/ns1:TotaleRichieste)&quot;/>&#xa;                            &lt;/totaleOrdiniPacchetto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                        &lt;numeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                        &lt;/numeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;>&#xa;                            &lt;codificaOLOAGCOMDonating>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;/>&#xa;                            &lt;/codificaOLOAGCOMDonating>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;>&#xa;                            &lt;codificaOLOAGCOMDonor>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;/>&#xa;                            &lt;/codificaOLOAGCOMDonor>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&#xa;                        &lt;codificaOLONOWDonating>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&#xa;                        &lt;/codificaOLONOWDonating>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&#xa;                        &lt;codificaOLONOWDonor>&#xa;                            &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&#xa;                        &lt;/codificaOLONOWDonor>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ordine>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($IdOfferta/Record[1]/ID_OFFERTA)&quot;/>&#xa;                &lt;/IDOfferta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CompareDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*/ns1:DataOrdine),'+')&quot;>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(xsd:date(substring-before(xsd:string($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine),'+')),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DRO>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]/*/ns1:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                            &lt;/DRO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($DRO.parameters/tns:outputDate) and (string-length($Start/ns1:FlagOscuramento)>0 or $CompareDate='KO'  or $Data='KO')&quot;>&#xa;                    &lt;DRO>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DRO.parameters/tns:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/DRO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;>&#xa;                    &lt;codificaOLOAGCOMDonating>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;/>&#xa;                    &lt;/codificaOLOAGCOMDonating>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;>&#xa;                    &lt;codificaOLOAGCOMDonor>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;/>&#xa;                    &lt;/codificaOLOAGCOMDonor>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&#xa;                    &lt;codificaOLONOWDonating>&#xa;                        &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&#xa;                    &lt;/codificaOLONOWDonating>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&#xa;                    &lt;codificaOLONOWDonor>&#xa;                        &lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;/>&#xa;                    &lt;/codificaOLONOWDonor>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                &lt;numeroTelefonico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                &lt;/numeroTelefonico>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio)&quot;>&#xa;                &lt;DAC>&#xa;                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                &lt;/DAC>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;>&#xa;                        &lt;codificaOLOAGCOMRic>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;/>&#xa;                        &lt;/codificaOLOAGCOMRic>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOMRic>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&#xa;                    &lt;/codificaOLOAGCOMRic>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tipoComunicazioneNP>&#xa;                &lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&#xa;            &lt;/tipoComunicazioneNP>&#xa;            &lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&#xa;                &lt;transactionIDLocator>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/transactionIDLocator>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;>&#xa;                    &lt;routingNumber>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;/>&#xa;                    &lt;/routingNumber>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
