ioneNP/ns:Richiesta[number($index)]/ns:Cessazione/ns:Rientro)&quot;>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Cessazione/ns:Rientro/ns:CognomeCliente_RagioneSociale&quot;>&lt;tns:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Cessazione/ns:Rientro/ns:CognomeCliente_RagioneSociale&quot;/>&lt;/tns:CognomeRagioneSociale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CognomeCliente_RagioneSociale&quot;>&lt;tns:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CognomeCliente_RagioneSociale&quot;/>&lt;/tns:CognomeRagioneSociale>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RequestCreate_token>&lt;tns:ProcessIstance>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:ProcessIstance>&lt;tns:StrutturaRichiesta>&lt;xsl:value-of select=&quot;'NPG'&quot;/>&lt;/tns:StrutturaRichiesta>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:DirectoryNumber&quot;>&lt;tns:NumeroLinea>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:DirectoryNumber&quot;/>&lt;/tns:NumeroLinea>&lt;/xsl:if>&lt;tns:OffertaBPM>&lt;xsl:value-of select=&quot;'NP'&quot;/>&lt;/tns:OffertaBPM>&lt;/tns:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
