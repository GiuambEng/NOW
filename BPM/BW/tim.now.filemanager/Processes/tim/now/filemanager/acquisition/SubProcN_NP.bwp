                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RichiestaCasedata&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:template name=&quot;Locator-input&quot; match=&quot;/&quot;>&lt;tns1:RichiestaLocalizzatore>&lt;tns1:Testata>&lt;tns1:Transaction_id>&lt;xsl:value-of select=&quot;$RichiestaCasedata/transactionIDLocator&quot;/>&lt;/tns1:Transaction_id>&lt;tns1:Transaction_date>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:Transaction_date>&lt;tns1:Sistema_origine>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/tns1:Sistema_origine>&lt;/tns1:Testata>&lt;tns1:Richiesta>&lt;tns1:DataRichiesta>&lt;xsl:value-of select=&quot;xsd:dateTime($RichiestaCasedata/dataInvioRichiesta)&quot;/>&lt;/tns1:DataRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)>0 and string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)=&amp;quot;3&amp;quot;&quot;>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient&quot;>&lt;tns1:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient&quot;/>&lt;/tns1:CodiceOLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/ns:CodOloAgcomIntrfc&quot;/>&lt;/tns1:CodiceOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)>0 and string-length($CodiciOlo/tns2:codes[tns2:CodiceOLOAGCOM=string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)]/tns2:CodiceOLO)>0 and string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)=&amp;quot;3&amp;quot;&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns2:codes[tns2:CodiceOLOAGCOM=string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)]/tns2:CodiceOLO&quot;>&lt;tns1:CodiceISP>&lt;xsl:value-of select=&quot;$CodiciOlo/tns2:codes[tns2:CodiceOLOAGCOM=string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)]/tns2:CodiceOLO&quot;/>&lt;/tns1:CodiceISP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceISP>&lt;xsl:value-of select=&quot;$Start/ns:CodIspIntrfc&quot;/>&lt;/tns1:CodiceISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:Servizio>&lt;xsl:value-of select=&quot;'NP'&quot;/>&lt;/tns1:Servizio>&lt;tns1:Richiesta>&lt;xsl:value-of select=&quot;concat(&amp;quot;TIPO_COMUNICAZIONE_&amp;quot;,$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)&quot;/>&lt;/tns1:Richiesta>&lt;xsl:if test=&quot;string-length($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)>0 and(string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)='4' or string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)='5' or string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)='11' or string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)='13')&quot;>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOrdine&quot;>&lt;tns1:CodiceOrdineRiferimentoOLO>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOrdine&quot;/>&lt;/tns1:CodiceOrdineRiferimentoOLO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:DirectoryNumber&quot;>&lt;tns1:IdRisorsa>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:DirectoryNumber&quot;/>&lt;/tns1:IdRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$RichiestaCasedata/IDCorrelazione&quot;>&lt;tns1:IdCorrelazione>&lt;xsl:value-of select=&quot;$RichiestaCasedata/IDCorrelazione&quot;/>&lt;/tns1:IdCorrelazione>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)>0 and string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)='1' and substring($Start/ns:NomeFile,23,1)='5' and ($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:IdentificativoOperatoreDonor[1]='TLC' or $Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:IdentificativoOperatoreDonor[1]='KEA') and (string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)='TLC' or string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)='KEA')&quot;>&lt;tns1:Flag_verticalizzato>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:Flag_verticalizzato>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)>0 and string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:TipoComunicazione)='1' and not(substring($Start/ns:NomeFile,23,1)='5') and ($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:IdentificativoOperatoreDonor[1]='TLC' or $Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:IdentificativoOperatoreDonor[1]='KEA') and (string($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/node()/ns:CodiceOpRecipient)='TLC' or 