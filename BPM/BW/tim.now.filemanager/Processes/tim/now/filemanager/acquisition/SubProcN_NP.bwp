                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Token&quot;/>&lt;xsl:template name=&quot;RenderXml1-input&quot; match=&quot;/&quot;>&lt;Richiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin)&quot;>&lt;Portin>&lt;TipoComunicazione>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:TipoComunicazione&quot;/>&lt;/TipoComunicazione>&lt;CodiceOrdine>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:CodiceOrdine&quot;/>&lt;/CodiceOrdine>&lt;DataOrdine>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:DataOrdine&quot;/>&lt;/DataOrdine>&lt;DirectoryNumber>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:DirectoryNumber&quot;/>&lt;/DirectoryNumber>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:TipoLinea&quot;>&lt;TipoLinea>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:TipoLinea&quot;/>&lt;/TipoLinea>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;matches($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)') &quot;>&lt;Note>&lt;xsl:value-of select=&quot;translate($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:Note, '0123456789', '         ')&quot;/>&lt;/Note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:Note&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:Note&quot;/>&lt;/Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DataInvioMessaggio>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:DataInvioMessaggio&quot;/>&lt;/DataInvioMessaggio>&lt;IdentificativoOperatoreDonor>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:IdentificativoOperatoreDonor&quot;/>&lt;/IdentificativoOperatoreDonor>&lt;xsl:if test=&quot;$Token/tns:ResponseCreate_token/tns:Nome&quot;>&lt;NomeCliente>&lt;xsl:value-of select=&quot;$Token/tns:ResponseCreate_token/tns:Nome&quot;/>&lt;/NomeCliente>&lt;/xsl:if>&lt;CognomeCliente_RagioneSociale>&lt;xsl:value-of select=&quot;$Token/tns:ResponseCreate_token/tns:CognomeRagioneSociale&quot;/>&lt;/CognomeCliente_RagioneSociale>&lt;TelefonoReferenteRichiedente>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:TelefonoReferenteRichiedente&quot;/>&lt;/TelefonoReferenteRichiedente>&lt;EmailReferenteRichiedente>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:EmailReferenteRichiedente&quot;/>&lt;/EmailReferenteRichiedente>&lt;xsl:if test=&quot;string-length($Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:Correlazioni/ns:IdentificativoCorrelazioni)>0&quot;>&lt;Correlazioni>&lt;IdentificativoCorrelazioni>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:Correlazioni/ns:IdentificativoCorrelazioni&quot;/>&lt;/IdentificativoCorrelazioni>&lt;TotaleRichieste>&lt;xsl:value-of select=&quot;$Start/ns:ComunicazioneNP/ns:Richiesta[number($index)]/ns:Portin/ns:Correlazioni/ns:TotaleRichieste&quot;/>&lt;/TotaleRichieste>&lt;/Correlazioni>&lt;/xsl:if>&lt;CodiceOpRecipient>&lt;xsl:value-of