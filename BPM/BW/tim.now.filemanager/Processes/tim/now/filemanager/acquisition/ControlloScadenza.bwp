            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Risottomissione-input"
                    name="Risottomissione"
                    outputVariable="Risottomissione"
                    tibex:xpdlId="280d113d-8a8e-4bf8-9715-b7f314953ce9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
