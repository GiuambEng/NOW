            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="e8a62ce1-aad1-4e0a-8760-123d89a4afba" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
