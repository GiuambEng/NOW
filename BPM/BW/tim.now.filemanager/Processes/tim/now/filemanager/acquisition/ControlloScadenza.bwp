                    name="Risottomission" outputVariable="STATO"
                    tibex:xpdlId="adb3e941-42af-47b4-ba46-40ffc3778c7f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
