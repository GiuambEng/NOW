        <bpws:variable element="ns1:Output" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="STATO" type="xsd:string">
            <bpws:from>
                <bpws:literal>OK</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns0:LogData"
            name="LogFileProcessato-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:LogData"
            name="LogFileProcstoSCADUTO-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:jdbcUpdateActivityInput"
            name="FileProcsto-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:jdbcUpdateActivityOutput"
            name="FileProcsto" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Performance/Timeout" type="xsd:int"/>
        <bpws:variable element="ns4:jdbcUpdateActivityInput"
            name="FileProcstoInput-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:jdbcUpdateActivityOutput"
            name="FileProcstoInput" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:jdbcUpdateActivityInput"
            name="EsecProcsoFile-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:jdbcUpdateActivityOutput"
            name="EsecProcsoFile" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:ActivityInput" name="LogInput-input" sca-bpel:internal="true"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable element="ns6:ActivityInput"
            name="LogOutput-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:jdbcQueryActivityInput"
            name="Risottomissione-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:resultSet" name="Risottomissione" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:ActivityInput" name="LogRisot-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogFileProcstoSCADUTOToJDBCUpdate" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdateToJDBCUpdate1" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCUpdate1ToJDBCUpdate2" tibex:linkType="SUCCESS"/>
                <bpws:link name="EsecProcsoFileToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogRisotToCalcolaScadenza" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogRisotToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RisottomissioneToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="RisottomissionToLogOutput" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="90855b71-ff6b-4a81-950c-8ac09b5ddb70"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="3871543a-ff94-45fd-9433-5f75b3f6cffa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/ControlloScadenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;STATO&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Output>&#xa;            &lt;xsl:value-of select=&quot;$STATO&quot;/>&#xa;        &lt;/ns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="STATO"
                    name="CalcolaScadenza" outputVariable="STATO"
                    tibex:xpdlId="f2586880-ca53-4210-9970-6ca0fd2d7fbf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogRisotToCalcolaScadenza"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$STATO=&quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$STATO="OK"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(tib:compare-date(tib:parse-date(&quot;yyyy-MM-dd&quot;, format-date(tib:add-to-date(current-date(),0,0,-1), &quot;[Y0001]-[M01]-[D01]&quot;)), tib:parse-date(&quot;yyyy-MM-dd&quot;, format-date($Start/ns1:DataFile, &quot;[Y0001]-[M01]-[D01]&quot;)))=1 or tib:compare-date(tib:parse-date(&quot;yyyy-MM-dd&quot;, format-date(current-date(), &quot;[Y0001]-[M01]-[D01]&quot;)),tib:parse-date(&quot;yyyy-MM-dd&quot;, format-date($Start/ns1:DataFile, &quot;[Y0001]-[M01]-[D01]&quot;)))=-1) then &quot;SCADUTO&quot; else &quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="STATO" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogFileProcessato-input"
                    name="LogFileProcessato"
                    tibex:xpdlId="080acde3-f9a0-4502-9ea9-9735e2e009c8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1464255115306&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/ControlloScadenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:LogData>&#xa;            &lt;tns2:ID_File>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:IDFile&quot;/>&#xa;            &lt;/tns2:ID_File>&#xa;            &lt;tns2:Message>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;File non scaduto&amp;quot;&quot;/>&#xa;            &lt;/tns2:Message>&#xa;            &lt;tns2:ParentProcessInstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns2:ParentProcessInstanceID>&#xa;        &lt;/tns2:LogData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.InfoLog" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogFileProcstoSCADUTO-input"
                    name="LogFileProcstoSCADUTO"
                    tibex:xpdlId="7d3b3284-5f43-432e-92c9-bdaf95f2b5dd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogFileProcstoSCADUTOToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/ControlloScadenza&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1464255115306&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:LogData>&#xa;            &lt;tns2:ID_File>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:IDFile&quot;/>&#xa;            &lt;/tns2:ID_File>&#xa;            &lt;tns2:Message>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;File scaduto&amp;quot;&quot;/>&#xa;            &lt;/tns2:Message>&#xa;            &lt;tns2:ParentProcessInstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns2:ParentProcessInstanceID>&#xa;        &lt;/tns2:LogData>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.ErrorLog" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FileProcsto-input" name="FileProcsto"
                    outputVariable="FileProcsto"
                    tibex:xpdlId="5b53b785-b9a4-46cd-8da2-b56e538ee545" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogFileProcstoSCADUTOToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToJDBCUpdate1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5b53b785-b9a4-46cd-8da2-b56e538ee545+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/ControlloScadenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;FileProcsto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;TIMSTP_CHIUSURA_FILE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_CHIUSURA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($Start/ns:NomeFile,'_NPNG')&quot;>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;concat(substring-before($Start/ns:NomeFile, &amp;quot;_NPNG.xml&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NOME_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:NomeFile&quot;/>&#xa;                    &lt;/NOME_FILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:IDFile&quot;/>&#xa;            &lt;/ID_FILE>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO&#xa;  SET ESITO = 'KO', DESCR_STATO_FILE ='SCADUTO', TIMSTP_CHIUSURA_FILE = ?&#xa;  WHERE NOME_FILE = ? AND ID_FILE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_CHIUSURA_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_FILE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="FileProcstoInput-input"
                    name="FileProcstoInput"
                    outputVariable="FileProcstoInput"
                    tibex:xpdlId="dc61f05e-cb44-47ce-93b0-48e18eaceab2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToJDBCUpdate1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdate1ToJDBCUpdate2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dc61f05e-cb44-47ce-93b0-48e18eaceab2+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/ControlloScadenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;FileProcstoInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;DATA_ARRIVO>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:DataFile&quot;/>&#xa;            &lt;/DATA_ARRIVO>&#xa;            &lt;DIMENSIONE_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:Size&quot;/>&#xa;            &lt;/DIMENSIONE_FILE>&#xa;            &lt;QT_RECD_KO>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/QT_RECD_KO>&#xa;            &lt;QT_RECD_NOW>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/QT_RECD_NOW>&#xa;            &lt;QT_RECD_OK>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/QT_RECD_OK>&#xa;            &lt;QT_RECD_TOTALI>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/QT_RECD_TOTALI>&#xa;            &lt;ID_FILE_PROCSTO_INPUT>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:IDFile&quot;/>&#xa;            &lt;/ID_FILE_PROCSTO_INPUT>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO FILE_PROCSTO_INPUT(DATA_ARRIVO, DIMENSIONE_FILE,QT_RECD_KO, QT_RECD_NOW, QT_RECD_OK, QT_RECD_TOTALI,ID_FILE_PROCSTO_INPUT)&#xa;VALUES (?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_ARRIVO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="DIMENSIONE_FILE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_KO"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_NOW"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_OK"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="QT_RECD_TOTALI"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE_PROCSTO_INPUT"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="EsecProcsoFile-input"
                    name="EsecProcsoFile"
                    outputVariable="EsecProcsoFile"
                    tibex:xpdlId="beee4bef-d56d-46ac-90a7-17d76f1295a7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdate1ToJDBCUpdate2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EsecProcsoFileToLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+beee4bef-d56d-46ac-90a7-17d76f1295a7+input&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/ControlloScadenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:IDEsecProcsoFile&quot;/>&#xa;            &lt;/ID_ESEC_PROCSO_FILE>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
