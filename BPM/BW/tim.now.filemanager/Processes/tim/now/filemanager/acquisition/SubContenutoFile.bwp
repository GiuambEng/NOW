                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DatiFile-input" name="DatiFile"
                    outputVariable="DatiFile"
                    tibex:xpdlId="35bf595b-679f-40a8-81bb-c66cb2e4133a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToJDBCQuery"/>
