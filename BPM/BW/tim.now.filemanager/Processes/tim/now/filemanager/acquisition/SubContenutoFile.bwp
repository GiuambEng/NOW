                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ListFiles&quot;/>&lt;xsl:template name=&quot;ReadFile1-input&quot; match=&quot;/&quot;>&lt;tns:ReadActivityInputClass>&lt;xsl:if test=&quot;$ListFiles/files/fileInfo[1]/fullName&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;$ListFiles/files/fileInfo[1]/fullName&quot;/>&lt;/fileName>&lt;/xsl:if>&lt;/tns:ReadActivityInputClass>&lt;/xsl:template>&lt;/xsl:stylesheet>"
