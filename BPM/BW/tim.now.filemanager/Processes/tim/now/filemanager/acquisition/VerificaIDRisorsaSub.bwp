            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f50b6cf4-f721-4f58-afea-bb034aa3034c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&lt;xsl:template name=&quot;NumF-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, 2, 1)='2' or substring($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, 2, 1)='6'&quot;>&lt;NUMEROFITTIZIO2>&lt;xsl:value-of select=&quot;concat('0',$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa)&quot;/>&lt;/NUMEROFITTIZIO2>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, 3, 1)='0' or substring($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, 3, 1)='1' or substring($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, 3, 1)='5' or substring($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, 3, 1)='9'&quot;>&lt;NUMEROFITTIZIO2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMEROFITTIZIO2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NUMEROFITTIZIO2>&lt;xsl:value-of select=&quot;substring($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, 2, string-length($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa)-1)&quot;/>&lt;/NUMEROFITTIZIO2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="NumF-input" name="NumF"
                    outputVariable="NumF"
                    tibex:xpdlId="f50b6cf4-f721-4f58-afea-bb034aa3034c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
