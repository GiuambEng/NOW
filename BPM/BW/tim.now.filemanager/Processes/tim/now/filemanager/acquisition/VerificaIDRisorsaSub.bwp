                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+540ab0d1-8cbf-4223-b249-c6847784d991+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcolaIdRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;number($index)=1&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO,&amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.IDRISORSA = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;number($index)=2&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,&amp;#xD;&amp;#xA;F.DESCR,&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,&amp;#xD;&amp;#xA;TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROTELEFONICO = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;number($index)=3&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.CODICEISTATCOMUNE,A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$CalcolaIdRisorsa/tns1:IDRisorsa,&amp;quot;'AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
