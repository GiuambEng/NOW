                                    sqlStatement="SELECT OFFERTA, STATOASSET, IDASSET, IDOFFERTA,CODICEISTATCOMUNE&#xd;&#xa;FROM BDS_1_CASEDATA_ASSET&#xd;&#xa;WHERE IDRISORSA = ? &#xd;&#xa;AND (STATOASSET = 'ATTIVO' OR STATOASSET = 'INLAVORAZIONE') &#xd;&#xa;AND TIPOLOGIAACCESSO = 'FONIA'" xsi:type="jdbcPalette:JDBCQueryActivity">
