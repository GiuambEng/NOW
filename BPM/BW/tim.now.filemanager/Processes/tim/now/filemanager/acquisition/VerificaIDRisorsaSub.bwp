                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICEISTATCOMUNE FROM BDS_1_CASEDATA_ASSET&#xa;WHERE&#xa;NUMEROFITTIZIO=? AND (STATOASSET = 'ATTIVO' OR STATOASSET = 'INLAVORAZIONE')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
