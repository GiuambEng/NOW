                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f50b6cf4-f721-4f58-afea-bb034aa3034c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:template name=&quot;NumF-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 2, 1)='2' or substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 2, 1)='6'&quot;>&#xa;                    &lt;NUMEROFITTIZIO2>&#xa;                        &lt;xsl:value-of select=&quot;concat('0',$VerificaIDRisorsaSub.input/tns1:IDRisorsa)&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='0' or substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='1' or substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='5' or substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='9'&quot;>&#xa;                    &lt;NUMEROFITTIZIO2>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaIDRisorsaSub.input/tns1:IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMEROFITTIZIO2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROFITTIZIO2>&#xa;                        &lt;xsl:value-of select=&quot;substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 2, string-length($VerificaIDRisorsaSub.input/tns1:IDRisorsa)-1)&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
