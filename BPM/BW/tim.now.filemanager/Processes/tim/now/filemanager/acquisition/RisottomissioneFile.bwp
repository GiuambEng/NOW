                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5f601cff-f964-428c-8d61-5fce0fe093de+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/RisottomissioneFile/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RisottomissioneFileIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:template name=&quot;Errore_LogFileProcsto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;COD_PROCSO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ALIMENTATORE_NOW&amp;quot;&quot;/>&#xa;            &lt;/COD_PROCSO>&#xa;            &lt;ID_ESEC_PROCSO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($DatiFile/Record[1]/ID_ESEC_PROCSO_FILE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/ID_ESEC_PROCSO_FILE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ESEC_PROCSO>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$RisottomissioneFileIn.parameters/ID_FILE&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;LOG_LEVEL>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;            &lt;/LOG_LEVEL>&#xa;            &lt;LOG_MESSAGE>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Palette fallita: &amp;quot;, $FaultDetails/ActivityName, &amp;quot; Codice errore: &amp;quot;, $FaultDetails/MsgCode, &amp;quot; Messaggio errore: &amp;quot;, tib:render-xml($FaultDetails,true(),true()),&amp;quot; JobId: &amp;quot;,$_processContext/JobId, &amp;quot; ProcessInstanceId: &amp;quot;, $_processContext/ProcessInstanceId, &amp;quot; Timestamp: &amp;quot;,string(current-dateTime()))&quot;/>&#xa;            &lt;/LOG_MESSAGE>&#xa;            &lt;TIMSTP_INSMTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
