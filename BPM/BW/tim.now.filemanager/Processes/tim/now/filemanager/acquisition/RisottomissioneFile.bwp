ione/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;ns:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns:CodiceOrdine>&#xa;                                    &lt;ns:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/DataOrdine&quot;/>&#xa;                                    &lt;/ns:DataOrdine>&#xa;                                    &lt;ns:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns:DirectoryNumber>&#xa;                                    &lt;ns:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                    &lt;ns:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns:DataInvioMessaggio>&#xa;                                    &lt;xsl:if test=&quot;Valid_Tecnica_Cessazione/Note&quot;>&#xa;                                        &lt;ns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/Note&quot;/>&#xa;                                        &lt;/ns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:if test=&quot;Valid_Tecnica_Cessazione/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Tecnica_Cessazione/Telecom&quot;>&#xa;                                        &lt;ns:Telecom>&#xa;                                            &lt;xsl:for-each select=&quot;Rientro&quot;>&#xa;                                                &lt;ns:Rientro>&#xa;                                                    &lt;ns:RientroTI>&#xa;                                                        &lt;xsl:value-of select=&quot;RientroTI&quot;/>&#xa;                                                    &lt;/ns:RientroTI>&#xa;                                                    &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                        &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                                    &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                                    &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                        &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                                    &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                                    &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                        &lt;ns:NomeCliente>&#xa;                                                            &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                        &lt;/ns:NomeCliente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                        &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                                    &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                                    &lt;ns:EmailReferenteRichiedente>&#xa;                                                        &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                                    &lt;/ns:EmailReferenteRichiedente>&#xa;                                                    &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                        &lt;ns:Correlazioni>&#xa;                                                            &lt;ns:IdentificativoCorrelazioni>&#xa;                                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                            &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                            &lt;ns:TotaleRichieste>&#xa;                                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                            &lt;/ns:TotaleRichieste>&#xa;                                                        &lt;/ns:Correlazioni>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:Rientro>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:for-each select=&quot;NPAggiuntive&quot;>&#xa;                                                &lt;ns:NPAggiuntive>&#xa;                                                    &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                        &lt;ns:NumAggiuntivaPortata>&#xa;                                                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                        &lt;/ns:NumAggiuntivaPortata>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:NPAggiuntive>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:Telecom>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Tecnica_Cessazione/EsitoVerifica&quot;>&#xa;                                        &lt;ns:EsitoVerifica>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists(EsitoKO)&quot;>&#xa;                                                    &lt;ns:EsitoKO>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns:CodiceMotivoRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/CodiceMotivoRifiuto&quot;/>&#xa;                                                        &lt;/ns:CodiceMotivoRifiuto>&#xa;                                                        &lt;ns:DescrizioneRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/DescrizioneRifiuto&quot;/>&#xa;                                                        &lt;/ns:DescrizioneRifiuto>&#xa;                                                    &lt;/ns:EsitoKO>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns:EsitoOK>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoOK/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                    &lt;/ns:EsitoOK>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/ns:EsitoVerifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns:Valid_Tecnica_Cessazione>&#xa;                            &lt;/ns:Risposta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns:ComunicazioneNP>&#xa;            &lt;ns:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/NOME_FILE&quot;/>&#xa;            &lt;/ns:NomeFile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;ns:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns:CodIspIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns:CodIspIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns2:Lavorate/tns1:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns1:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns1:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns1:RichiesteLavorate>&#xa;            &lt;xsl:if test=&quot;count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1'&quot;>&#xa;                &lt;ns:FlagOscuramento>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/ns:FlagOscuramento>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($DatiFile/Record[1]/TIMSTP_APERTURA_FILE)&quot;>&#xa;                &lt;xsl:if test=&quot;$DatiFile/Record[1]/TIMSTP_APERTURA_FILE&quot;>&#xa;                    &lt;ns:TimstpAperturaFile>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/TIMSTP_APERTURA_FILE&quot;/>&#xa;                    &lt;/ns:TimstpAperturaFile>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubProcR_NP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
