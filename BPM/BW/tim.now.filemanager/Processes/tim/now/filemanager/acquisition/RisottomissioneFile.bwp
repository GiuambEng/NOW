                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;EstrazioneOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:template name=&quot;CodiciOlo&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CodiciOlo>&#xa;            &lt;xsl:for-each select=&quot;$EstrazioneOLO/tns2:codes&quot;>&#xa;                &lt;xsl:copy-of select=&quot;.&quot;/>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;count($EstrazioneOLO/tns2:codes) = 0 and string-length($DatiFile/Record[1]/COD_OLO) > 0 and string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM) > 0&quot;>&#xa;                &lt;tns2:codes>&#xa;                    &lt;tns2:CodiceOLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/tns2:CodiceOLO>&#xa;                    &lt;tns2:CodiceOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns2:CodiceOLOAGCOM>&#xa;                &lt;/tns2:codes>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:CodiciOlo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
