&lt;/ns:IdentificativoCorrelazioni>&#xa;                                                            &lt;ns:TotaleRichieste>&#xa;                                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                            &lt;/ns:TotaleRichieste>&#xa;                                                        &lt;/ns:Correlazioni>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:Rientro>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:for-each select=&quot;NPAggiuntive&quot;>&#xa;                                                &lt;ns:NPAggiuntive>&#xa;                                                    &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                        &lt;ns:NumAggiuntivaPortata>&#xa;                                                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                        &lt;/ns:NumAggiuntivaPortata>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:NPAggiuntive>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:Telecom>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns:DataEspletamentoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/DataEspletamentoOrdine&quot;/>&#xa;                                    &lt;/ns:DataEspletamentoOrdine>&#xa;                                &lt;/ns:Espletamento_Cessazione>&#xa;                            &lt;/ns:Risposta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists(Valid_Formale_Cessazione)&quot;>&#xa;                            &lt;ns:Risposta>&#xa;                                &lt;ns:Valid_Formale_Cessazione>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;ns:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns:CodiceOrdine>&#xa;                                    &lt;ns:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/DataOrdine&quot;/>&#xa;                                    &lt;/ns:DataOrdine>&#xa;                                    &lt;ns:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns:DirectoryNumber>&#xa;                                    &lt;ns:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                    &lt;ns:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns:DataInvioMessaggio>&#xa;                                    &lt;xsl:if test=&quot;Valid_Formale_Cessazione/Note&quot;>&#xa;                                        &lt;ns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/Note&quot;/>&#xa;                                        &lt;/ns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:if test=&quot;Valid_Formale_Cessazione/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_Cessazione/Telecom&quot;>&#xa;                                        &lt;ns:Telecom>&#xa;                                            &lt;xsl:for-each select=&quot;Rientro&quot;>&#xa;                                                &lt;ns:Rientro>&#xa;                                                    &lt;ns:RientroTI>&#xa;                                                        &lt;xsl:value-of select=&quot;RientroTI&quot;/>&#xa;                                                    &lt;/ns:RientroTI>&#xa;                                                    &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                        &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                                    &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                                    &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                        &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                                    &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                                    &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                        &lt;ns:NomeCliente>&#xa;                                                            &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                        &lt;/ns:NomeCliente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                        &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                                    &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                                    &lt;ns:EmailReferenteRichiedente>&#xa;                                                        &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                                    &lt;/ns:EmailReferenteRichiedente>&#xa;                                                    &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                        &lt;ns:Correlazioni>&#xa;                                                            &lt;ns:IdentificativoCorrelazioni>&#xa;                                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                            &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                            &lt;ns:TotaleRichieste>&#xa;                                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                            &lt;/ns:TotaleRichieste>&#xa;                                                        &lt;/ns:Correlazioni>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:Rientro>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:for-each select=&quot;NPAggiuntive&quot;>&#xa;                                                &lt;ns:NPAggiuntive>&#xa;                                                    &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                        &lt;ns:NumAggiuntivaPortata>&#xa;                                                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                        &lt;/ns:NumAggiuntivaPortata>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:NPAggiuntive>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:Telecom>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_Cessazione/EsitoVerifica&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists(EsitoKO)&quot;>&#xa;                                                &lt;ns:EsitoVerifica>&#xa;                                                    &lt;ns:EsitoKO>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns:CodiceMotivoRifiuto>&#xa;                                                            &lt;xsl:value-of select