            <bpws:invoke inputVariable="ReplaceCharacterInvoke-input"
                name="ReplaceCharacterInvoke"
                operation="ReplaceCharacter"
                outputVariable="ReplaceCharacterInvoke"
                partnerLink="ReplaceCharacter"
                portType="ns52:ReplaceCharacterPortType" tibex:xpdlId="50e78ff9-e789-43ad-9198-c78417de88f7">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter" xmlns:tns1="http://www.tim.com/NOW/xsd/ReplaceCharacter" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="DatiFile"/&gt;
    &lt;xsl:param name="ListFiles"/&gt;
    &lt;xsl:param name="ReadFile"/&gt;
    &lt;xsl:template name="ReplaceCharacterInvoke-input" match="/"&gt;
        &lt;tns2:ReplaceCharacterRequest&gt;
            &lt;ReplaceCharacterInput&gt;
                &lt;tns1:InputString&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($ListFiles/files/fileInfo)&gt;0"&gt;
                            &lt;tns1:OldString&gt;
                                &lt;xsl:value-of select="$ReadFile/fileContent/textContent"/&gt;
                            &lt;/tns1:OldString&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:OldString&gt;
                                &lt;xsl:value-of select="tib:base64-to-string(string($DatiFile/Record[1]/CONTENUTO_FILE))"/&gt;
                            &lt;/tns1:OldString&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns1:OldChar&gt;
                        &lt;xsl:value-of select="&amp;quot;^M&amp;quot;"/&gt;
                    &lt;/tns1:OldChar&gt;
                    &lt;tns1:NewChar&gt;
                        &lt;xsl:value-of select="&amp;quot;&amp;#xA;&amp;quot;"/&gt;
                    &lt;/tns1:NewChar&gt;
                &lt;/tns1:InputString&gt;
            &lt;/ReplaceCharacterInput&gt;
        &lt;/tns2:ReplaceCharacterRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;ListFiles&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFile&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplaceCharacterInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputString>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($ListFiles/files/fileInfo)>0&quot;>&#xa;                    &lt;tns1:OldString>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFile/fileContent/textContent&quot;/>&#xa;                    &lt;/tns1:OldString>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:OldString>&#xa;                        &lt;xsl:value-of select=&quot;tib:base64-to-string(string($DatiFile/Record[1]/CONTENUTO_FILE))&quot;/>&#xa;                    &lt;/tns1:OldString>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:OldChar>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;^M&amp;quot;&quot;/>&#xa;            &lt;/tns1:OldChar>&#xa;            &lt;tns1:NewChar>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;#xA;&amp;quot;&quot;/>&#xa;            &lt;/tns1:NewChar>&#xa;        &lt;/tns1:InputString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogToReplaceCharacterInvoke"/>
                    <bpws:target linkName="Empty1ToReplaceCharacterInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ReplaceCharacterInvokeToScope"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:invoke inputVariable="getNextWorkingDay-input"
                name="getNextWorkingDay" operation="calcNextWorkingDate"
                outputVariable="getNextWorkingDay"
                partnerLink="GetNextDatePortType" portType="ns53:GetNextDatePortType">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="DatiFile"/&gt;
    &lt;xsl:template name="getNextWorkingDay-input" match="/"&gt;
        &lt;tns3:calcNextWorkingDateRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:CalcRequest&gt;
                    &lt;tns1:inputDate&gt;
                        &lt;xsl:value-of select="xsd:date($DatiFile/Record[1]/DATA_FILE)"/&gt;
                    &lt;/tns1:inputDate&gt;
                    &lt;tns1:TipoData&gt;
                        &lt;xsl:value-of select="&amp;quot;DRO&amp;quot;"/&gt;
                    &lt;/tns1:TipoData&gt;
                &lt;/tns1:CalcRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns3:calcNextWorkingDateRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:template name=&quot;getNextWorkingDay-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CalcRequest>&#xa;            &lt;tns1:inputDate>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($DatiFile/Record[1]/DATA_FILE)&quot;/>&#xa;            &lt;/tns1:inputDate>&#xa;            &lt;tns1:TipoData>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DRO&amp;quot;&quot;/>&#xa;            &lt;/tns1:TipoData>&#xa;        &lt;/tns1:CalcRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="EmptyTogetNextWorkingDay"/>
                    <bpws:target linkName="JDBCUpdate1TogetNextWorkingDay"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="getNextWorkingDayToJDBCQuery"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;NGA_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns1:codes)&quot;>&#xa;                &lt;tns1:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns1:codes&quot;/>&#xa;                &lt;/tns1:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;ns2:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns2:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns2:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns2:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns2:CodAGCOMint>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns2:CodAGCOMint>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns2:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/ID_FILE&quot;/>&#xa;            &lt;/ns2:ID_FILE>&#xa;            &lt;ns2:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/DATA_FILE&quot;/>&#xa;            &lt;/ns2:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;ns2:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                    &lt;/ns2:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns2:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns4:Response/tns4:outputDate&quot;/>&#xa;                    &lt;/ns2:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns0:TracciatoOLONGA>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlNGA/ns0:Richiesta&quot;>&#xa;                    &lt;ns0:Richiesta>&#xa;                        &lt;ns0:Testata>&#xa;                            &lt;ns0:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                            &lt;/ns0:CodiceOlo>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                                &lt;ns0:CodiceOrdineOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                                &lt;ns0:CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                                &lt;ns0:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                                &lt;/ns0:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:Note&quot;>&#xa;                                &lt;ns0:Note>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:Note&quot;/>&#xa;                                &lt;/ns0:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:TestMode&quot;>&#xa;                                &lt;ns0:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:TestMode&quot;/>&#xa;                                &lt;/ns0:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:Testata>&#xa;                        &lt;xsl:copy-of select=&quot;ns0:TipoRichiesta&quot;/>&#xa;                    &lt;/ns0:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns0:TracciatoOLONGA>&#xa;            &lt;tns3:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns2:Lavorate/tns3:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns3:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns3:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns3:RichiesteLavorate>&#xa;        &lt;/ns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="NGA_SUBPROCESS-input"
                    name="NGA_SUBPROCESS"
                    outputVariable="NGA_SUBPROCESS"
                    tibex:xpdlId="d0ea7485-acab-4a97-b629-73aa86750d74"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToNGA_SUBPROCESS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NGA_SUBPROCESSToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;NGA_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns1:codes)&quot;>&#xa;                &lt;tns1:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns1:codes&quot;/>&#xa;                &lt;/tns1:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;ns2:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns2:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns2:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns2:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;ns2:CodAGCOMint>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns2:CodAGCOMint>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;ns2:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/ID_FILE&quot;/>&#xa;            &lt;/ns2:ID_FILE>&#xa;            &lt;ns2:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/DATA_FILE&quot;/>&#xa;            &lt;/ns2:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;ns2:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                    &lt;/ns2:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns2:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns4:outputDate&quot;/>&#xa;                    &lt;/ns2:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns0:TracciatoOLONGA>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlNGA/ns0:Richiesta&quot;>&#xa;                    &lt;ns0:Richiesta>&#xa;                        &lt;ns0:Testata>&#xa;                            &lt;ns0:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                            &lt;/ns0:CodiceOlo>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                                &lt;ns0:CodiceOrdineOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                                &lt;ns0:CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                                &lt;ns0:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                                &lt;/ns0:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:Note&quot;>&#xa;                                &lt;ns0:Note>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:Note&quot;/>&#xa;                                &lt;/ns0:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:TestMode&quot;>&#xa;                                &lt;ns0:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:TestMode&quot;/>&#xa;                                &lt;/ns0:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:Testata>&#xa;                        &lt;xsl:copy-of select=&quot;ns0:TipoRichiesta&quot;/>&#xa;                    &lt;/ns0:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns0:TracciatoOLONGA>&#xa;            &lt;tns3:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns2:Lavorate/tns3:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns3:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns3:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns3:RichiesteLavorate>&#xa;        &lt;/ns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubProcNGA_NEW" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="ContatoriXDSL" outputVariable="Contatori"
                    tibex:xpdlId="5325f7c8-e878-4279-9f68-71e39ce81eac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToADD_xDSL_NOW_COUNTER"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ContatoriXDSLToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Contatori&quot;/>&#xa;    &lt;xsl:param name=&quot;xDSL_SUBPROCESS&quot;/>&#xa;    &lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Contatori>&#xa;            &lt;tns2:StringaCRMWS>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns2:StringaCRMWS,$xDSL_SUBPROCESS/tns2:StringaCRMWS)&quot;/>&#xa;            &lt;/tns2:StringaCRMWS>&#xa;            &lt;tns2:StringaSDR>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns2:StringaSDR,$xDSL_SUBPROCESS/tns2:StringaSDR)&quot;/>&#xa;            &lt;/tns2:StringaSDR>&#xa;            &lt;tns2:StringaDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$Contatori/tns2:StringaDBCFX&quot;/>&#xa;            &lt;/tns2:StringaDBCFX>&#xa;            &lt;tns2:ContatoreCRMWS>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreCRMWS+$xDSL_SUBPROCESS/tns2:ContatoreCRMWS)&quot;/>&#xa;            &lt;/tns2:ContatoreCRMWS>&#xa;            &lt;tns2:ContatoreSDR>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreSDR+$xDSL_SUBPROCESS/tns2:ContatoreSDR)&quot;/>&#xa;            &lt;/tns2:ContatoreSDR>&#xa;            &lt;tns2:ContatoreDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$Contatori/tns2:ContatoreDBCFX&quot;/>&#xa;            &lt;/tns2:ContatoreDBCFX>&#xa;            &lt;tns2:ContatoreNOW>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreNOW+$xDSL_SUBPROCESS/tns2:ContatoreNOW)&quot;/>&#xa;            &lt;/tns2:ContatoreNOW>&#xa;            &lt;tns2:ContatoreKO>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreKO+$xDSL_SUBPROCESS/tns2:ContatoreKO)&quot;/>&#xa;            &lt;/tns2:ContatoreKO>&#xa;        &lt;/tns2:Contatori>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Contatori" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty2" tibex:xpdlId="6ded50a7-fe43-468c-8be1-fa1031e01126">
                <bpws:targets>
                    <bpws:target linkName="LogFlagOscuramentoToEmpty2"/>
                    <bpws:target linkName="LogDateToEmpty2"/>
                    <bpws:target linkName="Assign2ToEmpty2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty2ToNGA_NGA">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with($DatiFile/Record[1]/NOME_FILE, $NGAPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with($DatiFile/Record[1]/NOME_FILE, $NGAPref)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty2ToxDSL_xDSL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with($DatiFile/Record[1]/NOME_FILE, $ADSLPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with($DatiFile/Record[1]/NOME_FILE, $ADSLPref)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty2ToATT-ANN_Cycle">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty2ToLog1_NNP">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with($DatiFile/Record[1]/NOME_FILE, $N_NP_pref) or starts-with($DatiFile/Record[1]/NOME_FILE,concat($T3_pref,$N_NP_pref))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with($DatiFile/Record[1]/NOME_FILE, $N_NP_pref) or starts-with($DatiFile/Record[1]/NOME_FILE,concat($T3_pref,$N_NP_pref))]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty2ToLog11_RNP">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with($DatiFile/Record[1]/NOME_FILE, $R_NP_pref) or starts-with($DatiFile/Record[1]/NOME_FILE,concat($T3_pref,$R_NP_pref))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with($DatiFile/Record[1]/NOME_FILE, $R_NP_pref) or starts-with($DatiFile/Record[1]/NOME_FILE,concat($T3_pref,$R_NP_pref))]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogXdsl-input"
                    name="LogXdsl"
                    tibex:xpdlId="5f133c95-70af-47c9-8e9b-4c7a43fd2681" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToxDSL_xDSL"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogXdslToADD_xDSL_NOW_COUNTER"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&#xa;    &lt;xsl:template name=&quot;LogXdsl-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto validato per xDSL: &amp;#xD;&amp;#xA;&amp;quot;,tib:render-xml($ParseXmlxDSL))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Debug"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;xDSL_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns5:codes)&quot;>&#xa;                &lt;tns5:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns5:codes&quot;/>&#xa;                &lt;/tns5:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;tns1:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/tns1:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/tns1:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns1:CodAGCOMint>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns1:CodAGCOMint>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/ID_FILE&quot;/>&#xa;            &lt;/tns1:ID_FILE>&#xa;            &lt;tns1:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/DATA_FILE&quot;/>&#xa;            &lt;/tns1:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;tns1:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                    &lt;/tns1:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns2:Response/tns2:outputDate&quot;/>&#xa;                    &lt;/tns1:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns0:Richiesta&quot;>&#xa;                &lt;tns1:ContenutoXml>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml(.)&quot;/>&#xa;                &lt;/tns1:ContenutoXml>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;ns0:TracciatoOLOxDSL>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns0:Richiesta&quot;>&#xa;                    &lt;ns0:Richiesta>&#xa;                        &lt;ns0:Testata>&#xa;                            &lt;ns0:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                            &lt;/ns0:CodiceOlo>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                                &lt;ns0:CodiceOrdineOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                                &lt;ns0:CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                                &lt;ns0:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                                &lt;/ns0:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:Note&quot;>&#xa;                                &lt;ns0:Note>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:Note&quot;/>&#xa;                                &lt;/ns0:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:TestMode&quot;>&#xa;                                &lt;ns0:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:TestMode&quot;/>&#xa;                                &lt;/ns0:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:Testata>&#xa;                        &lt;xsl:copy-of select=&quot;ns0:TipoRichiesta&quot;/>&#xa;                    &lt;/ns0:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns0:TracciatoOLOxDSL>&#xa;            &lt;tns4:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns3:Lavorate/tns4:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns4:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns4:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns4:RichiesteLavorate>&#xa;        &lt;/tns1:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="xDSL_SUBPROCESS-input"
                    name="xDSL_SUBPROCESS"
                    outputVariable="xDSL_SUBPROCESS"
                    tibex:xpdlId="ef312555-1202-4a8a-9323-192d491e6aff"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogXdslToADD_xDSL_NOW_COUNTER"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToADD_xDSL_NOW_COUNTER"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;xDSL_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns5:codes)&quot;>&#xa;                &lt;tns5:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns5:codes&quot;/>&#xa;                &lt;/tns5:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;tns1:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/tns1:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/tns1:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns1:CodAGCOMint>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns1:CodAGCOMint>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/ID_FILE&quot;/>&#xa;            &lt;/tns1:ID_FILE>&#xa;            &lt;tns1:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/DATA_FILE&quot;/>&#xa;            &lt;/tns1:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;tns1:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                    &lt;/tns1:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns2:outputDate&quot;/>&#xa;                    &lt;/tns1:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns0:Richiesta&quot;>&#xa;                &lt;tns1:ContenutoXml>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml(.)&quot;/>&#xa;                &lt;/tns1:ContenutoXml>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;ns0:TracciatoOLOxDSL>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns0:Richiesta&quot;>&#xa;                    &lt;ns0:Richiesta>&#xa;                        &lt;ns0:Testata>&#xa;                            &lt;ns0:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                            &lt;/ns0:CodiceOlo>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                                &lt;ns0:CodiceOrdineOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                                &lt;ns0:CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/ns0:CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                                &lt;ns0:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                                &lt;/ns0:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:Note&quot;>&#xa;                                &lt;ns0:Note>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:Note&quot;/>&#xa;                                &lt;/ns0:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns0:Testata/ns0:TestMode&quot;>&#xa;                                &lt;ns0:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;ns0:Testata/ns0:TestMode&quot;/>&#xa;                                &lt;/ns0:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns0:Testata>&#xa;                        &lt;xsl:copy-of select=&quot;ns0:TipoRichiesta&quot;/>&#xa;                    &lt;/ns0:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns0:TracciatoOLOxDSL>&#xa;            &lt;tns4:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns3:Lavorate/tns4:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns4:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns4:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns4:RichiesteLavorate>&#xa;        &lt;/tns1:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubprocXDSL_NEW" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LocalPath"
                    name="BuildPath" outputVariable="LocalPath"
                    tibex:xpdlId="c7cb7c80-8661-4c80-9df4-4fcb8e865d75" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Reply1ToBuildPath"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogFileInformation"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0) then (&#xd;&#xa;if (starts-with($DatiFile/Record[1]/NOME_FILE,$NGAPref)) then (concat($AcquisitionFolder,$DatiFile/Record[1]/CODFC_OLO_AGCOM,$NGAfolder)) else (&#xd;&#xa;if(starts-with($DatiFile/Record[1]/NOME_FILE,$ADSLPref)) then (concat($AcquisitionFolder,$DatiFile/Record[1]/CODFC_OLO_AGCOM,$XDSLfolder)) else(&#xd;&#xa;if(starts-with($DatiFile/Record[1]/NOME_FILE,$N_NP_pref) or starts-with($DatiFile/Record[1]/NOME_FILE,concat($T3_pref,$N_NP_pref))) then (concat($AcquisitionFolder,$DatiFile/Record[1]/CODFC_OLO_AGCOM,$N_NPfolder)) else(&#xd;&#xa;if(starts-with($DatiFile/Record[1]/NOME_FILE,$R_NP_pref) or starts-with($DatiFile/Record[1]/NOME_FILE,concat($T3_pref,$R_NP_pref))) then (concat($AcquisitionFolder,$DatiFile/Record[1]/CODFC_OLO_AGCOM,$R_NPfolder)) else(&#xd;&#xa;if (starts-with($DatiFile/Record[1]/NOME_FILE,$SDT_pref)) then (concat($AcquisitionFolder,$DatiFile/Record[1]/CODFC_OLO_AGCOM,$SDT_folder)) else (if($DatiFile/Record[1]/ID_INTRFC=$IdInterfacciaCPS) then (concat($AcquisitionFolder,$DatiFile/Record[1]/CODFC_OLO_AGCOM,$CPSfolder)) else (concat($AcquisitionFolder,$DatiFile/Record[1]/CODFC_OLO_AGCOM,$REGfolder)))))))) else ($DatiFile/Record[1]/LOCAL_PATH)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="LocalPath" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogN_NP-input"
                    name="LogN_NP"
                    tibex:xpdlId="b2ea7611-c764-41e3-8342-8070748fd7bd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToLog1_NNP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogN_NPToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlN_NP&quot;/>&#xa;    &lt;xsl:template name=&quot;Log1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto validato per N_NP: &amp;#xD;&amp;#xA;&amp;quot;,tib:render-xml($ParseXmlN_NP))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="N_NP_SUBPROCESS-input"
                    name="N_NP_SUBPROCESS"
                    outputVariable="N_NP_SUBPROCESS"
                    tibex:xpdlId="f89d258e-cac7-4678-838f-9573de6de2bd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogN_NPToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="N_NP_SUBPROCESSToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlN_NP&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;N_NP_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:IDfile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/ID_FILE)&quot;/>&#xa;            &lt;/ns:IDfile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                    &lt;ns:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:ComunicazioneNP>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlN_NP/Richiesta&quot;>&#xa;                    &lt;ns:Richiesta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(Portin)&quot;>&#xa;                                &lt;ns:Portin>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;ns:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns:CodiceOrdine>&#xa;                                    &lt;ns:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataOrdine&quot;/>&#xa;                                    &lt;/ns:DataOrdine>&#xa;                                    &lt;ns:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Portin/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Portin/Note&quot;>&#xa;                                        &lt;ns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/Note&quot;/>&#xa;                                        &lt;/ns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns:DataInvioMessaggio>&#xa;                                    &lt;ns:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:if test=&quot;Portin/NomeCliente&quot;>&#xa;                                        &lt;ns:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/NomeCliente&quot;/>&#xa;                                        &lt;/ns:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                    &lt;ns:TelefonoReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/TelefonoReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                    &lt;ns:EmailReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/EmailReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns:EmailReferenteRichiedente>&#xa;                                    &lt;xsl:for-each select=&quot;Portin/Correlazioni&quot;>&#xa;                                        &lt;ns:Correlazioni>&#xa;                                            &lt;ns:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns:IdentificativoCorrelazioni>&#xa;                                            &lt;ns:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns:TotaleRichieste>&#xa;                                        &lt;/ns:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns:CodiceOpRecipient>&#xa;                                    &lt;ns:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Portin/CodiceProgetto&quot;>&#xa;                                        &lt;ns:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Portin/FlagNPNumerazioniAggiuntive&quot;>&#xa;                                        &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                        &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns:CodiceSegreto>&#xa;                                    &lt;ns:RoutingNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/RoutingNumber&quot;/>&#xa;                                    &lt;/ns:RoutingNumber>&#xa;                                &lt;/ns:Portin>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Prenotifica_Donating)&quot;>&#xa;                                &lt;ns:Prenotifica_Donating>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;ns:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns:CodiceOrdine>&#xa;                                    &lt;ns:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataOrdine&quot;/>&#xa;                                    &lt;/ns:DataOrdine>&#xa;                                    &lt;ns:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/Note&quot;>&#xa;                                        &lt;ns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/Note&quot;/>&#xa;                                        &lt;/ns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns:DataInvioMessaggio>&#xa;                                    &lt;ns:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/NomeCliente&quot;>&#xa;                                        &lt;ns:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/NomeCliente&quot;/>&#xa;                                        &lt;/ns:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                    &lt;ns:TelefonoReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/TelefonoReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                    &lt;ns:EmailReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/EmailReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns:EmailReferenteRichiedente>&#xa;                                    &lt;xsl:for-each select=&quot;Prenotifica_Donating/Correlazioni&quot;>&#xa;                                        &lt;ns:Correlazioni>&#xa;                                            &lt;ns:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns:IdentificativoCorrelazioni>&#xa;                                            &lt;ns:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns:TotaleRichieste>&#xa;                                        &lt;/ns:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns:CodiceOpRecipient>&#xa;                                    &lt;ns:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/CodiceProgetto&quot;>&#xa;                                        &lt;ns:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/FlagNPNumerazioniAggiuntive&quot;>&#xa;                                        &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                        &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns:CodiceSegreto>&#xa;                                    &lt;ns:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:for-each select=&quot;Prenotifica_Donating/NPAggiuntive&quot;>&#xa;                                        &lt;ns:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns:Prenotifica_Donating>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Cessazione)&quot;>&#xa;                                &lt;ns:Cessazione>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;ns:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns:CodiceOrdine>&#xa;                                    &lt;ns:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DataOrdine&quot;/>&#xa;                                    &lt;/ns:DataOrdine>&#xa;                                    &lt;ns:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Cessazione/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Cessazione/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Cessazione/Note&quot;>&#xa;                                        &lt;ns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Cessazione/Note&quot;/>&#xa;                                        &lt;/ns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns:DataInvioMessaggio>&#xa;                                    &lt;ns:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:for-each select=&quot;Cessazione/Rientro&quot;>&#xa;                                        &lt;ns:Rientro>&#xa;                                            &lt;ns:RientroTI>&#xa;                                                &lt;xsl:value-of select=&quot;RientroTI&quot;/>&#xa;                                            &lt;/ns:RientroTI>&#xa;                                            &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                &lt;ns:NomeCliente>&#xa;                                                    &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                &lt;/ns:NomeCliente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                            &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                            &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                            &lt;ns:EmailReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:EmailReferenteRichiedente>&#xa;                                            &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                &lt;ns:Correlazioni>&#xa;                                                    &lt;ns:IdentificativoCorrelazioni>&#xa;                                                        &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                    &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                    &lt;ns:TotaleRichieste>&#xa;                                                        &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                    &lt;/ns:TotaleRichieste>&#xa;                                                &lt;/ns:Correlazioni>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:Rientro>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:for-each select=&quot;Cessazione/NPAggiuntive&quot;>&#xa;                                        &lt;ns:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns:Cessazione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns:Annullamento>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;ns:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns:CodiceOrdine>&#xa;                                    &lt;ns:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DataOrdine&quot;/>&#xa;                                    &lt;/ns:DataOrdine>&#xa;                                    &lt;ns:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/Note&quot;>&#xa;                                        &lt;ns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/Note&quot;/>&#xa;                                        &lt;/ns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns:DataInvioMessaggio>&#xa;                                    &lt;ns:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/NomeCliente&quot;>&#xa;                                        &lt;ns:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/NomeCliente&quot;/>&#xa;                                        &lt;/ns:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                    &lt;ns:TelefonoReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/TelefonoReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                    &lt;ns:EmailReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/EmailReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns:EmailReferenteRichiedente>&#xa;                                    &lt;xsl:for-each select=&quot;Annullamento/Correlazioni&quot;>&#xa;                                        &lt;ns:Correlazioni>&#xa;                                            &lt;ns:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns:IdentificativoCorrelazioni>&#xa;                                            &lt;ns:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns:TotaleRichieste>&#xa;                                        &lt;/ns:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns:CodiceOpRecipient>&#xa;                                    &lt;ns:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/CodiceProgetto&quot;>&#xa;                                        &lt;ns:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/FlagNPNumerazioniAggiuntive&quot;>&#xa;                                        &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                        &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns:CodiceSegreto>&#xa;                                    &lt;xsl:for-each select=&quot;Annullamento/NPAggiuntive&quot;>&#xa;                                        &lt;ns:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns:Annullamento>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns:ComunicazioneNP>&#xa;            &lt;ns:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/NOME_FILE&quot;/>&#xa;            &lt;/ns:NomeFile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;ns:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns:CodIspIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/ns:CodIspIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:Progressivi/>&#xa;            &lt;tns1:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns2:Lavorate/tns1:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns1:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns1:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns1:RichiesteLavorate>&#xa;            &lt;xsl:if test=&quot;count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1'&quot;>&#xa;                &lt;ns:FlagOscuramento>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/ns:FlagOscuramento>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($DatiFile/Record[1]/TIMSTP_APERTURA_FILE)&quot;>&#xa;                &lt;xsl:if test=&quot;$DatiFile/Record[1]/TIMSTP_APERTURA_FILE&quot;>&#xa;                    &lt;ns:TimstpAperturaFile>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/TIMSTP_APERTURA_FILE&quot;/>&#xa;                    &lt;/ns:TimstpAperturaFile>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.GroupN_NP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="ContatoriN_NP" outputVariable="Contatori"
                    tibex:xpdlId="e351a163-9b2e-4671-a215-a915e74c521e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="N_NP_SUBPROCESSToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ContatoriN_NPToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/N_NP_end&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Contatori&quot;/>&#xa;    &lt;xsl:param name=&quot;N_NP_SUBPROCESS&quot;/>&#xa;    &lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Contatori>&#xa;            &lt;tns2:StringaCRMWS>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns2:StringaCRMWS,$N_NP_SUBPROCESS/tns1:stringaCRMWS)&quot;/>&#xa;            &lt;/tns2:StringaCRMWS>&#xa;            &lt;tns2:StringaSDR>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns2:StringaSDR,$N_NP_SUBPROCESS/tns1:stringaSDR)&quot;/>&#xa;            &lt;/tns2:StringaSDR>&#xa;            &lt;tns2:StringaDBCFX>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns2:StringaDBCFX,$N_NP_SUBPROCESS/tns1:stringaDBCFX)&quot;/>&#xa;            &lt;/tns2:StringaDBCFX>&#xa;            &lt;tns2:ContatoreCRMWS>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreCRMWS+$N_NP_SUBPROCESS/tns1:contatoreCRMWS)&quot;/>&#xa;            &lt;/tns2:ContatoreCRMWS>&#xa;            &lt;tns2:ContatoreSDR>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreSDR+$N_NP_SUBPROCESS/tns1:contatoreSDR)&quot;/>&#xa;            &lt;/tns2:ContatoreSDR>&#xa;            &lt;tns2:ContatoreDBCFX>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreDBCFX+$N_NP_SUBPROCESS/tns1:contatoreDBCFX)&quot;/>&#xa;            &lt;/tns2:ContatoreDBCFX>&#xa;            &lt;tns2:ContatoreNOW>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreNOW+$N_NP_SUBPROCESS/tns1:contatoreNOW)&quot;/>&#xa;            &lt;/tns2:ContatoreNOW>&#xa;            &lt;tns2:ContatoreKO>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreKO+$N_NP_SUBPROCESS/tns1:contatoreKO)&quot;/>&#xa;            &lt;/tns2:ContatoreKO>&#xa;        &lt;/tns2:Contatori>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Contatori" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="EstrazioneOLO-input"
                    name="EstrazioneOLO" outputVariable="EstrazioneOLO"
                    tibex:xpdlId="c023e765-270b-48a1-bf91-c20594f8cc32"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CodiciAssignToSelectCodiciOLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EstrazioneOLToAssignCoppiaCodiciOLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$CodiciOlo&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.EstrazioneOLO" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogR_NP-input"
                    name="LogR_NP"
                    tibex:xpdlId="550d9474-d736-4d37-8c36-2419ead2b8b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToLog11_RNP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogR_NPToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlR_NP&quot;/>&#xa;    &lt;xsl:template name=&quot;LogR_NP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto validato per R_NP: &amp;#xD;&amp;#xA;&amp;quot;,tib:render-xml($ParseXmlR_NP))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="R_NP_SUBPROCESS-input"
                    name="R_NP_SUBPROCESS"
                    outputVariable="R_NP_SUBPROCESS"
                    tibex:xpdlId="f8a15876-6e91-427b-981b-6faba7af9f1d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogR_NPToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="R_NP_SUBPROCESSToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/R_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlR_NP&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;R_NP_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:IDfile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/ID_FILE)&quot;/>&#xa;            &lt;/ns:IDfile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                    &lt;ns:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:ComunicazioneNP>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlR_NP/ComunicazioneNP/Risposta&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(Valid_Formale_DonorRecipient)&quot;>&#xa;                            &lt;ns:Risposta>&#xa;                                &lt;ns:Valid_Formale_DonorRecipient>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_DonorRecipient/DatiNotifica&quot;>&#xa;                                        &lt;ns:DatiNotifica>&#xa;                                            &lt;ns:CodiceOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOrdine&quot;/>&#xa;                                            &lt;/ns:CodiceOrdine>&#xa;                                            &lt;ns:DataOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;DataOrdine&quot;/>&#xa;                                            &lt;/ns:DataOrdine>&#xa;                                            &lt;ns:DirectoryNumber>&#xa;                                                &lt;xsl:value-of select=&quot;DirectoryNumber&quot;/>&#xa;                                            &lt;/ns:DirectoryNumber>&#xa;                                            &lt;ns:IdentificativoOperatoreDonor>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoOperatoreDonor&quot;/>&#xa;                                            &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                            &lt;ns:DataInvioMessaggio>&#xa;                                                &lt;xsl:value-of select=&quot;DataInvioMessaggio&quot;/>&#xa;                                            &lt;/ns:DataInvioMessaggio>&#xa;                                            &lt;xsl:if test=&quot;Note&quot;>&#xa;                                                &lt;ns:Note>&#xa;                                                    &lt;xsl:value-of select=&quot;Note&quot;/>&#xa;                                                &lt;/ns:Note>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:CodiceOpRecipient>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOpRecipient&quot;/>&#xa;                                            &lt;/ns:CodiceOpRecipient>&#xa;                                            &lt;ns:CodiceSegreto>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceSegreto&quot;/>&#xa;                                            &lt;/ns:CodiceSegreto>&#xa;                                            &lt;xsl:for-each select=&quot;TipoLinea&quot;>&#xa;                                                &lt;ns:TipoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;exists(ISDN)&quot;>&#xa;                                                            &lt;ns:ISDN>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                                &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                                                &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                &lt;xsl:for-each select=&quot;ISDN/NPAggiuntive&quot;>&#xa;                                                                    &lt;ns:NPAggiuntive>&#xa;                                                                        &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                                            &lt;ns:NumAggiuntivaPortata>&#xa;                                                                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                                            &lt;/ns:NumAggiuntivaPortata>&#xa;                                                                        &lt;/xsl:for-each>&#xa;                                                                    &lt;/ns:NPAggiuntive>&#xa;                                                                &lt;/xsl:for-each>&#xa;                                                            &lt;/ns:ISDN>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns:GNR>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;GNR/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                            &lt;/ns:GNR>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns:TipoLinea>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                            &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                            &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                            &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                            &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                &lt;ns:NomeCliente>&#xa;                                                    &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                &lt;/ns:NomeCliente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;CodiceProgetto&quot;>&#xa;                                                &lt;ns:CodiceProgetto>&#xa;                                                    &lt;xsl:value-of select=&quot;CodiceProgetto&quot;/>&#xa;                                                &lt;/ns:CodiceProgetto>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:EmailReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:EmailReferenteRichiedente>&#xa;                                            &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                            &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                &lt;ns:Correlazioni>&#xa;                                                    &lt;ns:IdentificativoCorrelazioni>&#xa;                                                        &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                    &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                    &lt;ns:TotaleRichieste>&#xa;                                                        &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                    &lt;/ns:TotaleRichieste>&#xa;                                                &lt;/ns:Correlazioni>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:DatiNotifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_DonorRecipient/EsitoVerifica&quot;>&#xa;                                        &lt;ns:EsitoVerifica>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists(EsitoKO)&quot;>&#xa;                                                    &lt;ns:EsitoKO>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns:CodiceMotivoRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/CodiceMotivoRifiuto&quot;/>&#xa;                                                        &lt;/ns:CodiceMotivoRifiuto>&#xa;                                                        &lt;ns:DescrizioneRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/DescrizioneRifiuto&quot;/>&#xa;                                                        &lt;/ns:DescrizioneRifiuto>&#xa;                    