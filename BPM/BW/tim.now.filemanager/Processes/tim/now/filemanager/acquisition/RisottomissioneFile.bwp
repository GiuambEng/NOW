            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="ContatoriR_NP" outputVariable="Contatori"
                    tibex:xpdlId="3c65b1ba-3fd9-40d7-aa0d-f4f5b795a5ac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="R_NP_SUBPROCESSToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ContatoriR_NPToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/ListaContatori&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/R_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Contatori&quot;/>&#xa;    &lt;xsl:param name=&quot;R_NP_SUBPROCESS&quot;/>&#xa;    &lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Contatori>&#xa;            &lt;tns1:StringaCRMWS>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaCRMWS,$R_NP_SUBPROCESS/ns:stringaCRMWS)&quot;/>&#xa;            &lt;/tns1:StringaCRMWS>&#xa;            &lt;tns1:StringaSDR>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaSDR,$R_NP_SUBPROCESS/ns:stringaSDR)&quot;/>&#xa;            &lt;/tns1:StringaSDR>&#xa;            &lt;tns1:StringaDBCFX>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaDBCFX,$R_NP_SUBPROCESS/ns:stringaDBCFX)&quot;/>&#xa;            &lt;/tns1:StringaDBCFX>&#xa;            &lt;tns1:ContatoreCRMWS>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns1:ContatoreCRMWS+$R_NP_SUBPROCESS/ns:contatoreCRMWS)&quot;/>&#xa;            &lt;/tns1:ContatoreCRMWS>&#xa;            &lt;tns1:ContatoreSDR>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns1:ContatoreSDR+$R_NP_SUBPROCESS/ns:contatoreSDR)&quot;/>&#xa;            &lt;/tns1:ContatoreSDR>&#xa;            &lt;tns1:ContatoreDBCFX>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns1:ContatoreDBCFX+$R_NP_SUBPROCESS/ns:contatoreDBCFX)&quot;/>&#xa;            &lt;/tns1:ContatoreDBCFX>&#xa;            &lt;tns1:ContatoreNOW>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns1:ContatoreNOW+$R_NP_SUBPROCESS/ns:contatoreNOW)&quot;/>&#xa;            &lt;/tns1:ContatoreNOW>&#xa;            &lt;tns1:ContatoreKO>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns1:ContatoreKO+$R_NP_SUBPROCESS/ns:contatoreKO)&quot;/>&#xa;            &lt;/tns1:ContatoreKO>&#xa;        &lt;/tns1:Contatori>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Contatori" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="AzzeraContatori" outputVariable="Contatori"
                    tibex:xpdlId="51eeef8b-09e1-4d3b-b8fd-0f451260710a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
