            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CodiciOlo"
                    name="CodiciAssign" outputVariable="CodiciOlo"
                    tibex:xpdlId="6709e383-733f-42b8-bef0-7c5d2e0abfe0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCodiciAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CodiciAssignToSelectCodiciOLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlREG&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAPref&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;N_pref&quot;/>&#xa;    &lt;xsl:param name=&quot;R_pref&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:template name=&quot;CodiciOlo&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM) > 0 and (starts-with($DatiFile/Record[1]/NOME_FILE, $DatiFile/Record[1]/CODFC_OLO_AGCOM) or starts-with($DatiFile/Record[1]/NOME_FILE, concat($N_pref,$DatiFile/Record[1]/CODFC_OLO_AGCOM)) or starts-with($DatiFile/Record[1]/NOME_FILE, concat($R_pref,$DatiFile/Record[1]/CODFC_OLO_AGCOM)))&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:for-each-group select=&quot;$ParseXmlREG/Richiesta&quot; group-by=&quot;Testata/CodiceOlo&quot;>&#xa;                        &lt;tns3:codes>&#xa;                            &lt;tns3:CodiceOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns3:CodiceOLO>&#xa;                            &lt;tns3:CodiceOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&#xa;                            &lt;/tns3:CodiceOLOAGCOM>&#xa;                        &lt;/tns3:codes>&#xa;                    &lt;/xsl:for-each-group>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO) > 0 and starts-with($DatiFile/Record[1]/NOME_FILE, concat($NGAPref, $DatiFile/Record[1]/COD_OLO))&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:for-each-group select=&quot;$ParseXmlNGA/ns0:Richiesta&quot; group-by=&quot;ns0:Testata/ns0:CodiceOlo&quot;>&#xa;                        &lt;tns3:codes>&#xa;                            &lt;tns3:CodiceOLO>&#xa;                                &lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                            &lt;/tns3:CodiceOLO>&#xa;                            &lt;tns3:CodiceOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns3:CodiceOLOAGCOM>&#xa;                        &lt;/tns3:codes>&#xa;                    &lt;/xsl:for-each-group>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:for-each-group select=&quot;$ParseXmlxDSL/ns01:Richiesta&quot; group-by=&quot;ns01:Testata/ns01:CodiceOlo&quot;>&#xa;                        &lt;tns3:codes>&#xa;                            &lt;tns3:CodiceOLO>&#xa;                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                            &lt;/tns3:CodiceOLO>&#xa;                            &lt;tns3:CodiceOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns3:CodiceOLOAGCOM>&#xa;                        &lt;/tns3:codes>&#xa;                    &lt;/xsl:for-each-group>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="CodiciOlo" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CodiciOlo"
