               &lt;xsl:value-of select=&quot;Espletamento_Cessazione/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns:DataInvioMessaggio>&#xa;                                    &lt;xsl:if test=&quot;Espletamento_Cessazione/Note&quot;>&#xa;                                        &lt;ns:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Espletamento_Cessazione/Note&quot;/>&#xa;                                        &lt;/ns:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:if test=&quot;Espletamento_Cessazione/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Espletamento_Cessazione/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;Espletamento_Cessazione/Telecom&quot;>&#xa;                                        &lt;ns:Telecom>&#xa;                                            &lt;xsl:for-each select=&quot;Rientro&quot;>&#xa;                                                &lt;ns:Rientro>&#xa;                                                    &lt;ns:RientroTI>&#xa;                                                        &lt;xsl:value-of select=&quot;RientroTI&quot;/>&#xa;                                                    &lt;/ns:RientroTI>&#xa;                                                    &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                        &lt;xsl:value-of 