                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/GenerateBadFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;LocalPath&quot;/>&lt;xsl:param name=&quot;DatiFile&quot;/>&lt;xsl:param name=&quot;FolderDelimiter&quot;/>&lt;xsl:template name=&quot;Bad_KO_PARSE_XML-input&quot; match=&quot;/&quot;>&lt;tns1:Input>&lt;tns1:IDfile>&lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/ID_FILE)&quot;/>&lt;/tns1:IDfile>&lt;tns1:IdEsecProcsoFile>&lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&lt;/tns1:IdEsecProcsoFile>&lt;tns1:NomeFile>&lt;xsl:value-of select=&quot;$DatiFile/Record[1]/NOME_FILE&quot;/>&lt;/tns1:NomeFile>&lt;xsl:choose>&lt;xsl:when test=&quot;ends-with($DatiFile/Record[1]/LOCAL_PATH, $FolderDelimiter)&quot;>&lt;tns1:FileFullName>&lt;xsl:value-of select=&quot;concat($DatiFile/Record[1]/LOCAL_PATH,$DatiFile/Record[1]/NOME_FILE)&quot;/>&lt;/tns1:FileFullName>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:FileFullName>&lt;xsl:value-of select=&quot;concat($DatiFile/Record[1]/LOCAL_PATH,$FolderDelimiter,$DatiFile/Record[1]/NOME_FILE)&quot;/>&lt;/tns1:FileFullName>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:FileSize>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:FileSize>&lt;tns1:LocalPath>&lt;xsl:value-of select=&quot;$LocalPath&quot;/>&lt;/tns1:LocalPath>&lt;tns1:LogMessage>&lt;xsl:value-of select=&quot;concat(&amp;quot;Il file &amp;quot;, $DatiFile/Record[1]/NOME_FILE, &amp;quot; non è valido.&amp;quot;)&quot;/>&lt;/tns1:LogMessage>&lt;tns1:ParentProcessInstanceID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns1:ParentProcessInstanceID>&lt;tns1:Esito>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quo