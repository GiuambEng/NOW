                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCodiciAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Contatori>&#xa;            &lt;tns2:StringaCRMWS>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:StringaCRMWS&quot;/>&#xa;            &lt;/tns2:StringaCRMWS>&#xa;            &lt;tns2:StringaSDR>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:StringaSDR&quot;/>&#xa;            &lt;/tns2:StringaSDR>&#xa;            &lt;tns2:StringaDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:StringaDBCFX&quot;/>&#xa;            &lt;/tns2:StringaDBCFX>&#xa;            &lt;tns2:ContatoreCRMWS>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:ContatoreCRMWS&quot;/>&#xa;            &lt;/tns2:ContatoreCRMWS>&#xa;            &lt;tns2:ContatoreSDR>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:ContatoreSDR&quot;/>&#xa;            &lt;/tns2:ContatoreSDR>&#xa;            &lt;tns2:ContatoreDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:ContatoreDBCFX&quot;/>&#xa;            &lt;/tns2:ContatoreDBCFX>&#xa;            &lt;tns2:ContatoreNOW>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:ContatoreNOW&quot;/>&#xa;            &lt;/tns2:ContatoreNOW>&#xa;            &lt;tns2:ContatoreKO>&#xa;                &lt;xsl:value-of select=&quot;$EstrazioneLavorate/tns1:Contatori/tns2:ContatoreKO&quot;/>&#xa;            &lt;/tns2:ContatoreKO>&#xa;        &lt;/tns2:Contatori>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Contatori" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="ContatoriNGA" outputVariable="Contatori"
                    tibex:xpdlId="97da837f-3615-41ec-9760-80ae0f1a358e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NGA_SUBPROCESSToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ContatoriNGAToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Contatori&quot;/>&#xa;    &lt;xsl:param name=&quot;NGA_SUBPROCESS&quot;/>&#xa;    &lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Contatori>&#xa;            &lt;tns2:StringaCRMWS>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns2:StringaCRMWS,$NGA_SUBPROCESS/tns2:StringaCRMWS)&quot;/>&#xa;            &lt;/tns2:StringaCRMWS>&#xa;            &lt;tns2:StringaSDR>&#xa;                &lt;xsl:value-of select=&quot;concat($Contatori/tns2:StringaSDR,$NGA_SUBPROCESS/tns2:StringaSDR)&quot;/>&#xa;            &lt;/tns2:StringaSDR>&#xa;            &lt;tns2:StringaDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$Contatori/tns2:StringaDBCFX&quot;/>&#xa;            &lt;/tns2:StringaDBCFX>&#xa;            &lt;tns2:ContatoreCRMWS>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreCRMWS+$NGA_SUBPROCESS/tns2:ContatoreCRMWS)&quot;/>&#xa;            &lt;/tns2:ContatoreCRMWS>&#xa;            &lt;tns2:ContatoreSDR>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreSDR+$NGA_SUBPROCESS/tns2:ContatoreSDR)&quot;/>&#xa;            &lt;/tns2:ContatoreSDR>&#xa;            &lt;tns2:ContatoreDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$Contatori/tns2:ContatoreDBCFX&quot;/>&#xa;            &lt;/tns2:ContatoreDBCFX>&#xa;            &lt;tns2:ContatoreNOW>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreNOW+$NGA_SUBPROCESS/tns2:ContatoreNOW)&quot;/>&#xa;            &lt;/tns2:ContatoreNOW>&#xa;            &lt;tns2:ContatoreKO>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Contatori/tns2:ContatoreKO+$NGA_SUBPROCESS/tns2:ContatoreKO)&quot;/>&#xa;            &lt;/tns2:ContatoreKO>&#xa;        &lt;/tns2:Contatori>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
