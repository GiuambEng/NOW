                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FolderDelimiter&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:template name=&quot;ListFiles-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ListFilesActivityConfig>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($DatiFile/Record[1]/LOCAL_PATH, $FolderDelimiter)&quot;>&#xa;                    &lt;fileName>&#xa;                        &lt;xsl:value-of select=&quot;concat($DatiFile/Record[1]/LOCAL_PATH,$DatiFile/Record[1]/NOME_FILE)&quot;/>&#xa;                    &lt;/fileName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;fileName>&#xa;                        &lt;xsl:value-of select=&quot;concat($DatiFile/Record[1]/LOCAL_PATH,$FolderDelimiter,$DatiFile/Record[1]/NOME_FILE)&quot;/>&#xa;                    &lt;/fileName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:ListFilesActivityConfig>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
