                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO SET TIMSTP_RISTTMISS=? WHERE ID_FILE=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_RISTTMISS"/>
