                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Contatori" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="ChiusuraFile-input"
                    name="ChiusuraFile"
                    tibex:xpdlId="76f8976e-2b11-4cf5-b7ca-e26318a7133d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToChiusuraFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ChiusuraFileToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/ChiusuraFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LocalPath&quot;/>&#xa;    &lt;xsl:param name=&quot;Contatori&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlR_NP&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlN_NP&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlREG&quot;/>&#xa;    &lt;xsl:param name=&quot;FolderDelimiter&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:template name=&quot;ChiusuraFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Input>&#xa;            &lt;tns3:FileName>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/NOME_FILE&quot;/>&#xa;            &lt;/tns3:FileName>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;ends-with($DatiFile/Record[1]/LOCAL_PATH, $FolderDelimiter)&quot;>&#xa;                    &lt;tns3:FileFullName>&#xa;                        &lt;xsl:value-of select=&quot;concat($DatiFile/Record[1]/LOCAL_PATH,$DatiFile/Record[1]/NOME_FILE)&quot;/>&#xa;                    &lt;/tns3:FileFullName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:FileFullName>&#xa;                        &lt;xsl:value-of select=&quot;concat($DatiFile/Record[1]/LOCAL_PATH,$FolderDelimiter,$DatiFile/Record[1]/NOME_FILE)&quot;/>&#xa;                    &lt;/tns3:FileFullName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns3:LocalPath>&#xa;                &lt;xsl:value-of select=&quot;$LocalPath&quot;/>&#xa;            &lt;/tns3:LocalPath>&#xa;            &lt;tns3:IDfile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/ID_FILE)&quot;/>&#xa;            &lt;/tns3:IDfile>&#xa;            &lt;tns3:IdEsecProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;            &lt;/tns3:IdEsecProcsoFile>&#xa;            &lt;tns3:Esito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;IN AMBITO&amp;quot;&quot;/>&#xa;            &lt;/tns3:Esito>&#xa;            &lt;tns3:ContatoreRichieste>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(count($ParseXmlREG/Richiesta)+count($ParseXmlNGA/ns0:Richiesta)+count($ParseXmlxDSL/ns01:Richiesta)+count($ParseXmlR_NP/ComunicazioneNP/Risposta)+count($ParseXmlN_NP/Richiesta))&quot;/>&#xa;            &lt;/tns3:ContatoreRichieste>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;tns3:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/tns3:CodiceISP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                    &lt;/tns3:CodiceISP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                    &lt;tns3:CodificaOLOagcom>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOagcom>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:CodificaOLOagcom>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOagcom>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns3:IDintrfc>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/ID_INTRFC)&quot;/>&#xa;            &lt;/tns3:IDintrfc>&#xa;            &lt;tns3:IDtplg_file>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($DatiFile/Record[1]/IDTPLG_FILE)&quot;/>&#xa;            &lt;/tns3:IDtplg_file>&#xa;            &lt;tns3:Contatori>&#xa;                &lt;xsl:copy-of select=&quot;$Contatori/ancestor-or-self::*/namespace::node()&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$Contatori/@*&quot;/>&#xa;                &lt;xsl:copy-of select=&quot;$Contatori/node()&quot;/>&#xa;            &lt;/tns3:Contatori>&#xa;        &lt;/tns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.ChiusuraFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlREG&quot;/>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;REG_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Element>&#xa;            &lt;xsl:copy-of select=&quot;$CodiciOlo&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                    &lt;ns:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$DatiFile/Record[1]/COD_OLO&quot;>&#xa;                        &lt;ns:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/ns:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$DatiFile/Record[1]/COD_OLO&quot;>&#xa;                        &lt;ns:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/ns:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/ID_FILE&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/DATA_FILE&quot;/>&#xa;            &lt;/ns:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;ns:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                    &lt;/ns:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns3:Response/tns3:outputDate&quot;/>&#xa;                    &lt;/ns:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$ParseXmlREG&quot;/>&#xa;            &lt;tns2:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns1:Lavorate/tns2:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns2:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns2:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns2:RichiesteLavorate>&#xa;        &lt;/ns:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="REG_SUBPROCESS-input"
                    name="REG_SUBPROCESS"
                    outputVariable="REG_SUBPROCESS"
                    tibex:xpdlId="20b3cc2c-ba5b-4a8e-b23e-a69ac37f88d8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="REG_SUBPROCESSToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlREG&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneLavorate&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;REG_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Element>&#xa;            &lt;xsl:copy-of select=&quot;$CodiciOlo&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                    &lt;ns:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/ns:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($DatiFile/Record[1]/COD_OLO)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$DatiFile/Record[1]/COD_OLO&quot;>&#xa;                        &lt;ns:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/ns:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$DatiFile/Record[1]/COD_OLO&quot;>&#xa;                        &lt;ns:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/COD_OLO&quot;/>&#xa;                        &lt;/ns:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/ID_FILE&quot;/>&#xa;            &lt;/ns:ID_FILE>&#xa;            &lt;ns:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$DatiFile/Record[1]/DATA_FILE&quot;/>&#xa;            &lt;/ns:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;ns:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                    &lt;/ns:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns3:outputDate&quot;/>&#xa;                    &lt;/ns:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$ParseXmlREG&quot;/>&#xa;            &lt;tns2:RichiesteLavorate>&#xa;                &lt;xsl:for-each select=&quot;$EstrazioneLavorate/tns1:Lavorate/tns2:ProgressivoRichiestaFile&quot;>&#xa;                    &lt;tns2:ProgressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/tns2:ProgressivoRichiestaFile>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns2:RichiesteLavorate>&#xa;        &lt;/ns:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
