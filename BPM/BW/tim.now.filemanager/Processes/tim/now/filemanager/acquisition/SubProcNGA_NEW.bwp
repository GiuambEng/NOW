e/CF&quot;/>&lt;/CF>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/PIVA&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;ordine/PIVA&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/IDSLUCo&quot;>&lt;IDSLUCo>&lt;xsl:value-of select=&quot;ordine/IDSLUCo&quot;/>&lt;/IDSLUCo>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/IDULLCo&quot;>&lt;IDULLCo>&lt;xsl:value-of select=&quot;ordine/IDULLCo&quot;/>&lt;/IDULLCo>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/codiceDelivery&quot;>&lt;codiceDelivery>&lt;xsl:value-of select=&quot;ordine/codiceDelivery&quot;/>&lt;/codiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/DNOLOCollaudo&quot;>&lt;DNOLOCollaudo>&lt;xsl:value-of select=&quot;ordine/DNOLOCollaudo&quot;/>&lt;/DNOLOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/numeroVerdeOloCollaudo&quot;>&lt;numeroVerdeOloCollaudo>&lt;xsl:value-of select=&quot;ordine/numeroVerdeOloCollaudo&quot;/>&lt;/numeroVerdeOloCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/numeroVerdeOloPT&quot;>&lt;numeroVerdeOloPT>&lt;xsl:value-of select=&quot;ordine/numeroVerdeOloPT&quot;/>&lt;/numeroVerdeOloPT>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/codiceTTM&quot;>&lt;codiceTTM>&lt;xsl:value-of select=&quot;ordine/codiceTTM&quot;/>&lt;/codiceTTM>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/flagLavorazioneManuale&quot;>&lt;flagLavorazioneManuale>&lt;xsl:value-of select=&quot;ordine/flagLavorazioneManuale&quot;/>&lt;/flagLavorazioneManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/flagMonitoraggio&quot;>&lt;flagMonitoraggio>&lt;xsl:value-of select=&quot;ordine/flagMonitoraggio&quot;/>&lt;/flagMonitoraggio>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/noteCliente&quot;>&lt;noteCliente>&lt;xsl:value-of select=&quot;ordine/noteCliente&quot;/>&lt;/noteCliente>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/notedaSistema&quot;>&lt;notedaSistema>&lt;xsl:value-of select=&quot;ordine/notedaSistema&quot;/>&lt;/notedaSistema>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/totaleOrdRilevPacchetto&quot;>&lt;totaleOrdRilevPacchetto>&lt;xsl:value-of select=&quot;ordine/totaleOrdRilevPacchetto&quot;/>&lt;/totaleOrdRilevPacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/CLLI&quot;>&lt;CLLI>&lt;xsl:value-of select=&quot;ordine/CLLI&quot;/>&lt;/CLLI>&lt;/xsl:if>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;ordine/codificaOLONOW&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;ordine/codiceOrdineOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;ordine/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/codiceOrdineOLOPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;ordine/codiceOrdineOLOPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/codiceOrdineTI&quot;>&lt;codiceOrdineTI>&lt;xsl:value-of select=&quot;ordine/codiceOrdineTI&quot;/>&lt;/codiceOrdineTI>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/codiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;ordine/codiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(ordine/codificaOLOAGCOM)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;ordine/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;ordine/DADRimodulata&quot;>&lt;DADRimodulata>&lt;xsl:value-of select=&quot;ordine/DADRimodulata&quot;/>&lt;/DADRimodulata>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/DEC&quot;>&lt;DEC>&lt;xsl:value-of select=&quot;ordine/DEC&quot;/>&lt;/DEC>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/DES&quot;>&lt;DES>&lt;xsl:value-of select=&quot;ordine/DES&quot;/>&lt;/DES>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/ORA_DES&quot;>&lt;ORA_DES>&lt;xsl:value-of select=&quot;ordine/ORA_DES&quot;/>&lt;/ORA_DES>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/IDRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;ordine/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;ordine/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;ordine/tipologiaLavorazione&quot;/>&lt;/tipologiaLavorazione>&lt;xsl:if test=&quot;ordine/tipologiaSottolav&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;ordine/tipologiaSottolav&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/LNA_LA&quot;>&lt;LNA_LA>&lt;xsl:value-of select=&quot;ordine/LNA_LA&quot;/>&lt;/LNA_LA>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/modalitaFatturazione&quot;>&lt;modalitaFatturazione>&lt;xsl:value-of select=&quot;ordine/modalitaFatturazione&quot;/>&lt;/modalitaFatturazione>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/operatore&quot;>&lt;operatore>&lt;xsl:value-of select=&quot;ordine/operatore&quot;/>&lt;/operatore>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/RO&quot;>&lt;RO>&lt;xsl:value-of select=&quot;ordine/RO&quot;/>&lt;/RO>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/lastUpdate&quot;>&lt;lastUpdate>&lt;xsl:value-of select=&quot;ordine/lastUpdate&quot;/>&lt;/lastUpdate>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/tipoPacchetto&quot;>&lt;tipoPacchetto>&lt;xsl:value-of select=&quot;ordine/tipoPacchetto&quot;/>&lt;/tipoPacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/dataInvioOrdineADelivery&quot;>&lt;dataInvioOrdineADelivery>&lt;xsl:value-of select=&quot;ordine/dataInvioOrdineADelivery&quot;/>&lt;/dataInvioOrdineADelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;ordine/dataInvioCommercializz&quot;>&lt;dataInvioCommercializz>&lt;xsl:value-of select=&quot;ordine/dataInvioCommercializz&quot;/>&lt;/dataInvioCommercializz>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;lavorazione='ATTIVAZIONE' or lavorazione='MIGRAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count(ordine/dettaglioordine[nomeComponente='USERVLAN'])>0 and count(ordine/dettaglioordine[nomeComponente='SERVIZIOPZIONALI'])>0&quot;>&lt;xsl:for-each select=&quot;ordine/dettaglioordine[starts-with(nomeComponente,'ACCE