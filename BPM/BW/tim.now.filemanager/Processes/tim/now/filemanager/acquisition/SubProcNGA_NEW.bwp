                                    <bpws:source linkName="LogChiamataBPMToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogChiamataBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcNGA_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Richiesta inviata al BPM: &amp;quot;, $RenderRichiesta)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns9:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Rendezvous-input"
                                    name="Rendezvous"
                                    outputVariable="Rendezvous"
                                    tibex:xpdlId="c5b095d8-6ce5-4b62-a40a-f30c544e271e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ClienteFinaleD420ToRendezvous"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RendezvousToVerificaCodiceProgetto">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($ATTarray/tns:Richiesta[$index]/disaggregato)>1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($ATTarray/tns:Richiesta[$index]/disaggregato)>1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="RendezvousToEmpty18">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Rendezvous-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ATTarray/tns3:Richiesta[number($index)]/codificaOLOAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[number($index)]/codificaOLOAGCOM&quot;>&#xa;                        &lt;tns6:CODFC_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns6:CODFC_OLO_AGCOM>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns6:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&#xa;                    &lt;/tns6:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ListaIdOfferta/tns1:Offerta[upper-case(tns1:Nome_Offerta)=upper-case($ATTarray/tns3:Richiesta[number($index)]/offerta)]/tns1:ID_Offerta&quot;>&#xa;                &lt;tns6:ID_OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$ListaIdOfferta/tns1:Offerta[upper-case(tns1:Nome_Offerta)=upper-case($ATTarray/tns3:Richiesta[number($index)]/offerta)]/tns1:ID_Offerta&quot;/>&#xa;                &lt;/tns6:ID_OFFERTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[number($index)]/created&quot;>&#xa;                &lt;tns6:CREATED>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[number($index)]/created&quot;/>&#xa;                &lt;/tns6:CREATED>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns6:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns6:TransactionID>&#xa;        &lt;/tns6:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
