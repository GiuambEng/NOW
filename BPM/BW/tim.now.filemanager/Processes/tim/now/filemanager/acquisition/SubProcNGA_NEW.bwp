                    &lt;/tns:N_Recap_Cliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper2/tns9:Referente[$index1]/telefonoMobileReferente&quot;>&#xa;                    &lt;tns:N_Recap_Cliente_ALT>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper2/tns9:Referente[$index1]/telefonoMobileReferente&quot;/>&#xa;                    &lt;/tns:N_Recap_Cliente_ALT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper2/tns9:Referente[$index1]/nomeReferente&quot;>&#xa;                    &lt;tns:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper2/tns9:Referente[$index1]/nomeReferente&quot;/>&#xa;                    &lt;/tns:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Mapper2/tns9:Referente[$index1]/cognomeReferente&quot;>&#xa;                    &lt;tns:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper2/tns9:Referente[$index1]/cognomeReferente&quot;/>&#xa;                    &lt;/tns:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:RequestCreate_token>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;            &lt;tns:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/tns:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]&quot;>&#xa;                        &lt;tns:IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns