                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallP-input"
                                    name="CallP" outputVariable="CallP"
                                    tibex:xpdlId="0deb546f-3f43-4a9a-83c3-b9840c404f90"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallDToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToRefAltreLav"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tns10=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:param name=&quot;CallD&quot;/>&#xa;    &lt;xsl:template name=&quot;CallP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione)&quot;>&#xa;                    &lt;tns:RequestCreate_token>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;>&#xa;                                    &lt;tns:CodificaOLOAGCOM>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                                    &lt;/tns:CodificaOLOAGCOM>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:CodificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&#xa;                                &lt;/tns:CodificaOLOAGCOM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                            &lt;tns:CodiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                            &lt;/tns:CodiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:Funzione>&#xa;                            &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                        &lt;/tns:Funzione>&#xa;                        &lt;tns:ChiaveRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;concat($NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                        &lt;/tns:ChiaveRiferimento>&#xa;                        &lt;tns:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                        &lt;/tns:Operatore>&#xa;                        &lt;xsl:if test=&quot;$GetLocalIP/tns10:IPAddress&quot;>&#xa;                            &lt;tns:IPClient>&#xa;                                &lt;xsl:value-of select=&quot;$GetLocalIP/tns10:IPAddress&quot;/>&#xa;                            &lt;/tns:IPClient>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:NomeReferente&quot;>&#xa;                            &lt;tns:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:NomeReferente&quot;/>&#xa;                            &lt;/tns:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:CognomeReferente&quot;>&#xa;                            &lt;tns:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:CognomeReferente&quot;/>&#xa;                            &lt;/tns:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:TOKENIZZAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$CallD/tns9:TipoToken&quot;/>&#xa;                        &lt;/tns:TOKENIZZAZIONE>&#xa;                    &lt;/tns:RequestCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:RequestCreate_token>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;>&#xa;                                    &lt;tns:CodificaOLOAGCOM>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                                    &lt;/tns:CodificaOLOAGCOM>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:CodificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&#xa;                                &lt;/tns:CodificaOLOAGCOM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                            &lt;tns:CodiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                            &lt;/tns:CodiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:Funzione>&#xa;                            &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                        &lt;/tns:Funzione>&#xa;                        &lt;tns:ChiaveRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;concat($NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                        &lt;/tns:ChiaveRiferimento>&#xa;                        &lt;tns:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                        &lt;/tns:Operatore>&#xa;                        &lt;xsl:if test=&quot;$GetLocalIP/tns10:IPAddress&quot;>&#xa;                            &lt;tns:IPClient>&#xa;                                &lt;xsl:value-of select=&quot;$GetLocalIP/tns10:IPAddress&quot;/>&#xa;                            &lt;/tns:IPClient>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Telefono&quot;>&#xa;                            &lt;tns:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Telefono&quot;/>&#xa;                            &lt;/tns:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Mobile&quot;>&#xa;                            &lt;tns:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Mobile&quot;/>&#xa;                            &lt;/tns:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Nome&quot;>&#xa;                            &lt;tns:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Nome&quot;/>&#xa;                            &lt;/tns:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Cognome&quot;>&#xa;                            &lt;tns:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente/ns0:Cognome&quot;/>&#xa;                            &lt;/tns:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:TOKENIZZAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$CallD/tns9:TipoToken&quot;/>&#xa;                        &lt;/tns:TOKENIZZAZIONE>&#xa;                    &lt;/tns:RequestCreate_token>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;            &lt;tns:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/tns:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]))>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]&quot;>&#xa;                        &lt;tns:IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]&quot;/>&#xa;                        &lt;/tns:IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:DatiMigrazione/ns0:CodiceRisorsa1)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:DatiMigrazione/ns0:CodiceRisorsa1&quot;>&#xa;                        &lt;tns:IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:DatiMigrazione/ns0:CodiceRisorsa1&quot;/>&#xa;                        &lt;/tns:IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:OffertaBPM>&#xa;                &lt;xsl:value-of select=&quot;$CallD/tns9:Offerta&quot;/>&#xa;            &lt;/tns:OffertaBPM>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
