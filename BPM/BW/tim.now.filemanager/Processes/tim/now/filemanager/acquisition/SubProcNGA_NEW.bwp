                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper5-input"
                                    name="Mapper5"
                                    outputVariable="Mapper5"
                                    tibex:xpdlId="800ea957-f113-4acf-8beb-58c60f9cf4fb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
