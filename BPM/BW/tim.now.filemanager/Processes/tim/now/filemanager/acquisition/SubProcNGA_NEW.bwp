                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallD-input"
                                    name="CallD" outputVariable="CallD"
                                    tibex:xpdlId="b107a614-5ebd-4269-a38e-4591f62924de"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderRichiestaALTToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallDToCallProcess1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallDToRefAltreLav">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallD/ns59:TipoToken='NOTOKEN'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallD/ns59:TipoToken='NOTOKEN']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;CallD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Input>&#xa;            &lt;tns9:CodOrdTI>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;            &lt;/tns9:CodOrdTI>&#xa;        &lt;/tns9:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
