                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Annullamento&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns3:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns3:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns3:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]&quot;>&#xa;            &lt;xsl:for-each select=&quot;.&quot;>&#xa;                &lt;ns:RichiestaElement>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                    &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                        &lt;statoRichiestaPrecedNOW>&#xa;                            &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;       