                    name="MapperRaggruppamento"
                    outputVariable="MapperRaggruppamento"
                    tibex:xpdlId="b2410d25-001e-4e91-861b-b1c66aa5f1a7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetLocalIPToMapperRaggruppamento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperRaggruppamentoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($MapperRaggruppamento/ns23:Richieste/ns23:RichiesteATT_ANN/ns2:RichiestaElement)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($MapperRaggruppamento/ns23:Richieste/ns23:RichiesteATT_ANN/ns2:RichiestaElement)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MapperRaggruppamentoToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns1=&quot;http://www.example.org/RichiesteNGAxBPM&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;CodProgettoOrdWList&quot;/>&lt;xsl:template name=&quot;MapperRaggruppamento-input&quot; match=&quot;/&quot;>&lt;ns1:RichiesteOLOSuddivise>&lt;xsl:for-each select=&quot;$Start/ns0:TracciatoOLONGA/ns0:Richiesta&quot;>&lt;xsl:variable name=&quot;rich&quot; select=&quot;current()&quot;/>&lt;xsl:variable name=&quot;RTYPE&quot; select=&quot;if(exists(ns0:TipoRichiesta/ns0:Migrazione)) then &amp;#xD;&amp;#xA; if (exists(../ns0:Richiesta/ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento[../../../ns0:Testata/ns0:CodiceOlo = $rich/ns0:Testata/ns0:CodiceOlo and ns0:CodiceOrdineOlo = $rich/ns0:Testata/ns0:CodiceOrdineOlo])) then  &amp;#xD;&amp;#xA;  'ATTANN' &amp;#xD;&amp;#xA; else &amp;#xD;&amp;#xA;  'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(ns0:TipoRichiesta/ns0:Attivazione)) then &amp;#xD;&amp;#xA; if (exists(../ns0:Richiesta/ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento[../../../ns0:Testata/ns0:CodiceOlo = $rich/ns0:Testata/ns0:CodiceOlo and ns0:CodiceOrdineOlo = $rich/ns0:Testata/ns0:CodiceOrdineOlo])) then  &amp;#xD;&amp;#xA;  'ATTANN' &amp;#xD;&amp;#xA; else &amp;#xD;&amp;#xA;  'ATT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento)) then &amp;#xD;&amp;#xA; if (exists(../ns0:Richiesta/ns0:TipoRichiesta/ns0:Attivazione[../../ns0:Testata/ns0:CodiceOrdineOlo = $rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento/ns0:CodiceOrdineOlo and ../../ns0:Testata/ns0:CodiceOlo = $rich/ns0:Testata/ns0:CodiceOlo])) then  &amp;#xD;&amp;#xA;  'ATTANN' &amp;#xD;&amp;#xA; else &amp;#xD;&amp;#xA;  'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;'ALT'&quot;/>&lt;ns1:Richieste>&lt;xsl:if test=&quot;$RTYPE=&amp;quot;ATT&amp;quot;&quot;>&lt;ns1:RichiesteATT>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;xsd:int(../../ns2:ID_FILE)&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/progressivoRichiestaFile>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;../../ns2:CodOLOdaNome&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOlo&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../ns2:DATA_FILE), 1, 10))&quot;/>&lt;/dataInvioRichiesta>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&lt;/contenutoXML>&lt;xsl:choose>&lt;xsl:when test=&quot;matches(ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;note>&lt;xsl:value-of select=&quot;translate(ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&lt;/note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;ns0:Testata/ns0:Note&quot;>&lt;note>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:Note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamNGAFTTCAB) or exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamNGAFTTH) or exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:VULAFTTCAB) or exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:VULAFTTH) or exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:EasyIPUBBFTTCAB) or exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:EasyIPUBBFTTH) or (((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0)&amp;#xD;&amp;#xA;and (exists($rich/ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANNGA) or exists($rich/ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANVULA)))&quot;>&lt;ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;(exists(ns0:Testata/ns0:semiVULA) and ns0:Testata/ns0:semiVULA='SI') and ($FlagOscuramento/Record[COD_AGESP='R1I-21-0101']/FLAG_OSCURMENTO='0' or count($FlagOscuramento/Record[COD_AGESP='R1I-21-0101'])=0)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIVULAFTTH'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;(exists(ns0:Testata/ns0:semiBitstreamNGA) and ns0:Testata/ns0:semiBitstreamNGA='SI') and ($FlagOscuramento/Record[COD_AGESP='R1I-21-0101']/FLAG_OSCURMENTO='0' or count($FlagOscuramento/Record[COD_AGESP='R1I-21-0101'])=0)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIBITSTREAMNGAFTTH'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;(exists(ns0:Testata/ns0:semiEasyIPNGA) and ns0:Testata/ns0:semiEasyIPNGA='SI') and ($FlagOscuramento/Record[COD_AGESP='R1I-21-0101']/FLAG_OSCURMENTO='0' or count($FlagOscuramento/Record[COD_AGESP='R1I-21-0101'])=0)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIEASYIPUBBFTTH'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamNGAFTTH) and exists(ns0:Testata/ns0:FullGPONPLUS) and upper-case(ns0:Testata/ns0:FullGPONPLUS)='SI' and (($FlagOscuramento/Record[COD_AGESP='R1I-25-0049']/FLAG_OSCURMENTO='0') or (count($FlagOscuramento/Record[COD_AGESP='R1I-25-0049'])=0))&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUSNGA&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(ns0:TipoRichiesta/ns0:Attivazione/ns0:VULAFTTH) and exists(ns0:Testata/ns0:FullGPONPLUS) and ns0:Testata/ns0:FullGPONPLUS='SI' and (($FlagOscuramento/Record[COD_AGESP='R1I-25-0049']/FLAG_OSCURMENTO='0') or (count($FlagOscuramento/Record[COD_AGESP='R1I-25-0049'])=0))&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;FULLGPONPLUS&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;upper-case(local-name(ns0:TipoRichiesta/ns0:Attivazione/*))&quot;/>&lt;/offertaCatalogo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:DAD)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($FlagOscuramento/Record[COD_AGESP='R1I-20-0131'])>0 and  upper-case($FlagOscuramento/Record[COD_AGESP='R1I-20-0131']/FLAG_OSCURMENTO)='1'&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:DAD)&quot;/>&lt;/DAD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length(ns0:TipoRichiesta/ns0:Attivazione/ns0:VULAFTTCAB/ns0:Accesso/ns0:LineaNonFonia/ns0:Disaggregazione/ns0:PresaAppuntamento/ns0:OwnerPresaAppuntamento)>0 and upper-case(ns0:TipoRichiesta/ns0:Attivazione/ns0:VULAFTTCAB/ns0:Accesso/ns0:LineaNonFonia/ns0:Disaggregazione/ns0:PresaAppuntamento/ns0:OwnerPresaAppuntamento)='OP')&quot;/>&lt;xsl:otherwise>&lt;DAD>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:DAD)&quot;/>&lt;/DAD>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:CognomeRagSoc&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:CognomeRagSoc&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:Nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:Nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:CF&quot;>&lt;CF>&lt;xsl:value-of select=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:CF&quot;/>&lt;/CF>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:PIVA&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:ClienteFinale/ns0:PIVA&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:CodiceDelivery&quot;>&lt;codiceDelivery>&lt;xsl:value-of select=&quot;ns0:TipoRichiesta/ns0:Attivazione/node()/ns0:Accesso/node()/ns0:CodiceDelivery&quot;/>&lt;/codiceDelivery>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;matches(ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;noteCliente>&lt;xsl:value-of select=&quot;translate(ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&lt;/noteCliente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;ns0:Testata/ns0:Note&quot;>&lt;noteCliente>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:Note&quot;/>&lt;/noteCliente>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANNGA/ns0:CLLICentrale)>0&quot;>&lt;xsl:if test=&quot;ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANNGA/ns0:CLLICentrale&quot;>&lt;CLLI>&lt;xsl:value-of select=&quot;ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANNGA/ns0:CLLICentrale&quot;/>&lt;/CLLI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANVULA/ns0:CLLICentrale)>0&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANVULA/ns0:CLLICentrale&quot;>&lt;CLLI>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/ns0:Attivazione/ns0:VLANVULA/ns0:CLLICentrale&quot;/>&lt;/CLLI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOlo&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;ns0:Testata/ns0:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;../../ns2:CodOLOdaNome&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;lastUpdate>&lt;xsl:valu