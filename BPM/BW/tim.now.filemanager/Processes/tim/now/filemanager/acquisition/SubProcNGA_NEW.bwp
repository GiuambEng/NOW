                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$CallLocatorATT_ANN/ns11:Risposta/ns11:SistemaDiCompetenza = "WSDP"]]></bpws:transitionCondition>
                                    </bpws:source>
