                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallLocatorATT_ANN-input&quot; match=&quot;/&quot;>&lt;tns8:RichiestaLocalizzatore>&lt;tns8:Testata>&lt;tns8:Transaction_id>&lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&lt;/tns8:Transaction_id>&lt;tns8:Transaction_date>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns8:Transaction_date>&lt;tns8:Sistema_origine>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns8:Sistema_origine>&lt;/tns8:Testata>&lt;tns8:Richiesta>&lt;xsl:if test=&quot;$Richiesta/transactionIDLocator&quot;>&lt;tns8:IdRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&lt;/tns8:IdRichiesta>&lt;/xsl:if>&lt;tns8:DataRichiesta>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns8:DataRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Richiesta/codificaOLOAGCOM)>0&quot;>&lt;tns8:CodiceOLO>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&lt;/tns8:CodiceOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:CodiceOLO>&lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&lt;/tns8:CodiceOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&lt;tns8:CodiceISP>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&lt;/tns8:CodiceISP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Richiesta/ISTATComune)>0&quot;>&lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&lt;tns8:CodiceComune>&lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&lt;/tns8:CodiceComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Richiesta/offerta)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&lt;tns8:Servizio>&lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&lt;/tns8:Servizio>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;>&lt;tns8:Servizio>&lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&lt;/tns8:Servizio>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:Servizio>&lt;xsl:value-of select=&quot;upper-case($Richiesta/offerta)&quot;/>&lt;/tns8:Servizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/flagNaked&quot;>&lt;tns8:FlagNaked>&lt;xsl:value-of select=&quot;$Richiesta/flagNaked&quot;/>&lt;/tns8:FlagNaked>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&lt;tns8:Richiesta>&lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&lt;/tns8:Richiesta>&lt;/xsl:if>&lt;tns8:Ambito_XDSL>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/tns8:Ambito_XDSL>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&lt;tns8:CodiceOrdineRiferimentoTI>&lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&lt;/tns8:CodiceOrdineRiferimentoTI>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&lt;tns8:CodiceOrdineRiferimentoOLO>&lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&lt;/tns8:CodiceOrdineRiferimentoOLO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating&quot;>&lt;tns8:IdRisorsa>&lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating&quot;/>&lt;/tns8:IdRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&lt;tns8:IdRisorsa>&lt;xsl:value