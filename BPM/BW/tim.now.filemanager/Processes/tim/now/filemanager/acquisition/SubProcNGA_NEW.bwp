                                    inputVariable="Token9-input"
                                    name="Token9"
                                    outputVariable="Token9"
                                    tibex:xpdlId="d6b35b30-fcea-4240-bc3a-185d36707f77"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign9ToToken9_clientefinale"/>
