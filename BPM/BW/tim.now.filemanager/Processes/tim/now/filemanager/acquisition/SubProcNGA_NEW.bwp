                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="Token1-input"
                                    name="Token1"
                                    outputVariable="Token1"
                                    tibex:xpdlId="9ee076ef-a0bb-46b4-8614-46907b58cf21"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart3ToToken1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Token1ToLog1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($Token1/ns35:TOKENIZZAZIONE_RECAPITI)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
