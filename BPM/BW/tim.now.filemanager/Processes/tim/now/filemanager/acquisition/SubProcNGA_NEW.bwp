                                    sqlStatement="SELECT COD_PRGT,ONESTEP,codfc_olo_agcom&#xa;FROM PRGT&#xa;WHERE &#xa;COD_PRGT=? and codfc_olo_agcom =?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
