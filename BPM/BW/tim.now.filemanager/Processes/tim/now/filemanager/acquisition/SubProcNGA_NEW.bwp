                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReplaceCharacter.ReplaceCharacterOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Log18-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcNGA_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Index',string($index),tib:render-xml($ReplaceCharacter.ReplaceCharacterOutput, true(), true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns10:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="FlagFittizio"
                                    name="Assign13"
                                    outputVariable="FlagFittizio"
                                    tibex:xpdlId="e2328c9f-5e9f-4324-a398-fa7e1b0c5dfc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign7ToAssign13"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign13ToToken7_clientefinale">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($ATTarray/tns:Richiesta[$index]/ordine/nome)>0 or&#xd;&#xa;string-length($ATTarray/tns:Richiesta[$index]/ordine/cognomeRagioneSociale)>0 or&#xd;&#xa;string-length($ATTarray/tns:Richiesta[$index]/ordine/CF)>0 or&#xd;&#xa;string-length($ATTarray/tns:Richiesta[$index]/ordine/PIVA)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($ATTarray/tns:Richiesta[$index]/ordine/nome)>0 or
string-length($ATTarray/tns:Richiesta[$index]/ordine/cognomeRagioneSociale)>0 or
string-length($ATTarray/tns:Richiesta[$index]/ordine/CF)>0 or
string-length($ATTarray/tns:Richiesta[$index]/ordine/PIVA)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Assign13ToClienteFinaleD420">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($ATTarray/tns:Richiesta[number($index)]/esito='Fittizio2' or $ATTarray/tns:Richiesta[number($index)]/esito='Fittizio3') then 'True' else 'False'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="FlagFittizio" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Referente"
                                    name="Assign15"
                                    outputVariable="Referente"
                                    tibex:xpdlId="fbd7c5e0-15e1-4cc8-aa6f-d7c546182e10" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty7ToAssign15"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign15ToToken"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Referente&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:Request>&#xa;            &lt;tns7:Request>&#xa;                &lt;tns7:Token>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns7:Token>&#xa;                &lt;tns7:Esito>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns7:Esito>&#xa;                &lt;tns7:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns7:Descrizione>&#xa;                &lt;tns7:Referente>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;cognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/cognomeReferente>&#xa;                    &lt;nomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/nomeReferente>&#xa;                    &lt;telefonoFissoReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/telefonoFissoReferente>&#xa;                    &lt;telefonoMobileReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/telefonoMobileReferente>&#xa;                    &lt;emailReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/emailReferente>&#xa;                    &lt;flag_Token>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/flag_Token>&#xa;                &lt;/tns7:Referente>&#xa;            &lt;/tns7:Request>&#xa;        &lt;/tns7:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Referente" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ParseXml-input"
                                    name="ParseXml"
                                    outputVariable="ParseXml"
                                    tibex:xpdlId="4693f827-8fc4-4ff8-8bb5-8d13e546cb6c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderRichiestaToParseXml"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ParseXmlToRenderXml1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:xmlString>&#xa;            &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/contenutoXML&quot;/>&#xa;        &lt;/tns9:xmlString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.parsexml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:nga="http://xsd.telecomitalia.it/crm/xdsl/nga"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value
                                    inputStyle="text"
                                    outputElementQName="nga:Richiesta"
                                    validateOutput="true" xsi:type="palettexml:ParseXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderXml1-input"
                                    name="RenderXml1"
                                    outputVariable="RenderXml1"
                                    tibex:xpdlId="68f9f3f8-36c3-49a0-a27c-b51b7e8c7eec" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseXmlToRenderXml1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXml1ToCreaRichiesta"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;Token7&quot;/>&lt;xsl:template name=&quot;RenderXml1-input&quot; match=&quot;/&quot;>&lt;ns0:Richiesta>&lt;ns0:Testata>&lt;ns0:CodiceOlo>&lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceOlo&quot;/>&lt;/ns0:CodiceOlo>&lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&lt;ns0:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&lt;/ns0:CodiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&lt;ns0:CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&lt;/ns0:CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:CodiceProgetto&quot;>&lt;ns0:CodiceProgetto>&lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceProgetto&quot;/>&lt;/ns0:CodiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;matches($ParseXml/ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;ns0:Note>&lt;xsl:value-of select=&quot;translate($ParseXml/ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&lt;/ns0:Note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:Note&quot;>&lt;ns0:Note>&lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:Note&quot;/>&lt;/ns0:Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:TestMode&quot;>&lt;ns0:TestMode>&lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:TestMode&quot;/>&lt;/ns0:TestMode>&lt;/xsl:if>&lt;xsl:ch