   &lt;xsl:value-of select=&quot;$Annullamento/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns9:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns9:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
