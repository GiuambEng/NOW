                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:template name=&quot;Token2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta&quot;>&#xa;                    &lt;tns:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta&quot;/>&#xa;                    &lt;/tns:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:FlagReferente>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:FlagReferente>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:RequestVerificaRollout>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
