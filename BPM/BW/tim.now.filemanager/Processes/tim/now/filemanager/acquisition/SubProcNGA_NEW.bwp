                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;Log4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcNGA_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat($_error/StackTrace, $_error/FullClass,$_error/Msg,$_error/ProcessStack,$_error/Class,$_error/MsgCode)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns9:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="While1"
                                tibex:group="while" tibex:xpdlId="ae1b8a5b-cb93-4b69-89c3-b935472dd15f">
                                <bpws:targets>
                                    <bpws:target linkName="Assign10ToWhile1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="While1ToEmpty12"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence4" tibex:group="while">
                                    <bpws:empty name="GroupInit4" tibex:group="groupInit"/>
                                    <bpws:while name="while4" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($ATT-ANNArray/tns:Richiesta[$index]/ordine/referente[not(telefonoFissoReferente='3333333333') and not(telefonoMobileReferente='3333333333')])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($ATT-ANNArray/tns:Richiesta[$index]/ordine/referente[not(telefonoFissoReferente='3333333333') and not(telefonoMobileReferente='3333333333')])]]></bpws:condition>
                                    <bpws:flow name="flow5">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart4ToToken3" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Token3ToLog5" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Log5ToGroupEnd3" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Token3ToLog6" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="Log6ToGroupEnd3" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Token3ToLog15" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Log15ToAccumulate1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Assign11ToLog5" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart4ToLog23" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Log23ToGroupEnd5" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart4"
                                    tibex:group="groupStart" tibex:xpdlId="c53a737f-e429-4af9-b397-ce87a3e7a16b">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart4ToToken3">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart4ToLog23">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($ATT-ANNArray/tns:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente)=0 and string-length($ATT-ANNArray/tns:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($ATT-ANNArray/tns:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente)=0 and string-length($ATT-ANNArray/tns:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente)=0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:empty name="GroupEnd5"
                                    tibex:group="groupEnd" tibex:xpdlId="4fbaf408-2625-44e6-b5e8-e429ccf2acd3">
                                    <bpws:targets>
                                    <bpws:target linkName="Log5ToGroupEnd3"/>
                                    <bpws:target linkName="Log6ToGroupEnd3"/>
                                    <bpws:target linkName="Log15ToAccumulate1"/>
                                    <bpws:target linkName="Log23ToGroupEnd5"/>
                                    </bpws:targets>
                                    </bpws:empty>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="Token3-input"
                                    name="Token3"
                                    outputVariable="Token3"
                                    tibex:xpdlId="32e82225-13a0-4bf0-9034-1b4d6bb0afd7"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart4ToToken3"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Token3ToLog5">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($Token3/ns35:TOKENIZZAZIONE_RECAPITI)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($Token3/ns35:TOKENIZZAZIONE_RECAPITI)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="Token3ToLog6"
                                    tibex:faultDetailsVar="Token3" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Token3ToLog15">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                        &lt;tns:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                        &lt;/tns:Offerta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta=&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;>&#xa;                        &lt;tns:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                        &lt;/tns:Offerta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta&quot;>&#xa;                            &lt;tns:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta&quot;/>&#xa;                            &lt;/tns:Offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1][qualificaReferente='CF'])&quot;>&#xa;                        &lt;tns:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:FlagReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:FlagReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:RequestVerificaRollout>&#xa;            &lt;tns:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns:Funzione>&#xa;                &lt;tns:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns:ChiaveRiferimento>&#xa;                &lt;tns:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns9:IPAddress&quot;>&#xa;                    &lt;tns:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns9:IPAddress&quot;/>&#xa;                    &lt;/tns:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;>&#xa;                    &lt;tns:N_Recap_Cliente>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;/>&#xa;                    &lt;/tns:N_Recap_Cliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;>&#xa;                    &lt;tns:N_Recap_Cliente_ALT>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;/>&#xa;                    &lt;/tns:N_Recap_Cliente_ALT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;>&#xa;                    &lt;tns:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;/>&#xa;                    &lt;/tns:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;>&#xa;                    &lt;tns:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;/>&#xa;                    &lt;/tns:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:RequestCreate_token>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;            &lt;tns:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/tns:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceSessione&quot;>&#xa;                &lt;tns:NumeroLinea>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceSessione&quot;/>&#xa;                &lt;/tns:NumeroLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta&quot;>&#xa;                &lt;tns:OffertaBPM>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/offerta&quot;/>&#xa;                &lt;/tns:OffertaBPM>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log5-input"
                                    name="Log5"
                                    tibex:xpdlId="37edce56-e4a5-49a2-b42d-70c2c044ffaa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign11ToLog5"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log5ToGroupEnd3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Log5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcNGA_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(' Accumulo Token',tib:render-xml($Referente,true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns9:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
