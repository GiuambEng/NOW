                                    inputVariable="Contatori"
                                    name="Contatori_ALT"
                                    outputVariable="Contatori"
                                    tibex:xpdlId="68e82729-bc70-4b41-a420-a7384033d405" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
