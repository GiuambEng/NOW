                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressiviRichiesta&quot; xmlns:ns1=&quot;http://www.example.org/RichiesteNGAxBPM&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperRaggruppamento&quot;/>&#xa;    &lt;xsl:template name=&quot;ProgrAlt&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ArrayProgressivi>&#xa;            &lt;xsl:for-each select=&quot;$MapperRaggruppamento/ns1:Richieste/ns1:ProgressiviAlt&quot;>&#xa;                &lt;tns2:Progressivo>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/tns2:Progressivo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:ArrayProgressivi>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
