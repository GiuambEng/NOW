                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+dc5c2d51-6cdf-4aa0-a02d-72d6568c0624+input&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:jdbcQueryActivityInput>&#xa;            &lt;COD_PRGT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceProgetto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_PRGT>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                    &lt;codfc_olo_agcom>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/codfc_olo_agcom>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codfc_olo_agcom>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&#xa;                    &lt;/codfc_olo_agcom>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns9:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
