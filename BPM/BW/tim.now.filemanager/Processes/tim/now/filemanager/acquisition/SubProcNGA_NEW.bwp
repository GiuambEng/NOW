                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP FROM OSCURAMENTO_AGESP &#xa;WHERE COD_AGESP IN ('R1I-19-0175','R1I-19-0256','R1I-19-0291','R1C-19-1212','R1I-19-0350','R1I-19-0290','R1I-19-0016','R1I-20-0131','R1I-20-0012','R1I-20-0150','R58-20-1339','R1I-20-0333','R1F-20-0236','R1I-22-0274','R1I-25-0049','R1I-25-0151','R1I-25-0174')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_AGESP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
