                                    <tibex:activityExtension
                                    inputVariable="Referente"
                                    name="Assign3"
                                    outputVariable="Referente"
                                    tibex:xpdlId="a75cd1ee-cce9-4747-a42e-d7db14329de3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
