                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/VerificaProgetto/&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&lt;xsl:param name=&quot;ListaDescrComune&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;CallProcess&quot;/>&lt;xsl:param name=&quot;VerificaCodiceProgetto1&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;JDBCQuery1&quot;/>&lt;xsl:param name=&quot;JDBCQuery2&quot;/>&lt;xsl:param name=&quot;CLLI2&quot;/>&lt;xsl:param name=&quot;Referente&quot;/>&lt;xsl:param name=&quot;FlagFittizio&quot;/>&lt;xsl:param name=&quot;TransitoryPropertyWSDP&quot;/>&lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&lt;xsl:for-each select=&quot;$ATT-ANNArray/tns3:Richiesta[number($index)]&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;xsl:if test=&quot;ambito&quot;>&lt;ambito>&lt;xsl:value-of select=&quot;ambito&quot;/>&lt;/ambito>&lt;/xsl:if>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&lt;/canaleRichiesta>&lt;xsl:if test=&quot;lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;IDRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(codificaOLOA