                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CreaRichiesta-input"
                                    name="CreaRichiesta"
                                    tibex:xpdlId="34e36e36-6355-4daf-a21d-edb1da410e78"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXml1ToCreaRichiesta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToLog1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;CallLocatorATT&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;PriorityCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;FTTC&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml1&quot;/>&#xa;    &lt;xsl:template name=&quot;CreaRichiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Element>&#xa;            &lt;tns9:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns9:moduleName>&#xa;            &lt;tns9:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns9:parameterName>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorATT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns9:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMoperationName&quot;/>&#xa;                    &lt;/tns9:operationName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns9:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSoperationName&quot;/>&#xa;                    &lt;/tns9:operationName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorATT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns9:processName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;                    &lt;/tns9:processName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns9:processName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSprocessName&quot;/>&#xa;                    &lt;/tns9:processName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns9:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderRichiesta&quot;/>&#xa;            &lt;/tns9:value>&#xa;            &lt;tns9:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns2:ID_FILE&quot;/>&#xa;            &lt;/tns9:ID_FILE>&#xa;            &lt;xsl:if test=&quot;$CallLocatorATT/tns8:Risposta/tns8:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot; and $TransitoryProperty=&amp;quot;Y&amp;quot;&quot;>&#xa;                &lt;tns9:priority>&#xa;                    &lt;xsl:value-of select=&quot;$PriorityCRMWS&quot;/>&#xa;                &lt;/tns9:priority>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns9:ContenutoXML>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml1&quot;/>&#xa;            &lt;/tns9:ContenutoXML>&#xa;            &lt;tns9:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns9:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$Richiesta/progressivoRichiestaFile&quot;>&#xa;                &lt;tns9:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns9:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&#xa;                &lt;tns9:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&#xa;                &lt;/tns9:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FTTC='OK'&quot;>&#xa;                    &lt;tns9:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;'FTTC'&quot;/>&#xa;                    &lt;/tns9:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns9:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&#xa;                    &lt;/tns9:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&#xa;                &lt;tns9:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns9:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns9:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
