                                    inputVariable="VerificaCodiceProgetto2-input"
                                    name="VerificaCodiceProgetto2"
                                    outputVariable="VerificaCodiceProgetto2"
                                    tibex:xpdlId="958c4876-48b5-4611-b7b6-a366d91c1697"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty4ToVerificaCodiceProgetto2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VerificaCodiceProgetto2ToEmpty10"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/VerificaProgetto/&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCodiceProgetto2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;>&#xa;                        &lt;tns4:Codfc_Olo_Agicom>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                        &lt;/tns4:Codfc_Olo_Agicom>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:Codfc_Olo_Agicom>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&#xa;                    &lt;/tns4:Codfc_Olo_Agicom>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                &lt;tns4:CodiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                &lt;/tns4:CodiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:Dro>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns2:NextWorkingDate&quot;/>&#xa;            &lt;/tns4:Dro>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.VerificaCodiceProgetto" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
