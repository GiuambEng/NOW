                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log12-input"
                                    name="Log12"
                                    tibex:xpdlId="e59968e9-4b7f-4c60-86e7-a26953814af0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
