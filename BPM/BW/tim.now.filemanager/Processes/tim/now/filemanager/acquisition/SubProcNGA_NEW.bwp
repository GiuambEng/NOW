                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ATT-ANNArray/tns3:Richiesta[number($index)]/codificaOLOAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[number($index)]/codificaOLOAGCOM&quot;>&#xa;                        &lt;tns6:CODFC_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns6:CODFC_OLO_AGCOM>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns6:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&#xa;                    &lt;/tns6:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ListaIdOfferta/tns1:Offerta[upper-case(tns1:Nome_Offerta)=upper-case($ATT-ANNArray/tns3:Richiesta[number($index)]/offerta)]/tns1:ID_Offerta&quot;>&#xa;                &lt;tns6:ID_OFFERTA>&#xa;                    &lt;xsl:value