                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressiviRichiesta&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/VerificaProgetto/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NORMALarray&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;ProgrAlt&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;VerificaCodiceProgetto2&quot;/>&lt;xsl:param name=&quot;JDBCQuery3&quot;/>&lt;xsl:param name=&quot;JDBCQuery4&quot;/>&lt;xsl:param name=&quot;EstrazioneOLO&quot;/>&lt;xsl:param name=&quot;Token9&quot;/>&lt;xsl:param name=&quot;TransitoryPropertyWSDP&quot;/>&lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;xsl:variable name=&quot;rich&quot; select=&quot;$NORMALarray/ns0:Richiesta[number($index)]&quot;/>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;xsd:int($Start/ns2:ID_FILE)&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaPreventivoOpereSpeciali)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;'RICHIESTAPREVENTIVOOPERESPECIALI'&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Variazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Migrazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDACRecipient)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDACDARECIPIENT&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaInterruzioneRecipient)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RISCONTROCODICESESSIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:AccettazioneOpereSpeciali)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$ProgrAlt/tns2:Progressivo[number($index)]&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$ProgrAlt/tns2:Progressivo[number($index)]&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Attivazione) or exists($rich/ns0:TipoRichiesta/ns0:Variazione) or exists($rich/ns0:TipoRichiesta/ns0:Cessazione) or exists($rich/ns0:TipoRichiesta/ns0:Migrazione)&quot;>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($rich/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]))>0&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:IDENTIFICATIVO_RISORSA[1]&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceOlo&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOlo&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineOlo)>0&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineOlo&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento/node()/ns0:ISP)>0&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento/node()/ns0:ISP&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento/node()/ns0:ISP&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaPreventivoOpereSpeciali)&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaPreventivoOpereSpeciali/ns0:CodiceOrdineRiferimentoTI&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaPreventivoOpereSpeciali/ns0:CodiceOrdineRiferimentoTI&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineTIWH[1])>0&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineTIWH&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineTIWH&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento/node()/ns0:TI)>0&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento/node()/ns0:TI&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento/node()/ns0:TI&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineRiferimentoTI)>0&quot;>&lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineRiferimentoTI&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/node()/node()/ns0:CodiceOrdineRiferimentoTI&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string($Start/ns2:DATA_FILE), 1, 10))&quot;/>&lt;/dataInvioRichiesta>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&lt;/contenutoXML>&lt;xsl:choose>&lt;xsl:when test=&quot;matches($rich/ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;note>&lt;xsl:value-of select=&quot;translate($rich/ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&lt;/note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:Note&quot;>&lt;note>&lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:Note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;(exists($rich/ns0:TipoRichiesta/ns0:Variazione) and not(exists($rich/ns0:TipoRichiesta/ns0:Variazione/ns0:VLANNGA))) or (exists($rich/ns0:TipoRichiesta/ns0:Cessazione) and not(exists($rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:VLANNGA)) and not(exists($rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:VLANVULA))) or exists($rich/ns0:TipoRichiesta/ns0:Migrazione) or (((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0) and  (exists($rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:VLANNGA) or exists($rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:VLANVULA) or exists($rich/ns0:TipoRichiesta/ns0:Variazione/ns0:VLANNGA)))&quot;>&lt;ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Variazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(exists($rich/ns0:Testata/ns0:semiVULA) and $rich/ns0:Testata/ns0:semiVULA='SI') and ($FlagOscuramento/Record[COD_AGESP='R1I-21-0101']/FLAG_OSCURMENTO='0' or count($FlagOscuramento/Record[COD_AGESP='R1I-21-0101'])=0)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIVULAFTTH'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;(exists($rich/ns0:Testata/ns0:semiBitstreamNGA) and $rich/ns0:Testata/ns0:semiBitstreamNGA='SI') and ($FlagOscuramento/Record[COD_AGESP='R1I-21-0101']/FLAG_OSCURMENTO='0' or count($FlagOscuramento/Record[COD_AGESP='R1I-21-0101'])=0)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIBITSTREAMNGAFTTH'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;(exists($rich/ns0:Testata/ns0:semiEasyIPNGA) and $rich/ns0:Testata/ns0:semiEasyIPNGA='SI') and ($FlagOscuramento/Record[COD_AGESP='R1I-21-0101']/FLAG_OSCURMENTO='0' or count($FlagOscuramento/Record[COD_AGESP='R1I-21-0101'])=0)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIEASYIPUBBFTTH'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Variazione/ns0:VULAFTTH) and exists($rich/ns0:Testata/ns0:FullGPONPLUS) and $rich/ns0:Testata/ns0:FullGPONPLUS='SI' and (($FlagOscuramento/Record[COD_AGESP='R1I-25-0049']/FLAG_OSCURMENTO='0') or (count($FlagOscuramento/Record[COD_AGESP='R1I-25-0049'])=0))&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'FULLGPONPLUS'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Variazione/ns0:BitstreamNGAFTTH) and exists($rich/ns0:Testata/ns0:FullGPONPLUS) and $rich/ns0:Testata/ns0:FullGPONPLUS='SI' and (($FlagOscuramento/Record[COD_AGESP='R1I-25-0049']/FLAG_OSCURMENTO='0') or (count($FlagOscuramento/Record[COD_AGESP='R1I-25-0049'])=0))&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'FULLGPONPLUSNGA'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;upper-case(local-name($rich/ns0:TipoRichiesta/ns0:Var