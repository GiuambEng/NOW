                                    <bpws:targets>
                                    <bpws:target linkName="Empty16ToToken4"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source
                                    linkName="Token4ToLog7"
                                    tibex:faultDetailsVar="Token4" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Token4ToEmpty15"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Token4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:RequestVerificaRollout>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;>&#xa;                            &lt;tns:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/tns:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns2:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo&quot;>&#xa;                    &lt;tns:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                    &lt;/tns:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Variazione) or exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/ns0:EasyIPUBBFTTH)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/ns0:EasyIPUBBFTTCAB)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/ns0:BitstreamNGAFTTCAB)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/ns0:BitstreamNGAFTTH)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/ns0:VULAFTTCAB)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/ns0:VULAFTTH)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/ns0:EasyIPUBBFTTH)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/ns0:EasyIPUBBFTTCAB)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/ns0:BitstreamNGAFTTCAB)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/ns0:BitstreamNGAFTTH)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/ns0:VULAFTTCAB)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTCAB&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/ns0:VULAFTTH)&quot;>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VULAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                                &lt;/tns:Offerta>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                        &lt;/tns:Offerta>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaPreventivoOpereSpeciali)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;'RICHIESTAPREVENTIVOOPERESPECIALI'&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Variazione)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDACRecipient)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDACDARECIPIENT&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaInterruzioneRecipient)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;RISCONTROCODICESESSIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:AccettazioneOpereSpeciali)&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns0:DatiSede/ns0:CodiceComune[1])>5&quot;>&#xa;                        &lt;tns:CodiceIstatComune>&#xa;                            &lt;xsl:value-of select=&quot;substring($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns0:DatiSede/ns0:CodiceComune[1],string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns0:DatiSede/ns0:CodiceComune[1])-5,6)&quot;/>&#xa;                        &lt;/tns:CodiceIstatComune>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/ns0:Accesso/node()/ns0:DatiSede/ns0:CodiceComune)>5&quot;>&#xa;                        &lt;tns:CodiceIstatComune>&#xa;                            &lt;xsl:value-of select=&quot;substring($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/ns0:Accesso/node()/ns0:DatiSede/ns0:CodiceComune,string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/ns0:Accesso/node()/ns0:DatiSede/ns0:CodiceComune)-5,6)&quot;/>&#xa;                        &lt;/tns:CodiceIstatComune>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns0:DatiSede/ns0:CodiceComune[1])>0 and string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns0:DatiSede/ns0:CodiceComune[1])&amp;lt;=5&quot;>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns0:DatiSede/ns0:CodiceComune&quot;>&#xa;                            &lt;tns:CodiceIstatComune>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns0:DatiSede/ns0:CodiceComune&quot;/>&#xa;                            &lt;/tns:CodiceIstatComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/ns0:Accesso/node()/ns0:DatiSede/ns0:CodiceComune)>0 and string-length($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/ns0:Accesso/node()/ns0:DatiSede/ns0:CodiceComune)&amp;lt;=5&quot;>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/ns0:Accesso/node()/ns0:DatiSede/ns0:CodiceComune&quot;>&#xa;                            &lt;tns:CodiceIstatComune>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/ns0:Accesso/node()/ns0:DatiSede/ns0:CodiceComune&quot;/>&#xa;                            &lt;/tns:CodiceIstatComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:FlagReferente>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:FlagReferente>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:RequestVerificaRollout>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
