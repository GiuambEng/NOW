                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ReferenteAltreLavorazioni"
                                    name="RefAltreLav"
                                    outputVariable="ReferenteAltreLavorazioni"
                                    tibex:xpdlId="b28af606-dc03-4963-a271-634e2e6a787f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXmlToCallProcess1"/>
                                    <bpws:target linkName="CallProcess1ToRefAltreLav"/>
                                    <bpws:target linkName="CallDToRefAltreLav"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:ns59=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NORMALarray&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;CallP&quot;/>&lt;xsl:param name=&quot;CallD&quot;/>&lt;xsl:template name=&quot;ReferenteAltreLavorazioni&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallP/tns:ResponseCreate_token/tns:ESITO='OK' and (exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente) or exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione))&quot;>&lt;ns:ReferenteElement>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivoReferente>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[number($index)]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Referente) &quot;>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEAPPUNTAMENTO&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&