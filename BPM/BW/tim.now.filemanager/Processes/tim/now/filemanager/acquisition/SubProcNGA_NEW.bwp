                                    <tibex:expression
                                    expression="exists($ListaIdOfferta/ns7:Offerta[upper-case(ns7:Nome_Offerta)=upper-case($Richiesta/offerta)]/ns7:ID_Offerta)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($ListaIdOfferta/ns7:Offerta[upper-case(ns7:Nome_Offerta)=upper-case($Richiesta/offerta)]/ns7:ID_Offerta)]]></bpws:transitionCondition>
