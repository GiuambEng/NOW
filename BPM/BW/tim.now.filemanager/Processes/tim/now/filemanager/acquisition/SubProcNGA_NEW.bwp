                                    <bpws:sources>
                                    <bpws:source linkName="Mapper2ToAssign16">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Mapper2ToAssign3">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Mapper2/ns36:Referente)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($Mapper2/ns36:Referente)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/Referenti/&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Request>&#xa;            &lt;xsl:for-each select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/node()/ns0:Servizio/node()/node()/node()/ns0:Referente/ns0:Progressivo[string-length(../ns0:Cognome)>0]&quot;>&#xa;                &lt;tns9:Referente>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;progressivoReferente>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(.)&quot;/>&#xa;                    &lt;/progressivoReferente>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;qualificaReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns0:Qualifica[1]&quot;/>&#xa;                    &lt;/qualificaReferente>&#xa;                    &lt;cognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns0:Cognome&quot;/>&#xa;                    &lt;/cognomeReferente>&#xa;                    &lt;nomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns0:Nome&quot;/>&#xa;                    &lt;/nomeReferente>&#xa;                    &lt;xsl:if test=&quot;../ns0:Telefono&quot;>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns0:Telefono&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;../ns0:Mobile&quot;>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns0:Mobile&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns9:Referente>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns9:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:Referenti="http://www.tim.com/NOW/xsd/Referenti/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Referenti:Request" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
