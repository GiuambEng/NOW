                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;CallLocatorALT&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns5:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns5:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns5:StringaCRMWS,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns5:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns5:StringaCRMWS&quot;/>&lt;/tns5:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;WSDP&amp;quot;&quot;>&lt;tns5:StringaWSDP>&lt;xsl:value-of select=&quot;concat($Contatori/tns5:StringaWSDP,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns5:StringaWSDP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Contatori/tns5:StringaWSDP&quot;>&lt;tns5:StringaWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns5:StringaWSDP&quot;/>&lt;/tns5:StringaWSDP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorALT/tns8:Risposta/tns8:RC=&amp;quot;09&amp;quot; or $CallLocatorALT/tns8:Risposta/tns8:RC=&amp;quot;10&amp;quot; or $CallLocatorALT/tns8:Risposta/tns8:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns5:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns5:StringaSDR,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns5:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns5:StringaSDR&quot;/>&lt;/tns5:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns5:StringaDBCFX&quot;/>&lt;/tns5:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns5:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns5:ContatoreCRMWS+1)&quot;/>&lt;/tns5:ContatoreCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:ContatoreCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns5:ContatoreCRMWS&quot;/>&lt;/tns5:ContatoreCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;WSDP&amp;quot;&quot;>&lt;tns5:ContatoreWSDP>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns5:ContatoreWSDP+1)&quot;/>&lt;/tns5:ContatoreWSDP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Contatori/tns5:ContatoreWSDP&quot;>&lt;tns5:ContatoreWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns5:ContatoreWSDP&quot;/>&lt;/tns5:ContatoreWSDP>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorALT/tns8:Risposta/tns8:RC=&amp;quot;09&amp;quot; or $CallLocatorALT/tns8:Risposta/tns8:RC=&amp;quot;10&amp;quot; or $CallLocatorALT/tns8:Risposta/tns8:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns5:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns5:ContatoreSDR+1)&quot;/>&lt;/tns5:ContatoreSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:ContatoreSDR>&lt;xsl:value-of select=&quot;$Contatori/tns5:ContatoreSDR&quot;/>&lt;/tns5:ContatoreSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns5:ContatoreDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns5:ContatoreDBCFX&quot;/>&lt;/tns5:ContatoreDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&lt;tns5:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns5:ContatoreNOW+1)&quot;/>&lt;/tns5:ContatoreNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:ContatoreNOW>&lt;xsl:value-of select=&quot;$Contatori/tns5:ContatoreNOW&quot;/>&lt;/tns5:ContatoreNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns8:Risposta/tns8:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&lt;tns5:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns5:ContatoreKO+1)&quot;/>&lt;/tns5:ContatoreKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:ContatoreKO>&lt;xsl:value-of select=&quot;$Contatori/tns5:ContatoreKO&quot;/>&lt;/tns5:ContatoreKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns5:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
