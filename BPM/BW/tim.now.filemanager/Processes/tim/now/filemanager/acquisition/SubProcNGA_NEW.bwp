                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/VerificaProgetto/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCodiceProgetto1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                &lt;tns4:Codfc_Olo_Agicom>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns4:Codfc_Olo_Agicom>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/disaggregato&quot;>&#xa;                &lt;tns4:CodiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/disaggregato&quot;/>&#xa;                &lt;/tns4:CodiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/DRO&quot;>&#xa;                &lt;tns4:Dro>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/DRO&quot;/>&#xa;                &lt;/tns4:Dro>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
