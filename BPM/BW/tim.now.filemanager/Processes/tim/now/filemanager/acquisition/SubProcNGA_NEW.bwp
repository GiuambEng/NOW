                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper4-input"
                                    name="Mapper4"
                                    outputVariable="Mapper4"
                                    tibex:xpdlId="26e5bee9-aeb6-4eba-a36d-d586be9ea4ec" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty11ToMapper4"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper4ToLog10"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/ReferenteXML/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Referente>&#xa;            &lt;xsl:for-each select=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[qualificaReferente!='CF' and tipoReferenteOrdine!='REFERENTEONFIELD' and not(telefonoFissoReferente='3333333333') and not(telefonoMobileReferente='3333333333')]&quot;>&#xa;                &lt;tns9:Referente>&#xa;                    &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                        &lt;tns9:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                        &lt;/tns9:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                        &lt;tns9:Qualifica>&#xa;                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                        &lt;/tns9:Qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;nomeReferente&quot;>&#xa;                        &lt;tns9:Nome>&#xa;                            &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                        &lt;/tns9:Nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;cognomeReferente&quot;>&#xa;                        &lt;tns9:Cognome>&#xa;                            &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                        &lt;/tns9:Cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                        &lt;tns9:Telefono>&#xa;                            &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns9:Telefono>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                        &lt;tns9:Mobile>&#xa;                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns9:Mobile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                        &lt;tns9:Email>&#xa;                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                        &lt;/tns9:Email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns9:Referente>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$Referente/tns7:Request[string-length(tns7:Esito)>0]&quot;>&#xa;                &lt;tns9:Referente>&#xa;                    &lt;xsl:if test=&quot;tns7:Referente[1]/progressivoReferente&quot;>&#xa;                        &lt;tns9:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns7:Referente[1]/progressivoReferente&quot;/>&#xa;                        &lt;/tns9:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:Referente[1]/qualificaReferente&quot;>&#xa;                        &lt;tns9:Qualifica>&#xa;                            &lt;xsl:value-of select=&quot;tns7:Referente[1]/qualificaReferente&quot;/>&#xa;                        &lt;/tns9:Qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:Referente[1]/nomeReferente&quot;>&#xa;                        &lt;tns9:Nome>&#xa;                            &lt;xsl:value-of select=&quot;tns7:Referente[1]/nomeReferente&quot;/>&#xa;                        &lt;/tns9:Nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:Referente[1]/cognomeReferente&quot;>&#xa;                        &lt;tns9:Cognome>&#xa;                            &lt;xsl:value-of select=&quot;tns7:Referente[1]/cognomeReferente&quot;/>&#xa;                        &lt;/tns9:Cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:Referente[1]/telefonoFissoReferente&quot;>&#xa;                        &lt;tns9:Telefono>&#xa;                            &lt;xsl:value-of select=&quot;tns7:Referente[1]/telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns9:Telefono>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:Referente[1]/telefonoMobileReferente&quot;>&#xa;                        &lt;tns9:Mobile>&#xa;                            &lt;xsl:value-of select=&quot;tns7:Referente[1]/telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns9:Mobile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:Referente[1]/emailReferente&quot;>&#xa;                        &lt;tns9:Email>&#xa;                            &lt;xsl:value-of select=&quot;tns7:Referente[1]/emailReferente&quot;/>&#xa;                        &lt;/tns9:Email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns9:Referente>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns9:Referente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:ReferenteXML="http://www.tim.com/NOW/xsd/ReferenteXML/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ReferenteXML:Referente" xsi:type="generalactivities:Mapper"/>
                                    </properties>
