                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Richiesta"
                                    name="Arricchimento"
                                    outputVariable="Richiesta"
                                    tibex:xpdlId="1083be99-f451-42a3-b174-48fad9596416" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign2ToArricchimento"/>
                                    <bpws:target linkName="Assign3ToArricchimento"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToRenderXml1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ArricchimentoToMapper6">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Richiesta/ordine/referente[contains(telefonoFissoReferente,'kk') or contains(telefonoMobileReferente, 'kk')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($Richiesta/ordine/referente[contains(telefonoFissoReferente,'kk') or contains(telefonoMobileReferente, 'kk')])>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;ID_Offerta&quot;/>&lt;xsl:param name=&quot;DescrComune&quot;/>&lt;xsl:param name=&quot;CallLocatorALT&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;Referente&quot;/>&lt;xsl:param name=&quot;Token9&quot;/>&lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;$Richiesta/created&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;$Richiesta/lastUpdate&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;$Richiesta/operatore&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Richiesta/IDRichiestaOLO&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaNOW&quot;/>&lt;/statoRichiestaNOW>&lt;xsl:if test=&quot;$Richiesta/statoRichiestaPrecedNOW&quot;>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaPrecedNOW&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/statoRichiestaOLO&quot;>&lt;statoRichiestaOLO>&lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaOLO&quot;/>&lt;/statoRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;>&lt;statoRichiestaPrecedOLO>&lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;/>&lt;/statoRichiestaPrecedOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/sottostatoLavorManuale&quot;>&lt;sottostatoLavorManuale>&lt;xsl:value-of select=&quot;$Richiesta/sottostatoLavorManuale&quot;/>&lt;/sottostatoLavorManuale>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/IDFileInput&quot;>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Richiesta/IDFileInput&quot;/>&lt;/IDFileInput>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/IDFileOutput&quot;>&lt;IDFileOutput>&lt;xsl:value-of select=&quot;$Richiesta/IDFileOutput&quot;/>&lt;/IDFileOutput>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&lt;ambito>&lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&lt;/ambito>&lt;/xsl:if>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/canaleRichiesta&quot;/>&lt;/canaleRichiesta>&lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&lt;/lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/progressivoRichiestaFile&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$Richiesta/progressivoRichiestaFile&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;$Richiesta/tipoRichiesta&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&lt;codiceOrdineOLOTarget>&lt