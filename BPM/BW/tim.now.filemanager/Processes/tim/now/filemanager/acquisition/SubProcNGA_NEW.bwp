>&lt;/ns0:ClienteFinale>&lt;ns0:SlaAssurance>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/ns0:SlaAssurance>&lt;ns0:NumeroLinea>&lt;xsl:value-of select=&quot;'V0'&quot;/>&lt;/ns0:NumeroLinea>&lt;ns0:ProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;'V0'&quot;/>&lt;/ns0:ProfiloTecnicoLinea>&lt;ns0:Tecnologia>&lt;xsl:value-of select=&quot;'V'&quot;/>&lt;/ns0:Tecnologia>&lt;ns0:UserVLAN_1_TAGGING>&lt;xsl:value-of select=&quot;'Tagged'&quot;/>&lt;/ns0:UserVLAN_1_TAGGING>&lt;ns0:Encapsulation>&lt;xsl:value-of select=&quot;'SINGLETAG'&quot;/>&lt;/ns0:Encapsulation>&lt;/ns0:LineaPOTS>&lt;/ns0:Accesso>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:BitstreamNGAFTTCAB/ns0:UserVlan&quot;/>&lt;/ns0:BitstreamNGAFTTCAB>&lt;/ns0:Servizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:DatiMigrazione&quot;/>&lt;/ns0:Attivazione274>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            