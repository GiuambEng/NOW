                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns10="http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter" xmlns:tns9="http://www.tim.com/NOW/xsd/ReplaceCharacter" xmlns:ns0="http://xsd.telecomitalia.it/crm/xdsl/nga" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="NORMALarray"/&gt;
    &lt;xsl:param name="Mapper7"/&gt;
    &lt;xsl:template name="Invoke2-input" match="/"&gt;
        &lt;tns10:ReplaceCharacterRequest&gt;
            &lt;ReplaceCharacterInput&gt;
                &lt;tns9:InputString&gt;
                    &lt;tns9:OldString&gt;
                        &lt;xsl:value-of select="tib:render-xml($Mapper7, true(), true())"/&gt;
                    &lt;/tns9:OldString&gt;
                    &lt;tns9:OldChar&gt;
                        &lt;xsl:value-of select="'tns:'"/&gt;
                    &lt;/tns9:OldChar&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="contains(tib:render-xml($NORMALarray/ns0:Richiesta[$index]),'ns0:')"&gt;
                            &lt;tns9:NewChar&gt;
                                &lt;xsl:value-of select="'ns0:'"/&gt;
                            &lt;/tns9:NewChar&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns9:NewChar&gt;
                                &lt;xsl:value-of select="'ns01:'"/&gt;
                            &lt;/tns9:NewChar&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns9:InputString&gt;
            &lt;/ReplaceCharacterInput&gt;
        &lt;/tns10:ReplaceCharacterRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
