                                    inputVariable="CreaRichiestaALT-input"
                                    name="CreaRichiestaALT"
                                    tibex:xpdlId="52a8cf1c-9cc4-49a3-8a2f-22d92b3027a9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
