                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Request>&#xa;            &lt;tns:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ATTarray/tns3:Richiesta[$index]/offerta='EASYIPNGAFTTCAB'&quot;>&#xa;                        &lt;tns:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                        &lt;/tns:Offerta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ATTarray/tns3:Richiesta[$index]/offerta=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                        &lt;tns:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                        &lt;/tns:Offerta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/offerta&quot;>&#xa;                            &lt;tns:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/offerta&quot;/>&#xa;                            &lt;/tns:Offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1][qualificaReferente='CF'])&quot;>&#xa;                        &lt;tns:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:FlagReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:FlagReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:RequestVerificaRollout>&#xa;            &lt;tns:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns:Funzione>&#xa;                &lt;tns:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATTarray/tns3:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns:ChiaveRiferimento>&#xa;                &lt;tns:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns9:IPAddress&quot;>&#xa;                    &lt;tns:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns9:IPAddress&quot;/>&#xa;                    &lt;/tns:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;>&#xa;                    &lt;tns:N_Recap_Cliente>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;/>&#xa;                    &lt;/tns:N_Recap_Cliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;>&#xa;                    &lt;tns:N_Recap_Cliente_ALT>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;/>&#xa;                    &lt;/tns:N_Recap_Cliente_ALT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;>&#xa;                    &lt;tns:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;/>&#xa;                    &lt;/tns:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;>&#xa;                    &lt;tns:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;/>&#xa;                    &lt;/tns:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:RequestCreate_token>&#xa;            &lt;tns:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:ProcessIstance>&#xa;            &lt;tns:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/tns:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codiceSessione&quot;>&#xa;                &lt;tns:NumeroLinea>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codiceSessione&quot;/>&#xa;                &lt;/tns:NumeroLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/offerta&quot;>&#xa;                &lt;tns:OffertaBPM>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/offerta&quot;/>&#xa;                &lt;/tns:OffertaBPM>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log1-input"
                                    name="Log1"
                                    tibex:xpdlId="2e50d5dd-2f76-47b0-9606-fe1db3aa92ca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign2ToLog1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log1ToGroupEnd3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Log1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcNGA_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(' Accumulo Token',tib:render-xml($Referente,true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns9:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
