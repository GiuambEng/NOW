                                    <tibex:activityExtension
                                    inputVariable="Referente"
                                    name="Assign11"
                                    outputVariable="Referente"
                                    tibex:xpdlId="0d8deedd-3e11-439d-a6fd-7c3fbc740a02" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
