     &lt;/tns:RequestVerificaRollout>&#xa;            &lt;tns:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns:Funzione>&#xa;                &lt;tns:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATT-ANNArray/tns3:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns:ChiaveRiferimento>&#xa;                &lt;tns:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns9:IPAddress&quot;>&#xa;                    &lt;tns:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns9:IPAddress&quot;/>&#xa;                    &lt;/tns:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/nome&quot;>&#xa;                    &lt;tns:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/nome&quot;/>&#xa;                    &lt;/tns:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot