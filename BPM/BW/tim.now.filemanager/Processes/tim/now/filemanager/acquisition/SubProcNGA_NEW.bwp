                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log11-input"
                                    name="Log11"
                                    tibex:xpdlId="f7a1026e-040b-442f-b442-c4f9d881752c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Mapper5ToLog11"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log11ToInvoke"/>
                                    </bpws:sources>
