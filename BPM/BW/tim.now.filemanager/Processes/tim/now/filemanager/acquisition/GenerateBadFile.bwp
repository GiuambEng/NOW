                                    sqlStatement="UPDATE ESEC_PROCSO_FILE&#xa;  SET STATO_ESEC = 'CHIUSO'&#xa;  WHERE ID_ESEC_PROCSO_FILE=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
