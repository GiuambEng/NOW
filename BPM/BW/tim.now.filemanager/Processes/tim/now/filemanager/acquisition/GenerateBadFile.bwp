                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+020894bb-f477-4fab-a022-7daf4ada09bf+input&quot; xmlns:tns1=&quot;http://www.example.org/GenerateBadFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateFileProcsto-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ESITO>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/ESITO>&lt;TIMSTP_CHIUSURA_FILE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/TIMSTP_CHIUSURA_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:NomeFile,'_NPNG')&quot;>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns1:NomeFile, &amp;quot;_NPNG.xml&amp;quot;),&amp;quot;.csv&amp;quot;)&quot;/>&lt;/NOME_FILE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NOME_FILE>&lt;xsl:value-of select=&quot;$Start/tns1:NomeFile&quot;/>&lt;/NOME_FILE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_FILE>&lt;xsl:value-of select=&quot;$Start/tns1:IDfile&quot;/>&lt;/ID_FILE>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
