cap_Cliente_ALT>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:N_Recap_Cliente_ALT&quot;/>&lt;/tns:N_Recap_Cliente_ALT>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:Note&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:Note&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:Nome&quot;>&lt;tns:Nome>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:Nome&quot;/>&lt;/tns:Nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale&quot;>&lt;tns:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:CognomeRagioneSociale&quot;/>&lt;/tns:CognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:CodiceFiscale&quot;>&lt;tns:CodiceFiscale>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:CodiceFiscale&quot;/>&lt;/tns:CodiceFiscale>&lt;/xsl:if>&lt;xsl:if test=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:PIVA&quot;>&lt;tns:PIVA>&lt;xsl:value-of select=&quot;$DecodeSECOLO/Output/tns1:ResponseDecode_token/tns1:PIVA&quot;/>&lt;/tns:PIVA>&lt;/xsl:if>&lt;/tns:ResponseDecode_token>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Rollout/Output/tns2:ResponseVerificaRollout)&quot;>&lt;tns:Rollout>&lt;xsl:value-of select=&quot;$Rollout/Output/tns2:ResponseVerificaRollout/tns2:ESITO&quot;/>&lt;/tns:Rollout>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Rollout/Output/tns2:ResponseVerificaRollout/tns2:TOKENIZZAZIONE_RECAPITI)>0  and upper-case($Rollout/Output/tns2:ResponseVerificaRollout/tns2:TOKENIZZAZIONE_RECAPITI)='SI'&quot;>&lt;tns:TOKENIZZAZIONE_RECAPITI>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/tns:TOKENIZZAZIONE_RECAPITI>&lt;/xsl:if>&lt;xsl:if test=&quot;$Rollout/Output/tns2:Re