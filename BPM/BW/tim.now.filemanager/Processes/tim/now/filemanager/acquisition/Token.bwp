            <bpws:invoke inputVariable="VerificaIDRisorsaSub-input"
                name="VerificaIDRisorsaSub"
                operation="VerificaIDRisorsa"
                outputVariable="VerificaIDRisorsaSub"
                partnerLink="VerificaIDRisorsaSub"
                portType="ns7:BPM_CheckServiceAmmissibilitaPortType" tibex:xpdlId="b88a5e75-2946-4096-a50b-3725a3a22408">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/Token/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/" xmlns:tns2="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="JDBCQuery"/&gt;
    &lt;xsl:template name="VerificaIDRisorsaSub-input" match="/"&gt;
        &lt;tns1:VerificaIDRisorsaRequest&gt;
            &lt;input&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="count($JDBCQuery/Record)&gt;0"&gt;
                        &lt;tns2:Verifica_ID_Risorsa_Request&gt;
                            &lt;xsl:if test="not($JDBCQuery/Record[1]/LAVORAZIONE='ATTIVAZIONE')"&gt;
                                &lt;xsl:if test="$JDBCQuery/Record[1]/IDRISORSA"&gt;
                                    &lt;tns2:IDRisorsa&gt;
                                        &lt;xsl:value-of select="$JDBCQuery/Record[1]/IDRISORSA"/&gt;
                                    &lt;/tns2:IDRisorsa&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns2:Offerta&gt;
                                &lt;xsl:value-of select="upper-case($JDBCQuery/Record[1]/OFFERTA)"/&gt;
                            &lt;/tns2:Offerta&gt;
                            &lt;tns2:CodiceOLOAGCOM&gt;
                                &lt;xsl:value-of select="$JDBCQuery/Record[1]/CODIFICAOLOAGCOM"/&gt;
                            &lt;/tns2:CodiceOLOAGCOM&gt;
                            &lt;xsl:if test="$JDBCQuery/Record[1]/STRUTTURARICHIESTA"&gt;
                                &lt;tns2:StrutturaRichiesta&gt;
                                    &lt;xsl:value-of select="$JDBCQuery/Record[1]/STRUTTURARICHIESTA"/&gt;
                                &lt;/tns2:StrutturaRichiesta&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$JDBCQuery/Record[1]/LAVORAZIONE"&gt;
                                &lt;tns2:Lavorazione&gt;
                                    &lt;xsl:value-of select="$JDBCQuery/Record[1]/LAVORAZIONE"/&gt;
                                &lt;/tns2:Lavorazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$JDBCQuery/Record[1]/LAVORAZIONE='ATTIVAZIONE'"&gt;
                                &lt;xsl:if test="$JDBCQuery/Record[1]/IDRISORSA"&gt;
                                    &lt;tns2:NumeroLinea&gt;
                                        &lt;xsl:value-of select="$JDBCQuery/Record[1]/IDRISORSA"/&gt;
                                    &lt;/tns2:NumeroLinea&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$Start/tns:ProcessIstance"&gt;
                                &lt;tns2:IDRichiestaOLO&gt;
                                    &lt;xsl:value-of select="$Start/tns:ProcessIstance"/&gt;
                                &lt;/tns2:IDRichiestaOLO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns2:Verifica_ID_Risorsa_Request&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns2:Verifica_ID_Risorsa_Request&gt;
                            &lt;xsl:if test="$Start/tns:IDRisorsa"&gt;
                                &lt;tns2:IDRisorsa&gt;
                                    &lt;xsl:value-of select="$Start/tns:IDRisorsa"/&gt;
                                &lt;/tns2:IDRisorsa&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="upper-case($Start/tns:OffertaBPM)=&amp;quot;BITSTREAMATMASIMM&amp;quot;"&gt;
                                    &lt;tns2:Offerta&gt;
                                        &lt;xsl:value-of select="&amp;quot;BITSTREAMATMASIMMETRICO&amp;quot;"/&gt;
                                    &lt;/tns2:Offerta&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="upper-case($Start/tns:OffertaBPM)=&amp;quot;BITSTREAMATMSIMM&amp;quot;"&gt;
                                    &lt;tns2:Offerta&gt;
                                        &lt;xsl:value-of select="&amp;quot;BITSTREAMATMSIMMETRICO&amp;quot;"/&gt;
                                    &lt;/tns2:Offerta&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="upper-case($Start/tns:OffertaBPM)=&amp;quot;BITSTREAMGBESIMM&amp;quot;"&gt;
                                    &lt;tns2:Offerta&gt;
                                        &lt;xsl:value-of select="&amp;quot;BITSTREAMGBESIMMETRICO&amp;quot;"/&gt;
                                    &lt;/tns2:Offerta&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="upper-case($Start/tns:OffertaBPM)=&amp;quot;BITSTREAMGBEASIMM&amp;quot;"&gt;
                                    &lt;tns2:Offerta&gt;
                                        &lt;xsl:value-of select="&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;"/&gt;
                                    &lt;/tns2:Offerta&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="upper-case($Start/tns:OffertaBPM)=&amp;quot;EASYIPUBBFTTH&amp;quot;"&gt;
                                    &lt;tns2:Offerta&gt;
                                        &lt;xsl:value-of select="&amp;quot;EASYIPNGAFTTH&amp;quot;"/&gt;
                                    &lt;/tns2:Offerta&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="upper-case($Start/tns:OffertaBPM)=&amp;quot;EASYIPUBBFTTCAB&amp;quot;"&gt;
                                    &lt;tns2:Offerta&gt;
                                        &lt;xsl:value-of select="&amp;quot;EASYIPNGAFTTCAB&amp;quot;"/&gt;
                                    &lt;/tns2:Offerta&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns2:Offerta&gt;
                                        &lt;xsl:value-of select="upper-case($Start/tns:OffertaBPM)"/&gt;
                                    &lt;/tns2:Offerta&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;tns2:CodiceOLOAGCOM&gt;
                                &lt;xsl:value-of select="$Start/tns:RequestVerificaRollout/tns:CodificaOLOAGCOM"/&gt;
                            &lt;/tns2:CodiceOLOAGCOM&gt;
                            &lt;xsl:if test="$Start/tns:StrutturaRichiesta"&gt;
                                &lt;tns2:StrutturaRichiesta&gt;
                                    &lt;xsl:value-of select="$Start/tns:StrutturaRichiesta"/&gt;
                                &lt;/tns2:StrutturaRichiesta&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$Start/tns:RequestVerificaRollout/tns:Lavorazione"&gt;
                                &lt;tns2:Lavorazione&gt;
                                    &lt;xsl:value-of select="$Start/tns:RequestVerificaRollout/tns:Lavorazione"/&gt;
                                &lt;/tns2:Lavorazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$Start/tns:NumeroLinea"&gt;
                                &lt;tns2:NumeroLinea&gt;
                                    &lt;xsl:value-of select="$Start/tns:NumeroLinea"/&gt;
                                &lt;/tns2:NumeroLinea&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="$Start/tns:ProcessIstance"&gt;
                                &lt;tns2:IDRichiestaOLO&gt;
                                    &lt;xsl:value-of select="$Start/tns:ProcessIstance"/&gt;
                                &lt;/tns2:IDRichiestaOLO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns2:Verifica_ID_Risorsa_Request&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/input&gt;
        &lt;/tns1:VerificaIDRisorsaRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaIDRisorsaSub-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                &lt;tns2:Verifica_ID_Risorsa_Request>&#xa;                    &lt;xsl:if test=&quot;not($JDBCQuery/Record[1]/LAVORAZIONE='ATTIVAZIONE')&quot;>&#xa;                        &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/IDRISORSA&quot;>&#xa;                            &lt;tns2:IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/IDRISORSA&quot;/>&#xa;                            &lt;/tns2:IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($JDBCQuery/Record[1]/OFFERTA)&quot;/>&#xa;                    &lt;/tns2:Offerta>&#xa;                    &lt;tns2:CodiceOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                    &lt;/tns2:CodiceOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/STRUTTURARICHIESTA&quot;>&#xa;                        &lt;tns2:StrutturaRichiesta>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/STRUTTURARICHIESTA&quot;/>&#xa;                        &lt;/tns2:StrutturaRichiesta>&#xa;                    &lt;/x