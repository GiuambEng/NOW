E)&quot;/>&#xa;                        &lt;/tns:DESCRIZIONE>&#xa;                    &lt;/tns:ResponseCreate_token>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($DecodeSECOLO.Output)&quot;>&#xa;                &lt;tns:ResponseDecode_token>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns1:ESITO&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns1:DESCRIZIONE&quot;>&#xa;                        &lt;tns:DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns1:DESCRIZIONE&quot;/>&#xa;                        &lt;/tns:DESCRIZIONE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns1:N_Recap_Cliente&quot;>&#xa;                        &lt;tns:N_Recap_Cliente>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns1:N_Recap_Cliente&quot;/>&#xa;                        &lt;/tns:N_Recap_Cliente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns1:N_Recap_Cliente_ALT&quot;>&#xa;                        &lt;tns:N_Recap_Cliente_ALT>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns1:N_Recap_Cliente_ALT&quot;/>&#xa;                        &lt;/tns:N_Recap_Cliente_ALT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns1:Note&quot;>&#xa;                        &lt;tns:Note>&#xa;                            &lt;xsl:value-of select=&quot;$DecodeSECOLO.Output/tns1:Note&quot;/>&#xa;                        &lt;/tns:Note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$DecodeSECOLO.Output/tns1:Nome&quot;>&#xa;                        &lt;tns:Nome>&#xa;                    