                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="c6326272-0a73-4734-8576-f2a9300ca0df" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Rollout.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;SECOLO.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;DecodeSECOLO.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;variable&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$variable='True'&quot;>&#xa;                    &lt;tns:ResponseCreate_token>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente&quot;>&#xa;                            &lt;tns:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente&quot;/>&#xa;                            &lt;/tns:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente_ALT&quot;>&#xa;                            &lt;tns:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente_ALT&quot;/>&#xa;                            &lt;/tns:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:Nome&quot;>&#xa;                            &lt;tns:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:Nome&quot;/>&#xa;                            &lt;/tns:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:CognomeRagioneSociale&quot;>&#xa;                            &lt;tns:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:CognomeRagioneSociale&quot;/>&#xa;                            &lt;/tns:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:CodiceFiscale&quot;>&#xa;                            &lt;tns:CodiceFiscale>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:CodiceFiscale&quot;/>&#xa;                            &lt;/tns:CodiceFiscale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:PIVA&quot;>&#xa;                            &lt;tns:PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:PIVA&quot;/>&#xa;                            &lt;/tns:PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:ESITO>&#xa;                        &lt;tns:DESCRIZIONE>&#xa;                            &lt;xsl:value-of select=&quot;'X'&quot;/>&#xa;                        &lt;/tns:DESCRIZIONE>&#xa;                    &lt;/tns:ResponseCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($SECOLO.Output)&quot;>&#xa;                    &lt;tns:ResponseCreate_token>&#xa;                        &lt;xsl:if test=&quot;$SECOLO.Output/tns1:Token&quot;>&#xa;                            &lt;tns:Token>&#xa;                                &lt;xsl:value-of select=&quot;$SECOLO.Output/tns1:Token&quot;/