            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="IDRICHIESTAOLO" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="LAVORAZIONE"
