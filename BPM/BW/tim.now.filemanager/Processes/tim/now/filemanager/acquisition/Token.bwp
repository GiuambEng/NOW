                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/Token/" xmlns:ns="http://www.tibco.com/NOW_SECOLO_ROLLOUT/" xmlns:tns1="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/" xmlns:tns2="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="VerificaIDRisorsaSub"/&gt;&lt;xsl:param name="JDBCQuery"/&gt;&lt;xsl:template name="Rollout-input" match="/"&gt;&lt;ns:VerificaRollout_NOWSecoloRequest&gt;&lt;Input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($JDBCQuery/Record)&gt;0"&gt;&lt;tns1:RequestVerificaRollout&gt;&lt;xsl:if test="$JDBCQuery/Record[1]/CODIFICAOLOAGCOM"&gt;&lt;tns1:CodificaOLOAGCOM&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/CODIFICAOLOAGCOM"/&gt;&lt;/tns1:CodificaOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$JDBCQuery/Record[1]/CODIFICAOLONOW"&gt;&lt;tns1:CodificaOloNumerico&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/CODIFICAOLONOW"/&gt;&lt;/tns1:CodificaOloNumerico&gt;&lt;/xsl:if&gt;&lt;tns1:Offerta&gt;&lt;xsl:value-of select="upper-case($JDBCQuery/Record[1]/OFFERTA)"/&gt;&lt;/tns1:Offerta&gt;&lt;xsl:if test="$JDBCQuery/Record[1]/LAVORAZIONE"&gt;&lt;tns1:Lavorazione&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/LAVORAZIONE"/&gt;&lt;/tns1:Lavorazione&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($JDBCQuery/Record[1]/ISTATCOMUNE)&gt;0"&gt;&lt;xsl:if test="$JDBCQuery/Record[1]/ISTATCOMUNE"&gt;&lt;tns1:CodiceIstatComune&gt;&lt;xsl:value-of select="$JDBCQuery/Record[1]/ISTATCOMUNE"/&gt;&lt;/tns1:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$VerificaIDRisorsaSub/output/tns2:Verifica_ID_Risorsa_Response/tns2:CodiceIstatComune"&gt;&lt;tns1:CodiceIstatComune&gt;&lt;xsl:value-of select="$VerificaIDRisorsaSub/output/tns2:Verifica_ID_Risorsa_Response/tns2:CodiceIstatComune"/&gt;&lt;/tns1:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:FlagReferente&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/tns1:FlagReferente&gt;&lt;xsl:if test="$Start/tns:RequestVerificaRollout/tns:FlagClienteFinale"&gt;&lt;tns1:FlagClienteFinale&gt;&lt;xsl:value-of select="$Start/tns:RequestVerificaRollout/tns:FlagClienteFinale"/&gt;&lt;/tns1:FlagClienteFinale&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:RequestVerificaRollout/tns:CodiceOrdineOLO"&gt;&lt;tns1:CodiceOrdineOLO&gt;&lt;xsl:value-of select="$Start/tns:RequestVerificaRollout/tns:CodiceOrdineOLO"/&gt;&lt;/tns1:CodiceOrdineOLO&gt;&lt;/xsl:if&gt;&lt;/tns1:RequestVerificaRollout&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:RequestVerificaRollout&gt;&lt;xsl:if test="$Start/tns:RequestVerificaRollout/tns:CodificaOLOAGCOM"&gt;&lt;tns1:CodificaOLOAGCOM&gt;&lt;xsl:value-of select="$Start/tns:RequestVerificaRollout/tns:CodificaOLOAGCOM"/&gt;&lt;/tns1:CodificaOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:RequestVerificaRollout/tns:CodificaOloNumerico"&gt;&lt;tns1:CodificaOloNumerico&gt;&lt;xsl:value-of select="$Start/tns:RequestVerificaRollout/tns:CodificaOloNumerico"/&gt;&lt;/tns1:CodificaOloNumerico&gt;&lt;/xsl:if&gt;&lt;tns1:Offerta&gt;&lt;xsl:value-of select="upper-case($Start/tns:RequestVerificaRollout/tns:Offerta)"/&gt;&lt;/tns1:Offerta&gt;&lt;xsl:if test="$Start/tns:RequestVerificaRollout/tns:Lavorazione"&gt;&lt;tns1:Lavorazione&gt;&lt;xsl:value-of select="$Start/tns:RequestVerificaRollout/tns:Lavorazione"/&gt;&lt;/tns1:Lavorazione&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($VerificaIDRisorsaSub/output/tns2:Verifica_ID_Risorsa_Response/tns2:CodiceIstatComune)&gt;0"&gt;&lt;xsl:if test="$VerificaIDRisorsaSub/output/tns2:Verifica_ID_Risorsa_Response/tns2:CodiceIstatComune"&gt;&lt;tns1:CodiceIstatComune&gt;&lt;xsl:value-of select="$VerificaIDRisorsaSub/output/tns2:Verifica_ID_Risorsa_Response/tns2:CodiceIstatComune"/&gt;&lt;/tns1:CodiceIstatComune&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/t