                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:ns=&quot;http://www.tibco.com/NOW_SECOLO_ROLLOUT/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.output&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;Rollout-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                &lt;tns1:RequestVerificaRollout>&#xa;                    &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                        &lt;tns1:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                        &lt;/tns1:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODIFICAOLONOW&quot;>&#xa;                        &lt;tns1:CodificaOloNumerico>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODIFICAOLONOW&quot;/>&#xa;                        &lt;/tns1:CodificaOloNumerico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($JDBCQuery/Record[1]/OFFERTA)&quot;/>&#xa;                    &lt;/tns1:Offerta>&#xa;                    &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/LAVORAZIONE&quot;>&#xa;                        &lt;tns1:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/LAVORAZIONE&quot;/>&#xa; 