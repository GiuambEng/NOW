            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Rollout&quot;/>&lt;xsl:param name=&quot;DecodeSECOLO&quot;/>&lt;xsl:param name=&quot;variable&quot;/>&lt;xsl:param name=&quot;SECOLO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$variable='True'&quot;>&lt;tns:ResponseCreate_token>&lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente&quot;>&lt;tns:N_Recap_Cliente>&lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente&quot;/>&lt;/tns:N_Recap_Cliente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente_ALT&quot;>&lt;tns:N_Recap_Cliente_ALT>&lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:N_Recap_Cliente_ALT&quot;/>&lt;/tns:N_Recap_Cliente_ALT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:Nome&quot;>&lt;tns:Nome>&lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:Nome&quot;/>&lt;/tns:Nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:CognomeRagioneSociale&quot;>&lt;tns:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:CognomeRagioneSociale&quot;/>&lt;/tns:CognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:CodiceFiscale&quot;>&lt;tns:CodiceFiscale>&lt;xsl:value-of select=&quot;$Start/tns:RequestCreate_token/tns:CodiceFiscale&quot;/>&lt;/tns:CodiceFiscale>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:RequestCreate_token/tns:PIVA&quot;>&lt;tns:PIVA>&lt;xsl:value-of select=&quo