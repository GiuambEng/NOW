                                    name="RenderXmlTocreateProcessInstance" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="RenderAnnullamentoToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="CallProcessToCallProcess11" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcess1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="TransformXml1ToTransformXml" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="AnnullamentoCasedataToRemoveNSnow" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RemNSnow2ToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="NOWcounterToRenderRichiesta" tibex:linkType="SUCCESS"/>
                                <bpws:link name="DROToEmpty2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty2ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="DateToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty2ToAttivazioneCasedata" tibex:linkType="SUCCESSWITHCONDITION"/>
