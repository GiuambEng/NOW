                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="50cd9c9d-4826-4ad2-a20f-abdabb09970d">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToWhile"/>
                    <bpws:target linkName="EmptyToWhile"/>
