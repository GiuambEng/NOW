lt;xsl:when test=&quot;exists($rich/ns2:Portin) or exists($rich/ns2:Cessazione)&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Prenotifica_Donating)&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/ns2:NomeFile, '103N_NP_'), '_')&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$rich/node()/ns2:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$rich/node()/ns2:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($rich/node()/ns2:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($rich/node()/ns2:IdentificativoOperatoreDonating)]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns2:Portin) or exists($rich/ns2:Cessazione)&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;'002'&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Prenotifica_Donating)&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=substring-before(substring-after($Start/ns2:NomeFile, '103N_NP_'), '_')]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=substring-before(substring-after($Start/ns2:NomeFile, '103N_NP_'), '_')]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=string($rich/node()/ns2:IdentificativoOperatoreDonor)]/tns1:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns1:codes