                                <bpws:link name="AssignToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToLog1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Log1ToAttivazioneCasedata" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogToAttivazioneCasedata" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty3ToDRO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="Empty3ToAttivazioneCasedata_CalcoloDROskip"
