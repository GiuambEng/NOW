                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderAnnullamento&quot;/>&#xa;    &lt;xsl:template name=&quot;LogBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Appilcation: tim.now.filemanager.application | Process: 103N_NP | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Richieste inviata al BPM: &amp;quot;, $RenderRichiesta,$RenderAnnullamento)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke inputVariable="DRO-input"
                                name="DRO"
                                operation="calcNextWorkingDate"
                                outputVariable="DRO"
                                partnerLink="GetNextDatePortType"
                                portType="ns12:GetNextDatePortType" tibex:xpdlId="6ece8ead-0cd0-482e-906d-5cc8a718d8e4">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns2="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:ns2="http://www.tim.com/NOW/xsd/103N_NP_start" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="TimestampNP"/&gt;
    &lt;xsl:template name="DRO-input" match="/"&gt;
        &lt;tns3:calcNextWorkingDateRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:CalcRequest&gt;
                    &lt;xsl:variable name="richiesta" select="$Start/ns2:ComunicazioneNP/ns2:Richiesta[number($index)]"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($richiesta/*/ns2:DataOrdine)"&gt;
                            &lt;tns2:inputDate&gt;
                                &lt;xsl:value-of select="$richiesta/*/ns2:DataOrdine"/&gt;
                            &lt;/tns2:inputDate&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns2:inputDate&gt;
                                &lt;xsl:value-of select="xsd:date($TimestampNP/Record[1]/DATA_FILE)"/&gt;
                            &lt;/tns2:inputDate&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns2:TipoData&gt;
                        &lt;xsl:value-of select="&amp;quot;DRO&amp;quot;"/&gt;
                    &lt;/tns2:TipoData&gt;
                &lt;/tns2:CalcRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns3:calcNextWorkingDateRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TimestampNP&quot;/>&#xa;    &lt;xsl:template name=&quot;DRO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CalcRequest>&#xa;            &lt;xsl:variable name=&quot;richiesta&quot; select=&quot;$Start/ns2:ComunicazioneNP/ns2:Richiesta[number($index)]&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/*/ns2:DataOrdine)&quot;>&#xa;                    &lt;tns2:inputDate>&#xa;                        &lt;xsl:value-of select=&quot;$richiesta/*/ns2:DataOrdine&quot;/>&#xa;                    &lt;/tns2:inputDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:inputDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($TimestampNP/Record[1]/DATA_FILE)&quot;/>&#xa;                    &lt;/tns2:inputDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:TipoData>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DRO&amp;quot;&quot;/>&#xa;            &lt;/tns2:TipoData>&#xa;        &lt;/tns2:CalcRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="Empty3ToDRO"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="DROToEmpty2"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="AnnullamentoCasedata"
                                    name="AnnullamentoCasedata"
                                    outputVariable="AnnullamentoCasedata"
                                    tibex:xpdlId="bc4aff2e-e69f-41cd-865c-0fb594a0b394" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign2ToAnnullamentoCasedata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AnnullamentoCasedataToRemoveNSnow"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;OLO_NORM&quot;/>&lt;xsl:param name=&quot;TimestampNP&quot;/>&lt;xsl:param name=&quot;CodiceOrdine&quot;/>&lt;xsl:template name=&quot;AnnullamentoCasedata&quot; match=&quot;/&quot;>&lt;xsl:variable name=&quot;richiesta&quot; select=&quot;$Start/ns2:ComunicazioneNP/ns2:Richiesta[ns2:Annullamento/ns2:CodiceOrdine=$CodiceOrdine]&quot;/>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Start/ns2:IDfile&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($richiesta/ns2:Annullamento) and $richiesta/ns2:Annullamento/ns2:TipoComunicazione='11'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns2:Annullamento) and $richiesta/ns2:Annullamento/ns2:TipoComunicazione='18'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTORECIPIENT&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns2:Rimodulazione_DAC)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAC&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns2:Rimodulazione_DAC_Recipient) and $richiesta/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='16'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RDACRECIPIENTDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns2:Rimodulazione_DAC_Recipient) and $richiesta/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='17'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RDACDONORDONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns2:Cessazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($richiesta/ns2:Portin)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PORTIN&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns2:Progressivi/ns2:Progressivo[number($index)]&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$Start/ns2:Progressivi/ns2:Progressivo[number($index)]&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($richiesta/ns2:Annullamento) or exists($richiesta/ns2:Rimodulazione_DAC) or exists($richiesta/ns2:Rimodulazione_DAC_Recipient)&quot;>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$richiesta/node()/ns2:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$richiesta/node()/ns2:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns2:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;$richiesta/node()/ns2:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$richiesta/node()/ns2:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($richiesta/node()/ns2:CodiceOrdine)>0&quot;>&lt;xsl:if test=&quot;$richiesta/node()/ns2:CodiceOrdine&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$richiesta/node()/ns2:CodiceOrdine&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($richiesta/node()/ns2:CodiceProgetto)>0&quot;>&lt;xsl:if test=&quot;$richiesta/node()/ns2:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$richiesta/node()/ns2:CodiceProgetto&quot;