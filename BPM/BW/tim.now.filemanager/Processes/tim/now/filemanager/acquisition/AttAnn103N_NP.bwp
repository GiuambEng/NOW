            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="ee17bffa-1639-4b9b-af6c-a6b9d04f7ea4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/N_NP_end&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;subContatoreNOW&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreKO&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreDBCFX&quot;/>&#xa;    &lt;xsl:param name=&quot;subStringaCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;subStringaDBCFX&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreSDR&quot;/>&#xa;    &lt;xsl:param name=&quot;subStringaSDR&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Element>&#xa;            &lt;tns2:stringaCRMWS>&#xa;                &lt;xsl:value-of select=&quot;$subStringaCRMWS&quot;/>&#xa;            &lt;/tns2:stringaCRMWS>&#xa;            &lt;tns2:contatoreNOW>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreNOW&quot;/>&#xa;            &lt;/tns2:contatoreNOW>&#xa;            &lt;tns2:contatoreCRMWS>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreCRMWS&quot;/>&#xa;            &lt;/tns2:contatoreCRMWS>&#xa;            &lt;tns2:contatoreKO>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreKO&quot;/>&#xa;            &lt;/tns2:contatoreKO>&#xa;            &lt;tns2:stringaDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$subStringaDBCFX&quot;/>&#xa;            &lt;/tns2:stringaDBCFX>&#xa;            &lt;tns2:contatoreDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreDBCFX&quot;/>&#xa;            &lt;/tns2:contatoreDBCFX>&#xa;            &lt;tns2:stringaSDR>&#xa;                &lt;xsl:value-of select=&quot;$subStringaSDR&quot;/>&#xa;            &lt;/tns2:stringaSDR>&#xa;            &lt;tns2:contatoreSDR>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreSDR&quot;/>&#xa;            &lt;/tns2:contatoreSDR>&#xa;        &lt;/tns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="StartLog-input"
                    name="StartLog"
                    tibex:xpdlId="d8cb3ac0-1692-4506-b449-60cfd6cd943e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Appilcation: tim.now.filemanager.application | Process: 103N_NP | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Input AttAnn103N_NP: ',tib:render-xml($Start, true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
