                    <bpws:variable element="ns4:RichiestaElement" name="AnnullamentoCasedata"/>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns23:ComunicazioneNP/ns23:Richiesta[not(exists(ns23:Annullamento))])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns23:ComunicazioneNP/ns23:Richiesta[not(exists(ns23:Annullamento))])]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToEmpty3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RenderXmlToCallProcess" tibex:linkType="SUCCESS"/>
