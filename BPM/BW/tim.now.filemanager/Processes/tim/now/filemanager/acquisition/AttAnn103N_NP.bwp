                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AttivazioneCasedataToAssign2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;OLO_NORM&quot;/>&lt;xsl:param name=&quot;TransitoryProperty&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;TimestampNP&quot;/>&lt;xsl:template name=&quot;AttivazioneCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;xsl:variable name=&quot;rich&quot; select=&quot;$Start/ns2:ComunicazioneNP/ns2:Richiesta[not(exists(ns2:Annullamento))][$index]&quot;/>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Start/ns2:IDfile&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns2:Annullamento) and $rich/ns2:Annullamento/ns2:TipoComunicazione='11'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Annullamento) and $rich/ns2:Annullamento/ns2:TipoComunicazione='18'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTORECIPIENT&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Rimodulazione_DAC)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAC&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Rimodulazione_DAC_Recipient) and $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='16'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RDACRECIPIENTDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Rimodulazione_DAC_Recipient) and $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='17'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RDACDONORDONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Cessazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Portin)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PORTIN&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/ns2:Progressivi/ns2:Progressivo[number($index)]&quot;>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;$Start/ns2:Progressivi/ns2:Progressivo[number($index)]&quot;/>&lt;/progressivoRichiestaFile>&lt;/xsl:if>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns2:Annullamento) or exists($rich/ns2:Rimodulazione_DAC) or exists($rich/ns2:Rimodulazione_DAC_Recipient)&quot;>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/node()/ns2:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$rich/node()/ns2:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/ns2:Portin/ns2:CodiceOpRecipient)>0 and string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$rich/ns2:Portin/ns2:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$rich/ns2:Portin/ns2:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns2:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;$rich/node()/ns2:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$rich/node()/ns2:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($rich/node()/ns2:CodiceProgetto)>0&quot;>&lt;xsl:if test=&quot;$rich/node()/ns2:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$rich/node()/ns2:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/node()/ns2:DataOrdine)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($rich/node()/ns2:DataOrdine,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns2:ComunicazioneNP/ns2:Richiesta[$index]/ns2:Annullamento) or exists($Start/ns2:ComunicazioneNP/ns2:Richiesta[$index]/ns2:Rimodulazione_DAC_Recipient)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($rich/node()/ns2:DataInvioMessaggio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/node()/ns2:Correlazioni/ns2:IdentificativoCorrelazioni)>0 and ($rich/ns2:Portin/ns2:TipoComunicazione='3' or $rich/ns2:Portin/ns2:TipoComunicazione='8' or $rich/ns2:Portin/ns2:TipoComunicazione='1' or $rich/ns2:Prenotifica_Donating/ns2:TipoComunicazione='1' or $rich/ns2:Prenotifica_Donating/ns2:TipoComunicazione='3' or $rich/ns2:Prenotifica_Donating/ns2:TipoComunicazione='8' or $rich/ns2:Cessazione/ns2:TipoComunicazione='1' or $rich/ns2:Cessazione/ns2:TipoComunicazione='3' or $rich/ns2:Cessazione/ns2:TipoComunicazione='8' or $rich/ns2:Annullamento/ns2:TipoComunicazione='1' or $rich/ns2:Annullamento/ns2:TipoComunicazione='3' or $rich/ns2:Annullamento/ns2:TipoComunicazione='8' or $rich/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='1' or $rich/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='3' or $rich/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='8' or $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='1' or $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='3' or $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='8')&quot;>&lt;xsl:if test=&quot;$rich/node()/ns2:Correlazioni/ns2:IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;$rich/node()/ns2:Correlazioni/ns2:IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/node()/ns2:Correlazioni/ns2:TotaleRichieste) and ($rich/ns2:Portin/ns2:TipoComunicazione='3' or $rich/ns2:Portin/ns2:TipoComunicazione='8' or $rich/ns2:Portin/ns2:TipoComunicazione='1' or $rich/ns2:Prenotifica_Donating/ns2:TipoComunicazione='1' or $rich/ns2:Prenotifica_Donating/ns2:TipoComunicazione='3' or $rich/ns2:Prenotifica_Donating/ns2:TipoComunicazione='8' or $rich/ns2:Cessazione/ns2:TipoComunicazione='1' or $rich/ns2:Cessazione/ns2:TipoComunicazione='3' or $rich/ns2:Cessazione/ns2:TipoComunicazione='8' or $rich/ns2:Annullamento/ns2:TipoComunicazione='1' or $rich/ns2:Annullamento/ns2:TipoComunicazione='3' or $rich/ns2:Annullamento/ns2:TipoComunicazione='8' or $rich/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='1' or $rich/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='3' or $rich/ns2:Rimodulazione_DAC/ns2:TipoComunicazione='8' or $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='1' or $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='3' or $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='8')&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;xsd:int($rich/node()/ns2:Correlazioni/ns2:TotaleRichieste)&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&lt;/contenutoXML>&lt;xsl:if test=&quot;not(exists($rich/ns2:Annullamento)) and not(exists($rich/ns2:Rimodulazione_DAC)) and not(exists($rich/ns2:Rimodulazione_DAC_Recipient))&quot;>&lt;ordine>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;xsl:if test=&quot;exists($rich/node()/ns2:DataAttesaConsegnaServizio)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($rich/node()/ns2:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;$rich/node()/ns2:CognomeCliente_RagioneSociale&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;$rich/node()/ns2:CognomeCliente_RagioneSociale&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;$rich/node()/ns2:NomeCliente&quot;>&lt;nome>&lt;xsl:value-of select=&quot;$rich/node()/ns2:NomeCliente&quot;/>&lt;/nome>&lt;/xsl:if>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;$Start/ns2:CodIspIntrfc&quot;/>&lt;/codificaOLONOW>&lt;xsl:if test=&quot;$rich/node()/ns2:CodiceOrdine&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;$rich/node()/ns2:CodiceOrdine&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($rich/node()/ns2:CodiceProgetto)>0&quot;>&lt;xsl:if test=&quot;$rich/node()/ns2:CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$rich/node()/ns2:CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/ns2:Portin/ns2:CodiceOpRecipient)>0 and string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$rich/ns2:Portin/ns2:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$rich/ns2:Portin/ns2:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns2:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/ns2:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/node()/ns2:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$rich/node()/ns2:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns2:Cessazione)&quot;>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;xsl:if test=&quot;$rich/node()/ns2:DirectoryNumber&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;$rich/node()/ns2:DirectoryNumber&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;nomeComponente>&lt;xsl:value-of select=&quot;&amp;quot;NUMBERPORTABILITY&amp;quot;&quot;/>&lt;/nomeComponente>&lt;integrationID>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/integrationID>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;NUMEROTELEFONICO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$rich/node()/ns2:DirectoryNumber&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;xsl:if test=&quot;string-length($rich/node()/ns2:TipoLinea)>0&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;nomeAttributo>&lt;xsl:value-of select=&quot;&amp;quot;TIPOLINEAOLO&amp;quot;&quot;/>&lt;/nomeAttributo>&lt;valoreAttributo>&lt;xsl:value-of select=&quot;$rich/node()/ns2:TipoLinea&quot;/>&lt;/valoreAttributo>&lt;tipologiaDato>&lt;xsl:value-of select=&quot;&amp;quot;VARCHAR2&amp;quot;&quot;/>&lt;/tipologiaDato>&lt;/attributiDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($rich/ns2:Prenotifica_Donating/ns2:TipoLinea)>0&quot;>&lt;attributiDettaglioOrdine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettagl