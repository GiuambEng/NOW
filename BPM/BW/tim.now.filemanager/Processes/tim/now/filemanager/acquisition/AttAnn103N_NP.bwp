Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/node()/ns2:DataAttesaConsegnaServizio)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($rich/node()/ns2:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/ns2:Portin/ns2:CodiceOpRecipient)>0&quot;>&lt;xsl:if test=&quot;$rich/ns2:Portin/ns2:CodiceOpRecipient&quot;>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$rich/ns2:Portin/ns2:CodiceOpRecipient&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/ns2:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/ns2:Annullamento) and $rich/ns2:Annullamento/ns2:TipoComunicazione='18'&quot;>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;'ANNULLAMENTORECIPIENT'&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Rimodulazione_DAC_Recipient) and $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='16'&quot;>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;'RDACRECIPIENTDONOR'&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/ns2:Rimodulazione_DAC_Recipient) and $rich/ns2:Rimodulazione_DAC_Recipient/ns2:TipoComunicazione='17'&quot;>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;'RDACDONORDONATING'&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;upper-case(translate(local-name($rich/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&lt;transactionIDLocator>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&lt;/transactionIDLocator>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($rich/ns2:Portin/ns2:RoutingNumber)>0&quot;>&lt;xsl:if test=&quot;$rich/ns2:Portin/ns2:RoutingNumber&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;$rich/ns2:Portin/ns2:RoutingNumber&quot;/>&lt;/routingNumber>&lt;/xsl:if>&lt;/xsl:if>&lt;flagDelibera103>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/flagDelibera103>&lt;xsl:if test=&quot;string-length(string($TimestampNP/Record[1]/TIMSTP_NP))>0&quot;>&lt;xsl:if test=&quot;$TimestampNP/Record[1]/TIMSTP_NP&quot;>&lt;tmpAckNpD103>&lt;xsl:value-of select=&quot;$TimestampNP/Record[1]/TIMSTP_NP&quot;/>&lt;/tmpAckNpD103>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($rich/ns2:Cessazione)&quot;>&lt;codiceOperatoreReturning>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/ns2:NomeFile, '103N_NP_'), '_')&quot;/>&lt;/codiceOperatoreReturning>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
