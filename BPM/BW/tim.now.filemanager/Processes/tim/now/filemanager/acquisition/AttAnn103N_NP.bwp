                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderAnnullamento&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterNameATT_ANN&quot;/>&#xa;    &lt;xsl:param name=&quot;AttivazioneCasedata&quot;/>&#xa;    &lt;xsl:param name=&quot;AnnullamentoCasedata&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSnow&quot;/>&#xa;    &lt;xsl:param name=&quot;RemNSnow2&quot;/>&#xa;    &lt;xsl:template name=&quot;createProcessInstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Element>&#xa;            &lt;tns2:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns2:moduleName>&#xa;            &lt;tns2:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns2:parameterName>&#xa;            &lt;tns2:parameterName2>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterNameATT_ANN&quot;/>&#xa;            &lt;/tns2:parameterName2>&#xa;            &lt;tns2:operationName>&#xa;                &lt;xsl:value-of select=&quot;$BPMoperationName&quot;/>&#xa;            &lt;/tns2:operationName>&#xa;            &lt;tns2:processName>&#xa;                &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;            &lt;/tns2:processName>&#xa;            &lt;tns2:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderRichiesta&quot;/>&#xa;            &lt;/tns2:value>&#xa;            &lt;tns2:value2>&#xa;                &lt;xsl:value-of select=&quot;$RenderAnnullamento&quot;/>&#xa;            &lt;/tns2:value2>&#xa;            &lt;tns2:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns2:IDfile&quot;/>&#xa;            &lt;/tns2:ID_FILE>&#xa;            &lt;tns2:ContenutoXML>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&#xa;            &lt;/tns2:ContenutoXML>&#xa;            &lt;tns2:ContenutoXML_ANN>&#xa;                &lt;xsl:value-of select=&quot;$RemNSnow2&quot;/>&#xa;            &lt;/tns2:ContenutoXML_ANN>&#xa;            &lt;tns2:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$AttivazioneCasedata/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns2:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$AttivazioneCasedata/progressivoRichiestaFile&quot;>&#xa;                &lt;tns2:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneCasedata/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns2:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AttivazioneCasedata/ambito&quot;>&#xa;                &lt;tns2:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneCasedata/ambito&quot;/>&#xa;                &lt;/tns2:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AnnullamentoCasedata/progressivoRichiestaFile&quot;>&#xa;                &lt;tns2:ProgressivoRichiestaFileAnn>&#xa;                    &lt;xsl:value-of select=&quot;$AnnullamentoCasedata/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns2:ProgressivoRichiestaFileAnn>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$AttivazioneCasedata/strutturaRichiesta&quot;/>&#xa;            &lt;/tns2:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$AttivazioneCasedata/codiceOrdineOLO&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$AttivazioneCasedata/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:flagDEL103>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/tns2:flagDEL103>&#xa;        &lt;/tns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
