art/ns2:NomeFile, '103N_NP_'), '_')&quot;/>&lt;/tns1:CodiceOLOAGCOM>&lt;/tns1:codes>&lt;/xsl:if>&lt;/tns1:CodiciOlo>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
