                                    sqlStatement="SELECT COD_INTRFC, DATAESECUZIONE, ESTRAZIONE, CODICE_OLO, DATA_INIZIO, DATA_FINE, DATA_ESPLETAMENTO&#xa;  FROM CFG_START_ESTRAZIONI&#xa;  WHERE TRUNC(DATAESECUZIONE)=TRUNC(SYSDATE)&#xa;    AND FLAG_LETTURA = 'N' AND SISTEMA = ? AND COD_INTRFC = ?&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
