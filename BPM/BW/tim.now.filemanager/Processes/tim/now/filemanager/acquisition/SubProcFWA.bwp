                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ProgressiviRichiesta&quot; xmlns:ns0=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;ALTArray&quot;/>&#xa;    &lt;xsl:param name=&quot;ProgressALT&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;xsl:variable name=&quot;rich&quot; select=&quot;$ALTArray/ns0:Richiesta[number($index)]&quot;/>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;IDFileInput>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ID_FILE)&quot;/>&#xa;            &lt;/IDFileInput>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ProgressALT/tns3:Progressivo[number($index)]&quot;>&#xa;                &lt;progressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$ProgressALT/tns3:Progressivo[number($index)]&quot;/>&#xa;                &lt;/progressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FWA&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:FixedWirelessAccess/ns0:IDENTIFICATIVO_RISORSA&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:FixedWirelessAccess/ns0:IDENTIFICATIVO_RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns:CodiciOlo/tns:codes[tns:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOloAgcom]/tns:CodiceOLOAGCOM)>0&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiciOlo/tns:codes[tns:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOloAgcom]/tns:CodiceOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:CodOLOdaNome&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceOloAgcom&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOloAgcom&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string($Start/ns1:DATA_FILE), 1, 10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;contenutoXML>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&#xa;            &lt;/contenutoXML>&#xa;            &lt;xsl:if test=&quot;exists($rich/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&#xa;                &lt;ordine>&#xa;                    &lt;offertaCatalogo>&#xa;                        &lt;xsl:value-of select=&quot;'FIXEDWIRELESSACCESS'&quot;/>&#xa;                    &lt;/offertaCatalogo>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOloAgcom&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                    &lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns:CodiciOlo/tns:codes[tns:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOloAgcom]/tns:CodiceOLOAGCOM)>0&quot;>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:CodiciOlo/tns:codes[tns:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOloAgcom]/tns:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/codificaOLOAGCOM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:CodOLOdaNome&quot;/>&#xa;                            &lt;/codificaOLOAGCOM>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:FixedWirelessAccess/ns0:IDENTIFICATIVO_RISORSA&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:FixedWirelessAccess/ns0:IDENTIFICATIVO_RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;tipologiaLavorazione>&#xa;                        &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                    &lt;/tipologiaLavorazione>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;tipologiaAccesso>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaAccesso>&#xa;                    &lt;offerta>&#xa;                        &lt;xsl:value-of select=&quot;'FIXEDWIRELESSACCESS'&quot;/>&#xa;                    &lt;/offerta>&#xa;                    &lt;xsl:if test=&quot;$rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:FixedWirelessAccess/ns0:IDENTIFICATIVO_RISORSA&quot;>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns0:TipoRichiesta/ns0:Cessazione/ns0:FixedWirelessAccess/ns0:IDENTIFICATIVO_RISORSA&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ordine>&#xa;            &lt;/xsl:if>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;'FIXEDWIRELESSACCESS'&quot;/>&#xa;            &lt;/offerta>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;3971&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;DRO>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns1:NextWorkingDate&quot;/>&#xa;            &lt;/DRO>&#xa;            &lt;xsl:if test=&quot;$Start/ns1:CodAGCOMint&quot;>&#xa;                &lt;codificaOLOAGCOMRic>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:CodAGCOMint&quot;/>&#xa;                &lt;/codificaOLOAGCOMRic>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$TransitoryProperty=&amp;quot;Y&amp;quot;&quot;>&#xa;                &lt;transactionIDLocator>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/transactionIDLocator>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Richiesta" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallLocatorALT-input"
                                    name="CallLocatorALT"
                                    outputVariable="CallLocatorALT"
                                    tibex:xpdlId="f03d91d5-66e4-46b8-8555-1eb2f8549e5f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd11"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd11">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT/ns15:Risposta/ns15:SistemaDiCompetenza=&quot;CRMWS&quot; or ($CallLocatorATT/ns15:Risposta/ns15:SistemaDiCompetenza=&quot;KO&quot; and ($CallLocatorATT/ns15:Risposta/ns15:RC=&quot;09&quot; or $CallLocatorATT/ns15:Risposta/ns15:RC=&quot;10&quot; or $CallLocatorATT/ns15:Risposta/ns15:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
