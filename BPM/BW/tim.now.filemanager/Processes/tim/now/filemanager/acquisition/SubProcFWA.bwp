                                    <bpws:target linkName="Empty4ToGroupEnd1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd11">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$TransitoryProperty=&quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$TransitoryProperty="Y"]]></bpws:transitionCondition>
