                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaLocalizzatore>&#xa;            &lt;tns2:Testata>&#xa;                &lt;tns2:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&#xa;                &lt;/tns2:Transaction_id>&#xa;                &lt;tns2:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:Transaction_date>&#xa;                &lt;tns2:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns2:Sistema_origine>&#xa;            &lt;/tns2:Testata>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;tns2:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:DataRichiesta>&#xa;                &lt;tns2:CodiceOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns2:CodiceOLO>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns2:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns2:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                    &lt;tns2:CodiceComune>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                    &lt;/tns2:CodiceComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                    &lt;tns2:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                    &lt;/tns2:Richiesta>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Ambito_XDSL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/tns2:Ambito_XDSL>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                    &lt;tns2:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;tns2:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                    &lt;tns2:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                    &lt;/tns2:IdRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns2:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns2:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating2&quot;>&#xa;                    &lt;tns2:IdRisorsa2>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                    &lt;/tns2:IdRisorsa2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/numeroTelefonico&quot;>&#xa;                    &lt;tns2:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/numeroTelefonico&quot;/>&#xa;                    &lt;/tns2:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Richiesta/DNAggiuntivo&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns2:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns2:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns2:DNAggiuntivi>&#xa;            &lt;/tns2:Richiesta>&#xa;        &lt;/tns2:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
