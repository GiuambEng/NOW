                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallLocatorATT-input"
                                    name="CallLocatorATT"
                                    outputVariable="CallLocatorATT"
                                    tibex:xpdlId="b05428f6-a526-4a5a-a0eb-09eceebe9b24"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT/ns15:Risposta/ns15:SistemaDiCompetenza=&quot;CRMWS&quot; or ($CallLocatorATT/ns15:Risposta/ns15:SistemaDiCompetenza=&quot;KO&quot; and ($CallLocatorATT/ns15:Risposta/ns15:RC=&quot;09&quot; or $CallLocatorATT/ns15:Risposta/ns15:RC=&quot;10&quot; or $CallLocatorATT/ns15:Risposta/ns15:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorATT/ns15:Risposta/ns15:SistemaDiCompetenza="CRMWS" or ($CallLocatorATT/ns15:Risposta/ns15:SistemaDiCompetenza="KO" and ($CallLocatorATT/ns15:Risposta/ns15:RC="09" or $CallLocatorATT/ns15:Risposta/ns15:RC="10" or $CallLocatorATT/ns15:Risposta/ns15:RC="14"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorToContatoreNOW">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLocator-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaLocalizzatore>&#xa;            &lt;tns2:Testata>&#xa;                &lt;tns2:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns2:Transaction_id>&#xa;                &lt;tns2:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:Transaction_date>&#xa;                &lt;tns2:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns2:Sistema_origine>&#xa;            &lt;/tns2:Testata>&#xa;            &lt;tns2:Richiesta>&#xa;                &lt;tns2:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns2:DataRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/codificaOLOAGCOM)>0&quot;>&#xa;                        &lt;tns2:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns2:CodiceOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns2:CodiceOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns2:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns2:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/ISTATComune)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                            &lt;tns2:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                            &lt;/tns2:CodiceComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;upper-case($Richiesta/offerta)&quot;>&#xa;                    &lt;tns2:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;'FIXEDWIRELESSACCESS'&quot;/>&#xa;                    &lt;/tns2:Servizio>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/flagNaked&quot;>&#xa;                    &lt;tns2:FlagNaked>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/flagNaked&quot;/>&#xa;                    &lt;/tns2:FlagNaked>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Richiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tns2:Richiesta>&#xa;                &lt;tns2:Ambito_XDSL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/tns2:Ambito_XDSL>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                    &lt;tns2:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                    &lt;/tns2:IdRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns2:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns2:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/numeroTelefonico&quot;>&#xa;                    &lt;tns2:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/numeroTelefonico&quot;/>&#xa;                    &lt;/tns2:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Richiesta/DNAggiuntivo&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns2:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns2:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns2:DNAggiuntivi>&#xa;            &lt;/tns2:Richiesta>&#xa;        &lt;/tns2:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.CallLocator" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Richiesta"
