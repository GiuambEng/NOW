                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;CallLocatorALT&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns1:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns2:Risposta/tns2:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns1:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaCRMWS,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns1:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaCRMWS&quot;/>&lt;/tns1:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns2:Risposta/tns2:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorALT/tns2:Risposta/tns2:RC=&amp;quot;09&amp;quot; or $CallLocatorALT/tns2:Risposta/tns2:RC=&amp;quot;10&amp;quot; or $CallLocatorALT/tns2:Risposta/tns2:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns1:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaSDR,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns1:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaSDR&quot;/>&lt;/tns1:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaDBCFX&quot;/>&lt;/tns1:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns2:Risposta/tns2:SistemaDiCompetenza=&amp;quot;CRMWS&amp;