            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="ba6736cd-6de2-4f70-bf03-20492adaae6c">
                <bpws:targets>
                    <bpws:target linkName="SortToWhile"/>
                    <bpws:target linkName="Empty1ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToWhile1"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="ID_Offerta" type="xsd:integer">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=$ContaRichieste/ns12:ATT" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=$ContaRichieste/ns12:ATT]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToEmpty2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty2ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToEmpty3" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty3ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToGroupEnd1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="AssignToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ArricchimentoRichiestaATTToAssign1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="CallLocatorToContatoreNOW" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="RenderXmlToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ContatoreNOWToRenderXml" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log6ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Log7ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="76e516d6-f604-4a4c-ba2b-a4c5eeb564b9">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEmpty3">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($Start/tns:RichiesteLavorate[tns:ProgressivoRichiestaFile=$ATTArray/ns4:Richiesta[number($index)]/progressivoRichiestaFile])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($Start/tns:RichiesteLavorate[tns:ProgressivoRichiestaFile=$ATTArray/ns4:Richiesta[number($index)]/progressivoRichiestaFile])]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="93aa6c1d-6f88-4b85-a631-7c4733f9a37f">
                                <bpws:targets>
                                    <bpws:target linkName="Empty3ToGroupEnd"/>
                                    <bpws:target linkName="Log7ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:empty name="Empty2" tibex:xpdlId="2a100cc5-f9e6-4ef3-9bcf-44eda4a89766">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToEmpty2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty2ToGroupEnd"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="Empty3" tibex:xpdlId="c8ce7b9b-39e9-43e6-af2f-9f27672210e3">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToEmpty3"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty3ToGroupEnd"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Rendezvous-input"
                                    name="Rendezvous"
                                    outputVariable="Rendezvous"
                                    tibex:xpdlId="5bf85f6f-4049-4ce2-9dbb-b7cea487330f"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty2ToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTArray&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;Rendezvous-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ATTArray/tns4:Richiesta[number($index)]/codificaOLOAGCOM) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATTArray/tns4:Richiesta[number($index)]/codificaOLOAGCOM&quot;>&#xa;                        &lt;tns:CODFC_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$ATTArray/tns4:Richiesta[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns:CODFC_OLO_AGCOM>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns:CodOLOdaNome&quot;/>&#xa;                    &lt;/tns:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ListaIdOfferta/tns3:Offerta[upper-case(tns3:Nome_Offerta)=upper-case($ATTArray/tns4:Richiesta[number($index)]/offerta)]/tns3:ID_Offerta&quot;>&#xa;                &lt;tns:ID_OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$ListaIdOfferta/tns3:Offerta[upper-case(tns3:Nome_Offerta)=upper-case($ATTArray/tns4:Richiesta[number($index)]/offerta)]/tns3:ID_Offerta&quot;/>&#xa;                &lt;/tns:ID_OFFERTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATTArray/tns4:Richiesta[number($index)]/created&quot;>&#xa;                &lt;tns:CREATED>&#xa;                    &lt;xsl:value-of select=&quot;$ATTArray/tns4:Richiesta[number($index)]/created&quot;/>&#xa;                &lt;/tns:CREATED>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns:TransactionID>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Rendezvous" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Richiesta"
                                    name="ArricchimentoRichiestaATT"
                                    outputVariable="Richiesta"
                                    tibex:xpdlId="3911f444-96fd-4d4b-b312-2b0fee1e9da3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$TransitoryProperty='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$TransitoryProperty='Y']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ArricchimentoRichiestaATTToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDescrComune&quot;/>&#xa;    &lt;xsl:param name=&quot;Rendezvous&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTArray&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ATTArray/tns:Richiesta[number($index)]&quot;>&#xa;            &lt;ns:RichiestaElement>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                    &lt;statoRichiestaPrecedOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                    &lt;/statoRichiestaPrecedOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                    &lt;sottostatoLavorManuale>&#xa;                        &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                    &lt;/sottostatoLavorManuale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                    &lt;IDFileInput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                    &lt;/IDFileInput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                    &lt;IDFileOutput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                    &lt;/IDFileOutput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;ambito&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:if>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;xsl:if test=&quot;lavorazione&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;lavorazione&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&#xa;                    &lt;progressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&#xa;                    &lt;/progressivoRichiestaFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(codificaOLOAGCOM)>0&quot;>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:CodOLOdaNome&quot;/>&#xa;                        &lt;/codificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;codificaOLONOW&quot;>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;codificaOLONOW&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLO&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLOTarget&quot;>&#xa;                    &lt;codiceOrdineOLOTarget>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/codiceOrdineOLOTarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLOPadre&quot;>&#xa;                    &lt;codiceOrdineOLOPadre>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLOPadre&quot;/>&#xa;                    &lt;/codiceOrdineOLOPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineTITarget&quot;>&#xa;                    &lt;codiceOrdineTITarget>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineTITarget&quot;/>&#xa;                    &lt;/codiceOrdineTITarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;codiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;dataInvioRichiesta&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;xsl:if test=&quot;IDAnagraficaCausale&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:value-of select=&quot;IDAnagraficaCausale&quot;/>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDCorrelazione&quot;>&#xa;                    &lt;IDCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;IDCorrelazione&quot;/>&#xa;                    &lt;/IDCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;totaleRichiestePacchetto&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;totaleRichiestePacchetto&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipoPacchetto&quot;>&#xa;                    &lt;tipoPacchetto>&#xa;                        &lt;xsl:value-of select=&quot;tipoPacchetto&quot;/>&#xa;                    &lt;/tipoPacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDPacchettoNOW&quot;>&#xa;                    &lt;IDPacchettoNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDPacchettoNOW&quot;/>&#xa;                    &lt;/IDPacchettoNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;contenutoXML&quot;>&#xa;                    &lt;contenutoXML>&#xa;                        &lt;xsl:value-of select=&quot;contenutoXML&quot;/>&#xa;                    &lt;/contenutoXML>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;note&quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;note&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists(ordine)&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;xsl:if test=&quot;ordine/offertaCatalogo&quot;>&#xa;                            &lt;offertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/offertaCatalogo&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DAC&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DAC&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DAD&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DAD&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DPP&quot;>&#xa;                            &lt;DPP>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DPP&quot;/>&#xa;                            &lt;/DPP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DUVO&quot;>&#xa;                            &lt;DUVO>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DUVO&quot;/>&#xa;                            &lt;/DUVO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;ordine/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;ordine/dataChiusuraOrdine&quot;>&#xa;                            &lt;dataChiusuraOrdine>&#xa;                                &lt;xsl:value-of select=&quot;ordine/dataChiusuraOrdine&quot;/>&#xa;                            &lt;/dataChiusuraOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;ordine/cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;ordine/nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/CF&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;ordine/CF&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/PIVA&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;ordine/PIVA&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/IDSLUCo&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/IDSLUCo&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/IDULLCo&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/IDULLCo&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;ordine/codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DNOLOCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DNOLOCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/numeroVerdeOloCollaudo&quot;>&#xa;                            &lt;numeroVerdeOloCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/numeroVerdeOloCollaudo&quot;/>&#xa;                            &lt;/numeroVerdeOloCollaudo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/numeroVerdeOloPT&quot;>&#xa;                            &lt;numeroVerdeOloPT>&#xa;                                &lt;xsl:value-of select=&quot;ordine/numeroVerdeOloPT&quot;/>&#xa;                            &lt;/numeroVerdeOloPT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/codiceTTM&quot;>&#xa;                            &lt;codiceTTM>&#xa;                                &lt;xsl:value-of select=&quot;ordine/codiceTTM&quot;/>&#xa;                            &lt;/codiceTTM>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/flagLavorazioneManuale&quot;>&#xa;                            &lt;flagLavorazioneManuale>&#xa;                                &lt;xsl:value-of select=&quot;ordine/flagLavorazioneManuale&quot;/>&#xa;                            &lt;/flagLavorazioneManuale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/flagMonitoraggio&quot;>&#xa;                            &lt;flagMonitoraggio>&#xa;                                &lt;xsl:value-of select=&quot;ordine/flagMonitoraggio&quot;/>&#xa;                            &lt;/flagMonitoraggio>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/noteCliente&quot;>&#xa;                            &lt;noteCliente>&#xa;                                &lt;xsl:value-of select=&quot;ordine/noteCliente&quot;/>&#xa;                            &lt;/noteCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/notedaSistema&quot;>&#xa;                            &lt;notedaSistema>&#xa;                                &lt;xsl:value-of select=&quot;ordine/notedaSistema&quot;/>&#xa;                            &lt;/notedaSistema>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/totaleOrdRilevPacchetto&quot;>&#xa;                            &lt;totaleOrdRilevPacchetto>&#xa;                                &lt;xsl:value-of select=&quot;ordine/totaleOrdRilevPacchetto&quot;/>&#xa;                            &lt;/totaleOrdRilevPacchetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/CLLI&quot;>&#xa;                            &lt;CLLI>&#xa;                                &lt;xsl:value-of select=&quot;ordine/CLLI&quot;/>&#xa;                            &lt;/CLLI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;ordine/codificaOLONOW&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                        &lt;xsl:if test=&quot;ordine/codiceOrdineOLO&quot;>&#xa;                            &lt;codiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;ordine/codiceOrdineOLO&quot;/>&#xa;                            &lt;/codiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/codiceOrdineOLOPadre&quot;>&#xa;                            &lt;codiceOrdineOLOPadre>&#xa;                                &lt;xsl:value-of select=&quot;ordine/codiceOrdineOLOPadre&quot;/>&#xa;                            &lt;/codiceOrdineOLOPadre>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/codiceOrdineTI&quot;>&#xa;                            &lt;codiceOrdineTI>&#xa;                                &lt;xsl:value-of select=&quot;ordine/codiceOrdineTI&quot;/>&#xa;                            &lt;/codiceOrdineTI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/codiceProgetto&quot;>&#xa;                            &lt;codiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;ordine/codiceProgetto&quot;/>&#xa;                            &lt;/codiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(ordine/codificaOLOAGCOM)>0&quot;>&#xa;                                &lt;codificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;ordine/codificaOLOAGCOM&quot;/>&#xa;                                &lt;/codificaOLOAGCOM>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;codificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:CodOLOdaNome&quot;/>&#xa;                                &lt;/codificaOLOAGCOM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;ordine/DADRimodulata&quot;>&#xa;                            &lt;DADRimodulata>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DADRimodulata&quot;/>&#xa;                            &lt;/DADRimodulata>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DEC&quot;>&#xa;                            &lt;DEC>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DEC&quot;/>&#xa;                            &lt;/DEC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DES&quot;>&#xa;                            &lt;DES>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DES&quot;/>&#xa;                            &lt;/DES>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/ORA_DES&quot;>&#xa;                            &lt;ORA_DES>&#xa;                                &lt;xsl:value-of select=&quot;ordine/ORA_DES&quot;/>&#xa;                            &lt;/ORA_DES>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/IDRisorsa&quot;>&#xa;                            &lt;IDRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;ordine/IDRisorsa&quot;/>&#xa;                            &lt;/IDRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;ordine/IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;tipologiaLavorazione>&#xa;                            &lt;xsl:value-of select=&quot;ordine/tipologiaLavorazione&quot;/>&#xa;                        &lt;/tipologiaLavorazione>&#xa;                        &lt;xsl:if test=&quot;ordine/tipologiaSottolav&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;ordine/tipologiaSottolav&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/LNA_LA&quot;>&#xa;                            &lt;LNA_LA>&#xa;                                &lt;xsl:value-of select=&quot;ordine/LNA_LA&quot;/>&#xa;                            &lt;/LNA_LA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/modalitaFatturazione&quot;>&#xa;                    