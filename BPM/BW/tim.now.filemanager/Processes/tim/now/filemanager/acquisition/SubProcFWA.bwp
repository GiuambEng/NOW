                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/ListaContatori&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns1:Contatori>&lt;tns1:StringaCRMWS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:StringaCRMWS>&lt;tns1:StringaSDR>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:StringaSDR>&lt;tns1:StringaDBCFX>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:StringaDBCFX>&lt;tns1:ContatoreCRMWS>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreCRMWS>&lt;tns1:ContatoreWSDP>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreWSDP>&lt;tns1:ContatoreSDR>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreSDR>&lt;tns1:ContatoreDBCFX>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreDBCFX>&lt;tns1:ContatoreNOW>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreNOW>&lt;tns1:ContatoreKO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreKO>&lt;/tns1:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
