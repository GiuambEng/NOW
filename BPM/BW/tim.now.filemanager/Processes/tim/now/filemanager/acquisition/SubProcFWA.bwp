    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/RichiesteFWAxBPM"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://fwa.telecomitalia.it/crm/fwa/order"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/ProgressiviRichiesta"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/Arricchimenti"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/ContaRichieste"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.org/ListaContatori"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/Rendezvous/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://NOW.it.telecomitalia.it/casedata"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/SystemLocatorInterface/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.example.com/namespaces/tns/1465380730918"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:Element" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns1:ActivityInput" name="Log-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:Element" name="GetIp" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:RichiesteOLOSuddivise"
            name="MapperRichieste-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:RichiesteOLOSuddivise"
            name="MapperRichieste" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:RichiestaMapper" name="ATTArray"/>
        <bpws:variable element="ns5:TracciatoOLOFWA" name="ALTArray"/>
        <bpws:variable element="ns6:ArrayProgressivi" name="ProgressALT"/>
        <bpws:variable element="ns1:ActivityInput" name="Log1-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:ListaOfferte" name="ListaOfferte"/>
        <bpws:variable element="ns1:ActivityInput" name="Log2-input" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns9:ActivityInputType"
            name="ListaIDOfferta-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:jdbcGeneralActivityOutput"
            name="ListaIDOfferta" sca-bpel:internal="true"/>
        <bpws:variable name="tim.now.shared_library-TimeOut"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="//tim.now.shared_library///Connections/JDBC/TimeOut" type="xsd:int"/>
        <bpws:variable element="ns8:ListaIdOfferta" name="ListaIdOfferta"/>
        <bpws:variable element="ns1:ActivityInput" name="Log3-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:ListaCodiciComune" name="ListaComuni"/>
        <bpws:variable element="ns1:ActivityInput" name="Log4-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns11:ActivityInputType"
            name="DescrComune-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns10:jdbcGeneralActivityOutput"
            name="DescrComune" sca-bpel:internal="true"/>
        <bpws:variable element="ns8:ListaDescrComune" name="ListaDescrComune"/>
        <bpws:variable element="ns1:ActivityInput" name="Log5-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:ContaRichieste" name="ContaRichieste"/>
        <bpws:variable element="ns14:Input" name="Rendezvous-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns14:Output" name="Rendezvous" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:RichiestaElement" name="Richiesta"/>
        <bpws:variable element="ns15:RichiestaLocalizzatore"
            name="CallLocatorATT-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns15:RispostaLocalizzatore"
            name="CallLocatorATT" sca-bpel:internal="true"/>
        <bpws:variable name="TransitoryProperty"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/FlagTransitory" type="xsd:string"/>
        <bpws:variable element="ns13:Contatori" name="Contatori"/>
        <bpws:variable element="ns7:RichiestaElement"
            name="RenderXml-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns16:xmlString" name="RenderXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ActivityInput" name="Log6-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns17:Element"
            name="CreaRichiestaATT-input" sca-bpel:internal="true"/>
        <bpws:variable name="BPMmoduleName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/moduleName" type="xsd:string"/>
        <bpws:variable name="BPMparameterName"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/parameterName" type="xsd:string"/>
        <bpws:variable name="BPMprocessName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/processName" type="xsd:string"/>
        <bpws:variable name="BPMoperationName"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/operationName" type="xsd:string"/>
        <bpws:variable name="CRMWSprocessName"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/CRMWSprocessName" type="xsd:string"/>
        <bpws:variable name="CRMWSoperationName"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/CRMWSoperationName" type="xsd:string"/>
        <bpws:variable name="BPMparameterRAL" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/RalParameterName" type="xsd:string"/>
        <bpws:variable name="PriorityCRMWS" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CreateProcessInstance/PriorityCRMWS" type="xsd:int"/>
        <bpws:variable element="ns1:ActivityInput" name="Log7-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns13:Contatori" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns15:RichiestaLocalizzatore"
            name="CallLocatorALT-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns15:RispostaLocalizzatore"
            name="CallLocatorALT" sca-bpel:internal="true"/>
        <bpws:variable element="ns18:jdbcQueryActivityInput"
            name="JDBCQuery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns19:resultSet" name="JDBCQuery" sca-bpel:internal="true"/>
        <bpws:variable element="ns20:jdbcQueryActivityInput"
            name="JDBCQuery1-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns21:resultSet" name="JDBCQuery1" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:RichiestaElement"
            name="RenderXml1-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns16:xmlString" name="RenderXml1" sca-bpel:internal="true"/>
        <bpws:variable element="ns17:Element" name="RichiestaALT-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ActivityInput" name="Log8-input" sca-bpel:internal="true"/>
        <bpws:variable name="CodProgettoOrdWList"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CodPrgtOrderWList" type="xsd:string"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToATTAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ATTAssignToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperRichiesteToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="ALTAssignToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToALTAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Assign1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log2ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListaIDOffertaToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToLog3" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log3ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CodISTATComuneToLog4" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log4ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="DescrComuneToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log5ToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="ContaRichiesteToEmpty1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log5ToAssign1" tibex:linkType="SUCCESS"/>
                <bpws:link name="AzzeraContatoriToEmpty1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="SortToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToWhile1" tibex:linkType="SUCCESS"/>
                <bpws:link name="While1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToWhile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="dda11220-df6b-4e2c-9067-a0ebfe1e1af8"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="2602e08d-112f-4ba4-9515-48820bf722ca" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="While1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ListaContatori&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Contatori&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log-input"
                    name="Log"
                    tibex:xpdlId="ef34360d-f400-4f6e-aa10-5c005844c507" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcFWA | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat('SubProcFWA',tib:render-xml($Start,true(),true()))&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity name="GetIp" outputVariable="GetIp"
                    tibex:xpdlId="95aee400-ab91-4b2a-a884-98ddd6773e7e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.GetLocalIP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperRichieste-input"
                    name="MapperRichieste"
                    outputVariable="MapperRichieste"
                    tibex:xpdlId="a441bc89-32e0-4cb4-a9cf-0f8b26f16077" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperRichiesteToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RichiesteFWAxBPM&quot; xmlns:ns0=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProgettoOrdWList&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperRichieste-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RichiesteOLOSuddivise>&#xa;            &lt;xsl:for-each select=&quot;$Start/ns0:TracciatoOLOFWA/ns0:Richiesta&quot;>&#xa;                &lt;xsl:variable name=&quot;rich&quot; select=&quot;current()&quot;/>&#xa;                &lt;xsl:variable name=&quot;RTYPE&quot; select=&quot;if($rich/ns0:TipoRichiesta/ns0:Attivazione) then &amp;quot;ATT&amp;quot; else &amp;quot;ALT&amp;quot;&quot;/>&#xa;                &lt;tns:Richieste>&#xa;                    &lt;xsl:if test=&quot;$RTYPE=&amp;quot;ATT&amp;quot;&quot;>&#xa;                        &lt;tns:RichiesteATT>&#xa;                            &lt;ns:RichiestaElement>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;statoRichiestaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&#xa;                                &lt;/statoRichiestaNOW>&#xa;                                &lt;statoRichiestaPrecedNOW>&#xa;                                    &lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&#xa;                                &lt;/statoRichiestaPrecedNOW>&#xa;                                &lt;IDFileInput>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(../../ns1:ID_FILE)&quot;/>&#xa;                                &lt;/IDFileInput>&#xa;                                &lt;ambito>&#xa;                                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                                &lt;/ambito>&#xa;                                &lt;canaleRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;'FILE'&quot;/>&#xa;                                &lt;/canaleRichiesta>&#xa;                                &lt;lavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                                &lt;/lavorazione>&#xa;                                &lt;progressivoRichiestaFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                &lt;/progressivoRichiestaFile>&#xa;                                &lt;strutturaRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;'FWA'&quot;/>&#xa;                                &lt;/strutturaRichiesta>&#xa;                                &lt;tipoRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                                &lt;/tipoRichiesta>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(../../tns3:CodiciOlo/tns3:codes[$Start/tns3:CodiciOlo/tns3:codes/tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOloAgcom]/tns3:CodiceOLOAGCOM)&quot;>&#xa;                                        &lt;codificaOLOAGCOM>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns3:CodiciOlo/tns3:codes[$Start/tns3:CodiciOlo/tns3:codes/tns3:CodiceOLO=$rich/ns0:Testata/ns0:CodiceOloAgcom]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                                        &lt;/codificaOLOAGCOM>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;codificaOLOAGCOM>&#xa;                                            &lt;xsl:value-of select=&quot;../../ns1:CodOLOdaNome&quot;/>&#xa;                                        &lt;/codificaOLOAGCOM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;codificaOLONOW>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOloAgcom&quot;/>&#xa;                                &lt;/codificaOLONOW>&#xa;                                &lt;codiceOrdineOLO>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/codiceOrdineOLO>&#xa;                                &lt;xsl:if test=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                                    &lt;codiceProgetto>&#xa;                                        &lt;xsl:value-of select=&quot;$rich/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa; 