        &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                    &lt;/sede>&#xa;                                    &lt;xsl:for-each select=&quot;ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:Referente&quot;>&#xa;                                        &lt;referente>&#xa;                                            &lt;IDRichiestaOLO>&#xa;                                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                            &lt;/IDRichiestaOLO>&#xa;                                            &lt;created>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/created>&#xa;                                            &lt;lastUpdate>&#xa;                                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                            &lt;/lastUpdate>&#xa;                                            &lt;operatore>&#xa;                                                &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                            &lt;/operatore>&#xa;                                            &lt;progressivoReferente>&#xa;                                                &lt;xsl:value-of select=&quot;xsd:int(ns0:Progressivo)&quot;/>&#xa;                                            &lt;/progressivoReferente>&#xa;                                            &lt;tipoReferenteOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;'REFERENTE'&quot;/>&#xa;                                            &lt;/tipoReferenteOrdine>&#xa;                                            &lt;qualificaReferente>&#xa;                                                &lt;xsl:value-of select=&quot;ns0:Qualifica&quot;/>&#xa;                                            &lt;/qualificaReferente>&#xa;                                            &lt;cognomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;ns0:Cognome&quot;/>&#xa;                                            &lt;/cognomeReferente>&#xa;                                            &lt;nomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;ns0:Nome&quot;/>&#xa;                                            &lt;/nomeReferente>&#xa;                                            &lt;xsl:if test=&quot;ns0:Telefono&quot;>&#xa;                                                &lt;telefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;ns0:Telefono&quot;/>&#xa;                                                &lt;/telefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;ns0:Mobile&quot;>&#xa;                                                &lt;telefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;ns0:Mobile&quot;/>&#xa;                                                &lt;/telefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;flag_Token>&#xa;                                                &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                                            &lt;/flag_Token>&#xa;                                        &lt;/referente>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;tipologiaAccesso>&#xa;                                        &lt;xsl:value-of select=&quot;'DATI'&quot;/>&#xa;                                    &lt;/tipologiaAccesso>&#xa;                                    &lt;offerta>&#xa;                                        &lt;xsl:value-of select=&quot;'FIXEDWIRELESSACCESS'&quot;/>&#xa;                                    &lt;/offerta>&#xa;                                &lt;/ordine>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:DatiSede/ns0:CodiceComune)>5&quot;>&#xa;                                        &lt;ISTATComune>&#xa;                                            &lt;xsl:value-of select=&quot;substring(ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:DatiSede/ns0:CodiceComune,string-length(ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:DatiSede/ns0:CodiceComune)-5,6)&quot;/>&#xa;                                        &lt;/ISTATComune>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:DatiSede/ns0:CodiceComune&quot;>&#xa;                                            &lt;ISTATComune>&#xa;                                                &lt;xsl:value-of select=&quot;ns0:TipoRichiesta/ns0:Attivazione/ns0:FixedWirelessAccess/ns0:DatiSede/ns0:CodiceComune&quot;/>&#xa;                                            &lt;/ISTATComune>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;offerta>&#xa;                                    &lt;xsl:value-of select=&quot;'FIXEDWIRELESSACCESS'&quot;/>&#xa;                                &lt;/offerta>&#xa;                                &lt;flagNaked>&#xa;                                    &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                                &lt;/flagNaked>&#xa;                                &lt;IDRichiestaLocalizzatore>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/IDRichiestaLocalizzatore>&#xa;                                &lt;DRO>&#xa;                                    &lt;xsl:value-of select=&quot;../../ns1:NextWorkingDate&quot;/>&#xa;                                &lt;/DRO>&#xa;                                &lt;xsl:if test=&quot;../../ns1:CodAGCOMint&quot;>&#xa;                                    &lt;codificaOLOAGCOMRic>&#xa;                                        &lt;xsl:value-of select=&quot;../../ns1:CodAGCOMint&quot;/>&#xa;                                    &lt;/codificaOLOAGCOMRic>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ns0:Testata/ns0:CodiceOrdineOlo='ALB' and contains($CodProgettoOrdWList,ns0:Testata/ns0:CodiceProgetto)&quot;>&#xa;                                    &lt;ordineAssetWhiteList>&#xa;                                        &lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&#xa;                                    &lt;/ordineAssetWhiteList>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/ns:RichiestaElement>&#xa;                        &lt;/tns:RichiesteATT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RTYPE=&amp;quot;ALT&amp;quot;&quot;>&#xa;                        &lt;ns0:TracciatoOLOFWA>&#xa;                            &lt;xsl:copy-of select=&quot;$rich&quot;/>&#xa;                        &lt;/ns0:TracciatoOLOFWA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RTYPE=&amp;quot;ALT&amp;quot;&quot;>&#xa;                        &lt;tns:ProgressiviAlt>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                        &lt;/tns:ProgressiviAlt>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:Richieste>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:RichiesteOLOSuddivise>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
