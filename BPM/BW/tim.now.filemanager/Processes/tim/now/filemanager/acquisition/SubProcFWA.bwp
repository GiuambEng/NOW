/codicePacchettoNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$Richiesta/assetTarget&quot;/>&#xa;            &lt;xsl:if test=&quot;$Richiesta/operatoreRete&quot;>&#xa;                &lt;operatoreRete>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/operatoreRete&quot;/>&#xa;                &lt;/operatoreRete>&#xa;            &lt;/xsl:if>&#xa;            &lt;transactionIDLocator>&#xa;                &lt;xsl:value-of select=&quot;$CallLocatorATT/tns2:Testata/tns2:Transaction_id&quot;/>&#xa;            &lt;/transactionIDLocator>&#xa;            &lt;xsl:if test=&quot;$Richiesta/flagNumAggiuntive&quot;>&#xa;                &lt;flagNumAggiuntive>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/flagNumAggiuntive&quot;/>&#xa;                &lt;/flagNumAggiuntive>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDAnagraficaCausaleGUI&quot;>&#xa;                &lt;IDAnagraficaCausaleGUI>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDAnagraficaCausaleGUI&quot;/>&#xa;                &lt;/IDAnagraficaCausaleGUI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceRifiutoDonating&quot;>&#xa;                &lt;codiceRifiutoDonating>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceRifiutoDonating&quot;/>&#xa;                &lt;/codiceRifiutoDonating>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/DACFile&quot;>&#xa;                &lt;DACFile>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/DACFile&quot;/>&#xa;                &lt;/DACFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/tipologiaSottolav&quot;>&#xa;                &lt;tipologiaSottolav>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/tipologiaSottolav&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;            &lt;/xsl:if>&#xa;            