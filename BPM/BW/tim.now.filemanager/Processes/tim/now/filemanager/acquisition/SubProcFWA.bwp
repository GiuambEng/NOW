entoDONOR&quot;>&#xa;                    &lt;dataEspletamentoDONOR>&#xa;                        &lt;xsl:value-of select=&quot;dataEspletamentoDONOR&quot;/>&#xa;                    &lt;/dataEspletamentoDONOR>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceTrasformazione&quot;>&#xa;                    &lt;codiceTrasformazione>&#xa;                        &lt;xsl:value-of select=&quot;codiceTrasformazione&quot;/>&#xa;                    &lt;/codiceTrasformazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagOpereSpeciali&quot;>&#xa;                    &lt;flagOpereSpeciali>&#xa;                        &lt;xsl:value-of select=&quot;flagOpereSpeciali&quot;/>&#xa;                    &lt;/flagOpereSpeciali>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDRisorsaCorrelato&quot;>&#xa;                    &lt;IDRisorsaCorrelato>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsaCorrelato&quot;/>&#xa;                    &lt;/IDRisorsaCorrelato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDRichiestaOLOGenerante&quot;>&#xa;                    &lt;IDRichiestaOLOGenerante>&#xa;                        &lt;xsl:value-of select=&quot;IDRichiestaOLOGenerante&quot;/>&#xa;                    &lt;/IDRichiestaOLOGenerante>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipoComunicazioneNP&quot;>&#xa;                    &lt;tipoComunicazioneNP>&#xa;                        &lt;xsl:value-of select=&quot;tipoComunicazioneNP&quot;/>&#xa;                    &lt;/tipoComunicazioneNP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;servizioOrigine&quot;>&#xa;                    &lt;servizioOrigine>&#xa;                        &lt;xsl:value-of select=&quot;servizioOrigine&quot;/>&#xa;                    &lt;/servizioOrigine>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceSTS&quot;>&#xa;                    &lt;codiceSTS>&#xa;                        &lt;xsl:value-of select=&quot;codiceSTS&quot;/>&#xa;                    &lt;/codiceSTS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;caratteristica&quot;>&#xa;                    &lt;caratteristica>&#xa;                        &lt;xsl:value-of select=&quot;caratteristica&quot;/>&#xa;                    &lt;/caratteristica>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceRisorsaDonating&quot;>&#xa;                    &lt;codiceRisorsaDonating>&#xa;                        &lt;xsl:value-of select=&quot;codiceRisorsaDonating&quot;/>&#xa;                    &lt;/codiceRisorsaDonating>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceRisorsaDonating2&quot;>&#xa;                    &lt;codiceRisorsaDonating2>&#xa;                        &lt;xsl:value-of select=&quot;codiceRisorsaDonating2&quot;/>&#xa;                    &lt;/codiceRisorsaDonating2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;cowCodeOLO&quot;>&#xa;                    &lt;cowCodeOLO>&#xa;                        &lt;xsl:value-of select=&quot;cowCodeOLO&quot;/>&#xa;                    &lt;/cowCodeOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;cowCodeOLO2&quot;>&#xa;                    &lt;cowCodeOLO2>&#xa;                        &lt;xsl:value-of select=&quot;cowCodeOLO2&quot;/>&#xa;                    &lt;/cowCodeOLO2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceSessione&quot;>&#xa;                    &lt;codiceSessione>&#xa;                        &lt;xsl:value-of select=&quot;codiceSessione&quot;/>&#xa;                    &lt;/codiceSessione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceSessione2&quot;>&#xa;                    &lt;codiceSessione2>&#xa;                        &lt;xsl:value-of select=&quot;codiceSessione2&quot;/>&#xa;                    &lt;/codiceSessione2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;DNAggiuntivo&quot;>&#xa;                    &lt;DNAggiuntivo>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/DNAggiuntivo>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:if test=&quot;IDPreventivo&quot;>&#xa;                    &lt;IDPreventivo>&#xa;                        &lt;xsl:value-of select=&quot;IDPreventivo&quot;/>&#xa;                    &lt;/IDPreventivo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDConsuntivo&quot;>&#xa;                    &lt;IDConsuntivo>&#xa;                        &lt;xsl:value-of select=&quot;IDConsuntivo&quot;/>&#xa;                    &lt;/IDConsuntivo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;noteAltreLavorazioni&quot;>&#xa;                    &lt;noteAltreLavorazioni>&#xa;                        &lt;xsl:value-of select=&quot;noteAltreLavorazioni&quot;/>&#xa;                    &lt;/noteAltreLavorazioni>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codicePacchettoNOW&quot;>&#xa;                    &lt;codicePacchettoNOW>&#xa;                        &lt;xsl:value-of select=&quot;codicePacchettoNOW&quot;/>&#xa;                    &lt;/codicePacchettoNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:copy-of select=&quot;assetTarget&quot;/>&#xa;                &lt;xsl:if test=&quot;operatoreRete&quot;>&#xa;                    &lt;operatoreRete>&#xa;                        &lt;xsl:value-of select=&quot;operatoreRete&quot;/>&#xa;                    &lt;/operatoreRete>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;transactionIDLocator&quot;>&#xa;                    &lt;transactionIDLocator>&#xa;                        &lt;xsl:value-of select=&quot;transactionIDLocator&quot;/>&#xa;                    &lt;/transactionIDLocator>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagNumAggiuntive&quot;>&#xa;                    &lt;flagNumAggiuntive>&#xa;                        &lt;xsl:value-of select=&quot;flagNumAggiuntive&quot;/>&#xa;                    &lt;/flagNumAggiuntive>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDAnagraficaCausaleGUI&quot;>&#xa;                    &lt;IDAnagraficaCausaleGUI>&#xa;                        &lt;xsl:value-of select=&quot;IDAnagraficaCausaleGUI&quot;/>&#xa;                    &lt;/IDAnagraficaCausaleGUI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceRifiutoDonating&quot;>&#xa;                    &lt;codiceRifiutoDonating>&#xa;                        &lt;xsl:value-of select=&quot;codiceRifiutoDonating&quot;/>&#xa;                    &lt;/codiceRifiutoDonating>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;DACFile&quot;>&#xa;                    &lt;DACFile>&#xa;                        &lt;xsl:value-of select=&quot;DACFile&quot;/>&#xa;                    &lt;/DACFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipologiaSottolav&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;tipologiaSottolav&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceRifiuto&quot;>&#xa;                    &lt;codiceRifiuto>&#xa;                        &lt;xsl:value-of select=&quot;codiceRifiuto&quot;/>&#xa;                    &lt;/codiceRifiuto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;routingNumber&quot;>&#xa;                    &lt;routingNumber>&#xa;                        &lt;xsl:value-of select=&quot;routingNumber&quot;/>&#xa;                    &lt;/routingNumber>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;progressivoEmissioneDTU&quot;>&#xa;                    &lt;progressivoEmissioneDTU>&#xa;                        &lt;xsl:value-of select=&quot;progressivoEmissioneDTU&quot;/>&#xa;                    &lt;/progressivoEmissioneDTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagAttesaDesospOLO&quot;>&#xa;                    &lt;flagAttesaDesospOLO>&#xa;                        &lt;xsl:value-of select=&quot;flagAttesaDesospOLO&quot;/>&#xa;                    &lt;/flagAttesaDesospOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagDeliveryExposed&quot;>&#xa;                    &lt;flagDeliveryExposed>&#xa;                        &lt;xsl:value-of select=&quot;flagDeliveryExposed&quot;/>&#xa;                    &lt;/flagDeliveryExposed>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;disaggregato&quot;>&#xa;                    &lt;disaggregato>&#xa;                        &lt;xsl:value-of select=&quot;disaggregato&quot;/>&#xa;                    &lt;/disaggregato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exDisaggregato&quot;>&#xa;                    &lt;exDisaggregato>&#xa;                        &lt;xsl:value-of select=&quot;exDisaggregato&quot;/>&#xa;                    &lt;/exDisaggregato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;FFACQKO&quot;>&#xa;                    &lt;FFACQKO>&#xa;                        &lt;xsl:value-of select=&quot;FFACQKO&quot;/>&#xa;                    &lt;/FFACQKO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;idProgressivoNotificheFF&quot;>&#xa;                    &lt;idProgressivoNotificheFF>&#xa;                        &lt;xsl:value-of select=&quot;idProgressivoNotificheFF&quot;/>&#xa;                    &lt;/idProgressivoNotificheFF>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;idTplgCautelare&quot;>&#xa;                    &lt;idTplgCautelare>&#xa;                        &lt;xsl:value-of select=&quot;idTplgCautelare&quot;/>&#xa;                    &lt;/idTplgCautelare>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($Rendezvous/tns3:Record)>0 and exists($Rendezvous/tns3:Record[string-length(tns3:CODFC_OLO_AGCOM)>0])&quot;>&#xa;                    &lt;rendezVous>&#xa;                        &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                    &lt;/rendezVous>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;cambioTecnologia&quot;>&#xa;                    &lt;cambioTecnologia>&#xa;                        &lt;xsl:value-of select=&quot;cambioTecnologia&quot;/>&#xa;                    &lt;/cambioTecnologia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipoComunicazioneCPS&quot;>&#xa;                    &lt;tipoComunicazioneCPS>&#xa;                        &lt;xsl:value-of select=&quot;tipoComunicazioneCPS&quot;/>&#xa;                    &lt;/tipoComunicazioneCPS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;ordineAssetWhiteList&quot;>&#xa;                    &lt;ordineAssetWhiteList>&#xa;                        &lt;xsl:value-of select=&quot;ordineAssetWhiteList&quot;/>&#xa;                    &lt;/ordineAssetWhiteList>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:RichiestaElement>&#xa;        &lt;/xsl:for-each>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Richiesta" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
