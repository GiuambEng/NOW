                                <bpws:link name="Empty7ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty7ToJDBCQuery1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCQuery1ToAssign1" tibex:linkType="SUCCESS"/>
