                                    name="ContatoriNOW_ALTToEmpty6" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty6ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty6ToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="JDBCQueryToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
