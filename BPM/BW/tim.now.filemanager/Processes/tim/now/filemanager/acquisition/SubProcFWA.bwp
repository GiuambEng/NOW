                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; xmlns:ns0=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CallLocatorALT&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;PriorityCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterRAL&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml1&quot;/>&#xa;    &lt;xsl:param name=&quot;ALTArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;RichiestaALT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Element>&#xa;            &lt;tns:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns:moduleName>&#xa;            &lt;tns:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns:parameterName>&#xa;            &lt;xsl:if test=&quot;$Richiesta/lavorazione=&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot; and $Richiesta/ambito=&amp;quot;NOW&amp;quot;&quot;>&#xa;                &lt;tns:parameterName2>&#xa;                    &lt;xsl:value-of select=&quot;$BPMparameterRAL&quot;/>&#xa;                &lt;/tns:parameterName2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorALT/tns2:Risposta/tns2:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMoperationName&quot;/>&#xa;                    &lt;/tns:operationName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSoperationName&quot;/>&#xa;                    &lt;/tns:operationName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorALT/tns2:Risposta/tns2:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns:processName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;                    &lt;/tns:processName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:processName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSprocessName&quot;/>&#xa;                    &lt;/tns:processName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml1&quot;/>&#xa;            &lt;/tns:value>&#xa;            &lt;tns:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns:ID_FILE&quot;/>&#xa;            &lt;/tns:ID_FILE>&#xa;            &lt;xsl:if test=&quot;$TransitoryProperty=&amp;quot;Y&amp;quot; and $CallLocatorALT/tns2:Risposta/tns2:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&#xa;                &lt;tns:priority>&#xa;                    &lt;xsl:value-of select=&quot;$PriorityCRMWS&quot;/>&#xa;                &lt;/tns:priority>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:ContenutoXML>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($ALTArray/ns0:Richiesta[number($index)])&quot;/>&#xa;            &lt;/tns:ContenutoXML>&#xa;            &lt;tns:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$Richiesta/progressivoRichiestaFile&quot;>&#xa;                &lt;tns:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&#xa;                &lt;tns:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&#xa;                &lt;/tns:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'FWA'&quot;/>&#xa;            &lt;/tns:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&#xa;                &lt;tns:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log8-input"
                                    name="Log8"
                                    tibex:xpdlId="885315de-6b0a-41e6-a3e7-4ee70070140e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RichiestaALTToLog8"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log8ToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;RenderXml1&quot;/>&lt;xsl:template name=&quot;Log8-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;msgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcFWA | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&lt;/msgCode>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Richiesta inviata al BPM: &amp;quot;, $RenderXml1)&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
