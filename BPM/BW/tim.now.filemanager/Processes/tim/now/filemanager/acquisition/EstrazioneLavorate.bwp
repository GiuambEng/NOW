            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="7bfaff6d-1051-41eb-bbdd-a511b1b3102b">
                <bpws:targets>
                    <bpws:target linkName="LogNPestratteToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToLogEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($RichiesteStagNP/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($RichiesteStagNP/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="AssignToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStart1ToGroupEnd1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="LogToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="f239c1e4-fcfe-4770-9997-1980349dee5a">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RichiesteStagNP/Record[number($index)]/AMBITO!=&quot;NOW&quot; and string-length($RichiesteStagNP/Record[number($index)]/AMBITO)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$RichiesteStagNP/Record[number($index)]/AMBITO!="NOW" and string-length($RichiesteStagNP/Record[number($index)]/AMBITO)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToGroupEnd1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd1"
                                tibex:group="groupEnd" tibex:xpdlId="7f2b0ecc-73ed-4986-a7de-f8524fd5607e">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToGroupEnd1"/>
                                    <bpws:target linkName="LogToGroupEnd1"/>
                                </bpws:targets>
                            </bpws:empty>
