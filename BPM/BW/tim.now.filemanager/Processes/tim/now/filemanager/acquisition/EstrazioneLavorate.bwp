ns:Contatori>&lt;tns:Lavorate>&lt;xsl:for-each select=&quot;$Richieste/Record&quot;>&lt;xsl:if test=&quot;exists(PROGRESSIVORICHIESTAFILE)&quot;>&lt;tns1:ProgressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(PROGRESSIVORICHIESTAFILE)&quot;/>&lt;/tns1:ProgressivoRichiestaFile>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$RichiesteStagNP/Record&quot;>&lt;xsl:if test=&quot;exists(PROGRESSIVORICHIESTAFILE)&quot;>&lt;tns1:ProgressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(PROGRESSIVORICHIESTAFILE)&quot;/>&lt;/tns1:ProgressivoRichiestaFile>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$Mapper/tns3:Record&quot;>&lt;xsl:if test=&quot;exists(tns3:Progr_richiesta_File)&quot;>&lt;xsl:if test=&quot;tns3:Progr_richiesta_File&quot;>&lt;tns1:ProgressivoRichiestaFile>&lt;xsl:value-of select=&quot;tns3:Progr_richiesta_File&quot;/>&lt;/tns1:ProgressivoRichiestaFile>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:Lavorate>&lt;/tns:LavorateOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="58692c9d-466e-4ce7-a313-dfde2c75117d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
