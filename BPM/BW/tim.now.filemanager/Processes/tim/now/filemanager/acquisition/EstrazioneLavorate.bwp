            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RecordAcquisizione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richieste&quot;/>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;RichiesteStagNP&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:LavorateOutput>&lt;tns:Contatori>&lt;tns2:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns2:StringaCRMWS&quot;/>&lt;/tns2:StringaCRMWS>&lt;tns2:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns2:StringaSDR&quot;/>&lt;/tns2:StringaSDR>&lt;tns2:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns2:StringaDBCFX&quot;/>&lt;/tns2:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Mapper/tns3:Record)>0&quot;>&lt;tns2:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int(count($Mapper/tns3:Record[tns3:Ambito=&amp;quot;CRMWS&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;CRMWS&amp;quot;]))&quot;/>&lt;/tns2:ContatoreCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int(count($Richieste/Record[AMBITO=&amp;quot;CRMWS&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;CRMWS&amp;quot;]))&quot;/>&lt;/tns2:ContatoreCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Mapper/tns3:Record)>0&quot;>&lt;tns2:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int(count($Mapper/tns3:Record[tns3:Ambito=&amp;quot;SDR&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;SDR&amp;quot;]))&quot;/>&lt;/tns2:ContatoreSDR>&lt;/x