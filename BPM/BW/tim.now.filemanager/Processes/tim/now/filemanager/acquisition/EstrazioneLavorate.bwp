            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+383a3dd4-23b2-446a-aa0a-42461b1bb02a+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;$Start&quot;/>&lt;/ID_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Richieste-input" name="Richieste"
                    outputVariable="Richieste"
                    tibex:xpdlId="383a3dd4-23b2-446a-aa0a-42461b1bb02a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToRichieste"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RichiesteToForEach"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+383a3dd4-23b2-446a-aa0a-42461b1bb02a+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_FILE>&lt;xsl:value-of select=&quot;$Start&quot;/>&lt;/ID_FILE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT R.PROGRESSIVORICHIESTAFILE,R.CONTENUTOXML,R.AMBITO,R.STRUTTURARICHIESTA FROM BDS_1_CASEDATA_RICHIESTA R WHERE R.IDFILEINPUT=? ORDER BY R.LASTUPDATE ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    <columnMetadata
                                    columnName="PROGRESSIVORICHIESTAFILE"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="CONTENUTOXML"
                                    dataType="2011"
                                    status="OptionalElement" typeName="NCLOB"/>
                                    <columnMetadata
                                    columnName="AMBITO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STRUTTURARICHIESTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="c98e3ba9-5190-4bde-a68f-ee4cd0723095">
                <bpws:targets>
                    <bpws:target linkName="LogEstrattiToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToRichiesteStagNP"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:while name="while" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="$index&lt;=count($Richieste/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Richieste/Record)]]></bpws:condition>
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="GroupStartToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link name="AddStringToLog" tibex:linkType="SUCCESS"/>
                            <bpws:link name="LogToGroupEnd" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:empty name="GroupStart"
                            tibex:group="groupStart" tibex:xpdlId="67ed95ef-6df3-4b8b-9130-6b804c648a26">
                            <bpws:sources>
                                <bpws:source linkName="GroupStartToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Richieste/Record[number($index)]/AMBITO!=&quot;NOW&quot; and string-length($Richieste/Record[number($index)]/AMBITO)>0 and string-length($Richieste/Record[number($index)]/STRUTTURARICHIESTA)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Richieste/Record[number($index)]/AMBITO!="NOW" and string-length($Richieste/Record[number($index)]/AMBITO)>0 and string-length($Richieste/Record[number($index)]/STRUTTURARICHIESTA)>0]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="GroupStartToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:empty name="GroupEnd"
                            tibex:group="groupEnd" tibex:xpdlId="e581804e-cdc9-4784-b6b8-a9bd375cbd52">
                            <bpws:targets>
                                <bpws:target linkName="GroupStartToGroupEnd"/>
                                <bpws:target linkName="LogToGroupEnd"/>
                            </bpws:targets>
                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
