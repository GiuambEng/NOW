                                    <bpws:sources>
                                    <bpws:source linkName="AssignToLog"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns1=&quot;http://www.example.org/ListaContatori&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RichiesteStagNP&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichiesteStagNP/Record[number($index)]/AMBITO=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns1:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaCRMWS,$RichiesteStagNP/Record[number($index)]/CONTENUTOXML)&quot;/>&lt;/tns1:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaCRMWS&quot;/>&lt;/tns1:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichiesteStagNP/Record[number($index)]/AMBITO=&amp;quot;SDR&amp;quot;&quot;>&lt;tns1:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaSDR,$RichiesteStagNP/Record[number($index)]/CONTENUTOXML)&quot;/>&lt;/tns1:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaSDR&quot;/>&lt;/tns1:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichiesteStagNP/Record[number($index)]/AMBITO=&amp;quot;DBCFX&amp;quot;&quot;>&lt;tns1:StringaDBCFX>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaDBCFX,$RichiesteStagNP/Record[number($index)]/CONTENUTOXML)&quot;/>&lt;/tns1:StringaDBCFX>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaDBCFX&quot;/>&lt;/tns1:StringaDBCFX>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:ContatoreCRMWS>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreCRMWS>&lt;tns1:ContatoreSDR>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreSDR>&lt;tns1:ContatoreDBCFX>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreDBCFX>&lt;tns1:ContatoreNOW>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreNOW>&lt;tns1:ContatoreKO>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns1:ContatoreKO>&lt;/tns:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
