                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/Lavorate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/RecordAcquisizione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richieste&quot;/>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;RichiesteStagNP&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:LavorateOutput>&lt;tns:Contatori>&lt;tns2:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns2:StringaCRMWS&quot;/>&lt;/tns2:StringaCRMWS>&lt;tns2:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns2:StringaSDR&quot;/>&lt;/tns2:StringaSDR>&lt;tns2:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns2:StringaDBCFX&quot;/>&lt;/tns2:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Mapper/tns3:Record)>0&quot;>&lt;tns2:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int(count($Mapper/tns3:Record[tns3:Ambito=&amp;quot;CRMWS&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;CRMWS&amp;quot;]))&quot;/>&lt;/tns2:ContatoreCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int(count($Richieste/Record[AMBITO=&amp;quot;CRMWS&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;CRMWS&amp;quot;]))&quot;/>&lt;/tns2:ContatoreCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Mapper/tns3:Record)>0&quot;>&lt;tns2:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int(count($Mapper/tns3:Record[tns3:Ambito=&amp;quot;SDR&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;SDR&amp;quot;]))&quot;/>&lt;/tns2:ContatoreSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int(count($Richieste/Record[AMBITO=&amp;quot;SDR&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;SDR&amp;quot;]))&quot;/>&lt;/tns2:ContatoreSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Mapper/tns3:Record)>0&quot;>&lt;tns2:ContatoreDBCFX>&lt;xsl:value-of select=&quot;xsd:int(count($Mapper/tns3:Record[tns3:Ambito=&amp;quot;DBCFX&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;DBCFX&amp;quot;]))&quot;/>&lt;/tns2:ContatoreDBCFX>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContatoreDBCFX>&lt;xsl:value-of select=&quot;xsd:int(count($Richieste/Record[AMBITO=&amp;quot;DBCFX&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;DBCFX&amp;quot;]))&quot;/>&lt;/tns2:ContatoreDBCFX>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Mapper/tns3:Record)>0&quot;>&lt;tns2:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int(count($Mapper/tns3:Record[tns3:Ambito=&amp;quot;NOW&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;NOW&amp;quot;]))&quot;/>&lt;/tns2:ContatoreNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int(count($Richieste/Record[AMBITO=&amp;quot;NOW&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;NOW&amp;quot;]))&quot;/>&lt;/tns2:ContatoreNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Mapper/tns3:Record)>0&quot;>&lt;tns2:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int(count($Mapper/tns3:Record[tns3:Ambito=&amp;quot;SDR&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;SDR&amp;quot;]))&quot;/>&lt;/tns2:ContatoreKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int(count($Richieste/Record[AMBITO=&amp;quot;SDR&amp;quot;])+count($RichiesteStagNP/Record[AMBITO=&amp;quot;SDR&amp;quot;]))&quot;/>&lt;/tns2:ContatoreKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Contatori>&lt;tns:Lavorate>&lt;xsl:for-each select=&quot;$Richieste/Record&quot;>&lt;xsl:if test=&quot;exists(PROGRESSIVORICHIESTAFILE)&quot;>&lt;tns1:ProgressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(PROGRESSIVORICHIESTAFILE)&quot;/>&lt;/tns1:ProgressivoRichiestaFile>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$RichiesteStagNP/Record&quot;>&lt;xsl:if test=&quot;exists(PROGRESSIVORICHIESTAFILE)&quot;>&lt;tns1:ProgressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(PROGRESSIVORICHIESTAFILE)&quot;/>&lt;/tns1:ProgressivoRichiestaFile>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$Mapper/tns3:Record&quot;>&lt;xsl:if test=&quot;exists(tns3:Progr_richiesta_File)&quot;>&lt;xsl:if test=&quot;tns3:Progr_richiesta_File&quot;>&lt;tns1:ProgressivoRichiestaFile>&lt;xsl:value-of select=&quot;tns3:Progr_richiesta_File&quot;/>&lt;/tns1:ProgressivoRichiestaFile>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:Lavorate>&lt;/tns:LavorateOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
