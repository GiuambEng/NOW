                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Contatori"
                                    name="Assign"
                                    outputVariable="Contatori"
                                    tibex:xpdlId="f4cbfc74-19ad-4a4f-8a8a-2d8799a235b8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
