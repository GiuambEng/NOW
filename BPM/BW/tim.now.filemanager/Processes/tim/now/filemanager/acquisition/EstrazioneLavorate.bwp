                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EstrazioneLavorate&quot; xmlns:tns1=&quot;http://www.example.org/ListaContatori&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RichiesteStagNP&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichiesteStagNP/Record[number($index)]/AMBITO=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns1:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaCRMWS,$RichiesteStagNP/Record[number($index)]/CONTENUTOXML)&quot;/>&lt;/tns1:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaCRMWS&quot;/>&lt;/tns1:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichiesteStagNP/Record[number($index)]/AMBITO=&amp;quot;SDR&amp;quot;&quot;>&lt;tns1:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaSDR,$RichiesteStagNP/Record[number($index)]/CONTENUTOXML)&quot;/>&lt;/tns1:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaSDR&quot;/>&lt;/tns1:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$RichiesteStagNP/Record[number($index)]/AMBITO=&amp;quot;DBCFX&amp;quot;&quot;>&lt;tns1:StringaDBCFX>&lt;xsl:value-of select=&quot;concat($Contatori/tns1:StringaDBCFX,$RichiesteStagNP/Record[number($index)]/CONTENUTOXML)&quot;/>&lt;/tns1:StringaDBCFX>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns1:StringaDBCFX&quot;/>&lt;/tns1:StringaDBCFX>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:ContatoreCRMWS>&lt;xsl:value-of select=&quot;0