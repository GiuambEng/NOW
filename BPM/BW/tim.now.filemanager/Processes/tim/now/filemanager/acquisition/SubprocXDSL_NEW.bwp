                                    <bpws:sources>
                                    <bpws:source linkName="MapperRichiestaToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$TransitoryProperty=&quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$TransitoryProperty="Y"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="MapperRichiestaToContatoriNOW_ALT">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
