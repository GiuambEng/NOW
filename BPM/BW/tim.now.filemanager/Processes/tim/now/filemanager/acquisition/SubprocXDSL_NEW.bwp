                                    inputVariable="CreaRichiestaATTcrmws-input"
                                    name="CreaRichiestaATTcrmws"
                                    tibex:xpdlId="c2a786d2-7978-4c8b-bab1-d96866a3dab8"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
