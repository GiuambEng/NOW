                                                            &lt;ns0:PIVA>&#xa;                                                                                        &lt;xsl:value-of select=&quot;$Token9/tns2:ResponseCreate_token/tns2:PIVA&quot;/>&#xa;                                                                                    &lt;/ns0:PIVA>&#xa;                                                                                &lt;/xsl:otherwise>&#xa;                                                                            &lt;/xsl:choose>&#xa;                                                                        &lt;/ns0:ClienteFinale>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:SlaProvisioning&quot;>&#xa;                                                                            &lt;ns0:SlaProvisioning>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:SlaProvisioning&quot;/>&#xa;                                                                            &lt;/ns0:SlaProvisioning>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:CodiceQualita&quot;>&#xa;                                                                            &lt;ns0:CodiceQualita>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:CodiceQualita&quot;/>&#xa;                                                                            &lt;/ns0:CodiceQualita>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:CodiceDelivery&quot;>&#xa;                                                                            &lt;ns0:CodiceDelivery>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:CodiceDelivery&quot;/>&#xa;                                                                            &lt;/ns0:CodiceDelivery>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:DAD&quot;>&#xa;                                                                            &lt;ns0:DAD>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:DAD&quot;/>&#xa;                                                                            &lt;/ns0:DAD>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:FasciaOraria&quot;>&#xa;                                                                            &lt;ns0:FasciaOraria>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:FasciaOraria&quot;/>&#xa;                                                                            &lt;/ns0:FasciaOraria>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:CampoServizioIt&quot;>&#xa;                                                                            &lt;ns0:CampoServizioIt>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:CampoServizioIt&quot;/>&#xa;                                                                            &lt;/ns0:CampoServizioIt>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;ns0:ProfiloTecnicoLinea>&#xa;                                                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:ProfiloTecnicoLinea&quot;/>&#xa;                                                                        &lt;/ns0:ProfiloTecnicoLinea>&#xa;                                                                        &lt;ns0:ModalitaConsegna>&#xa;                                                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:ModalitaConsegna&quot;/>&#xa;                                                                        &lt;/ns0:ModalitaConsegna>&#xa;                                                                        &lt;ns0:Modulazione>&#xa;                                                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:Modulazione&quot;/>&#xa;                                                                        &lt;/ns0:Modulazione>&#xa;                                                                        &lt;xsl:for-each select=&quot;$Richiesta/ordine/referente&quot;>&#xa;                                                                            &lt;ns0:Referente>&#xa;                                                                                &lt;ns0:Progressivo>&#xa;                                                                                    &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                                                                                &lt;/ns0:Progressivo>&#xa;                                                                                &lt;ns0:Qualifica>&#xa;                                                                                    &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                                                                                &lt;/ns0:Qualifica>&#xa;                                                                                &lt;ns0:Nome>&#xa;                                                                                    &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                                                                                &lt;/ns0:Nome>&#xa;                                                                                &lt;ns0:Cognome>&#xa;                                                                                    &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                                                                                &lt;/ns0:Cognome>&#xa;                                                                                &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                                                                    &lt;ns0:Telefono>&#xa;                                                                                        &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                                                                    &lt;/ns0:Telefono>&#xa;                                                                                &lt;/xsl:if>&#xa;                                                                                &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                                                                    &lt;ns0:Mobile>&#xa;                                                                                        &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                                                                    &lt;/ns0:Mobile>&#xa;                                                                                &lt;/xsl:if>&#xa;                                                                                &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                                                                                    &lt;ns0:Email>&#xa;                                                                                        &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                                                                                    &lt;/ns0:Email>&#xa;                                                                                &lt;/xsl:if>&#xa;                                                                            &lt;/ns0:Referente>&#xa;                                                                        &lt;/xsl:for-each>&#xa;                                                                    &lt;/ns0:LineaNonFonia>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns0:Accesso>&#xa;                                                        &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:Servizio/ns0:EasyIPSpecialProfileLite/ns0:VC&quot;/>&#xa;                                                    &lt;/ns0:EasyIPSpecialProfileLite>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/ns0:Servizio>&#xa;                                        &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:Attivazione274/ns0:DatiMigrazione&quot;/>&#xa;                                    &lt;/ns0:Attivazione274>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneADSLRetail&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns0:Migrazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Prequalifica&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ns0:TipoRichiesta>&#xa;        &lt;/ns0:Richiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:order="http://xsd.telecomitalia.it/crm/xdsl/order"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="order:Richiesta"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="DeterminaToken-input"
                                    name="DeterminaToken"
                                    outputVariable="DeterminaToken"
                                    tibex:xpdlId="2866d222-ec30-43db-b817-cce0da2d3543"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderRichiestaALTToCallProcess1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToCallProcess21">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallProcess1ToRefAltreLav">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$DeterminaToken/ns63:TipoToken='NOTOKEN'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$DeterminaToken/ns63:TipoToken='NOTOKEN']]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:CodOrdTI>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;            &lt;/tns2:CodOrdTI>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.DeterminaTokenizzazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallProcess2-input"
                                    name="CallProcess2"
                                    outputVariable="CallProcess2"
                                    tibex:xpdlId="2cbc3cbd-ce81-4279-a0b2-6efd6821a98e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToCallProcess21"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess2ToRefAltreLav"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:param name=&quot;DeterminaToken&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                    &lt;tns5:RequestCreate_token>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM&quot;>&#xa;                                    &lt;tns5:CodificaOLOAGCOM>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM&quot;/>&#xa;                                    &lt;/tns5:CodificaOLOAGCOM>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:CodificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                                &lt;/tns5:CodificaOLOAGCOM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                            &lt;tns5:CodiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                            &lt;/tns5:CodiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:Funzione>&#xa;                            &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                        &lt;/tns5:Funzione>&#xa;                        &lt;tns5:ChiaveRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;concat($NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOrdineOlo,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                        &lt;/tns5:ChiaveRiferimento>&#xa;                        &lt;tns5:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                        &lt;/tns5:Operatore>&#xa;                        &lt;xsl:if test=&quot;$GetLocalIP/tns4:IPAddress&quot;>&#xa;                            &lt;tns5:IPClient>&#xa;                                &lt;xsl:value-of select=&quot;$GetLocalIP/tns4:IPAddress&quot;/>&#xa;                            &lt;/tns5:IPClient>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns5:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns5:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns5:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns5:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:NomeReferente&quot;>&#xa;                            &lt;tns5:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:NomeReferente&quot;/>&#xa;                            &lt;/tns5:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:CognomeReferente&quot;>&#xa;                            &lt;tns5:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:CognomeReferente&quot;/>&#xa;                            &lt;/tns5:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:TOKENIZZAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$DeterminaToken/tns3:TipoToken&quot;/>&#xa;                        &lt;/tns5:TOKENIZZAZIONE>&#xa;                    &lt;/tns5:RequestCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:RequestCreate_token>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM&quot;>&#xa;                                    &lt;tns5:CodificaOLOAGCOM>&#xa;                                        &lt;xsl:value-of select=&quot;$Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM&quot;/>&#xa;                                    &lt;/tns5:CodificaOLOAGCOM>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:CodificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                                &lt;/tns5:CodificaOLOAGCOM>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                            &lt;tns5:CodiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                            &lt;/tns5:CodiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:Funzione>&#xa;                            &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                        &lt;/tns5:Funzione>&#xa;                        &lt;tns5:ChiaveRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;concat($NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOrdineOlo,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                        &lt;/tns5:ChiaveRiferimento>&#xa;                        &lt;tns5:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                        &lt;/tns5:Operatore>&#xa;                        &lt;xsl:if test=&quot;$GetLocalIP/tns4:IPAddress&quot;>&#xa;                            &lt;tns5:IPClient>&#xa;                                &lt;xsl:value-of select=&quot;$GetLocalIP/tns4:IPAddress&quot;/>&#xa;                            &lt;/tns5:IPClient>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Telefono&quot;>&#xa;                            &lt;tns5:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Telefono&quot;/>&#xa;                            &lt;/tns5:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Mobile&quot;>&#xa;                            &lt;tns5:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Mobile&quot;/>&#xa;                            &lt;/tns5:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Nome&quot;>&#xa;                            &lt;tns5:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Nome&quot;/>&#xa;                            &lt;/tns5:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Cognome&quot;>&#xa;                            &lt;tns5:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Cognome&quot;/>&#xa;                            &lt;/tns5:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:TOKENIZZAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$DeterminaToken/tns3:TipoToken&quot;/>&#xa;                        &lt;/tns5:TOKENIZZAZIONE>&#xa;                    &lt;/tns5:RequestCreate_token>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns5:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns5:ProcessIstance>&#xa;            &lt;tns5:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;            &lt;/tns5:StrutturaRichiesta>&#xa;            &lt;tns5:OffertaBPM>&#xa;                &lt;xsl:value-of select=&quot;$DeterminaToken/tns3:Offerta&quot;/>&#xa;            &lt;/tns5:OffertaBPM>&#xa;        &lt;/tns5:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Log_EstrazioniIDOfferta-input"
                    name="Log_EstrazioniIDOfferta"
                    tibex:xpdlId="f01e1406-0eb5-4d40-a714-61926b6b02e9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListaOfferteToLog_EstrazioniIDOfferta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_EstrazioniIDOffertaToEstrazioneIDofferta"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaOfferte&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_EstrazioniIDOfferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($ListaOfferte/tns3:Offerta)>0&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT NOME_OFFERTA_ESTERNA, ID_OFFERTA  FROM TRASCODFC_OFFERTA  WHERE upper(NOME_OFFERTA_ESTERNA) IN ( '&amp;quot;, tib:concat-sequence-format($ListaOfferte/tns3:Offerta,&amp;quot;' , '&amp;quot;, true()) , &amp;quot;' ) AND PROVENIENZA='BPM'&amp;quot;)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Non è presente la lista delle offerte&amp;quot;&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Log_ListIDOfferta-input"
                    name="Log_ListIDOfferta"
                    tibex:xpdlId="24a03cbb-bff5-41e9-b637-537e203212b3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListaIdOffertaToLog_ListIDOfferta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_ListIDOffertaToListaComuni"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_ListIDOfferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($ListaIdOfferta/tns3:Offerta)>0&quot;>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($ListaIdOfferta)&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;message>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Non esistono offerte estrapolate dal DB&amp;quot;&quot;/>&#xa;                    &lt;/message>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Log_EstrazioneDescrComune-input"
                    name="Log_EstrazioneDescrComune"
                    tibex:xpdlId="6b532860-7e33-44db-a926-d6ebc603700d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListaComuniToLog_EstrazioneDescrComune"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_EstrazioneDescrComuneToEstrazioneDescrComune"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaComuni&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_EstrazioneDescrComune-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT cod_istat_comune, descr_comune FROM comune_o_localita WHERE (to_date(sysdate)&amp;lt;datafi_valid OR datafi_valid IS NULL) AND cod_istat_comune IN ( '&amp;quot; , tib:concat-sequence-format($ListaComuni/tns3:CodiceIstatComune,&amp;quot;' , '&amp;quot;, true()) , &amp;quot;' ) AND flag_comune='S'&amp;quot;)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Log_ListaDescrComune-input"
                    name="Log_ListaDescrComune"
                    tibex:xpdlId="52ace5e2-ab1b-4976-9bd6-82c4959f7223" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListaDescrComuneToLog_ListaDescrComune"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_ListaDescrComuneToContaRichieste"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDescrComune&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_ListaDescrComune-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($ListaDescrComune)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
