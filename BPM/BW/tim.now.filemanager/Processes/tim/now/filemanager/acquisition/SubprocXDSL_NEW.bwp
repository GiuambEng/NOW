ect=&quot;&amp;quot;EASYIPBASEPLUSFLAT&amp;quot;&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPSpecialProfile)&quot;>&#xa;                            &lt;offertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot;&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:VLAN)&quot;>&#xa;                            &lt;offertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VLAN&amp;quot;&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC) or string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:NuovaDAC)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)>0 and tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)&quot;>&#xa;                                &lt;DAC>&#xa;                                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)&quot;/>&#xa;                                &lt;/DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC) and tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC)&quot;>&#xa;                                        &lt;DAC>&#xa;                                            &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC)&quot;/>&#xa;                                        &lt;/DAC>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:NuovaDAC)&quot;>&#xa;                                            &lt;DAC>&#xa;                                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:NuovaDAC)&quot;/>&#xa;                                            &lt;/DAC>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DataAppuntamento) or string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DataAppuntamentoDesiderata)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DataAppuntamento)&quot;>&#xa;                                    &lt;DAD>&#xa;                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DataAppuntamento)&quot;/>&#xa;                                    &lt;/DAD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;DAD>&#xa;                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DataAppuntamentoDesiderata)&quot;/>&#xa;                                    &lt;/DAD>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:DAD)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0333']/FLAG_OSCURMENTO='1'&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:DAD)>0&quot;>&#xa;                                            &lt;DAD>&#xa;                                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:DAD)&quot;/>&#xa;                                            &lt;/DAD>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM)>0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceOLO2)>0&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;($Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:Attivazione274/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneADSLRetail/ns01:DatiMigrazione/ns01:CodiceOLO1)  and $Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM!=$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceOLO2 and string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:FasciaOraria)>0 and count($JDBCQuery4/Record)>0 and upper-case($JDBCQuery6/Record[1]/ONESTEP)='SI'&quot;>&#xa;                                                            &lt;DAD>&#xa;                                                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)&quot;/>&#xa;                                                            &lt;/DAD>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise/>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;($Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:Attivazione274/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneADSLRetail/ns01:DatiMigrazione/ns01:CodiceOLO1) and string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:FasciaOraria)>0 and count($JDBCQuery4/Record)>0 and upper-case($JDBCQuery6/Record[1]/ONESTEP)='SI'&quot;>&#xa;                                                    &lt;DAD>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)&quot;/>&#xa;                                                    &lt;/DAD>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise/>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;string-length($Start/tns2:CodOLOdaNome )>0&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceOLO2)>0&quot;>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;($Start/tns2:CodOLOdaNome!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns2:CodOLOdaNome!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:Attivazione274/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns2:CodOLOdaNome!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneADSLRetail/ns01:DatiMigrazione/ns01:CodiceOLO1)and $Start/tns2:CodOLOdaNome!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO/ns01:DatiMigrazione/ns01:CodiceOLO2 and string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:FasciaOraria)>0 and count($JDBCQuery4/Record)>0 and upper-case($JDBCQuery6/Record[1]/ONESTEP)='SI'&quot;>&#xa;                                                            &lt;DAD>&#xa;                                                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)&quot;/>&#xa;                                                            &lt;/DAD>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise/>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;($Start/tns2:CodOLOdaNome!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns2:CodOLOdaNome!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:Attivazione274/ns01:DatiMigrazione/ns01:CodiceOLO1 or $Start/tns2:CodOLOdaNome!=$rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneADSLRetail/ns01:DatiMigrazione/ns01:CodiceOLO1) and string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:FasciaOraria)>0 and count($JDBCQuery4/Record)>0 and upper-case($JDBCQuery6/Record[1]/ONESTEP)='SI'&quot;>&#xa;                                                    &lt;DAD>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)&quot;/>&#xa;                                                    &lt;/DAD>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise/>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise/>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:DAD[1])>0&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,$rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:DAD[1])&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;xsl:if test=&quot;$Token9/tns5:ResponseCreate_token/tns5:CognomeRagioneSociale&quot;>&#xa;                        &lt;cognomeRagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$Token9/tns5:ResponseCreate_token/tns5:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/cognomeRagioneSociale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Token9/tns5:ResponseCreate_token/tns5:Nome)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Token9/tns5:ResponseCreate_token/tns5:Nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;$Token9/tns5:ResponseCreate_token/tns5:Nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Token9/tns5:ResponseCreate_token/tns5:CodiceFiscale)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Token9/tns5:ResponseCreate_token/tns5:CodiceFiscale&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;$Token9/tns5:ResponseCreate_token/tns5:CodiceFiscale&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($Token9/tns5:ResponseCreate_token/tns5:PIVA)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Token9/tns5:ResponseCreate_token/tns5:PIVA&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;$Token9/tns5:ResponseCreate_token/tns5:PIVA&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:CodiceDelivery)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:CodiceDelivery&quot;>&#xa;                                &lt;codiceDelivery>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:CodiceDelivery&quot;/>&#xa;                                &lt;/codiceDelivery>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:CodiceDelivery[1])>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:CodiceDelivery&quot;>&#xa;                                &lt;codiceDelivery>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:CodiceDelivery&quot;/>&#xa;                                &lt;/codiceDelivery>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;matches($rich/ns01:Testata/ns01:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                            &lt;noteCliente>&#xa;                                &lt;xsl:value-of select=&quot;translate($rich/ns01:Testata/ns01:Note, '0123456789', '         ')&quot;/>&#xa;                            &lt;/noteCliente>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:Note&quot;>&#xa;                                &lt;noteCliente>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:Note&quot;/>&#xa;                                &lt;/noteCliente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;codificaOLONOW>&#xa;                        &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                    &lt;/codificaOLONOW>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                        &lt;codiceOrdineOLOPadre>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOloPadre&quot;/>&#xa;                        &lt;/codiceOrdineOLOPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM)>0&quot;>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/codificaOLOAGCOM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                            &lt;/codificaOLOAGCOM>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Cessazione/node()/ns01:IDENTIFICATIVO_RISORSA[1])>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Cessazione/node()/ns01:IDENTIFICATIVO_RISORSA&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Cessazione/node()/ns01:IDENTIFICATIVO_RISORSA&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Cessazione)&quot;>&#xa;                            &lt;tipologiaLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaLavorazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione)&quot;>&#xa;                            &lt;tipologiaLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaLavorazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione)&quot;>&#xa;                            &lt;tipologiaLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaLavorazione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tipologiaLavorazione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaLavorazione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:Attivazione274)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE274&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneADSLRetail)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONEOLO&amp;quot;&quot;/>&#x