                                <tibex:activityExtension
                                    inputVariable="LogChiamateBPM-input"
                                    name="LogChiamateBPM"
                                    tibex:xpdlId="24c6c901-f1a4-4a68-b225-41779b00b987" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
