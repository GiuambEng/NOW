                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter" xmlns:tns3="http://www.tim.com/NOW/xsd/ReplaceCharacter" xmlns:ns01="http://xsd.telecomitalia.it/crm/xdsl/order" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="NORMALarray"/&gt;
    &lt;xsl:param name="Mapper7"/&gt;
    &lt;xsl:template name="ReplaceCharacter5-input" match="/"&gt;
        &lt;tns2:ReplaceCharacterRequest&gt;
            &lt;ReplaceCharacterInput&gt;
                &lt;tns3:InputString&gt;
                    &lt;tns3:OldString&gt;
                        &lt;xsl:value-of select="tib:render-xml($Mapper7, true(), true())"/&gt;
                    &lt;/tns3:OldString&gt;
                    &lt;tns3:OldChar&gt;
                        &lt;xsl:value-of select="'tns:'"/&gt;
                    &lt;/tns3:OldChar&gt;
                    &lt;xsl:choose&gt;
