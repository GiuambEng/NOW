                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;CallLocatorALT&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/created&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/lastUpdate&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;xsl:if test=&quot;$Richiesta/statoRichiestaOLO&quot;>&#xa;                &lt;statoRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaOLO&quot;/>&#xa;                &lt;/statoRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;>&#xa;                &lt;statoRichiestaPrecedOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                &lt;/statoRichiestaPrecedOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/sottostatoLavorManuale&quot;>&#xa;                &l