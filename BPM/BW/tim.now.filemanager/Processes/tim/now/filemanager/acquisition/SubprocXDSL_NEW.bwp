                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Request>&#xa;            &lt;tns2:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns2:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns2:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns2:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns2:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/offerta&quot;>&#xa;                    &lt;tns2:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/offerta&quot;/>&#xa;                    &lt;/tns2:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns2:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns2:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns2:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns2:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:FlagReferente>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:FlagReferente>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns2:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:RequestVerificaRollout>&#xa;            &lt;tns2:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns2:ProcessIstance>&#xa;        &lt;/tns2:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
