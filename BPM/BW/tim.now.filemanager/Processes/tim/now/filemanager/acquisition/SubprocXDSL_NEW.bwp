Xml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoHL/ns0:Accesso/ns0:LineaISDN/ns0:Modulazione&quot;/>&#xa;                                                &lt;/ns0:Modulazione>&#xa;                                                &lt;xsl:for-each select=&quot;$Richiesta/ordine/referente[string-length(qualificaReferente)>0 and string-length(nomeReferente)>0 and string-length(cognomeReferente)>0]&quot;>&#xa;                                                    &lt;ns0:Referente>&#xa;                                                        &lt;ns0:Progressivo>&#xa;                                                            &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                                                        &lt;/ns0:Progressivo>&#xa;                                                        &lt;ns0:Qualifica>&#xa;                                                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                                                        &lt;/ns0:Qualifica>&#xa;                                                        &lt;ns0:Nome>&#xa;                                                            &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                                                        &lt;/ns0:Nome>&#xa;                                                        &lt;ns0:Cognome>&#xa;                                                            &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                                                        &lt;/ns0:Cognome>&#xa;                                                        &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                                            &lt;ns0:Telefono>&#xa;                                                                &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                                            &lt;/ns0:Te