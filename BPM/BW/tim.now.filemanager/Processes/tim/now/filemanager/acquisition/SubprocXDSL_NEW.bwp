                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:template name=&quot;Token8-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;tns3:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns3:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns3:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns3:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/offerta&quot;>&#xa;                    &lt;tns3:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/offerta&quot;/>&#xa;                    &lt;/tns3:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns3:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns3:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns3:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns3:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:FlagClienteFinale>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:FlagClienteFinale>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:RequestVerificaRollout>&#xa;            &lt;tns3:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns3:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns3:Funzione>&#xa;                &lt;tns3:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns3:ChiaveRiferimento>&#xa;                &lt;tns3:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns3:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns3:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns3:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/nome&quot;>&#xa;                    &lt;tns3:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/nome&quot;/>&#xa;                    &lt;/tns3:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/cognomeRagioneSociale&quot;>&#xa;                    &lt;tns3:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/cognomeRagioneSociale&quot;/>&#xa;                    &lt;/tns3:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/CF&quot;>&#xa;                    &lt;tns3:CodiceFiscale>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/CF&quot;/>&#xa;                    &lt;/tns3:CodiceFiscale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/PIVA&quot;>&#xa;                    &lt;tns3:PIVA>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/PIVA&quot;/>&#xa;                    &lt;/tns3:PIVA>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:RequestCreate_token>&#xa;        &lt;/tns3:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ATT-ANNArray"
                                    name="Assign17"
                                    outputVariable="ATT-ANNArray"
                                    tibex:xpdlId="3c8a3df7-0d5a-41da-b28b-a852036fa73c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXml1ToAssign17"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign17ToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Token8&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;ATT-ANNArray&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaMapper>&#xa;            &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns2:Richiesta&quot;>&#xa;                &lt;xsl:variable name=&quot;position&quot; select=&quot;position()&quot;/>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$position=$index&quot;>&#xa;                        &lt;tns2:Richiesta>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;statoRichiestaNOW>&#xa;                                &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                            &lt;/statoRichiestaNOW>&#xa;                            &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                                &lt;statoRichiestaPrecedNOW>&#xa;                                    &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                                &lt;/statoRichiestaPrecedNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                                &lt;statoRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                                &lt;/statoRichiestaOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                                &lt;statoRichiestaPrecedOLO>&#xa;                                    &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                                &lt;/statoRichiestaPrecedOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                                &lt;sottostatoLavorManuale>&#xa;                                    &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                                &lt;/sottostatoLavorManuale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                                &lt;IDFileInput>&#xa;                                    &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                                &lt;/IDFileInput>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                                &lt;IDFileOutput>&#xa;                                    &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                                &lt;/IDFileOutput>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ambito&quot;>&#xa;                                &lt;ambito>&#xa;                                    &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                                &lt;/ambito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;canaleRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&#xa;                            &lt;/canaleRichiesta>&#xa;                            &lt;xsl:if test=&quot;lavorazione&quot;>&#xa;                                &lt;lavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;lavorazione&quot;/>&#xa;                                &lt;/lavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&#xa;                                &lt;progressivoRichiestaFile>&#xa;                                    &lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&#xa;                                &lt;/progressivoRichiestaFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&#xa;                            &lt;/strutturaRichiesta>&#xa;                            &lt;tipoRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&#xa;                            &lt;/tipoRichiesta>&#xa;                            &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;codificaOLOAGCOM&qu