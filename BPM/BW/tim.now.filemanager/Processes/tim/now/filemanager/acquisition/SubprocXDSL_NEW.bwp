 &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/ns01:EasyIPBasePlusLite)&quot;>&#xa;                            &lt;tns5:OffertaBPM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;EASYIPBASEPLUSLITE&amp;quot;&quot;/>&#xa;                            &lt;/tns5:OffertaBPM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/ns01:EasyIPSpecialProfileFlat)&quot;>&#xa;                            &lt;tns5:OffertaBPM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILEFLAT&amp;quot;&quot;/>&#xa;                            &lt;/tns5:OffertaBPM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/ns01:EasyIPSpecialProfileLite)&quot;>&#xa;                            &lt;tns5:OffertaBPM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                            &lt;/tns5:OffertaBPM>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:OffertaBPM>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;EASYIPSPECIALPROFILELITE&amp;quot;&quot;/>&#xa;                            &lt;/tns5:OffertaBPM>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:OffertaBPM>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns5:Offe