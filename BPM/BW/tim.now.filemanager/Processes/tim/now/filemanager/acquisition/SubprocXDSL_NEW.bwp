                                    <bpws:sources>
                                    <bpws:source linkName="CambioAmbitoToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;CallLocatorATT&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/created&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/lastUpdate&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;xsl:if test=&quot;$Richiesta/statoRichiestaOLO&quot;>&#xa;                &lt;statoRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaOLO&quot;/>&#xa;                &lt;/statoRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;>&#xa;                &lt;statoRichiestaPrecedOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                &lt;/statoRichiestaPrecedOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/sottostatoLavorManuale&quot;>&#xa;                &lt;sottostatoLavorManuale>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/sottostatoLavorManuale&quot;/>&#xa;                &lt;/sottostatoLavorManuale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDFileInput&quot;>&#xa;                &lt;IDFileInput>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDFileInput&quot;/>&#xa;                &lt;/IDFileInput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDFileOutput&quot;>&#xa;                &lt;IDFileOutput>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDFileOutput&quot;/>&#xa;                &lt;/IDFileOutput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SDR&amp;quot;&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&#xa;                        &lt;ambito>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&#xa;                        &lt;/ambito>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/canaleRichiesta&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                &lt;lavorazione>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                &lt;/lavorazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/progressivoRichiestaFile&quot;>&#xa;                &lt;progressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/progressivoRichiestaFile&quot;/>&#xa;                &lt;/progressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/tipoRichiesta&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                &lt;codiceOrdineOLOTarget>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrd