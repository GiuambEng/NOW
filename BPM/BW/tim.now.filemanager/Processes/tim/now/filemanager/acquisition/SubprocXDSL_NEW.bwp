                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:ns63=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CallProcess2&quot;/>&#xa;    &lt;xsl:param name=&quot;DeterminaToken&quot;/>&#xa;    &lt;xsl:template name=&quot;ReferenteAltreLavorazioni&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente) or exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione))&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;$CallProcess2/tns2:ResponseCreate_token/tns2:ESITO='OK'&quot;>&#xa;                &lt;ns:ReferenteElement>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;progressivoReferente>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivoReferente>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                            &lt;tipoReferenteOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipoReferenteOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tipoReferenteOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEAPPUNTAMENTO&amp;quot;&quot;/>&#xa;                            &lt;/tipoReferenteOrdine>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:QualificaRef&quot;>&#xa;                                &lt;qualificaReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:QualificaRef&quot;/>&#xa;                                &lt;/qualificaReferente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Qualifica&quot;>&#xa;                                &lt;qualificaReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Qualifica&quot;/>&#xa;                                &lt;/qualificaReferente>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;>&#xa;                        &lt;cognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/cognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Nome)>0 or string-length($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:NomeReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Telefono)>0 or string-length($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:TelefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                            &lt;telefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                            &lt;/telefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Mobile)>0 or string-length($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:TelefonoMobileReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                            &lt;telefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallProcess2/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                            &lt;/telefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Email)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Email&quot;>&#xa;                            &lt;emailReferente>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Email&quot;/>&#xa;                            &lt;/emailReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;flag_Token>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/flag_Token>&#xa;                &lt;/ns:ReferenteElement>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($CallProcess2/tns2:ResponseCreate_token/tns2:ESITO='KO' or $DeterminaToken/ns63:TipoToken='NOTOKEN') and exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                        &lt;ns:ReferenteElement>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                                    &lt;tipoReferenteOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                                    &lt;/tipoReferenteOrdine>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tipoReferenteOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEAPPUNTAMENTO&amp;quot;&quot;/>&#xa;                                    &lt;/tipoReferenteOrdine>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Qualifica&quot;>&#xa;                                &lt;qualificaReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Qualifica&quot;/>&#xa;                                &lt;/qualificaReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Cognome&quot;>&#xa;                                &lt;cognomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Cognome&quot;/>&#xa;                                &lt;/cognomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Nome&quot;>&#xa;                                &lt;nomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Nome&quot;/>&#xa;                                &lt;/nomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Telefono&quot;>&#xa;                                &lt;telefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Telefono&quot;/>&#xa;                                &lt;/telefonoFissoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Mobile&quot;>&#xa;                                &lt;telefonoMobileReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Mobile&quot;/>&#xa;                                &lt;/telefonoMobileReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Email&quot;>&#xa;                                &lt;emailReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente/ns01:Email&quot;/>&#xa;                                &lt;/emailReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;flag_Token>&#xa;                                &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                            &lt;/flag_Token>&#xa;                        &lt;/ns:ReferenteElement>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;($CallProcess2/tns2:ResponseCreate_token/tns2:ESITO='KO' or $DeterminaToken/ns63:TipoToken='NOTOKEN') and exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento/ns01:Referente)&quot;>&#xa;                        &lt;ns:ReferenteElement>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                                    &lt;tipoReferenteOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                                    &lt;/tipoReferenteOrdine>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tipoReferenteOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEAPPUNTAMENTO&amp;quot;&quot;/>&#xa;                                    &lt;/tipoReferenteOrdine>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:QualificaRef&quot;>&#xa;                                &lt;qualificaReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:QualificaRef&quot;/>&#xa;                                &lt;/qualificaReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione/ns01:ReferenteDesospensione/ns01:CognomeReferente&quot;>&#xa;                                &lt;cognomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot