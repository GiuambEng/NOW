                <bpws:link
                    name="Log_EstrazioniIDOffertaToEstrazioneIDofferta" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListaIdOffertaToLog_ListIDOfferta" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log_ListIDOffertaToListaComuni" tibex:linkType="SUCCESS"/>
                <bpws:link name="ListaComuniToLog_EstrazioneDescrComune" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="Log_EstrazioneDescrComuneToEstrazioneDescrComune" tibex:linkType="SUCCESS"/>
