                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ATTassignToEmpty1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns1=&quot;http://www.example.org/RichiesteXDSLxBPM&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperRaggruppamento&quot;/>&#xa;    &lt;xsl:template name=&quot;ATTarray&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaMapper>&#xa;            &lt;xsl:for-each select=&quot;$MapperRaggruppamento/ns1:Richieste/ns1:RichiesteATT/ns:RichiestaElement&quot;>&#xa;                &lt;tns2:Richiesta>&#xa;                    &lt;xsl:copy-of select=&quot;./ancestor-or-self::*/namespace::node()&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;./@*&quot;/>&#xa;                    &lt;xsl:copy-of select=&quot;./node()&quot;/>&#xa;                &lt;/tns2:Richiesta>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:RichiestaMapper>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
