livery>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/DNOLOCollaudo&quot;>&#xa;                                    &lt;DNOLOCollaudo>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/DNOLOCollaudo&quot;/>&#xa;                                    &lt;/DNOLOCollaudo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/numeroVerdeOloCollaudo&quot;>&#xa;                                    &lt;numeroVerdeOloCollaudo>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/numeroVerdeOloCollaudo&quot;/>&#xa;                                    &lt;/numeroVerdeOloCollaudo>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/numeroVerdeOloPT&quot;>&#xa;                                    &lt;numeroVerdeOloPT>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/numeroVerdeOloPT&quot;/>&#xa;                                    &lt;/numeroVerdeOloPT>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/codiceTTM&quot;>&#xa;                                    &lt;codiceTTM>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/codiceTTM&quot;/>&#xa;                                    &lt;/codiceTTM>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/flagLavorazioneManuale&quot;>&#xa;                                    &lt;flagLavorazioneManuale>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/flagLavorazioneManuale&quot;/>&#xa;                                    &lt;/flagLavorazioneManuale>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/flagMonitoraggio&quot;>&#xa;                                    &lt;flagMonitoraggio>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/flagMonitoraggio&quot;/>&#xa;                                    &lt;/flagMonitoraggio>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/noteCliente&quot;>&#xa;                                    &lt;noteCliente>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/noteCliente&quot;/>&#xa;                                    &lt;/noteCliente>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/notedaSistema&quot;>&#xa;                                    &lt;notedaSistema>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/notedaSistema&quot;/>&#xa;                                    &lt;/notedaSistema>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/totaleOrdRilevPacchetto&quot;>&#xa;                                    &lt;totaleOrdRilevPacchetto>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/totaleOrdRilevPacchetto&quot;/>&#xa;                                    &lt;/totaleOrdRilevPacchetto>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/CLLI&quot;>&#xa;                                    &lt;CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/CLLI&quot;/>&#xa;                                    &lt;/CLLI>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;codificaOLONOW>&#xa;                                    &lt;xsl:value-of select=&quot;ordine/codificaOLONOW&quot;/>&#xa;                                &lt;/codificaOLONOW>&#xa;                                &lt;xsl:if test=&quot;ordine/codiceOrdineOLO&quo