:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceSessione1&quot;>&#xa;                &lt;codiceSessione>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceSessione1&quot;/>&#xa;                &lt;/codiceSessione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceSessione2&quot;>&#xa;                &lt;codiceSessione2>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceSessione2&quot;/>&#xa;                &lt;/codiceSessione2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;distinct-values(tokenize(tib:concat-sequence-format($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:NP/ns01:DN,&amp;quot;;&amp;quot;),&amp;quot;;&amp;quot;))[string-length(string(.))>0]&quot;>&#xa;                &lt;DNAggiuntivo>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/DNAggiuntivo>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:Note)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:Note&quot;>&#xa;                    &lt;noteAltreLavorazioni>&#xa;                        &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:Note&quot;/>&#xa;                    &lt;/noteAltreLavorazioni>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$TransitoryProperty=&amp;quot;Y&amp;quot;&quot;>&#xa;                &lt;transactionIDLocator>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/transactionIDLocator>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:FlagNumerazioniAggiuntive)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:FlagNumerazioniAggiuntive&quot;>&#xa;                    &lt;flagNumAggiuntive>&#xa;                        &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:FlagNumerazioniAggiuntive&quot;/>&#xa;                    &lt;/flagNumAggiuntive>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto&quot;>&#xa;                    &lt;codiceRifiutoDonating>&#xa;                        &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione/ns01:StatoRichiesta/ns01:KO/ns01:CodiceMotivoRifiuto&quot;/>&#xa;                    &lt;/codiceRifiutoDonating>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:NuovaDAC)>0 and not(tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:NuovaDAC))&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:NuovaDAC&quot;>&#xa;                        &lt;DACFile>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:NuovaDAC&quot;/>&#xa;                        &lt;/DACFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC)>0 and not(tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC))&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC&quot;>&#xa;                        &lt;DACFile>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/node()/ns01:DAC&quot;/>&#xa;                        &lt;/DACFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC)>0 and not(tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC))&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC&quot;>&#xa;                        &lt;DACFile>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:DAC&quot;/>&#xa;                        &lt;/DACFile>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:Attivazione274)&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE274&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneADSLRetail)&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONEOLO&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBEAsimm) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPSpecialProfile) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPBasePlus) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBESimm) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:VLAN)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:VLAN/ns01:TipoVariazione/ns01:VariazioneNumeroCondivisori)and ((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;'VARIAZIONENUMEROCONDIVISORI'&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0) and exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:VLAN/ns01:TipoVariazione/ns01:VariazioneBanda)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;'VARIAZIONEBANDA'&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0) and exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:VLAN/ns01:TipoVariazione/ns01:VariazioneKIT)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;'VARIAZIONETDKIT'&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0) and exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:VLAN/ns01:TipoVariazione/ns01:VariazioneCAR)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;'VARIAZIONECAR'&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Caratteristica)>0 and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Modulazione)) and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Flag_Ordine_Unico)>0) and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:ProfiloTecnicoLinea)>0) and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:DatiVC))) or (string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Caratteristica)>0 and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:ProfiloTecnicoLinea)>0) and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:DatiVC)))&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONECARATTERISTICA&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;not((string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Caratteristica)>0 and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Modulazione)) and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Flag_Ordine_Unico)>0) and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:ProfiloTecnicoLinea)>0) and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:DatiVC))) or (string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Caratteristica)>0 and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:ProfiloTecnicoLinea)>0) and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:DatiVC)))) and exists($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso[1])&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;RICONFIGURAZIONEVC&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:TipoVariazione/ns01:IncrementoDecrementoVC)  or exists($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:TipoVariazione/ns01:IncrementoDecrementoUserVlan)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;INCREMENTODECREMENTOVC&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:TipoVariazione/ns01:CambioSla)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CAMBIOSLA&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:NP/ns01:RoutingNumberRecipient)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:NP/ns01:RoutingNumberRecipient&quot;>&#xa;                    &lt;routingNumber>&#xa;                        &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:NP/ns01:RoutingNumberRecipient&quot;/>&#xa;                    &lt;/routingNumber>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($FlagOscuramento/Record[COD_AGESP='R1I-19-0175'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-19-0175']/FLAG_OSCURMENTO='1'&quot;/>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione) and exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO) and upper-case($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceSessione1)='CAMBIOTECNOLOGIA'&quot;>&#xa;                    &lt;cambioTecnologia>&#xa;                        &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                    &lt;/cambioTecnologia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Richiesta" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallLocatorALT-input"
                                    name="CallLocatorALT"
                                    outputVariable="CallLocatorALT"
                                    tibex:xpdlId="2ee9c531-371e-4ffb-a41e-53293237ff93"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperRichiestaToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallLocatorALTToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza="NOW"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorALTToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;CRMWS&quot; or ($CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;KO&quot; and ($CallLocatorALT/ns11:Risposta/ns11:RC=&quot;09&quot; or $CallLocatorALT/ns11:Risposta/ns11:RC=&quot;10&quot; or $CallLocatorALT/ns11:Risposta/ns11:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza="CRMWS" or ($CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza="KO" and ($CallLocatorALT/ns11:Risposta/ns11:RC="09" or $CallLocatorALT/ns11:Risposta/ns11:RC="10" or $CallLocatorALT/ns11:Risposta/ns11:RC="14"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorALTToGroupEnd2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLocatorALT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RichiestaLocalizzatore>&#xa;            &lt;tns1:Testata>&#xa;                &lt;tns1:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&#xa;                &lt;/tns1:Transaction_id>&#xa;                &lt;tns1:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:Transaction_date>&#xa;                &lt;tns1:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns1:Sistema_origine>&#xa;            &lt;/tns1:Testata>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;tns1:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:DataRichiesta>&#xa;                &lt;tns1:CodiceOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns1:CodiceOLO>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns1:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns1:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                    &lt;tns1:CodiceComune>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune