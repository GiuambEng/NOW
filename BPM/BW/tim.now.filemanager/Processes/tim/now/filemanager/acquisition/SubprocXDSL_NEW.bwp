                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ProgressiviRichiesta&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ProgrAlt&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery4&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery6&quot;/>&#xa;    &lt;xsl:param name=&quot;EstrazioneOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Token9&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;xsl:variable name=&quot;rich&quot; select=&quot;$NORMALarray/ns01:Richiesta[number($index)]&quot;/>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;IDFileInput>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/tns2:ID_FILE)&quot;/>&#xa;            &lt;/IDFileInput>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Cessazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDACRecipient)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDACDARECIPIENT&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RichiestaInterruzioneRecipient)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:EspletamentoADSLRetail)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;COMUNICAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:CancellazioneAccodamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RimodulazioneDataAppuntamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:RiscontroCodiceSessione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RISCONTROCODICESESSIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:AccettazioneOpereSpeciali)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Prequalifica)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PREQUALIFICA&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ProgrAlt/tns3:Progressivo[number($index)]&quot;>&#xa;                &lt;progressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$ProgrAlt/tns3:Progressivo[number($index)]&quot;/>&#xa;                &lt;/progressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione) or exists($rich/ns01:TipoRichiesta/ns01:Cessazione) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione)&quot;>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/node()/ns01:BitstreamATMAsimmetricoFlat/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:BitstreamATMAsimmetricoHL/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:BitstreamATMAsimmetricoLite/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:BitstreamGBEAsimmetricoFlat/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:EasyIPBasePlusFlat/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:EasyIPBasePlusLite/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:EasyIPSpecialProfileFlat/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:EasyIPSpecialProfileLite/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBEAsimm/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPBasePlus/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPSpecialProfile/ns01:IDENTIFICATIVO_RISORSA)>0 or&amp;#xD;&amp;#xA;string-length($rich/ns01:TipoRichiesta/node()/ns01:BitstreamATMSimmetricoHL/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:BitstreamATMSimmetricoFlat/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/node()/ns01:BitstreamGBESimmetricoFlat/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:IDENTIFICATIVO_RISORSA)>0 or string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBESimm/ns01:IDENTIFICATIVO_RISORSA)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/node()/node()/ns01:IDENTIFICATIVO_RISORSA&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/node()/node()/ns01:IDENTIFICATIVO_RISORSA&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM)>0&quot;>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns4:CodiciOlo/tns4:codes[tns4:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns4:CodiceOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceOlo&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineOlo)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/node()/node()/ns01:CodiceOrdineOlo&quot;>&#xa;                        &lt;codiceOrdineOLOTarget>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/node()/node()/ns01:CodiceOrdineOlo&quot;/>&#xa;                        &lt;/codiceOrdineOLOTarget>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:CancellazioneAccodamento/node()/ns01:ISP)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:CancellazioneAccodamento/node()/ns01:ISP&quot;>&#xa;                        &lt;codiceOrdineOLOTarget>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:CancellazioneAccodamento/node()/ns01:ISP&quot;/>&#xa;                        &lt;/codiceOrdineOLOTarget>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                &lt;c