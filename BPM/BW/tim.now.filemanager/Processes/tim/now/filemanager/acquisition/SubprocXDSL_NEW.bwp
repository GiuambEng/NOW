&lt;xsl:if test=&quot;ordine/DEC&quot;>&#xa;                                    &lt;DEC>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/DEC&quot;/>&#xa;                                    &lt;/DEC>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/DES&quot;>&#xa;                                    &lt;DES>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/DES&quot;/>&#xa;                                    &lt;/DES>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/ORA_DES&quot;>&#xa;                                    &lt;ORA_DES>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/ORA_DES&quot;/>&#xa;                                    &lt;/ORA_DES>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ordine/IDRisorsa&quot;>&#xa;                                    &lt;IDRisorsa>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/IDRisorsa&quot;/>&#xa;                                    &lt;/IDRisorsa>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;ordine/IDRichiestaOLO&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;tipologiaLavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;ordine/tipologiaLavorazione&quot;/>&#xa;                                &lt;/tipologiaLavorazione>&#xa;                                &lt;xsl:if test=&quot;ordine/tipologiaSottolav&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/tipologiaSottolav&quot;/>&#xa;                    