                                    </bpws:source>
                                    <bpws:source linkName="Invoke_ATT_ANN_locToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Invoke_ATT_ANN_loc/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;CRMWS&quot; or ($Invoke_ATT_ANN_loc/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;KO&quot; and ($Invoke_ATT_ANN_loc/ns11:Risposta/ns11:RC=&quot;09&quot; or $Invoke_ATT_ANN_loc/ns11:Risposta/ns11:RC=&quot;10&quot; or $Invoke_ATT_ANN_loc/ns11:Risposta/ns11:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Invoke_ATT_ANN_loc/ns11:Risposta/ns11:SistemaDiCompetenza="CRMWS" or ($Invoke_ATT_ANN_loc/ns11:Risposta/ns11:SistemaDiCompetenza="KO" and ($Invoke_ATT_ANN_loc/ns11:Risposta/ns11:RC="09" or $Invoke_ATT_ANN_loc/ns11:Risposta/ns11:RC="10" or $Invoke_ATT_ANN_loc/ns11:Risposta/ns11:RC="14"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Invoke_ATT_ANN_locToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_ATT_ANN_loc-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RichiestaLocalizzatore>&#xa;            &lt;tns1:Testata>&#xa;                &lt;tns1:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&#xa;                &lt;/tns1:Transaction_id>&#xa;                &lt;tns1:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:Transaction_date>&#xa;                &lt;tns1:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns1:Sistema_origine>&#xa;            &lt;/tns1:Testata>&#xa;            &lt;tns1:Richiesta>&#xa;                &lt;tns1:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:DataRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/codificaOLOAGCOM)>0&quot;>&#xa;                        &lt;tns1:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns1:CodiceOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns1:CodiceOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns1:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns1:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/ISTATComune)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                            &lt;tns1:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                            &lt;/tns1:CodiceComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length($Richiesta/offerta)>0&quot;>&#xa;                    &lt;tns1:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($Richiesta/offerta)&quot;/>&#xa;                    &lt;/tns1:Servizio>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/flagNaked&quot;>&#xa;                    &lt;tns1:FlagNaked>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/flagNaked&quot;/>&#xa;                    &lt;/tns1:FlagNaked>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                    &lt;tns1:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                    &lt;/tns1:Richiesta>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Ambito_XDSL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/tns1:Ambito_XDSL>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                    &lt;tns1:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                    &lt;/tns1:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;tns1:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/tns1:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating&quot;>&#xa;                            &lt;tns1:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating&quot;/>&#xa;                            &lt;/tns1:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                            &lt;tns1:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/tns1:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns1:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns1:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating2&quot;>&#xa;                        &lt;tns1:IdRisorsa2>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                        &lt;/tns1:IdRisorsa2>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/numeroTelefonico&quot;>&#xa;                    &lt;tns1:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/numeroTelefonico&quot;/>&#xa;                    &lt;/tns1:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Richiesta/DNAggiuntivo&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns1:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns1:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:DNAggiuntivi>&#xa;            &lt;/tns1:Richiesta>&#xa;        &lt;/tns1:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.CallLocator" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
