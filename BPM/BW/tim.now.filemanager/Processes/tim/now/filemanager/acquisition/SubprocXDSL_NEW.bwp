                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns4:InputString&gt;
            &lt;/ReplaceCharacterInput&gt;
        &lt;/tns2:ReplaceCharacterRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
