&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter" xmlns:tns4="http://www.tim.com/NOW/xsd/ReplaceCharacter" xmlns:tns3="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
