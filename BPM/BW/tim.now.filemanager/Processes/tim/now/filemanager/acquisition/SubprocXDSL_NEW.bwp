ATMSimmetricoHL) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/ns01:BitstreamATMSimmetricoFlat) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/ns01:BitstreamGBESimmetricoFlat)&quot;>&#xa;                                            &lt;ordine>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length(upper-case(local-name($rich/ns01:TipoRichiesta/ns01:Cessazione/*)))>0&quot;>&#xa;                                                        &lt;offertaCatalogo>&#xa;                                                            &lt;xsl:value-of select=&quot;upper-case(local-name($rich/ns01:TipoRichiesta/ns01:Cessazione/*))&quot;/>&#xa;                                                        &lt;/offertaCatalogo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione)&quot;>&#xa;                                                        &lt;offertaCatalogo>&#xa;                                                            &lt;xsl:value-of select=&quot;upper-case(local-name($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/*))&quot;/>&#xa;                                                        &lt;/offertaCatalogo>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm)&quot;>&#xa;                                                        &lt;offertaCatalogo>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                                                        &lt;/offertaCatalogo>&#xa;                            