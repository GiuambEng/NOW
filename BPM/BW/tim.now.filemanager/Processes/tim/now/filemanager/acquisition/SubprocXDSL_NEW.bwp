                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Richiesta"
                                    name="ArricchimentoAttivazione"
                                    outputVariable="Richiesta"
                                    tibex:xpdlId="2ba3b525-24d5-497a-b643-169df45a11fa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
