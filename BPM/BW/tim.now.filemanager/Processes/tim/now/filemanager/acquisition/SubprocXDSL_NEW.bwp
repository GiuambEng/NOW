l:value-of select=&quot;codiceOrdineTITarget&quot;/>&#xa;                    &lt;/codiceOrdineTITarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;codiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;dataInvioRichiesta&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;xsl:if test=&quot;IDAnagraficaCausale&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:value-of select=&quot;IDAnagraficaCausale&quot;/>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDCorrelazione&quot;>&#xa;                    &lt;IDCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;IDCorrelazione&quot;/>&#xa;                    &lt;/IDCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;totaleRichiestePacchetto&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;totaleRichiestePacchetto&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipoPacchetto&quot;>&#xa;                    &lt;tipoPacchetto>&#xa;                        &lt;xsl:value-of select=&quot;tipoPacchetto&quot;/>&#xa;                    &lt;/tipoPacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDPacchettoNOW&quot;>&#xa;                    &lt;IDPacchettoNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDPacchettoNOW&quot;/>&#xa;                    &lt;/IDPacchettoNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test