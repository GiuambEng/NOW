                                <bpws:sequence name="sequence3" tibex:group="while">
                                    <bpws:empty name="GroupInit3" tibex:group="groupInit"/>
                                    <bpws:while name="while3" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($ATTarray/tns:Richiesta[$index]/ordine/referente)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($ATTarray/tns:Richiesta[$index]/ordine/referente)]]></bpws:condition>
                                    <bpws:flow name="flow4">
