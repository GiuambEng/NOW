                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;tns3:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns3:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns3:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns3:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/offerta&quot;>&#xa;                    &lt;tns3:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/offerta&quot;/>&#xa;                    &lt;/tns3:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns3:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns3:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns3:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns3:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1][qualificaReferente='CF'])&quot;>&#xa;                        &lt;tns3:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns3:FlagReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns3:FlagReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:RequestVerificaRollout>&#xa;            &lt;tns3:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns3:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns3:Funzione>&#xa;                &lt;tns3:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATTarray/tns4:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns3:ChiaveRiferimento>&#xa;                &lt;tns3:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns3:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns3:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns3:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;>&#xa;                    &lt;tns3:N_Recap_Cliente>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;/>&#xa;                    &lt;/tns3:N_Recap_Cliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;>&#xa;                    &lt;tns3:N_Recap_Cliente_ALT>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;/>&#xa;                    &lt;/tns3:N_Recap_Cliente_ALT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;>&#xa;                    &lt;tns3:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;/>&#xa;                    &lt;/tns3:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;>&#xa;                    &lt;tns3:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;/>&#xa;                    &lt;/tns3:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:RequestCreate_token>&#xa;            &lt;tns3:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns3:ProcessIstance>&#xa;            &lt;tns3:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;            &lt;/tns3:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ATTarray/tns4:Richiesta[$index]/codiceSessione)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/codiceSessione&quot;>&#xa;                        &lt;tns3:NumeroLinea>&#xa;                            &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/codiceSessione&quot;/>&#xa;                        &lt;/tns3:NumeroLinea>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($ATTarray/tns4:Richiesta[$index]/codiceSessione2)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/codiceSessione2&quot;>&#xa;                        &lt;tns3:NumeroLinea>&#xa;                            &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/codiceSessione2&quot;/>&#xa;                        &lt;/tns3:NumeroLinea>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns4:Richiesta[$index]/offerta&quot;>&#xa;                &lt;tns3:OffertaBPM>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns4:Richiesta[$index]/offerta&quot;/>&#xa;                &lt;/tns3:OffertaBPM>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log2-input"
                                    name="Log2"
                                    tibex:xpdlId="81ad7b57-5ceb-4b99-99ec-724cc60e3eda" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign13ToLog2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log2ToGroupEnd3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Log2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(' Accumulo Token',tib:render-xml($Referente,true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
