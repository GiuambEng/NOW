                                               &lt;/operatore>&#xa;                                                &lt;lastUpdate>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/lastUpdate>&#xa;                                                &lt;xsl:variable name=&quot;RiconfigurazioneAccessoATMAsimm&quot; select=&quot;if (string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:ProfiloTecnicoLinea)>0 or string-length(string($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Modulazione))>0 or string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Flag_Ordine_Unico)>0 or (string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:CampoServizioIt)>0 and exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso))) then true() else false()&quot;/>&#xa;                                                &lt;xsl:variable name=&quot;BitstreamATMSimmetrico_ACCESSOATMSIM&quot; select=&quot;if (exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso) and ( string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:CampoServizioIt)>0 or&amp;#xD;&amp;#xA;string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:ProfiloTecnicoLinea)>0)&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;then true() &amp;#xD;&amp;#xA;else &amp;#xD;&amp;#xA;if (exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:CambioSla) and ( string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:Bitstream