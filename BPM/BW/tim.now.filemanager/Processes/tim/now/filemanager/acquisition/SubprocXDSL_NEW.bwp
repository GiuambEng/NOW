                                    <bpws:targets>
                                    <bpws:target linkName="ArricchimentoRichiestaATTToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallLocatorATTToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorATT/ns11:Risposta/ns11:SistemaDiCompetenza="NOW"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorATTToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;CRMWS&quot; or ($CallLocatorATT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;KO&quot; and ($CallLocatorATT/ns11:Risposta/ns11:RC=&quot;09&quot; or $CallLocatorATT/ns11:Risposta/ns11:RC=&quot;10&quot; or $CallLocatorATT/ns11:Risposta/ns11:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorATT/ns11:Risposta/ns11:SistemaDiCompetenza="CRMWS" or ($CallLocatorATT/ns11:Risposta/ns11:SistemaDiCompetenza="KO" and ($CallLocatorATT/ns11:Risposta/ns11:RC="09" or $CallLocatorATT/ns11:Risposta/ns11:RC="10" or $CallLocatorATT/ns11:Risposta/ns11:RC="14"))]]></bpws:transitionCondition>
                                    </bpws:source>
