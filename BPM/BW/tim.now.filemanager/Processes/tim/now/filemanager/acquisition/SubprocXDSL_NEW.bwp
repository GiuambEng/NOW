        <bpws:variable element="tns:CodiciOlo"
            name="EstrazioneOLO-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:CodiciOlo" name="EstrazioneOLO" sca-bpel:internal="true"/>
        <bpws:variable name="Variable" type="xsd:string"/>
        <bpws:variable name="FlagFittizio" type="xsd:string">
            <bpws:from>
                <bpws:literal>False</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns61:Request" name="Referente"/>
        <bpws:variable element="ns3:ActivityInput" name="Log16-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityInput" name="Log17-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityInput" name="Log18-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ActivityInput" name="Log21-input" sca-bpel:internal="true"/>
        <bpws:variable name="CodProgettoOrdWList"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/AnalyzeOloRequest/CodPrgtOrderWList" type="xsd:string"/>
        <bpws:variable element="ns31:Request" name="Token7-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns31:Response" name="Token7" sca-bpel:internal="true"/>
        <bpws:variable element="ns31:Request" name="Token8-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns31:Response" name="Token8" sca-bpel:internal="true"/>
        <bpws:variable element="ns31:Request" name="Token9-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns31:Response" name="Token9" sca-bpel:internal="true"/>
        <bpws:variable element="ns62:xmlString" name="ParseXml-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns01:Richiesta" name="ParseXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns01:Richiesta" name="RenderXml-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:xmlString" name="RenderXml" sca-bpel:internal="true"/>
        <bpws:variable element="ns62:xmlString" name="ParseXml1-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns01:Richiesta" name="ParseXml1" sca-bpel:internal="true"/>
        <bpws:variable element="ns01:Richiesta" name="RenderXml1-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:xmlString" name="RenderXml1" sca-bpel:internal="true"/>
        <bpws:variable element="ns01:Richiesta" name="RenderXml2-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:xmlString" name="RenderXml2" sca-bpel:internal="true"/>
        <bpws:variable element="ns01:Richiesta" name="RenderXml3-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:xmlString" name="RenderXml3" sca-bpel:internal="true"/>
        <bpws:variable element="ns63:Input" name="DeterminaToken-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns63:Output" name="DeterminaToken" sca-bpel:internal="true"/>
        <bpws:variable element="ns31:Request" name="CallProcess2-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns31:Response" name="CallProcess2" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperRaggruppamentoToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ATT-ANNArrayAssignToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperRaggruppamentoToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToATTassign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="ATTassignToEmpty1" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToEmpty1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Empty1ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="NormalAssignToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToLog" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="SQLDirectToATT_ANN" tibex:linkType="SUCCESS"/>
                <bpws:link name="SQLDirectToATT_ANN1" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToATT_ANN2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Assign1ToATT_ANN" tibex:linkType="SUCCESS"/>
                <bpws:link name="ATT_ANNToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="SortToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="ATT_ANNToWhile" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ATTToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="ALTToEnd" tibex:linkType="SUCCESS"/>
