                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper2-input"
                                    name="Mapper2"
                                    outputVariable="Mapper2"
                                    tibex:xpdlId="e8da21b5-3aec-45dd-b48a-eb977ef7e6f0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty4ToMapper2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper2ToAssign10">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Mapper2ToAssign11">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Mapper2/ns32:Referente)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($Mapper2/ns32:Referente)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Referenti/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Request>&#xa;            &lt;xsl:for-each select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/node()/node()/ns01:Referente/ns01:Progressivo[string-length(../ns01:Cognome)>0][1]&quot;>&#xa;                &lt;tns2:Referente>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;progressivoReferente>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(.)&quot;/>&#xa;                    &lt;/progressivoReferente>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;qualificaReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Qualifica&quot;/>&#xa;                    &lt;/qualificaReferente>&#xa;                    &lt;cognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Cognome&quot;/>&#xa;                    &lt;/cognomeReferente>&#xa;                    &lt;nomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Nome&quot;/>&#xa;                    &lt;/nomeReferente>&#xa;                    &lt;xsl:if test=&quot;../ns01:Telefono&quot;>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns01:Telefono&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;../ns01:Mobile&quot;>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns01:Mobile&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Referente>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Cessazione/node()/ns01:Referente/ns01:Progressivo[string-length(../ns01:Cognome)>0][1]&quot;>&#xa;                &lt;tns2:Referente>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;progressivoReferente>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(.)&quot;/>&#xa;                    &lt;/progressivoReferente>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;qualificaReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Qualifica&quot;/>&#xa;                    &lt;/qualificaReferente>&#xa;                    &lt;cognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Cognome&quot;/>&#xa;                    &lt;/cognomeReferente>&#xa;                    &lt;nomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Nome&quot;/>&#xa;                    &lt;/nomeReferente>&#xa;                    &lt;xsl:if test=&quot;../ns01:Telefono&quot;>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns01:Telefono&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;../ns01:Mobile&quot;>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns01:Mobile&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Referente>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:IncrementoDecrementoVC/ns01:Referente/ns01:Progressivo[string-length(../ns01:Cognome)>0]&quot;>&#xa;                &lt;tns2:Referente>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;progressivoReferente>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(.)&quot;/>&#xa;                    &lt;/progressivoReferente>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;qualificaReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Qualifica&quot;/>&#xa;                    &lt;/qualificaReferente>&#xa;                    &lt;cognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Cognome&quot;/>&#xa;                    &lt;/cognomeReferente>&#xa;                    &lt;nomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;../ns01:Nome&quot;/>&#xa;                    &lt;/nomeReferente>&#xa;                    &lt;xsl:if test=&quot;../ns01:Telefono&quot;>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns01:Telefono&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;../ns01:Mobile&quot;>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;../ns01:Mobile&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Referente>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:Referenti="http://www.tim.com/NOW/xsd/Referenti/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Referenti:Request" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:scope name="While2"
                                tibex:group="while" tibex:xpdlId="8c6e00a5-ecc6-4175-ad8e-7ab9b54347ec">
                                <bpws:targets>
                                    <bpws:target linkName="Assign11ToWhile2"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="While2ToEmpty17"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence5" tibex:group="while">
                                    <bpws:empty name="GroupInit5" tibex:group="groupInit"/>
                                    <bpws:while name="while5" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($Mapper2/ns32:Referente)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($Mapper2/ns32:Referente)]]></bpws:condition>
                                    <bpws:flow name="flow6">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart5ToToken5" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Assign9ToLog8" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Token5ToAssign9" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Log8ToGroupEnd3" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Token5ToLog9" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="Log9ToGroupEnd3" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Token5ToGroupEnd3" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="GroupStart5ToLog17" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Log17ToGroupEnd3" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart5"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="9b56e1ff-dc9e-44f0-9f4b-2460777978d0" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart5ToToken5">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart5ToLog17">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($Mapper2/ns32:Referente[$index1]/telefonoFissoReferente)=0 and string-length($Mapper2/ns32:Referente[$index1]/telefonoMobileReferente)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($Mapper2/ns32:Referente[$index1]/telefonoFissoReferente)=0 and string-length($Mapper2/ns32:Referente[$index1]/telefonoMobileReferente)=0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="Token5"/>
                                    <bpws:to variable="Token5"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:empty name="GroupEnd3"
                                    tibex:group="groupEnd" tibex:xpdlId="f3e45e00-7ea1-49c3-bd99-674c75aac184">
                                    <bpws:targets>
                                    <bpws:target linkName="Log8ToGroupEnd3"/>
                                    <bpws:target linkName="Log9ToGroupEnd3"/>
                                    <bpws:target linkName="Token5ToGroupEnd3"/>
                                    <bpws:target linkName="Log17ToGroupEnd3"/>
                                    </bpws:targets>
                                    </bpws:empty>
                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="Token5-input"
                                    name="Token5"
                                    outputVariable="Token5"
                                    tibex:xpdlId="05c13c9c-639c-4bc7-964c-6ef8231c6193"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart5ToToken5"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Token5ToAssign9">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="string-length($Token5/ns31:TOKENIZZAZIONE_RECAPITI)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($Token5/ns31:TOKENIZZAZIONE_RECAPITI)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="Token5ToLog9"
                                    tibex:faultDetailsVar="Token5" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Token5ToGroupEnd3">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Referenti/&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper2&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Request>&#xa;            &lt;tns5:RequestVerificaRollout>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM&quot;>&#xa;                            &lt;tns5:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns6:CodiciOlo/tns6:codes[tns6:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns6:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/tns5:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns5:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo&quot;>&#xa;                    &lt;tns5:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                    &lt;/tns5:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm)&quot;>&#xa;                                &lt;tns5:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamATMAsimm&amp;quot;&quot;/>&#xa;                                &lt;/tns5:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm)&quot;>&#xa;                                &lt;tns5:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamATMSimm&amp;quot;&quot;/>&#xa;                                &lt;/tns5:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBEAsimm)&quot;>&#xa;                                &lt;tns5:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamGBEAsimm&amp;quot;&quot;/>&#xa;                                &lt;/tns5:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBESimm)&quot;>&#xa;                                &lt;tns5:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamGBESimm&amp;quot;&quot;/>&#xa;                                &lt;/tns5:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPBasePlus)&quot;>&#xa;                                &lt;tns5:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EasyIPBasePlus&amp;quot;&quot;/>&#xa;                                &lt;/tns5:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPSpecialProfile)&quot;>&#xa;                                &lt;tns5:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EasyIPSpecialProfile&amp;quot;&quot;/>&#xa;                                &lt;/tns5:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns5:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                                &lt;/tns5:Offerta>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>