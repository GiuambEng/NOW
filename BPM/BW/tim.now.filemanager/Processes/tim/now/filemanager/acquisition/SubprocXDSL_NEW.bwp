                                  &lt;tipologiaSottolav>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE274&amp;quot;&quot;/>&#xa;                                                &lt;/tipologiaSottolav>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneADSLRetail)&quot;>&#xa;                                                &lt;tipologiaSottolav>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONEOLO&amp;quot;&quot;/>&#xa;                                                &lt;/tipologiaSottolav>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBEAsimm) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPSpecialProfile) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPBasePlus) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm) or exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBESimm)&quot;>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Caratteristica)>0 and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Modulazione)) and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns0