                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ATTarray"
                                    name="Assign16"
                                    outputVariable="ATTarray"
                                    tibex:xpdlId="6b340f97-896c-429b-a967-fef4b3542cd5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXmlToAssign16"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign16ToRendezvous"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token7&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml&quot;/>&#xa;    &lt;xsl:template name=&quot;ATTarray&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:RichiestaMapper>&#xa;            &lt;xsl:for-each select=&quot;$ATTarray/tns2:Richiesta&quot;>&#xa;                &lt;xsl:variable name=&quot;position&quot; select=&quot;position()&quot;/>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$position=$index&quot;>&#xa;                        &lt;tns2:Richiesta>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;statoRichiestaNOW>&#xa;                                &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                            &lt;/statoRichiestaNOW>&#xa;                            &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                                &lt;statoRichiestaPrecedNOW>&#xa;                                    &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                                &lt;/statoRichiestaPrecedNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                                &lt;statoRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                                &lt;/statoRichiestaOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                                &lt;statoRichiestaPrecedOLO>&#xa;                                    &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                                &lt;/statoRichiestaPrecedOLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                                &lt;sottostatoLavorManuale>&#xa;                                    &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                                &lt;/sottostatoLavorManuale>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                                &lt;IDFileInput>&#xa;                                    &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                                &lt;/IDFileInput>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                                &lt;IDFileOutput>&#xa;                                    &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                                &lt;/IDFileOutput>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ambito&quot;>&#xa;                                &lt;ambito>&#xa;                                    &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                                &lt;/ambito>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;canaleRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&#xa;                            &lt;/canaleRichiesta>&#xa;                            &lt;xsl:if test=&quot;lavorazione&quot;>&#xa;                                &lt;lavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;lavorazione&quot;/>&#xa;                                &lt;/lavorazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&#xa;                                &lt;progressivoRichiestaFile>&#xa;                                    &lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&#xa;                                &lt;/progressivoRichiestaFile>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;strutturaRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&#xa;                            &lt;/strutturaRichiesta>&#xa;                            &lt;tipoRichiesta>&#xa;                                &lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&#xa;                            &lt;/tipoRichiesta>&#xa;                            &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;codificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;   