node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:CF&quot;/>&#xa;                                                        &lt;/CF>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:PIVA)>0&quot;>&#xa;                                                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:PIVA&quot;>&#xa;                                                        &lt;PIVA>&#xa;                                                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:PIVA&quot;/>&#xa;                                                        &lt;/PIVA>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:CodiceDelivery)>0&quot;>&#xa;                                                        &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:CodiceDelivery&quot;>&#xa;                                                            &lt;codiceDelivery>&#xa;                                                                &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/node()/ns01:Accesso/node()/ns01:CodiceDelivery&quot;/>&#xa;                                                            &lt;/codiceDelivery>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:CodiceDelivery[1])>0&quot;>&#xa;                                                        &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:CodiceDelivery&quot;>&#xa;                                                            &lt;codiceDelivery>&#xa;                                                                &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:CodiceDelivery&quot;/>&#xa;                                                            &lt;/codiceDelivery>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;matches($rich/ns01:Testata/ns01:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                                                        &lt;noteCliente>&#xa;                                                            &lt;xsl:value-of select=&quot;translate($rich/ns01:Testata/ns01:Note, '0123456789', '         ')&quot;/>&#xa;                                                        &lt;/noteCliente>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:Note&quot;>&#xa;                                                            &lt;noteCliente>&#xa;                                                                &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:Note&quot;/>&#xa;                                                            &lt;/noteCliente>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;codificaOLONOW>&#xa;                                                    &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                                                &lt;/codificaOLONOW>&#xa;                                                &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                                                    &lt;codiceOrdineOLO>&#xa;                                                        &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                                                    &lt;/codiceOrdineOLO>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                                                    &lt;codiceOrdineOLOPadre>&#xa;                                                        &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceOrdineOloPadre&quot;/>&#xa;                                                    &lt;/codiceOrdineOLOPadre>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                                                    &lt;codiceProgetto>&#xa;                                          