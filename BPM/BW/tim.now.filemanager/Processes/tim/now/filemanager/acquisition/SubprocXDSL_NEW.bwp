                    &lt;/tns1:Richiesta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                            &lt;tns1:Richiesta>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                            &lt;/tns1:Richiesta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:Ambito_XDSL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/tns1:Ambito_XDSL>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                    &lt;tns1:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                    &lt;/tns1:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;tns1:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/tns1:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating&quot;>&#xa;                            &lt;tns1:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating&quot;/>&#xa;                            &lt;/tns1:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/IDR