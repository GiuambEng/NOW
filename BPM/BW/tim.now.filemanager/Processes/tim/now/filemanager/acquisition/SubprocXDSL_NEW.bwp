)/ns01:DatiSede[string-length(tib:concat-sequence(*))>0]&quot;>&#xa;                                                    &lt;sede>&#xa;                                                        &lt;IDRichiestaOLO>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                        &lt;/IDRichiestaOLO>&#xa;                                                        &lt;IDSede>&#xa;                                                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                                        &lt;/IDSede>&#xa;                                                        &lt;xsl:if test=&quot;ns01:ParticellaToponomastica&quot;>&#xa;                                                            &lt;particellaToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:ParticellaToponomastica&quot;/>&#xa;                                                            &lt;/particellaToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:Via&quot;>&#xa;                                                            &lt;via>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:Via&quot;/>&#xa;                                                            &lt;/via>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:Civico&quot;>&#xa;                                                            &lt;civico>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:Civico&quot;/>&#xa;                                                            &lt;/civico>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:Localita&quot;>&#xa;                                                            &lt;localita>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:Localita&quot;/>&#xa;                                                            &lt;/localita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:CAP&quot;>&#xa;                                                            &lt;CAP>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:CAP&quot;/>&#xa;                                                            &lt;/CAP>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:Complesso&quot;>&#xa;                                                            &lt;complesso>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:Complesso&quot;/>&#xa;                                                            &lt;/complesso>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:Interno&quot;>&#xa;                                                            &lt;interno>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:Interno&quot;/>&#xa;                                                            &lt;/interno>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:Scala&quot;>&#xa;                                                            &lt;scala>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:Scala&quot;/>&#xa;                                                            &lt;/scala>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;ns01:Piano&quot;>&#xa;                                                            &lt;piano>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:Piano&quot;/>&#xa;                                                            &lt;/piano>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;string-length(ns01:CodiceComune[1])>5&quot;>&#xa;                                                                &lt;codiceISTATComune>&#xa;                                                                    &lt;xsl:value-of select=&quot;substring(ns01:CodiceComune[1],string-length(ns01:CodiceComune[1])-5,6)&quot;/>&#xa;                                                                &lt;/codiceISTATComune>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:when test=&quot;string-length(ns01:CodiceComune[1])>0 and string-length(ns01:CodiceComune[1])&amp;lt;=5&quot;>&#xa;                                                                &lt;xsl:if test=&quot;ns01:CodiceComune&quot;>&#xa;                                                                    &lt;codiceISTATComune>&#xa;                                                                        &lt;xsl:value-of select=&quot;ns01:CodiceComune&quot;/>&#xa;                                                                    &lt;/codiceISTATComune>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:when>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                        &lt;xsl:if test=&quot;ns01:CodiceIndirizzo&quot;>&#xa;                                                            &lt;codiceToponomastica>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:CodiceIndirizzo&quot;/>&#xa;                                                            &lt;/codiceToponomastica>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;tipologiaSede>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SEDECLIENTE&amp;quot;&quot;/>&#xa;                                                        &lt;/tipologiaSede>&#xa;                                                        &lt;operatore>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                                        &lt;/operatore>&#xa;                                                        &lt;xsl:if test=&quot;ns01:CodiceComune&quot;>&#xa;                                                            &lt;CODICECOMUNEINPUT>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:CodiceComune&quot;/>&#xa;                                                            &lt;/CODICECOMUNEINPUT>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/sede>&#xa;                                                &lt;/xsl:for-each>&#xa;                                                &lt;xsl:for-each select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:Referente/ns01:Progressivo[string-length(../ns01:Cognome)>0]&quot;>&#xa;                                                    &lt;referente>&#xa;                                                        &lt;IDRichiestaOLO>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                        &lt;/IDRichiestaOLO>&#xa;                                                        &lt;created>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/created>&#xa;                                                        &lt;lastUpdate>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/lastUpdate>&#xa;                                                        &lt;operatore>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                                        &lt;/operatore>&#xa;                                                        &lt;progressivoReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;xsd:int(.)&quot;/>&#xa;                                                        &lt;/progressivoReferente>&#xa;                                                        &lt;tipoReferenteOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&#xa;                                                        &lt;/tipoReferenteOrdine>&#xa;                                                        &lt;qualificaReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;../ns01:Qualifica[1]&quot;/>&#xa;                                                        &lt;/qualificaReferente>&#xa;                                                        &lt;cognomeReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;../ns01:Cognome&quot;/>&#xa;                                                        &lt;/cognomeReferente>&#xa;                                                        &lt;nomeReferente>&#xa;                                                            &lt;xsl:value-of select=&quot;../ns01:Nome[1]&quot;/>&#xa;                                                        &lt;/nomeReferente>&#xa;                                                        &lt;xsl:if test=&quot;../ns01:Telefono&quot;>&#xa;                                                            &lt;telefonoFissoReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;../ns01:Telefono&quot;/>&#xa;                                                            &lt;/telefonoFissoReferente>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;../ns01:Mobile&quot;>&#xa;                                                            &lt;telefonoMobileReferente>&#xa;                                                                &lt;xsl:value-of select=&quot;../ns01:Mobile&quot;/>&#xa;                                                            &lt;/telefonoMobileReferente>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists(../../../../../ns01:BitstreamATMAsimmetricoFlat) or exists(../../../../../ns01:BitstreamATMAsimmetricoHL) or exists(../../../../../ns01:BitstreamATMAsimmetricoLite) or exists(../../../../../ns01:BitstreamATMSimmetricoHL) or exists(../../../../../ns01:BitstreamATMSimmetricoFlat) or exists(../../../../../ns01:BitstreamGBEAsimmetricoFlat) or exists(../../../../../ns01:BitstreamGBESimmetricoFlat) or exists(../../../../../ns01:EasyIPBasePlusFlat) or exists(../../../../../ns01:EasyIPBasePlusLite) or exists(../../../../../ns01:EasyIPSpecialProfileFlat) or exists(../../../../../ns01:EasyIPSpecialProfileLite)&quot;>&#xa;                                                                &lt;xsl:if test=&quot;../ns01:Email&quot;>&#xa;                                                                    &lt;emailReferente>&#xa;                                                                        &lt;xsl:value-of select=&quot;../ns01:Email&quot;/>&#xa;                                                                    &lt;/emailReferente>&#xa;                                                                &lt;/xsl:if>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise/>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/referente>&#xa;                                                &lt;/xsl:for-each>&#xa;                                                &lt;xsl:if test=&quot;string-length($rich/ns01:Testata/ns01:CodiceProgetto)>0 and string-length($rich/ns01:Testata/ns01:ReferentiOAOProgettiSpeciali)>0 and &amp;#xD;&amp;#xA;(count($FlagOscuramento/Record[COD_AGESP='R1F-20-0236'])=0 or $FlagOscuramento/Record[COD_AGESP='R1F-20-0236']/FLAG_OSCURMENTO='0')&quot;>&#xa;                                                    &lt;referente>&#xa;                                                        &lt;IDRichiestaOLO>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                        &lt;/IDRichiestaOLO>&#xa;                                                        &lt;created>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/created>&#xa;                                                        &lt;lastUpdate>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/lastUpdate>&#xa;                                                        &lt;operatore>&#xa;                                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                                        &lt;/operatore>&#xa;                                                        &lt;tipoReferenteOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                                        &lt;/tipoReferenteOrdine>&#xa;                                                        &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;>&#xa;                                                            &lt;refOAOProgettiSpeciali>&#xa;                                                                &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                                                            &lt;/refOAOProgettiSpeciali>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/referente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;exists($rich/ns01:Testata[string-length(ns01:CodiceProgetto)>0 and string-length(ns01:ReferentiOAOProgettiSpeciali)>0 and &amp;#xD;&amp;#xA;(count($FlagOscuramento/Record[COD_AGESP='R1F-20-0236'])=0 or $FlagOscuramento/Record[COD_AGESP='R1F-20-0236']/FLAG_OSCURMENTO='0')])&quot;>&#xa;                                                    &lt;referente>&#xa;                                                        &lt;IDRichiestaOLO>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                                        &lt;/IDRichiestaOLO>&#xa;                                                        &lt;created>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/created>&#xa;                                                        &lt;lastUpdate>&#xa;                                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                        &lt;/lastUpdate>&#xa;                                                        &lt;operatore>&#xa;                                                            &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                                                        &lt;/operatore>&#xa;                                                        &lt;tipoReferenteOrdine>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEOAOPROGETTISPECIALI&amp;quot;&quot;/>&#xa;                                                        &lt;/tipoReferenteOrdine>&#xa;                                                        &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;>&#xa;                                                            &lt;refOAOProgettiSpeciali>&#xa;                                                                &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                                                            &lt;/refOAOProgettiSpeciali>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/referente>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;tipologiaAccesso>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;DATI&amp;quot;&quot;/>&#xa;                                                &lt;/tipologiaAccesso>&#xa;                                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:CodiceQualita&quot;>&#xa;                                                    &lt;tipologiaQualita>&#xa;                                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:CodiceQualita&quot;/>&#xa;                                                    &lt;/tipologiaQualita>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;offerta>&#xa;                                                    &lt;xsl:value-of select=&quot;upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*))&quot;/>&#xa;                                                &lt;/offerta>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:SlaAssurance)>0&quot;>&#xa;                                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:SlaAssurance&quot;>&#xa;                                                            &lt;codiceSLAAssurance>&#xa;                                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:SlaAssurance&quot;/>&#xa;                                                            &lt;/codiceSLAAssurance>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*)),&amp;quot;EASYIP&amp;quot;)&quot;>&#xa;                                                        &lt;codiceSLAAssurance>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                        &lt;/codiceSLAAssurance>&#xa;                                                    &lt;/xsl:when>&#xa;                                                &lt;/xsl:choose>&#xa;                                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:NumeroLinea&quot;>&#xa;                                                    &lt;numeroTelefonico>&#xa;                                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:NumeroLinea&quot;/>&#xa;                                                    &lt;/numeroTelefonico>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;exists(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*)&quot;>&#xa;                                                        &lt;tipologiaLinea>&#xa;                                                            &lt;xsl:value-of select=&quot;if(contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*)),'POTS')) then 'POTS' else&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;if(contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*)),'ISDN')) then 'ISDN' else &amp;#xD;&amp;#xA; upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*))&amp;#xD;&amp;#xA; )&quot;/>&#xa;                                                        &lt;/tipologiaLinea>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/ordine>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])>5&quot;>&#xa;                                                &lt;ISTATComune>&#xa;                                                    &lt;xsl:value-of select=&quot;substring(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1],string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])-5,6)&quot;/>&#xa;                                                &lt;/ISTATComune>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])>0 and string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])&amp;lt;=5&quot;>&#xa;                                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune&quot;>&#xa;                                                    &lt;ISTATComune>&#xa;                                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune&quot;/>&#xa;                                                    &lt;/ISTATComune>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:Localita&quot;>&#xa;                                            &lt;localita>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:Localita&quot;/>&#xa;                                            &lt;/localita>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBEAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBESimmetricoFlat)&quot;>&#xa;                                                &lt;offerta>&#xa;                                                    &lt;xsl:value-of select=&quot;upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*))&quot;/>&#xa;                                                &lt;/offerta>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;(count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0&quot;>&#xa;                                                        &lt;offerta>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;VLAN&amp;quot;&quot;/>&#xa;                                                        &lt;/offerta>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise>&#xa;                                                        &lt;offerta>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;SERVIZIONONINAMBITO&amp;quot;&quot;/>&#xa;                                                        &lt;/offerta>&#xa;                                                    &lt;/xsl:otherwise>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*/ns01:Accesso/*)),&amp;quot;NONFONIA&amp;quot;)&quot;>&#xa;                                                &lt;flagNaked>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                                                &lt;/flagNaked>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;flagNaked>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                                &lt;/flagNaked>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;IDRichiestaLocalizzatore>&#xa;                                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                        &lt;/IDRichiestaLocalizzatore>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:TestMode&quot;>&#xa;                                            &lt;testMode>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:TestMode&quot;/>&#xa;                                            &lt;/testMode>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DAD)>0&quot;>&#xa;                                            &lt;DAD>&#xa;                                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,ns