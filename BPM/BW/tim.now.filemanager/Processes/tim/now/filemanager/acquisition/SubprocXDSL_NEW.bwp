                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token9&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferenteAltreLavorazioni&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml3-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:Richiesta>&#xa;            &lt;ns0:Testata>&#xa;                &lt;ns0:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                &lt;/ns0:CodiceOlo>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                    &lt;ns0:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOlo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                    &lt;ns0:CodiceOrdineOloPadre>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOloPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                    &lt;ns0:CodiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                    &lt;/ns0:CodiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;matches($NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                        &lt;ns0:Note>&#xa;                            &lt;xsl:value-of select=&quot;translate($NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&#xa;                        &lt;/ns0:Note>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:Note&quot;>&#xa;                            &lt;ns0:Note>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:Note&quot;/>&#xa;                            &lt;/ns0:Note>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:TestMode&quot;>&#xa;                    &lt;ns0:TestMode>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:TestMode&quot;/>&#xa;                    &lt;/ns0:TestMode>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;>&#xa;                    &lt;ns0:ReferentiOAOProgettiSpeciali>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                    &lt;/ns0:ReferentiOAOProgettiSpeciali>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns0:Testata>&#xa;            &lt;ns0:TipoRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione)&quot;>&#xa;                        &lt;ns0:Comunicazione>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RiscontroCodiceSessione&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:EspletamentoADSLRetail)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:EspletamentoADSLRetail&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:CancellazioneAccodamento&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaInterruzioneRecipient)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RichiestaInterruzioneRecipient&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDACRecipient)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDACRecipient&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento)&quot;>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:Annullamento&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento)&quot;>&#xa;                                    &lt;ns0:RimodulazioneDataAppuntamento>&#xa;                                        &lt;ns0:CodiceOrdineRiferimentoTI>&#xa;                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:CodiceOrdineRiferimentoTI&quot;/>&#xa;                                        &lt;/ns0:CodiceOrdineRiferimentoTI>&#xa;                                        &lt;ns0:DataAppuntamento>&#xa;                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:DataAppuntamento&quot;/>&#xa;                                        &lt;/ns0:DataAppuntamento>&#xa;                                        &lt;ns0:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:FasciaOraria&quot;/>&#xa;                                        &lt;/ns0:FasciaOraria>&#xa;                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Note&quot;>&#xa;                                            &lt;ns0:Note>&#xa;                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:RimodulazioneDataAppuntamento/ns0:Note&quot;/>&#xa;                                            &lt;/ns0:Note>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;ns0:Referente>&#xa;                                            &lt;ns0:Qualifica>&#xa;                                                &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/qualificaReferente&quot;/>&#xa;                                            &lt;/ns0:Qualifica>&#xa;                                            &lt;ns0:Nome>&#xa;                                                &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/nomeReferente&quot;/>&#xa;                                            &lt;/ns0:Nome>&#xa;                                            &lt;ns0:Cognome>&#xa;                                                &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/cognomeReferente&quot;/>&#xa;                                            &lt;/ns0:Cognome>&#xa;                                            &lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/telefonoFissoReferente&quot;>&#xa;                                                &lt;ns0:Telefono>&#xa;                                                    &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/telefonoFissoReferente&quot;/>&#xa;                                                &lt;/ns0:Telefono>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/telefonoMobileReferente&quot;>&#xa;                                                &lt;ns0:Mobile>&#xa;                                                    &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/telefonoMobileReferente&quot;/>&#xa;                                                &lt;/ns0:Mobile>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/emailReferente&quot;>&#xa;                                                &lt;ns0:Email>&#xa;                                                    &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/emailReferente&quot;/>&#xa;                                                &lt;/ns0:Email>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns0:Referente>&#xa;                                    &lt;/ns0:RimodulazioneDataAppuntamento>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione)&quot;>&#xa;                                    &lt;ns0:InterruzioneSospensione>&#xa;                                        &lt;ns0:CodiceOrdineRiferimentoTI>&#xa;                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:CodiceOrdineRiferimentoTI&quot;/>&#xa;                                        &lt;/ns0:CodiceOrdineRiferimentoTI>&#xa;                                        &lt;ns0:DataAppuntamentoDesiderata>&#xa;                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:DataAppuntamentoDesiderata&quot;/>&#xa;                                        &lt;/ns0:DataAppuntamentoDesiderata>&#xa;                                        &lt;ns0:FasciaOraria>&#xa;                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:FasciaOraria&quot;/>&#xa;                                        &lt;/ns0:FasciaOraria>&#xa;                                        &lt;ns0:ReferenteDesospensione>&#xa;                                            &lt;ns0:QualificaRef>&#xa;                                                &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/qualificaReferente&quot;/>&#xa;                                            &lt;/ns0:QualificaRef>&#xa;                                            &lt;ns0:CognomeReferente>&#xa;                                                &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/cognomeReferente&quot;/>&#xa;                                            &lt;/ns0:CognomeReferente>&#xa;                                            &lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/nomeReferente&quot;>&#xa;                                                &lt;ns0:NomeReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/nomeReferente&quot;/>&#xa;                                                &lt;/ns0:NomeReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/telefonoFissoReferente&quot;>&#xa;                                                &lt;ns0:TelefonoFissoReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/telefonoFissoReferente&quot;/>&#xa;                                                &lt;/ns0:TelefonoFissoReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/telefonoMobileReferente&quot;>&#xa;                                                &lt;ns0:TelefonoMobileReferente>&#xa;                                                    &lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/telefonoMobileReferente&quot;/>&#xa;                                                &lt;/ns0:TelefonoMobileReferente>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/ns0:ReferenteDesospensione>&#xa;                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:Note&quot;>&#xa;                                            &lt;ns0:Note>&#xa;                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:Note&quot;/>&#xa;                                            &lt;/ns0:Note>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns0:InterruzioneSospensione>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:AccettazioneOpereSpeciali&quot;/>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns0:Comunicazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Variazione)&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Variazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Cessazione)&quot;>&#xa;                        &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Cessazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione)&quot;>&#xa;                        &lt;ns0:Migrazione>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO)&quot;>&#xa;                                    &lt;ns0:MigrazioneOLO>&#xa;                                        &lt;ns0:Servizio>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta[$index]//ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat)&quot;>&#xa;                                                    &lt;ns0:BitstreamATMAsimmetricoFlat>&#xa;                                                        &lt;ns0:Accesso>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;exists($NORMALarray/ns0:Richiesta/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS)&quot;>&#xa;                                                                    &lt;ns0:LineaPOTS>&#xa;                                                                        &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DatiSede&quot;/>&#xa;                                                                        &lt;ns0:ClienteFinale>&#xa;                                                                            &lt;ns0:CognomeRagSoc>&#xa;                                                                                &lt;xsl:value-of select=&quot;$Token9/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                                                                            &lt;/ns0:CognomeRagSoc>&#xa;                                                                            &lt;xsl:if test=&quot;$Token9/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                                                                                &lt;ns0:Nome>&#xa;                                                                                    &lt;xsl:value-of select=&quot;$Token9/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                                                                                &lt;/ns0:Nome>&#xa;                                                                            &lt;/xsl:if>&#xa;                                                                            &lt;xsl:choose>&#xa;                                                                                &lt;xsl:when test=&quot;string-length($Token9/tns2:ResponseCreate_token/tns2:CodiceFiscale)>0&quot;>&#xa;                                                                                    &lt;ns0:CF>&#xa;                                                                                        &lt;xsl:value-of select=&quot;$Token9/tns2:ResponseCreate_token/tns2:CodiceFiscale&quot;/>&#xa;                                                                                    &lt;/ns0:CF>&#xa;                                                                                &lt;/xsl:when>&#xa;                                                                                &lt;xsl:otherwise>&#xa;                                                                                    &lt;ns0:PIVA>&#xa;                                                                                        &lt;xsl:value-of select=&quot;$Token9/tns2:ResponseCreate_token/tns2:PIVA&quot;/>&#xa;                                                                                    &lt;/ns0:PIVA>&#xa;                                                                                &lt;/xsl:otherwise>&#xa;                                                                            &lt;/xsl:choose>&#xa;                                                                        &lt;/ns0:ClienteFinale>&#xa;                                                                        &lt;xsl:copy-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Modem&quot;/>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaProvisioning&quot;>&#xa;                                                                            &lt;ns0:SlaProvisioning>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaProvisioning&quot;/>&#xa;                                                                            &lt;/ns0:SlaProvisioning>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;ns0:SlaAssurance>&#xa;                                                                            &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaAssurance&quot;/>&#xa;                                                                        &lt;/ns0:SlaAssurance>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceQualita&quot;>&#xa;                                                                            &lt;ns0:CodiceQualita>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceQualita&quot;/>&#xa;                                                                            &lt;/ns0:CodiceQualita>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceDelivery&quot;>&#xa;                                                                            &lt;ns0:CodiceDelivery>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceDelivery&quot;/>&#xa;                                                                            &lt;/ns0:CodiceDelivery>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DAD&quot;>&#xa;                                                                            &lt;ns0:DAD>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DAD&quot;/>&#xa;                                                                            &lt;/ns0:DAD>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:FasciaOraria&quot;>&#xa;                                                                            &lt;ns0:FasciaOraria>&#xa;                                                                                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:FasciaOraria&quot;/>&#xa;                                                                            &lt;/ns0:FasciaOraria>&#xa;                                                                        &lt;/xsl:if>&#xa;                                                                        &lt;xsl:if test=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Migrazione/ns0:MigrazioneOLO/ns0:Servizio/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CampoServizioIt&quot;>&#xa;                                                                      