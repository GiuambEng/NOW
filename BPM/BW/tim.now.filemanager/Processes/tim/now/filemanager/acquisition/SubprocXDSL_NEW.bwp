                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper4-input"
                                    name="Mapper4"
                                    outputVariable="Mapper4"
                                    tibex:xpdlId="97c5106a-3adf-4aa4-91bc-a320a20fc87b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty9ToMapper4"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper4ToLog10"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReferenteXML/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Referente>&#xa;            &lt;xsl:for-each select=&quot;$ATTarray/tns2:Richiesta[$index]/ordine/referente[qualificaReferente!='CF' and tipoReferenteOrdine!='REFERENTEONFIELD']&quot;>&#xa;                &lt;tns4:Referente>&#xa;                    &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                        &lt;tns4:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                        &lt;/tns4:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                        &lt;tns4:Qualifica>&#xa;                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                        &lt;/tns4:Qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;nomeReferente&quot;>&#xa;                        &lt;tns4:Nome>&#xa;                            &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                        &lt;/tns4:Nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;cognomeReferente&quot;>&#xa;                        &lt;tns4:Cognome>&#xa;                            &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                        &lt;/tns4:Cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                        &lt;tns4:Telefono>&#xa;                            &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns4:Telefono>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                        &lt;tns4:Mobile>&#xa;                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns4:Mobile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                        &lt;tns4:Email>&#xa;                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                        &lt;/tns4:Email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns4:Referente>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$Referente/tns3:Request[string-length(tns3:Esito)>0]&quot;>&#xa;                &lt;tns4:Referente>&#xa;                    &lt;xsl:if test=&quot;tns3:Referente[1]/progressivoReferente&quot;>&#xa;                        &lt;tns4:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns3:Referente[1]/progressivoReferente&quot;/>&#xa;                        &lt;/tns4:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns3:Referente[1]/qualificaReferente&quot;>&#xa;                        &lt;tns4:Qualifica>&#xa;                            &lt;xsl:value-of select=&quot;tns3:Referente[1]/qualificaReferente&quot;/>&#xa;                        &lt;/tns4:Qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns3:Referente[1]/nomeReferente&quot;>&#xa;                        &lt;tns4:Nome>&#xa;                            &lt;xsl:value-of sel