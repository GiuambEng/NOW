                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token9-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;tns3:RequestVerificaRollout>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns5:CodiciOlo/tns5:codes[tns5:CodiceOLO=$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo]/tns5:CodiceOLOAGCOM)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns5:CodiciOlo/tns5:codes[tns5:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns5:CodiceOLOAGCOM&quot;>&#xa;                            &lt;tns3:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns5:CodiciOlo/tns5:codes[tns5:CodiceOLO=$NORMALarray/ns01:Richiesta/ns01:Testata/ns01:CodiceOlo]/tns5:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/tns3:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns3:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo&quot;>&#xa;                    &lt;tns3:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                    &lt;/tns3:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamATMAsimm&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamATMSimm&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBEAsimm)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamGBEAsimm&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBESimm)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BitstreamGBESimm&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPBasePlus)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EasyIPBasePlus&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPSpecialProfile)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;EasyIPSpecialProfile&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Cessazione)&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMAsimmetricoFlat)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMAsimmetricoHL)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOHL&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMAsimmetricoLite)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMATMASIMMETRICOLITE&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamGBEAsimmetricoFlat)&quot;>&#xa;                                &lt;tns3:Offerta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;/>&#xa;                                &lt;/tns3:Offerta>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiest