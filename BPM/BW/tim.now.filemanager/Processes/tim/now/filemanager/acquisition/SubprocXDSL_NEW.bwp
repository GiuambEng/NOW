                                   &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:CodiceQualita&quot;>&#xa;                                            &lt;tipologiaQualita>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:CodiceQualita&quot;/>&#xa;                                            &lt;/tipologiaQualita>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;offerta>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*))&quot;/>&#xa;                                        &lt;/offerta>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:SlaAssurance)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:SlaAssurance&quot;>&#xa;                                                    &lt;codiceSLAAssurance>&#xa;                                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:SlaAssurance&quot;/>&#xa;                                                    &lt;/codiceSLAAssurance>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:when test=&quot;contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*)),&amp;quot;EASYIP&amp;quot;)&quot;>&#xa;                                                &lt;codiceSLAAssurance>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;                                                &lt;/codiceSLAAssurance>&#xa;                                            &lt;/xsl:when>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:NumeroLinea&quot;>&#xa;                                            &lt;numeroTelefonico>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:NumeroLinea&quot;/>&#xa;                                            &lt;/numeroTelefonico>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*)&quot;>&#xa;                                                &lt;tipologiaLinea>&#xa;                                                    &lt;xsl:value-of select=&quot;if(contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*)),'POTS')) then 'POTS' else&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;if(contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*)),'ISDN')) then 'ISDN' else &amp;#xD;&amp;#xA; upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/*))&amp;#xD;&amp;#xA; )&quot;/>&#xa;                                                &lt;/tipologiaLinea>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ordine>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])>5&quot;>&#xa;                                        &lt;ISTATComune>&#xa;                                            &lt;xsl:value-of select=&quot;substring(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1],string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])-5,6)&quot;/>&#xa;                                        &lt;/ISTATComune>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])>0 and string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune[1])&amp;lt;=5&quot;>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune&quot;>&#xa;                                            &lt;ISTATComune>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:CodiceComune&quot;/>&#xa;                                            &lt;/ISTATComune>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:Localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DatiSede/ns01:Localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBEAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBESimmetricoFlat)&quot;>&#xa;                                        &lt;offerta>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*))&quot;/>&#xa;                                        &lt;/offerta>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;(count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0&quot;>&#xa;                                                &lt;offerta>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;VLAN&amp;quot;&quot;/>&#xa;                                                &lt;/offerta>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;offerta>&#xa;                                                    &lt;xsl:value-of select=&quot;&amp;quot;SERVIZIONONINAMBITO&amp;quot;&quot;/>&#xa;                                                &lt;/offerta>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;contains(upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*/ns01:Accesso/*)),&amp;quot;NONFONIA&amp;quot;)&quot;>&#xa;                                        &lt;flagNaked>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                                        &lt;/flagNaked>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;flagNaked>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                        &lt;/flagNaked>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;IDRichiestaLocalizzatore>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/IDRichiestaLocalizzatore>&#xa;                                &lt;xsl:if test=&quot;ns01:Testata/ns01:TestMode&quot;>&#xa;                                    &lt;testMode>&#xa;                                        &lt;xsl:value-of select=&quot;ns01:Testata/ns01:TestMode&quot;/>&#xa;                                    &lt;/testMode>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DAD)>0&quot;>&#xa;                                    &lt;DAD>&#xa;                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DAD)&quot;/>&#xa;                                    &lt;/DAD>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:FasciaOraria&quot;>&#xa;                                    &lt;IDFasciaOraria>&#xa;                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:FasciaOraria&quot;/>&#xa;                                    &lt;/IDFasciaOraria>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;DRO>&#xa;                                    &lt;xsl:value-of select=&quot;../../tns2:NextWorkingDate&quot;/>&#xa;                                &lt;/DRO>&#xa;                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:NumeroLinea&quot;>&#xa;                                    &lt;numeroTelefonico>&#xa;                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:NumeroLinea&quot;/>&#xa;                                    &lt;/numeroTelefonico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;../../tns2:CodAGCOMint&quot;>&#xa;                                    &lt;codificaOLOAGCOMRic>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns2:CodAGCOMint&quot;/>&#xa;                                    &lt;/codificaOLOAGCOMRic>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:FamigliaVLAN=2) and exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:TipoCoS/ns01:CoS)&quot;>&#xa;                                        &lt;esito>&#xa;                                            &lt;xsl:value-of select=&quot;'Fittizio2'&quot;/>&#xa;                                        &lt;/esito>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:FamigliaVLAN=3) and exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:TipoCoS/ns01:CoS)&quot;>&#xa;                                        &lt;esito>&#xa;                                            &lt;xsl:value-of select=&quot;'Fittizio3'&quot;/>&#xa;                                        &lt;/esito>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;codiceSessione>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroLineaPOTS&quot;/>&#xa;                                &lt;/codiceSessione>&#xa;                                &lt;codiceSessione2>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroLineaISDN&quot;/>&#xa;                                &lt;/codiceSessione2>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:FamigliaVLAN=2 or ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:FamigliaVLAN=3) and ((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0) and exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN)&quot;>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:Profilo&quot;>&#xa;                                            &lt;flagDeliveryExposed>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:Profilo&quot;/>&#xa;                                            &lt;/flagDeliveryExposed>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:when test=&quot;ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:FamigliaVLAN!=2 and ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:FamigliaVLAN!=3 and exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:TipoCoS) and exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:TipoCoS/ns01:CoS) and ((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0)&quot;>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:TipoCoS/ns01:CoS&quot;>&#xa;                                            &lt;flagDeliveryExposed>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:TipoCoS/ns01:CoS&quot;/>&#xa;                                            &lt;/flagDeliveryExposed>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOlo='ALB' and contains($CodProgettoOrdWList, ns01:Testata/ns01:CodiceProgetto) and not(exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN))&quot;>&#xa;                                    &lt;ordineAssetWhiteList>&#xa;                                        &lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&#xa;                                    &lt;/ordineAssetWhiteList>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/ns:RichiestaElement>&#xa;                        &lt;/ns3:RichiesteATT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RTYPE=&amp;quot;ATTANN&amp;quot;&quot;>&#xa;                        &lt;ns3:RichiesteATT_ANN>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Attivazione)&quot;>&#xa;                                    &lt;ns:RichiestaElement>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;statoRichiestaNOW>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;                                        &lt;/statoRichiestaNOW>&#xa;                                        &lt;statoRichiestaPrecedNOW>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;                                        &lt;/statoRichiestaPrecedNOW>&#xa;                                        &lt;IDFileInput>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(../../tns2:ID_FILE)&quot;/>&#xa;                                        &lt;/IDFileInput>&#xa;                                        &lt;ambito>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                        &lt;/ambito>&#xa;                                        &lt;canaleRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;                                        &lt;/canaleRichiesta>&#xa;                                        &lt;lavorazione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                                        &lt;/lavorazione>&#xa;                                        &lt;progressivoRichiestaFile>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                        &lt;/progressivoRichiestaFile>&#xa;                                        &lt;strutturaRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                                        &lt;/strutturaRichiesta>&#xa;                                        &lt;tipoRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                                        &lt;/tipoRichiesta>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                                                &lt;codificaOLOAGCOM>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                                                &lt;/codificaOLOAGCOM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;codificaOLOAGCOM>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns2:CodOLOdaNome&quot;/>&#xa;                                                &lt;/codificaOLOAGCOM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;codificaOLONOW>&#xa;                                            &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                                        &lt;/codificaOLONOW>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                                            &lt;codiceOrdineOLO>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                                            &lt;/codiceOrdineOLO>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                                            &lt;codiceOrdineOLOPadre>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;/>&#xa;                                            &lt;/codiceOrdineOLOPadre>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                                            &lt;codiceProgetto>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceProgetto&quot;/>&#xa;                                            &lt;/codiceProgetto>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;dataInvioRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../tns2:DATA_FILE), 1, 10))&quot;/>&#xa;                                        &lt;/dataInvioRichiesta>&#xa;                                        &lt;contenutoXML>&#xa;                                            &lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&#xa;                                        &lt;/contenutoXML>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;matches(ns01:Testata/ns01:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                                                &lt;note>&#xa;                                                    &lt;xsl:value-of select=&quot;translate(ns01:Testata/ns01:Note, '0123456789', '         ')&quot;/>&#xa;                                                &lt;/note>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;xsl:if test=&quot;ns01:Testata/ns01:Note&quot;>&#xa;                                                    &lt;note>&#xa;                                                        &lt;xsl:value-of select=&quot;ns01:Testata/ns01:Note&quot;/>&#xa;                                                    &lt;/note>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBEAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBESimmetricoFlat) or  (exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN) and ((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0))&quot;>&#xa;                                            &lt;ordine>&#xa;                                                &lt;offertaCatalogo>&#xa;                                                    &lt;xsl:value-of select=&quot;upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*))&quot;/>&#xa;                                                &lt;/offertaCatalogo>&#xa;                                                &lt;xsl:if test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DAD)>0&quot;>&#xa;                                                    &lt;DAD>&#xa;                                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DAD)&quot;/>&#xa;                                                    &lt;/DAD>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;created>&#xa;                                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                                &lt;/created>&#xa;                                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:CognomeRagSoc&quot;>&#xa;                                                    &lt;cognomeRagioneSociale>&#xa;                                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:CognomeRagSoc&quot;/>&#xa;                                                    &lt;/cognomeRagioneSociale>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:Nome&quot;>&#xa;                                                    &lt;nome>&#xa;                                                        &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:Nome&quot;/>&#xa;                                                    &lt;/nome>&#xa;      