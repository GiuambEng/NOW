ns0:Referente&quot; copy-namespaces=&quot;no&quot;/>&#xa;                                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:EasyIPSpecialProfileLite/ns0:Accesso/ns0:LineaNonFonia/ns0:ReferenteOLOperProblematicheOn-field&quot; copy-namespaces=&quot;no&quot;/>&#xa;                                            &lt;/ns0:LineaNonFonia>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/ns0:Accesso>&#xa;                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:EasyIPSpecialProfileLite/ns0:VC&quot; copy-namespaces=&quot;no&quot;/>&#xa;                            &lt;/ns0:EasyIPSpecialProfileLite>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ns0:Attivazione>&#xa;            &lt;/ns0:TipoRichiesta>&#xa;        &lt;/ns0:Richiesta>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:order="http://xsd.telecomitalia.it/crm/xdsl/order"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="order:Richiesta"
                                    outputStyle="text" xsi:type="palettexml:RenderXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderXml2-input"
                                    name="RenderXml2"
                                    outputVariable="RenderXml2"
                                    tibex:xpdlId="4412b4f3-7f9f-40a6-ab85-44b85191b1b4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXmlToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXml2ToCreaRichiesta"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Token7&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml2-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:Richiesta>&#xa;            &lt;ns0:Testata>&#xa;                &lt;ns0:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                &lt;/ns0:CodiceOlo>&#xa;                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                    &lt;ns0:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOlo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                    &lt;ns0:CodiceOrdineOloPadre>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOloPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                    &lt;ns0:CodiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                    &lt;/ns0:CodiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;matches($ParseXml[1]/ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                        &lt;ns0:Note>&#xa;                            &lt;xsl:value-of select=&quot;translate($ParseXml[1]/ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&#xa;                        &lt;/ns0:Note>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ParseXml[1]/ns0:Testata/ns0:Note&quot;>&#xa;                            &lt;ns0:Note>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:Testata/ns0:Note&quot;/>&#xa;                            &lt;/ns0:Note>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:Testata/ns0:TestMode&quot;>&#xa;                    &lt;ns0:TestMode>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:Testata/ns0:TestMode&quot;/>&#xa;                    &lt;/ns0:TestMode>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;>&#xa;                    &lt;ns0:ReferentiOAOProgettiSpeciali>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                    &lt;/ns0:ReferentiOAOProgettiSpeciali>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns0:Testata>&#xa;            &lt;ns0:TipoRichiesta>&#xa;                &lt;ns0:Attivazione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat)&quot;>&#xa;                            &lt;ns0:BitstreamATMAsimmetricoFlat>&#xa;                                &lt;ns0:Accesso>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS)&quot;>&#xa;                                            &lt;ns0:LineaPOTS>&#xa;                                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DatiSede&quot;/>&#xa;                                                &lt;ns0:ClienteFinale>&#xa;                                                    &lt;ns0:CognomeRagSoc>&#xa;                                                        &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                                                    &lt;/ns0:CognomeRagSoc>&#xa;                                                    &lt;xsl:if test=&quot;$Token7/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                                                        &lt;ns0:Nome>&#xa;                                                            &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                                                        &lt;/ns0:Nome>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($Token7/tns2:ResponseCreate_token/tns2:CodiceFiscale)>0&quot;>&#xa;                                                            &lt;ns0:CF>&#xa;                                                                &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:CodiceFiscale&quot;/>&#xa;                                                            &lt;/ns0:CF>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns0:PIVA>&#xa;                                                                &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:PIVA&quot;/>&#xa;                                                            &lt;/ns0:PIVA>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns0:ClienteFinale>&#xa;                                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Modem&quot;/>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaProvisioning&quot;>&#xa;                                                    &lt;ns0:SlaProvisioning>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaProvisioning&quot;/>&#xa;                                                    &lt;/ns0:SlaProvisioning>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;ns0:SlaAssurance>&#xa;                                                    &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaAssurance&quot;/>&#xa;                                                &lt;/ns0:SlaAssurance>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceQualita&quot;>&#xa;                                                    &lt;ns0:CodiceQualita>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceQualita&quot;/>&#xa;                                                    &lt;/ns0:CodiceQualita>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceDelivery&quot;>&#xa;                                                    &lt;ns0:CodiceDelivery>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceDelivery&quot;/>&#xa;                                                    &lt;/ns0:CodiceDelivery>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DAD&quot;>&#xa;                                                    &lt;ns0:DAD>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DAD&quot;/>&#xa;                                                    &lt;/ns0:DAD>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:FasciaOraria&quot;>&#xa;                                                    &lt;ns0:FasciaOraria>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:FasciaOraria&quot;/>&#xa;                                                    &lt;/ns0:FasciaOraria>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CampoServizioIt&quot;>&#xa;                                                    &lt;ns0:CampoServizioIt>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CampoServizioIt&quot;/>&#xa;                                                    &lt;/ns0:CampoServizioIt>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;ns0:NumeroLinea>&#xa;                                                    &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:NumeroLinea&quot;/>&#xa;                                                &lt;/ns0:NumeroLinea>&#xa;                                                &lt;ns0:ProfiloTecnicoLinea>&#xa;                                                    &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:ProfiloTecnicoLinea&quot;/>&#xa;                                                &lt;/ns0:ProfiloTecnicoLinea>&#xa;                                                &lt;ns0:Modulazione>&#xa;                                                    &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Modulazione&quot;/>&#xa;                                                &lt;/ns0:Modulazione>&#xa;                                                &lt;ns0:Splitter>&#xa;                                                    &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Splitter&quot;/>&#xa;                                                &lt;/ns0:Splitter>&#xa;                                                &lt;xsl:for-each select=&quot;$Richiesta/ordine/referente[string-length(qualificaReferente)>0 and string-length(nomeReferente)>0 and string-length(cognomeReferente)>0]&quot;>&#xa;                                                    &lt;ns0:Referente>&#xa;                                                        &lt;ns0:Progressivo>&#xa;                                                            &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                                                        &lt;/ns0:Progressivo>&#xa;                                                        &lt;ns0:Qualifica>&#xa;                                                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                                                        &lt;/ns0:Qualifica>&#xa;                                                        &lt;ns0:Nome>&#xa;                                                            &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                                                        &lt;/ns0:Nome>&#xa;                                                        &lt;ns0:Cognome>&#xa;                                                            &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                                                        &lt;/ns0:Cognome>&#xa;                                                        &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                                            &lt;ns0:Telefono>&#xa;                                                                &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                                            &lt;/ns0:Telefono>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                                            &lt;ns0:Mobile>&#xa;                                                                &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                                            &lt;/ns0:Mobile>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                                                            &lt;ns0:Email>&#xa;                                                                &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                                                            &lt;/ns0:Email>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns0:Referente>&#xa;                                                &lt;/xsl:for-each>&#xa;                                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:ReferenteOLOperProblematicheOn-field&quot; copy-namespaces=&quot;no&quot;/>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:GestioneProdotto&quot;>&#xa;                                                    &lt;ns0:GestioneProdotto>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:GestioneProdotto&quot;/>&#xa;                                                    &lt;/ns0:GestioneProdotto>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/ns0:LineaPOTS>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN)&quot;>&#xa;                                            &lt;ns0:LineaISDN>&#xa;                                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:DatiSede&quot;/>&#xa;                                                &lt;ns0:ClienteFinale>&#xa;                                                    &lt;ns0:CognomeRagSoc>&#xa;                                                        &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                                                    &lt;/ns0:CognomeRagSoc>&#xa;                                                    &lt;xsl:if test=&quot;$Token7/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                                                        &lt;ns0:Nome>&#xa;                                                            &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                                                        &lt;/ns0:Nome>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($Token7/tns2:ResponseCreate_token/tns2:CodiceFiscale)>0&quot;>&#xa;                                                            &lt;ns0:CF>&#xa;                                                                &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:CodiceFiscale&quot;/>&#xa;                                                            &lt;/ns0:CF>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns0:PIVA>&#xa;                                                                &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:PIVA&quot;/>&#xa;                                                            &lt;/ns0:PIVA>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns0:ClienteFinale>&#xa;                                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:Modem&quot;/>&#xa;                                                &lt;xsl:if test=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:SlaProvisioning&quot;>&#xa;                                                    &lt;ns0:SlaProvisioning>&#xa;                                                        &lt;xsl:value-of select=&quot;$ParseXml[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:SlaProvisioning&quot;/>&#xa;                                                    &lt;/ns0:SlaProvisioning>&#xa;                                                &lt;/xsl:if>&#xa;                                                &lt;ns0:SlaAssurance>&#xa;                                                    &lt;xsl:value-of select=&quot;$Pa