            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="72394485-0c7c-47a3-a6a5-a441c1dd69f4"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLog1"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="5e17ada1-2710-4528-a2ec-8e9a27544908" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ALTToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ListaContatori&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Contatori&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperRaggruppamento-input"
                    name="MapperRaggruppamento"
                    outputVariable="MapperRaggruppamento"
                    tibex:xpdlId="b2410d25-001e-4e91-861b-b1c66aa5f1a7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetLocalIPToMapperRaggruppamento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperRaggruppamentoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($MapperRaggruppamento/ns26:Richieste/ns26:RichiesteATT_ANN/ns2:RichiestaElement)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($MapperRaggruppamento/ns26:Richieste/ns26:RichiesteATT_ANN/ns2:RichiestaElement)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MapperRaggruppamentoToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:ns3=&quot;http://www.example.org/RichiesteXDSLxBPM&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;CodProgettoOrdWList&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperRaggruppamento-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:RichiesteOLOSuddivise>&#xa;            &lt;xsl:for-each select=&quot;$Start/ns01:TracciatoOLOxDSL/ns01:Richiesta&quot;>&#xa;                &lt;xsl:variable name=&quot;rich&quot; select=&quot;current()&quot;/>&#xa;                &lt;xsl:variable name=&quot;NumeroLineaPOTS&quot; select=&quot;string($rich/ns01:TipoRichiesta/ns01:Attivazione/*[1]/ns01:Accesso/ns01:LineaPOTS/ns01:NumeroLinea)&quot;/>&#xa;                &lt;xsl:variable name=&quot;NumeroLineaISDN&quot; select=&quot;string($rich/ns01:TipoRichiesta/ns01:Attivazione/*[1]/ns01:Accesso/ns01:LineaISDN/ns01:NumeroLinea)&quot;/>&#xa;                &lt;xsl:variable name=&quot;RTYPE&quot; select=&quot;if(exists(ns01:TipoRichiesta/ns01:Migrazione)) then &amp;#xD;&amp;#xA; if (exists(../ns01:Richiesta/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento[../../../ns01:Testata/ns01:CodiceOlo = $rich/ns01:Testata/ns01:CodiceOlo and ns01:CodiceOrdineOlo = $rich/ns01:Testata/ns01:CodiceOrdineOlo])) then  &amp;#xD;&amp;#xA;  'ATTANN' &amp;#xD;&amp;#xA; else &amp;#xD;&amp;#xA;  'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(ns01:TipoRichiesta/ns01:Attivazione)) then &amp;#xD;&amp;#xA; if (exists(../ns01:Richiesta/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento[../../../ns01:Testata/ns01:CodiceOlo = $rich/ns01:Testata/ns01:CodiceOlo and ns01:CodiceOrdineOlo = $rich/ns01:Testata/ns01:CodiceOrdineOlo])) then  &amp;#xD;&amp;#xA;  'ATTANN' &amp;#xD;&amp;#xA; else &amp;#xD;&amp;#xA;  'ATT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento)) then &amp;#xD;&amp;#xA; if (exists(../ns01:Richiesta/ns01:TipoRichiesta/ns01:Attivazione[../../ns01:Testata/ns01:CodiceOrdineOlo = $rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineOlo and ../../ns01:Testata/ns01:CodiceOlo = $rich/ns01:Testata/ns01:CodiceOlo]) or exists(../ns01:Richiesta/ns01:TipoRichiesta/ns01:Migrazione[../../ns01:Testata/ns01:CodiceOrdineOlo = $rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineOlo and ../../ns01:Testata/ns01:CodiceOlo = $rich/ns01:Testata/ns01:CodiceOlo])) then  &amp;#xD;&amp;#xA;  'ATTANN' &amp;#xD;&amp;#xA; else &amp;#xD;&amp;#xA;  'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;'ALT'&quot;/>&#xa;                &lt;ns3:Richieste>&#xa;                    &lt;xsl:if test=&quot;$RTYPE=&amp;quot;ATT&amp;quot;&quot;>&#xa;                        &lt;ns3:RichiesteATT>&#xa;                            &lt;ns:RichiestaElement>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;lastUpdate>&#xa;                                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                &lt;/lastUpdate>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;IDRichiestaOLO>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                &lt;/IDRichiestaOLO>&#xa;                                &lt;statoRichiestaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;                                &lt;/statoRichiestaNOW>&#xa;                                &lt;statoRichiestaPrecedNOW>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;                                &lt;/statoRichiestaPrecedNOW>&#xa;                                &lt;IDFileInput>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(../../tns2:ID_FILE)&quot;/>&#xa;                                &lt;/IDFileInput>&#xa;                                &lt;ambito>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                &lt;/ambito>&#xa;                                &lt;canaleRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;                                &lt;/canaleRichiesta>&#xa;                                &lt;lavorazione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                                &lt;/lavorazione>&#xa;                                &lt;progressivoRichiestaFile>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                &lt;/progressivoRichiestaFile>&#xa;                                &lt;strutturaRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                                &lt;/strutturaRichiesta>&#xa;                                &lt;tipoRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&#xa;                                &lt;/tipoRichiesta>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length(../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                                        &lt;codificaOLOAGCOM>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                                        &lt;/codificaOLOAGCOM>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;codificaOLOAGCOM>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns2:CodOLOdaNome&quot;/>&#xa;                                        &lt;/codificaOLOAGCOM>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;codificaOLONOW>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                                &lt;/codificaOLONOW>&#xa;                                &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                                    &lt;codiceOrdineOLO>&#xa;                                        &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                                    &lt;/codiceOrdineOLO>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                                    &lt;codiceOrdineOLOPadre>&#xa;                                        &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;/>&#xa;                                    &lt;/codiceOrdineOLOPadre>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                                    &lt;codiceProgetto>&#xa;                                        &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceProgetto&quot;/>&#xa;                                    &lt;/codiceProgetto>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;dataInvioRichiesta>&#xa;                                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../tns2:DATA_FILE), 1, 10))&quot;/>&#xa;                                &lt;/dataInvioRichiesta>&#xa;                                &lt;contenutoXML>&#xa;                                    &lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&#xa;                                &lt;/contenutoXML>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;matches(ns01:Testata/ns01:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                                        &lt;note>&#xa;                                            &lt;xsl:value-of select=&quot;translate(ns01:Testata/ns01:Note, '0123456789', '         ')&quot;/>&#xa;                                        &lt;/note>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:Note&quot;>&#xa;                                            &lt;note>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:Note&quot;/>&#xa;                                            &lt;/note>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMAsimmetricoLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBEAsimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPBasePlusLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:EasyIPSpecialProfileLite) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoHL) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamATMSimmetricoFlat) or exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:BitstreamGBESimmetricoFlat) or (exists(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN) and ((count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-20-0150']/FLAG_OSCURMENTO='0') or count($FlagOscuramento/Record[COD_AGESP='R1I-20-0150'])=0))&quot;>&#xa;                                    &lt;ordine>&#xa;                                        &lt;offertaCatalogo>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case(local-name(ns01:TipoRichiesta/ns01:Attivazione/*))&quot;/>&#xa;                                        &lt;/offertaCatalogo>&#xa;                                        &lt;xsl:if test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DAD)>0&quot;>&#xa;                                            &lt;DAD>&#xa;                                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:DAD)&quot;/>&#xa;                                            &lt;/DAD>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:CognomeRagSoc&quot;>&#xa;                                            &lt;cognomeRagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:CognomeRagSoc&quot;/>&#xa;                                            &lt;/cognomeRagioneSociale>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:Nome&quot;>&#xa;                                            &lt;nome>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:Nome&quot;/>&#xa;                                            &lt;/nome>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:CF&quot;>&#xa;                                            &lt;CF>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/node()/ns01:Accesso/node()/ns01:ClienteFinale/ns01:CF&quot;/