;''&quot;/>&#xa;                    &lt;/telefonoFissoReferente>&#xa;                    &lt;telefonoMobileReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/telefonoMobileReferente>&#xa;                    &lt;emailReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/emailReferente>&#xa;                    &lt;flag_Token>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/flag_Token>&#xa;                &lt;/tns2:Referente>&#xa;            &lt;/tns2:Request>&#xa;        &lt;/tns2:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
