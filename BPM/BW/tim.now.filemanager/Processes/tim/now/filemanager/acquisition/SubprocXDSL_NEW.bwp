            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ListaOfferte"
                    name="ListaOfferte" outputVariable="ListaOfferte"
                    tibex:xpdlId="6f0aff57-92d1-4064-90d3-d80937f8554e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListaOfferteToLog_EstrazioniIDOfferta"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:template name=&quot;ListaOfferte&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ListaOfferte>&#xa;            &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns3:Richiesta/offerta&quot;>&#xa;                &lt;tns2:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/tns2:Offerta>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$ATTarray/tns3:Richiesta/offerta&quot;>&#xa;                &lt;tns2:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                &lt;/tns2:Offerta>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns2:ListaOfferte>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ListaOfferte" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="EstrazioneIDofferta-input"
                    name="EstrazioneIDofferta"
                    outputVariable="EstrazioneIDofferta"
                    tibex:xpdlId="cce417b3-458d-4bea-a16d-d56282bfbec5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log_EstrazioniIDOffertaToEstrazioneIDofferta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToATT_ANN"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cce417b3-458d-4bea-a16d-d56282bfbec5+input&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaOfferte&quot;/>&#xa;    &lt;xsl:template name=&quot;EstrazioneIDofferta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT NOME_OFFERTA_ESTERNA, ID_OFFERTA  FROM TRASCODFC_OFFERTA  WHERE upper(NOME_OFFERTA_ESTERNA) IN ( '&amp;quot;, tib:concat-sequence-format($ListaOfferte/tns3:Offerta,&amp;quot;' , '&amp;quot;, true()) , &amp;quot;' ) AND PROVENIENZA='BPM'&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
