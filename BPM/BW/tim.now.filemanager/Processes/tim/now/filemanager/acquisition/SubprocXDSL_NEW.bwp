                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ParseXml1ToAssign17"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXml1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:xmlString>&#xa;            &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/contenutoXML&quot;/>&#xa;        &lt;/tns2:xmlString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.parsexml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:order="http://xsd.telecomitalia.it/crm/xdsl/order"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value
                                    inputStyle="text"
                                    outputElementQName="order:Richiesta" xsi:type="palettexml:ParseXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderXml1-input"
                                    name="RenderXml1"
                                    outputVariable="RenderXml1"
                                    tibex:xpdlId="e8673c80-7b27-40f4-b27c-935bef65dd38" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseXml1ToAssign17"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXml1ToAssign17"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXml1&quot;/>&#xa;    &lt;xsl:param name=&quot;Token8&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml1-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:Richiesta>&#xa;            &lt;ns0:Testata>&#xa;                &lt;ns0:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml1/ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                &lt;/ns0:CodiceOlo>&#xa;                &lt;xsl:if test=&quot;$ParseXml1/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                    &lt;ns0:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml1/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOlo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml1/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                    &lt;ns0:CodiceOrdineOloPadre>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml1/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOloPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml1/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                    &lt;ns0:CodiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml1/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                    &lt;/ns0:CodiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;matches($ParseXml1/ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                        &lt;ns0:Note>&#xa;                            &lt;xsl:value-of select=&quot;translate($ParseXml1/ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&#xa;                        &lt;/ns0:Note>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ParseXml1/ns0:Testata/ns0:Note&quot;>&#xa;                            &lt;ns0:Note>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml1/ns0:Testata/ns0:Note&quot;/>&#xa;                            &lt;/ns0:Note>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ParseXml1/ns0:Testata/ns0:TestMode&quot;>&#xa;                    &lt;ns0:TestMode>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml1/ns0:Testata/ns0:TestMode&quot;/>&#xa;                    &lt;/ns0:TestMode>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml1/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;>&#xa;                    &lt;ns0:ReferentiOAOProgettiSpeciali>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml1/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                    &lt;/ns0:ReferentiOAOProgettiSpeciali>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns0:Testata>&#xa;            &lt;ns0:TipoRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ParseXml1/ns0:TipoRichiesta/ns0:Attivazione)&quot;>&#xa;                        &lt;ns0:Attivazione>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat)&quot;>&#xa;                                    &lt;ns0:BitstreamATMAsimmetricoFlat>&#xa;                                        &lt;ns0:Accesso>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists($ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS)&quot;>&#xa;                                                    &lt;ns0:LineaPOTS>&#xa;                                                        &lt;xsl:copy-of select=&quot;$ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DatiSede&quot;/>&#xa;                                                        &lt;ns0:ClienteFinale>&#xa;                                                            &lt;ns0:CognomeRagSoc>&#xa;                                                                &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                                                            &lt;/ns0:CognomeRagSoc>&#xa;                                                            &lt;xsl:if test=&quot;$Token8/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                                                                &lt;ns0:Nome>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                                                                &lt;/ns0:Nome>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;string-length($Token8/tns2:ResponseCreate_token/tns2:CodiceFiscale)>0&quot;>&#xa;                                                                    &lt;ns0:CF>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:CodiceFiscale&quot;/>&#xa;                                                                    &lt;/ns0:CF>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns0:PIVA>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:PIVA&quot;/>&#xa;                                                                    &lt;/ns0:PIVA>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns0:ClienteFinale>&#xa;                                                        &lt;xsl:copy-of select=&quot;$ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Modem&quot;/>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaProvisioning&quot;>&#xa;                                                            &lt;ns0:SlaProvisioning>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaProvisioning&quot;/>&#xa;                                                            &lt;/ns0:SlaProvisioning>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;ns0:SlaAssurance>&#xa;                                                            &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:SlaAssurance&quot;/>&#xa;                                                        &lt;/ns0:SlaAssurance>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceQualita&quot;>&#xa;                                                            &lt;ns0:CodiceQualita>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceQualita&quot;/>&#xa;                                                            &lt;/ns0:CodiceQualita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceDelivery&quot;>&#xa;                                                            &lt;ns0:CodiceDelivery>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CodiceDelivery&quot;/>&#xa;                                                            &lt;/ns0:CodiceDelivery>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DAD&quot;>&#xa;                                                            &lt;ns0:DAD>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DAD&quot;/>&#xa;                                                            &lt;/ns0:DAD>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:FasciaOraria&quot;>&#xa;                                                            &lt;ns0:FasciaOraria>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:FasciaOraria&quot;/>&#xa;                                                            &lt;/ns0:FasciaOraria>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CampoServizioIt&quot;>&#xa;                                                            &lt;ns0:CampoServizioIt>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:CampoServizioIt&quot;/>&#xa;                                                            &lt;/ns0:CampoServizioIt>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;ns0:NumeroLinea>&#xa;                                                            &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:NumeroLinea&quot;/>&#xa;                                                        &lt;/ns0:NumeroLinea>&#xa;                                                        &lt;ns0:ProfiloTecnicoLinea>&#xa;                                                            &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:ProfiloTecnicoLinea&quot;/>&#xa;                                                        &lt;/ns0:ProfiloTecnicoLinea>&#xa;                                                        &lt;ns0:Modulazione>&#xa;                                                            &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Modulazione&quot;/>&#xa;                                                        &lt;/ns0:Modulazione>&#xa;                                                        &lt;ns0:Splitter>&#xa;                                                            &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Splitter&quot;/>&#xa;                                                        &lt;/ns0:Splitter>&#xa;                                                        &lt;xsl:copy-of select=&quot;$ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:Referente&quot; copy-namespaces=&quot;no&quot;/>&#xa;                                                        &lt;xsl:copy-of select=&quot;$ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:ReferenteOLOperProblematicheOn-field&quot; copy-namespaces=&quot;no&quot;/>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:GestioneProdotto&quot;>&#xa;                                                            &lt;ns0:GestioneProdotto>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:GestioneProdotto&quot;/>&#xa;                                                            &lt;/ns0:GestioneProdotto>&#xa;                                                        &lt;/xsl:if>&#xa;                                                    &lt;/ns0:LineaPOTS>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:when test=&quot;exists($ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN)&quot;>&#xa;                                                    &lt;ns0:LineaISDN>&#xa;                                                        &lt;xsl:copy-of select=&quot;$ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:DatiSede&quot;/>&#xa;                                                        &lt;ns0:ClienteFinale>&#xa;                                                            &lt;ns0:CognomeRagSoc>&#xa;                                                                &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                                                            &lt;/ns0:CognomeRagSoc>&#xa;                                                            &lt;xsl:if test=&quot;$Token8/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                                                                &lt;ns0:Nome>&#xa;                                                                    &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                                                                &lt;/ns0:Nome>&#xa;                                                            &lt;/xsl:if>&#xa;                                                            &lt;xsl:choose>&#xa;                                                                &lt;xsl:when test=&quot;string-length($Token8/tns2:ResponseCreate_token/tns2:CodiceFiscale)>0&quot;>&#xa;                                                                    &lt;ns0:CF>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:CodiceFiscale&quot;/>&#xa;                                                                    &lt;/ns0:CF>&#xa;                                                                &lt;/xsl:when>&#xa;                                                                &lt;xsl:otherwise>&#xa;                                                                    &lt;ns0:PIVA>&#xa;                                                                        &lt;xsl:value-of select=&quot;$Token8/tns2:ResponseCreate_token/tns2:PIVA&quot;/>&#xa;                                                                    &lt;/ns0:PIVA>&#xa;                                                                &lt;/xsl:otherwise>&#xa;                                                            &lt;/xsl:choose>&#xa;                                                        &lt;/ns0:ClienteFinale>&#xa;                                                        &lt;xsl:copy-of select=&quot;$ParseXml1/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:Modem&quot;/>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:SlaProvisioning&quot;>&#xa;                                                            &lt;ns0:SlaProvisioning>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:SlaProvisioning&quot;/>&#xa;                                                            &lt;/ns0:SlaProvisioning>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;ns0:SlaAssurance>&#xa;                                                            &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:SlaAssurance&quot;/>&#xa;                                                        &lt;/ns0:SlaAssurance>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:CodiceQualita&quot;>&#xa;                                                            &lt;ns0:CodiceQualita>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:CodiceQualita&quot;/>&#xa;                                                            &lt;/ns0:CodiceQualita>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:CodiceDelivery&quot;>&#xa;                                                            &lt;ns0:CodiceDelivery>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:CodiceDelivery&quot;/>&#xa;                                                            &lt;/ns0:CodiceDelivery>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:DAD&quot;>&#xa;                                                            &lt;ns0:DAD>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:DAD&quot;/>&#xa;                                                            &lt;/ns0:DAD>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:FasciaOraria&quot;>&#xa;                                                            &lt;ns0:FasciaOraria>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:FasciaOraria&quot;/>&#xa;                                                            &lt;/ns0:FasciaOraria>&#xa;                                                        &lt;/xsl:if>&#xa;                                                        &lt;xsl:if test=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:CampoServizioIt&quot;>&#xa;                                                            &lt;ns0:CampoServizioIt>&#xa;                                                                &lt;xsl:value-of select=&quot;$ParseXml1[1]/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaISDN/ns0:CampoServizioIt&quot;/>&#xa;                                                            &lt;/ns0:CampoServizioIt>&#xa;                                                        &lt;/xsl:if>&#xa;                                               