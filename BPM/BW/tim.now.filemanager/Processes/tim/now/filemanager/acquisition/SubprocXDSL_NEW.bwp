&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns:ContatoreKO+1)&quot;/>&lt;/tns:ContatoreKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ContatoreKO>&lt;xsl:value-of select=&quot;$Contatori/tns:ContatoreKO&quot;/>&lt;/tns:ContatoreKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
