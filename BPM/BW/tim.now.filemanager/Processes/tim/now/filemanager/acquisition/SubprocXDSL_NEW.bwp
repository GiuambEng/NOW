                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDescrComune&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;Rendezvous&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;TIPOLOGIA_BANDA&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery2&quot;/>&#xa;    &lt;xsl:param name=&quot;CLLI&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagFittizio&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ATTarray/tns5:Richiesta[number($index)]&quot;>&#xa;            &lt;ns:RichiestaElement>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                    &lt;statoRichiestaPrecedOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                    &lt;/statoRichiestaPrecedOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                    &lt;sottostatoLavorManuale>&#xa;                        &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                    &lt;/sottostatoLavorManuale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                    &lt;IDFileInput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                    &lt;/IDFileInput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                    &lt;IDFileOutput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                    &lt;/IDFileOutput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;ambito&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:if>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;xsl:if test=&quot;lavorazione&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;lavorazione&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&#xa;                    &lt;progressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&#xa;                    &lt;/progressivoRichiestaFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(codificaOLOAGCOM)>0&quot;>&#xa;                        &lt;codificaOLOAGCOM>&#xa;                            &lt;xsl:va