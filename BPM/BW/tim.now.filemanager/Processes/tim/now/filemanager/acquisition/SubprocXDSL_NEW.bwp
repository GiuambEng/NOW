                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcess1ToCallProcess2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CreaRichiestaANNcrmwsToLog1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderAnn&quot;/>&#xa;    &lt;xsl:param name=&quot;PriorityCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Annullamento&quot;/>&#xa;    &lt;xsl:template name=&quot;CreaRichiestaANNcrmws-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Element>&#xa;            &lt;tns3:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns3:moduleName>&#xa;            &lt;tns3:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns3:parameterName>&#xa;            &lt;tns3:operationName>&#xa;                &lt;xsl:value-of select=&quot;$CRMWSoperationName&quot;/>&#xa;            &lt;/tns3:operationName>&#xa;            &lt;tns3:processName>&#xa;                &lt;xsl:value-of select=&quot;$CRMWSprocessName&quot;/>&#xa;            &lt;/tns3:processName>&#xa;            &lt;tns3:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderAnn&quot;/>&#xa;            &lt;/tns3:value>&#xa;            &lt;tns3:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns4:ID_FILE&quot;/>&#xa;            &lt;/tns3:ID_FILE>&#xa;            &lt;tns3:priority>&#xa;                &lt;xsl:value-of select=&quot;$PriorityCRMWS&quot;/>&#xa;            &lt;/tns3:priority>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns2:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns2:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns2:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]/contenutoXML&quot;>&#xa;                &lt;tns3:ContenutoXML>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns2:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns2:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns2:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]/contenutoXML&quot;/>&#xa;                &lt;/tns3:ContenutoXML>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns3:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$Annullamento/progressivoRichiestaFile&quot;>&#xa;                &lt;tns3:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns3:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/ambito&quot;>&#xa;                &lt;tns3:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/ambito&quot;/>&#xa;                &lt;/tns3:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/strutturaRichiesta&quot;/>&#xa;            &lt;/tns3:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$Annullamento/codiceOrdineOLO&quot;>&#xa;                &lt;tns3:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns3:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
