                               &lt;xsl:value-of select=&quot;ns01:Testata/ns01:Note&quot;/>&#xa;                                                    &lt;/noteCliente>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;string-length(ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:CLLICentrale)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:CLLICentrale&quot;>&#xa;                                                &lt;CLLI>&#xa;                                                    &lt;xsl:value-of select=&quot;ns01:TipoRichiesta/ns01:Attivazione/ns01:VLAN/ns01:CLLICentrale&quot;/>&#xa;                                                &lt;/CLLI>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;codificaOLONOW>&#xa;                                            &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                                        &lt;/codificaOLONOW>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                                            &lt;codiceOrdineOLO>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                                            &lt;/codiceOrdineOLO>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                                            &lt;codiceOrdineOLOPadre>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:T