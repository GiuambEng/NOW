                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token1&quot;/>&#xa;    &lt;xsl:template name=&quot;Referente&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;xsl:copy-of select=&quot;$Referente/tns3:Request&quot;/>&#xa;            &lt;tns3:Request>&#xa;                &lt;xsl:if test=&quot;$Token1/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                    &lt;tns3:Token>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                    &lt;/tns3:Token>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token1/tns2:ResponseCreate_token/tns2:ESITO&quot;>&#xa;                    &lt;tns3:Esito>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns2:ResponseCreate_token/tns2:ESITO&quot;/>&#xa;                    &lt;/tns3:Esito>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token1/tns2:ResponseCreate_token/tns2:DESCRIZIONE&quot;>&#xa;                    &lt;tns3:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns2:ResponseCreate_token/tns2:DESCRIZIONE&quot;/>&#xa;                    &lt;/tns3:Descrizione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$ATTarray/tns4:Richiesta[$index]/ordine/referente[$index1]&quot;>&#xa;                    &lt;tns3:Referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;tipoReferenteOrdine&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                            &lt;qualificaReferente>&#xa;                                &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                            &lt;/qualificaReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Token1/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token1/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Token1/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token1/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token1/tns2:ResponseCreate_token/tns2:Token)>0 and string-length(telefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token1/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token1/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token1/tns2:ResponseCreate_token/tns2:Token)>0 and string-length(telefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token1/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token1/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                            &lt;emailReferente>&#xa;                                &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                            &lt;/emailReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns3:Referente>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns3:Request>&#xa;        &lt;/tns3:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
