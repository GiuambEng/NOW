    &lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/ns01:Prequalifica)&quot;>&#xa;                        &lt;tns3:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PREQUALIFICA&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns01:DatiSede/ns01:CodiceComune[1])>5&quot;>&#xa;                        &lt;tns3:CodiceIstatComune>&#xa;                            &lt;xsl:value-of select=&quot;substring($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns01:DatiSede/ns01:CodiceComune[1],string-length($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns01:DatiSede/ns01:CodiceComune[1])-5,6)&quot;/>&#xa;                        &lt;/tns3:CodiceIstatComune>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns01:DatiSede/ns01:CodiceComune[1])>0 and string-length($NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns01:DatiSede/ns01:CodiceComune[1])&amp;lt;=5&quot;>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:TipoRichiesta/node()/*[1]/*[1]/*[1]/ns01:DatiSede/ns01:CodiceComune&quot;>&#xa;                            &lt;tns3:CodiceIstatComune>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/ns01:Richiesta[$index]/ns01:TipoRich