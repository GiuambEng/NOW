                                <tibex:activityExtension
                                    inputVariable="Richiesta"
                                    name="CambioAmbito"
                                    outputVariable="Richiesta"
                                    tibex:xpdlId="6d9d535d-6697-4ff9-b048-20367f61bffb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
