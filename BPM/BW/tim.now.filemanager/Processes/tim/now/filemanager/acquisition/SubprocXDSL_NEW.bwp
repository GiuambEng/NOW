                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT descr_comune FROM comune_o_localita&#xa;WHERE (to_date(sysdate)&lt;datafi_valid OR datafi_valid IS NULL) AND cod_istat_comune=? AND flag_comune='S'&#xa;&#xa;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

