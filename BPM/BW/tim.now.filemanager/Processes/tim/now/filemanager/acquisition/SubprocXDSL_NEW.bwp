                                    name="LogChiamataBPM"
                                    tibex:xpdlId="35174bfb-6f1a-4d8b-8e4b-ac8a1bd9e634" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToLog1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogChiamataBPMToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogChiamataBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Richiesta inviata al BPM: &amp;quot;, $RenderRichiesta)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Rendezvous-input"
                                    name="Rendezvous"
                                    outputVariable="Rendezvous"
                                    tibex:xpdlId="774cf3d5-6a7a-47b8-8274-10d80b1a3b46"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign16ToRendezvous"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RendezvousToEmpty20"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Rendezvous-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ATTarray/tns5:Richiesta[number($index)]/codificaOLOAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATTarray/tns5:Richiesta[number($index)]/codificaOLOAGCOM&quot;>&#xa;                        &lt;tns4:CODFC_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$ATTarray/tns5:Richiesta[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns4:CODFC_OLO_AGCOM>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:CodOLOdaNome&quot;/>&#xa;                    &lt;/tns4:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ListaIdOfferta/tns3:Offerta[upper-case(tns3:Nome_Offerta)=upper-case($ATTarray/tns5:Richiesta[number($index)]/offerta)]/tns3:ID_Offerta&quot;>&#xa;                &lt;tns4:ID_OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$ListaIdOfferta/tns3:Offerta[upper-case(tns3:Nome_Offerta)=upper-case($ATTarray/tns5:Richiesta[number($index)]/offerta)]/tns3:ID_Offerta&quot;/>&#xa;                &lt;/tns4:ID_OFFERTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns5:Richiesta[number($index)]/created&quot;>&#xa;                &lt;tns4:CREATED>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns5:Richiesta[number($index)]/created&quot;/>&#xa;                &lt;/tns4:CREATED>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:TransactionID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:TransactionID>&#xa;        &lt;/tns4:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Rendezvous" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty5" tibex:xpdlId="8c54cef7-2e59-4eff-b208-9c800f3232e4">
                                <bpws:targets>
                                    <bpws:target linkName="Empty20ToEmpty5"/>
                                    <bpws:target linkName="JDBCQuery5ToEmpty5"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty5ToEmpty11">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($FlagOscuramento/Record[COD_AGESP='R58-20-1339'])>0 and  $FlagOscuramento/Record[COD_AGESP='R58-20-1339']/FLAG_OSCURMENTO='1'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($FlagOscuramento/Record[COD_AGESP='R58-20-1339'])>0 and  $FlagOscuramento/Record[COD_AGESP='R58-20-1339']/FLAG_OSCURMENTO='1']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty5ToAssign12">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="Empty6" tibex:xpdlId="f09c454a-ed03-45bf-b008-6a723045d0e2">
                                <bpws:targets>
                                    <bpws:target linkName="Assign12ToEmpty6"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty6ToToken">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty6ToWhile">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($ATTarray/tns:Richiesta[$index]/ordine/referente)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($ATTarray/tns:Richiesta[$index]/ordine/referente)>0]]></bpws:transitionCondition>
