                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log7-input"
                                    name="Log7"
                                    tibex:xpdlId="8ed194d7-2dcd-409a-b6b5-fec662b1f6d6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
