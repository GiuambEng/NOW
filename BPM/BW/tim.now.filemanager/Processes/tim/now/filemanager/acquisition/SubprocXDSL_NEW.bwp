                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:tns5=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReplaceCharacter1.ReplaceCharacterOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterNameATT-ANN&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderAtt&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderAnn&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Variable&quot;/>&#xa;    &lt;xsl:template name=&quot;CreaRichiestaATT_ANN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Element>&#xa;            &lt;tns4:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns4:moduleName>&#xa;            &lt;tns4:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns4:parameterName>&#xa;            &lt;tns4:parameterName2>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterNameATT-ANN&quot;/>&#xa;            &lt;/tns4:parameterName2>&#xa;            &lt;tns4:operationName>&#xa;                &lt;xsl:value-of select=&quot;$BPMoperationName&quot;/>&#xa;            &lt;/tns4:operationName>&#xa;            &lt;tns4:processName>&#xa;                &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;            &lt;/tns4:processName>&#xa;            &lt;tns4:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderAtt&quot;/>&#xa;            &lt;/tns4:value>&#xa;            &lt;tns4:value2>&#xa;                &lt;xsl:value-of select=&quot;$RenderAnn&quot;/>&#xa;            &lt;/tns4:value2>&#xa;            &lt;tns4:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns5:ID_FILE&quot;/>&#xa;            &lt;/tns4:ID_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ReplaceCharacter1.ReplaceCharacterOutput/tns3:NewString)>0 and $Variable='True'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML, 'ns0:')&quot;>&#xa;                            &lt;tns4:ContenutoXML>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring-before(concat(substring-before($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;ns0:Referente>'),$ReplaceCharacter1.ReplaceCharacterOutput/tns3:NewString,tib:substring-after-last($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;/ns0:Referente>')),'&amp;lt;ns0:Referente>'),&amp;#xD;&amp;#xA;substring-after(tib:substring-before-last(concat(substring-before($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;ns0:Referente>'),$ReplaceCharacter1.ReplaceCharacterOutput/tns3:NewString,tib:substring-after-last($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;/ns0:Referente>')),'&amp;lt;/ns0:Referente>'),'&amp;lt;ns0:Referente>'),&amp;#xD;&amp;#xA;tib:substring-after-last(concat(substring-before($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;ns0:Referente>'),$ReplaceCharacter1.ReplaceCharacterOutput/tns3:NewString,tib:substring-after-last($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;/ns0:Referente>')),'&amp;lt;/ns0:Referente>'))&quot;/>&#xa;                            &lt;/tns4:ContenutoXML>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns4:ContenutoXML>&#xa;                                &lt;xsl:value-of select=&quot;concat(substring-before(concat(substring-before($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;ns01:Referente>'),$ReplaceCharacter1.ReplaceCharacterOutput/tns3:NewString,tib:substring-after-last($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;/ns01:Referente>')),'&amp;lt;ns01:Referente>'),&amp;#xD;&amp;#xA;substring-after(tib:substring-before-last(concat(substring-before($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;ns01:Referente>'),$ReplaceCharacter1.ReplaceCharacterOutput/tns3:NewString,tib:substring-after-last($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;/ns01:Referente>')),'&amp;lt;/ns01:Referente>'),'&amp;lt;ns01:Referente>'),&amp;#xD;&amp;#xA;tib:substring-after-last(concat(substring-before($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;ns01:Referente>'),$ReplaceCharacter1.ReplaceCharacterOutput/tns3:NewString,tib:substring-after-last($ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML,'&amp;lt;/ns01:Referente>')),'&amp;lt;/ns01:Referente>'))&quot;/>&#xa;                            &lt;/tns4:ContenutoXML>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML&quot;>&#xa;                        &lt;tns4:ContenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns2:Richiesta[number($index)]/contenutoXML&quot;/>&#xa;                        &lt;/tns4:ContenutoXML>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns2:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns2:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns2:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]/contenutoXML&quot;>&#xa;                &lt;tns4:ContenutoXML_ANN>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns2:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns2:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns2:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]/contenutoXML&quot;/>&#xa;                &lt;/tns4:ContenutoXML_ANN>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns4:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns2:Richiesta[number($index)]/progressivoRichiestaFile&quot;>&#xa;                &lt;tns4:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns2:Richiesta[number($index)]/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns4:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns2:Richiesta[number($index)]/ambito&quot;>&#xa;                &lt;tns4:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns2:Richiesta[number($index)]/ambito&quot;/>&#xa;                &lt;/tns4:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns2:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns2:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns2:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]/progressivoRichiestaFile&quot;>&#xa;                &lt;tns4:ProgressivoRichiestaFileAnn>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns2:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns2:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns2:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns4:ProgressivoRichiestaFileAnn>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns4:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&#xa;            &lt;/tns4:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&#xa;                &lt;tns4:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns4:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
