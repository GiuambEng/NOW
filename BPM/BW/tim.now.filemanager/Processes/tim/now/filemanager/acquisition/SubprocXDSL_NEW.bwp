nsione/ns01:ReferenteDesospensione/ns01:TelefonoMobileReferente&quot;/>&#xa;                                &lt;/telefonoMobileReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;flag_Token>&#xa;                                &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                            &lt;/flag_Token>&#xa;                        &lt;/ns:ReferenteElement>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ReferenteElement>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($NORMALarray/ns01:Richiesta[number($index)]/ns01:TipoRichiesta/ns01:Comunicazione/ns01:InterruzioneSospensione)&quot;>&#xa;                                    &lt;tipoReferenteOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                                    &lt;/tipoReferenteOrdine>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tipoReferenteOrdine>&#xa;