                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Contatori"
                                    name="ContatoriATT"
                                    outputVariable="Contatori"
                                    tibex:xpdlId="aa604dae-3562-4578-8a89-457c8752fe99" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CambioAmbitoToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ContatoriATTToRenderXml"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;CallLocatorATT&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns:StringaCRMWS,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns:StringaCRMWS&quot;/>&lt;/tns:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorATT/tns1:Risposta/tns1:RC=&amp;quot;09&amp;quot; or $CallLocatorATT/tns1:Risposta/tns1:RC=&amp;quot;10&amp;quot; or $CallLocatorATT/tns1:Risposta/tns1:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns:StringaSDR,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns:StringaSDR&quot;/>&lt;/tns:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns:StringaDBCFX&quot;/>&lt;/tns:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns:ContatoreCRMWS+1)&quot;/>&lt;/tns:ContatoreCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ContatoreCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns:ContatoreCRMWS&quot;/>&lt;/tns:ContatoreCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Contatori/tns:ContatoreWSDP&quot;>&lt;tns:ContatoreWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns:ContatoreWSDP&quot;/>&lt;/tns:ContatoreWSDP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorATT/tns1:Risposta/tns1:RC=&amp;quot;09&amp;quot; or $CallLocatorATT/tns1:Risposta/tns1:RC=&amp;quot;10&amp;quot; or $CallLocatorATT/tns1:Risposta/tns1:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns:ContatoreSDR+1)&quot;/>&lt;/tns:ContatoreSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ContatoreSDR>&lt;xsl:value-of select=&quot;$Contatori/tns:ContatoreSDR&quot;/>&lt;/tns:ContatoreSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ContatoreDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns:ContatoreDBCFX&quot;/>&lt;/tns:ContatoreDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&lt;tns:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns:ContatoreNOW+1)&quot;/>&lt;/tns:ContatoreNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ContatoreNOW>&lt;xsl:value-of select=&quot;$Contatori/tns:ContatoreNOW&quot;/>&lt;/tns:ContatoreNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns1:Risposta/tns1:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&lt;tns:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns:ContatoreKO+1)&quot;/>&lt;/tns:ContatoreKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ContatoreKO>&lt;xsl:value-of select=&quot;$Contatori/tns:ContatoreKO&quot;/>&lt;/tns:ContatoreKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
