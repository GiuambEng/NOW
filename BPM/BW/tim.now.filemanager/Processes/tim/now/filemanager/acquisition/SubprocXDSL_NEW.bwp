gurazioneAccesso/ns01:DatiVC))) or (string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:Caratteristica)>0 and not(string-length($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:ProfiloTecnicoLinea)>0) and not(exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso/ns01:DatiVC)))) and exists($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:TipoVariazione/ns01:RiconfigurazioneAccesso[1])&quot;>&#xa;                                                        &lt;tipologiaSottolav>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;RICONFIGURAZIONEVC&amp;quot;&quot;/>&#xa;                                                        &lt;/tipologiaSottolav>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:TipoVariazione/ns01:IncrementoDecrementoVC)&quot;>&#xa;                                                        &lt;tipologiaSottolav>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;INCREMENTODECREMENTOVC&amp;quot;&quot;/>&#xa;                                                        &lt;/tipologiaSottolav>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/node()/ns01:TipoVariazione/ns01:CambioSla)&quot;>&#xa;                                                        &lt;tipologiaSottolav>&#xa;                                                            &lt;xsl:value-of select=&quot;&amp;quot;CAMBIOSLA&amp;quot;&quot;/>&#xa;                                                        &lt;/tipologiaSottolav>&#xa;                                                    &lt;/xsl:when>&#xa;                                                    &lt;xsl:otherwise/>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:NP/ns01:RoutingNumberRecipient)>0&quot;>&#xa;                                            &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:NP/ns01:RoutingNumberRecipient&quot;>&#xa;                                                &lt;routingNumber>&#xa;                                                    &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:NP/ns01:RoutingNumberRecipient&quot;/>&#xa;                                                &lt;/routingNumber>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;count($FlagOscuramento/Record[COD_AGESP='R1I-19-0175'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-19-0175']/FLAG_OSCURMENTO='1'&quot;/>&#xa;                                            &lt;xsl:when test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Migrazione) and exists($rich/ns01:TipoRichiesta/ns01:Migrazione/ns01:MigrazioneOLO) and upper-case($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:DatiMigrazione/ns01:CodiceSessione1)='CAMBIOTECNOLOGIA' and string-length($rich/ns01:Testata/ns01:CodiceProgetto)>0&quot;>&#xa;                                                &lt;cambioTecnologia>&#xa;                                                    &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                                                &lt;/cambioTecnologia>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns:RichiestaElement>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ns:RichiestaElement>&#xa;                                        &lt;created>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/created>&#xa;                                        &lt;lastUpdate>&#xa;                                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                                        &lt;/lastUpdate>&#xa;                                        &lt;operatore>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                                        &lt;/operatore>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;statoRichiestaNOW>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;                                        &lt;/statoRichiestaNOW>&#xa;                                        &lt;statoRichiestaPrecedNOW>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;                                        &lt;/statoRichiestaPrecedNOW>&#xa;                                        &lt;IDFileInput>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(../../tns2:ID_FILE)&quot;/>&#xa;                                        &lt;/IDFileInput>&#xa;                                        &lt;ambito>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                                        &lt;/ambito>&#xa;                                        &lt;canaleRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;                                        &lt;/canaleRichiesta>&#xa;                                        &lt;lavorazione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                                        &lt;/lavorazione>&#xa;                                        &lt;progressivoRichiestaFile>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                                        &lt;/progressivoRichiestaFile>&#xa;                                        &lt;strutturaRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;                                        &lt;/strutturaRichiesta>&#xa;                                        &lt;tipoRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&#xa;                                        &lt;/tipoRichiesta>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length(../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns3:CodiceOLOAGCOM)>0&quot;>&#xa;                                                &lt;codificaOLOAGCOM>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns3:CodiciOlo/tns3:codes[tns3:CodiceOLO=$rich/ns01:Testata/ns01:CodiceOlo]/tns3:CodiceOLOAGCOM&quot;/>&#xa;                                                &lt;/codificaOLOAGCOM>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;codificaOLOAGCOM>&#xa;                                                    &lt;xsl:value-of select=&quot;../../tns2:CodOLOdaNome&quot;/>&#xa;                                                &lt;/codificaOLOAGCOM>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;codificaOLONOW>&#xa;                                            &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                                        &lt;/codificaOLONOW>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                                            &lt;codiceOrdineOLO>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                                            &lt;/codiceOrdineOLO>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineOlo)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineOlo&quot;>&#xa;                                                    &lt;codiceOrdineOLOTarget>&#xa;                                                        &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineOlo&quot;/>&#xa;                                                    &lt;/codiceOrdineOLOTarget>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                                            &lt;codiceOrdineOLOPadre>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;/>&#xa;                                            &lt;/codiceOrdineOLOPadre>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineRiferimentoTI)>0&quot;>&#xa;                                                &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineRiferimentoTI&quot;>&#xa;                                                    &lt;codiceOrdineTITarget>&#xa;                                                        &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:Annullamento/ns01:CodiceOrdineRiferimentoTI&quot;/>&#xa;                                                    &lt;/codiceOrdineTITarget>&#xa;                                                &lt;/xsl:if>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise/>&#xa;                                        &lt;/xsl:choose>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                                            &lt;codiceProgetto>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceProgetto&quot;/>&#xa;                                            &lt;/codiceProgetto>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;dataInvioRichiesta>&#xa;                                            &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../tns2:DATA_FILE), 1, 10))&quot;/>&#xa;                                        &lt;/dataInvioRichiesta>&#xa;                                        &lt;contenutoXML>&#xa;                                            &lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&#xa;                                        &lt;/contenutoXML>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:Note&quot;>&#xa;                                            &lt;note>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:Note&quot;/>&#xa;                                            &lt;/note>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;IDRichiestaLocalizzatore>&#xa;                                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                        &lt;/IDRichiestaLocalizzatore>&#xa;                                        &lt;xsl:if test=&quot;ns01:Testata/ns01:TestMode&quot;>&#xa;                                            &lt;testMode>&#xa;                                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:TestMode&quot;/>&#xa;                                            &lt;/testMode>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;DRO>&#xa;                                            &lt;xsl:value-of select=&quot;../../tns2:NextWorkingDate&quot;/>&#xa;                                        &lt;/DRO>&#xa;                                        &lt;xsl:if test=&quot;../../tns2:CodAGCOMint&quot;>&#xa;                                            &lt;codificaOLOAGCOMRic>&#xa;                                                &lt;xsl:value-of select=&quot;../../tns2:CodAGCOMint&quot;/>&#xa;                                            &lt;/codificaOLOAGCOMRic>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/ns:RichiestaElement>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/ns3:RichiesteATT_ANN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RTYPE=&amp;quot;ALT&amp;quot;&quot;>&#xa;                        &lt;ns01:TracciatoOLOxDSL>&#xa;                            &lt;xsl:copy-of select=&quot;$rich&quot;/>&#xa;                        &lt;/ns01:TracciatoOLOxDSL>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$RTYPE=&amp;quot;ALT&amp;quot;&quot;>&#xa;                        &lt;ns3:ProgressiviAlt>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&#xa;                        &lt;/ns3:ProgressiviAlt>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns3:Richieste>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/ns3:RichiesteOLOSuddivise>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
