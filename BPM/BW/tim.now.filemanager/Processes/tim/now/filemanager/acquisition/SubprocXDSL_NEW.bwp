                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;tns3:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns3:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns3:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns3:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/offerta&quot;>&#xa;                    &lt;tns3:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/offerta&quot;/>&#xa;                    &lt;/tns3:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns3:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns3:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns3:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns3:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1][qualificaReferente='CF'])&quot;>&#xa;                        &lt;tns3:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns3:FlagReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns3:FlagReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:RequestVerificaRollout>&#xa;            &lt;tns3:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns3:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns3:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns3:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns3:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns3:Funzione>&#xa;                &lt;tns3:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATT-ANNArray/tns4:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns3:ChiaveRiferimento>&#xa;                &lt;tns3:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns3:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns2:IPAddress&quot;>&#xa;                    &lt;tns3:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns2:IPAddress&quot;/>&#xa;                    &lt;/tns3:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;>&#xa;                    &lt;tns3:N_Recap_Cliente>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;/>&#xa;                    &lt;/tns3:N_Recap_Cliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;>&#xa;                    &lt;tns3:N_Recap_Cliente_ALT>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;/>&#xa;                    &lt;/tns3:N_Recap_Cliente_ALT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;>&#xa;                    &lt;tns3:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;/>&#xa;                    &lt;/tns3:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;>&#xa;                    &lt;tns3:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;/>&#xa;                    &lt;/tns3:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns3:RequestCreate_token>&#xa;            &lt;tns3:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns3:ProcessIstance>&#xa;            &lt;tns3:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'XDSL'&quot;/>&#xa;            &lt;/tns3:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ATTarray/tns4:Richiesta[$index]/codiceSessione)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceSessione&quot;>&#xa;                        &lt;tns3:NumeroLinea>&#xa;                            &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceSessione&quot;/>&#xa;                        &lt;/tns3:NumeroLinea>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($ATTarray/tns4:Richiesta[$index]/codiceSessione2)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceSessione2&quot;>&#xa;                        &lt;tns3:NumeroLinea>&#xa;                            &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/codiceSessione2&quot;/>&#xa;                        &lt;/tns3:NumeroLinea>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/offerta&quot;>&#xa;                &lt;tns3:OffertaBPM>&#xa;                    &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns4:Richiesta[$index]/offerta&quot;/>&#xa;                &lt;/tns3:OffertaBPM>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log4-input"
                                    name="Log4"
                                    tibex:xpdlId="3bc05bbb-3aaf-4872-848f-ef46096d8033" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign15ToLog4"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log4ToGroupEnd3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Log4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(' Accumulo Token',tib:render-xml($Referente,true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log5-input"
                                    name="Log5"
                                    tibex:xpdlId="36c1e8a7-9454-4c87-a84e-425de6598177" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token3ToLog5"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log5ToGroupEnd3"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;Log5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubprocXDSL_NEW | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat($_error/StackTrace, $_error/Msg,$_error/FullClass,$_error/Class,$_error/ProcessStack,$_error/MsgCode)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns2:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Referente"
                                    name="Assign15"
                                    outputVariable="Referente"
                                    tibex:xpdlId="598debbc-a9f5-49b3-86a6-8192d21463e7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token3ToAssign15"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign15ToLog4"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token3&quot;/>&#xa;    &lt;xsl:template name=&quot;Referente&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;xsl:copy-of select=&quot;$Referente/tns4:Request&quot;/>&#xa;            &lt;tns4:Request>&#xa;                &lt;xsl:if test=&quot;$Token3/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                    &lt;tns4:Token>&#xa;                        &lt;xsl:value-of select=&quot;$Token3/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                    &lt;/tns4:Token>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token3/tns2:ResponseCreate_token/tns2:ESITO&quot;>&#xa;                    &lt;tns4:Esito>&#xa;                        &lt;xsl:value-of select=&quot;$Token3/tns2:ResponseCreate_token/tns2:ESITO&quot;/>&#xa;                    &lt;/tns4:Esito>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token3/tns2:ResponseCreate_token/tns2:DESCRIZIONE&quot;>&#xa;                    &lt;tns4:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;$Token3/tns2:ResponseCreate_token/tns2:DESCRIZIONE&quot;/>&#xa;                    &lt;/tns4:Descrizione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns3:Richiesta[$index]/ordine/referente[$index1]&quot;>&#xa;                    &lt;tns4:Referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;tipoReferenteOrdine&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                            &lt;qualificaReferente>&#xa;                                &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                            &lt;/qualificaReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Token3/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token3/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Token3/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token3/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token3/tns2:ResponseCreate_token/tns2:Token)>0 and string-length(telefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token3/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token3/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token3/tns2:ResponseCreate_token/tns2:Token)>0 and string-length(telefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token3/tns2:ResponseCreate_token/tns2:Token&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token3/tns2:ResponseCreate_token/tns2:Token&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                            &lt;emailReferente>&#xa;                                &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                            &lt;/emailReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:Referente>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns4:Request>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>

