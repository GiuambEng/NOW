                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ReferenteDesospensione/&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token6&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper7-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ReferenteDesospensione>&#xa;            &lt;tns2:QualificaRef>&#xa;                &lt;xsl:value-of select=&quot;$NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:QualificaRef&quot;/>&#xa;            &lt;/tns2:QualificaRef>&#xa;            &lt;tns2:CognomeReferente>&#xa;                &lt;xsl:value-of select=&quot;$Token6/tns3:ResponseCreate_token/tns3:CognomeRagioneSociale&quot;/>&#xa;            &lt;/tns2:CognomeReferente>&#xa;            &lt;xsl:if test=&quot;$Token6/tns3:ResponseCreate_token/tns3:Nome&quot;>&#xa;                &lt;tns2:NomeReferente>&#xa;                    &lt;xsl:value-of select=&quot;$Token6/tns3:ResponseCreate_token/tns3:Nome&quot;/>&#xa;                &lt;/tns2:NomeReferente>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($NORMALarray/ns0:Richiesta[$index]/ns0:TipoRichiesta/ns0:Comunicazione/ns0:InterruzioneSospensione/ns0:ReferenteDesospensione/ns0:TelefonoFissoReferente)>0 and string-length($Token6/tns3:ResponseCreate_token/tns3:Token)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$Token6/tns3:ResponseCreate_token/tns3:Token&quot;>&#xa;                    &lt;tns2:TelefonoFissoReferente>&#xa;                        &lt;xsl:value-of select=&quot;$Token6/tns3:ResponseCreate_