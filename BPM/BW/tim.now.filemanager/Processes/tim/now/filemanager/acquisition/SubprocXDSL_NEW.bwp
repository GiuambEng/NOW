st=&quot;string-length($rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:CancellazioneAccodamento/node()/ns01:TI)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:CancellazioneAccodamento/node()/ns01:TI&quot;>&#xa;                        &lt;codiceOrdineTITarget>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:TipoRichiesta/ns01:Comunicazione/ns01:CancellazioneAccodamento/node()/ns01:TI&quot;/>&#xa;                        &lt;/codiceOrdineTITarget>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:CodiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string($Start/tns2:DATA_FILE), 1, 10))&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;contenutoXML>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&#xa;            &lt;/contenutoXML>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;matches($rich/ns01:Testata/ns01:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;translate($rich/ns01:Testata/ns01:Note, '0123456789', '         ')&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$rich/ns01:Testata/ns01:Note&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;$rich/ns01:Testata/ns01:Note&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMAsimm) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBEAsimm) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPBasePlus) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:EasyIPSpecialProfile) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamATMSimm) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Variazione/ns01:BitstreamGBESimm) or&amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMAsimmetricoFlat) or exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMAsimmetricoHL) or exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMAsimmetricoLite) or exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamGBEAsimmetricoFlat) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMSimmetricoHL) or exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamATMSimmetricoFlat) or exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:BitstreamGBESimmetricoFlat) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:EasyIPBasePlusFlat) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:EasyIPBasePlusLite) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:EasyIPSpecialProfileFlat) or &amp;#xD;&amp;#xA;exists($rich/ns01:TipoRichiesta/ns01:Cessazione/ns01:EasyIPSpecialProfileLite) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/ns01:BitstreamATMAsimmetricoFlat) or exists($rich/ns01:TipoRichiesta/ns01:Migrazione/node()/ns01:Servizio/ns01:BitstreamATMAsimmetricoHL) or exists($rich/ns01:TipoRichiesta/ns01:Migraz