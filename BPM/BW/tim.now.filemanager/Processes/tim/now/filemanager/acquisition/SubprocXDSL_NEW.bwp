            <bpws:scope name="ATT" tibex:group="while" tibex:xpdlId="b0e664df-11b0-4d90-a3a3-51180dd0e79a">
                <bpws:targets>
                    <bpws:target linkName="SortToWhile"/>
                    <bpws:target linkName="ATT_ANNToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ATTToWhile"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable element="ns2:RichiestaElement" name="Richiesta"/>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;= $ContaRichieste/tns1:ATT" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<= $ContaRichieste/tns1:ATT]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="ArricchimentoRichiestaATTToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallLocatorATTToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="ArricchimentoRichiestaATTToContatoreNOWatt" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="CallLocatorATTToAssign1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CambioAmbitoToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ContatoreNOWattToRenderXml" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="ContatoriATTToRenderXml" tibex:linkType="SUCCESS"/>
