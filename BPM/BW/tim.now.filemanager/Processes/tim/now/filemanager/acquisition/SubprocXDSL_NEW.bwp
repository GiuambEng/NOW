                <bpws:link name="AssignToLog" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartSubprocXDSL_NEWToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToLog1" tibex:linkType="SUCCESS"/>
