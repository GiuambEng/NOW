                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ParseXml-input"
                                    name="ParseXml"
                                    outputVariable="ParseXml"
                                    tibex:xpdlId="44bc3e73-ab53-4c85-a125-43c840c243ea" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token7ToAssign16"/>
                                    <bpws:target linkName="Assign7ToParseXml"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ParseXmlToAssign16"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:xmlString>&#xa;            &lt;xsl:value-of select=&quot;$ATTarray/tns3:Richiesta[$index]/contenutoXML&quot;/>&#xa;        &lt;/tns2:xmlString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.parsexml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:order="http://xsd.telecomitalia.it/crm/xdsl/order"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//ParseXml"/>
                                    <value
                                    inputStyle="text"
                                    outputElementQName="order:Richiesta" xsi:type="palettexml:ParseXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderXml-input"
                                    name="RenderXml"
                                    outputVariable="RenderXml"
                                    tibex:xpdlId="fff431a7-3b00-49ae-99c9-4dd37c87bcbf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ParseXmlToAssign16"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXmlToAssign16"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXml&quot;/>&#xa;    &lt;xsl:param name=&quot;Token7&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:Richiesta>&#xa;            &lt;ns0:Testata>&#xa;                &lt;ns0:CodiceOlo>&#xa;                    &lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceOlo&quot;/>&#xa;                &lt;/ns0:CodiceOlo>&#xa;                &lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOlo&quot;>&#xa;                    &lt;ns0:CodiceOrdineOlo>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOlo&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOlo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;>&#xa;                    &lt;ns0:CodiceOrdineOloPadre>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceOrdineOloPadre&quot;/>&#xa;                    &lt;/ns0:CodiceOrdineOloPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:CodiceProgetto&quot;>&#xa;                    &lt;ns0:CodiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:CodiceProgetto&quot;/>&#xa;                    &lt;/ns0:CodiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;matches($ParseXml/ns0:Testata/ns0:Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;                        &lt;ns0:Note>&#xa;                            &lt;xsl:value-of select=&quot;translate($ParseXml/ns0:Testata/ns0:Note, '0123456789', '         ')&quot;/>&#xa;                        &lt;/ns0:Note>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:Note&quot;>&#xa;                            &lt;ns0:Note>&#xa;                                &lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:Note&quot;/>&#xa;                            &lt;/ns0:Note>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:TestMode&quot;>&#xa;                    &lt;ns0:TestMode>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:TestMode&quot;/>&#xa;                    &lt;/ns0:TestMode>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseXml/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;>&#xa;                    &lt;ns0:ReferentiOAOProgettiSpeciali>&#xa;                        &lt;xsl:value-of select=&quot;$ParseXml/ns0:Testata/ns0:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                    &lt;/ns0:ReferentiOAOProgettiSpeciali>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns0:Testata>&#xa;            &lt;ns0:TipoRichiesta>&#xa;                &lt;ns0:Attivazione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat)&quot;>&#xa;                            &lt;ns0:BitstreamATMAsimmetricoFlat>&#xa;                                &lt;ns0:Accesso>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists($ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS)&quot;>&#xa;                                            &lt;ns0:LineaPOTS>&#xa;                                                &lt;xsl:copy-of select=&quot;$ParseXml/ns0:TipoRichiesta/ns0:Attivazione/ns0:BitstreamATMAsimmetricoFlat/ns0:Accesso/ns0:LineaPOTS/ns0:DatiSede&quot;/>&#xa;                                                &lt;ns0:ClienteFinale>&#xa;                                                    &lt;ns0:CognomeRagSoc>&#xa;                                                        &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                                                    &lt;/ns0:CognomeRagSoc>&#xa;                                                    &lt;xsl:if test=&quot;$Token7/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                                                        &lt;ns0:Nome>&#xa;                                                            &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                                                        &lt;/ns0:Nome>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;string-length($Token7/tns2:ResponseCreate_token/tns2:CodiceFiscale)>0&quot;>&#xa;                                                            &lt;ns0:CF>&#xa;                                                                &lt;xsl:value-of select=&quot;$Token7/tns2:ResponseCreate_token/tns2:CodiceFiscale&quot;/>&#xa;                                                            &lt;/ns0:CF>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns0:PIVA>&#xa;                                                                &l