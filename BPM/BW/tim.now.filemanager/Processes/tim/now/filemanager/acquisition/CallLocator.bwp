    <bpws:partnerLinks>
        <bpws:partnerLink name="SystemLocatorPortType"
            partnerLinkType="ns0:partnerLinkType" partnerRole="use"
            sca-bpel:ignore="true"
            sca-bpel:reference="SystemLocatorPortType" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceBinding>
                <tibex:binding>
                    <bwbinding:BWBaseBinding
                        xmlns:SystemLocator="http://www.tim.com/NOW/binding/SystemLocator/"
                        xmlns:SystemLocator_1="http://www.tim.com/NOW/xsd/SystemLocator/"
                        xmlns:axis2="http://xsd.tns.tibco.com/bw/models/binding/soap/axis2"
                        xmlns:bwbinding="http://tns.tibco.com/bw/model/core/bwbinding"
                        xmlns:pt="http://www.tim.com/NOW/wsdl/abstract/SystemLocator/"
                        xmlns:sca="http://www.osoa.org/xmlns/sca/1.0"
                        xmlns:scact="http://xsd.tns.tibco.com/amf/models/sca/componentType"
                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding name="SystemLocatorPortType" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://www.tim.com/NOW/wsdl/abstract/SystemLocator/#wsdl.interface(SystemLocatorPortType)" scaext:wsdlLocation="../../../../../Service%20Descriptors/SystemLocator/SystemLocator.wsdl"/>
                            <scaext:binding
                                locationURI="https://localhost:8082/SystemLocator_SOAPService/systemLocatorPortType_v1/"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
                                portName="SystemLocatorPortTypeSOAP"
                                portTypeQName="pt:SystemLocatorPortType"
                                portTypeWSDLLocation="platform:/resource/tim.now.filemanager/Service%20Descriptors/SystemLocator/SystemLocator.wsdl"
                                serviceBindingQName="SystemLocator:SOAPServiceBinding"
                                serviceQName="SystemLocator:SystemLocatorPortType"
                                transportBindingType="HTTP"
                                wsdlLocation="platform:/resource/tim.now.filemanager/Service%20Descriptors/SystemLocator/SystemLocator_concrete.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="GetSystem" operationName="GetSystem">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:GetSystemRequest" wsdlLocation="platform:/resource/tim.now.filemanager/Service%20Descriptors/SystemLocator/SystemLocator.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="SystemLocator_1:RichiestaLocalizzatore"
                                    partName="RichiestaLocalizzatore" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    messageDirection="OUTPUT"
                                    messageQName="pt:GetSystemResponse" wsdlLocation="platform:/resource/tim.now.filemanager/Service%20Descriptors/SystemLocator/SystemLocator.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="SystemLocator_1:RispostaLocalizzatore"
                                    partName="RispostaLocalizzatore" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration action="fault"
                                    messageDirection="FAULT"
                                    messageQName="pt:GetSystemFault" wsdlLocation="platform:/resource/tim.now.filemanager/Service%20Descriptors/SystemLocator/SystemLocator.wsdl">
                                    <messagePartConfigurations
                                    partElementName="SystemLocator_1:Fault"
                                    partName="Fault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    <faultMappings direction="FAULT" faultName="fault"/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    httpClient="tim.now.filemanager.acquisition.Locator_HttpClient" xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding">
                                <sca:property name="endpointURI" scaext:simpleValue="/Connection/HTTP/SystemLocator/URI"/>
                            </scact:bindingAdjunct>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
