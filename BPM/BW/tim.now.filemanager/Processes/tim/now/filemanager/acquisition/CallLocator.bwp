                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SystemLocator&quot;/>&lt;xsl:template name=&quot;RispostaLocalizzatore&quot; match=&quot;/&quot;>&lt;tns:RispostaLocalizzatore>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Testata)&quot;>&lt;xsl:copy-of select=&quot;$SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Testata&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;$Start/tns:Testata&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:SistemaDiCompetenza)>0 and $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:SistemaDiCompetenza!=&amp;quot;KO&amp;quot;&quot;>&lt;xsl:copy-of select=&quot;$SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns:Richiesta/tns:CodiceOLO=&amp;quot;TLC&amp;quot; or $Start/tns:Richiesta/tns:CodiceISP=&amp;quot;002&amp;quot;) and ($SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;02&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;03&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;05&amp;quot;or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;07&amp;quot;or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;09&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;10&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;11&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;12&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;13&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;14&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;21&amp;quot;)&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;$SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:DataRisposta&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;09&amp;quot;&quot;/>&lt;/tns:RC>&lt;tns:ErrMSG>&lt;xsl:value-of select=&quot;&amp;quot;Codice d'errore convenzionale&amp;quot;&quot;/>&lt;/tns:ErrMSG>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Richiesta/tns:Richiesta=&amp;quot;TIPO_COMUNICAZIONE_3&amp;quot; and ($SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;99&amp;quot; or $SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;18&amp;quot;)&quot;>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:value-of select=&quot;$SystemLocator/RispostaLocalizzatore/tns:RispostaLocalizzatore/tns:Risposta/tns:DataRisposta&quot;/>&lt;/tns:DataRisposta>&lt;tns:SistemaDiCompetenza>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:SistemaDiCompetenza>&lt;tns:RC>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:RC>&lt;/tns:Risposta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Risposta>&lt;tns:DataRisposta>&lt;xsl:valu