                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions" xmlns:tns1="http://www.tim.com/NOW/xsd/SystemLocator/" xmlns:tns2="http://www.tim.com/NOW/xsd/SystemLocatorInterface/" version="2.0"&gt;&lt;xsl:param name="SystemLocator"/&gt;&lt;xsl:template name="Throw-input" match="/"&gt;&lt;tns:DefaultFault&gt;&lt;message&gt;&lt;xsl:value-of select="concat(&amp;quot;Sistema di competenza: &amp;quot;, $SystemLocator/RispostaLocalizzatore/tns2:RispostaLocalizzatore/tns2:Risposta/tns2:SistemaDiCompetenza, &amp;quot;&amp;#xD;&amp;#xA;RC: &amp;quot;, $SystemLocator/RispostaLocalizzatore/tns2:RispostaLocalizzatore/tns2:Risposta/tns2:RC)"/&gt;&lt;/message&gt;&lt;/tns:DefaultFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
