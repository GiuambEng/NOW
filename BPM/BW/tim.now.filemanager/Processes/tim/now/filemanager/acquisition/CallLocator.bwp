                                    <tibex:expression
                                    expression="$SystemLocator/RispostaLocalizzatore/ns6:RispostaLocalizzatore/ns6:Risposta/ns6:SistemaDiCompetenza = &quot;KO&quot; and ($SystemLocator/RispostaLocalizzatore/ns6:RispostaLocalizzatore/ns6:Risposta/ns6:RC = &quot;01&quot; or $SystemLocator/RispostaLocalizzatore/ns6:RispostaLocalizzatore/ns6:Risposta/ns6:RC = &quot;02&quot;) and $index&lt;$MaxRetrials" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$SystemLocator.RispostaLocalizzatore/ns6:Risposta/ns6:SistemaDiCompetenza = "KO" and ($SystemLocator.RispostaLocalizzatore/ns6:Risposta/ns6:RC = "01" or $SystemLocator.RispostaLocalizzatore/ns6:Risposta/ns6:RC = "02") and $index<$MaxRetrials]]></bpws:transitionCondition>
