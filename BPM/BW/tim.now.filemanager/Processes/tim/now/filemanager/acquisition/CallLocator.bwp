    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToRepeatOnError" tibex:linkType="SUCCESS"/>
                <bpws:link name="RepeatOnErrorToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToRepeatOnError" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToAssign_NOW" tibex:label="NOW" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="AssignToLogOutput" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="c377b67b-389b-4019-ae03-a990de4a8c60"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToRepeatOnError"/>
                    </bpws:sources>
                    <tibex:eventSource>
