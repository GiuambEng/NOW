                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SystemLocator.RispostaLocalizzatore&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RispostaLocalizzatore&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RispostaLocalizzatore>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SystemLocator.RispostaLocalizzatore/tns:Testata)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$SystemLocator.RispostaLocalizzatore/tns:Testata&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:copy-of select=&quot;$Start/tns:Testata&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($SystemLocator.RispostaLocalizzatore/tns:Risposta/tns:SistemaDiCompetenza)>0 and $SystemLocator.RispostaLocalizzatore/tns:Risposta/tns:SistemaDiCompetenza!=&amp;quot;KO&amp;quot;&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$SystemLocator.RispostaLocalizzatore/tns:Risposta&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($Start/tns:Richiesta/tns:CodiceOLO=&amp;quot;TLC&amp;quot; or $Start/tns:Richiesta/tns:CodiceISP=&amp;quot;002&amp;quot;) and ($SystemLocator.RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;02&amp;quot; or $SystemLocator.RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;03&amp;quot; or $SystemLocator.RispostaLocalizzatore/tns:Risposta/tns:RC=&amp;quot;05&amp;quot;or $SystemLocator.RispostaLocalizzatore/tns:Risposta/tn