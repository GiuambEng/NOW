                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SystemLocator/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SystemLocator.RispostaLocalizzatore&quot;/>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Sistema di competenza: &amp;quot;, $SystemLocator.RispostaLocalizzatore/tns2:Risposta/tns2:SistemaDiCompetenza, &amp;quot;&amp;#xD;&amp;#xA;RC: &amp;quot;, $SystemLocator.RispostaLocalizzatore/tns2:Risposta/tns2:RC)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
