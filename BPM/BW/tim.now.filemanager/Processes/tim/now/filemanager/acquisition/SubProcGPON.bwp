                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns=&quot;http://www.example.org/GPONstart&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIDOffarray&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ATTarray/tns1:Richiesta[number($index)]/codificaOLOAGCOM) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[number($index)]/codificaOLOAGCOM&quot;>&#xa;                        &lt;tns3:CODFC_OLO_AGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns3:CODFC_OLO_AGCOM>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:CODFC_OLO_AGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodOLOdaNome&quot;/>&#xa;                    &lt;/tns3:CODFC_OLO_AGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$ListaIDOffarray/tns2:Offerta[upper-case(tns2:Nome_Offerta)=upper-case($ATTarray/tns1:Richiesta[number($index)]/offerta)]/tns2:ID_Offerta&quot;>&#xa;                &lt;tns3:ID_OFFERTA>&#xa;                    &lt;xsl:value-of select=&quot;$