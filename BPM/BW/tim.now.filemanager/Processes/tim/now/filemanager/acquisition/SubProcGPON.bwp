            </bpws:empty>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="05914dd2-79bd-444d-9aec-1a1bd28da6b6">
                <bpws:targets>
                    <bpws:target linkName="EmptyToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToAssign1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ContaRichieste/ns13:ATT>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$ContaRichieste/ns13:ATT>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="WhileToWhile2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=$ContaRichieste/ns13:ATT_ANN" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=$ContaRichieste/ns13:ATT_ANN]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToEmpty15" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="ArricchimentoATTToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToEmpty3" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty3ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToArricchimentoATT" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToToken2" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty4ToWhile1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="Token2ToArricchimentoAttivazione" tibex:linkType="SUCCESS"/>
