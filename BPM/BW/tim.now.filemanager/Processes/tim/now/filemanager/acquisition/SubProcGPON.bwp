                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source
                                    linkName="Token1ToLog12"
                                    tibex:faultDetailsVar="Token1" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Request>&#xa;            &lt;tns10:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns10:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns10:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                    &lt;tns10:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                    &lt;/tns10:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ATTarray/tns1:Richiesta[$index]/offerta='EASYIPNGAFTTCAB'&quot;>&#xa;                        &lt;tns10:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                        &lt;/tns10:Offerta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ATTarray/tns1:Richiesta[$index]/offerta=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                        &lt;tns10:Offerta>&#xa;                            &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                        &lt;/tns10:Offerta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;>&#xa;                            &lt;tns10:Offerta>&#xa;                                &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;/>&#xa;                            &lt;/tns10:Offerta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns10:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns10:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns10:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns10:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1][qualificaReferente='CF'])&quot;>&#xa;                        &lt;tns10:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns10:FlagReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns10:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns10:FlagReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns10:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns10:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns10:RequestVerificaRollout>&#xa;            &lt;tns10:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns10:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns10:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns10:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns10:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns10:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns10:Funzione>&#xa;                &lt;tns10:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns10:ChiaveRiferimento>&#xa;                &lt;tns10:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns10:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns9:IPAddress&quot;>&#xa;                    &lt;tns10:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns9:IPAddress&quot;/>&#xa;                    &lt;/tns10:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;>&#xa;                    &lt;tns10:N_Recap_Cliente>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;/>&#xa;                    &lt;/tns10:N_Recap_Cliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;>&#xa;                    &lt;tns10:N_Recap_Cliente_ALT>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;/>&#xa;                    &lt;/tns10:N_Recap_Cliente_ALT>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns10:RequestCreate_token>&#xa;            &lt;tns10:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns10:ProcessIstance>&#xa;            &lt;tns10:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NGA'&quot;/>&#xa;            &lt;/tns10:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codiceSessione&quot;>&#xa;                &lt;tns10:NumeroLinea>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codiceSessione&quot;/>&#xa;                &lt;/tns10:NumeroLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;>&#xa;                &lt;tns10:OffertaBPM>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;/>&#xa;                &lt;/tns10:OffertaBPM>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns10:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log10-input"
                                    name="Log10"
                                    tibex:xpdlId="4c30e694-db94-42b8-9072-684334e0ca24" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
