                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($ATT-ANNArray/ns0:Richiesta[$index]/ordine/referente[not(telefonoFissoReferente='3333333333') and not(telefonoMobileReferente='3333333333')])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($ATT-ANNArray/ns0:Richiesta[$index]/ordine/referente[not(telefonoFissoReferente='3333333333') and not(telefonoMobileReferente='3333333333')])]]></bpws:condition>
