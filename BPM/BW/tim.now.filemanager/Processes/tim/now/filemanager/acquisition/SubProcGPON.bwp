                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.example.org/GPONstart&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Invoke3.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIDOffarray&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDescrComune&quot;/>&#xa;    &lt;xsl:param name=&quot;CallProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery1&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagDataDAI&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns1:Richiesta[number($index)]&quot;>&#xa;            &lt;ns1:RichiestaElement>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                    &lt;statoRichiestaPrecedOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                    &lt;/statoRichiestaPrecedOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                    &lt;sottostatoLavorManuale>&#xa;                        &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                    &lt;/sottostatoLavorManuale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                    &lt;IDFileInput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                    &lt;/IDFileInput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                    &lt;IDFileOutput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                    &lt;/IDFileOutput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;ambito&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:if>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;xsl:if test=&quot;lavorazione&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;lavorazione&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&#xa;                    &lt;progressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&#xa;                    &lt;/progressivoRichiestaFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(codificaOLONOW)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;codificaOLONOW&quot;>&#xa;                            &lt;codificaOLONOW>&#xa;                                &lt;xsl:value-of select=&quot;codificaOLONOW&quot;/>&#xa;                            &lt;/codificaOLONOW>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/tns:CodISPdaNome&quot;>&#xa;                            &lt;codificaOLONOW>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns:CodISPdaNome&quot;/>&#xa;                            &lt;/codificaOLONOW>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLO&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLOTarget&quot;>&#xa;                    &lt;codiceOrdineOLOTarget>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/codiceOrdineOLOTarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLOPadre&quot;>&#xa;                    &lt;codiceOrdineOLOPadre>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLOPadre&quot;/>&#xa;                    &lt;/codiceOrdineOLOPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineTITarget&quot;>&#xa;                    &lt;codiceOrdineTITarget>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineTITarget&quot;/>&#xa;                    &lt;/codiceOrdineTITarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;codiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;dataInvioRichiesta&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;xsl:if test=&quot;IDAnagraficaCausale&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:value-of select=&quot;IDAnagraficaCausale&quot;/>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDCorrelazione&quot;>&#xa;                    &lt;IDCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;IDCorrelazione&quot;/>&#xa;                    &lt;/IDCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;totaleRichiestePacchetto&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;totaleRichiestePacchetto&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipoPacchetto&quot;>&#xa;                    &lt;tipoPacchetto>&#xa;                        &lt;xsl:value-of select=&quot;tipoPacchetto&quot;/>&#xa;                    &lt;/tipoPacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDPacchettoNOW&quot;>&#xa;                    &lt;IDPacchettoNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDPacchettoNOW&quot;/>&#xa;                    &lt;/IDPacchettoNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;contenutoXML&quot;>&#xa;                    &lt;contenutoXML>&#xa;                        &lt;xsl:value-of select=&quot;contenutoXML&quot;/>&#xa;                    &lt;/contenutoXML>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;note&quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;note&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists(ordine)&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;xsl:if test=&quot;ordine/offertaCatalogo&quot;>&#xa;                            &lt;offertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/offertaCatalogo&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DAC&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DAC&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$FlagDataDAI=1&quot;>&#xa;                                &lt;DACRimodulata>&#xa;                                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Invoke3.parameters/tns5:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                &lt;/DACRimodulata>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;ordine/DACRimodulata&quot;>&#xa;                                    &lt;DACRimodulata>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/DACRimodulata&quot;/>&#xa;                                    &lt;/DACRimodulata>&#xa;                                &lt;/xsl:if>&#xa;                     