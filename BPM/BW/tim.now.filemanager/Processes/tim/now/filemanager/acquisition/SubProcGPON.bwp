                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CambioAmbitoAnnToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Annullamento&quot;/>&#xa;    &lt;xsl:param name=&quot;CallLocatorATT_ANN&quot;/>&#xa;    &lt;xsl:template name=&quot;Annullamento&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/created&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/lastUpdate&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/IDRichiestaOLO&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;xsl:if test=&quot;$Annullamento/statoRichiestaOLO&quot;>&#xa;                &lt;statoRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/statoRichiestaOLO&quot;/>&#xa;                &lt;/statoRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/statoRichiestaPrecedOLO&quot;>&#xa;                &lt;statoRichiestaPrecedOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/statoRichiestaPrecedOLO&quot;/>&#xa;                &lt;/statoRichiestaPrecedOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/sottostatoLavorManuale&quot;>&#xa;                &lt;sottostatoLavorManuale>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/sottostatoLavorManuale&quot;/>&#xa;                &lt;/sottostatoLavorManuale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/IDFileInput&quot;>&#xa;                &lt;IDFileInput>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/IDFileInput&quot;/>&#xa;                &lt;/IDFileInput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/IDFileOutput&quot;>&#xa;                &lt;IDFileOutput>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/IDFileOutput&quot;/>&#xa;                &lt;/IDFileOutput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:SistemaDiCompetenza = &amp;quot;CRMWS&amp;quot;&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:SistemaDiCompetenza = &amp;quot;KO&amp;quot;&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SDR&amp;quot;&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Annullamento/ambito&quot;>&#xa;                        &lt;ambito>&#xa;                            &lt;xsl:value-of select=&quot;$Annullamento/ambito&quot;/>&#xa;                        &lt;/ambito>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/canaleRichiesta&quot;/>&#xa; 