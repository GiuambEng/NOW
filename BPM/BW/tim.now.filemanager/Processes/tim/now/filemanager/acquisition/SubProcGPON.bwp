llazioneAccodamento/CodiceOrdineFornitore&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Annullamento)&quot;>&lt;xsl:if test=&quot;$rich/Annullamento/CodiceOrdineFornitore&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/Annullamento/CodiceOrdineFornitore&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/RimodulazioneAppuntamento)&quot;>&lt;xsl:if test=&quot;$rich/RimodulazioneAppuntamento/CodiceOrdineFornitore&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/RimodulazioneAppuntamento/CodiceOrdineFornitore&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/InterruzioneSospensione)&quot;>&lt;xsl:if test=&quot;$rich/InterruzioneSospensione/CodiceOrdineFornitore&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/InterruzioneSospensione/CodiceOrdineFornitore&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/Testata/CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;$rich/Testata/CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string($Start/tns:DATA_FILE), 1, 10))&quot;/>&lt;/dataInvioRichiesta>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&lt;/contenutoXML>&lt;xsl:if test=&quot;exists($rich/Ordine/Cessazione)&quot;>&lt;ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns:NomeFile, $NEWGPONPref) and exists($rich/Ordine/Cessazione) and (count($FlagOscuramento/Record[COD_AGESP='R1I-24-0178'])=0 or $FlagOscuramento/Record[COD_AGESP='R1I-24-0178']/FLAG_OSCURMENTO='0')&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIGPON1BPNRR'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'UBBSEMIG