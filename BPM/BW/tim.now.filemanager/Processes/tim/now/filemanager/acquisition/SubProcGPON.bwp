                                portType="ns21:ReplaceCharacterPortType" tibex:xpdlId="8fd94f3e-e4b9-4a08-b225-926087fe9f35">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns9="http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter" xmlns:tns10="http://www.tim.com/NOW/xsd/ReplaceCharacter" xmlns:tns1="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="ATTarray"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="Mapper2"/&gt;
    &lt;xsl:template name="Invoke1-input" match="/"&gt;
        &lt;tns9:ReplaceCharacterRequest&gt;
            &lt;ReplaceCharacterInput&gt;
                &lt;tns10:InputString&gt;
                    &lt;tns10:OldString&gt;
                        &lt;xsl:value-of select="tib:render-xml($Mapper2, true(), true())"/&gt;
                    &lt;/tns10:OldString&gt;
                    &lt;tns10:OldChar&gt;
                        &lt;xsl:value-of select="'tns:'"/&gt;
                    &lt;/tns10:OldChar&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="contains($ATTarray/tns1:Richiesta[number($index)]/contenutoXML,'ns0:')"&gt;
                            &lt;tns10:NewChar&gt;
                                &lt;xsl:value-of select="'ns0:'"/&gt;
                            &lt;/tns10:NewChar&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns10:NewChar&gt;
                                &lt;xsl:value-of select="'ns01:'"/&gt;
                            &lt;/tns10:NewChar&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns10:InputString&gt;
            &lt;/ReplaceCharacterInput&gt;
        &lt;/tns9:ReplaceCharacterRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
