                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;Annullamento&quot;/>&lt;xsl:param name=&quot;CallLocatorATT_ANN&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns8:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:SistemaDiCompetenza = &amp;quot;CRMWS&amp;quot;&quot;>&lt;tns8:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns8:StringaCRMWS,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;),substring-after($Annullamento/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns8:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns8:StringaCRMWS&quot;/>&lt;/tns8:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:SistemaDiCompetenza = &amp;quot;KO&amp;quot; and ($CallLocatorATT_ANN/tns7:Risposta/tns7:RC = &amp;quot;09&amp;quot; or $CallLocatorATT_ANN/tns7:Risposta/tns7:RC = &amp;quot;10&amp;quot; or $CallLocatorATT_ANN/tns7:Risposta/tns7:RC = &amp;quot;14&amp;quot;)&quot;>&lt;tns8:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns8:StringaSDR,substring-after($Richiesta/contenutoXML,&amp;quot;?>&amp;quot;),substring-after($Annullamento/contenutoXML,&amp;quot;?>&amp;quot;))&quot;/>&lt;/tns8:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns8:StringaSDR&quot;/>&lt;/tns8:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns8:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns8:StringaDBCFX&quot;/>&lt;/tns8:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:SistemaDiCompetenza = &amp;quot;CRMWS&amp;quot;&quot;>&lt;tns8:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns8:ContatoreCRMWS+2)&quot;/>&lt;/tns8:ContatoreCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:ContatoreCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns8:ContatoreCRMWS&quot;/>&lt;/tns8:ContatoreCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Contatori/tns8:ContatoreWSDP&quot;>&lt;tns8:ContatoreWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns8:ContatoreWSDP&quot;/>&lt;/tns8:ContatoreWSDP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:SistemaDiCompetenza = &amp;quot;KO&amp;quot; and ($CallLocatorATT_ANN/tns7:Risposta/tns7:RC = &amp;quot;09&amp;quot; or $CallLocatorATT_ANN/tns7:Risposta/tns7:RC = &amp;quot;10&amp;quot; or $CallLocatorATT_ANN/tns7:Risposta/tns7:RC = &amp;quot;14&amp;quot;)&quot;>&lt;tns8:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns8:ContatoreSDR+2)&quot;/>&lt;/tns8:ContatoreSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:ContatoreSDR>&lt;xsl:value-of select=&quot;$Contatori/tns8:ContatoreSDR&quot;/>&lt;/tns8:ContatoreSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns8:ContatoreDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns8:ContatoreDBCFX&quot;/>&lt;/tns8:ContatoreDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:SistemaDiCompetenza = &amp;quot;NOW&amp;quot;&quot;>&lt;tns8:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns8:ContatoreNOW+2)&quot;/>&lt;/tns8:ContatoreNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns8:ContatoreNOW>&lt;xsl:value-of select=&quot;$Contatori/tns8:ContatoreNOW&quot;/>&lt;/tns8:ContatoreNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT_ANN/tns7:Risposta/tns7:Sistema