                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper5-input"
                                    name="Mapper5"
                                    outputVariable="Mapper5"
                                    tibex:xpdlId="5f323fd5-1e25-4c97-9769-a3ad20144955" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty5ToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper5ToInvoke"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/ReferenteXML/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Referente>&#xa;            &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/ordine/referente[qualificaReferente!='CF' and tipoReferenteOrdine!='REFERENTEONFIELD' and not(telefonoFissoReferente='3333333333') and not(telefonoMobileReferente='3333333333')]&quot;>&#xa;                &lt;tns9:Referente>&#xa;                    &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                        &lt;tns9:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                        &lt;/tns9:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                        &lt;tns9:Qualifica>&#xa;                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                        &lt;/tns9:Qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;nomeReferente&quot;>&#xa;                        &lt;tns9:Nome>&#xa;                            &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                        &lt;/tns9:Nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;cognomeReferente&quot;>&#xa;                        &lt;tns9:Cognome>&#xa;                            &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                        &lt;/tns9:Cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                        &lt;tns9:Telefono>&#xa;                            &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns9:Telefono>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                        &lt;tns9:Mobile>&#xa;                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns9:Mobile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                        &lt;tns9:Email>&#xa;                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                        &lt;/tns9:Email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns9:Referente>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$Referente/tns4:Request[string-length(tns4:Esito)>0]&quot;>&#xa;                &lt;tns9:Referente>&#xa;                    &lt;xsl:if test=&quot;tns4:Referente[1]/progressivoReferente&quot;>&#xa;                        &lt;tns9:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns4:Referente[1]/progressivoReferente&quot;/>&#xa;                        &lt;/tns9:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:Referente[1]/qualificaReferente&quot;>&#xa;                        &lt;tns9:Qualifica>&#xa;                            &lt;xsl:value-of select=&quot;tns4:Referente[1]/qualificaReferente&quot;/>&#xa;                        &lt;/tns9:Qualifica>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:Referente[1]/nomeReferente&quot;>&#xa;                        &lt;tns9:Nome>&#xa;                            &lt;xsl:value-of select=&quot;tns4:Referente[1]/nomeReferente&quot;/>&#xa;                        &lt;/tns9:Nome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:Referente[1]/cognomeReferente&quot;>&#xa;                        &lt;tns9:Cognome>&#xa;                            &lt;xsl:value-of select=&quot;tns4:Referente[1]/cognomeReferente&quot;/>&#xa;                        &lt;/tns9:Cognome>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:Referente[1]/telefonoFissoReferente&quot;>&#xa;                        &lt;tns9:Telefono>&#xa;                            &lt;xsl:value-of select=&quot;tns4:Referente[1]/telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns9:Telefono>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:Referente[1]/telefonoMobileReferente&quot;>&#xa;                        &lt;tns9:Mobile>&#xa;                            &lt;xsl:value-of select=&quot;tns4:Referente[1]/telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns9:Mobile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:Referente[1]/emailReferente&quot;>&#xa;                        &lt;tns9:Email>&#xa;                            &lt;xsl:value-of select=&quot;tns4:Referente[1]/emailReferente&quot;/>&#xa;                        &lt;/tns9:Email>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns9:Referente>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns9:Referente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:ReferenteXML="http://www.tim.com/NOW/xsd/ReferenteXML/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ReferenteXML:Referente" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke inputVariable="Invoke-input"
                                name="Invoke"
                                operation="ReplaceCharacter"
                                outputVariable="Invoke"
                                partnerLink="ReplaceCharacter"
                                portType="ns21:ReplaceCharacterPortType" tibex:xpdlId="3dc9efa9-9782-458f-af78-a50b071312c7">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns9="http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter" xmlns:tns10="http://www.tim.com/NOW/xsd/ReplaceCharacter" xmlns:tns1="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="Mapper5"/&gt;
    &lt;xsl:param name="ATT-ANNArray"/&gt;
    &lt;xsl:template name="Invoke-input" match="/"&gt;
        &lt;tns9:ReplaceCharacterRequest&gt;
            &lt;ReplaceCharacterInput&gt;
                &lt;tns10:InputString&gt;
                    &lt;tns10:OldString&gt;
                        &lt;xsl:value-of select="tib:render-xml($Mapper5, true(), true())"/&gt;
                    &lt;/tns10:OldString&gt;
                    &lt;tns10:OldChar&gt;
                        &lt;xsl:value-of select="'tns:'"/&gt;
                    &lt;/tns10:OldChar&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="contains($ATT-ANNArray/tns1:Richiesta[number($index)]/contenutoXML,'ns0:')"&gt;
                            &lt;tns10:NewChar&gt;
                                &lt;xsl:value-of select="'ns0:'"/&gt;
                            &lt;/tns10:NewChar&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns10:NewChar&gt;
                                &lt;xsl:value-of select="'ns01:'"/&gt;
                            &lt;/tns10:NewChar&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns10:InputString&gt;
            &lt;/ReplaceCharacterInput&gt;
        &lt;/tns9:ReplaceCharacterRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper5&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:InputString>&#xa;            &lt;tns10:OldString>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($Mapper5, true(), true())&quot;/>&#xa;            &lt;/tns10:OldString>&#xa;            &lt;tns10:OldChar>&#xa;                &lt;xsl:value-of select=&quot;'tns:'&quot;/>&#xa;            &lt;/tns10:OldChar>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($ATT-ANNArray/tns1:Richiesta[number($index)]/contenutoXML,'ns0:')&quot;>&#xa;                    &lt;tns10:NewChar>&#xa;                        &lt;xsl:value-of select=&quot;'ns0:'&quot;/>&#xa;                    &lt;/tns10:NewChar>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:NewChar>&#xa;                        &lt;xsl:value-of select=&quot;'ns01:'&quot;/>&#xa;                    &lt;/tns10:NewChar>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns10:InputString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="Log8ToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToArricchimentoAttivazione"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Log11-input"
                                    name="Log11"
                                    tibex:xpdlId="97e08829-e8f6-4e2f-9580-c32e189df9d6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Mapper5ToInvoke"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log8ToInvoke"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper5&quot;/>&#xa;    &lt;xsl:template name=&quot;Log11-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcGPON | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Calcolo Referenti per Contenuto XML',tib:render-xml($Mapper5,true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns9:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallLocatorATT_ANN-input"
                                    name="CallLocatorATT_ANN"
                                    outputVariable="CallLocatorATT_ANN"
                                    tibex:xpdlId="7a995aa0-808e-43ff-b741-69be70b733de"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign1ToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorATT_ANNToContatoreNOW">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza = &quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza = "NOW"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorATT_ANNToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza = &quot;CRMWS&quot; or ($CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza = &quot;KO&quot; and ($CallLocatorATT_ANN/ns22:Risposta/ns22:RC = &quot;09&quot; or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC = &quot;10&quot; or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC = &quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza = "CRMWS" or ($CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza = "KO" and ($CallLocatorATT_ANN/ns22:Risposta/ns22:RC = "09" or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC = "10" or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC = "14"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tns=&quot;http://www.example.org/GPONstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLocatorATT_ANN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:RichiestaLocalizzatore>&#xa;            &lt;tns7:Testata>&#xa;                &lt;tns7:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&#xa;                &lt;/tns7:Transaction_id>&#xa;                &lt;tns7:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns7:Transaction_date>&#xa;                &lt;tns7:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns7:Sistema_origine>&#xa;            &lt;/tns7:Testata>&#xa;            &lt;tns7:Richiesta>&#xa;                &lt;tns7:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns7:DataRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/codificaOLOAGCOM)>0&quot;>&#xa;                        &lt;tns7:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns7:CodiceOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns7:CodiceOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns7:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns7:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/ISTATComune)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                            &lt;tns7:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                            &lt;/tns7:CodiceComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length($Richiesta/offerta)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                            &lt;tns7:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                            &lt;/tns7:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;>&#xa;                            &lt;tns7:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                            &lt;/tns7:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns7:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Richiesta/offerta)&quot;/>&#xa;                            &lt;/tns7:Servizio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/flagNaked&quot;>&#xa;                    &lt;tns7:FlagNaked>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/flagNaked&quot;/>&#xa;                    &lt;/tns7:FlagNaked>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                    &lt;tns7:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                    &lt;/tns7:Richiesta>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:Ambito_XDSL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/tns7:Ambito_XDSL>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                    &lt;tns7:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                    &lt;/tns7:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;tns7:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/tns7:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating&quot;>&#xa;                            &lt;tns7:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating&quot;/>&#xa;                            &lt;/tns7:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                            &lt;tns7:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/tns7:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns7:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns7:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating2&quot;>&#xa;                        &lt;tns7:IdRisorsa2>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                        &lt;/tns7:IdRisorsa2>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/numeroTelefonico&quot;>&#xa;                    &lt;tns7:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/numeroTelefonico&quot;/>&#xa;                    &lt;/tns7:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Richiesta/DNAggiuntivo&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns7:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns7:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns7:DNAggiuntivi>&#xa;            &lt;/tns7:Richiesta>&#xa;        &lt;/tns7:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
