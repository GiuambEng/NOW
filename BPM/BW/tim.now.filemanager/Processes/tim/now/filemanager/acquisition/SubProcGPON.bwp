                                    inputVariable="Log20-input"
                                    name="Log20"
                                    tibex:xpdlId="9d4fa26c-9376-4ec3-ad33-c9646bcd0587" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
