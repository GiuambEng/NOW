totaleRichiestePacchetto&quot;>&#xa;                &lt;totaleRichiestePacchetto>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/totaleRichiestePacchetto&quot;/>&#xa;                &lt;/totaleRichiestePacchetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/tipoPacchetto&quot;>&#xa;                &lt;tipoPacchetto>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/tipoPacchetto&quot;/>&#xa;                &lt;/tipoPacchetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDPacchettoNOW&quot;>&#xa;                &lt;IDPacchettoNOW>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDPacchettoNOW&quot;/>&#xa;                &lt;/IDPacchettoNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/contenutoXML&quot;>&#xa;                &lt;contenutoXML>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/contenutoXML&quot;/>&#xa;                &lt;/contenutoXML>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/note&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/note&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:copy-of select=&quot;$Richiesta/ordine&quot;/>&#xa;            &lt;xsl:if test=&quot;$Richiesta/dataControlliFormali&quot;>&#xa;                &lt;dataControlliFormali>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/dataControlliFormali&quot;/>&#xa;                &lt;/dataControlliFormali>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/totaleRichiesteRilevPac&quot;>&#xa;                &lt;totaleRichiesteRilevPac>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/totaleRichiesteRilevPac&quot;/>&#xa;                &lt;/totaleRichiesteRilevPac>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDContratto&quot;>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                &lt;ISTATComune>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                &lt;/ISTATComune>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/localita&quot;>&#xa;                &lt;localita>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/localita&quot;/>&#xa;                &lt;/localita>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                &lt;/offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/flagNaked&quot;>&#xa;                &lt;flagNaked>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/flagNaked&quot;/>&#xa;                &lt;/flagNaked>&#xa;            &lt;/xsl:if>&#xa;            &lt;IDRichiestaLocalizzatore>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/IDRichiestaLocalizzatore&quot;/>&#xa;            &lt;/IDRichiestaLocalizzatore>&#xa;            &lt;xsl:if test=&quot;$Richiesta/testMode&quot;>&#xa;                &lt;testMode>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/testMode&quot;/>&#xa;                &lt;/testMode>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/DAD&quot;>&#xa;                &lt;DAD>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/DAD&quot;/>&#xa;                &lt;/DAD>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDFasciaOraria&quot;>&#xa;                &lt;IDFasciaOraria>&#xa;                    &lt;xs