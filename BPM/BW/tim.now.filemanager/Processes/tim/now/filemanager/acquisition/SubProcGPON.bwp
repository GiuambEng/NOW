uot;tipoComunicazioneCPS&quot;>&#xa;                    &lt;tipoComunicazioneCPS>&#xa;                        &lt;xsl:value-of select=&quot;tipoComunicazioneCPS&quot;/>&#xa;                    &lt;/tipoComunicazioneCPS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;ordineAssetWhiteList&quot;>&#xa;                    &lt;ordineAssetWhiteList>&#xa;                        &lt;xsl:value-of select=&quot;ordineAssetWhiteList&quot;/>&#xa;                    &lt;/ordineAssetWhiteList>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;gestioneAutonoma&quot;>&#xa;                    &lt;gestioneAutonoma>&#xa;                        &lt;xsl:value-of select=&quot;gestioneAutonoma&quot;/>&#xa;                    &lt;/gestioneAutonoma>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagNewGpon&quot;>&#xa;                    &lt;flagNewGpon>&#xa;                        &lt;xsl:value-of select=&quot;flagNewGpon&quot;/>&#xa;                    &lt;/flagNewGpon>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns1:RichiestaElement>&#xa;        &lt;/xsl:for-each>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
