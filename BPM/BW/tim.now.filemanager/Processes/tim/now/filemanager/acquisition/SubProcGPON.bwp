gAttesaDesospOLO&quot;/>&lt;/flagAttesaDesospOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;flagDeliveryExposed&quot;>&lt;flagDeliveryExposed>&lt;xsl:value-of select=&quot;flagDeliveryExposed&quot;/>&lt;/flagDeliveryExposed>&lt;/xsl:if>&lt;xsl:if test=&quot;disaggregato&quot;>&lt;disaggregato>&lt;xsl:value-of select=&quot;disaggregato&quot;/>&lt;/disaggregato>&lt;/xsl:if>&lt;xsl:if test=&quot;exDisaggregato&quot;>&lt;exDisaggregato>&lt;xsl:value-of select=&quot;exDisaggregato&quot;/>&lt;/exDisaggregato>&lt;/xsl:if>&lt;xsl:if test=&quot;FFACQKO&quot;>&lt;FFACQKO>&lt;xsl:value-of select=&quot;FFACQKO&quot;/>&lt;/FFACQKO>&lt;/xsl:if>&lt;xsl:if test=&quot;idProgressivoNotificheFF&quot;>&lt;idProgressivoNotificheFF>&lt;xsl:value-of select=&quot;idProgressivoNotificheFF&quot;/>&lt;/idProgressivoNotificheFF>&lt;/xsl:if>&lt;xsl:if test=&quot;idTplgCautelare&quot;>&lt;idTplgCautelare>&lt;xsl:value-of select=&quot;idTplgCautelare&quot;/>&lt;/idTplgCautelare>&lt;/xsl:if>&lt;xsl:if test=&quot;count($CallProcess/tns3:Record)>0 and exists($CallProcess/tns3:Record[string-length(tns3:CODFC_OLO_AGCOM)>0])&quot;>&lt;rendezVous>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/rendezVous>&lt;/xsl:if>&lt;xsl:if test=&quot;cambioTecnologia&quot;>&lt;cambioTecnologia>&lt;xsl:value-of select=&quot;cambioTecnologia&quot;/>&lt;/cambioTecnologia>&lt;/xsl:if>&lt;xsl:if test=&quot;tipoComunicazioneCPS&quot;>&lt;tipoComunicazioneCPS>&lt;xsl:value-of select=&quot;tipoComunicazioneCPS&quot;/>&lt;/tipoComunicazioneCPS>&lt;/xsl:if>&lt;xsl:if test=&quot;ordineAssetWhiteList&quot;>&lt;ordineAssetWhiteList>&lt;xsl:value-of select=&quot;ordineAssetWhiteList&quot;/>&lt;/ordineAssetWhiteList>&lt;/xsl:if>&lt;xsl:if test=&quot;gestioneAutonoma&quot;>&lt;gestioneAutonoma>&lt;xsl:value-of select=&quot;gestioneAutonoma&quot;/>&lt;/gestioneAutonoma>&lt;/xsl:if>&lt;xsl:if test=&quot;flagNewGpon&quot;>&lt;flagNewGpon>&lt;xsl:value-of select=&quot;flagNewGpon&quot;/>&lt;/flagNewGpon>&lt;/xsl:if>&lt;/ns1:RichiestaElement>&lt;/