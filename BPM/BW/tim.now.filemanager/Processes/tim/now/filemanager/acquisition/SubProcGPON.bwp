                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Annullamento"
                                    name="Annullamento"
                                    outputVariable="Annullamento"
                                    tibex:xpdlId="73a2ee33-9473-4d15-9008-6a6a79d4aa93" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ArricchimentoATTToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$TransitoryProperty = &quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$TransitoryProperty = "Y"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AnnullamentoToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Annullamento&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns1:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns1:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns1:Richiesta[number($index)]/codiceOrdineOLO) and lavorazione = &amp;quot;ANNULLAMENTO&amp;quot;][1]&quot;>&#xa;            &lt;xsl:for-each select=&quot;.&quot;>&#xa;                &lt;ns1:RichiestaElement>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                    &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                        &lt;statoRichiestaPrecedNOW>&#xa;                            &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                        &lt;/statoRichiestaPrecedNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                        &lt;statoRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                        &lt;/statoRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                        &lt;statoRichiestaPrecedOLO>&#xa;                            &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                        &lt;/statoRichiestaPrecedOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                        &lt;sottostatoLavorManuale>&#xa;                            &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                        &lt;/sottostatoLavorManuale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                        &lt;IDFileInput>&#xa;                            &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                        &lt;/IDFileInput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                        &lt;IDFileOutput>&#xa;                            &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                        &lt;/IDFileOutput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ambito&quot;>&#xa;                        &lt;ambito>&#xa;                            &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                        &lt;/ambito>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;canaleRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&#xa;                    &lt;/canaleRichiesta>&#xa;                    &lt;xsl:if test=&quot;lavorazione&quot;>&#xa;                        &lt;lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;lavorazione&quot;/>&#xa;                        &lt;/lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&#xa;                        &lt;progressivoRichiestaFile>&#xa;                            &lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&#xa;                        &lt;/progressivoRichiestaFile>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;strutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&#xa;                    &lt;/strutturaRichiesta>&#xa;                    &lt;tipoRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&#xa;                    &lt;/tipoRichiesta>&#xa;                    &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;codificaOLONOW&quot;>&#xa;                        &lt;codificaOLONOW>&#xa;                            &lt;xsl:value-of select=&quot;codificaOLONOW&quot;/>&#xa;                        &lt;/codificaOLONOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;codiceOrdineOLO&quot;>&#xa;                        &lt;codiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                        &lt;/codiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;codiceOrdineOLOTarget&quot;>&#xa;                        &lt;codiceOrdineOLOTarget>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineOLOTarget&quot;/>&#xa;                        &lt;/codiceOrdineOLOTarget>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;codiceOrdineOLOPadre&quot;>&#xa;                        &lt;codiceOrdineOLOPadre>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineOLOPadre&quot;/>&#xa;                        &lt;/codiceOrdineOLOPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;codiceOrdineTITarget&quot;>&#xa;                        &lt;codiceOrdineTITarget>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineTITarget&quot;/>&#xa;                        &lt;/codiceOrdineTITarget>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;codiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;codiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;dataInvioRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;dataInvioRichiesta&quot;/>&#xa;                    &lt;/dataInvioRichiesta>&#xa;                    &lt;xsl:if test=&quot;IDAnagraficaCausale&quot;>&#xa;                        &lt;IDAnagraficaCausale>&#xa;                            &lt;xsl:value-of select=&quot;IDAnagraficaCausale&quot;/>&#xa;                        &lt;/IDAnagraficaCausale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDCorrelazione&quot;>&#xa;                        &lt;IDCorrelazione>&#xa;                            &lt;xsl:value-of select=&quot;IDCorrelazione&quot;/>&#xa;                        &lt;/IDCorrelazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;totaleRichiestePacchetto&quot;>&#xa;                        &lt;totaleRichiestePacchetto>&#xa;                            &lt;xsl:value-of select=&quot;totaleRichiestePacchetto&quot;/>&#xa;                        &lt;/totaleRichiestePacchetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tipoPacchetto&quot;>&#xa;                        &lt;tipoPacchetto>&#xa;                            &lt;xsl:value-of select=&quot;tipoPacchetto&quot;/>&#xa;                        &lt;/tipoPacchetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDPacchettoNOW&quot;>&#xa;                        &lt;IDPacchettoNOW>&#xa;                            &lt;xsl:value-of select=&quot;IDPacchettoNOW&quot;/>&#xa;                        &lt;/IDPacchettoNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;contenutoXML&quot;>&#xa;                        &lt;contenutoXML>&#xa;                            &lt;xsl:value-of select=&quot;contenutoXML&quot;/>&#xa;                        &lt;/contenutoXML>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;note&quot;>&#xa;                        &lt;note>&#xa;                            &lt;xsl:value-of select=&quot;note&quot;/>&#xa;                        &lt;/note>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;ordine&quot;/>&#xa;                    &lt;xsl:if test=&quot;dataControlliFormali&quot;>&#xa;                        &lt;dataControlliFormali>&#xa;                            &lt;xsl:value-of select=&quot;dataControlliFormali&quot;/>&#xa;                  