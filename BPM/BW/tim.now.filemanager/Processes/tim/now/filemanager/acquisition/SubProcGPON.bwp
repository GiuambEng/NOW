      &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                        &lt;/DNAggiuntivo>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;IDPreventivo&quot;>&#xa;                        &lt;IDPreventivo>&#xa;                            &lt;xsl:value-of select=&quot;IDPreventivo&quot;/>&#xa;                        &lt;/IDPreventivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDConsuntivo&quot;>&#xa;                        &lt;IDConsuntivo>&#xa;                            &lt;xsl:value-of select=&quot;IDConsuntivo&quot;/>&#xa;                        &lt;/IDConsuntivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;noteAltreLavorazioni&quot;>&#xa;                        &lt;noteAltreLavorazioni>&#xa;                            &lt;xsl:value-of select=&quot;noteAltreLavorazioni&quot;/>&#xa;                        &lt;/noteAltreLavorazioni>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;codicePacchettoNOW&quot;>&#xa;                        &lt;codicePacchettoNOW>&#xa;                            &lt;xsl:value-of select=&quot;codicePacchettoNOW&quot;/>&#xa;                        &lt;/codicePacchettoNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:copy-of select=&quot;assetTarget&quot;/>&#xa;                    &lt;xsl:if test=&quot;operatoreRete&quot;>&#xa;                        &lt;operatoreRete>&#xa;                            &lt;xsl:value-of select=&quot;operatoreRete&quot;/>&#xa;                        &lt;/operatoreRete>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;transactionIDLocator&quot;>&#xa;                        &lt;transactionIDLocator>&#xa;                            &lt;xsl:value-of select=&quot;transactionIDLocator&quot;/>&#xa;                        &lt;/transactionIDLocator>&#xa;                    &lt;/xsl:if>&#xa;                    &