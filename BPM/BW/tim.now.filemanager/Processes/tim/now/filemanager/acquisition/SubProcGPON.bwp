                                    <tibex:activityExtension
                                    inputVariable="Referente"
                                    name="Assign7"
                                    outputVariable="Referente"
                                    tibex:xpdlId="10d34f2b-281c-46c9-b77b-b42d137a8169" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token1ToAccumulate"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign7ToAccumulate"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token1&quot;/>&#xa;    &lt;xsl:template name=&quot;Referente&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;xsl:copy-of select=&quot;$Referente/tns4:Request&quot;/>&#xa;            &lt;tns4:Request>&#xa;                &lt;xsl:if test=&quot;$Token1/tns9:ResponseCreate_token/tns9:Token&quot;>&#xa;                    &lt;tns4:Token>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns9:ResponseCreate_token/tns9:Token&quot;/>&#xa;                    &lt;/tns4:Token>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token1/tns9:ResponseCreate_token/tns9:ESITO&quot;>&#xa;                    &lt;tns4:Esito>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns9:ResponseCreate_token/tns9:ESITO&quot;/>&#xa;                    &lt;/tns4:Esito>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token1/tns9:ResponseCreate_token/tns9:DESCRIZIONE&quot;>&#xa;                    &lt;tns4:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns9:ResponseCreate_token/tns9:DESCRIZIONE&quot;/>&#xa;                    &lt;/tns4:Descrizione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]&quot;>&#xa;                    &lt;tns4:Referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;tipoReferenteOrdine&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                            &lt;qualificaReferente>&#xa;                                &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                            &lt;/qualificaReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;cognomeReferente&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;nomeReferente&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token1/tns9:ResponseCreate_token/tns9:Token)>0 and string-length(telefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token1/tns9:ResponseCreate_token/tns9:Token&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token1/tns9:ResponseCreate_token/tns9:Token&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token1/tns9:ResponseCreate_token/tns9:Token)>0 and string-length(telefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token1/tns9:ResponseCreate_token/tns9:Token&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token1/tns9:ResponseCreate_token/tns9:Token&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                                    &lt;/telefonoMobileReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                            &lt;emailReferente>&#xa;                                &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                            &lt;/emailReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns4:Referente>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns4:Request>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>

                                    <value
                                    processVariable="Referente" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log26-input"
                                    name="Log26"
                                    tibex:xpdlId="a668c910-ef2f-4977-9627-f8e54fdfaec3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart3ToLog26"/>
                                    </bpws:targets>
