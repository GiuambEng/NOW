                                    linkName="CallProcess3ToLog16"
                                    tibex:faultDetailsVar="CallProcess3" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns=&quot;http://www.example.org/GPONstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:Request>&#xa;            &lt;tns9:RequestVerificaRollout>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLO=$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo]/tns1:CodiceOLOAGCOM)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLO=$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo]/tns1:CodiceOLOAGCOM&quot;>&#xa;                            &lt;tns9:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLO=$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo]/tns1:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/tns9:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns9:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns9:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;>&#xa;                    &lt;tns9:CodificaOloNumerico>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;/>&#xa;                    &lt;/tns9:CodificaOloNumerico>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns9:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;'UBBSEMIGPON'&quot;/>&#xa;                &lt;/tns9:Offerta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione)&quot;>&#xa;                        &lt;tns9:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/CancellazioneAccodamento)&quot;>&#xa;                        &lt;tns9:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Annullamento)&quot;>&#xa;                        &lt;tns9:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento)&quot;>&#xa;                        &lt;tns9:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione)&quot;>&#xa;                        &lt;tns9:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta/Comunicazione/AccettazioneOpereSpeciali)&quot;>&#xa;                        &lt;tns9:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&#xa;                        &lt;/tns9:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns9:FlagReferente>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns9:FlagReferente>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;>&#xa;                    &lt;tns9:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;/>&#xa;                    &lt;/tns9:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns9:RequestVerificaRollout>&#xa;            &lt;tns9:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns9:ProcessIstance>&#xa;        &lt;/tns9:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
