                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallLocatorATT-input"
                                    name="CallLocatorATT"
                                    outputVariable="CallLocatorATT"
                                    tibex:xpdlId="489645b6-06e8-409d-a3d4-6b512ac4f0ec"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign1ToGroupEnd11"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallLocatorATTToContatoreNOWatt">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT/ns22:Risposta/ns22:SistemaDiCompetenza = &quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorATT/ns22:Risposta/ns22:SistemaDiCompetenza = "NOW"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorATTToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorATT/ns22:Risposta/ns22:SistemaDiCompetenza=&quot;CRMWS&quot; or ($CallLocatorATT/ns22:Risposta/ns22:SistemaDiCompetenza=&quot;KO&quot; and ($CallLocatorATT/ns22:Risposta/ns22:RC=&quot;09&quot; or $CallLocatorATT/ns22:Risposta/ns22:RC=&quot;10&quot; or $CallLocatorATT/ns22:Risposta/ns22:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorATT/ns22:Risposta/ns22:SistemaDiCompetenza="CRMWS" or ($CallLocatorATT/ns22:Risposta/ns22:SistemaDiCompetenza="KO" and ($CallLocatorATT/ns22:Risposta/ns22:RC="09" or $CallLocatorATT/ns22:Risposta/ns22:RC="10" or $CallLocatorATT/ns22:Risposta/ns22:RC="14"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tns=&quot;http://www.example.org/GPONstart&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLocatorATT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:RichiestaLocalizzatore>&#xa;            &lt;tns7:Testata>&#xa;                &lt;tns7:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns7:Transaction_id>&#xa;                &lt;tns7:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns7:Transaction_date>&#xa;                &lt;tns7:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns7:Sistema_origine>&#xa;            &lt;/tns7:Testata>&#xa;            &lt;tns7:Richiesta>&#xa;                &lt;tns7:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns7:DataRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/codificaOLOAGCOM)>0&quot;>&#xa;                        &lt;tns7:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                        &lt;/tns7:CodiceOLO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns7:CodiceOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodOLOdaNome&quot;/>&#xa;                        &lt;/tns7:CodiceOLO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns7:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns7:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/ISTATComune)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                            &lt;tns7:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                            &lt;/tns7:CodiceComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length($Richiesta/offerta)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;>&#xa;                            &lt;tns7:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                            &lt;/tns7:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                            &lt;tns7:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                            &lt;/tns7:Servizio>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns7:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;upper-case($Richiesta/offerta)&quot;/>&#xa;                            &lt;/tns7:Servizio>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/flagNaked&quot;>&#xa;                    &lt;tns7:FlagNaked>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/flagNaked&quot;/>&#xa;                    &lt;/tns7:FlagNaked>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:Richiesta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                &lt;/tns7:Richiesta>&#xa;                &lt;tns7:Ambito_XDSL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/tns7:Ambito_XDSL>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                    &lt;tns7:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                    &lt;/tns7:IdRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns7:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns7:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/numeroTelefonico&quot;>&#xa;                    &lt;tns7:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/numeroTelefonico&quot;/>&#xa;                    &lt;/tns7:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Richiesta/DNAggiuntivo&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns7:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns7:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns7:DNAggiuntivi>&#xa;            &lt;/tns7:Richiesta>&#xa;        &lt;/tns7:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.CallLocator" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
