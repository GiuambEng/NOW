                                    <tibex:activityExtension
                                    inputVariable="Log5-input"
                                    name="Log5"
                                    tibex:xpdlId="97280d66-4586-480d-a78b-cebefc39a0e8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
