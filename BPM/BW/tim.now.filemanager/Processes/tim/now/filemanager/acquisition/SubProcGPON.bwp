                                    name="CambioAmbitoAnn"
                                    outputVariable="Annullamento"
                                    tibex:xpdlId="cbd9b7a3-0031-416c-bf25-2e3f98182d2c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
