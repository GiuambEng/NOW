                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallLocatorALT-input"
                                    name="CallLocatorALT"
                                    outputVariable="CallLocatorALT"
                                    tibex:xpdlId="4b26aae0-7fba-40d2-b347-9fc682edc1e5"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperRichiestaToGroupEnd2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess2ToGroupEnd2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorALT/ns22:Risposta/ns22:SistemaDiCompetenza=&quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorALT/ns22:Risposta/ns22:SistemaDiCompetenza="NOW"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorALTToGroupEnd2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorALTToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorALT/ns22:Risposta/ns22:SistemaDiCompetenza=&quot;CRMWS&quot; or ($CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza=&quot;KO&quot; and ($CallLocatorATT_ANN/ns22:Risposta/ns22:RC=&quot;09&quot; or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC=&quot;10&quot; or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorALT/ns22:Risposta/ns22:SistemaDiCompetenza="CRMWS" or ($CallLocatorATT_ANN/ns22:Risposta/ns22:SistemaDiCompetenza="KO" and ($CallLocatorATT_ANN/ns22:Risposta/ns22:RC="09" or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC="10" or $CallLocatorATT_ANN/ns22:Risposta/ns22:RC="14"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLocatorALT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:RichiestaLocalizzatore>&#xa;            &lt;tns7:Testata>&#xa;                &lt;tns7:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&#xa;                &lt;/tns7:Transaction_id>&#xa;                &lt;tns7:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns7:Transaction_date>&#xa;                &lt;tns7:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns7:Sistema_origine>&#xa;            &lt;/tns7:Testata>&#xa;            &lt;tns7:Richiesta>&#xa;                &lt;tns7:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns7:DataRichiesta>&#xa;                &lt;tns7:CodiceOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns7:CodiceOLO>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns7:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns7:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                    &lt;tns7:CodiceComune>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                    &lt;/tns7:CodiceComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;>&#xa;                                &lt;tns7:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                                &lt;/tns7:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                                &lt;tns7:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                                &lt;/tns7:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                                    &lt;tns7:Servizio>&#xa;                                        &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                                    &lt;/tns7:Servizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTH&amp;quot;&quot;>&#xa;                                &lt;tns7:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;'EasyIPUBBFTTH'&quot;/>&#xa;                                &lt;/tns7:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;upper-case($Richiesta/offerta)=&amp;quot;EASYIPNGAFTTCAB&amp;quot;&quot;>&#xa;                                &lt;tns7:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;'EasyIPUBBFTTCAB'&quot;/>&#xa;                                &lt;/tns7:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                                    &lt;tns7:Servizio>&#xa;                                        &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                                    &lt;/tns7:Servizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;>&#xa;                        &lt;tns7:Richiesta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&#xa;                        &lt;/tns7:Richiesta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                            &lt;tns7:Richiesta>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                            &lt;/tns7:Richiesta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:Ambito_XDSL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&#xa;                &lt;/tns7:Ambito_XDSL>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                    &lt;tns7:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                    &lt;/tns7:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;tns7:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/tns7:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione='MIGRAZIONE'&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating&quot;>&#xa;                            &lt;tns7:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating&quot;/>&#xa;                            &lt;/tns7:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                            &lt;tns7:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/tns7:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns7:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns7:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating2&quot;>&#xa;                    &lt;tns7:IdRisorsa2>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                    &lt;/tns7:IdRisorsa2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/numeroTelefonico&quot;>&#xa;                    &lt;tns7:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/numeroTelefonico&quot;/>&#xa;                    &lt;/tns7:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Richiesta/DNAggiuntivo&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns7:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns7:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns7:DNAggiuntivi>&#xa;            &lt;/tns7:Richiesta>&#xa;        &lt;/tns7:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
