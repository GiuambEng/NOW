                                    inputVariable="Contatori"
                                    name="ContatoreNOWatt"
                                    outputVariable="Contatori"
                                    tibex:xpdlId="5bba6fc2-7fb4-46a8-aee7-1520ffabfeb5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
