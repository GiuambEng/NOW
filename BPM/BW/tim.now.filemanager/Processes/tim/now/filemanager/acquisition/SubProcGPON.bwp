Larray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/QualificaRef&quot;/>&#xa;                        &lt;/qualificaReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente&quot;>&#xa;                        &lt;cognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente&quot;/>&#xa;                        &lt;/cognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/NomeReferente&quot;>&#xa;                        &lt;nomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/NomeReferente&quot;/>&#xa;                        &lt;/nomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;>&#xa;                        &lt;telefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;/>&#xa;                        &lt;/telefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;>&#xa;                        &lt;telefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;/>&#xa;                        &lt;/telefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/ns1:ReferenteElement>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;ns1:ReferenteElement>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;cognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FAKE&amp;quot;&quot;/>&#xa;                    &lt;/cognomeReferente>&#xa;                &lt;/ns1:ReferenteElement>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
