                    <bpws:sources>
                        <bpws:source linkName="RichiesteToCopy_1_Log"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.example.org/RichiesteGPONxBPM&quot; xmlns:ns1=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns=&quot;http://www.example.org/GPONstart&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CodProgettoOrdWList&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;NEWGPONPref&quot;/>&lt;xsl:template name=&quot;Richieste-input&quot; match=&quot;/&quot;>&lt;ns:RichiesteOLOSuddivise>&lt;xsl:for-each select=&quot;$Start/RichiestaOAO/Richiesta&quot;>&lt;xsl:variable name=&quot;rich&quot; select=&quot;current()&quot;/>&lt;xsl:variable name=&quot;RTYPE&quot; select=&quot;if(exists(Ordine/Attivazione)) then if(exists(Annullamento[../Testata/CodiceOlo=$rich/Testata/CodiceOlo and CodiceOrdineOlo=$rich/Testata/CodiceOrdineOlo])) then 'ATTANN' else 'ATT'&amp;#xD;&amp;#xA;else if(exists(Annullamento)) then if(exists(Ordine/Attivazione[../../Testata/CodiceOlo=$rich/Testata/CodiceOlo and ../../Testata/CodiceOrdineOlo=$rich/Testata/CodiceOrdineOlo])) then 'ATTANN' else 'ALT' else 'ALT'&quot;/>&lt;ns:Richieste>&lt;xsl:if test=&quot;$RTYPE='ATT'&quot;>&lt;ns:RichiesteATT>&lt;ns1:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;xsd:int(../../tns:ID_FILE)&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;'FILE'&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&lt;/lavorazione>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/progressivoRichiestaFile>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;'NGA'&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO)>0&quot;>&lt;xsl:if test=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;../../tns:CodISPdaNome&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns:CodISPdaNome&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;Testata/CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;Testata/CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../tns:DATA_FILE), 1, 10))&quot;/>&lt;/dataInvioRichiesta>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&lt;/contenutoXML>&lt;ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;Ordine/Attivazione/AccessoGPON/TipologiaAccessoUBB='F'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../tns:NomeFile, $NEWGPONPref) and (count($FlagOscuramento/Record[COD_AGESP='R1I-24-0178'])=0 or $FlagOscuramento/Record[COD_AGESP='R1I-24-0178']/FLAG_OSCURMENTO='0')&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'FULLGPON1BPNRR'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'UBBFULLGPON'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../tns:NomeFile, $NEWGPONPref) and (count($FlagOscuramento/Record[COD_AGESP='R1I-24-0178'])=0 or $FlagOscuramento/Record[COD_AGESP='R1I-24-0178']/FLAG_OSCURMENTO='0')&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'SEMIGPON1BPNRR'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'UBBSEMIGPON'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date('dd/MM/yyyy',Ordine/Attivazione/AccessoGPON/DataDAI)&quot;/>&lt;/DAC>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/CognomeRagSoc&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/CognomeRagSoc&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/Nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/Nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/CF&quot;>&lt;CF>&lt;xsl:value-of select=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/CF&quot;/>&lt;/CF>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/PIVA&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;Ordine/Attivazione/AccessoGPON/DatiCliente/PIVA&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/AccessoGPON/CodiceDelivery&quot;>&lt;codiceDelivery>&lt;xsl:value-of select=&quot;Ordine/Attivazione/AccessoGPON/CodiceDelivery&quot;/>&lt;/codiceDelivery>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO)>0&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns:CodISPdaNome&quot;/>&lt;/codificaOLONOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;Testata/CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;Testata/CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/codificaOLOAGCOM>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&lt;/tipologiaLavorazione>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;IDDettaglioOrdine>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/IDDettaglioOrdine>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of s