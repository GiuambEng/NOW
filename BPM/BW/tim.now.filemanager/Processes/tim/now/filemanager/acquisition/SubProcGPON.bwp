TelefonoFissoReferente&quot;/>&lt;/telefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TelefonoMobileReferente&quot;>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;TelefonoMobileReferente&quot;/>&lt;/telefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;EmailReferente&quot;>&lt;emailReferente>&lt;xsl:value-of select=&quot;EmailReferente&quot;/>&lt;/emailReferente>&lt;/xsl:if>&lt;/referente>&lt;/xsl:for-each>&lt;tipologiaAccesso>&lt;xsl:value-of select=&quot;'DATI'&quot;/>&lt;/tipologiaAccesso>&lt;xsl:choose>&lt;xsl:when test=&quot;Ordine/Attivazione/AccessoGPON/TipologiaAccessoUBB='F'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../tns:NomeFile, $NEWGPONPref)&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;'FULLGPON1BPNRR'&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;'UBBFULLGPON'&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../tns:NomeFile, $NEWGPONPref)&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;'SEMIGPON1BPNRR'&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;'UBBSEMIGPON'&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;operatoreRete>&lt;xsl:value-of select=&quot;'FC'&quot;/>&lt;/operatoreRete>&lt;/ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(Ordine/Attivazione/AccessoGPON/Sede/CodiceComune)>5&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;substring(Ordine/Attivazione/AccessoGPON/Sede/CodiceComune,string-length(Ordine/Attivazione/AccessoGPON/Sede/CodiceComune)-5,6)&quot;/>&lt;/ISTATComune>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(Ordine/Attivazione/AccessoGPON/Sede/CodiceComune)&amp;lt;=5&quot;>&lt;xsl:if test=&quot;Ordine/Attivazione/AccessoGPON/Sede/CodiceComune&quot;>&lt;ISTATComune>&lt;xsl:value-of select=&quot;Ordine/Attivazione/AccessoGPON/Sede/CodiceComune&quot;/>&lt;/ISTATComune>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;Ordine/Attivazione/AccessoGPON/Sede/Localita&quot;>&lt;localita>&lt;xsl:value-of select=&quot;Ordine/Attivazione/AccessoGPON/Sede/Localita&quot;/>&lt;/localita>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;Ordine/Attivazione/AccessoGPON/TipologiaAccessoUBB='F'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../tns:NomeFile, $NEWGPONPref)&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;'FULLGPON1BPNRR'&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;'UBBFULLGPON'&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../../tns:NomeFile, $NEWGPONPref)&quot;>&lt;offerta>&lt;xsl:value-of select=&quot;'SEMIGPON1BPNRR'&quot;/>&lt;/offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offerta>&lt;xsl:value-of select=&quot;'UBBSEMIGPON'&quot;/>&lt;/offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;flagNaked>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/flagNaked>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;DRO>&lt;xsl:value-of select=&quot;../../tns:NextWorkingDate&quot;/>&lt;/DRO>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date('dd/MM/yyyy',Ordine/Attivazione/AccessoGPON/DataDAI)&quot;/>&lt;/DAC>&lt;xsl:if test=&quot;../../tns:CodAGCOMint&quot;>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;../../tns:CodAGCOMint&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:if>&lt;operatoreRete>&lt;xsl:value-of select=&quot;'FC'&quot;/>&lt;/operatoreRete>&lt;xsl:if test=&quot;(../../tns1:CodiciOlo/tns1:codes[$Start/tns1:CodiciOlo/tns1:codes/tns1:CodiceOLO=$rich/Testata/CodiceOlo]/tns1:CodiceOLOAGCOM)&amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;(../../tns1:CodiciOlo/tns1:codes[$Start/tns1:CodiciOlo/tns1:codes/tns1:CodiceOLO=$rich/Testata/CodiceOlo]/tns1:CodiceOLOAGCOM='ALB')&amp;#xD;&amp;#xA;and&amp;#xD;&amp;#xA;string-length($rich/Testata/CodiceProgetto)>0 and contains($CodProgettoOrdWList,$rich/Testata/CodiceProgetto)&quot;>&lt;ordineAssetWhiteList>&lt;xsl:value-of select=&quot;'TIM EX BT'&quot;/>&lt;/ordineAssetWhiteList>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/GestioneAutonomaImpresa)&quot;>&lt;gestioneAutonoma>&lt;xsl:value-of select=&quot;'IS'&quot;/>&lt;/gestioneAutonoma>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/GestioneAutonomaOperatore)&quot;>&lt;gestioneAutonoma>&lt;xsl:value-of select=&quot;'OS'&quot;/>&lt;/gestioneAutonoma>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;starts-with(../../tns:NomeFile, $NEWGPONPref)&quot;>&lt;flagNewGpon>&lt;xsl:value-of select=&quot;'SI'&quot;/>&lt;/flagNewGpon>&lt;/xsl:if>&lt;/ns1:RichiestaElement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns1:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;'PERVENUTO'&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;xsd:int(../../tns:ID_FILE)&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;'FILE'&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;'ANNULLAMENTO'&quot;/>&lt;/lavorazione>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/progressivoRichiestaFile>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;'NGA'&quot;/>&lt;/strutturaRichiesta>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ALTRO&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO)>0&quot;>&lt;xsl:if test=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;../../tns:CodISPdaNome&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns:CodISPdaNome&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;Annullamento/CodiceOrdineOlo&quot;>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;Annullamento/CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;Testata/CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;Testata/CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../tns:DATA_FILE), 1, 10))&quot;/>&lt;/dataInvioRichiesta>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&lt;/contenutoXML>&lt;IDRichiestaLocalizzatore>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/IDRichiestaLocalizzatore>&lt;DRO>&lt;xsl:value-of select=&quot;../../tns:NextWorkingDate&quot;/>&lt;/DRO>&lt;xsl:if test=&quot;../../tns:CodAGCOMint&quot;>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;../../tns:CodAGCOMint&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:if>&lt;operatoreRete>&lt;xsl:value-of select=&quot;'FC'&quot;/>&lt;/operatoreRete>&lt;/ns1:RichiestaElement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ns:RichiesteATT_ANN>&lt;/xsl:if>&lt;xsl:if test=&quot;$RTYPE='ALT'&quot;>&lt;RichiestaOAO>&lt;xsl:copy-of select=&quot;$rich&quot;/>&lt;/RichiestaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;$RTYPE='ALT'&quot;>&lt;ns:ProgressiviAlt>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/ns:ProgressiviAlt>&lt;/xsl:if>&lt;/ns:Richieste>&lt;/xsl:for-each>&lt;/ns:RichiesteOLOSuddivise>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
