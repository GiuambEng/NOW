                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderRichiesta-input"
                                    name="RenderRichiesta"
                                    outputVariable="RenderRichiesta"
                                    tibex:xpdlId="0fc1f309-1362-479e-b48d-801eaf933b72" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="NOWcounterToRenderRichiesta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXmlToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="RenderRichiestaToCallProcess">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$RichiestaCasedata/ambito=&quot;CRMWS&quot; or string-length($RichiestaCasedata/IDCorrelazione)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$RichiestaCasedata/ambito="CRMWS" or string-length($RichiestaCasedata/IDCorrelazione)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RichiestaCasedata&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$RichiestaCasedata&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="casedata:RichiestaElement"
                                    outputStyle="text"
                                    validateInput="true" xsi:type="palettexml:RenderXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="createProcessInstance-input"
                                    name="createProcessInstance"
                                    tibex:xpdlId="a4489aa9-0e05-4802-8e18-9fa10cd70343"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXmlToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="createProcessInstanceToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSnow&quot;/>&#xa;    &lt;xsl:param name=&quot;RichiestaCasedata&quot;/>&#xa;    &lt;xsl:template name=&quot;createProcessInstance-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Element>&#xa;            &lt;tns1:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns1:moduleName>&#xa;            &lt;tns1:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns1:parameterName>&#xa;            &lt;tns1:operationName>&#xa;                &lt;xsl:value-of select=&quot;$BPMoperationName&quot;/>&#xa;            &lt;/tns1:operationName>&#xa;            &lt;tns1:processName>&#xa;                &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;            &lt;/tns1:processName>&#xa;            &lt;tns1:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderRichiesta&quot;/>&#xa;            &lt;/tns1:value>&#xa;            &lt;tns1:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($Start/ns1:IDfile)&quot;/>&#xa;            &lt;/tns1:ID_FILE>&#xa;            &lt;tns1:ContenutoXML>&#xa;                &lt;xsl:value-of select=&quot;$RemoveNSnow&quot;/>&#xa;            &lt;/tns1:ContenutoXML>&#xa;            &lt;tns1:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$RichiestaCasedata/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns1:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$RichiestaCasedata/progressivoRichiestaFile&quot;>&#xa;                &lt;tns1:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaCasedata/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns1:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$RichiestaCasedata/ambito&quot;>&#xa;                &lt;tns1:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaCasedata/ambito&quot;/>&#xa;                &lt;/tns1:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RichiestaCasedata/strutturaRichiesta&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$RichiestaCasedata/codiceOrdineOLO&quot;>&#xa;                &lt;tns1:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$RichiestaCasedata/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns1:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:flagDEL103>&#xa;                &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;            &lt;/tns1:flagDEL103>&#xa;        &lt;/tns1:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
