                            <bpws:invoke inputVariable="DRO-input"
                                name="DRO"
                                operation="calcNextWorkingDate"
                                outputVariable="DRO"
                                partnerLink="GetNextDatePortType"
                                portType="ns12:GetNextDatePortType" tibex:xpdlId="6ece8ead-0cd0-482e-906d-5cc8a718d8e4">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:ns1="http://www.tim.com/NOW/xsd/103N_NP_start" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="TimestampNP"/&gt;
    &lt;xsl:template name="DRO-input" match="/"&gt;
        &lt;tns3:calcNextWorkingDateRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:CalcRequest&gt;
                    &lt;xsl:variable name="richiesta" select="$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($richiesta/*/ns1:DataOrdine)"&gt;
                            &lt;tns1:inputDate&gt;
                                &lt;xsl:value-of select="$richiesta/*/ns1:DataOrdine"/&gt;
                            &lt;/tns1:inputDate&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:inputDate&gt;
                                &lt;xsl:value-of select="xsd:date($TimestampNP/Record[1]/DATA_FILE)"/&gt;
                            &lt;/tns1:inputDate&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns1:TipoData&gt;
                        &lt;xsl:value-of select="&amp;quot;DRO&amp;quot;"/&gt;
                    &lt;/tns1:TipoData&gt;
                &lt;/tns1:CalcRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns3:calcNextWorkingDateRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;TimestampNP&quot;/>&#xa;    &lt;xsl:template name=&quot;DRO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CalcRequest>&#xa;            &lt;xsl:variable name=&quot;richiesta&quot; select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($richiesta/*/ns1:DataOrdine)&quot;>&#xa;                    &lt;tns1:inputDate>&#xa;                        &lt;xsl:value-of select=&quot;$richiesta/*/ns1:DataOrdine&quot;/>&#xa;                    &lt;/tns1:inputDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:inputDate>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($TimestampNP/Record[1]/DATA_FILE)&quot;/>&#xa;                    &lt;/tns1:inputDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:TipoData>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DRO&amp;quot;&quot;/>&#xa;            &lt;/tns1:TipoData>&#xa;        &lt;/tns1:CalcRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
