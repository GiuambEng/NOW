                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns2="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns1="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:ns1="http://www.tim.com/NOW/xsd/103N_NP_start" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="TimestampNP"/&gt;
    &lt;xsl:template name="GetNextDateByDuration-input" match="/"&gt;
        &lt;ns2:calcNextDateByDurationRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:Request&gt;
                    &lt;xsl:variable name="richiesta" select="$Start/ns1:ComunicazioneNP/ns1:Richiesta[$index]"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($richiesta/*/ns1:DataOrdine)"&gt;
                            &lt;tns1:inputDate&gt;
                                &lt;xsl:value-of select="$richiesta/*/ns1:DataOrdine"/&gt;
                            &lt;/tns1:inputDate&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:inputDate&gt;
                                &lt;xsl:value-of select="xsd:date($TimestampNP/Record[1]/DATA_FILE)"/&gt;
                            &lt;/tns1:inputDate&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns1:inputDuration&gt;
                        &lt;xsl:value-of select="'PT9H'"/&gt;
                    &lt;/tns1:inputDuration&gt;
                &lt;/tns1:Request&gt;
            &lt;/parameters&gt;
        &lt;/ns2:calcNextDateByDurationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
