l:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin)&quot;>&#xa;                        &lt;tns2:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;'PORTIN'&quot;/>&#xa;                        &lt;/tns2:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADONATING&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Lavorazione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:FlagClienteFinale>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:FlagClienteFinale>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceOrdine&quot;>&#xa;                    &lt;tns2:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceOrdine&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:RequestVerificaRollout>&#xa;            &lt;tns2:RequestCreate_token>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0 and string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;>&#xa;                            &lt;tns2:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;/>&#xa;                            &lt;/tns2:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;>&#xa;                            &lt;tns2:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&#xa;                            &lt;/tns2:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&#xa;                        &lt;/tns2:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceOrdine&quot;>&#xa;                    &lt;tns2:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceOrdine&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns2:Funzione>&#xa;                &lt;tns2:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CodiceOrdine,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns2:ChiaveRiferimento>&#xa;                &lt;tns2:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns2:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns1:IPAddress&quot;>&#xa;                    &lt;tns2:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns1:IPAddress&quot;/>&#xa;                    &lt;/tns2:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:NomeCliente&quot;>&#xa;                    &lt;tns2:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:NomeCliente&quot;/>&#xa;                    &lt;/tns2:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CognomeCliente_RagioneSociale&quot;>&#xa;                    &lt;tns2:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:CognomeCliente_RagioneSociale&quot;/>&#xa;                    &lt;/tns2:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns2:RequestCreate_token>&#xa;            &lt;tns2:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns2:ProcessIstance>&#xa;            &lt;tns2:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NPG'&quot;/>&#xa;            &lt;/tns2:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&#xa;                &lt;tns2:NumeroLinea>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&#xa;                &lt;/tns2:NumeroLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:OffertaBPM>&#xa;                &lt;xsl:value-of select=&quot;'NP'&quot;/>&#xa;            &lt;/tns2:OffertaBPM>&#xa;        &lt;/tns2:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderXml1-input"
                                    name="RenderXml1"
                                    outputVariable="RenderXml1"
                                    tibex:xpdlId="c6c00ea4-f870-4659-9760-068479640a4e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogToRenderXml1"/>
                                    <bpws:target linkName="LogDateToRenderXml1_DataKO"/>
                                    <bpws:target linkName="Empty1ToRenderXml1_flagoscuramento"/>
