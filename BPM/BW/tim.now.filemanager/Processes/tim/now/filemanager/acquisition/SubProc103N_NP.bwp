                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_OFFERTA&#xd;&#xa;  FROM TRASCODFC_OFFERTA&#xd;&#xa;  WHERE upper(NOME_OFFERTA_ESTERNA)=upper(?) AND PROVENIENZA='BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
