;))&quot;/>&lt;/DRO>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;>&lt;codificaOLOAGCOMDonating>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating&quot;/>&lt;/codificaOLOAGCOMDonating>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0 or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin) or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione) or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin) or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione)&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating)&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/ns1:NomeFile, '103N_NP_'), '_')&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;>&lt;codificaOLOAGCOMDonor>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor&quot;/>&lt;/codificaOLOAGCOMDonor>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)>0&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns:codes[tns:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns:CodiceOLO&quot;>&lt;codificaOLONOWDonating>&lt;xsl:value-of select=&quot;$CodiciOlo/tns:codes[tns:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonating)]/tns:CodiceOLO&quot;/>&lt;/codificaOLONOWDonating>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)>0 or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin) or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione) or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin) or exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione)&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;'002'&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating)&quot;>&lt;xsl:if test=&quot;$CodiciOlo/tns:codes[tns:CodiceOLOAGCOM=substring-before(substring-after($Start/ns1:NomeFile, '103N_NP_'), '_')]/tns:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns:codes[tns:CodiceOLOAGCOM=substring-before(substring-after($Start/ns1:NomeFile, '103N_NP_'), '_')]/tns:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$CodiciOlo/tns:codes[tns:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns:CodiceOLO&quot;>&lt;codificaOLONOWDonor>&lt;xsl:value-of select=&quot;$CodiciOlo/tns:codes[tns:CodiceOLOAGCOM=string($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:IdentificativoOperatoreDonor)]/tns:CodiceOLO&quot;/>&lt;/codificaOLONOWDonor>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;>&lt;numeroTelefonico>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DirectoryNumber&quot;/>&lt;/numeroTelefonico>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaRimodulata)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaRimodulata,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio)&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/node()/ns1:DataAttesaConsegnaServizio,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/DAC>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLOAGCOMRic>&lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&lt;/codificaOLOAGCOMRic>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='18'&quot;>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;'ANNULLAMENTORECIPIENT'&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient/ns1:TipoComunicazione='16'&quot;>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;'RDACRECIPIENTDONOR'&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient/ns1:TipoComunicazione='17'&quot;>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;'RDACDONORDONATING'&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipoComunicazioneNP>&lt;xsl:value-of select=&quot;upper-case(translate(local-name($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/*), &amp;quot;_&amp;quot;,&amp;quot;&amp;quot;))&quot;/>&lt;/tipoComunicazioneNP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&lt;transactionIDLocator>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&lt;/transactionIDLocator>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber)>0&quot;>&lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;/>&lt;/routingNumber>&lt;/xsl:if>&lt;/xsl:if>&lt;flagDelibera103>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/flagDelibera103>&lt;xsl:if test=&quot;string-length(string($TimestampNP/Record[1]/TIMSTP_NP))>0&quot;>&lt;xsl:if test=&quot;$TimestampNP/Record[1]/TIMSTP_NP&quot;>&lt;tmpAckNpD103>&lt;xsl:value-of select=&quot;$TimestampNP/Record[1]/TIMSTP_NP&quot;/>&lt;/tmpAckNpD103>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione)&quot;>&lt;codiceOperatoreReturning>&lt;xsl:value-of select=&quot;substring-before(substring-after($Start/ns1:NomeFile, '103N_NP_'), '_')&quot;/>&lt;/codiceOperatoreReturning>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
