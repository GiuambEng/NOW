                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (hours-from-dateTime($Start/ns27:TimstpAperturaFile) > hours-from-dateTime($CalcoloDRO) or (hours-from-dateTime($Start/ns27:TimstpAperturaFile) = hours-from-dateTime($CalcoloDRO) and minutes-from-dateTime($Start/ns27:TimstpAperturaFile) > minutes-from-dateTime($CalcoloDRO)) or (hours-from-dateTime($Start/ns27:TimstpAperturaFile) = hours-from-dateTime($CalcoloDRO) and minutes-from-dateTime($Start/ns27:TimstpAperturaFile) = minutes-from-dateTime($CalcoloDRO) and seconds-from-dateTime($Start/ns27:TimstpAperturaFile) > seconds-from-dateTime($CalcoloDRO))) then &quot;KO&quot; else &quot;OK&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
