        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartLogToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="IdOffertaToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="GroupOLOToEstrazioneISP" tibex:linkType="SUCCESS"/>
                <bpws:link name="OLOestrattiToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToOLOestratti" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToEmpty" tibex:linkType="ERROR"/>
                <bpws:link name="EmptyToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="GetLocalIPToIdOfferta" tibex:linkType="SUCCESS"/>
                <bpws:link name="TimestampNPToLog1" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log1ToGetLocalIP" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="e68f8070-1a5f-4f3e-8bde-9a21466a3917"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToEnd"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="ee17bffa-1639-4b9b-af6c-a6b9d04f7ea4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/N_NP_end&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;subContatoreNOW&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreKO&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreDBCFX&quot;/>&#xa;    &lt;xsl:param name=&quot;subStringaCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;subStringaDBCFX&quot;/>&#xa;    &lt;xsl:param name=&quot;subContatoreSDR&quot;/>&#xa;    &lt;xsl:param name=&quot;subStringaSDR&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Element>&#xa;            &lt;tns1:stringaCRMWS>&#xa;                &lt;xsl:value-of select=&quot;$subStringaCRMWS&quot;/>&#xa;            &lt;/tns1:stringaCRMWS>&#xa;            &lt;tns1:contatoreNOW>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreNOW&quot;/>&#xa;            &lt;/tns1:contatoreNOW>&#xa;            &lt;tns1:contatoreCRMWS>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreCRMWS&quot;/>&#xa;            &lt;/tns1:contatoreCRMWS>&#xa;            &lt;tns1:contatoreKO>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreKO&quot;/>&#xa;            &lt;/tns1:contatoreKO>&#xa;            &lt;tns1:stringaDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$subStringaDBCFX&quot;/>&#xa;            &lt;/tns1:stringaDBCFX>&#xa;            &lt;tns1:contatoreDBCFX>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreDBCFX&quot;/>&#xa;            &lt;/tns1:contatoreDBCFX>&#xa;            &lt;tns1:stringaSDR>&#xa;                &lt;xsl:value-of select=&quot;$subStringaSDR&quot;/>&#xa;            &lt;/tns1:stringaSDR>&#xa;            &lt;tns1:contatoreSDR>&#xa;                &lt;xsl:value-of select=&quot;$subContatoreSDR&quot;/>&#xa;            &lt;/tns1:contatoreSDR>&#xa;        &lt;/tns1:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="StartLog-input"
                    name="StartLog"
                    tibex:xpdlId="d8cb3ac0-1692-4506-b449-60cfd6cd943e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="StartLogToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;StartLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Appilcation: tim.now.filemanager.application | Process: SubProc103N_NP | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Input SubProc103N: ',tib:render-xml($Start, true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns1:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while"
                tibex:indexToGlobal="false" tibex:xpdlId="50cd9c9d-4826-4ad2-a20f-abdabb09970d">
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToWhile"/>
                    <bpws:target linkName="EmptyToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable element="ns4:RichiestaElement" name="RichiestaCasedata"/>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($Start/ns27:ComunicazioneNP/ns27:Richiesta)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns27:ComunicazioneNP/ns27:Richiesta)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToEmpty2" tibex:linkType="SUCCESS"/>
                                <bpws:link name="RenderXmlToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="createProcessInstanceToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToNOWcounter" tibex:linkType="SUCCESS"/>
                                <bpws:link name="DROToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RenderRichiestaToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="NOWcounterToRenderRichiesta" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RemoveNSnowToPrimoCasedata" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty1ToRenderXml1_flagoscuramento"
                                    tibex:label="flag oscuramento" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty1ToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="DateToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogDateToGetNextDateByDuration" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="LogDateToRenderXml1_DataKO"
                                    tibex:label="Data KO" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GetNextDateByDurationToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToLog" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="TokenToEmpty3" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogToRenderXml1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RenderXml1ToRemoveNSnow" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Empty2ToToken_clientefinale"
                                    tibex:label="cliente finale" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty2ToEmpty3" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty3ToDRO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="Calcolo DRO skip_CalcoloDROskip"
                                    tibex:label="Calcolo DRO skip" tibex:linkType="SUCCESSWITHCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="18e8d9e4-1d59-4537-9196-132346c3d83d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToEmpty2">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="18774ed4-d48b-4830-8a0c-f48946dc2396">
                                <bpws:targets>
                                    <bpws:target linkName="LogToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="subContatoreNOW"
                                    name="NOWcounter"
                                    outputVariable="subContatoreNOW"
                                    tibex:xpdlId="ef9299d4-3ecd-4582-82d9-16b22301b26d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToNOWcounter"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="NOWcounterToRenderRichiesta"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="$subContatoreNOW+1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="subContatoreNOW" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RichiestaCasedata"
                                    name="PrimoCasedata"
                                    outputVariable="RichiestaCasedata"
                                    tibex:xpdlId="95a6a418-c45f-4881-84c1-a4682f891c5e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RemoveNSnowToPrimoCasedata"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToNOWcounter">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;OLO_NORM&quot;/>&lt;xsl:param name=&quot;TransitoryProperty&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;RemoveNSnow&quot;/>&lt;xsl:param name=&quot;Token&quot;/>&lt;xsl:param name=&quot;TimestampNP&quot;/>&lt;xsl:template name=&quot;RichiestaCasedata&quot; match=&quot;/&quot;>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;$Start/ns1:IDfile&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='11'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='18'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTORECIPIENT&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAC&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient/ns1:TipoComunicazione='16'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RDACRECIPIENTDONOR&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC_Recipient/ns1:TipoComunicazione='17'&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RDACDONORDONATING&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione)&quot;>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin)&quot;>&lt;lavorazione>&lt;xsl:value-of