                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;OLO_NORM&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Request>&#xa;            &lt;tns2:RequestVerificaRollout>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient)>0 and string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;>&#xa;                            &lt;tns2:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient]/CODFC_OLO_AGCOM_ASSET&quot;/>&#xa;                            &lt;/tns2:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;>&#xa;                            &lt;tns2:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$OLO_NORM/Record[CODFC_OLO_AGCOM_RICH=$Start/ns1:CodOloAgcomIntrfc]/CODFC_OLO_AGCOM_ASSET&quot;/>&#xa;                            &lt;/tns2:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:CodificaOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:CodOloAgcomIntrfc&quot;/>&#xa;                        &lt;/tns2:CodificaOLOAGCOM>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:CodificaOloNumerico>&#xa;                    &lt;xsl:value-of select=&quot;$Start/ns1:CodIspIntrfc&quot;/>&#xa;                &lt;/tns2:CodificaOloNumerico>&#xa;                &lt;tns2:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Offerta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione='11'&quot;>&#xa;                        &lt;tns2:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;'ANNULLAMENTO'&quot;/>&#xa;                        &lt;/tns2:Lavorazione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento) and $Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annulla