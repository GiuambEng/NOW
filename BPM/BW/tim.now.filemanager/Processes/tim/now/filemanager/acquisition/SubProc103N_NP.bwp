                                    <bpws:sources>
                                    <bpws:source linkName="RenderXml1ToRemoveNSnow"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Token&quot;/>&#xa;    &lt;xsl:template name=&quot;RenderXml1-input&quot; match=&quot;/&quot;>&#xa;        &lt;Richiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin)&quot;>&#xa;                    &lt;Portin>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;CodiceOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOrdine&quot;/>&#xa;                        &lt;/CodiceOrdine>&#xa;                        &lt;DataOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:DataOrdine&quot;/>&#xa;                        &lt;/DataOrdine>&#xa;                        &lt;DirectoryNumber>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:DirectoryNumber&quot;/>&#xa;                        &lt;/DirectoryNumber>&#xa;                        &lt;TipoLinea>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:TipoLinea&quot;/>&#xa;                        &lt;/TipoLinea>&#xa;                        &lt;DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:DataInvioMessaggio&quot;/>&#xa;                        &lt;/DataInvioMessaggio>&#xa;                        &lt;xsl:if test=&quot;$Token/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                            &lt;NomeCliente>&#xa;                                &lt;xsl:value-of select=&quot;$Token/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                            &lt;/NomeCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CognomeCliente_RagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/CognomeCliente_RagioneSociale>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0&quot;>&#xa;                            &lt;Correlazioni>&#xa;                                &lt;IdentificativoCorrelazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&#xa;                                &lt;/IdentificativoCorrelazioni>&#xa;                                &lt;TotaleRichieste>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:Correlazioni/ns1:TotaleRichieste&quot;/>&#xa;                                &lt;/TotaleRichieste>&#xa;                            &lt;/Correlazioni>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CodiceOpRecipient>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceOpRecipient&quot;/>&#xa;                        &lt;/CodiceOpRecipient>&#xa;                        &lt;DataAttesaConsegnaServizio>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:DataAttesaConsegnaServizio&quot;/>&#xa;                        &lt;/DataAttesaConsegnaServizio>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceProgetto&quot;>&#xa;                            &lt;CodiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceProgetto&quot;/>&#xa;                            &lt;/CodiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CodiceSegreto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:CodiceSegreto&quot;/>&#xa;                        &lt;/CodiceSegreto>&#xa;                        &lt;RoutingNumber>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Portin/ns1:RoutingNumber&quot;/>&#xa;                        &lt;/RoutingNumber>&#xa;                    &lt;/Portin>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating)&quot;>&#xa;                    &lt;Prenotifica_Donating>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;CodiceOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:CodiceOrdine&quot;/>&#xa;                        &lt;/CodiceOrdine>&#xa;                        &lt;DataOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:DataOrdine&quot;/>&#xa;                        &lt;/DataOrdine>&#xa;                        &lt;DirectoryNumber>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:DirectoryNumber&quot;/>&#xa;                        &lt;/DirectoryNumber>&#xa;                        &lt;TipoLinea>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:TipoLinea&quot;/>&#xa;                        &lt;/TipoLinea>&#xa;                        &lt;DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:DataInvioMessaggio&quot;/>&#xa;                        &lt;/DataInvioMessaggio>&#xa;                        &lt;IdentificativoOperatoreDonor>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:IdentificativoOperatoreDonor&quot;/>&#xa;                        &lt;/IdentificativoOperatoreDonor>&#xa;                        &lt;xsl:if test=&quot;$Token/tns2:ResponseCreate_token/tns2:Nome&quot;>&#xa;                            &lt;NomeCliente>&#xa;                                &lt;xsl:value-of select=&quot;$Token/tns2:ResponseCreate_token/tns2:Nome&quot;/>&#xa;                            &lt;/NomeCliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CognomeCliente_RagioneSociale>&#xa;                            &lt;xsl:value-of select=&quot;$Token/tns2:ResponseCreate_token/tns2:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/CognomeCliente_RagioneSociale>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0&quot;>&#xa;                            &lt;Correlazioni>&#xa;                                &lt;IdentificativoCorrelazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&#xa;                                &lt;/IdentificativoCorrelazioni>&#xa;                                &lt;TotaleRichieste>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:Correlazioni/ns1:TotaleRichieste&quot;/>&#xa;                                &lt;/TotaleRichieste>&#xa;                            &lt;/Correlazioni>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CodiceOpRecipient>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:CodiceOpRecipient&quot;/>&#xa;                        &lt;/CodiceOpRecipient>&#xa;                        &lt;DataAttesaConsegnaServizio>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:DataAttesaConsegnaServizio&quot;/>&#xa;                        &lt;/DataAttesaConsegnaServizio>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:CodiceProgetto&quot;>&#xa;                            &lt;CodiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:CodiceProgetto&quot;/>&#xa;                            &lt;/CodiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CodiceSegreto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:CodiceSegreto&quot;/>&#xa;                        &lt;/CodiceSegreto>&#xa;                        &lt;IdentificativoOperatoreDonating>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Prenotifica_Donating/ns1:IdentificativoOperatoreDonating&quot;/>&#xa;                        &lt;/IdentificativoOperatoreDonating>&#xa;                    &lt;/Prenotifica_Donating>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione)&quot;>&#xa;                    &lt;Cessazione>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;DataOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:DataOrdine&quot;/>&#xa;                        &lt;/DataOrdine>&#xa;                        &lt;CodiceOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:CodiceOrdine&quot;/>&#xa;                        &lt;/CodiceOrdine>&#xa;                        &lt;DirectoryNumber>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:DirectoryNumber&quot;/>&#xa;                        &lt;/DirectoryNumber>&#xa;                        &lt;DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Cessazione/ns1:DataInvioMessaggio&quot;/>&#xa;                        &lt;/DataInvioMessaggio>&#xa;                    &lt;/Cessazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento)&quot;>&#xa;                    &lt;Annullamento>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                        &lt;CodiceOrdine>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:CodiceOrdine&quot;/>&#xa;                        &lt;/CodiceOrdine>&#xa;                        &lt;DirectoryNumber>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:DirectoryNumber&quot;/>&#xa;                        &lt;/DirectoryNumber>&#xa;                        &lt;DataInvioMessaggio>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:DataInvioMessaggio&quot;/>&#xa;                        &lt;/DataInvioMessaggio>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:Correlazioni/ns1:IdentificativoCorrelazioni)>0&quot;>&#xa;                            &lt;Correlazioni>&#xa;                                &lt;IdentificativoCorrelazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:Correlazioni/ns1:IdentificativoCorrelazioni&quot;/>&#xa;                                &lt;/IdentificativoCorrelazioni>&#xa;                                &lt;TotaleRichieste>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:Correlazioni/ns1:TotaleRichieste&quot;/>&#xa;                                &lt;/TotaleRichieste>&#xa;                            &lt;/Correlazioni>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;CodiceOpRecipient>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:CodiceOpRecipient&quot;/>&#xa;                        &lt;/CodiceOpRecipient>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:CodiceProgetto&quot;>&#xa;                            &lt;CodiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Annullamento/ns1:CodiceProgetto&quot;/>&#xa;                            &lt;/CodiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/Annullamento>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC)&quot;>&#xa;                    &lt;Rimodulazione_DAC>&#xa;                        &lt;TipoComunicazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/ns1:ComunicazioneNP/ns1:Richiesta[number($index)]/ns1:Rimodulazione_DAC/ns1:TipoComunicazione&quot;/>&#xa;                        &lt;/TipoComunicazione>&#xa;                      