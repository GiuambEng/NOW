    &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione) and ($rich/Testata/CodiceOlo!=&amp;quot;TLC&amp;quot; or ($rich/Testata/CodiceOlo=&amp;quot;TLC&amp;quot; and  ($rich/Ordine/Migrazione/CodiceDonating1=&amp;quot;TLC&amp;quot; or not(string-length($rich/Ordine/Migrazione/CodiceDonating1)>0)) and ($rich/Ordine/Migrazione/CodiceDonating2=&amp;quot;TLC&amp;quot; or not(string-length($rich/Ordine/Migrazione/CodiceDonating2)>0)) ))&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONEOLO&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione) and ($rich/Testata/CodiceOlo=&amp;quot;TLC&amp;quot; and (($rich/Ordine/Migrazione/CodiceDonating1!=&amp;quot;TLC&amp;quot; and string-length($rich/Ordine/Migrazione/CodiceDonating1)>0) or ($rich/Ordine/Migrazione/CodiceDonating2!=&amp;quot;TLC&amp;quot; and string-length($rich/Ordine/Migrazione/CodiceDonating2)>0)))&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RIENTROINTI&amp;quot;&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTS)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$rich/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTS=&amp;quot;15&amp;quot;&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;INCREMENTOBORCHIA&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONESTS&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTS)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$rich/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTS=&amp;quot;16&amp;quot;&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;DECREMENTOBORCHIA&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONESTS&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTSMultinumero)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONESTSMULTINUMERO&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTSMultinumero)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONESTSMULTINUMERO&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)>0&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR=&amp;quot;3&amp;quot; or $rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR=&amp;quot;4&amp;quot;&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;CAMBIONUMERO&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;PRESTAZIONEWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)>0&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;TRASLOCOWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)>0&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;CAMBIOTIPOLOGIAWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CAMBIOCANALIWLR&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/DestinazioneUso)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONEDESTINAZIONEUSO&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/CessSolaNPsuULL-NP)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DECREMENTONP&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/CessSoloUllsuULL-NP)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DECREMENTOULL&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/CambioCoppia)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;CAMBIOCOPPIA&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/Trasloco)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;TRASLOCO&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneSLU/DestinazioneUso)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONEDESTINAZIONEUSO&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneSLU/CessSolaNPsuSLU-NP)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DECREMENTONP&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneSLU/CessSoloSLUsuSLU-NP)&quot;>&#xa;                            &lt;tipologiaSottolav>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DECREMENTOSLU&amp;quot;&quot;/>&#xa;                            &lt;/tipologiaSottolav>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/Rifiuto/CodiceMotivoRifiuto&quot;>&#xa;                &lt;codiceRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/Rifiuto/CodiceMotivoRifiuto&quot;/>&#xa;                &lt;/codiceRifiuto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($rich/Ordine/Migrazione/Servizio/node()/NP/RoutingNumberRecipient)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/Ordine/Migrazione/Servizio/node()/NP/RoutingNumberRecipient&quot;>&#xa;                        &lt;routingNumber>&#xa;                            &lt;xsl:value-of select=&quot;$rich/Ordine/Migrazione/Servizio/node()/NP/RoutingNumberRecipient&quot;/>&#xa;                        &lt;/routingNumber>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/node()/node()[1]/RoutingNumber[1])>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/Ordine/Variazione/node()/node()[1]/RoutingNumber[1]&quot;>&#xa;                        &lt;routingNumber>&#xa;                            &lt;xsl:value-of select=&quot;$rich/Ordine/Variazione/node()/node()[1]/RoutingNumber[1]&quot;/>&#xa;                        &lt;/routingNumber>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($rich/Ordine/Cessazione/node()/node()[1]/RoutingNumber[1])>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$rich/Ordine/Cessazione/node()/node()[1]/RoutingNumber[1]&quot;>&#xa;                        &lt;routingNumber>&#xa;                            &lt;xsl:value-of select=&quot;$rich/Ordine/Cessazione/node()/node()[1]/RoutingNumber[1]&quot;/>&#xa;                        &lt;/routingNumber>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione) and (exists($rich/Ordine/Migrazione/Servizio/Ull)  or exists($rich/Ordine/Migrazione/Servizio/SLU)) and upper-case($rich/Ordine/Migrazione/CodiceSessione1)='CAMBIOTECNOLOGIA' and string-length($rich/Testata/CodiceProgetto)>0&quot;>&#xa;                    &lt;disaggregato>&#xa;                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                    &lt;/disaggregato>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($rich/Testata/CodiceProgetto)>0 and exists($rich/Ordine/Migrazione/Servizio/node()/Disaggregazione)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCodiceProgetto2/tns5:FlagFittizio='FALSE'&quot;/>&#xa;                        &lt;xsl:when test=&quot;upper-case($VerificaCodiceProgetto2/tns5:FlagFittizio)='SI'&quot;>&#xa;                            &lt;disaggregato>&#xa;                                &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                            &lt;/disaggregato>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;disaggregato>&#xa;                                &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                            &lt;/disaggregato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;not(string-length($rich/Testata/CodiceProgetto)>0) and exists($rich/Ordine/Migrazione/Servizio/node()/Disaggregazione)&quot;>&#xa;                    &lt;disaggregato>&#xa;                        &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                    &lt;/disaggregato>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($FlagOscuramento/Record[COD_AGESP='R1I-19-0175'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-19-0175']/FLAG_OSCURMENTO='1'&quot;/>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione) and upper-case($rich/Ordine/Migrazione/CodiceSessione1)='CAMBIOTECNOLOGIA'&quot;>&#xa;                    &lt;cambioTecnologia>&#xa;                        &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                    &lt;/cambioTecnologia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/TipoNotifica&quot;>&#xa;                &lt;tipoComunicazioneCPS>&#xa;                    &lt;xsl:value-of select=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/TipoNotifica&quot;/>&#xa;                &lt;/tipoComunicazioneCPS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
