                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Annullamento"
                                    name="Annullamento"
                                    outputVariable="Annullamento"
                                    tibex:xpdlId="bb79ea85-09c9-4b38-b7d1-0ca1a31585bb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="TransformXml1ToAnnullamento"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToInvoke_ATT_ANN_loc1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$TransitoryProperty = &quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$TransitoryProperty = "Y"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="AnnullamentoToContatoreNOW">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSann&quot;/>&#xa;    &lt;xsl:template name=&quot;Annullamento&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns1:Richiesta[concat(string(codificaOLOAGCOM), codiceOrdineOLOTarget) = concat($ATT-ANNArray/tns1:Richiesta[number($index)]/codificaOLOAGCOM, $ATT-ANNArray/tns1:Richiesta[number($index)]/codiceOrdineOLO) and (lavorazione = &amp;quot;ANNULLAMENTO&amp;quot; or lavorazione=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;)][1]&quot;>&#xa;            &lt;xsl:for-each select=&quot;.&quot;>&#xa;                &lt;ns:RichiestaElement>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;statoRichiestaNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                    &lt;/statoRichiestaNOW>&#xa;                    &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                        &lt;statoRichiestaPrecedNOW>&#xa;                            &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                        &lt;/statoRichiestaPrecedNOW>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                        &lt;statoRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                        &lt;/statoRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                        &lt;statoRichiestaPrecedOLO>&#xa;                            &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                        &lt;/statoRichiestaPrecedOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                        &lt;sottostatoLavorManuale>&#xa;                            &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                        &lt;/sottostatoLavorManuale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                        &lt;IDFileInput>&#xa;                            &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                        &lt;/IDFileInput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                        &lt;IDFileOutput>&#xa;                            &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                        &lt;/IDFileOutput>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;ambito&quot;>&#xa;                        &lt;ambito>&#xa;                            &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                        &lt;/ambito>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;canaleRichiesta>&#xa;    