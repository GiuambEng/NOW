rManuale&quot;>&#xa;                &lt;sottostatoLavorManuale>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/sottostatoLavorManuale&quot;/>&#xa;                &lt;/sottostatoLavorManuale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/IDFileInput&quot;>&#xa;                &lt;IDFileInput>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/IDFileInput&quot;/>&#xa;                &lt;/IDFileInput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/IDFileOutput&quot;>&#xa;                &lt;IDFileOutput>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/IDFileOutput&quot;/>&#xa;                &lt;/IDFileOutput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Invoke_ATT_ANN_loc/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Invoke_ATT_ANN_loc/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SDR&amp;quot;&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Annullamento/ambito&quot;>&#xa;                        &lt;ambito>&#xa;                            &lt;xsl:value-of select=&quot;$Annullamento/ambito&quot;/>&#xa;                        &lt;/ambito>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/canaleRichiesta&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:if test=&quot;$Annullamento/lavorazione&quot;>&#xa;                &lt;lavorazione>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/lavorazione&quot;/>&#xa;                &lt;/lavorazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/progressivoRichiestaFile&quot;>&#xa;                &lt;progressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/progressivoRichiestaFile&quot;/>&#xa;                &lt;/progressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;strutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/strutturaRichiesta&quot;/>&#xa;            &lt;/strutturaRichiesta>&#xa;            &lt;tipoRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/tipoRichiesta&quot;/>&#xa;            &lt;/tipoRichiesta>&#xa;            &lt;xsl:if test=&quot;$Annullamento/IDRisorsa&quot;>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/IDRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;codificaOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Annullamento/codificaOLOAGCOM&quot;/>&#xa;            &lt;/codificaOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$Annullamento/codificaOLONOW&quot;>&#xa;                &lt;codificaOLONOW>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/codificaOLONOW&quot;/>&#xa;                &lt;/codificaOLONOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/codiceOrdineOLO&quot;>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Annullamento/codiceOrdineOLO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Annullamento/codiceOrdineOLOTarget&quot;>&#xa; 