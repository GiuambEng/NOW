                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Richiesta"
                                    name="Arricchimento"
                                    outputVariable="Richiesta"
                                    tibex:xpdlId="1083be99-f451-42a3-b174-48fad9596416" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToArricchimento"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToRenderXml1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ArricchimentoToMapper6">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Richiesta/ordine/referente[contains(telefonoFissoReferente,'kk') or contains(telefonoMobileReferente, 'kk')])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($Richiesta/ordine/referente[contains(telefonoFissoReferente,'kk') or contains(telefonoMobileReferente, 'kk')])>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.example.org/DeterminaSottoLavorazione&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;ID_Offerta&quot;/>&#xa;    &lt;xsl:param name=&quot;DescrComune&quot;/>&#xa;    &lt;xsl:param name=&quot;MapSottoLavorazione&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/created&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/lastUpdate&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/operatore&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/IDRichiestaOLO&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaNOW&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;xsl:if test=&quot;$Richiesta/statoRichiestaPrecedNOW&quot;>&#xa;                &lt;statoRichiestaPrecedNOW>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaPrecedNOW&quot;/>&#xa;                &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/statoRichiestaOLO&quot;>&#xa;                &lt;statoRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaOLO&quot;/>&#xa;                &lt;/statoRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;>&#xa;                &lt;statoRichiestaPrecedOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/statoRichiestaPrecedOLO&quot;/>&#xa;                &lt;/statoRichiestaPrecedOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/sottostatoLavorManuale&quot;>&#xa;                &lt;sottostatoLavorManuale>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/sottostatoLavorManuale&quot;/>&#xa;                &lt;/sottostatoLavorManuale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDFileInput&quot;>&#xa;                &lt;IDFileInput>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDFileInput&quot;/>&#xa;                &lt;/IDFileInput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDFileOutput&quot;>&#xa;                &lt;IDFileOutput>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDFileOutput&quot;/>&#xa;                &lt;/IDFileOutput>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&#xa;                &lt;ambito>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&#xa;                &lt;/ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/canaleRichiesta&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                &lt;lavorazione>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                &lt;/lavorazione>&#xa;        