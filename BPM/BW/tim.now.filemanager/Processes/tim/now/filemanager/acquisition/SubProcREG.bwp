  &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/codiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/codiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/ordine/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/DADRimodulata&quot;>&#xa;                        &lt;DADRimodulata>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/DADRimodulata&quot;/>&#xa;                        &lt;/DADRimodulata>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/DEC&quot;>&#xa;                        &lt;DEC>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/DEC&quot;/>&#xa;                        &lt;/DEC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/DES&quot;>&#xa;                        &lt;DES>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/DES&quot;/>&#xa;                        &lt;/DES>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/ORA_DES&quot;>&#xa;                        &lt;ORA_DES>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/ORA_DES&quot;/>&#xa;                        &lt;/ORA_DES>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/IDRisorsa&quot;>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/ordine/IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;tipologiaLavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/ordine/tipologiaLavorazione&quot;/>&#xa;                    &lt;/tipologiaLavorazione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;../lavorazione='CESSAZIONE' and string-length($MapSottoLavorazione/tns6:DeterminaSottoLavorazione/tns6:SottoLavorazione)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$MapSottoLavorazione/tns6:DeterminaSottoLavorazione/tns6:SottoLavorazione&quot;>&#xa;                                &lt;tipologiaSottolav>&#xa;                                    &lt;xsl:value-of select=&quot;$MapSottoLavorazione/tns6:DeterminaSottoLavorazione/tns6:SottoLavorazione&quot;/>&#xa;                                &lt;/tipologiaSottolav>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;../offerta='VARIAZIONE' and string-length($MapSottoLavorazione/tns6:DeterminaSottoLavorazione/tns6:SottoLavorazione)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$MapSottoLavorazione/tns6:DeterminaSottoLavorazione/tns6:SottoLavorazione&quot;>&#xa;                                &lt;tipologiaSottolav>&#xa;                                    &lt;xsl:value-of select=&quot;$MapSottoLavorazione/tns6:DeterminaSottoLavorazione/tns6:SottoLavorazione&quot;/>&#xa;                                &lt;/tipologiaSottolav>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$Richiesta/ordine/tipologiaSottolav&quot;>&#xa;                                &lt;tipologiaSottolav>&#xa;                                    &lt;xsl:value-of select=&quot;$Richiesta/ordine/tipologiaSottolav&quot;/>&#xa;                                &lt;/tipologiaSottolav>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/LNA_LA&quot;>&#xa;                        &lt;LNA_LA>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/LNA_LA&quot;/>&#xa;                        &lt;/LNA_LA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/modalitaFatturazione&quot;>&#xa;                        &lt;modalitaFatturazione>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/modalitaFatturazione&quot;/>&#xa;                        &lt;/modalitaFatturazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/operatore&quot;>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/RO&quot;>&#xa;                        &lt;RO>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/RO&quot;/>&#xa;                        &lt;/RO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/lastUpdate&quot;>&#xa;                        &lt;lastUpdate>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/lastUpdate&quot;/>&#xa;                        &lt;/lastUpdate>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/tipoPacchetto&quot;>&#xa;                        &lt;tipoPacchetto>&#xa;                            &lt;xsl:value