                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ReferenteAltreLavorazioni"
                                    name="RefAltreLav"
                                    outputVariable="ReferenteAltreLavorazioni"
                                    tibex:xpdlId="b28af606-dc03-4963-a271-634e2e6a787f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXmlToCallProcess1"/>
                                    <bpws:target linkName="CallProcess1ToRefAltreLav"/>
                                    <bpws:target linkName="CalDeterminazToRefAltreLav"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:ns45=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CallTok&quot;/>&#xa;    &lt;xsl:param name=&quot;CalDeterminaz&quot;/>&#xa;    &lt;xsl:template name=&quot;ReferenteAltreLavorazioni&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:ESITO='OK' and (exists($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento) and string-length($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/CognomeReferente)>0)&quot;>&#xa;                &lt;ns:ReferenteElement>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;progressivoReferente>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivoReferente>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEAPPUNTAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/QualificaRef&quot;>&#xa;                        &lt;qualificaReferente>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/QualificaRef&quot;/>&#xa;                        &lt;/qualificaReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;>&#xa;                        &lt;cognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/cognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/NomeReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                            &lt;telefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                            &lt;/telefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoMobileReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                            &lt;telefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                            &lt;/telefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/EmailReferente&quot;>&#xa;                        &lt;emailReferente>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/EmailReferente&quot;/>&#xa;                        &lt;/emailReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;flag_Token>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/flag_Token>&#xa;                &lt;/ns:ReferenteElement>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:ESITO='OK' and (exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione) and string-length($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente)>0)&quot;>&#xa;                &lt;ns:ReferenteElement>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;progressivoReferente>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/progressivoReferente>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CallTok/tns4:ResponseCreate_token) and (exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione) and string-length($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente)>0)&quot;>&#xa;                            &lt;tipoReferenteOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipoReferenteOrdine>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tipoReferenteOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEAPPUNTAMENTO&amp;quot;&quot;/>&#xa;                            &lt;/tipoReferenteOrdine>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/QualificaRef&quot;>&#xa;                        &lt;qualificaReferente>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/QualificaRef&quot;/>&#xa;                        &lt;/qualificaReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;>&#xa;                        &lt;cognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;/>&#xa;                        &lt;/cognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/NomeReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                            &lt;telefonoFissoReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                            &lt;/telefonoFissoReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                            &lt;telefonoMobileReferente>&#xa;                                &lt;xsl:value-of select=&quot;$CallTok/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                            &lt;/telefonoMobileReferente>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;flag_Token>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/flag_Token>&#xa;                &lt;/ns:ReferenteElement>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;($CallTok/tns4:ResponseCreate_token/tns4:ESITO='KO' or $CalDeterminaz/ns45:TipoToken='NOTOKEN') and (exists($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento) and string-length($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/CognomeReferente)>0)&quot;>&#xa;                        &lt;ns:ReferenteElement>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                            &lt;tipoReferenteOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTERIMODULAZIONEAPPUNTAMENTO&amp;quot;&quot;/>&#xa;                            &lt;/tipoReferenteOrdine>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/QualificaRef&quot;>&#xa;                                &lt;qualificaReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/QualificaRef&quot;/>&#xa;                                &lt;/qualificaReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/CognomeReferente&quot;>&#xa;                                &lt;cognomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/CognomeReferente&quot;/>&#xa;                                &lt;/cognomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/NomeReferente&quot;>&#xa;                                &lt;nomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/NomeReferente&quot;/>&#xa;                                &lt;/nomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoFissoReferente&quot;>&#xa;                                &lt;telefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoFissoReferente&quot;/>&#xa;                                &lt;/telefonoFissoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoMobileReferente&quot;>&#xa;                                &lt;telefonoMobileReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoMobileReferente&quot;/>&#xa;                                &lt;/telefonoMobileReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/EmailReferente&quot;>&#xa;                                &lt;emailReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/EmailReferente&quot;/>&#xa;                                &lt;/emailReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;flag_Token>&#xa;                                &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                            &lt;/flag_Token>&#xa;                        &lt;/ns:ReferenteElement>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;($CallTok/tns4:ResponseCreate_token/tns4:ESITO='KO' or $CalDeterminaz/ns45:TipoToken='NOTOKEN') and (exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione) and string-length($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente)>0)&quot;>&#xa;                        &lt;ns:ReferenteElement>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                            &lt;tipoReferenteOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipoReferenteOrdine>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/QualificaRef&quot;>&#xa;                                &lt;qualificaReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/QualificaRef&quot;/>&#xa;                                &lt;/qualificaReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente&quot;>&#xa;                                &lt;cognomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente&quot;/>&#xa;                                &lt;/cognomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/NomeReferente&quot;>&#xa;                                &lt;nomeReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/NomeReferente&quot;/>&#xa;                                &lt;/nomeReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;>&#xa;                                &lt;telefonoFissoReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;/>&#xa;                                &lt;/telefonoFissoReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;>&#xa;                                &lt;telefonoMobileReferente>&#xa;                                    &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;/>&#xa;                                &lt;/telefonoMobileReferente>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;flag_Token>&#xa;                                &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                            &lt;/flag_Token>&#xa;                        &lt;/ns:ReferenteElement>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ReferenteElement>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;tipoReferenteOrdine>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                            &lt;/tipoReferenteOrdine>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;FAKE&amp;quot;&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/ns:ReferenteElement>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
