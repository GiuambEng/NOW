                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;CallLocatorALT&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns9:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns9:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns9:StringaCRMWS,$Richiesta/contenutoXML)&quot;/>&lt;/tns9:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaCRMWS&quot;/>&lt;/tns9:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorALT/tns11:Risposta/tns11:RC=&amp;quot;09&amp;quot; or $CallLocatorALT/tns11:Risposta/tns11:RC=&amp;quot;10&amp;quot; or $CallLocatorALT/tns11:Risposta/tns11:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns9:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns9:StringaSDR,$Richiesta/contenutoXML)&quot;/>&lt;/tns9:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaSDR&quot;/>&lt;/tns9:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns9:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaDBCFX&quot;/>&lt;/tns9:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns9:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreCRMWS+1)&quot;/>&lt;/tns9:ContatoreCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreCRMWS&quot;/>&lt;/tns9:ContatoreCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Contatori/tns9:ContatoreWSDP&quot;>&lt;tns9:ContatoreWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreWSDP&quot;/>&lt;/tns9:ContatoreWSDP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorALT/tns11:Risposta/tns11:RC=&amp;quot;09&amp;quot; or $CallLocatorALT/tns11:Risposta/tns11:RC=&amp;quot;10&amp;quot; or $CallLocatorALT/tns11:Risposta/tns11:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns9:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreSDR+1)&quot;/>&lt;/tns9:ContatoreSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreSDR>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreSDR&quot;/>&lt;/tns9:ContatoreSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns9:ContatoreDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreDBCFX&quot;/>&lt;/tns9:ContatoreDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&lt;tns9:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreNOW+1)&quot;/>&lt;/tns9:ContatoreNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreNOW>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreNOW&quot;/>&lt;/tns9:ContatoreNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&lt;tns9:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreKO+1)&quot;/>&lt;/tns9:ContatoreKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreKO>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreKO&quot;/>&lt;/tns9:ContatoreKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns9:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
