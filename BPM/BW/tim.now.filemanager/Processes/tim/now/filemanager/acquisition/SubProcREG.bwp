or
(exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneNPnG) and not(string-length($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneNPnG/DataDAC)))]]></bpws:transitionCondition>
