                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper6-input"
                                    name="Mapper6"
                                    outputVariable="Mapper6"
                                    tibex:xpdlId="3ae52758-3282-4ef9-944a-ca45c8f48593" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
