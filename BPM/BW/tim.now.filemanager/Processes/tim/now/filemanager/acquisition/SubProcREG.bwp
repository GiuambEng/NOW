                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione) and string-length($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente)>0) or
(exists($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento) and string-length($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/CognomeReferente)>0)]]></bpws:transitionCondition>
                                    </bpws:source>
