>&#xa;                        &lt;codiceOrdineOLOPadre>&#xa;                            &lt;xsl:value-of select=&quot;$rich/Testata/CodiceOrdineOloPadre&quot;/>&#xa;                        &lt;/codiceOrdineOLOPadre>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$rich/Testata/CodiceProgetto&quot;>&#xa;                        &lt;codiceProgetto>&#xa;                            &lt;xsl:value-of select=&quot;$rich/Testata/CodiceProgetto&quot;/>&#xa;                        &lt;/codiceProgetto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$rich/Testata/CodiceOlo&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/Cessazione/CessazioneNPnG/DN)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$rich/Ordine/Cessazione/CessazioneNPnG/DN&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/Ordine/Cessazione/CessazioneNPnG/DN&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/*[1]/*[1]/*[1]/IDRisorsa[1])>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$rich/Ordine/*[1]/*[1]/*[1]/IDRisorsa[1]&quot;>&#xa;                                &lt;IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$rich/Ordine/*[1]/*[1]/*[1]/IDRisorsa[1]&quot;/>&#xa;                                &lt;/IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($rich/Ordine/Cessazione/CessazioneWLRLineaAttiva/DN)>0&quot;>&#xa;                