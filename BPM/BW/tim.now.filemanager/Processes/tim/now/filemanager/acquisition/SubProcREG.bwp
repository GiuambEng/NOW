                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperRichiestaToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallLocatorALTToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;NOW&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza="NOW"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorALTToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;CRMWS&quot; or ($CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza=&quot;KO&quot; and ($CallLocatorALT/ns11:Risposta/ns11:RC=&quot;09&quot; or $CallLocatorALT/ns11:Risposta/ns11:RC=&quot;10&quot; or $CallLocatorALT/ns11:Risposta/ns11:RC=&quot;14&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza="CRMWS" or ($CallLocatorALT/ns11:Risposta/ns11:SistemaDiCompetenza="KO" and ($CallLocatorALT/ns11:Risposta/ns11:RC="09" or $CallLocatorALT/ns11:Risposta/ns11:RC="10" or $CallLocatorALT/ns11:Risposta/ns11:RC="14"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallLocatorALTToGroupEnd2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;CallLocatorALT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:RichiestaLocalizzatore>&#xa;            &lt;tns11:Testata>&#xa;                &lt;tns11:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&#xa;                &lt;/tns11:Transaction_id>&#xa;                &lt;tns11:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns11:Transaction_date>&#xa;                &lt;tns11:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns11:Sistema_origine>&#xa;            &lt;/tns11:Testata>&#xa;            &lt;tns11:Richiesta>&#xa;                &lt;tns11:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns11:DataRichiesta>&#xa;                &lt;tns11:CodiceOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns11:CodiceOLO>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codificaOLONOW&quot;>&#xa;                    &lt;tns11:CodiceISP>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codificaOLONOW&quot;/>&#xa;                    &lt;/tns11:CodiceISP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                    &lt;tns11:CodiceComune>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                    &lt;/tns11:CodiceComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;CESSAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;ULLLINEAATTIVANP&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ULL-NP&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;ULLDATILINEANONATTIVA&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ULLDati&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;ULLDATILINEAATTIVANP&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ULLDati-NP&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;SLULINEANONATTIVA&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;SLULINEAATTIVANP&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SLU-NP&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SharedAccess&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;CessazioneWLRLineaNonAttiva&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;CessazioneWLRLineaAttiva&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;VULL&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Vull&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;CPS&amp;quot;&quot;>&#xa;                                        &lt;tns11:Servizio>&#xa;                                            &lt;xsl:value-of select=&quot;'CESSAZIONECPS'&quot;/>&#xa;                                        &lt;/tns11:Servizio>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                                            &lt;tns11:Servizio>&#xa;                                                &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                                            &lt;/tns11:Servizio>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;ULL&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;ULLDATI&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;ULLDati&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;SLU&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;WLR&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;WLR&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;VULL&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Vull&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;SHAREDACCESS&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;SharedAccess&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                                    &lt;tns11:Servizio>&#xa;                                        &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                                    &lt;/tns11:Servizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VariazioneULL&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;SLU&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VariazioneSLU&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$Richiesta/offerta=&amp;quot;WLR&amp;quot;&quot;>&#xa;                                &lt;tns11:Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;VariazioneWLR&amp;quot;&quot;/>&#xa;                                &lt;/tns11:Servizio>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                                    &lt;tns11:Servizio>&#xa;                                        &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                                    &lt;/tns11:Servizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/offerta&quot;>&#xa;                            &lt;tns11:Servizio>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/offerta&quot;/>&#xa;                            &lt;/tns11:Servizio>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Richiesta/lavorazione=&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;>&#xa;                        &lt;tns11:Richiesta>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&#xa;                        &lt;/tns11:Richiesta>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/lavorazione&quot;>&#xa;                            &lt;tns11:Richiesta>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/lavorazione&quot;/>&#xa;                            &lt;/tns11:Richiesta>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;upper-case($Richiesta/offerta)=&amp;quot;ULLLINEANONATTIVA&amp;quot; and upper-case($Richiesta/lavorazione)=&amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                    &lt;tns11:Sottolavorazione>&#xa;                        &lt;xsl:value-of select=&quot;local-name($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneULL/*[1])&quot;/>&#xa;                    &lt;/tns11:Sottolavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                    &lt;tns11:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                    &lt;/tns11:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;tns11:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/tns11:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;not(exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR)) and not(exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva)) and not(exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva)) and not(exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione))&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                            &lt;tns11:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/tns11:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa1)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa1&quot;>&#xa;                            &lt;tns11:IdRisorsa>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa1&quot;/>&#xa;                            &lt;/tns11:IdRisorsa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns11:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns11:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva/Rientro) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneSLU/SLU-NP/Rientro) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/Vull/Rientro) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULL-NP/Rientro) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULLDati-NP/Rientro)&quot;>&#xa;                    &lt;tns11:Rientro_TI>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&#xa;                    &lt;/tns11:Rientro_TI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa2)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa2&quot;>&#xa;                        &lt;tns11:IdRisorsa2>&#xa;                            &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa2&quot;/>&#xa;                        &lt;/tns11:IdRisorsa2>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/IDRisorsa)>0 and (exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva))&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                            &lt;tns11:Telefonico>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                            &lt;/tns11:Telefonico>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns11:DNAggiuntivi>&#xa;                    &lt;xsl:if test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/node()/NP/DN)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/node()/NP/DN&quot;>&#xa;                            &lt;tns11:DN>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/node()/NP/DN&quot;/>&#xa;                            &lt;/tns11:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/*/NP/DNaggiuntive&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns11:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns11:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns11:DNAggiuntivi>&#xa;                &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia='9' or $NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia='11'&quot;>&#xa;                    &lt;tns11:CodiceCambioTipologia>&#xa;                        &lt;xsl:value-of select=&quot;'WLR9-11-NOW'&quot;/>&#xa;                    &lt;/tns11:CodiceCambioTipologia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneCPS) and  exists($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']) and (upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)='Y' or upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)='1'or upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)='S')&quot;>&#xa;                    &lt;tns11:CPS>&#xa;                        &lt;xsl:value-of select=&quot;'CPS'&quot;/>&#xa;                    &lt;/tns11:CPS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns11:Richiesta>&#xa;        &lt;/tns11:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.CallLocator" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Contatori"
                                    name="ContatoriNOW_ALT"
                                    outputVariable="Contatori"
                                    tibex:xpdlId="d5166cf5-70b9-4ac6-ad96-dcf81d1ef1b2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallLocatorALTToAssign"/>
                                    <bpws:target linkName="MapperRichiestaToContatoriNOW_ALT"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="ContatoriNOW_ALTToEmpty2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.example.org/ListaContatori&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns9:Contatori>&lt;tns9:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaCRMWS&quot;/>&lt;/tns9:StringaCRMWS>&lt;tns9:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaSDR&quot;/>&lt;/tns9:StringaSDR>&lt;tns9:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaDBCFX&quot;/>&lt;/tns9:StringaDBCFX>&lt;tns9:ContatoreCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreCRMWS&quot;/>&lt;/tns9:ContatoreCRMWS>&lt;xsl:if test=&quot;$Contatori/tns9:ContatoreWSDP&quot;>&lt;tns9:ContatoreWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreWSDP&quot;/>&lt;/tns9:ContatoreWSDP>&lt;/xsl:if>&lt;tns9:ContatoreSDR>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreSDR&quot;/>&lt;/tns9:ContatoreSDR>&lt;tns9:ContatoreDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreDBCFX&quot;/>&lt;/tns9:ContatoreDBCFX>&lt;tns9:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreNOW+1)&quot;/>&lt;/tns9:ContatoreNOW>&lt;tns9:ContatoreKO>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreKO&quot;/>&lt;/tns9:ContatoreKO>&lt;/tns9:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
