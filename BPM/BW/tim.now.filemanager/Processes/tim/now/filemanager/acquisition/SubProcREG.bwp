                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/ReferenteXML/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper6-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Referente>&#xa;            &lt;xsl:for-each select=&quot;$Richiesta/ordine/referente[tipoReferenteOrdine!='REFERENTEONFIELD']&quot;>&#xa;                &lt;tns10:Referente>&#xa;                    &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                        &lt;tns10:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                        &lt;/tns10:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                        &lt;tns10:QualificaRef>&#xa;                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                        &lt;/tns10:QualificaRef>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;cognomeReferente&quot;>&#xa;                        &lt;tns10:CognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                        &lt;/tns10:CognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;nomeReferente&quot;>&#xa;                        &lt;tns10:NomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                        &lt;/tns10:NomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                        &lt;tns10:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns10:TelefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                        &lt;tns10:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns10:TelefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                        &lt;tns10:EmailReferente>&#xa;                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                        &lt;/tns10:EmailReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns10:Referente>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns10:Referente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:ReferenteXML="http://www.tim.com/NOW/xsd/ReferenteXML/"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
