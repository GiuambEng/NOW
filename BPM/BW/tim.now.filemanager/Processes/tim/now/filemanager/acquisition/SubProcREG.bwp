                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterNameATT-ANN&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderAtt&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderAnn&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSatt&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSann&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Annullamento&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;DNAlternativo&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformXml1&quot;/>&#xa;    &lt;xsl:param name=&quot;Controllo1&quot;/>&#xa;    &lt;xsl:template name=&quot;CreaRichiestaATT_ANN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Element>&#xa;            &lt;tns10:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns10:moduleName>&#xa;            &lt;tns10:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns10:parameterName>&#xa;            &lt;tns10:parameterName2>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterNameATT-ANN&quot;/>&#xa;            &lt;/tns10:parameterName2>&#xa;            &lt;tns10:operationName>&#xa;                &lt;xsl:value-of select=&quot;$BPMoperationName&quo