;                                    &lt;/particellaToponomastica>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;via&quot;>&#xa;                                    &lt;via>&#xa;                                        &lt;xsl:value-of select=&quot;via&quot;/>&#xa;                                    &lt;/via>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;codiceVia&quot;>&#xa;                                    &lt;codiceVia>&#xa;                                        &lt;xsl:value-of select=&quot;codiceVia&quot;/>&#xa;                                    &lt;/codiceVia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;civico&quot;>&#xa;                                    &lt;civico>&#xa;                                        &lt;xsl:value-of select=&quot;civico&quot;/>&#xa;                                    &lt;/civico>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;localita&quot;>&#xa;                                    &lt;localita>&#xa;                                        &lt;xsl:value-of select=&quot;localita&quot;/>&#xa;                                    &lt;/localita>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$ListaDescrComune/tns13:Comune[tns13:CodiceComune=current()/codiceISTATComune]/tns13:DescrComune&quot;>&#xa;                                    &lt;comune>&#xa;                                        &lt;xsl:value-of select=&quot;$ListaDescrComune/tns13:Comune[tns13:CodiceComune=current()/codiceISTATComune]/tns13:DescrComune&quot;/>&#xa;                                    &lt;/comune>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;provincia&quot;>&#xa;                                    &lt;pr