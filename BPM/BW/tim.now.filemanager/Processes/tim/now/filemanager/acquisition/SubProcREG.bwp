        &lt;tipologiaSottolav>&#xa;                                                &lt;xsl:value-of select=&quot;concat(&amp;quot;PRESTAZIONEWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)&quot;/>&#xa;                                            &lt;/tipologiaSottolav>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)>0&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;TRASLOCOWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)>0&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;concat(&amp;quot;CAMBIOTIPOLOGIAWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)&quot;/>&#xa;                                    &lt;/tipologiaSottolav>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali)&quot;>&#xa;                                    &lt;tipologiaSottolav>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;CAMBIOCANALIWLR&amp;quot;&quot;/>&#xa;                                    &lt;/tipologiaSottolav