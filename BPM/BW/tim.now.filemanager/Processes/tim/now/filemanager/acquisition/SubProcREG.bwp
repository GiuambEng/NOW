                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcess1ToRefAltreLav"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns8=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tns10=&quot;http://www.example.com/namespaces/tns/1646065896850&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:param name=&quot;CalDeterminaz&quot;/>&#xa;    &lt;xsl:template name=&quot;CallTok-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione)&quot;>&#xa;                    &lt;tns4:RequestCreate_token>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;>&#xa;                            &lt;tns4:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;/>&#xa;                            &lt;/tns4:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;>&#xa;                            &lt;tns4:CodiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;/>&#xa;                            &lt;/tns4:CodiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:Funzione>&#xa;                            &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                        &lt;/tns4:Funzione>&#xa;                        &lt;tns4:ChiaveRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;concat($NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                        &lt;/tns4:ChiaveRiferimento>&#xa;                        &lt;tns4:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                        &lt;/tns4:Operatore>&#xa;                        &lt;xsl:if test=&quot;$GetLocalIP/tns8:IPAddress&quot;>&#xa;                            &lt;tns4:IPClient>&#xa;                                &lt;xsl:value-of select=&quot;$GetLocalIP/tns8:IPAddress&quot;/>&#xa;                            &lt;/tns4:IPClient>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;>&#xa;                            &lt;tns4:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns4:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;>&#xa;                            &lt;tns4:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns4:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/NomeReferente&quot;>&#xa;                            &lt;tns4:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/NomeReferente&quot;/>&#xa;                            &lt;/tns4:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente&quot;>&#xa;                            &lt;tns4:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/InterruzioneSospensione/ReferenteDesospensione/CognomeReferente&quot;/>&#xa;                            &lt;/tns4:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:TOKENIZZAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$CalDeterminaz/tns10:TipoToken&quot;/>&#xa;                        &lt;/tns4:TOKENIZZAZIONE>&#xa;                    &lt;/tns4:RequestCreate_token>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns4:RequestCreate_token>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;>&#xa;                            &lt;tns4:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;/>&#xa;                            &lt;/tns4:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;>&#xa;                            &lt;tns4:CodiceOrdineOLO>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;/>&#xa;                            &lt;/tns4:CodiceOrdineOLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:Funzione>&#xa;                            &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                        &lt;/tns4:Funzione>&#xa;                        &lt;tns4:ChiaveRiferimento>&#xa;                            &lt;xsl:value-of select=&quot;concat($NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                        &lt;/tns4:ChiaveRiferimento>&#xa;                        &lt;tns4:Operatore>&#xa;                            &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                        &lt;/tns4:Operatore>&#xa;                        &lt;xsl:if test=&quot;$GetLocalIP/tns8:IPAddress&quot;>&#xa;                            &lt;tns4:IPClient>&#xa;                                &lt;xsl:value-of select=&quot;$GetLocalIP/tns8:IPAddress&quot;/>&#xa;                            &lt;/tns4:IPClient>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoFissoReferente&quot;>&#xa;                            &lt;tns4:N_Recap_Cliente>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns4:N_Recap_Cliente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoMobileReferente&quot;>&#xa;                            &lt;tns4:N_Recap_Cliente_ALT>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns4:N_Recap_Cliente_ALT>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/NomeReferente&quot;>&#xa;                            &lt;tns4:Nome>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/NomeReferente&quot;/>&#xa;                            &lt;/tns4:Nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/CognomeReferente&quot;>&#xa;                            &lt;tns4:CognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento/Referente/CognomeReferente&quot;/>&#xa;                            &lt;/tns4:CognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns4:TOKENIZZAZIONE>&#xa;                            &lt;xsl:value-of select=&quot;$CalDeterminaz/tns10:TipoToken&quot;/>&#xa;                        &lt;/tns4:TOKENIZZAZIONE>&#xa;                    &lt;/tns4:RequestCreate_token>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns4:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:ProcessIstance>&#xa;            &lt;tns4:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;            &lt;/tns4:StrutturaRichiesta>&#xa;            &lt;tns4:OffertaBPM>&#xa;                &lt;xsl:value-of select=&quot;$CalDeterminaz/tns10:Offerta&quot;/>&#xa;            &lt;/tns4:OffertaBPM>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty17" tibex:xpdlId="4f3da9c6-d434-4830-8f23-eb8c110edb8c">
                                <bpws:targets>
                                    <bpws:target linkName="Assign9ToEmpty17"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty17ToToken9_clientefinale">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/Nome)>0 or&#xd;&#xa;string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/Nome)>0 or&#xd;&#xa;string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/CognomeRagSoc)>0 or&#xd;&#xa;string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/CognomeRagSoc)>0 or&#xd;&#xa;string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/CF)>0 or&#xd;&#xa;string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/CF)>0 or&#xd;&#xa;string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/PIVA)>0 or&#xd;&#xa;string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/PIVA)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/Nome)>0 or
string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/Nome)>0 or
string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/CognomeRagSoc)>0 or
string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/CognomeRagSoc)>0 or
string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/CF)>0 or
string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/CF)>0 or
string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/*[1]/DatiCliente/PIVA)>0 or
string-length($NORMALarray/Richiesta[$index]/Ordine/node()/*[1]/DatiCliente/PIVA)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Empty17ToTransformXml">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
