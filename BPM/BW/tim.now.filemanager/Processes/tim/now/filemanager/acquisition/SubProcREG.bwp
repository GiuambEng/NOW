                    <bpws:sources>
                        <bpws:source linkName="MapperRaggruppamentoToLog8"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/RichiesteOLOxBPM&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;CodProgettoOrdWList&quot;/>&lt;xsl:template name=&quot;MapperRaggruppamento-input&quot; match=&quot;/&quot;>&lt;tns:RichiesteOLOSuddivise>&lt;xsl:for-each select=&quot;$Start/RichiestaOloRegolatorio/Richiesta&quot;>&lt;xsl:variable name=&quot;rich&quot; select=&quot;current()&quot;/>&lt;xsl:variable name=&quot;RTYPE&quot; select=&quot;if(exists(Ordine/Attivazione)) then &amp;#xD;&amp;#xA;&amp;#x9;if (exists(../Richiesta/Annullamento[../Testata/CodiceOlo = $rich/Testata/CodiceOlo and CodiceOrdineOlo = $rich/Testata/CodiceOrdineOlo]) or exists(../Richiesta/InterruzioneMigrazione[../Testata/CodiceOlo = $rich/Testata/CodiceOlo and CodiceOrdineRiferimentoTI = $rich/Testata/CodiceOrdineOlo])) then &amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATTANN' &amp;#xD;&amp;#xA;&amp;#x9;else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(Ordine/Migrazione)) then &amp;#xD;&amp;#xA;&amp;#x9;if (exists(../Richiesta/Annullamento[../Testata/CodiceOlo = $rich/Testata/CodiceOlo and CodiceOrdineOlo = $rich/Testata/CodiceOrdineOlo]) or exists(../Richiesta/InterruzioneMigrazione[../Testata/CodiceOlo = $rich/Testata/CodiceOlo and CodiceOrdineRiferimentoTI = $rich/Testata/CodiceOrdineOlo])) then &amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATTANN' &amp;#xD;&amp;#xA;&amp;#x9;else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(Annullamento)) then &amp;#xD;&amp;#xA;&amp;#x9;if (exists(../Richiesta/Ordine/Attivazione[../../Testata/CodiceOlo = $rich/Testata/CodiceOlo and ../../Testata/CodiceOrdineOlo = $rich/Annullamento/CodiceOrdineOlo]) or exists(../Richiesta/Ordine/Migrazione[../../Testata/CodiceOlo = $rich/Testata/CodiceOlo and ../../Testata/CodiceOrdineOlo = $rich/Annullamento/CodiceOrdineOlo])) then &amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATTANN' &amp;#xD;&amp;#xA;&amp;#x9;else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;if(exists(InterruzioneMigrazione)) then &amp;#xD;&amp;#xA;&amp;#x9;if (exists(../Richiesta/Ordine/Attivazione[../../Testata/CodiceOlo = $rich/Testata/CodiceOlo and ../../Testata/CodiceOrdineOlo = $rich/InterruzioneMigrazione/CodiceOrdineRiferimentoTI]) or exists(../Richiesta/Ordine/Migrazione[../../Testata/CodiceOlo = $rich/Testata/CodiceOlo and ../../Testata/CodiceOrdineOlo = $rich/InterruzioneMigrazione/CodiceOrdineRiferimentoTI])) then &amp;#x9;&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ATTANN' &amp;#xD;&amp;#xA;&amp;#x9;else &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;'ALT'&amp;#xD;&amp;#xA;else&amp;#xD;&amp;#xA;'ALT'&quot;/>&lt;tns:Richieste>&lt;xsl:if test=&quot;$RTYPE=&amp;quot;ATT&amp;quot;&quot;>&lt;tns:RichiesteATT>&lt;ns:RichiestaElement>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;statoRichiestaNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaNOW>&lt;statoRichiestaPrecedNOW>&lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&lt;/statoRichiestaPrecedNOW>&lt;IDFileInput>&lt;xsl:value-of select=&quot;xsd:int(../../ns1:ID_FILE)&quot;/>&lt;/IDFileInput>&lt;ambito>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/ambito>&lt;canaleRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&lt;/canaleRichiesta>&lt;lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/lavorazione>&lt;progressivoRichiestaFile>&lt;xsl:value-of select=&quot;xsd:int(position())&quot;/>&lt;/progressivoRichiestaFile>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/NPnonGeografica)&quot;>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;NPNG&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;strutturaRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&lt;/strutturaRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoRichiesta>&lt;xsl:value-of select=&quot;&amp;quot;ORDINE&amp;quot;&quot;/>&lt;/tipoRichiesta>&lt;xsl:if test=&quot;string-length(Ordine/Attivazione/WLRLineaAttiva/DN)>0 or string-length(Ordine/Attivazione/VULL/DN)>0 or string-length(Ordine/Attivazione/SLULineaAttivaNP/DN)>0 or string-length(Ordine/Attivazione/ULLLineaAttivaNP/DN)>0 or Ordine/Attivazione/NPnonGeografica or (string-length(Ordine/Attivazione/CPS/DN)>0 and (not(exists($FlagOscuramento/Record[COD_AGESP='R1I-19-0270'])) or (upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='Y' and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='1'and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='S')))&quot;>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/DN&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/DN&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO)>0&quot;>&lt;xsl:if test=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;../../ns1:CodISPdaNome&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../ns1:CodISPdaNome&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;Testata/CodiceOrdineOloPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOloPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;Testata/CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;Testata/CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/NPnonGeografica)&quot;>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,Ordine/Attivazione/NPnonGeografica/DataOrdine)&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../ns1:DATA_FILE), 1, 10))&quot;/>&lt;/dataInvioRichiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(Testata/Correlazioni/IdentificativoCorrelazioni)>0&quot;>&lt;xsl:if test=&quot;Testata/Correlazioni/IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;Testata/Correlazioni/IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(Testata/Correlazioni/TotRichieste)&quot;>&lt;totaleRichiestePacchetto>&lt;xsl:value-of select=&quot;xsd:int(Testata/Correlazioni/TotRichieste)&quot;/>&lt;/totaleRichiestePacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;Testata/Correlazioni/TipoPacchetto&quot;>&lt;tipoPacchetto>&lt;xsl:value-of select=&quot;Testata/Correlazioni/TipoPacchetto&quot;/>&lt;/tipoPacchetto>&lt;/xsl:if>&lt;contenutoXML>&lt;xsl:value-of select=&quot;tib:render-xml($rich)&quot;/>&lt;/contenutoXML>&lt;xsl:choose>&lt;xsl:when test=&quot;matches(Testata/Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;note>&lt;xsl:value-of select=&quot;translate(Testata/Note, '0123456789', '         ')&quot;/>&lt;/note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;Testata/Note&quot;>&lt;note>&lt;xsl:value-of select=&quot;Testata/Note&quot;/>&lt;/note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(Ordine/Attivazione/WLRLineaAttiva) or exists(Ordine/Attivazione/WLRLineaNonAttiva) or&amp;#xD;&amp;#xA;exists(Ordine/Attivazione/NPnonGeografica) or&amp;#xD;&amp;#xA; exists(Ordine/Attivazione/ULLLineaAttiva) or exists(Ordine/Attivazione/ULLLineaNonAttiva) or exists(Ordine/Attivazione/ULLLineaAttivaNP) or exists(Ordine/Attivazione/VULL) or exists(Ordine/Attivazione/VULLLineaNonAttiva) or exists(Ordine/Attivazione/SLULineaAttiva)  or exists(Ordine/Attivazione/SLULineaNonAttiva) or exists(Ordine/Attivazione/SLULineaAttivaNP) or (exists(Ordine/Attivazione/CPS) and (not(exists($FlagOscuramento/Record[COD_AGESP='R1I-19-0270'])) or (upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='Y' and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='1'and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='S')))&quot;>&lt;ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/NPnonGeografica)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;'NPNG'&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/CPS)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;CPS&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/WLRLineaAttiva) or exists(Ordine/Attivazione/WLRLineaNonAttiva)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;WLR&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/ULLLineaAttiva) or exists(Ordine/Attivazione/ULLLineaNonAttiva) or exists(Ordine/Attivazione/ULLLineaAttivaNP)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Ordine/Attivazione/VULL) or exists(Ordine/Attivazione/VULLLineaNonAttiva)&quot;>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;VULL&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;offertaCatalogo>&lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&lt;/offertaCatalogo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(Ordine/Attivazione/node()/DataDAC[1])>0&quot;>&lt;xsl:if test=&quot;tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, Ordine/Attivazione/node()/DataDAC[1])&quot;>&lt;DAC>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, Ordine/Attivazione/node()/DataDAC[1])&quot;/>&lt;/DAC>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(Ordine/Attivazione/node()/DataAppuntamentoDesiderata[1])>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($FlagOscuramento/Record[COD_AGESP='R1I-19-0350']) and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0350']/FLAG_OSCURMENTO)='1'&quot;>&lt;DAD>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,Ordine/Attivazione/node()/DataAppuntamentoDesiderata[1])&quot;/>&lt;/DAD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;(string-length(Ordine/Attivazione/ULLLineaNonAttiva/Disaggregazione/PresaAppuntamento/OwnerPresaAppuntamento)>0 and upper-case(Ordine/Attivazione/ULLLineaNonAttiva/Disaggregazione/PresaAppuntamento/OwnerPresaAppuntamento)='OP') or (string-length(Ordine/Attivazione/SLULineaNonAttiva/Disaggregazione/PresaAppuntamento/OwnerPresaAppuntamento)>0 and upper-case(Ordine/Attivazione/SLULineaNonAttiva/Disaggregazione/PresaAppuntamento/OwnerPresaAppuntamento)='OP')&quot;/>&lt;xsl:otherwise>&lt;DAD>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;,Ordine/Attivazione/node()/DataAppuntamentoDesiderata[1])&quot;/>&lt;/DAD>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/DatiCliente/CognomeRagSoc&quot;>&lt;cognomeRagioneSociale>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/DatiCliente/CognomeRagSoc&quot;/>&lt;/cognomeRagioneSociale>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/DatiCliente/Nome&quot;>&lt;nome>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/DatiCliente/Nome&quot;/>&lt;/nome>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/DatiCliente/CF&quot;>&lt;CF>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/DatiCliente/CF&quot;/>&lt;/CF>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/DatiCliente/PIVA&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/DatiCliente/PIVA&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/IdentificativoSLU/IdSLUCo&quot;>&lt;IDSLUCo>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/IdentificativoSLU/IdSLUCo&quot;/>&lt;/IDSLUCo>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/IdUllCo&quot;>&lt;IDULLCo>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/IdUllCo&quot;/>&lt;/IDULLCo>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/CodiceDelivery&quot;>&lt;codiceDelivery>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/CodiceDelivery&quot;/>&lt;/codiceDelivery>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/DNOLOCollaudo&quot;>&lt;DNOLOCollaudo>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/DNOLOCollaudo&quot;/>&lt;/DNOLOCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/NumeroVerdeOloCollaudo&quot;>&lt;numeroVerdeOloCollaudo>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/NumeroVerdeOloCollaudo&quot;/>&lt;/numeroVerdeOloCollaudo>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/NumeroVerdeOloPT&quot;>&lt;numeroVerdeOloPT>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/NumeroVerdeOloPT&quot;/>&lt;/numeroVerdeOloPT>&lt;/xsl:if>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/FlagMonitoraggio&quot;>&lt;flagMonitoraggio>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/FlagMonitoraggio&quot;/>&lt;/flagMonitoraggio>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;matches(Testata/Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;noteCliente>&lt;xsl:value-of select=&quot;translate(Testata/Note, '0123456789', '         ')&quot;/>&lt;/noteCliente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;Testata/Note&quot;>&lt;noteCliente>&lt;xsl:value-of select=&quot;Testata/Note&quot;/>&lt;/noteCliente>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO)>0&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$rich/Testata/CodiceOlo]/tns1:CodiceOLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../ns1:CodISPdaNome&quot;/>&lt;/codificaOLONOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:if test=&quot;Testata/CodiceOrdineOloPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOloPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;Testata/CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;Testata/CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;codificaOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/codificaOLOAGCOM>&lt;xsl:if test=&quot;string-length(Ordine/Attivazione/WLRLineaAttiva/DN)>0 or string-length(Ordine/Attivazione/VULL/DN)>0 or string-length(Ordine/Attivazione/SLULineaAttivaNP/DN)>0 or string-length(Ordine/Attivazione/ULLLineaAttivaNP/DN)>0 or string-length(Ordine/Attivazione/CPS/DN)>0 or string-length(Ordine/Attivazione/NPnonGeografica/DN)>0&quot;>&lt;xsl:if test=&quot;Ordine/Attivazione/node()/DN&quot;>&lt;IDRisorsa>&lt;xsl:value-of select=&quot;Ordine/Attivazione/node()/DN&quot;/>&lt;/IDRisorsa>&lt;/xsl:if>&lt;/xsl:if>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;tipologiaLavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/tipologiaLavorazione>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(local-name(Ordine/Attivazione/*), &amp;quot;NonAttiva&amp;quot;)&quot;>&lt;LNA_LA>&lt;xsl:value-of select=&quot;&amp;quot;LNA&amp;quot;&quot;/>&lt;/LNA_LA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;LNA_LA>&lt;xsl:value-of select=&quot;&amp;quot;LA&amp;quot;&quot;/>&lt;/LNA_LA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;xsl:if test=&quot;Testata/Correlazioni/TipoPacchetto&quot;>&lt;tipoPacchetto>&lt;xsl:value-of select=&quot;Testata/Correlazioni/TipoPacchetto&quot;/>&lt;/tipoPacchetto>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(Ordine/Attivazione/WLRLineaAttiva) or exists(Ordine/Attivazione/WLRLineaNonAttiva)&quot;>&lt;dettaglioordine>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRich