                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Mapper4-input"
                                    name="Mapper4"
                                    outputVariable="Mapper4"
                                    tibex:xpdlId="1688dbb4-2fbf-4c9e-8bae-fba391e1e6bd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty12ToMapper4"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Mapper4ToLog18"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/ReferenteXML/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper4-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Referente>&#xa;            &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns1:Richiesta[number($index)]/ordine/referente[qualificaReferente!='CF' and tipoReferenteOrdine!='REFERENTEONFIELD']&quot;>&#xa;                &lt;tns10:Referente>&#xa;                    &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                        &lt;tns10:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                        &lt;/tns10:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                        &lt;tns10:QualificaRef>&#xa;                            &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                        &lt;/tns10:QualificaRef>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;cognomeReferente&quot;>&#xa;                        &lt;tns10:CognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;cognomeReferente&quot;/>&#xa;                        &lt;/tns10:CognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;nomeReferente&quot;>&#xa;                        &lt;tns10:NomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;nomeReferente&quot;/>&#xa;                        &lt;/tns10:NomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                        &lt;tns10:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns10:TelefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;telefonoMobileReferente&quot;>&#xa;                        &lt;tns10:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns10:TelefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;emailReferente&quot;>&#xa;                        &lt;tns10:EmailReferente>&#xa;                            &lt;xsl:value-of select=&quot;emailReferente&quot;/>&#xa;                        &lt;/tns10:EmailReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns10:Referente>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$Referente/tns12:Request[string-length(tns12:Esito)>0]&quot;>&#xa;                &lt;tns10:Referente>&#xa;                    &lt;xsl:if test=&quot;tns12:Referente[1]/progressivoReferente&quot;>&#xa;                        &lt;tns10:Progressivo>&#xa;                            &lt;xsl:value-of select=&quot;tns12:Referente[1]/progressivoReferente&quot;/>&#xa;                        &lt;/tns10:Progressivo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns12:Referente[1]/qualificaReferente&quot;>&#xa;                        &lt;tns10:QualificaRef>&#xa;                            &lt;xsl:value-of select=&quot;tns12:Referente[1]/qualificaReferente&quot;/>&#xa;                        &lt;/tns10:QualificaRef>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns12:Referente[1]/cognomeReferente&quot;>&#xa;                        &lt;tns10:CognomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns12:Referente[1]/cognomeReferente&quot;/>&#xa;                        &lt;/tns10:CognomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns12:Referente[1]/nomeReferente&quot;>&#xa;                        &lt;tns10:NomeReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns12:Referente[1]/nomeReferente&quot;/>&#xa;                        &lt;/tns10:NomeReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns12:Referente[1]/telefonoFissoReferente&quot;>&#xa;                        &lt;tns10:TelefonoFissoReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns12:Referente[1]/telefonoFissoReferente&quot;/>&#xa;                        &lt;/tns10:TelefonoFissoReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns12:Referente[1]/telefonoMobileReferente&quot;>&#xa;                        &lt;tns10:TelefonoMobileReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns12:Referente[1]/telefonoMobileReferente&quot;/>&#xa;                        &lt;/tns10:TelefonoMobileReferente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns12:Referente[1]/emailReferente&quot;>&#xa;                        &lt;tns10:EmailReferente>&#xa;                            &lt;xsl:value-of select=&quot;tns12:Referente[1]/emailReferente&quot;/>&#xa;                        &lt;/tns10:EmailReferente>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns10:Referente>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns10:Referente>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
