                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Token9&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;NORMALarray&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ReferenteAltreLavorazioni&quot;/>&lt;xsl:template name=&quot;RenderXml2-input&quot; match=&quot;/&quot;>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOlo&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOloPadre&quot;>&lt;CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOloPadre&quot;/>&lt;/CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceProgetto&quot;>&lt;CodiceProgetto>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceProgetto&quot;/>&lt;/CodiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;matches($NORMALarray/Richiesta[$index]/Testata/Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;Note>&lt;xsl:value-of select=&quot;translate($NORMALarray/Richiesta[$index]/Testata/Note, '0123456789', '         ')&quot;/>&lt;/Note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/Note&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/Note&quot;/>&lt;/Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/Correlazioni&quot;/>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/ReferentiOAOPr