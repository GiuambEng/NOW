                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="ATTarray"
                                    name="AssignD420"
                                    outputVariable="ATTarray"
                                    tibex:xpdlId="f0456bf7-7fd5-4a00-97a0-1d68dbc0853f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
