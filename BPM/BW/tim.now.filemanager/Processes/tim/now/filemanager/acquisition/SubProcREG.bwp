Sottolav&quot;/>&#xa;                &lt;/tipologiaSottolav>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceRifiuto&quot;>&#xa;                &lt;codiceRifiuto>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceRifiuto&quot;/>&#xa;                &lt;/codiceRifiuto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/routingNumber&quot;>&#xa;                &lt;routingNumber>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/routingNumber&quot;/>&#xa;                &lt;/routingNumber>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/progressivoEmissioneDTU&quot;>&#xa;                &lt;progressivoEmissioneDTU>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/progressivoEmissioneDTU&quot;/>&#xa;                &lt;/progressivoEmissioneDTU>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/flagAttesaDesospOLO&quot;>&#xa;                &lt;flagAttesaDesospOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/flagAttesaDesospOLO&quot;/>&#xa;                &lt;/flagAttesaDesospOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/flagDeliveryExposed&quot;>&#xa;                &lt;flagDeliveryExposed>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/flagDeliveryExposed&quot;/>&#xa;                &lt;/flagDeliveryExposed>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/disaggregato&quot;>&#xa;                &lt;disaggregato>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/disaggregato&quot;/>&#xa;                &lt;/disaggregato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/exDisaggregato&quot;>&#xa;                &lt;exDisaggregato>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/exDisaggregato&quot;/>&#xa;                &lt;/exDisaggregato>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:RichiestaElement>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
