                                    inputVariable="QueryComune-input"
                                    name="QueryComune"
                                    outputVariable="QueryComune"
                                    tibex:xpdlId="06ba5c26-99b2-4d16-9c17-88beb04cb52a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
