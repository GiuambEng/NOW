                                    inputVariable="CallTok-input"
                                    name="CallTok"
                                    outputVariable="CallTok"
                                    tibex:xpdlId="b343db12-967c-4bdf-a289-bc20bee8bb26"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
