                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Referente&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Request>&#xa;            &lt;tns10:Request>&#xa;                &lt;tns10:Token>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns10:Token>&#xa;                &lt;tns10:Esito>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns10:Esito>&#xa;                &lt;tns10:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                &lt;/tns10:Descrizione>&#xa;                &lt;tns10:Referente>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                    &lt;created>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/created>&#xa;                    &lt;operatore>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/operatore>&#xa;                    &lt;tipoReferenteOrdine>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;REFERENTEPERINTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&#xa;                    &lt;/tipoReferenteOrdine>&#xa;                    &lt;cognomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/cognomeReferente>&#xa;                    &lt;nomeReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/nomeReferente>&#xa;                    &lt;telefonoFissoReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/telefonoFissoReferente>&#xa;                    &lt;telefonoMobileReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/telefonoMobileReferente>&#xa;                    &lt;emailReferente>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/emailReferente>&#xa;                    &lt;flag_Token>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/flag_Token>&#xa;                &lt;/tns10:Referente>&#xa;            &lt;/tns10:Request>&#xa;        &lt;/tns10:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
