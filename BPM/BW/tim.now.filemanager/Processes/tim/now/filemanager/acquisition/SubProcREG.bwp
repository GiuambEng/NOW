      &lt;/cowCodeOLO2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceSessione&quot;>&#xa;                    &lt;codiceSessione>&#xa;                        &lt;xsl:value-of select=&quot;codiceSessione&quot;/>&#xa;                    &lt;/codiceSessione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceSessione2&quot;>&#xa;                    &lt;codiceSessione2>&#xa;                        &lt;xsl:value-of select=&quot;codiceSessione2&quot;/>&#xa;                    &lt;/codiceSessione2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;DNAggiuntivo&quot;>&#xa;                    &lt;DNAggiuntivo>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/DNAggiuntivo>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:if test=&quot;IDPreventivo&quot;>&#xa;                    &lt;IDPreventivo>&#xa;                        &lt;xsl:value-of select=&quot;IDPreventivo&quot;/>&#xa;                    &lt;/IDPreventivo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDConsuntivo&quot;>&#xa;                    &lt;IDConsuntivo>&#xa;                        &lt;xsl:value-of select=&quot;IDConsuntivo&quot;/>&#xa;                    &lt;/IDConsuntivo>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codicePacchettoNOW&quot;>&#xa;                    &lt;codicePacchettoNOW>&#xa;                        &lt;xsl:value-of select=&quot;codicePacchettoNOW&quot;/>&#xa;                    &lt;/codicePacchettoNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:copy-of select=&quot;assetTarget&quot;/>&#xa;                &lt;xsl:if test=&quot;operatoreRete&quot;>&#xa;                    &lt;operatoreRete>&#xa;                        &lt;xsl:value-of select=&quot;operatoreRete&quot;/>&#xa;                    &lt;/operatoreRete>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$TransitoryProperty = &amp;quot;Y&amp;quot;&quot;>&#xa;                    &lt;transactionIDLocator>&#xa;                        &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;                    &lt;/transactionIDLocator>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagNumAggiuntive&quot;>&#xa;                    &lt;flagNumAggiuntive>&#xa;                        &lt;xsl:value-of select=&quot;flagNumAggiuntive&quot;/>&#xa;                    &lt;/flagNumAggiuntive>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDAnagraficaCausaleGUI&quot;>&#xa;                    &lt;IDAnagraficaCausaleGUI>&#xa;                        &lt;xsl:value-of select=&quot;IDAnagraficaCausaleGUI&quot;/>&#xa;                    &lt;/IDAnagraficaCausaleGUI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceRifiutoDonating&quot;>&#xa;                    &lt;codiceRifiutoDonating>&#xa;                        &lt;xsl:value-of select=&quot;codiceRifiutoDonating&quot;/>&#xa;                    &lt;/codiceRifiutoDonating>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;DACFile&quot;>&#xa;                    &lt;DACFile>&#xa;                        &lt;xsl:value-of select=&quot;DACFile&quot;/>&#xa;                    &lt;/DACFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipologiaSottolav&quot;>&#xa;                    &lt;tipologiaSottolav>&#xa;                        &lt;xsl:value-of select=&quot;tipologiaSottolav&quot;/>&#xa;                    &lt;/tipologiaSottolav>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceRifiuto&quot;>&#xa;                    &lt;codiceRifiuto>&#xa;                        &lt;xsl:value-of select=&quot;codiceRifiuto&quot;/>&#xa;                    &lt;/codiceRifiuto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;routingNumber&quot;>&#xa;                    &lt;routingNumber>&#xa;                        &lt;xsl:value-of select=&quot;routingNumber&quot;/>&#xa;                    &lt;/routingNumber>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;progressivoEmissioneDTU&quot;>&#xa;                    &lt;progressivoEmissioneDTU>&#xa;                        &lt;xsl:value-of select=&quot;progressivoEmissioneDTU&quot;/>&#xa;                    &lt;/progressivoEmissioneDTU>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagAttesaDesospOLO&quot;>&#xa;                    &lt;flagAttesaDesospOLO>&#xa;                        &lt;xsl:value-of select=&quot;flagAttesaDesospOLO&quot;/>&#xa;                    &lt;/flagAttesaDesospOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;flagDeliveryExposed&quot;>&#xa;                    &lt;flagDeliveryExposed>&#xa;                        &lt;xsl:value-of select=&quot;flagDeliveryExposed&quot;/>&#xa;                    &lt;/flagDeliveryExposed>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(disaggregato)>1&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$VerificaCodiceProgetto1/tns5:FlagFittizio='FALSE'&quot;/>&#xa;                            &lt;xsl:when test=&quot;upper-case($VerificaCodiceProgetto1/tns5:FlagFittizio)='SI'&quot;>&#xa;                                &lt;disaggregato>&#xa;                                    &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                                &lt;/disaggregato>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;disaggregato>&#xa;                                    &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                &lt;/disaggregato>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;disaggregato&quot;>&#xa;                            &lt;disaggregato>&#xa;                                &lt;xsl:value-of select=&quot;disaggregato&quot;/>&#xa;                            &lt;/disaggregato>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;exDisaggregato&quot;>&#xa;                    &lt;exDisaggregato>&#xa;                        &lt;xsl:value-of select=&quot;exDisaggregato&quot;/>&#xa;                    &lt;/exDisaggregato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($CallProcess/tns10:Record)>0 and exists($CallProcess/tns10:Record[string-length(tns10:CODFC_OLO_AGCOM)>0]) and not(starts-with(offerta,'SHA'))&quot;>&#xa;                    &lt;rendezVous>&#xa;                        &lt;xsl:value-of select=&quot;'S'&quot;/>&#xa;                    &lt;/rendezVous>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;cambioTecnologia&quot;>&#xa;                    &lt;cambioTecnologia>&#xa;                        &lt;xsl:value-of select=&quot;cambioTecnologia&quot;/>&#xa;                    &lt;/cambioTecnologia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;ordineAssetWhiteList&quot;>&#xa;                    &lt;ordineAssetWhiteList>&#xa;                        &lt;xsl:value-of select=&quot;ordineAssetWhiteList&quot;/>&#xa;                    &lt;/ordineAssetWhiteList>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:RichiestaElement>&#xa;        &lt;/xsl:for-each>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
