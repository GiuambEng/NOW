                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CallLocatorALT&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderRichiestaALT&quot;/>&#xa;    &lt;xsl:param name=&quot;ReferenteAltreLavorazioni&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterRAL&quot;/>&#xa;    &lt;xsl:param name=&quot;PriorityCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderXml2&quot;/>&#xa;    &lt;xsl:template name=&quot;CreaRichiestaALT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Element>&#xa;            &lt;tns10:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns10:moduleName>&#xa;            &lt;tns10:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns10:parameterName>&#xa;            &lt;xsl:if test=&quot;($Richiesta/lavorazione=&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot; or $Richiesta/lavorazione=&amp;quot;RIMODULAZIONEDAD&amp;quot;)  and $Richiesta/ambito=&amp;quot;NOW&amp;quot;&quot;>&#xa;                &lt;tns10:parameterName2>&#xa;                    &lt;xsl:value-of select=&quot;$BPMparameterRAL&quot;/>&#xa;                &lt;/tns10:parameterName2>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns10:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMoperationName&quot;/>&#xa;                    &lt;/tns10:operationName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSoperationName&quot;/>&#xa;                    &lt;/tns10:operationName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns10:processName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;                    &lt;/tns10:processName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:processName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSprocessName&quot;/>&#xa;                    &lt;/tns10:processName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns10:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderRichiestaALT&quot;/>&#xa;            &lt;/tns10:value>&#xa;            &lt;xsl:if test=&quot;($Richiesta/lavorazione=&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot; or $Richiesta/lavorazione=&amp;quot;RIMODULAZIONEDAD&amp;quot;)  and $Richiesta/ambito=&amp;quot;NOW&amp;quot;&quot;>&#xa;                &lt;tns10:value2>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ReferenteAltreLavorazioni)&quot;/>&#xa;                &lt;/tns10:value2>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns10:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns1:ID_FILE&quot;/>&#xa;            &lt;/tns10:ID_FILE>&#xa;            &lt;xsl:if test=&quot;$TransitoryProperty=&amp;quot;Y&amp;quot; and $CallLocatorALT/tns11:Risposta/tns11:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot;&quot;>&#xa;                &lt;tns10:priority>&#xa;                    &lt;xsl:value-of select=&quot;$PriorityCRMWS&quot;/>&#xa;                &lt;/tns10:priority>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns10:ContenutoXML>&#xa;                &lt;xsl:value-of select=&quot;$RenderXml2&quot;/>&#xa;            &lt;/tns10:ContenutoXML>&#xa;            &lt;tns10:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns10:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$Richiesta/progressivoRichiestaFile&quot;>&#xa;                &lt;tns10:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns10:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&#xa;                &lt;tns10:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&#xa;                &lt;/tns10:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/node()/DestinazioneUso)&quot;>&#xa;                    &lt;tns10:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;'VDU'&quot;/>&#xa;                    &lt;/tns10:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&#xa;                    &lt;/tns10:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&#xa;                &lt;tns10:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns10:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns10:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
