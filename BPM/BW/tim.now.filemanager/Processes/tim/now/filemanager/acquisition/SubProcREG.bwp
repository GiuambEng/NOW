                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;NORMALarray&quot;/>&lt;xsl:template name=&quot;Token4-input&quot; match=&quot;/&quot;>&lt;tns4:Request>&lt;tns4:RequestVerificaRollout>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOlo&quot;>&lt;tns4:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOlo&quot;/>&lt;/tns4:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo]/tns1:CodiceOLO)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo]/tns1:CodiceOLO&quot;>&lt;tns4:CodificaOloNumerico>&lt;xsl:value-of select=&quot;$Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM=$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo]/tns1:CodiceOLO&quot;/>&lt;/tns4:CodificaOloNumerico>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/ns1:CodISPdaNome&quot;>&lt;tns4:CodificaOloNumerico>&lt;xsl:value-of select=&quot;$Start/ns1:CodISPdaNome&quot;/>&lt;/tns4:CodificaOloNumerico>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneCPS)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;CPS&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULL)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULL-NP)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULLLINEAATTIVANP&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/Vull)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;VULL&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULLDati)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULLDati-NP)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEAATTIVANP&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneSLU/SLU)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;SLULINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneSLU/SLU-NP)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;SLULINEAATTIVANP&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/SharedAccess)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[number($index)]/Ordine/*/*[1]))&quot;/>&lt;/tns4:Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneULL) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneSLU)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneULL/CambioCoppia/ServizioOriginale='F'&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;WLR&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneULL)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneSLU)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/*))&quot;/>&lt;/tns4:Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/Ull)  or exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/Vull) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/WLR) or exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/SLU)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/Ull)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/Vull)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;VULL&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/WLR)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;WLR&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/SLU)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/Servizio/*))&quot;/>&lt;/tns4:Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[number($index)]/Ordine/*/*[1]))&quot;/>&lt;/tns4:Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/StatoAvanzamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;STATOAVANZAMENTO&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/CancellazioneAccodamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/InterruzioneMigrazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Annullamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/RimodulazioneDACdaRecipient)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDACDARECIPIENT&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Comunicazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Comunicazione/RiscontroCodiceSessione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RISCONTROCODICESESSIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Comunicazione/AccettazioneOpereSpeciali)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADISATTIVAZIONECPS&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)>0 and string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)&amp;lt;=5&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune&quot;>&lt;tns4:CodiceIstatComune>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune&quot;/>&lt;/tns4:CodiceIstatComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)>5&quot;>&lt;tns4:CodiceIstatComune>&lt;xsl:value-of select=&quot;substring($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune,string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)-5,6)&quot;/>&lt;/tns4:CodiceIstatComune>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns4:FlagReferente>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:FlagReferente>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;>&lt;tns4:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;/>&lt;/tns4:CodiceOrdineOLO>&lt;/xsl:if>&lt;/tns4:RequestVerificaRollout>&lt;tns4:ProcessIstance>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns4:ProcessIstance>&lt;/tns4:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
