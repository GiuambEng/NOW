                                    inputVariable="Log12-input"
                                    name="Log12"
                                    tibex:xpdlId="4e3386f2-fa49-4e95-9d86-692c5b8317e1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
