                                    inputVariable="RenderXml-input"
                                    name="RenderXml"
                                    outputVariable="RenderXml"
                                    tibex:xpdlId="cdc7d72a-c7ca-4b52-87b2-61d5a44853e0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
