                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns2="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns3="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:ns1="http://www.tim.com/NOW/xsd/REGstart" xmlns:tns1="http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="ATTarray"/&gt;
    &lt;xsl:param name="index"/&gt;
    &lt;xsl:template name="DRO6-input" match="/"&gt;
        &lt;ns2:calcNextDateByDurationRequest&gt;
            &lt;parameters&gt;
                &lt;tns3:Request&gt;
                    &lt;tns3:inputDate&gt;
                        &lt;xsl:value-of select="$Start/ns1:NextWorkingDate"/&gt;
                    &lt;/tns3:inputDate&gt;
