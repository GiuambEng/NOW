t;$Start/ns1:CodISPdaNome&quot;/>&lt;/tns4:CodificaOloNumerico>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneCPS)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;CessazioneCPS&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;CessazioneWLRLineaAttiva&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;CessazioneWLRLineaNonAttiva&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULL)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULL-NP)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULL-NP&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/Vull)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;Vull&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULLDati)&quot;>&lt;tns4:Offerta>&lt;xsl:value-of select=&quot;&amp;quot;ULLDati&amp;quot;&quot;/>&lt;/tns4:Offerta>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneULL/ULLDati-NP)&quot;>