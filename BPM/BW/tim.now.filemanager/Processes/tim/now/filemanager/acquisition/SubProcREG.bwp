                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ProgressiviRichiesta&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/VerificaProgetto/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DRO6gg.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;NORMALarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ProgrAlt&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformXml&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgetto2&quot;/>&#xa;    &lt;xsl:param name=&quot;Token9&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;ns:RichiestaElement>&#xa;            &lt;xsl:variable name=&quot;rich&quot; select=&quot;$NORMALarray/Richiesta[number($index)]&quot;/>&#xa;            &lt;xsl:variable name=&quot;OrdineVariazione_DettAttOrd&quot; select=&quot;if(string-length($rich/Ordine/Variazione/node()/*[1]/DN[1])>0 or string-length($rich/Ordine/Variazione/node()/DN)>0 or exists($rich/Ordine/Variazione/node()/DestinazioneUso/fonia) or exists($rich/Ordine/Variazione/node()/DestinazioneUso/dati) or &amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/node()/DataSottoscrizioneContratto)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/node()/CampoServizioIT)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/FlagMantenimentoProdotti)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/RecapitoTelefonicoCliente)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)>0 or&amp;#xD;&amp;#xA;string-length(string($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali/Direzionalita))>0 or&amp;#xD;&amp;#xA;(string-length(string($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali/QuantitaLinee))>0  or count($rich/Ordine/Variazione/VariazioneULL/*[string-length(string(QuantitaLinee))>0]/QuantitaLinee)>0 or count($rich/Ordine/Variazione/VariazioneSLU/*[string-length(string(QuantitaLinee))>0]/QuantitaLinee)>0) or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali/SelezionePassante)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali/AccessoNumerico)>0 or&amp;#xD;&amp;#xA;(string-length(string($rich/Ordine/Variazione/VariazioneWLR/AttivazioneSTS/CodiceSTSMultinumero/AggiuntiviISDN))>0 or string-length(string($rich/Ordine/Variazione/VariazioneWLR/CessazioneSTS/CodiceSTSMultinumero/AggiuntiviISDN))>0) or&amp;#xD;&amp;#xA;(string-length($rich/Ordine/Variazione/VariazioneULL/CambioCoppia/PosizionePermutatore1)>0 or string-length($rich/Ordine/Variazione/VariazioneULL/Trasloco/PosizionePermutatore1)>0) or&amp;#xD;&amp;#xA;(string-length($rich/Ordine/Variazione/VariazioneULL/CambioCoppia/PosizionePermutatore2)>0 or string-length($rich/Ordine/Variazione/VariazioneULL/Trasloco/PosizionePermutatore2)>0) or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneULL/DestinazioneUso/dati/BitRate)>0 or&amp;#xD;&amp;#xA;count($rich/Ordine/Variazione/VariazioneULL/*[string-length(IdUllCo)>0]/IdUllCo)>0 or&amp;#xD;&amp;#xA;string-length($rich/Ordine/Variazione/VariazioneULL/*[1]/Capostipite)>0 or string-length($rich/Ordine/Variazione/VariazioneSLU/*[1]/Capostipite)>0 or exists($rich/Ordine/Variazione/node()/node()/QuantitaLinee[1]))&amp;#xD;&amp;#xA;then &amp;quot;EXISTS&amp;quot; else &amp;quot;NOTEXISTS&amp;quot;&quot;/>&#xa;            &lt;created>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/created>&#xa;            &lt;lastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/lastUpdate>&#xa;            &lt;operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;            &lt;/operatore>&#xa;            &lt;IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;            &lt;/IDRichiestaOLO>&#xa;            &lt;statoRichiestaNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaNOW>&#xa;            &lt;statoRichiestaPrecedNOW>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PERVENUTO&amp;quot;&quot;/>&#xa;            &lt;/statoRichiestaPrecedNOW>&#xa;            &lt;IDFileInput>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Start/ns1:ID_FILE)&quot;/>&#xa;            &lt;/IDFileInput>&#xa;            &lt;ambito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ambito>&#xa;            &lt;canaleRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/canaleRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Cessazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/StatoAvanzamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;STATOAVANZAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/CancellazioneAccodamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/InterruzioneMigrazione)&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($rich/Annullamento)&quot;>&#xa;                    &lt;lavorazione>&#xa;