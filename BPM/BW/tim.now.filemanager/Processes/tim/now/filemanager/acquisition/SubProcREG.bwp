ue-of select=&quot;$ReferenteAltreLavorazioni/cognomeReferente&quot;/>&lt;/CognomeReferente>&lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/nomeReferente&quot;>&lt;NomeReferente>&lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/nomeReferente&quot;/>&lt;/NomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/telefonoFissoReferente&quot;>&lt;TelefonoFissoReferente>&lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/telefonoFissoReferente&quot;/>&lt;/TelefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;$ReferenteAltreLavorazioni/telefonoMobileReferente&quot;>&lt;TelefonoMobileReferente>&lt;xsl:value-of select=&quot;$ReferenteAltreLavorazioni/telefonoMobileReferente&quot;/>&lt;/TelefonoMobileReferente>&lt;/xsl:if>&lt;/ReferenteDesospensione>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/InterruzioneSospensione/Note&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/InterruzioneSospensione/Note&quot;/>&lt;/Note>&lt;/xsl:if>&lt;/InterruzioneSospensione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;$NORMALarray/Richiesta[$index]/Comunicazione&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Richiesta>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
