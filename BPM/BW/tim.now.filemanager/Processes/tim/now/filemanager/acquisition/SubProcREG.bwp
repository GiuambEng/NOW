                                    inputVariable="Log15-input"
                                    name="Log15"
                                    tibex:xpdlId="5bed5d20-939d-4389-85f6-9ec64d14670b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
