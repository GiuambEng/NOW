                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns8=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token7-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;tns4:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns4:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns4:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ATTarray/tns1:Richiesta[$index]/codificaOLONOW)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                            &lt;tns4:CodificaOloNumerico>&#xa;                                &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                            &lt;/tns4:CodificaOloNumerico>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:CodISPdaNome&quot;>&#xa;                            &lt;tns4:CodificaOloNumerico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:CodISPdaNome&quot;/>&#xa;                            &lt;/tns4:CodificaOloNumerico>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;>&#xa;                    &lt;tns4:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;/>&#xa;                    &lt;/tns4:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns4:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns4:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns4:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns4:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1][qualificaReferente='CF'])&quot;>&#xa;                        &lt;tns4:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns4:FlagReferente>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:FlagReferente>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns4:FlagReferente>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns4:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns4:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns4:RequestVerificaRollout>&#xa;            &lt;tns4:RequestCreate_token>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns4:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns4:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns4:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns4:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&#xa;                &lt;/tns4:Funzione>&#xa;                &lt;tns4:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($ATTarray/tns1:Richiesta[$index]/codiceOrdineOLO,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns4:ChiaveRiferimento>&#xa;                &lt;tns4:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns4:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns8:IPAddress&quot;>&#xa;                    &lt;tns4:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns8:IPAddress&quot;/>&#xa;                    &lt;/tns4:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;>&#xa;                    &lt;tns4:N_Recap_Cliente>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoFissoReferente&quot;/>&#xa;                    &lt;/tns4:N_Recap_Cliente>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;>&#xa;                    &lt;tns4:N_Recap_Cliente_ALT>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/telefonoMobileReferente&quot;/>&#xa;                    &lt;/tns4:N_Recap_Cliente_ALT>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;>&#xa;                    &lt;tns4:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/nomeReferente&quot;/>&#xa;                    &lt;/tns4:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;>&#xa;                    &lt;tns4:CognomeRagioneSociale>&#xa;                        &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]/cognomeReferente&quot;/>&#xa;                    &lt;/tns4:CognomeRagioneSociale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns4:RequestCreate_token>&#xa;            &lt;tns4:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:ProcessIstance>&#xa;            &lt;tns4:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&#xa;            &lt;/tns4:StrutturaRichiesta>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/IDRisorsa&quot;>&#xa;                &lt;tns4:NumeroLinea>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/IDRisorsa&quot;/>&#xa;                &lt;/tns4:NumeroLinea>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;>&#xa;                &lt;tns4:OffertaBPM>&#xa;                    &lt;xsl:value-of select=&quot;$ATTarray/tns1:Richiesta[$index]/offerta&quot;/>&#xa;                &lt;/tns4:OffertaBPM>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log25-input"
                                    name="Log25"
                                    tibex:xpdlId="3eff8bcb-2a11-4af6-88a9-60a130f57d42" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign14ToLog25"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log25ToGroupEnd6"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Log25-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcREG | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(' Accumulo Token',tib:render-xml($Referente,true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns10:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
