                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns9=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;CallLocatorATT&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns9:Contatori>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns9:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns9:StringaCRMWS,$Richiesta/contenutoXML)&quot;/>&lt;/tns9:StringaCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:StringaCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaCRMWS&quot;/>&lt;/tns9:StringaCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorATT/tns11:Risposta/tns11:RC=&amp;quot;09&amp;quot; or $CallLocatorATT/tns11:Risposta/tns11:RC=&amp;quot;10&amp;quot; or $CallLocatorATT/tns11:Risposta/tns11:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns9:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns9:StringaSDR,$Richiesta/contenutoXML)&quot;/>&lt;/tns9:StringaSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:StringaSDR>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaSDR&quot;/>&lt;/tns9:StringaSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns9:StringaDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns9:StringaDBCFX&quot;/>&lt;/tns9:StringaDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;CRMWS&amp;quot;&quot;>&lt;tns9:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreCRMWS+1)&quot;/>&lt;/tns9:ContatoreCRMWS>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreCRMWS>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreCRMWS&quot;/>&lt;/tns9:ContatoreCRMWS>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Contatori/tns9:ContatoreWSDP&quot;>&lt;tns9:ContatoreWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreWSDP&quot;/>&lt;/tns9:ContatoreWSDP>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;KO&amp;quot; and  ($CallLocatorATT/tns11:Risposta/tns11:RC=&amp;quot;09&amp;quot; or $CallLocatorATT/tns11:Risposta/tns11:RC=&amp;quot;10&amp;quot; or $CallLocatorATT/tns11:Risposta/tns11:RC=&amp;quot;14&amp;quot;)&quot;>&lt;tns9:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreSDR+1)&quot;/>&lt;/tns9:ContatoreSDR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreSDR>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreSDR&quot;/>&lt;/tns9:ContatoreSDR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns9:ContatoreDBCFX>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreDBCFX&quot;/>&lt;/tns9:ContatoreDBCFX>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&lt;tns9:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreNOW+1)&quot;/>&lt;/tns9:ContatoreNOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreNOW>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreNOW&quot;/>&lt;/tns9:ContatoreNOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;KO&amp;quot;&quot;>&lt;tns9:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns9:ContatoreKO+1)&quot;/>&lt;/tns9:ContatoreKO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns9:ContatoreKO>&lt;xsl:value-of select=&quot;$Contatori/tns9:ContatoreKO&quot;/>&lt;/tns9:ContatoreKO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns9:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Contatori" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="RenderRichiesta-input"
                                    name="RenderRichiesta"
                                    outputVariable="RenderRichiesta"
                                    tibex:xpdlId="b472c542-d89a-44bf-9fa3-13477bf102c2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="ContatoreNOWattToRenderXml"/>
                                    <bpws:target linkName="ContatoriATTToRenderXml"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXmlToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Richiesta&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.xml.renderxml"
                                    version="6.0.0.20121128"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:casedata="http://NOW.it.telecomitalia.it/casedata"
                                    xmlns:palettexml="http://ns.tibco.com/bw/palette/xmlpalette" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/xmlpalette#//RenderXml"/>
                                    <value
                                    inputElementQName="casedata:RichiestaElement"
                                    outputStyle="text"
                                    validateInput="true" xsi:type="palettexml:RenderXml"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CreaRichiesta-input"
                                    name="CreaRichiesta"
                                    tibex:xpdlId="34e36e36-6355-4daf-a21d-edb1da410e78"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RenderXmlToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToLog1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.example.com/namespaces/tns/1465380730918&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMmoduleName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMparameterName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;BPMoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSprocessName&quot;/>&#xa;    &lt;xsl:param name=&quot;CRMWSoperationName&quot;/>&#xa;    &lt;xsl:param name=&quot;CallLocatorATT&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;PriorityCRMWS&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNS_ATT&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;FTTC&quot;/>&#xa;    &lt;xsl:param name=&quot;DNAlternativo&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformXml2&quot;/>&#xa;    &lt;xsl:param name=&quot;Controllo&quot;/>&#xa;    &lt;xsl:template name=&quot;CreaRichiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Element>&#xa;            &lt;tns10:moduleName>&#xa;                &lt;xsl:value-of select=&quot;$BPMmoduleName&quot;/>&#xa;            &lt;/tns10:moduleName>&#xa;            &lt;tns10:parameterName>&#xa;                &lt;xsl:value-of select=&quot;$BPMparameterName&quot;/>&#xa;            &lt;/tns10:parameterName>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns10:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMoperationName&quot;/>&#xa;                    &lt;/tns10:operationName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:operationName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSoperationName&quot;/>&#xa;                    &lt;/tns10:operationName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;not($TransitoryProperty=&amp;quot;Y&amp;quot;) or $CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza=&amp;quot;NOW&amp;quot;&quot;>&#xa;                    &lt;tns10:processName>&#xa;                        &lt;xsl:value-of select=&quot;$BPMprocessName&quot;/>&#xa;                    &lt;/tns10:processName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:processName>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSprocessName&quot;/>&#xa;                    &lt;/tns10:processName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns10:value>&#xa;                &lt;xsl:value-of select=&quot;$RenderRichiesta&quot;/>&#xa;            &lt;/tns10:value>&#xa;            &lt;tns10:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$Start/ns1:ID_FILE&quot;/>&#xa;            &lt;/tns10:ID_FILE>&#xa;            &lt;xsl:if test=&quot;$CallLocatorATT/tns11:Risposta/tns11:SistemaDiCompetenza!=&amp;quot;NOW&amp;quot; and $TransitoryProperty=&amp;quot;Y&amp;quot;&quot;>&#xa;                &lt;tns10:priority>&#xa;                    &lt;xsl:value-of select=&quot;$PriorityCRMWS&quot;/>&#xa;                &lt;/tns10:priority>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($TransformXml2)>0 and $Controllo='TRUE'&quot;>&#xa;                    &lt;tns10:ContenutoXML>&#xa;                        &lt;xsl:value-of select=&quot;concat(substring-before(concat(substring-before($RemoveNS_ATT,'&amp;lt;Referente>'),$TransformXml2,tib:substring-after-last($RemoveNS_ATT,'&amp;lt;/Referente>')),'&amp;lt;Referente>'),&amp;#xD;&amp;#xA;substring-after(tib:substring-before-last(concat(substring-before($RemoveNS_ATT,'&amp;lt;Referente>'),$TransformXml2,tib:substring-after-last($RemoveNS_ATT,'&amp;lt;/Referente>')),'&amp;lt;/Referente>'),'&amp;lt;Referente>'),&amp;#xD;&amp;#xA;tib:substring-after-last(concat(substring-before($RemoveNS_ATT,'&amp;lt;Referente>'),$TransformXml2,tib:substring-after-last($RemoveNS_ATT,'&amp;lt;/Referente>')),'&amp;lt;/Referente>'))&quot;/>&#xa;                    &lt;/tns10:ContenutoXML>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:ContenutoXML>&#xa;                        &lt;xsl:value-of select=&quot;$RemoveNS_ATT&quot;/>&#xa;                    &lt;/tns10:ContenutoXML>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns10:CodificaOLOAgicom>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;            &lt;/tns10:CodificaOLOAgicom>&#xa;            &lt;xsl:if test=&quot;$Richiesta/progressivoRichiestaFile&quot;>&#xa;                &lt;tns10:ProgressivoRichiestaFile>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/progressivoRichiestaFile&quot;/>&#xa;                &lt;/tns10:ProgressivoRichiestaFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/ambito&quot;>&#xa;                &lt;tns10:Ambito>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/ambito&quot;/>&#xa;                &lt;/tns10:Ambito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FTTC='OK'&quot;>&#xa;                    &lt;tns10:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;'FTTC'&quot;/>&#xa;                    &lt;/tns10:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Richiesta/offerta='CPS' and ((upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='Y' and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='1'and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='S') or not(exists($FlagOscuramento/Record[COD_AGESP='R1I-19-0270'])))&quot;>&#xa;                    &lt;tns10:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;'CPS'&quot;/>&#xa;                    &lt;/tns10:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns10:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/strutturaRichiesta&quot;/>&#xa;                    &lt;/tns10:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLO&quot;>&#xa;                &lt;tns10:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLO&quot;/>&#xa;                &lt;/tns10:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/offerta='CPS' and ((upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='Y' and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='1'and upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)!='S') or not(exists($FlagOscuramento/Record[COD_AGESP='R1I-19-0270'])))&quot;>&#xa;                &lt;tns10:CPS>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Richiesta/IDRisorsa)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Richiesta/IDRisorsa&quot;>&#xa;                                &lt;tns10:DN>&#xa;                                    &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsa&quot;/>&#xa;                                &lt;/tns10:DN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns10:CPS>&#xa;                        &lt;xsl:value-of select=&quot;'CPS'&quot;/>&#xa;                    &lt;/tns10:CPS>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEARICHIESTO']/valoreAttributo='BRA'&quot;>&#xa;                            &lt;tns10:DN_ALTERNATIVO>&#xa;                                &lt;xsl:value-of select=&quot;$DNAlternativo&quot;/>&#xa;                            &lt;/tns10:DN_ALTERNATIVO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPODNRICHIESTO']/valoreAttributo='POTS' or $Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPODNRICHIESTO']/valoreAttributo='ISDN') and ($Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEARICHIESTO']/valoreAttributo='PBX' or  $Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='TIPOLINEARICHIESTO']/valoreAttributo='GNR')&quot;>&#xa;                            &lt;xsl:if test=&quot;$Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='RADICALE']/valoreAttributo&quot;>&#xa;                                &lt;tns10:DN_ALTERNATIVO>&#xa;                                    &lt;xsl:value-of select=&quot;$Richiesta/ordine/dettaglioordine[starts-with(nomeComponente,'ACCESSO')]/attributiDettaglioOrdine[nomeAttributo='RADICALE']/valoreAttributo&quot;/>&#xa;                                &lt;/tns10:DN_ALTERNATIVO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns10:CPS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns10:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.ProcessManagementSubProcess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="LogChiamataBPM-input"
                                    name="LogChiamataBPM"
                                    tibex:xpdlId="35174bfb-6f1a-4d8b-8e4b-ac8a1bd9e634" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToLog1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogChiamataBPMToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RenderRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogChiamataBPM-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcREG | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Richiesta inviata al BPM: &amp;quot;, $RenderRichiesta)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns10:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
