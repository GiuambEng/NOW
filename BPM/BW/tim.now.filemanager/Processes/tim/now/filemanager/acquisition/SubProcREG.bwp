               &lt;progressivo>&#xa;                                    &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                                &lt;/progressivo>&#xa;                            &lt;/dettaglioordine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(disaggregato)>1 and (upper-case($VerificaCodiceProgetto1/tns5:FlagFittizio)='NO' or upper-case($VerificaCodiceProgetto1/tns5:FlagFittizio)='FALSE')  and string-length(FFACQKO)>0&quot;>&#xa;                                &lt;xsl:for-each select=&quot;ordine/dettaglioordine[nomeComponente!='APPUNTAMENTODISAGGREGAZIONE' and nomeComponente!='PRESTAZIONIAGGIUNTIVE' and nomeComponente!='SLAPLUSSU']&quot;>&#xa;                                    &lt;dettaglioordine>&#xa;                                        &lt;IDRichiestaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/IDRichiestaOLO>&#xa;                                        &lt;IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/IDDettaglioOrdine>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineParent&quot;>&#xa;                                            &lt;IDDettaglioOrdineParent>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineParent&quot;/>&#xa;                                            &lt;/IDDettaglioOrdineParent>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;xsl:if test=&quot;IDDettaglioOrdineRoot&quot;>&#xa;                                            &lt;IDDettaglioOrdineRoot>&#xa;                                                &lt;xsl:value-of select=&quot;IDDettaglioOrdineRoot&quot;/