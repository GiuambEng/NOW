f>&lt;xsl:if test=&quot;TelefonoMobileReferente&quot;>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;TelefonoMobileReferente&quot;/>&lt;/telefonoMobileReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;EmailReferente&quot;>&lt;emailReferente>&lt;xsl:value-of select=&quot;EmailReferente&quot;/>&lt;/emailReferente>&lt;/xsl:if>&lt;/tns7:Referente>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$NORMALarray/Richiesta[$index]/Ordine/node()/node()/Referente[string-length(CognomeReferente)>0][1]&quot;>&lt;tns7:Referente>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(Progressivo[1])>0&quot;>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;xsd:int(Progressivo[1])&quot;/>&lt;/progressivoReferente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivoReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;xsl:if test=&quot;QualificaRef[1]&quot;>&lt;qualificaReferente>&lt;xsl:value-of select=&quot;QualificaRef[1]&quot;/>&lt;/qualificaReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;CognomeReferente&quot;>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;CognomeReferente&quot;/>&lt;/cognomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;NomeReferente&quot;>&lt;nomeReferente>&lt;xsl:value-of select=&quot;NomeReferente&quot;/>&lt;/nomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TelefonoFissoReferente&quot;>&lt;telefonoFissoReferente>&lt;xsl:value-of select=&quot;TelefonoFissoReferente&quot;/>&lt;/telefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TelefonoMobileReferente&quot;>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;TelefonoMobileReferente&quot;/>&lt;/telefonoMobileReferente>&lt;/xsl:if>&lt;/tns7:Referente>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$NORMALarray/Richiesta[$index]/Ordine/node()/Referente[string-length(CognomeReferente)>0]&quot;>&lt;tns7:Referente>&lt;IDRichiestaOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/IDRichiestaOLO>&lt;created>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/created>&lt;lastUpdate>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/lastUpdate>&lt;operatore>&lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&lt;/operatore>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(Progressivo[1])>0&quot;>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;xsd:int(Progressivo[1])&quot;/>&lt;/progressivoReferente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;progressivoReferente>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/progressivoReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tipoReferenteOrdine>&lt;xsl:value-of select=&quot;&amp;quot;REFERENTE&amp;quot;&quot;/>&lt;/tipoReferenteOrdine>&lt;qualificaReferente>&lt;xsl:value-of select=&quot;QualificaRef&quot;/>&lt;/qualificaReferente>&lt;cognomeReferente>&lt;xsl:value-of select=&quot;CognomeReferente&quot;/>&lt;/cognomeReferente>&lt;xsl:if test=&quot;NomeReferente&quot;>&lt;nomeReferente>&lt;xsl:value-of select=&quot;NomeReferente&quot;/>&lt;/nomeReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TelefonoFissoReferente&quot;>&lt;telefonoFissoReferente>&lt;xsl:value-of select=&quot;TelefonoFissoReferente&quot;/>&lt;/telefonoFissoReferente>&lt;/xsl:if>&lt;xsl:if test=&quot;TelefonoMobileReferente&quot;>&lt;telefonoMobileReferente>&lt;xsl:value-of select=&quot;TelefonoMobileReferente&quot;/>&lt;/telefonoMobileReferente>&lt;/xsl:if>&lt;/tns7:Referente>&lt;/xsl:for-each>&lt;/tns7:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsb