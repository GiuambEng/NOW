                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Referente"
                                    name="Assign14"
                                    outputVariable="Referente"
                                    tibex:xpdlId="5c173d24-7d3e-4666-b342-b8f44801ef81" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token7ToAssign14"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign14ToLog25"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns33=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATTarray&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Token7&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Referente&quot; match=&quot;/&quot;>&#xa;        &lt;tns33:Request>&#xa;            &lt;xsl:copy-of select=&quot;$Referente/tns33:Request&quot;/>&#xa;            &lt;tns33:Request>&#xa;                &lt;xsl:if test=&quot;$Token7/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                    &lt;tns33:Token>&#xa;                        &lt;xsl:value-of select=&quot;$Token7/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                    &lt;/tns33:Token>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token7/tns4:ResponseCreate_token/tns4:ESITO&quot;>&#xa;                    &lt;tns33:Esito>&#xa;                        &lt;xsl:value-of select=&quot;$Token7/tns4:ResponseCreate_token/tns4:ESITO&quot;/>&#xa;                    &lt;/tns33:Esito>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token7/tns4:ResponseCreate_token/tns4:DESCRIZIONE&quot;>&#xa;                    &lt;tns33:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;$Token7/tns4:ResponseCreate_token/tns4:DESCRIZIONE&quot;/>&#xa;                    &lt;/tns33:Descrizione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$ATTarray/tns1:Richiesta[$index]/ordine/referente[$index1]&quot;>&#xa;                   