                 &lt;xsl:if test=&quot;exists($rich/Testata/Correlazioni/TipoPacchetto)&quot;>&#xa;                        &lt;xsl:if test=&quot;$rich/Testata/Correlazioni/TipoPacchetto&quot;>&#xa;                            &lt;tipoPacchetto>&#xa;                                &lt;xsl:value-of select=&quot;$rich/Testata/Correlazioni/TipoPacchetto&quot;/>&#xa;                            &lt;/tipoPacchetto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($rich/Ordine/Migrazione) and $ExistOnceDettOrd&quot;>&#xa;                        &lt;dettaglioordine>&#xa;                            &lt;IDRichiestaOLO>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/IDRichiestaOLO>&#xa;                            &lt;IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/IDDettaglioOrdine>&#xa;                            &lt;created>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/created>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                            &lt;operatore>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                            &lt;/operatore>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione/Servizio/Ull)&quot;>&#xa;                                    &lt;nomeComponente>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;ACCESSOULL&amp;quot;&quot;/>&#xa;                                    &lt;/nomeComponente>&