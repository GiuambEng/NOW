 &lt;xsl:value-of select=&quot;&amp;quot;WLR&amp;quot;&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneSLU) or exists($rich/Ordine/Migrazione/Servizio/SLU) or exists($rich/Ordine/Cessazione/CessazioneSLU)&quot;>&#xa;                            &lt;offertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$rich/Ordine/Variazione/VariazioneULL/CambioCoppia/ServizioOriginale='F'&quot;>&#xa;                            &lt;offertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;SHA&amp;quot;&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;string-length(upper-case(local-name($rich/Ordine/Migrazione/Servizio/*)))>0&quot;>&#xa;                                &lt;offertaCatalogo>&#xa;                                    &lt;xsl:value-of select=&quot;upper-case(local-name($rich/Ordine/Migrazione/Servizio/*))&quot;/>&#xa;                                &lt;/offertaCatalogo>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Variazione)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/node()/DataDAC)>0 and tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Variazione/node()/DataDAC)&quot;>&#xa;                                    &lt;DAC>&#xa;                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Variazione/node()/DataDAC)&quot;/>&#xa;                                    &lt;/DAC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($DRO6gg.parameters/tns3:outputDate)&quot;>&#xa;                                    &lt;DAC>&#xa;                                        &lt;xsl:value-of select=&quot;$DRO6gg.parameters/tns3:outputDate&quot;/>&#xa;                                    &lt;/DAC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Cessazione)&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($rich/Ordine/Cessazione/CessazioneSLU) and tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneSLU/node()/DataDAC)&quot;>&#xa;                                    &lt;DAC>&#xa;                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneSLU/node()/DataDAC)&quot;/>&#xa;                                    &lt;/DAC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($rich/Ordine/Cessazione/CessazioneULL) and tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneULL/node()/DataDAC)&quot;>&#xa;                                    &lt;DAC>&#xa;                                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneULL/node()/DataDAC)&quot;/>&#xa;                                    &l