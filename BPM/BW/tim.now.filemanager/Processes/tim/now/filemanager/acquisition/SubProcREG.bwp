                            <bpws:scope name="While3"
                                tibex:group="while" tibex:xpdlId="6c94063f-fc67-4349-adc9-769b183c2419">
                                <bpws:targets>
                                    <bpws:target linkName="Assign13ToWhile3"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="While3ToEmpty11"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index1"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence6" tibex:group="while">
                                    <bpws:empty name="GroupInit3" tibex:group="groupInit"/>
                                    <bpws:while name="while6" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($ATTarray/tns:Richiesta[$index]/ordine/referente[not(tipoReferenteOrdine='REFERENTEONFIELD')])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($ATTarray/tns:Richiesta[$index]/ordine/referente[not(tipoReferenteOrdine='REFERENTEONFIELD')])]]></bpws:condition>
                                    <bpws:flow name="flow13">
                                    <bpws:links>
                                    <bpws:link
                                    name="Token7ToAssign14" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStart9ToToken7" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="Log25ToGroupEnd6" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="Token7ToLog26" tibex:linkType="ERROR"/>
                                    <bpws:link
