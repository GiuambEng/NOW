=&quot;&amp;quot;CESSAZIONESTSMULTINUMERO&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR=&amp;quot;3&amp;quot; or $rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR=&amp;quot;4&amp;quot;&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat(&amp;quot;CAMBIONUMERO&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat(&amp;quot;PRESTAZIONEWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CodicePrestazioneAssociataWLR)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)>0&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat(&amp;quot;TRASLOCOWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/Trasloco/CodiceTrasloco)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)>0&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;concat(&amp;quot;CAMBIOTIPOLOGIAWLR&amp;quot;,$rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioTipologiaAccesso/CodiceCambioTipologia)&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneWLR/PrestazioniWLR/CambioCanali)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;CAMBIOCANALIWLR&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/DestinazioneUso)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONEDESTINAZIONEUSO&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/CessSolaNPsuULL-NP)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;DECREMENTONP&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/CessSoloUllsuULL-NP)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;DECREMENTOULL&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/CambioCoppia)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;CAMBIOCOPPIA&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneULL/Trasloco)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;TRASLOCO&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneSLU/DestinazioneUso)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONEDESTINAZIONEUSO&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneSLU/CessSolaNPsuSLU-NP)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;DECREMENTONP&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($rich/Ordine/Variazione/VariazioneSLU/CessSoloSLUsuSLU-NP)&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;&amp;quot;DECREMENTOSLU&amp;quot;&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/Rifiuto/CodiceMotivoRifiuto&quot;>&lt;codiceRifiuto>&lt;xsl:value-of select=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/Rifiuto/CodiceMotivoRifiuto&quot;/>&lt;/codiceRifiuto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/Ordine/Migrazione/Servizio/node()/NP/RoutingNumberRecipient)>0&quot;>&lt;xsl:if test=&quot;$rich/Ordine/Migrazione/Servizio/node()/NP/RoutingNumberRecipient&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;$rich/Ordine/Migrazione/Servizio/node()/NP/RoutingNumberRecipient&quot;/>&lt;/routingNumber>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/node()/node()[1]/RoutingNumber[1])>0&quot;>&lt;xsl:if test=&quot;$rich/Ordine/Variazione/node()/node()[1]/RoutingNumber[1]&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;$rich/Ordine/Variazione/node()/node()[1]/RoutingNumber[1]&quot;/>&lt;/routingNumber>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/Ordine/Cessazione/node()/node()[1]/RoutingNumber[1])>0&quot;>&lt;xsl:if test=&quot;$rich/Ordine/Cessazione/node()/node()[1]/RoutingNumber[1]&quot;>&lt;routingNumber>&lt;xsl:value-of select=&quot;$rich/Ordine/Cessazione/node()/node()[1]/RoutingNumber[1]&quot;/>&lt;/routingNumber>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione) and (exists($rich/Ordine/Migrazione/Servizio/Ull)  or exists($rich/Ordine/Migrazione/Servizio/SLU)) and upper-case($rich/Ordine/Migrazione/CodiceSessione1)='CAMBIOTECNOLOGIA' and string-length($rich/Testata/CodiceProgetto)>0&quot;>&lt;disaggregato>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/disaggregato>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($rich/Testata/CodiceProgetto)>0 and exists($rich/Ordine/Migrazione/Servizio/node()/Disaggregazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaCodiceProgetto2/tns5:FlagFittizio='FALSE'&quot;/>&lt;xsl:when test=&quot;upper-case($VerificaCodiceProgetto2/tns5:FlagFittizio)='SI'&quot;>&lt;disaggregato>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/disaggregato>&lt;/xsl:when>&lt;xsl:otherwise>&lt;disaggregato>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/disaggregato>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;not(string-length($rich/Testata/CodiceProgetto)>0) and exists($rich/Ordine/Migrazione/Servizio/node()/Disaggregazione)&quot;>&lt;disaggregato>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/disaggregato>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($FlagOscuramento/Record[COD_AGESP='R1I-19-0175'])>0 and $FlagOscuramento/Record[COD_AGESP='R1I-19-0175']/FLAG_OSCURMENTO='1'&quot;/>&lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione) and upper-case($rich/Ordine/Migrazione/CodiceSessione1)='CAMBIOTECNOLOGIA'&quot;>&lt;cambioTecnologia>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/cambioTecnologia>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/TipoNotifica&quot;>&lt;tipoComunicazioneCPS>&lt;xsl:value-of select=&quot;$rich/Comunicazione/PrenotificaDisattivazioneCPS/TipoNotifica&quot;/>&lt;/tipoComunicazioneCPS>&lt;/xsl:if>&lt;/ns:RichiestaElement>&lt;/xsl:template>&lt;/xsl:stylesheet>"
