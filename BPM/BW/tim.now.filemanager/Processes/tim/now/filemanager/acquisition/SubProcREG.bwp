eULL)&quot;>&#xa;                            &lt;xsl:if test=&quot;string-length($rich/Ordine/Cessazione/CessazioneULL/node()/DataDAC)>0 and not(tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneULL/node()/DataDAC))&quot;>&#xa;                                &lt;xsl:if test=&quot;$rich/Ordine/Cessazione/CessazioneULL/node()/DataDAC&quot;>&#xa;                                    &lt;DACFile>&#xa;                                        &lt;xsl:value-of select=&quot;$rich/Ordine/Cessazione/CessazioneULL/node()/DataDAC&quot;/>&#xa;                                    &lt;/DACFile>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($rich/Ordine/Cessazione/CessazioneNPnG/DataDAC)>0 and not(tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneNPnG/DataDAC))&quot;>&#xa;                                    &lt;xsl:if test=&quot;$rich/Ordine/Cessazione/CessazioneWLRLineaAttiva/DataDAC&quot;>&#xa;                                        &lt;DACFile>&#xa;                                            &lt;xsl:value-of select=&quot;$rich/Ordine/Cessazione/CessazioneWLRLineaAttiva/DataDAC&quot;/>&#xa;                                        &lt;/DACFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length($rich/Ordine/Cessazione/CessazioneWLRLineaAttiva/DataDAC)>0 and not(tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneWLRLineaAttiva/DataDAC))&quot;>&#xa;                                    &lt;xsl:if test=&quot;$rich/Ordine/Cessazione/CessazioneWLRLineaAttiva/DataDAC&quot;>&#xa;                         