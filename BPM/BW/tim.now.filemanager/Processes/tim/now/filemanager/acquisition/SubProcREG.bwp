:CodiceOLO&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;../../ns1:CodISPdaNome&quot;>&lt;codificaOLONOW>&lt;xsl:value-of select=&quot;../../ns1:CodISPdaNome&quot;/>&lt;/codificaOLONOW>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;codiceOrdineOLO>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/Annullamento/CodiceOrdineOlo)>0&quot;>&lt;xsl:if test=&quot;$rich/Annullamento/CodiceOrdineOlo&quot;>&lt;codiceOrdineOLOTarget>&lt;xsl:value-of select=&quot;$rich/Annullamento/CodiceOrdineOlo&quot;/>&lt;/codiceOrdineOLOTarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;Testata/CodiceOrdineOloPadre&quot;>&lt;codiceOrdineOLOPadre>&lt;xsl:value-of select=&quot;Testata/CodiceOrdineOloPadre&quot;/>&lt;/codiceOrdineOLOPadre>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($rich/Annullamento/CodiceOrdineRiferimentoTI)>0&quot;>&lt;xsl:if test=&quot;$rich/Annullamento/CodiceOrdineRiferimentoTI&quot;>&lt;codiceOrdineTITarget>&lt;xsl:value-of select=&quot;$rich/Annullamento/CodiceOrdineRiferimentoTI&quot;/>&lt;/codiceOrdineTITarget>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;Testata/CodiceProgetto&quot;>&lt;codiceProgetto>&lt;xsl:value-of select=&quot;Testata/CodiceProgetto&quot;/>&lt;/codiceProgetto>&lt;/xsl:if>&lt;dataInvioRichiesta>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, substring(string(../../ns1:DATA_FILE), 1, 10))&quot;/>&lt;/dataInvioRichiesta>&lt;xsl:if test=&quot;string-length(Testata/Correlazioni/IdentificativoCorrelazioni)>0&quot;>&lt;xsl:if test=&quot;Testata/Correlazioni/IdentificativoCorrelazioni&quot;>&lt;IDCorrelazione>&lt;xsl:value-of select=&quot;Testata/Correlazioni/IdentificativoCorrelazioni&quot;/>&lt;/IDCorrelazione>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists(Testata/Correlazioni/TotRic