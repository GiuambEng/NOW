                                    expression="string-length($Richiesta/codiceRifiuto)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[string-length($Richiesta/codiceRifiuto)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="ArricchimentoRichiestaATTToAssign">
                                    <tibex:DesignExpression>
