                             &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Cessazione/CessazioneWLRLineaNonAttiva/DataDAC)&quot;/>&#xa;                                            &lt;/DAC>&#xa;                                        &lt;/xsl:when>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($rich/Ordine/Migrazione) and tib:validate-dateTime(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Migrazione/DataDAC)&quot;>&#xa;                            &lt;DAC>&#xa;                                &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Migrazione/DataDAC)&quot;/>&#xa;                            &lt;/DAC>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length($rich/Ordine/Variazione/node()/DataAppuntamentoDesiderata)>0 or string-length($rich/Ordine/Migrazione/DataAppuntamentoDesiderata)>0 or string-length($rich/InterruzioneSospensione/DataAppuntamentoDesiderata)>0 or string-length($rich/RimodulazioneAppuntamento/DataAppuntamentoDesiderata)>0&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/node()/DataAppuntamentoDesiderata)>0&quot;>&#xa;                                &lt;DAD>&#xa;                                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $rich/Ordine/Variazione/node()/DataAppuntamentoDesiderata)&quot;/>&#xa;                                &lt;/DAD>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($rich/InterruzioneSospensione/DataAppuntamentoDesiderata)>0&quot;>&#xa;