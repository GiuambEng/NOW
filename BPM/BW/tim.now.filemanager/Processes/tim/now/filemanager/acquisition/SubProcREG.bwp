                            &lt;/tns3:GiorniLavorativi&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns3:GiorniLavorativi&gt;
                                &lt;xsl:value-of select="6"/&gt;
                            &lt;/tns3:GiorniLavorativi&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns3:Request&gt;
            &lt;/parameters&gt;
        &lt;/ns2:calcNextDateByDurationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
