     &lt;numeroVerdeOloCollaudo>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/numeroVerdeOloCollaudo&quot;/>&#xa;                        &lt;/numeroVerdeOloCollaudo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/numeroVerdeOloPT&quot;>&#xa;                        &lt;numeroVerdeOloPT>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/numeroVerdeOloPT&quot;/>&#xa;                        &lt;/numeroVerdeOloPT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/codiceTTM&quot;>&#xa;                        &lt;codiceTTM>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/codiceTTM&quot;/>&#xa;                        &lt;/codiceTTM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/flagLavorazioneManuale&quot;>&#xa;                        &lt;flagLavorazioneManuale>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/flagLavorazioneManuale&quot;/>&#xa;                        &lt;/flagLavorazioneManuale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/flagMonitoraggio&quot;>&#xa;                        &lt;flagMonitoraggio>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/flagMonitoraggio&quot;/>&#xa;                        &lt;/flagMonitoraggio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/noteCliente&quot;>&#xa;                        &lt;noteCliente>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/noteCliente&quot;/>&#xa;                        &lt;/noteCliente>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/notedaSistema&quot;>&#xa;                        &lt;notedaSistema>