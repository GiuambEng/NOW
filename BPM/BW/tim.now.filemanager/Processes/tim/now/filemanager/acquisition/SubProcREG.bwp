                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns11=&quot;http://www.tim.com/NOW/xsd/SystemLocatorInterface/&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Richiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke_ATT_ANN_loc-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns11:RichiestaLocalizzatore>&#xa;            &lt;tns11:Testata>&#xa;                &lt;tns11:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/transactionIDLocator&quot;/>&#xa;                &lt;/tns11:Transaction_id>&#xa;                &lt;tns11:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns11:Transaction_date>&#xa;                &lt;tns11:Sistema_origine>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                &lt;/tns11:Sistema_origine>&#xa;            &lt;/tns11:Testata>&#xa;            &lt;tns11:Richiesta>&#xa;                &lt;tns11:DataRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns11:DataRichiesta>&#xa;                &lt;tns11:CodiceOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns11:CodiceOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM = $Richiesta/codificaOLOAGCOM]/tns1:CodiceOLO)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM = $Richiesta/codificaOLOAGCOM]/tns1:CodiceOLO&quot;>&#xa;                            &lt;tns11:CodiceISP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:CodiciOlo/tns1:codes[tns1:CodiceOLOAGCOM = $Richiesta/codificaOLOAGCOM]/tns1:CodiceOLO&quot;/>&#xa;                            &lt;/tns11:CodiceISP>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:CodISPdaNome&quot;>&#xa;                            &lt;tns11:CodiceISP>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:CodISPdaNome&quot;/>&#xa;                            &lt;/tns11:CodiceISP>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Richiesta/ISTATComune)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Richiesta/ISTATComune&quot;>&#xa;                            &lt;tns11:CodiceComune>&#xa;                                &lt;xsl:value-of select=&quot;$Richiesta/ISTATComune&quot;/>&#xa;                            &lt;/tns11:CodiceComune>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;string-length($Richiesta/offerta)>0&quot;>&#xa;                    &lt;tns11:Servizio>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($Richiesta/offerta)&quot;/>&#xa;                    &lt;/tns11:Servizio>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($Richiesta/lavorazione)>0&quot;>&#xa;                    &lt;tns11:Richiesta>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($Richiesta/lavorazione)&quot;/>&#xa;                    &lt;/tns11:Richiesta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                    &lt;tns11:CodiceOrdineRiferimentoTI>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                    &lt;/tns11:CodiceOrdineRiferimentoTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceOrdineOLOTarget&quot;>&#xa;                    &lt;tns11:CodiceOrdineRiferimentoOLO>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/tns11:CodiceOrdineRiferimentoOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating&quot;>&#xa;                    &lt;tns11:IdRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating&quot;/>&#xa;                    &lt;/tns11:IdRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                    &lt;tns11:IdCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                    &lt;/tns11:IdCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/codiceRisorsaDonating2&quot;>&#xa;                    &lt;tns11:IdRisorsa2>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/codiceRisorsaDonating2&quot;/>&#xa;                    &lt;/tns11:IdRisorsa2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Richiesta/numeroTelefonico&quot;>&#xa;                    &lt;tns11:Telefonico>&#xa;                        &lt;xsl:value-of select=&quot;$Richiesta/numeroTelefonico&quot;/>&#xa;                    &lt;/tns11:Telefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;upper-case($Richiesta/offerta)=&amp;quot;WLRLINEANONATTIVA&amp;quot; and  string-length($Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)>0&quot;>&#xa;                    &lt;tns11:TipoLinea>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($Richiesta/ordine/dettaglioordine[nomeComponente=&amp;quot;ACCESSOWLR&amp;quot;]/attributiDettaglioOrdine[nomeAttributo=&amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)&quot;/>&#xa;                    &lt;/tns11:TipoLinea>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns11:DNAggiuntivi>&#xa;                    &lt;xsl:for-each select=&quot;$Richiesta/DNAggiuntivo&quot;>&#xa;                        &lt;xsl:if test=&quot;string-length(.)>0&quot;>&#xa;                            &lt;tns11:DN>&#xa;                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                            &lt;/tns11:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns11:DNAggiuntivi>&#xa;                &lt;xsl:if test=&quot;upper-case($Richiesta/offerta)='CPS' and exists($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']) and (upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)='Y' or upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)='1'or upper-case($FlagOscuramento/Record[COD_AGESP='R1I-19-0270']/FLAG_OSCURMENTO)='S')&quot;>&#xa;                    &lt;tns11:CPS>&#xa;                        &lt;xsl:value-of select=&quot;'CPS'&quot;/>&#xa;                    &lt;/tns11:CPS>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns11:Richiesta>&#xa;        &lt;/tns11:RichiestaLocalizzatore>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.CallLocator" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns13=&quot;http://www.tim.com/NOW/xsd/Arricchimenti&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/Rendezvous/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/VerificaProgetto/&quot; xmlns:tns12=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaIdOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDescrComune&quot;/>&#xa;    &lt;xsl:param name=&quot;DROp6&quot;/>&#xa;    &lt;xsl:param name=&quot;TransitoryProperty&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RemoveNSatt&quot;/>&#xa;    &lt;xsl:param name=&quot;CallProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgetto1&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Richiesta&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$ATT-ANNArray/tns1:Richiesta[number($index)]&quot;>&#xa;            &lt;ns:RichiestaElement>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;lastUpdate>&#xa;                    &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                &lt;/lastUpdate>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                &lt;/IDRichiestaOLO>&#xa;                &lt;statoRichiestaNOW>&#xa;                    &lt;xsl:value-of select=&quot;statoRichiestaNOW&quot;/>&#xa;                &lt;/statoRichiestaNOW>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedNOW&quot;>&#xa;                    &lt;statoRichiestaPrecedNOW>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedNOW&quot;/>&#xa;                    &lt;/statoRichiestaPrecedNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaOLO&quot;>&#xa;                    &lt;statoRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaOLO&quot;/>&#xa;                    &lt;/statoRichiestaOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;statoRichiestaPrecedOLO&quot;>&#xa;                    &lt;statoRichiestaPrecedOLO>&#xa;                        &lt;xsl:value-of select=&quot;statoRichiestaPrecedOLO&quot;/>&#xa;                    &lt;/statoRichiestaPrecedOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;sottostatoLavorManuale&quot;>&#xa;                    &lt;sottostatoLavorManuale>&#xa;                        &lt;xsl:value-of select=&quot;sottostatoLavorManuale&quot;/>&#xa;                    &lt;/sottostatoLavorManuale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileInput&quot;>&#xa;                    &lt;IDFileInput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileInput&quot;/>&#xa;                    &lt;/IDFileInput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDFileOutput&quot;>&#xa;                    &lt;IDFileOutput>&#xa;                        &lt;xsl:value-of select=&quot;IDFileOutput&quot;/>&#xa;                    &lt;/IDFileOutput>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;ambito&quot;>&#xa;                    &lt;ambito>&#xa;                        &lt;xsl:value-of select=&quot;ambito&quot;/>&#xa;                    &lt;/ambito>&#xa;                &lt;/xsl:if>&#xa;                &lt;canaleRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;canaleRichiesta&quot;/>&#xa;                &lt;/canaleRichiesta>&#xa;                &lt;xsl:if test=&quot;lavorazione&quot;>&#xa;                    &lt;lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;lavorazione&quot;/>&#xa;                    &lt;/lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;progressivoRichiestaFile&quot;>&#xa;                    &lt;progressivoRichiestaFile>&#xa;                        &lt;xsl:value-of select=&quot;progressivoRichiestaFile&quot;/>&#xa;                    &lt;/progressivoRichiestaFile>&#xa;                &lt;/xsl:if>&#xa;                &lt;strutturaRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;strutturaRichiesta&quot;/>&#xa;                &lt;/strutturaRichiesta>&#xa;                &lt;tipoRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;tipoRichiesta&quot;/>&#xa;                &lt;/tipoRichiesta>&#xa;                &lt;xsl:if test=&quot;IDRisorsa&quot;>&#xa;                    &lt;IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                    &lt;/IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(codificaOLONOW)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;codificaOLONOW&quot;>&#xa;                            &lt;codificaOLONOW>&#xa;                                &lt;xsl:value-of select=&quot;codificaOLONOW&quot;/>&#xa;                            &lt;/codificaOLONOW>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:CodISPdaNome&quot;>&#xa;                            &lt;codificaOLONOW>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:CodISPdaNome&quot;/>&#xa;                            &lt;/codificaOLONOW>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLO&quot;>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLOTarget&quot;>&#xa;                    &lt;codiceOrdineOLOTarget>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLOTarget&quot;/>&#xa;                    &lt;/codiceOrdineOLOTarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineOLOPadre&quot;>&#xa;                    &lt;codiceOrdineOLOPadre>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLOPadre&quot;/>&#xa;                    &lt;/codiceOrdineOLOPadre>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceOrdineTITarget&quot;>&#xa;                    &lt;codiceOrdineTITarget>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineTITarget&quot;/>&#xa;                    &lt;/codiceOrdineTITarget>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;codiceProgetto&quot;>&#xa;                    &lt;codiceProgetto>&#xa;                        &lt;xsl:value-of select=&quot;codiceProgetto&quot;/>&#xa;                    &lt;/codiceProgetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;dataInvioRichiesta>&#xa;                    &lt;xsl:value-of select=&quot;dataInvioRichiesta&quot;/>&#xa;                &lt;/dataInvioRichiesta>&#xa;                &lt;xsl:if test=&quot;IDAnagraficaCausale&quot;>&#xa;                    &lt;IDAnagraficaCausale>&#xa;                        &lt;xsl:value-of select=&quot;IDAnagraficaCausale&quot;/>&#xa;                    &lt;/IDAnagraficaCausale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDCorrelazione&quot;>&#xa;                    &lt;IDCorrelazione>&#xa;                        &lt;xsl:value-of select=&quot;IDCorrelazione&quot;/>&#xa;                    &lt;/IDCorrelazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;totaleRichiestePacchetto&quot;>&#xa;                    &lt;totaleRichiestePacchetto>&#xa;                        &lt;xsl:value-of select=&quot;totaleRichiestePacchetto&quot;/>&#xa;                    &lt;/totaleRichiestePacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;tipoPacchetto&quot;>&#xa;                    &lt;tipoPacchetto>&#xa;                        &lt;xsl:value-of select=&quot;tipoPacchetto&quot;/>&#xa;                    &lt;/tipoPacchetto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;IDPacchettoNOW&quot;>&#xa;                    &lt;IDPacchettoNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDPacchettoNOW&quot;/>&#xa;                    &lt;/IDPacchettoNOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;contenutoXML>&#xa;                    &lt;xsl:value-of select=&quot;$RemoveNSatt&quot;/>&#xa;                &lt;/contenutoXML>&#xa;                &lt;xsl:if test=&quot;note&quot;>&#xa;                    &lt;note>&#xa;                        &lt;xsl:value-of select=&quot;note&quot;/>&#xa;                    &lt;/note>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists(ordine)&quot;>&#xa;                    &lt;ordine>&#xa;                        &lt;xsl:if test=&quot;ordine/offertaCatalogo&quot;>&#xa;                            &lt;offertaCatalogo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/offertaCatalogo&quot;/>&#xa;                            &lt;/offertaCatalogo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(ordine/DAC)&quot;>&#xa;                                &lt;xsl:if test=&quot;ordine/DAC&quot;>&#xa;                                    &lt;DAC>&#xa;                                        &lt;xsl:value-of select=&quot;ordine/DAC&quot;/>&#xa;                                    &lt;/DAC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($DROp6/parameters/tns3:Response/tns3:outputDate)&quot;>&#xa;                                &lt;DAC>&#xa;                                    &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date($DROp6/parameters/tns3:Response/tns3:outputDate,&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                                &lt;/DAC>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;ordine/DACRimodulata&quot;>&#xa;                            &lt;DACRimodulata>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DACRimodulata&quot;/>&#xa;                            &lt;/DACRimodulata>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DAD&quot;>&#xa;                            &lt;DAD>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DAD&quot;/>&#xa;                            &lt;/DAD>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DPP&quot;>&#xa;                            &lt;DPP>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DPP&quot;/>&#xa;                            &lt;/DPP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DUVO&quot;>&#xa;                            &lt;DUVO>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DUVO&quot;/>&#xa;                            &lt;/DUVO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;ordine/created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;ordine/dataChiusuraOrdine&quot;>&#xa;                            &lt;dataChiusuraOrdine>&#xa;                                &lt;xsl:value-of select=&quot;ordine/dataChiusuraOrdine&quot;/>&#xa;                            &lt;/dataChiusuraOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/cognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeRagioneSociale>&#xa;                                &lt;xsl:value-of select=&quot;ordine/cognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeRagioneSociale>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/nome&quot;>&#xa;                            &lt;nome>&#xa;                                &lt;xsl:value-of select=&quot;ordine/nome&quot;/>&#xa;                            &lt;/nome>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/CF&quot;>&#xa;                            &lt;CF>&#xa;                                &lt;xsl:value-of select=&quot;ordine/CF&quot;/>&#xa;                            &lt;/CF>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/PIVA&quot;>&#xa;                            &lt;PIVA>&#xa;                                &lt;xsl:value-of select=&quot;ordine/PIVA&quot;/>&#xa;                            &lt;/PIVA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/IDSLUCo&quot;>&#xa;                            &lt;IDSLUCo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/IDSLUCo&quot;/>&#xa;                            &lt;/IDSLUCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/IDULLCo&quot;>&#xa;                            &lt;IDULLCo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/IDULLCo&quot;/>&#xa;                            &lt;/IDULLCo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/codiceDelivery&quot;>&#xa;                            &lt;codiceDelivery>&#xa;                                &lt;xsl:value-of select=&quot;ordine/codiceDelivery&quot;/>&#xa;                            &lt;/codiceDelivery>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;ordine/DNOLOCollaudo&quot;>&#xa;                            &lt;DNOLOCollaudo>&#xa;                                &lt;xsl:value-of select=&quot;ordine/DNOLOCollaudo&quot;/>&#xa;                            &lt;/DNOLOCollaudo>&#xa;             