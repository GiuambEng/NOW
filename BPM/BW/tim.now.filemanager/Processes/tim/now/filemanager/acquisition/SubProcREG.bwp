             &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Token7/tns4:ResponseCreate_token/tns4:Nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token7/tns4:ResponseCreate_token/tns4:Nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token7/tns4:ResponseCreate_token/tns4:Token)>0 and string-length(telefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token7/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token7/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token7/tns4:ResponseCreate_token/tns4:Token)>0 and string-length(telefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token7/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                      