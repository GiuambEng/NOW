                                <tibex:activityExtension
                                    inputVariable="Log18-input"
                                    name="Log18"
                                    tibex:xpdlId="2aead731-0239-4fb7-a42c-ef12dba5df2f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
