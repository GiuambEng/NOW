                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:ns1=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ATT-ANNArray&quot;/>&#xa;    &lt;xsl:template name=&quot;Token5-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:Request>&#xa;            &lt;tns4:RequestVerificaRollout>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;>&#xa;                    &lt;tns4:CodificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/codificaOLOAGCOM&quot;/>&#xa;                    &lt;/tns4:CodificaOLOAGCOM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ATT-ANNArray/tns1:Richiesta[$index]/codificaOLONOW)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/codificaOLONOW&quot;>&#xa;                            &lt;tns4:CodificaOloNumerico>&#xa;                                &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/codificaOLONOW&quot;/>&#xa;                            &lt;/tns4:CodificaOloNumerico>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Start/ns1:CodISPdaNome&quot;>&#xa;                            &lt;tns4:CodificaOloNumerico>&#xa;                                &lt;xsl:value-of select=&quot;$Start/ns1:CodISPdaNome&quot;/>&#xa;                            &lt;/tns4:CodificaOloNumerico>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/offerta&quot;>&#xa;                    &lt;tns4:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/offerta&quot;/>&#xa;                    &lt;/tns4:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/lavorazione&quot;>&#xa;                    &lt;tns4:Lavorazione>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/lavorazione&quot;/>&#xa;                    &lt;/tns4:Lavorazione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/ISTATComune&quot;>&#xa;                    &lt;tns4:CodiceIstatComune>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/ISTATComune&quot;/>&#xa;                    &lt;/tns4:CodiceIstatComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:FlagReferente>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:FlagReferente>&#xa;                &lt;xsl:if test=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;>&#xa;                    &lt;tns4:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ATT-ANNArray/tns1:Richiesta[$index]/codiceOrdineOLO&quot;/>&#xa;                    &lt;/tns4:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns4:RequestVerificaRollout>&#xa;            &lt;tns4:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns4:ProcessIstance>&#xa;        &lt;/tns4:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
