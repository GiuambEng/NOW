           &lt;xsl:when test=&quot;string-length($rich/Ordine/Cessazione/CessazioneULL/node()/FlagMonitoraggio[1])>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$rich/Ordine/Cessazione/CessazioneULL/node()/FlagMonitoraggio&quot;>&#xa;                                    &lt;flagMonitoraggio>&#xa;                                        &lt;xsl:value-of select=&quot;$rich/Ordine/Cessazione/CessazioneULL/node()/FlagMonitoraggio&quot;/>&#xa;                                    &lt;/flagMonitoraggio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;string-length($rich/Ordine/Variazione/node()/FlagMonitoraggio)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$rich/Ordine/Variazione/node()/FlagMonitoraggio&quot;>&#xa;                                    &lt;flagMonitoraggio>&#xa;                                        &lt;xsl:value-of select=&quot;$rich/Ordine/Variazione/node()/FlagMonitoraggio&quot;/>&#xa;                                    &lt;/flagMonitoraggio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$rich/Ordine/Migrazione/Servizio/node()/FlagMonitoraggio&quot;>&#xa;                                    &lt;flagMonitoraggio>&#xa;                                        &lt;xsl:value-of select=&quot;$rich/Ordine/Migrazione/Servizio/node()/FlagMonitoraggio&quot;/>&#xa;                                    &lt;/flagMonitoraggio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;matches($rich/Testata/Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&#xa;  