value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[number($index)]/Ordine/*/*[1]))&quot;/>&lt;/tns4:Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Variazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/StatoAvanzamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;STATOAVANZAMENTO&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/CancellazioneAccodamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;CANCELLAZIONEACCODAMENTO&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/InterruzioneMigrazione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Annullamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ANNULLAMENTO&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/RimodulazioneDACdaRecipient)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDACDARECIPIENT&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/RimodulazioneAppuntamento)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RIMODULAZIONEDAD&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/InterruzioneSospensione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONESOSPENSIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Comunicazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Comunicazione/RiscontroCodiceSessione)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;RISCONTROCODICESESSIONE&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[number($index)]/Comunicazione/AccettazioneOpereSpeciali)&quot;>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;ACCETTAZIONEOPERESPECIALI&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:Lavorazione>&lt;xsl:value-of select=&quot;&amp;quot;PRENOTIFICADISATTIVAZIONECPS&amp;quot;&quot;/>&lt;/tns4:Lavorazione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)>0 and string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)&amp;lt;=5&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune&quot;>&lt;tns4:CodiceIstatComune>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune&quot;/>&lt;/tns4:CodiceIstatComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)>5&quot;>&lt;tns4:CodiceIstatComune>&lt;xsl:value-of select=&quot;substring($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune,string-length($NORMALarray/Richiesta[$index]/Ordine/*[1]/*[1]/*[1]/Sede/CodiceComune)-5,6)&quot;/>&lt;/tns4:CodiceIstatComune>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Mapper2/tns7:Referente[$index1]/qualificaReferente='CF'&quot;>&lt;tns4:FlagReferente>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns4:FlagReferente>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:FlagReferente>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:FlagReferente>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;>&lt;tns4:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;/>&lt;/tns4:CodiceOrdineOLO>&lt;/xsl:if>&lt;/tns4:RequestVerificaRollout>&lt;tns4:RequestCreate_token>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;>&lt;tns4:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Testata/CodiceOlo&quot;/>&lt;/tns4:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;>&lt;tns4:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo&quot;/>&lt;/tns4:CodiceOrdineOLO>&lt;/xsl:if>&lt;tns4:Funzione>&lt;xsl:value-of select=&quot;'ACQFILE'&quot;/>&lt;/tns4:Funzione>&lt;tns4:ChiaveRiferimento>&lt;xsl:value-of select=&quot;concat($NORMALarray/Richiesta[$index]/Testata/CodiceOrdineOlo,'&amp;amp;' ,string(tib:timestamp()))&quot;/>&lt;/tns4:ChiaveRiferimento>&lt;tns4:Operatore>&lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&lt;/tns4:Operatore>&lt;xsl:if test=&quot;$GetLocalIP/tns8:IPAddress&quot;>&lt;tns4:IPClient>&lt;xsl:value-of select=&quot;$GetLocalIP/tns8:IPAddress&quot;/>&lt;/tns4:IPClient>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper2/tns7:Referente[$index1]/telefonoFissoReferente&quot;>&lt;tns4:N_Recap_Cliente>&lt;xsl:value-of select=&quot;$Mapper2/tns7:Referente[$index1]/telefonoFissoReferente&quot;/>&lt;/tns4:N_Recap_Cliente>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper2/tns7:Referente[$index1]/telefonoMobileReferente&quot;>&lt;tns4:N_Recap_Cliente_ALT>&lt;xsl:value-of select=&quot;$Mapper2/tns7:Referente[$index1]/telefonoMobileReferente&quot;/>&lt;/tns4:N_Recap_Cliente_ALT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper2/tns7:Referente[$index1]/nomeReferente&quot;>&lt;tns4:Nome>&lt;xsl:value-of select=&quot;$Mapper2/tns7:Referente[$index1]/nomeReferente&quot;/>&lt;/tns4:Nome>&lt;/xsl:if>&lt;xsl:if test=&quot;$Mapper2/tns7:Referente[$index1]/cognomeReferente&quot;>&lt;tns4:CognomeRagioneSociale>&lt;xsl:value-of select=&quot;$Mapper2/tns7:Referente[$index1]/cognomeReferente&quot;/>&lt;/tns4:CognomeRagioneSociale>&lt;/xsl:if>&lt;/tns4:RequestCreate_token>&lt;tns4:ProcessIstance>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns4:ProcessIstance>&lt;tns4:StrutturaRichiesta>&lt;xsl:value-of select=&quot;'REGOLATORIO'&quot;/>&lt;/tns4:StrutturaRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa1)>0&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa1&quot;>&lt;tns4:IDRisorsa>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Migrazione/CodiceRisorsa1&quot;/>&lt;/tns4:IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/node()/*[1]/*[1]/IDRisorsa[1])>0&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/node()/*[1]/*[1]/IDRisorsa[1]&quot;>&lt;tns4:IDRisorsa>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/node()/*[1]/*[1]/IDRisorsa[1]&quot;/>&lt;/tns4:IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva/DN)>0&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva/DN&quot;>&lt;tns4:IDRisorsa>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaAttiva/DN&quot;/>&lt;/tns4:IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva/DN)>0&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva/DN&quot;>&lt;tns4:IDRisorsa>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva/DN&quot;/>&lt;/tns4:IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneCPS/DN)>0&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneCPS/DN&quot;>&lt;tns4:IDRisorsa>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Cessazione/CessazioneCPS/DN&quot;/>&lt;/tns4:IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR/DN)>0&quot;>&lt;xsl:if test=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR/DN&quot;>&lt;tns4:IDRisorsa>&lt;xsl:value-of select=&quot;$NORMALarray/Richiesta[number($index)]/Ordine/Variazione/VariazioneWLR/DN&quot;/>&lt;/tns4:IDRisorsa>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneCPS)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;CPS&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneWLRLineaAttiva)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneWLRLineaNonAttiva)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneULL/ULL)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneULL/ULL-NP)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;ULLLINEAATTIVANP&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneULL/Vull)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;VULL&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneULL/ULLDati)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneULL/ULLDati-NP)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;ULLDATILINEAATTIVANP&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneSLU/SLU)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;SLULINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneSLU/SLU-NP)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;SLULINEAATTIVANP&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Cessazione/CessazioneULL/SharedAccess)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[$index]/Ordine/*/*[1]))&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Variazione/VariazioneULL) or exists($NORMALarray/Richiesta[$index]/Ordine/Variazione/VariazioneWLR) or exists($NORMALarray/Richiesta[$index]/Ordine/Variazione/VariazioneSLU)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$NORMALarray/Richiesta[$index]/Ordine/Variazione/VariazioneULL/CambioCoppia/ServizioOriginale='F'&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Variazione/VariazioneWLR)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;WLR&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Variazione/VariazioneULL)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Variazione/VariazioneSLU)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[$index]/Ordine/Variazione/*))&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/Ull) or exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/Vull) or exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/WLR) or exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/SLU)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/Ull)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;ULL&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/Vull)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;VULL&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/WLR)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;WLR&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/SLU)&quot;>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;&amp;quot;SLU&amp;quot;&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[$index]/Ordine/Migrazione/Servizio/*))&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns4:OffertaBPM>&lt;xsl:value-of select=&quot;upper-case(local-name($NORMALarray/Richiesta[$index]/Ordine/*/*[1]))&quot;/>&lt;/tns4:OffertaBPM>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns4:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log10-input"
                                    name="Log10"
                                    tibex:xpdlId="f24e7e1e-40d8-4acd-8eb4-3285fe8bd0a5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Assign19ToLog10"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log10ToGroupEnd6"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Log10-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcREG | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(' Accumulo Token',tib:render-xml($Referente,true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns10:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Log11-input"
                                    name="Log11"
                                    tibex:xpdlId="63b18921-0564-461a-889d-8a5cd484d33a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token1ToLog11"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Log11ToGroupEnd6"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;Log11-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: SubProcREG | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat($_error/StackTrace,$_error/ProcessStack,$_error/Msg,$_error/FullClass,$_error/MsgCode)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns10:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="loggerName" processProperty="LoggerName"/>
                                    <activityConfig>

                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">

                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>

                                    <value
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Referente"
                                    name="Assign19"
                                    outputVariable="Referente"
                                    tibex:xpdlId="a0b1153a-8012-41b4-92b2-f34e5e1555f0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Token1ToAssign19"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign19ToLog10"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/Referenti/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns10=&quot;http://www.tim.com/NOW/xsd/NuovoReferente/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper2&quot;/>&#xa;    &lt;xsl:param name=&quot;Token1&quot;/>&#xa;    &lt;xsl:param name=&quot;Referente&quot;/>&#xa;    &lt;xsl:template name=&quot;Referente&quot; match=&quot;/&quot;>&#xa;        &lt;tns10:Request>&#xa;            &lt;xsl:copy-of select=&quot;$Referente/tns10:Request&quot;/>&#xa;            &lt;tns10:Request>&#xa;                &lt;xsl:if test=&quot;$Token1/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                    &lt;tns10:Token>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                    &lt;/tns10:Token>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token1/tns4:ResponseCreate_token/tns4:ESITO&quot;>&#xa;                    &lt;tns10:Esito>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns4:ResponseCreate_token/tns4:ESITO&quot;/>&#xa;                    &lt;/tns10:Esito>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Token1/tns4:ResponseCreate_token/tns4:DESCRIZIONE&quot;>&#xa;                    &lt;tns10:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;$Token1/tns4:ResponseCreate_token/tns4:DESCRIZIONE&quot;/>&#xa;                    &lt;/tns10:Descrizione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$Mapper2/tns7:Referente[$index1]&quot;>&#xa;                    &lt;tns10:Referente>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;IDRichiestaOLO&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;xsl:if test=&quot;progressivoReferente&quot;>&#xa;                            &lt;progressivoReferente>&#xa;                                &lt;xsl:value-of select=&quot;progressivoReferente&quot;/>&#xa;                            &lt;/progressivoReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tipoReferenteOrdine>&#xa;                            &lt;xsl:value-of select=&quot;tipoReferenteOrdine&quot;/>&#xa;                        &lt;/tipoReferenteOrdine>&#xa;                        &lt;xsl:if test=&quot;qualificaReferente&quot;>&#xa;                            &lt;qualificaReferente>&#xa;                                &lt;xsl:value-of select=&quot;qualificaReferente&quot;/>&#xa;                            &lt;/qualificaReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Token1/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;>&#xa;                            &lt;cognomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token1/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;/>&#xa;                            &lt;/cognomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Token1/tns4:ResponseCreate_token/tns4:Nome&quot;>&#xa;                            &lt;nomeReferente>&#xa;                                &lt;xsl:value-of select=&quot;$Token1/tns4:ResponseCreate_token/tns4:Nome&quot;/>&#xa;                            &lt;/nomeReferente>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token1/tns4:ResponseCreate_token/tns4:Token)>0 and string-length(telefonoFissoReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token1/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;$Token1/tns4:ResponseCreate_token/tns4:Token&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;telefonoFissoReferente&quot;>&#xa;                                    &lt;telefonoFissoReferente>&#xa;                                        &lt;xsl:value-of select=&quot;telefonoFissoReferente&quot;/>&#xa;                                    &lt;/telefonoFissoReferente>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($Token1/tns4:ResponseCreate_token/tns4:Token)>0 and string-length(telefonoMobileReferente)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$Token1/tns4:ResponseCreate_token/tns4:Token&quot;>&#xa;                                    &lt;telefonoMobileReferente>&#xa;                                      