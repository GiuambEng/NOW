                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RenderXmlToAssignD420"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXml&quot;/>&lt;xsl:param name=&quot;Token&quot;/>&lt;xsl:template name=&quot;RenderXml-input&quot; match=&quot;/&quot;>&lt;Richiesta>&lt;Testata>&lt;CodiceOlo>&lt;xsl:value-of select=&quot;$ParseXml/Testata/CodiceOlo&quot;/>&lt;/CodiceOlo>&lt;CodiceOrdineOlo>&lt;xsl:value-of select=&quot;$ParseXml/Testata/CodiceOrdineOlo&quot;/>&lt;/CodiceOrdineOlo>&lt;xsl:if test=&quot;$ParseXml/Testata/CodiceOrdineOloPadre&quot;>&lt;CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;$ParseXml/Testata/CodiceOrdineOloPadre&quot;/>&lt;/CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/Testata/CodiceProgetto&quot;>&lt;CodiceProgetto>&lt;xsl:value-of select=&quot;$ParseXml/Testata/CodiceProgetto&quot;/>&lt;/CodiceProgetto>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;matches($ParseXml/Testata/Note, '(.*\s+|^)((0|3)(\d{8,11}))(\s+.*|$)')&quot;>&lt;Note>&lt;xsl:value-of select=&quot;translate($ParseXml/Testata/Note, '0123456789', '         ')&quot;/>&lt;/Note>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ParseXml/Testata/Note&quot;>&lt;Note>&lt;xsl:value-of select=&quot;$ParseXml/Testata/Note&quot;/>&lt;/Note>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$ParseXml/Testata/Correlazioni&quot;/>&lt;xsl:if test=&quot;$ParseXml/Testata/ReferentiOAOProgettiSpeciali&quot;>&lt;ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;$ParseXml/Testata/ReferentiOAOProgettiSpeciali&quot;/>&lt;/ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;/Testata>&lt;Ordine>&lt;Attivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ParseXml/Ordine/Attivazione/WLRLineaAttiva)&quot;>&lt;WLRLineaAttiva>&lt;DN>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/DN&quot;/>&lt;/DN>&lt;FlagMantenimentoProdotti>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/FlagMantenimentoProdotti&quot;/>&lt;/FlagMantenimentoProdotti>&lt;DataSottoscrizioneContratto>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/DataSottoscrizioneContratto&quot;/>&lt;/DataSottoscrizioneContratto>&lt;xsl:if test=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/DataDAC&quot;>&lt;DataDAC>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/DataDAC&quot;/>&lt;/DataDAC>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/FlagAggiuntivi&quot;>&lt;FlagAggiuntivi>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/FlagAggiuntivi&quot;/>&lt;/FlagAggiuntivi>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/BorchiaNT1Plus&quot;>&lt;BorchiaNT1Plus>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/BorchiaNT1Plus&quot;/>&lt;/BorchiaNT1Plus>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/CodiceQualita&quot;>&lt;CodiceQualita>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/CodiceQualita&quot;/>&lt;/CodiceQualita>&lt;/xsl:if>&lt;DatiCliente>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;$Token/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;/>&lt;/CognomeRagSoc>&lt;xsl:if test=&quot;$Token/tns4:ResponseCreate_token/tns4:Nome&quot;>&lt;Nome>&lt;xsl:value-of select=&quot;$Token/tns4:ResponseCreate_token/tns4:Nome&quot;/>&lt;/Nome>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Token/tns4:ResponseCreate_token/tns4:CodiceFiscale)>0&quot;>&lt;xsl:if test=&quot;$Token/tns4:ResponseCreate_token/tns4:CodiceFiscale&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Token/tns4:ResponseCreate_token/tns4:CodiceFiscale&quot;/>&lt;/CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Token/tns4:ResponseCreate_token/tns4:PIVA&quot;>&lt;PIVA>&lt;xsl:value-of select=&quot;$Token/tns4:ResponseCreate_token/tns4:PIVA&quot;/>&lt;/PIVA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DatiCliente>&lt;xsl:copy-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/DatiSede&quot;/>&lt;xsl:copy-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/Referente&quot;/>&lt;xsl:if test=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/CampoServizioIT&quot;>&lt;CampoServizioIT>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/CampoServizioIT&quot;/>&lt;/CampoServizioIT>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/ClirPermanente&quot;>&lt;ClirPermanente>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/ClirPermanente&quot;/>&lt;/ClirPermanente>&lt;/xsl:if>&lt;xsl:if test=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/FlagMantenimentoSTS&quot;>&lt;FlagMantenimentoSTS>&lt;xsl:value-of select=&quot;$ParseXml/Ordine/Attivazione/WLRLineaAttiva/FlagMantenimentoSTS&quot;/>&lt;/FlagMantenimentoSTS>&lt;/xsl:if>&lt;/WLRLineaAttiva>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($ParseXml/Ordine/Attivazione/WLRLineaNonAttiva)&quot;>&lt;WLRLineaNonAttiva>&lt;DatiCliente>&lt;CognomeRagSoc>&lt;xsl:value-of select=&quot;$Token/tns4:ResponseCreate_token/tns4:CognomeRagioneSociale&quot;/>&lt;/CognomeRagSoc>&lt;xsl:if test=&quot;string-length($Token/tns4:ResponseCreate_token/tns4:Nome)>0&quot;>&lt;xsl:if test=&quot;$Token/tns4:ResponseCreate_token/tns4:Nome&quot;>&lt;Nome>&lt;xsl:value-of select=&quot;$Token/tns4:ResponseCreate_token/tns4:Nome&quot;/>&lt;/Nome>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Token/tns4:ResponseCreate_token/tns4:CodiceFiscale)>0&quot;>&lt;CF>&lt;xsl:value-of select=&quot;$Token/tns4:ResponseCreate_token/tns4:CodiceFiscale&quot;/>&lt;/CF>&lt;/xsl:when>&lt;xsl:otherwise>&lt;PIVA>&lt;