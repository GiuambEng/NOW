;codiceOrdineOLOPadre>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineOLOPadre&quot;/>&#xa;                &lt;/codiceOrdineOLOPadre>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTI&quot;>&#xa;                &lt;codiceOrdineTI>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTI&quot;/>&#xa;                &lt;/codiceOrdineTI>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceOrdineTITarget&quot;>&#xa;                &lt;codiceOrdineTITarget>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceOrdineTITarget&quot;/>&#xa;                &lt;/codiceOrdineTITarget>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceProgetto&quot;>&#xa;                &lt;codiceProgetto>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceProgetto&quot;/>&#xa;                &lt;/codiceProgetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;dataInvioRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Richiesta/dataInvioRichiesta&quot;/>&#xa;            &lt;/dataInvioRichiesta>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDAnagraficaCausale&quot;>&#xa;                &lt;IDAnagraficaCausale>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDAnagraficaCausale&quot;/>&#xa;                &lt;/IDAnagraficaCausale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDCorrelazione&quot;>&#xa;                &lt;IDCorrelazione>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDCorrelazione&quot;/>&#xa;                &lt;/IDCorrelazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/totaleRichiestePacchetto&quot;>&#xa;                &lt;totaleRichiestePacchetto>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/totaleRichiestePacchetto&quot;/>&#xa;                &lt;/totaleRichiestePacchetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/tipoPacchetto&quot;>&#xa;                &lt;tipoPacchetto>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/tipoPacchetto&quot;/>&#xa;                &lt;/tipoPacchetto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDPacchettoNOW&quot;>&#xa;                &lt;IDPacchettoNOW>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDPacchettoNOW&quot;/>&#xa;                &lt;/IDPacchettoNOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/contenutoXML&quot;>&#xa;                &lt;contenutoXML>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/contenutoXML&quot;/>&#xa;                &lt;/contenutoXML>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/note&quot;>&#xa;                &lt;note>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/note&quot;/>&#xa;                &lt;/note>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$Richiesta/ordine&quot;>&#xa;                &lt;ordine>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/offertaCatalogo&quot;>&#xa;                        &lt;offertaCatalogo>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/offertaCatalogo&quot;/>&#xa;                        &lt;/offertaCatalogo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/DAC&quot;>&#xa;                        &lt;DAC>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/ordine/DAC&quot;/>&#xa;                        &lt;/DAC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Richiesta/ordine/DACRimodulata&quot;>&#xa;                        &lt;DACRimodulata>&#xa;                            &lt;xsl:value-of select=&quot;$Richiesta/or