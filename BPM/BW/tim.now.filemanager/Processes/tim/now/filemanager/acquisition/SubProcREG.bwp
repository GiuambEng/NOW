;            &lt;xsl:if test=&quot;$Richiesta/esito&quot;>&#xa;                &lt;esito>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/esito&quot;/>&#xa;                &lt;/esito>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceCausaleInterno&quot;>&#xa;                &lt;codiceCausaleInterno>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceCausaleInterno&quot;/>&#xa;                &lt;/codiceCausaleInterno>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/dataEspletamentoDONOR&quot;>&#xa;                &lt;dataEspletamentoDONOR>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/dataEspletamentoDONOR&quot;/>&#xa;                &lt;/dataEspletamentoDONOR>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/codiceTrasformazione&quot;>&#xa;                &lt;codiceTrasformazione>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/codiceTrasformazione&quot;/>&#xa;                &lt;/codiceTrasformazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/flagOpereSpeciali&quot;>&#xa;                &lt;flagOpereSpeciali>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/flagOpereSpeciali&quot;/>&#xa;                &lt;/flagOpereSpeciali>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDRisorsaCorrelato&quot;>&#xa;                &lt;IDRisorsaCorrelato>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDRisorsaCorrelato&quot;/>&#xa;                &lt;/IDRisorsaCorrelato>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Richiesta/IDRichiestaOLOGenerante&quot;>&#xa;                &lt;IDRichiestaOLOGenerante>&#xa;                    &lt;xsl:value-of select=&quot;$Richiesta/IDRichiestaOLOGenerante&quot;/>&#xa;                &lt;/IDRichiestaOLOGenerante>&#xa;            &lt;/xsl:if>&#xa;            