            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="SubProc103R_NP-input"
                    name="SubProc103R_NP"
                    outputVariable="SubProc103R_NP"
                    tibex:xpdlId="9cf54564-6d8b-4b51-b529-390c5792116c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log103R_NPToSubProc103R_NP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SubProc103R_NPToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/xsd/103R_NP_start&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;Parse103NP_R&quot;/>&#xa;    &lt;xsl:template name=&quot;SubProc103R_NP-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:IDfile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns3:IDfile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&#xa;                    &lt;ns3:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ComunicazioneNP>&#xa;                &lt;xsl:for-each select=&quot;$Parse103NP_R/ComunicazioneNP/Risposta&quot;>&#xa;                    &lt;ns3:Risposta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(Valid_Formale_DonorRecipient)&quot;>&#xa;                                &lt;ns3:Valid_Formale_DonorRecipient>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonor>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:TipoLinea>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/TipoLinea&quot;/>&#xa;                                    &lt;/ns3:TipoLinea>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;ns3:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns3:CognomeCliente_RagioneSociale>&#xa;                                    &lt;xsl:if test=&quot;Valid_Formale_DonorRecipient/NomeCliente&quot;>&#xa;                                        &lt;ns3:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/NomeCliente&quot;/>&#xa;                                        &lt;/ns3:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Valid_Formale_DonorRecipient/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_DonorRecipient/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_DonorRecipient/NPAggiuntive&quot;>&#xa;                                        &lt;ns3:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns3:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns3:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns3:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_DonorRecipient/EsitoVerifica&quot;>&#xa;                                        &lt;ns3:EsitoVerifica>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists(EsitoKO)&quot;>&#xa;                                                    &lt;ns3:EsitoKO>&#xa;                                                        &lt;ns3:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns3:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns3:CodiceMotivoRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/CodiceMotivoRifiuto&quot;/>&#xa;                                                        &lt;/ns3:CodiceMotivoRifiuto>&#xa;                                                        &lt;ns3:DescrizioneRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/DescrizioneRifiuto&quot;/>&#xa;                                                        &lt;/ns3:DescrizioneRifiuto>&#xa;                                                    &lt;/ns3:EsitoKO>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns3:EsitoOK>&#xa;                                                        &lt;ns3:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoOK/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns3:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns3:IdentificativoOperatoreDonating>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoOK/IdentificativoOperatoreDonating&quot;/>&#xa;                                                        &lt;/ns3:IdentificativoOperatoreDonating>&#xa;                                                    &lt;/ns3:EsitoOK>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/ns3:EsitoVerifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns3:Valid_Formale_DonorRecipient>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Valid_Tecnica_Donating_Donor)&quot;>&#xa;                                &lt;ns3:Valid_Tecnica_Donating_Donor>&#xa;                        