                                <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateToFaultExit"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns14=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8cd8d05d-e538-4ed2-af60-30e460f95a0b+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Errore_LogFileProcst-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns14:jdbcUpdateActivityInput>&#xa;            &lt;COD_PROCSO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ALIMENTATORE_NOW&amp;quot;&quot;/>&#xa;            &lt;/COD_PROCSO>&#xa;            &lt;ID_ESEC_PROCSO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ReadFileInfo/tns4:IdEsecProcsoFile)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IdEsecProcsoFile&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ESEC_PROCSO>&#xa;            &lt;ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ID_FILE>&#xa;            &lt;LOG_LEVEL>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;            &lt;/LOG_LEVEL>&#xa;            &lt;LOG_MESSAGE>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Palette fallita: &amp;quot;, $FaultDetails/ActivityName, &amp;quot; Codice errore: &amp;quot;, $FaultDetails/MsgCode, &amp;quot; Messaggio errore: &amp;quot;, tib:render-xml($FaultDetails,true(),true()),&amp;quot; JobId: &amp;quot;,$_processContext/JobId, &amp;quot; ProcessInstanceId: &amp;quot;, $_processContext/ProcessInstanceId, &amp;quot; Timestamp: &amp;quot;,string(current-dateTime()))&quot;/>&#xa;            &lt;/LOG_MESSAGE>&#xa;            &lt;TIMSTP_INSMTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO>&#xa;        &lt;/tns14:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="Timeout"/>
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    interpretEmptyStringAsNull="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO LOG_FILE_PROCSTO (COD_PROCSO,ID_ESEC_PROCSO,ID_FILE,LOG_LEVEL,LOG_MESSAGE,TIMSTP_INSMTO)&#xa;VALUES (?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="COD_PROCSO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ESEC_PROCSO"/>
                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LOG_LEVEL"/>
                                    <PreparedParameters
                                    DataType="2005"
                                    DataTypeDisplayValue="CLOB" ParameterName="LOG_MESSAGE"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
