DN)&quot;>&#xa;                                                            &lt;ns:ISDN>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                                &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                                                &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                &lt;xsl:for-each select=&quot;ISDN/NPAggiuntive&quot;>&#xa;                                                                    &lt;ns:NPAggiuntive>&#xa;                                                                        &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                                            &lt;ns:NumAggiuntivaPortata>&#xa;                                                                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                                            &lt;/ns:NumAggiuntivaPortata>&#xa;                                                                        &lt;/xsl:for-each>&#xa;                                                                    &lt;/ns:NPAggiuntive>&#xa;                                                                &lt;/xsl:for-each>&#xa;                                                            &lt;/ns:ISDN>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns:GNR>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;GNR/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                            &lt;/ns:GNR>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns:TipoLinea>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                            &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                            &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                            &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                            &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                &lt;ns:NomeCliente>&#xa;                                                    &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                &lt;/ns:NomeCliente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;CodiceProgetto&quot;>&#xa;                                                &lt;ns:CodiceProgetto>&#xa;                                                    &lt;xsl:value-of select=&quot;CodiceProgetto&quot;/>&#xa;                                                &l