                                    <bpws:sources>
                                    <bpws:source linkName="MapperToLog"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RimuoviDuplicati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;RimuoviDuplicatiInArray&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:TracciatoOLONGA>&lt;xsl:for-each select=&quot;$ParseXmlNGA/tns:Richiesta[$index]&quot;>&lt;tns:Richiesta>&lt;xsl:copy-of select=&quot;tns:Testata&quot;/>&lt;tns:TipoRichiesta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:TipoRichiesta/tns:Attivazione)&quot;>&lt;tns:Attivazione>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB)&quot;>&lt;tns:BitstreamNGAFTTCAB>&lt;tns:Accesso>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB/tns:Accesso/tns:LineaPOTS)&quot;>&lt;xsl:copy-of select=&quot;tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB/tns:Accesso/tns:LineaPOTS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:LineaNonFonia>&lt;xsl:copy-of select=&quot;tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB/tns:Accesso/tns:LineaNonFonia/tns:DatiSede&quot;/>&lt;xsl:copy-of select=&quot;tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB/tns:Accesso/tns:LineaNonFonia/tns:ClienteFinale&quot;/>&lt;xsl:if test=&quot;tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB/tns:Accesso/tns:LineaNonFonia/tns:SlaProvisioning&quot;>&lt;tns:SlaProvisioning>&lt;xsl:value-of select=&quot;tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB/tns:Accesso/tns:LineaNonFonia/tns:SlaProvisioning&quot;/>&lt;/tns:SlaProvisioning>&lt;/xsl:if>&lt;tns:SlaAssurance>&lt;xsl:value-of select=&quot;tns:TipoRichiesta/tns:Attiva