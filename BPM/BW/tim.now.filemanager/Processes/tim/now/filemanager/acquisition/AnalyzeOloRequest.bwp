                &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns3:Espletamento_Donating>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donating/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donating/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donating/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donating/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donating/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Espletamento_Donating/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Espletamento_Donating/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;Espletamento_Donating/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donating/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:DataEspletamentoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donating/DataEspletamentoOrdine&quot;/>&#xa;                                    &lt;/ns3:DataEspletamentoOrdine>&#xa;                                &lt;/ns3:Espletamento_Donating>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns3:Risposta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns3:ComunicazioneNP>&#xa;            &lt;ns3:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&#xa;            &lt;/ns3:NomeFile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;ns3:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/ns3:CodIspIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/ns3:CodIspIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($ReadFileInfo/tns4:TimestampAperturaFile)&quot;>&#xa;                &lt;ns3:TimstpAperturaFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:TimestampAperturaFile&quot;/>&#xa;                &lt;/ns3:TimstpAperturaFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
