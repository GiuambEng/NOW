                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;NGA_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns2:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;ns2:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/ns2:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns2:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/ns2:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ReadFileInfo/tns4:CodAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;>&#xa;                        &lt;ns2:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                        &lt;/ns2:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;>&#xa;                        &lt;ns2:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                        &lt;/ns2:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns2:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns2:ID_FILE>&#xa;            &lt;ns2:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/ns2:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;ns2:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/ns2:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns2:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/ns2:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay.parameters/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;ns2:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns5:outputDate&quot;/>&#xa;                    &lt;/ns2:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns2:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/ns2:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:TracciatoOLONGA>&#xa;                &lt;xsl:for-each select=&quot;$Accumulate/tns:TracciatoOLONGA&quot;>&#xa;                    &lt;tns:Richiesta>&#xa;                        &lt;tns:Testata>&#xa;                            &lt;tns:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOlo&quot;/>&#xa;                            &lt;/tns:CodiceOlo>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOlo&quot;>&#xa;                                &lt;tns:CodiceOrdineOlo>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/tns:CodiceOrdineOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOloPadre&quot;>&#xa;                                &lt;tns:CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/tns:CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceProgetto&quot;>&#xa;                                &lt;tns:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceProgetto&quot;/>&#xa;                                &lt;/tns:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:Note&quot;>&#xa;                                &lt;tns:Note>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:Note&quot;/>&#xa;                                &lt;/tns:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:TestMode&quot;>&#xa;                                &lt;tns:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:TestMode&quot;/>&#xa;                                &lt;/tns:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:semiVULA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:semiVULA&quot;>&#xa;                                        &lt;tns:semiVULA>&#xa;                                            &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:semiVULA&quot;/>&#xa;                                        &lt;/tns:semiVULA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:semiBitstreamNGA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:semiBitstreamNGA&quot;>&#xa;                                        &lt;tns:semiBitstreamNGA>&#xa;                                            &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:semiBitstreamNGA&quot;/>&#xa;                                        &lt;/tns:semiBitstreamNGA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:semiEasyIPNGA)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:semiEasyIPNGA&quot;>&#xa;                                        &lt;tns:semiEasyIPNGA>&#xa;                                            &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:semiEasyIPNGA&quot;/>&#xa;                                        &lt;/tns:semiEasyIPNGA>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:FullGPONPLUS)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:FullGPONPLUS&quot;>&#xa;                                        &lt;tns:FullGPONPLUS>&#xa;                                            &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:FullGPONPLUS&quot;/>&#xa;                                        &lt;/tns:FullGPONPLUS>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:IdReteSecondariaOAO&quot;>&#xa;                                &lt;tns:IdReteSecondariaOAO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:IdReteSecondariaOAO&quot;/>&#xa;                                &lt;/tns:IdReteSecondariaOAO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:ReferentiOAOProgettiSpeciali&quot;>&#xa;                                &lt;tns:ReferentiOAOProgettiSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                                &lt;/tns:ReferentiOAOProgettiSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOperatoreSecondario&quot;>&#xa;                                &lt;tns:CodiceOperatoreSecondario>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOperatoreSecondario&quot;/>&#xa;                                &lt;/tns:CodiceOperatoreSecondario>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:ClusterAccesso&quot;>&#xa;                                &lt;tns:ClusterAccesso>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:ClusterAccesso&quot;/>&#xa;                                &lt;/tns:ClusterAccesso>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:Testata>&#xa;                        &lt;xsl:copy-of select=&quot;tns:Richiesta[1]/tns:TipoRichiesta&quot;/>&#xa;                    &lt;/tns:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/tns:TracciatoOLONGA>&#xa;        &lt;/ns2:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubProcNGA_NEW" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
