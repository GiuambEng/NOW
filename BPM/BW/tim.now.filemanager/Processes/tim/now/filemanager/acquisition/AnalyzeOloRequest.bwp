ctoryNumber>&#xa;                                                &lt;xsl:value-of select=&quot;DirectoryNumber&quot;/>&#xa;                                            &lt;/ns:DirectoryNumber>&#xa;                                            &lt;ns:IdentificativoOperatoreDonor>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoOperatoreDonor&quot;/>&#xa;                                            &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                            &lt;ns:DataInvioMessaggio>&#xa;                                                &lt;xsl:value-of select=&quot;DataInvioMessaggio&quot;/>&#xa;                                            &lt;/ns:DataInvioMessaggio>&#xa;                                            &lt;xsl:if test=&quot;Note&quot;>&#xa;                                                &lt;ns:Note>&#xa;                                                    &lt;xsl:value-of select=&quot;Note&quot;/>&#xa;                                                &lt;/ns:Note>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:CodiceOpRecipient>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOpRecipient&quot;/>&#xa;                                            &lt;/ns:CodiceOpRecipient>&#xa;                                            &lt;ns:CodiceSegreto>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceSegreto&quot;/>&#xa;                                            &lt;/ns:CodiceSegreto>&#xa;                                            &lt;xsl:for-each select=&quot;TipoLinea&quot;>&#xa;                                                &lt;ns:TipoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;exists(ISDN)&quot;>&#xa;                                      