                                <bpws:links>
                                    <bpws:link
                                    name="Bad_KO_PARSE_XMLToExit1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogToBad_KO_PARSE_XML" tibex:linkType="SUCCESS"/>
                                </bpws:links>
