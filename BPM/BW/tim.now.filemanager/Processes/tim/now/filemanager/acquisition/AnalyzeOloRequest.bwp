            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="ENDFilePoller"
                    tibex:xpdlId="d3c7c679-a34a-491e-b59d-ce9517791760"
                    variable="ENDFilePoller" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="ENDFilePollerToRemoveENDFile"/>
                    </bpws:sources>
                    <sequenceKey
                        expression="string(if(starts-with($ENDFilePoller/fileInfo/fileName,$NGAPref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($NGAPref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$ADSLPref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($ADSLPref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$N_NP_pref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($N_NP_pref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$R_NP_pref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($R_NP_pref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$N_pref) and not(starts-with($ENDFilePoller/fileInfo/fileName,$N_NP_pref))) then substring($ENDFilePoller/fileInfo/fileName,1+string-length($N_pref),3) else if (starts-with($ENDFilePoller/fileInfo/fileName,$R_pref) and not(starts-with($ENDFilePoller/fileInfo/fileName,$R_NP_pref))) then substring($ENDFilePoller/fileInfo/fileName,1+string-length($R_pref),3) else  substring($ENDFilePoller/fileInfo/fileName,1,3))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    <sequenceKeyDesign
                        expression="string(if(starts-with($ENDFilePoller/fileInfo/fileName,$NGAPref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($NGAPref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$ADSLPref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($ADSLPref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$N_NP_pref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($N_NP_pref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$R_NP_pref)) then substring($ENDFilePoller/fileInfo/fileName,1,3+string-length($R_NP_pref)) else if (starts-with($ENDFilePoller/fileInfo/fileName,$N_pref) and not(starts-with($ENDFilePoller/fileInfo/fileName,$N_NP_pref))) then substring($ENDFilePoller/fileInfo/fileName,1+string-length($N_pref),3) else if (starts-with($ENDFilePoller/fileInfo/fileName,$R_pref) and not(starts-with($ENDFilePoller/fileInfo/fileName,$R_NP_pref))) then substring($ENDFilePoller/fileInfo/fileName,1+string-length($R_pref),3) else  substring($ENDFilePoller/fileInfo/fileName,1,3))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    <bpws:correlations/>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.file.poller"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="fileName" processProperty="FileFullName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//FilePoller"/>
                                    <value contentAs="text"
                                    createEvent="true"
                                    encodingUsed="UTF-8"
                                    excludeContent="true"
                                    includeCurrent="true"
                                    includeSubDirectories="true"
                                    mode="files-and-directories"
                                    modifyEvent="true"
                                    pollInterval="5"
                                    sortby="File Name"
                                    sortorder="ascending" xsi:type="file:FilePoller"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogFilePoller-input"
                    name="LogFilePoller"
                    tibex:xpdlId="712a2c53-2a61-40de-94e1-312090606211" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RemoveENDFileToLogFilePoller"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogFilePollerToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogFilePollerToLogOscuraFBS">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FlagOscuraFBS='Y' and starts-with($ENDFilePoller/fileInfo/fileName,$FIBERSTREAMPref)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$FlagOscuraFBS='Y' and starts-with($ENDFilePoller/fileInfo/fileName,$FIBERSTREAMPref)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ENDFilePoller&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFilePoller-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Trovato END file: &amp;quot;, $ENDFilePoller/fileInfo/fullName)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RemoveENDFile-input"
                    name="RemoveENDFile" outputVariable="RemoveENDFile"
                    tibex:xpdlId="6f3445bd-4b14-471d-b31f-7a901d0ea20d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ENDFilePollerToRemoveENDFile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RemoveENDFileToLogFilePoller"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns14=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ENDFilePoller&quot;/>&#xa;    &lt;xsl:template name=&quot;RemoveFile-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns14:RemoveActivityInputClass>&#xa;            &lt;fileName>&#xa;                &lt;xsl:value-of select=&quot;$ENDFilePoller/fileInfo/fullName&quot;/>&#xa;            &lt;/fileName>&#xa;        &lt;/tns14:RemoveActivityInputClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.file.remove"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:file="http://ns.tibco.com/bw/palette/file" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/file#//RemoveFile"/>
                                    <value xsi:type="file:RemoveFile"/>
                                </properties>
                            </activityConfig>
