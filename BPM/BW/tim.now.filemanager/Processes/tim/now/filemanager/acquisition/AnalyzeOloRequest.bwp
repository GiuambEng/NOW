            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogGPON-input"
                    name="LogGPON"
                    tibex:xpdlId="a9ec904b-82b3-4978-9ddb-5b00cf60139c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToLog_GPON"/>
