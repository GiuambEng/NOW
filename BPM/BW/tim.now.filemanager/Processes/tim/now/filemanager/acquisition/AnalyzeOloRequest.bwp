                    <bpws:sources>
                        <bpws:source linkName="ContatoriREGToJDBCUpdate1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns11=&quot;http://www.example.org/ListaContatori&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;REG_SUBPROCESS&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns11:Contatori>&lt;tns11:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns11:StringaCRMWS,$REG_SUBPROCESS/tns11:StringaCRMWS)&quot;/>&lt;/tns11:StringaCRMWS>&lt;tns11:StringaWSDP>&lt;xsl:value-of select=&quot;concat($Contatori/tns11:StringaWSDP,$REG_SUBPROCESS/tns11:StringaWSDP)&quot;/>&lt;/tns11:StringaWSDP>&lt;tns11:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns11:StringaSDR,$REG_SUBPROCESS/tns11:StringaSDR)&quot;/>&lt;/tns11:StringaSDR>&lt;tns11:StringaDBCFX>&lt;xsl:value-of select=&quot;concat($Contatori/tns11:StringaDBCFX,$REG_SUBPROCESS/tns11:StringaDBCFX)&quot;/>&lt;/tns11:StringaDBCFX>&lt;tns11:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreCRMWS+$REG_SUBPROCESS/tns11:ContatoreCRMWS)&quot;/>&lt;/tns11:ContatoreCRMWS>&lt;tns11:ContatoreWSDP>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreWSDP+$REG_SUBPROCESS/tns11:ContatoreWSDP)&quot;/>&lt;/tns11:ContatoreWSDP>&lt;tns11:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreSDR+$REG_SUBPROCESS/tns11:ContatoreSDR)&quot;/>&lt;/tns11:ContatoreSDR>&lt;tns11:ContatoreDBCFX>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreDBCFX+$REG_SUBPROCESS/tns11:ContatoreDBCFX)&quot;/>&lt;/tns11:ContatoreDBCFX>&lt;tns11:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreNOW+$REG_SUBPROCESS/tns11:ContatoreNOW)&quot;/>&lt;/tns11:ContatoreNOW>&lt;tns11:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreKO+$REG_SUBPROCESS/tns11:ContatoreKO)&quot;/>&lt;/tns11:ContatoreKO>&lt;/tns11:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
