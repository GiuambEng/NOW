                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($ParseXmlREG/Richiesta[$index]/Ordine/Attivazione/SLULineaNonAttiva/ServiziOpzionali)>0 or count($ParseXmlREG/Richiesta[$index]/Ordine/Attivazione/SLULineaAttiva/ServiziOpzionali)>0 or count($ParseXmlREG/Richiesta[$index]/Ordine/Attivazione/ULLLineaAttiva/ServiziOpzionali)>0 or count($ParseXmlREG/Richiesta[$index]/Ordine/Attivazione/ULLLineaNonAttiva/ServiziOpzionali)>0 or count($ParseXmlREG/Richiesta[$index]/Ordine/Attivazione/ULLLineaAttivaNP/ServiziOpzionali)>0  or count($ParseXmlREG/Richiesta[$index]/Ordine/Attivazione/SLULineaAttivaNP/ServiziOpzionali)>0]]></bpws:transitionCondition>
