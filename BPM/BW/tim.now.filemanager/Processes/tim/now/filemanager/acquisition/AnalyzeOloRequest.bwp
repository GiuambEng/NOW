ating/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Espletamento_Donor_RecipientDonating/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Espletamento_Donor_RecipientDonating/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:DataEspletamentoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Donor_RecipientDonating/DataEspletamentoOrdine&quot;/>&#xa;                                    &lt;/ns3:DataEspletamentoOrdine>&#xa;                                    &lt;xsl:for-each select=&quot;Espletamento_Donor_RecipientDonating/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Espletamento_Donor_RecipientDonating/NPAggiuntive&quot;>&#xa;                                        &lt;ns3:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns3:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns3:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns3:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns3:Espletamento_Donor_RecipientDonating>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Espletamento_Cessazione)&quot;>&#xa;                                &lt;ns3:Espletamento_Cessazione>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:DataEspletamentoOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Espletamento_Cessazione/DataEspletamentoOrdine&quot;/>&#xa;                                    &lt;/ns3:DataEspletamentoOrdine>&#xa;                                &lt;/ns3:Espletamento_Cessazione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Valid_Formale_Cessazione)&quot;>&#xa;                                &lt;ns3:Valid_Formale_Cessazione>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Cessazione/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonor>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&