                    inputVariable="LogNotFileInformation-input"
                    name="LogNotFileInformation"
                    tibex:xpdlId="327169f0-6a2e-4a2d-b3ef-0762b7264bcb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
