           &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:if test=&quot;Valid_Tecnica_Cessazione/TipoLinea&quot;>&#xa;                                        &lt;ns:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Valid_Tecnica_Cessazione/TipoLinea&quot;/>&#xa;                                        &lt;/ns:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Tecnica_Cessazione/Telecom&quot;>&#xa;                                        &lt;ns:Telecom>&#xa;                                            &lt;xsl:for-each select=&quot;Rientro&quot;>&#xa;                                                &lt;ns:Rientro>&#xa;                                                    &lt;ns:RientroTI>&#xa;                                                        &lt;xsl:value-of select=&quot;RientroTI&quot;/>&#xa;                                                    &lt;/ns:RientroTI>&#xa;                                                    &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                        &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                                    &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                                    &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                        &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                                    &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                                    &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                        &lt;ns:NomeCliente>&#xa;                                                            &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                        &lt;/ns:NomeCliente>&#xa;                                                    &lt;/xsl:if>&#xa;                                                    &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                        &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                                    &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                                    &lt;ns:EmailReferenteRichiedente>&#xa;                                                        &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                                    &lt;/ns:EmailReferenteRichiedente>&#xa;                                                    &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                        &lt;ns:Correlazioni>&#xa;                                                            &lt;ns:IdentificativoCorrelazioni>&#xa;                                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                            &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                            &lt;ns:TotaleRichieste>&#xa;                                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                            &lt;/ns:TotaleRichieste>&#xa;                                                        &lt;/ns:Correlazioni>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:Rientro>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:for-each select=&quot;NPAggiuntive&quot;>&#xa;                                                &lt;ns:NPAggiuntive>&#xa;                                                    &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                        &lt;ns:NumAggiuntivaPortata>&#xa;                                                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                        &lt;/ns:NumAggiuntivaPortata>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:NPAggiuntive>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:Telecom>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Tecnica_Cessazione/EsitoVerifica&quot;>&#xa;                                        &lt;ns:EsitoVerifica>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists(EsitoKO)&quot;>&#xa;                                                    &lt;ns:EsitoKO>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns:CodiceMotivoRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/CodiceMotivoRifiuto&quot;/>&#xa;                                                        &lt;/ns:CodiceMotivoRifiuto>&#xa;                                                        &lt;ns:DescrizioneRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/DescrizioneRifiuto&quot;/>&#xa;                                                        &lt;/ns:DescrizioneRifiuto>&#xa;                                                    &lt;/ns:EsitoKO>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns:EsitoOK>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoOK/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                    &lt;/ns:EsitoOK>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/ns:EsitoVerifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns:Valid_Tecnica_Cessazione>&#xa;                            &lt;/ns:Risposta>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns:ComunicazioneNP>&#xa;            &lt;ns:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&#xa;            &lt;/ns:NomeFile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;ns:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/ns:CodIspIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/ns:CodIspIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1'&quot;>&#xa;                &lt;ns:FlagOscuramento>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/ns:FlagOscuramento>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ReadFileInfo/tns4:TimestampAperturaFile)&quot;>&#xa;                &lt;ns:TimstpAperturaFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:TimestampAperturaFile&quot;/>&#xa;                &lt;/ns:TimstpAperturaFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubProcR_NP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
