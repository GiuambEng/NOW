                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogToBad_KO_PARSE_XML"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Bad_KO_PARSE_XMLToExit1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns14=&quot;http://www.example.org/GenerateBadFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LocalPath&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:template name=&quot;Bad_KO_PARSE_XML-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns14:Input>&#xa;            &lt;tns14:IDfile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/tns14:IDfile>&#xa;            &lt;xsl:if test=&quot;$ReadFileInfo/tns4:IdEsecProcsoFile&quot;>&#xa;                &lt;tns14:IdEsecProcsoFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IdEsecProcsoFile&quot;/>&#xa;                &lt;/tns14:IdEsecProcsoFile>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns14:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&#xa;            &lt;/tns14:NomeFile>&#xa;            &lt;tns14:FileFullName>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileFullName&quot;/>&#xa;            &lt;/tns14:FileFullName>&#xa;            &lt;tns14:FileSize>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:Size&quot;/>&#xa;            &lt;/tns14:FileSize>&#xa;            &lt;tns14:LocalPath>&#xa;                &lt;xsl:value-of select=&quot;$LocalPath&quot;/>&#xa;            &lt;/tns14:LocalPath>&#xa;            &lt;tns14:LogMessage>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Il file &amp;quot;, $ReadFileInfo/tns4:FileName, &amp;quot; non è valido.&amp;quot;)&quot;/>&#xa;            &lt;/tns14:LogMessage>&#xa;            &lt;tns14:ParentProcessInstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns14:ParentProcessInstanceID>&#xa;            &lt;tns14:Esito>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns14:Esito>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)&quot;>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOISP&quot;>&#xa;                        &lt;tns14:CodiceISP>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                        &lt;/tns14:CodiceISP>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodISP&quot;>&#xa;                        &lt;tns14:CodiceISP>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                        &lt;/tns14:CodiceISP>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&#xa;                    &lt;tns14:CodificaAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/tns14:CodificaAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns14:CodificaAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                    &lt;/tns14:CodificaAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns14:IDintrfc>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDintrfc&quot;/>&#xa;            &lt;/tns14:IDintrfc>&#xa;            &lt;tns14:IDtplg_file>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDtplg_file&quot;/>&#xa;            &lt;/tns14:IDtplg_file>&#xa;            &lt;tns14:DataFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;            &lt;/tns14:DataFile>&#xa;        &lt;/tns14:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.filemanager.acquisition.GenerateBadFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:exit name="Exit1" tibex:xpdlId="1b1b7268-69eb-430e-8e0e-f02e38c3b3c8">
                                    <bpws:targets>
                                    <bpws:target linkName="Bad_KO_PARSE_XMLToExit1"/>
                                    </bpws:targets>
                                </bpws:exit>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="LogErrorParse-input"
                                    name="LogErrorParse"
                                    tibex:xpdlId="86afbf86-7576-4edb-a61d-486273a87041" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:sources>
                                    <bpws:source linkName="LogToBad_KO_PARSE_XML"/>
                                    </bpws:sources>
