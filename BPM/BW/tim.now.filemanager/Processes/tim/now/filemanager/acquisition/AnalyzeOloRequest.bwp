                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value
                                    loggerName="/Log/LoggerName tim.now.filemanager.application"
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.example.org/GPONstart&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;ReadFileInfo&quot;/>&lt;xsl:param name=&quot;ControlliFormali&quot;/>&lt;xsl:param name=&quot;ControlloDate&quot;/>&lt;xsl:param name=&quot;Data&quot;/>&lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;Timezone&quot;/>&lt;xsl:param name=&quot;Accumulate2&quot;/>&lt;xsl:template name=&quot;CallSubProcGPON-input&quot; match=&quot;/&quot;>&lt;tns7:Element>&lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&lt;tns3:CodiciOlo>&lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&lt;/tns3:CodiciOlo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&lt;tns7:CodOLOdaNome>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&lt;/tns7:CodOLOdaNome>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns7:CodOLOdaNome>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&lt;/tns7:CodOLOdaNome>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ReadFileInfo/tns4:CodAGCOM)>0&quot;>&lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;>&lt;tns7:CodAGCOMint>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&lt;/tns7:CodAGCOMint>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;>&lt;tns7:CodAGCOMint>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&lt;/tns7:CodAGCOMint>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOISP&quot;>&lt;tns7:CodISPdaNome>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&lt;/tns7:CodISPdaNome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodISP&quot;>&lt;tns7:CodISPdaNome>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&lt;/tns7:CodISPdaNome>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns7:ID_FILE>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&lt;/tns7:ID_FILE>&lt;tns7:DATA_FILE>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&lt;/tns7:DATA_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&lt;tns7:NextWorkingDate>&lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&lt;/tns7:NextWorkingDate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns7:NextWorkingDate>&lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&lt;/tns7:NextWorkingDate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($getNextWorkingDay/parameters/tns5:Response/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&lt;tns7:NextWorkingDate>&lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns5:Response/tns5:outputDate&quot;/>&lt;/tns7:NextWorkingDate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns7:NextWorkingDate>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/tns7:NextWorkingDate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;RichiestaOAO>&lt;xsl:for-each select=&quot;$Accumulate2/RichiestaOAO&quot;>&lt;Richiesta>&lt;xsl:copy-of select=&quot;Richiesta[1]/Testata&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine)&quot;>&lt;Ordine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine/Attivazione)&quot;>&lt;Attivazione>&lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Attivazione/AccessoGPON&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine/Attivazione/GestioneAutonomaImpresa) or exists(Richiesta[1]/Ordine/Attivazione/GestioneAutonomaOperatore)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine/Attivazione/GestioneAutonomaImpresa)&quot;>&lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Attivazione/GestioneAutonomaImpresa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Attivazione/GestioneAutonomaOperatore&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;/xsl:choose>&lt;/Attivazione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Cessazione&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Ordine>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Richiesta[1]/CancellazioneAccodamento)&quot;>&lt;xsl:copy-of select=&quot;Richiesta/CancellazioneAccodamento&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Richiesta[1]/Annullamento)&quot;>&lt;xsl:copy-of select=&quot;Richiesta/Annullamento&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Richiesta[1]/RimodulazioneAppuntamento)&quot;>&lt;xsl:copy-of select=&quot;Richiesta[1]/RimodulazioneAppuntamento&quot;/>&lt;/xsl:when>&lt;xsl:when test=&quot;exists(Richiesta[1]/InterruzioneSospensione)&quot;>&lt;xsl:copy-of select=&quot;Richiesta[1]/InterruzioneSospensione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;Richiesta[1]/Comunicazione&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Richiesta>&lt;/xsl:for-each>&lt;/RichiestaOAO>&lt;tns7:NomeFile>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&lt;/tns7:NomeFile>&lt;/tns7:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CallSubProcGPON-input"
                    name="CallSubProcGPON"
                    outputVariable="CallSubProcGPON"
                    tibex:xpdlId="d98448fb-5aa8-43d5-8500-2bc4e5d80577"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToEmpty"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallSubProcGPONToAssign2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.example.org/GPONstart&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate2&quot;/>&#xa;    &lt;xsl:template name=&quot;CallSubProcGPON-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;tns7:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/tns7:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns7:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/tns7:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ReadFileInfo/tns4:CodAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;>&#xa;                        &lt;tns7:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                        &lt;/tns7:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;>&#xa;                        &lt;tns7:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                        &lt;/tns7:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOISP&quot;>&#xa;                        &lt;tns7:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                        &lt;/tns7:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodISP&quot;>&#xa;                        &lt;tns7:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                        &lt;/tns7:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns7:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/tns7:ID_FILE>&#xa;            &lt;tns7:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/tns7:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;tns7:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/tns7:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns7:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/tns7:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay.parameters/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;tns7:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns5:outputDate&quot;/>&#xa;                    &lt;/tns7:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns7:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/tns7:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;RichiestaOAO>&#xa;                &lt;xsl:for-each select=&quot;$Accumulate2/RichiestaOAO&quot;>&#xa;                    &lt;Richiesta>&#xa;                        &lt;xsl:copy-of select=&quot;Richiesta[1]/Testata&quot;/>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine)&quot;>&#xa;                                &lt;Ordine>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine/Attivazione)&quot;>&#xa;                                            &lt;Attivazione>&#xa;                                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Attivazione/AccessoGPON&quot;/>&#xa;                                                &lt;xsl:choose>&#xa;                                                    &lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine/Attivazione/GestioneAutonomaImpresa) or exists(Richiesta[1]/Ordine/Attivazione/GestioneAutonomaOperatore)&quot;>&#xa;                                                        &lt;xsl:choose>&#xa;                                                            &lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine/Attivazione/GestioneAutonomaImpresa)&quot;>&#xa;                                                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Attivazione/GestioneAutonomaImpresa&quot;/>&#xa;                                                            &lt;/xsl:when>&#xa;                                                            &lt;xsl:otherwise>&#xa;                                                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Attivazione/GestioneAutonomaOperatore&quot;/>&#xa;                                                            &lt;/xsl:otherwise>&#xa;                                                        &lt;/xsl:choose>&#xa;                                                    &lt;/xsl:when>&#xa;                                                &lt;/xsl:choose>&#xa;                                            &lt;/Attivazione>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine/Cessazione&quot;/>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/Ordine>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/CancellazioneAccodamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta/CancellazioneAccodamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/Annullamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta/Annullamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/RimodulazioneAppuntamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/RimodulazioneAppuntamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/InterruzioneSospensione)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/InterruzioneSospensione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Comunicazione&quot;/>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/RichiestaOAO>&#xa;            &lt;tns7:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&#xa;            &lt;/tns7:NomeFile>&#xa;        &lt;/tns7:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubProcGPON" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Log6-input"
                    name="Log6"
                    tibex:xpdlId="6744d528-d4c7-45ac-b41b-17c80e3ec12f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToLog6"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log6ToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;Log6-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto validato per FWA: &amp;#xD;&amp;#xA;&amp;quot;, tib:render-xml($ParseXmlFWA))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;FWA-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns3:ID_FILE>&#xa;            &lt;ns3:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/ns3:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0  and  $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay/parameters/tns5:Response/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns5:Response/tns5:outputDate&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns02:TracciatoOLOFWA>&#xa;                &lt;xsl:copy-of select=&quot;$ParseXmlFWA/ns02:Richiesta&quot;/>&#xa;            &lt;/ns02:TracciatoOLOFWA>&#xa;        &lt;/ns3:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FWA-input" name="FWA"
                    outputVariable="FWA"
                    tibex:xpdlId="1b0741e7-eb2c-464e-abab-34c68ac3eb36"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log6ToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/xsd/FWAstart&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlFWA&quot;/>&#xa;    &lt;xsl:template name=&quot;FWA-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns3:ID_FILE>&#xa;            &lt;ns3:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/ns3:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0  and  $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay.parameters/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns5:outputDate&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns02:TracciatoOLOFWA>&#xa;                &lt;xsl:copy-of select=&quot;$ParseXmlFWA/ns02:Richiesta&quot;/>&#xa;            &lt;/ns02:TracciatoOLOFWA>&#xa;        &lt;/ns3:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubProcFWA" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="ContatoriFWA" outputVariable="Contatori"
