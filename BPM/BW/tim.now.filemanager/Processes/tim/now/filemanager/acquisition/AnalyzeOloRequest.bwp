            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Group103N_NP-input"
                    name="Group103N_NP" outputVariable="Group103N_NP"
                    tibex:xpdlId="52f32aef-789b-484b-b4fd-0a1c2ae77621"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Log103N_NPToGroup103N_NP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Group103N_NPToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/xsd/103N_NP_start&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;Parse103NP_N&quot;/>&#xa;    &lt;xsl:template name=&quot;Group103N_NP-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:IDfile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns3:IDfile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&#xa;                    &lt;ns3:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ComunicazioneNP>&#xa;                &lt;xsl:for-each select=&quot;$Parse103NP_N/ComunicazioneNP/Richiesta&quot;>&#xa;                    &lt;ns3:Richiesta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(Portin)&quot;>&#xa;                                &lt;ns3:Portin>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:TipoLinea>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/TipoLinea&quot;/>&#xa;                                    &lt;/ns3:TipoLinea>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;xsl:if test=&quot;Portin/NomeCliente&quot;>&#xa;                                        &lt;ns3:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/NomeCliente&quot;/>&#xa;                                        &lt;/ns3:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns3:CognomeCliente_RagioneSociale>&#xa;                                    &lt;xsl:for-each select=&quot;Portin/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Portin/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns3:CodiceSegreto>&#xa;                                    &lt;ns3:RoutingNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/RoutingNumber&quot;/>&#xa;                                    &lt;/ns3:RoutingNumber>&#xa;                                &lt;/ns3:Portin>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Prenotifica_Donating)&quot;>&#xa;                                &lt;ns3:Prenotifica_Donating>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:TipoLinea>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/TipoLinea&quot;/>&#xa;                                    &lt;/ns3:TipoLinea>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/NomeCliente&quot;>&#xa;                                        &lt;ns3:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/NomeCliente&quot;/>&#xa;                                        &lt;/ns3:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns3:CognomeCliente_RagioneSociale>&#xa;                                    &lt;xsl:for-each select=&quot;Prenotifica_Donating/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns3:CodiceSegreto>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonating>&#xa;                                &lt;/ns3:Prenotifica_Donating>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Cessazione)&quot;>&#xa;                                &lt;ns3:Cessazione>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                &lt;/ns3:Cessazione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Annullamento)&quot;>&#xa;                                &lt;ns3:Annullamento>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;xsl:for-each select=&quot;Annullamento/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/ns3:Annullamento>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Rimodulazione_DAC)&quot;>&#xa;                                &lt;ns3:Rimodulazione_DAC>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:TipoLinea>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/TipoLinea&quot;/>&#xa;                                    &lt;/ns3:TipoLinea>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Rimodulazione_DAC/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Rimodulazione_DAC/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:DataAttesaConsegnaRimodulata>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC/DataAttesaConsegnaRimodulata&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaRimodulata>&#xa;                                    &lt;xsl:for-each select=&quot;Rimodulazione_DAC/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns3:Rimodulazione_DAC>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns3:Rimodulazione_DAC_Recipient>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC_Recipient/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC_Recipient/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC_Recipient/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC_Recipient/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;ns3:DataAttesaConsegnaRimodulata>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC_Recipient/DataAttesaConsegnaRimodulata&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaRimodulata>&#xa;                                    &lt;xsl:if test=&quot;Rimodulazione_DAC_Recipient/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Rimodulazione_DAC_Recipient/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:for-each select=&quot;Rimodulazione_DAC_Recipient/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Rimodulazione_DAC_Recipient/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                &lt;/ns3:Rimodulazione_DAC_Recipient>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns3:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns3:ComunicazioneNP>&#xa;            &lt;ns3:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&#xa;            &lt;/ns3:NomeFile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;ns3:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/ns3:CodIspIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/ns3:CodIspIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:Progressivi/>&#xa;            &lt;xsl:if test=&quot;exists($ReadFileInfo/tns4:TimestampAperturaFile)&quot;>&#xa;                &lt;ns3:TimstpAperturaFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:TimestampAperturaFile&quot;/>&#xa;                &lt;/ns3:TimstpAperturaFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.Group103N_NP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
