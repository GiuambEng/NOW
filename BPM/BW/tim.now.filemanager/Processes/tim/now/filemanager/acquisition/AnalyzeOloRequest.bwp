lt;/tns11:ContatoreNOW>&lt;tns11:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreKO+$R_NP_SUBPROCESS/ns:contatoreKO)&quot;/>&lt;/tns11:ContatoreKO>&lt;/tns11:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
