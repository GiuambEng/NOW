            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns14=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;xDSL_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns14:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;tns14:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/tns14:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns14:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/tns14:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ReadFileInfo/tns4:CodAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;>&#xa;                        &lt;tns14:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                        &lt;/tns14:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;>&#xa;                        &lt;tns14:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                        &lt;/tns14:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns14:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/tns14:ID_FILE>&#xa;            &lt;tns14:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/tns14:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0  and  $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;tns14:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/tns14:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns14:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/tns14:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay/parameters/tns5:Response/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;tns14:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns5:Response/tns5:outputDate&quot;/>&#xa;                    &lt;/tns14:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns14:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/tns14:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns01:Richiesta&quot;>&#xa;                &lt;tns14:ContenutoXml>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml(.)&quot;/>&#xa;                &lt;/tns14:ContenutoXml>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;ns01:TracciatoOLOxDSL>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns01:Richiesta&quot;>&#xa;                    &lt;ns01:Richiesta>&#xa;                        &lt;ns01:Testata>&#xa;                            &lt;ns01:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                            &lt;/ns01:CodiceOlo>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                                &lt;ns01:CodiceOrdineOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/ns01:CodiceOrdineOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                                &lt;ns01:CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/ns01:CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                                &lt;ns01:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceProgetto&quot;/>&#xa;                                &lt;/ns01:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:Note&quot;>&#xa;                                &lt;ns01:Note>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:Note&quot;/>&#xa;                                &lt;/ns01:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:TestMode&quot;>&#xa;                                &lt;ns01:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:TestMode&quot;/>&#xa;                                &lt;/ns01:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;>&#xa;                                &lt;ns01:ReferentiOAOProgettiSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                                &lt;/ns01:ReferentiOAOProgettiSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns01:Testata>&#xa;                        &lt;xsl:copy-of select=&quot;ns01:TipoRichiesta&quot;/>&#xa;                    &lt;/ns01:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns01:TracciatoOLOxDSL>&#xa;        &lt;/tns14:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="xDSL_SUBPROCESS-input"
                    name="xDSL_SUBPROCESS"
                    outputVariable="xDSL_SUBPROCESS"
                    tibex:xpdlId="ef312555-1202-4a8a-9323-192d491e6aff"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogXdslToADD_xDSL_NOW_COUNTER"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToADD_xDSL_NOW_COUNTER"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns14=&quot;http://www.example.com/namespaces/tns/1465216469702&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:template name=&quot;xDSL_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns14:Element>&#xa;            &lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&#xa;                &lt;tns3:CodiciOlo>&#xa;                    &lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&#xa;                &lt;/tns3:CodiciOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;tns14:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/tns14:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns14:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/tns14:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ReadFileInfo/tns4:CodAGCOM)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;>&#xa;                        &lt;tns14:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                        &lt;/tns14:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;>&#xa;                        &lt;tns14:CodAGCOMint>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                        &lt;/tns14:CodAGCOMint>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns14:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/tns14:ID_FILE>&#xa;            &lt;tns14:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/tns14:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0  and  $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;tns14:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/tns14:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns14:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/tns14:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay.parameters/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;tns14:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns5:outputDate&quot;/>&#xa;                    &lt;/tns14:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns14:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/tns14:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns01:Richiesta&quot;>&#xa;                &lt;tns14:ContenutoXml>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml(.)&quot;/>&#xa;                &lt;/tns14:ContenutoXml>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;ns01:TracciatoOLOxDSL>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlxDSL/ns01:Richiesta&quot;>&#xa;                    &lt;ns01:Richiesta>&#xa;                        &lt;ns01:Testata>&#xa;                            &lt;ns01:CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&#xa;                            &lt;/ns01:CodiceOlo>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;>&#xa;                                &lt;ns01:CodiceOrdineOlo>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOlo&quot;/>&#xa;                                &lt;/ns01:CodiceOrdineOlo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;>&#xa;                                &lt;ns01:CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/ns01:CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:CodiceProgetto&quot;>&#xa;                                &lt;ns01:CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceProgetto&quot;/>&#xa;                                &lt;/ns01:CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:Note&quot;>&#xa;                                &lt;ns01:Note>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:Note&quot;/>&#xa;                                &lt;/ns01:Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:TestMode&quot;>&#xa;                                &lt;ns01:TestMode>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:TestMode&quot;/>&#xa;                                &lt;/ns01:TestMode>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;>&#xa;                                &lt;ns01:ReferentiOAOProgettiSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;ns01:Testata/ns01:ReferentiOAOProgettiSpeciali&quot;/>&#xa;                                &lt;/ns01:ReferentiOAOProgettiSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/ns01:Testata>&#xa;                        &lt;xsl:copy-of select=&quot;ns01:TipoRichiesta&quot;/>&#xa;                    &lt;/ns01:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns01:TracciatoOLOxDSL>&#xa;        &lt;/tns14:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubprocXDSL_NEW" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LocalPath"
                    name="BuildPath" outputVariable="LocalPath"
                    tibex:xpdlId="c7cb7c80-8661-4c80-9df4-4fcb8e865d75" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToBuildPath"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogFileInformation"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(string-length($ReadFileInfo/ns124:CodAGCOM)>0) then (&#xd;&#xa;&#xd;&#xa;&#x9;if (ends-with(substring-before($ReadFileInfo/ns124:FileName,'.xml'),$NPNGSuff)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$NPNGFolder)) else (&#xd;&#xa;&#xd;&#xa;&#x9;if (starts-with($ReadFileInfo/ns124:FileName,$NGAPref)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$NGAfolder)) else (&#xd;&#xa;&#x9;&#xd;&#xa;&#x9;if (starts-with($ReadFileInfo/ns124:FileName,$FWAPref)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$FWAFolder)) else (&#xd;&#xa;&#x9;&#xd;&#xa;&#x9;if (starts-with($ReadFileInfo/ns124:FileName,$GPONPref) or starts-with($ReadFileInfo/ns124:FileName,$NEWGPONPref)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$GPONFolder)) else (&#xd;&#xa;&#x9;if(starts-with($ReadFileInfo/ns124:FileName,$ADSLPref)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$XDSLfolder)) else(&#xd;&#xa;&#x9;if (starts-with($ReadFileInfo/ns124:FileName,$FIBERSTREAMPref)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$FIBERSTREAMFolder)) else (&#xd;&#xa;&#x9;if(starts-with($ReadFileInfo/ns124:FileName,$N_NP_pref) or starts-with($ReadFileInfo/ns124:FileName,concat($T3_pref,$N_NP_pref))) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$N_NPfolder)) else(&#xd;&#xa;&#x9;if(starts-with($ReadFileInfo/ns124:FileName,$R_NP_pref) or starts-with($ReadFileInfo/ns124:FileName,concat($T3_pref,$R_NP_pref))) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$R_NPfolder)) else(&#xd;&#xa;&#x9;if(starts-with($ReadFileInfo/ns124:FileName,$Del103N_NP_pref) or starts-with($ReadFileInfo/ns124:FileName,$Del103R_NP_pref)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$Del103Folder)) else(&#xd;&#xa;&#x9;if (starts-with($ReadFileInfo/ns124:FileName,$SDT_pref)) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$SDT_folder)) else (&#xd;&#xa;&#x9;if ($ReadFileInfo/ns124:IDintrfc=$IdInterfacciaCPS) then (concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$CPSfolder)) else concat($AcquisitionFolder,$ReadFileInfo/ns124:CodAGCOM,$REGfolder))))))))))))&#xd;&#xa;&#xd;&#xa;else (substring-before($ReadFileInfo/ns124:FileFullName,$ReadFileInfo/ns124:FileName))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="LocalPath" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogN_NP-input"
                    name="LogN_NP"
                    tibex:xpdlId="b2ea7611-c764-41e3-8342-8070748fd7bd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToLog1_NNP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogN_NPToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlN_NP&quot;/>&#xa;    &lt;xsl:template name=&quot;Log1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto validato per N_NP: &amp;#xD;&amp;#xA;&amp;quot;,tib:render-xml($ParseXmlN_NP))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Debug"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="N_NP_SUBPROCESS-input"
                    name="N_NP_SUBPROCESS"
                    outputVariable="N_NP_SUBPROCESS"
                    tibex:xpdlId="f89d258e-cac7-4678-838f-9573de6de2bd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogN_NPToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="N_NP_SUBPROCESSToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/xsd/N_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlN_NP&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;N_NP_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Input>&#xa;            &lt;ns3:IDfile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns3:IDfile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&#xa;                    &lt;ns3:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ComunicazioneNP>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlN_NP/Richiesta&quot;>&#xa;                    &lt;ns3:Richiesta>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(Portin)&quot;>&#xa;                                &lt;ns3:Portin>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Portin/TipoLinea&quot;>&#xa;                                        &lt;ns3:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/TipoLinea&quot;/>&#xa;                                        &lt;/ns3:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Portin/Note&quot;>&#xa;                                        &lt;ns3:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/Note&quot;/>&#xa;                                        &lt;/ns3:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:if test=&quot;Portin/NomeCliente&quot;>&#xa;                                        &lt;ns3:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/NomeCliente&quot;/>&#xa;                                        &lt;/ns3:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns3:CognomeCliente_RagioneSociale>&#xa;                                    &lt;ns3:TelefonoReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/TelefonoReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns3:TelefonoReferenteRichiedente>&#xa;                                    &lt;ns3:EmailReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/EmailReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns3:EmailReferenteRichiedente>&#xa;                                    &lt;xsl:for-each select=&quot;Portin/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Portin/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Portin/FlagNPNumerazioniAggiuntive&quot;>&#xa;                                        &lt;ns3:FlagNPNumerazioniAggiuntive>&#xa;                                            &lt;xsl:value-of select=&quot;Portin/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                        &lt;/ns3:FlagNPNumerazioniAggiuntive>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns3:CodiceSegreto>&#xa;                                    &lt;ns3:RoutingNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Portin/RoutingNumber&quot;/>&#xa;                                    &lt;/ns3:RoutingNumber>&#xa;                                &lt;/ns3:Portin>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Prenotifica_Donating)&quot;>&#xa;                                &lt;ns3:Prenotifica_Donating>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/TipoLinea&quot;>&#xa;                                        &lt;ns3:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/TipoLinea&quot;/>&#xa;                                        &lt;/ns3:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/Note&quot;>&#xa;                                        &lt;ns3:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/Note&quot;/>&#xa;                                        &lt;/ns3:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/NomeCliente&quot;>&#xa;                                        &lt;ns3:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/NomeCliente&quot;/>&#xa;                                        &lt;/ns3:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns3:CognomeCliente_RagioneSociale>&#xa;                                    &lt;ns3:TelefonoReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/TelefonoReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns3:TelefonoReferenteRichiedente>&#xa;                                    &lt;ns3:EmailReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/EmailReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns3:EmailReferenteRichiedente>&#xa;                                    &lt;xsl:for-each select=&quot;Prenotifica_Donating/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Prenotifica_Donating/FlagNPNumerazioniAggiuntive&quot;>&#xa;                                        &lt;ns3:FlagNPNumerazioniAggiuntive>&#xa;                                            &lt;xsl:value-of select=&quot;Prenotifica_Donating/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                        &lt;/ns3:FlagNPNumerazioniAggiuntive>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns3:CodiceSegreto>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Prenotifica_Donating/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:for-each select=&quot;Prenotifica_Donating/NPAggiuntive&quot;>&#xa;                                        &lt;ns3:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns3:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns3:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns3:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns3:Prenotifica_Donating>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Cessazione)&quot;>&#xa;                                &lt;ns3:Cessazione>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Cessazione/TipoLinea&quot;>&#xa;                                        &lt;ns3:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Cessazione/TipoLinea&quot;/>&#xa;                                        &lt;/ns3:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Cessazione/Note&quot;>&#xa;                                        &lt;ns3:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Cessazione/Note&quot;/>&#xa;                                        &lt;/ns3:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:for-each select=&quot;Cessazione/Rientro&quot;>&#xa;                                        &lt;ns3:Rientro>&#xa;                                            &lt;ns3:RientroTI>&#xa;                                                &lt;xsl:value-of select=&quot;RientroTI&quot;/>&#xa;                                            &lt;/ns3:RientroTI>&#xa;                                            &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                &lt;ns3:NomeCliente>&#xa;                                                    &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                &lt;/ns3:NomeCliente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns3:CognomeCliente_RagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                            &lt;/ns3:CognomeCliente_RagioneSociale>&#xa;                                            &lt;ns3:TelefonoReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns3:TelefonoReferenteRichiedente>&#xa;                                            &lt;ns3:EmailReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns3:EmailReferenteRichiedente>&#xa;                                            &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                &lt;ns3:Correlazioni>&#xa;                                                    &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                        &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                    &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                                    &lt;ns3:TotaleRichieste>&#xa;                                                        &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                    &lt;/ns3:TotaleRichieste>&#xa;                                                &lt;/ns3:Correlazioni>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns3:Rientro>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Cessazione/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonating>&#xa;                                    &lt;xsl:for-each select=&quot;Cessazione/NPAggiuntive&quot;>&#xa;                                        &lt;ns3:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns3:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns3:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns3:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns3:Cessazione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;ns3:Annullamento>&#xa;                                    &lt;ns3:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns3:TipoComunicazione>&#xa;                                    &lt;ns3:CodiceOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceOrdine&quot;/>&#xa;                                    &lt;/ns3:CodiceOrdine>&#xa;                                    &lt;ns3:DataOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DataOrdine&quot;/>&#xa;                                    &lt;/ns3:DataOrdine>&#xa;                                    &lt;ns3:DirectoryNumber>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DirectoryNumber&quot;/>&#xa;                                    &lt;/ns3:DirectoryNumber>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/TipoLinea&quot;>&#xa;                                        &lt;ns3:TipoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/TipoLinea&quot;/>&#xa;                                        &lt;/ns3:TipoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/Note&quot;>&#xa;                                        &lt;ns3:Note>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/Note&quot;/>&#xa;                                        &lt;/ns3:Note>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:DataInvioMessaggio>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DataInvioMessaggio&quot;/>&#xa;                                    &lt;/ns3:DataInvioMessaggio>&#xa;                                    &lt;ns3:IdentificativoOperatoreDonor>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/IdentificativoOperatoreDonor&quot;/>&#xa;                                    &lt;/ns3:IdentificativoOperatoreDonor>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/NomeCliente&quot;>&#xa;                                        &lt;ns3:NomeCliente>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/NomeCliente&quot;/>&#xa;                                        &lt;/ns3:NomeCliente>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CognomeCliente_RagioneSociale>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CognomeCliente_RagioneSociale&quot;/>&#xa;                                    &lt;/ns3:CognomeCliente_RagioneSociale>&#xa;                                    &lt;ns3:TelefonoReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/TelefonoReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns3:TelefonoReferenteRichiedente>&#xa;                                    &lt;ns3:EmailReferenteRichiedente>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/EmailReferenteRichiedente&quot;/>&#xa;                                    &lt;/ns3:EmailReferenteRichiedente>&#xa;                                    &lt;xsl:for-each select=&quot;Annullamento/Correlazioni&quot;>&#xa;                                        &lt;ns3:Correlazioni>&#xa;                                            &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                            &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                            &lt;ns3:TotaleRichieste>&#xa;                                                &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                            &lt;/ns3:TotaleRichieste>&#xa;                                        &lt;/ns3:Correlazioni>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns3:CodiceOpRecipient>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceOpRecipient&quot;/>&#xa;                                    &lt;/ns3:CodiceOpRecipient>&#xa;                                    &lt;ns3:DataAttesaConsegnaServizio>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/DataAttesaConsegnaServizio&quot;/>&#xa;                                    &lt;/ns3:DataAttesaConsegnaServizio>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/CodiceProgetto&quot;>&#xa;                                        &lt;ns3:CodiceProgetto>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/CodiceProgetto&quot;/>&#xa;                                        &lt;/ns3:CodiceProgetto>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;Annullamento/FlagNPNumerazioniAggiuntive&quot;>&#xa;                                        &lt;ns3:FlagNPNumerazioniAggiuntive>&#xa;                                            &lt;xsl:value-of select=&quot;Annullamento/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                        &lt;/ns3:FlagNPNumerazioniAggiuntive>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;ns3:CodiceSegreto>&#xa;                                        &lt;xsl:value-of select=&quot;Annullamento/CodiceSegreto&quot;/>&#xa;                                    &lt;/ns3:CodiceSegreto>&#xa;                                    &lt;xsl:for-each select=&quot;Annullamento/NPAggiuntive&quot;>&#xa;                                        &lt;ns3:NPAggiuntive>&#xa;                                            &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                &lt;ns3:NumAggiuntivaPortata>&#xa;                                                    &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                &lt;/ns3:NumAggiuntivaPortata>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns3:NPAggiuntive>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns3:Annullamento>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ns3:Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/ns3:ComunicazioneNP>&#xa;            &lt;ns3:NomeFile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&#xa;            &lt;/ns3:NomeFile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;ns3:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/ns3:CodIspIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodIspIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                    &lt;/ns3:CodIspIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:Progressivi/>&#xa;            &lt;xsl:if test=&quot;count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1'&quot;>&#xa;                &lt;ns3:FlagOscuramento>&#xa;                    &lt;xsl:value-of select=&quot;'1'&quot;/>&#xa;                &lt;/ns3:FlagOscuramento>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ReadFileInfo/tns4:TimestampAperturaFile)&quot;>&#xa;                &lt;ns3:TimstpAperturaFile>&#xa;                    &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:TimestampAperturaFile&quot;/>&#xa;                &lt;/ns3:TimstpAperturaFile>&#xa;            &lt;/xsl:if>&#xa;        &lt;/ns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.GroupN_NP" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="ContatoriN_NP" outputVariable="Contatori"
                    tibex:xpdlId="e351a163-9b2e-4671-a215-a915e74c521e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="N_NP_SUBPROCESSToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ContatoriN_NPToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns11=&quot;http://www.example.org/ListaContatori&quot; xmlns:tns13=&quot;http://www.tim.com/NOW/xsd/N_NP_end&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;N_NP_SUBPROCESS&quot;/>&lt;xsl:template name=&quot;Contatori&quot; match=&quot;/&quot;>&lt;tns11:Contatori>&lt;tns11:StringaCRMWS>&lt;xsl:value-of select=&quot;concat($Contatori/tns11:StringaCRMWS,$N_NP_SUBPROCESS/tns13:stringaCRMWS)&quot;/>&lt;/tns11:StringaCRMWS>&lt;xsl:if test=&quot;$Contatori/tns11:StringaWSDP&quot;>&lt;tns11:StringaWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns11:StringaWSDP&quot;/>&lt;/tns11:StringaWSDP>&lt;/xsl:if>&lt;tns11:StringaSDR>&lt;xsl:value-of select=&quot;concat($Contatori/tns11:StringaSDR,$N_NP_SUBPROCESS/tns13:stringaSDR)&quot;/>&lt;/tns11:StringaSDR>&lt;tns11:StringaDBCFX>&lt;xsl:value-of select=&quot;concat($Contatori/tns11:StringaDBCFX,$N_NP_SUBPROCESS/tns13:stringaDBCFX)&quot;/>&lt;/tns11:StringaDBCFX>&lt;tns11:ContatoreCRMWS>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreCRMWS+$N_NP_SUBPROCESS/tns13:contatoreCRMWS)&quot;/>&lt;/tns11:ContatoreCRMWS>&lt;xsl:if test=&quot;$Contatori/tns11:ContatoreWSDP&quot;>&lt;tns11:ContatoreWSDP>&lt;xsl:value-of select=&quot;$Contatori/tns11:ContatoreWSDP&quot;/>&lt;/tns11:ContatoreWSDP>&lt;/xsl:if>&lt;tns11:ContatoreSDR>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreSDR+$N_NP_SUBPROCESS/tns13:contatoreSDR)&quot;/>&lt;/tns11:ContatoreSDR>&lt;tns11:ContatoreDBCFX>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreDBCFX+$N_NP_SUBPROCESS/tns13:contatoreDBCFX)&quot;/>&lt;/tns11:ContatoreDBCFX>&lt;tns11:ContatoreNOW>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreNOW+$N_NP_SUBPROCESS/tns13:contatoreNOW)&quot;/>&lt;/tns11:ContatoreNOW>&lt;tns11:ContatoreKO>&lt;xsl:value-of select=&quot;xsd:int($Contatori/tns11:ContatoreKO+$N_NP_SUBPROCESS/tns13:contatoreKO)&quot;/>&lt;/tns11:ContatoreKO>&lt;/tns11:Contatori>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Contatori" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="EstrazioneOLO-input"
                    name="EstrazioneOLO" outputVariable="EstrazioneOLO"
                    tibex:xpdlId="c023e765-270b-48a1-bf91-c20594f8cc32"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CodiciAssignToSelectCodiciOLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EstrazioneOLToAssignCoppiaCodiciOLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$CodiciOlo&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.EstrazioneOLO" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogR_NP-input"
                    name="LogR_NP"
                    tibex:xpdlId="550d9474-d736-4d37-8c36-2419ead2b8b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToLog11_RNP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogR_NPToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlR_NP&quot;/>&#xa;    &lt;xsl:template name=&quot;LogR_NP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto validato per R_NP: &amp;#xD;&amp;#xA;&amp;quot;,tib:render-xml($ParseXmlR_NP))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Debug"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="R_NP_SUBPROCESS-input"
                    name="R_NP_SUBPROCESS"
                    outputVariable="R_NP_SUBPROCESS"
                    tibex:xpdlId="f8a15876-6e91-427b-981b-6faba7af9f1d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogR_NPToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="R_NP_SUBPROCESSToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/R_NP_start&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlR_NP&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;R_NP_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:IDfile>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns:IDfile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&#xa;                    &lt;ns:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/ns:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns:CodOloAgcomIntrfc>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                    &lt;/ns:CodOloAgcomIntrfc>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns:ComunicazioneNP>&#xa;                &lt;xsl:for-each select=&quot;$ParseXmlR_NP/ComunicazioneNP/Risposta&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists(Valid_Formale_DonorRecipient)&quot;>&#xa;                            &lt;ns:Risposta>&#xa;                                &lt;ns:Valid_Formale_DonorRecipient>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_DonorRecipient/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_DonorRecipient/DatiNotifica&quot;>&#xa;                                        &lt;ns:DatiNotifica>&#xa;                                            &lt;ns:CodiceOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOrdine&quot;/>&#xa;                                            &lt;/ns:CodiceOrdine>&#xa;                                            &lt;ns:DataOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;DataOrdine&quot;/>&#xa;                                            &lt;/ns:DataOrdine>&#xa;                                            &lt;ns:DirectoryNumber>&#xa;                                                &lt;xsl:value-of select=&quot;DirectoryNumber&quot;/>&#xa;                                            &lt;/ns:DirectoryNumber>&#xa;                                            &lt;ns:IdentificativoOperatoreDonor>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoOperatoreDonor&quot;/>&#xa;                                            &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                            &lt;ns:DataInvioMessaggio>&#xa;                                                &lt;xsl:value-of select=&quot;DataInvioMessaggio&quot;/>&#xa;                                            &lt;/ns:DataInvioMessaggio>&#xa;                                            &lt;xsl:if test=&quot;Note&quot;>&#xa;                                                &lt;ns:Note>&#xa;                                                    &lt;xsl:value-of select=&quot;Note&quot;/>&#xa;                                                &lt;/ns:Note>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:CodiceOpRecipient>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOpRecipient&quot;/>&#xa;                                            &lt;/ns:CodiceOpRecipient>&#xa;                                            &lt;ns:CodiceSegreto>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceSegreto&quot;/>&#xa;                                            &lt;/ns:CodiceSegreto>&#xa;                                            &lt;xsl:for-each select=&quot;TipoLinea&quot;>&#xa;                                                &lt;ns:TipoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;exists(ISDN)&quot;>&#xa;                                                            &lt;ns:ISDN>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                                &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                                                &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                &lt;xsl:for-each select=&quot;ISDN/NPAggiuntive&quot;>&#xa;                                                                    &lt;ns:NPAggiuntive>&#xa;                                                                        &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                                            &lt;ns:NumAggiuntivaPortata>&#xa;                                                                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                                            &lt;/ns:NumAggiuntivaPortata>&#xa;                                                                        &lt;/xsl:for-each>&#xa;                                                                    &lt;/ns:NPAggiuntive>&#xa;                                                                &lt;/xsl:for-each>&#xa;                                                            &lt;/ns:ISDN>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns:GNR>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;GNR/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                            &lt;/ns:GNR>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns:TipoLinea>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                            &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                            &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                            &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                            &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                &lt;ns:NomeCliente>&#xa;                                                    &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                &lt;/ns:NomeCliente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;CodiceProgetto&quot;>&#xa;                                                &lt;ns:CodiceProgetto>&#xa;                                                    &lt;xsl:value-of select=&quot;CodiceProgetto&quot;/>&#xa;                                                &lt;/ns:CodiceProgetto>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:EmailReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:EmailReferenteRichiedente>&#xa;                                            &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                            &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                &lt;ns:Correlazioni>&#xa;                                                    &lt;ns:IdentificativoCorrelazioni>&#xa;                                                        &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                    &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                    &lt;ns:TotaleRichieste>&#xa;                                                        &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                    &lt;/ns:TotaleRichieste>&#xa;                                                &lt;/ns:Correlazioni>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:DatiNotifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_DonorRecipient/EsitoVerifica&quot;>&#xa;                                        &lt;ns:EsitoVerifica>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;exists(EsitoKO)&quot;>&#xa;                                                    &lt;ns:EsitoKO>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns:CodiceMotivoRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/CodiceMotivoRifiuto&quot;/>&#xa;                                                        &lt;/ns:CodiceMotivoRifiuto>&#xa;                                                        &lt;ns:DescrizioneRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/DescrizioneRifiuto&quot;/>&#xa;                                                        &lt;/ns:DescrizioneRifiuto>&#xa;                                                    &lt;/ns:EsitoKO>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;ns:EsitoOK>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoOK/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns:IdentificativoOperatoreDonating>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoOK/IdentificativoOperatoreDonating&quot;/>&#xa;                                                        &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                                    &lt;/ns:EsitoOK>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/ns:EsitoVerifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns:Valid_Formale_DonorRecipient>&#xa;                            &lt;/ns:Risposta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists(Valid_Formale_Donating_Donor)&quot;>&#xa;                            &lt;ns:Risposta>&#xa;                                &lt;ns:Valid_Formale_Donating_Donor>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Donating_Donor/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_Donating_Donor/DatiNotifica&quot;>&#xa;                                        &lt;ns:DatiNotifica>&#xa;                                            &lt;ns:CodiceOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOrdine&quot;/>&#xa;                                            &lt;/ns:CodiceOrdine>&#xa;                                            &lt;ns:DataOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;DataOrdine&quot;/>&#xa;                                            &lt;/ns:DataOrdine>&#xa;                                            &lt;ns:DirectoryNumber>&#xa;                                                &lt;xsl:value-of select=&quot;DirectoryNumber&quot;/>&#xa;                                            &lt;/ns:DirectoryNumber>&#xa;                                            &lt;ns:IdentificativoOperatoreDonor>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoOperatoreDonor&quot;/>&#xa;                                            &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                            &lt;ns:DataInvioMessaggio>&#xa;                                                &lt;xsl:value-of select=&quot;DataInvioMessaggio&quot;/>&#xa;                                            &lt;/ns:DataInvioMessaggio>&#xa;                                            &lt;xsl:if test=&quot;Note&quot;>&#xa;                                                &lt;ns:Note>&#xa;                                                    &lt;xsl:value-of select=&quot;Note&quot;/>&#xa;                                                &lt;/ns:Note>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:CodiceOpRecipient>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOpRecipient&quot;/>&#xa;                                            &lt;/ns:CodiceOpRecipient>&#xa;                                            &lt;ns:CodiceSegreto>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceSegreto&quot;/>&#xa;                                            &lt;/ns:CodiceSegreto>&#xa;                                            &lt;xsl:for-each select=&quot;TipoLinea&quot;>&#xa;                                                &lt;ns:TipoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;exists(ISDN)&quot;>&#xa;                                                            &lt;ns:ISDN>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                                &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                                                &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                &lt;xsl:for-each select=&quot;ISDN/NPAggiuntive&quot;>&#xa;                                                                    &lt;ns:NPAggiuntive>&#xa;                                                                        &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                                            &lt;ns:NumAggiuntivaPortata>&#xa;                                                                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                                            &lt;/ns:NumAggiuntivaPortata>&#xa;                                                                        &lt;/xsl:for-each>&#xa;                                                                    &lt;/ns:NPAggiuntive>&#xa;                                                                &lt;/xsl:for-each>&#xa;                                                            &lt;/ns:ISDN>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns:GNR>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;GNR/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                            &lt;/ns:GNR>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns:TipoLinea>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                            &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                            &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                            &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                            &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                &lt;ns:NomeCliente>&#xa;                                                    &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                &lt;/ns:NomeCliente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;CodiceProgetto&quot;>&#xa;                                                &lt;ns:CodiceProgetto>&#xa;                                                    &lt;xsl:value-of select=&quot;CodiceProgetto&quot;/>&#xa;                                                &lt;/ns:CodiceProgetto>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:EmailReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:EmailReferenteRichiedente>&#xa;                                            &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                            &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                &lt;ns:Correlazioni>&#xa;                                                    &lt;ns:IdentificativoCorrelazioni>&#xa;                                                        &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                    &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                    &lt;ns:TotaleRichieste>&#xa;                                                        &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                    &lt;/ns:TotaleRichieste>&#xa;                                                &lt;/ns:Correlazioni>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:DatiNotifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Formale_Donating_Donor/IdentificativoOperatoreDonating&quot;/>&#xa;                                    &lt;/ns:IdentificativoOperatoreDonating>&#xa;                                    &lt;ns:EsitoVerifica>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists(Valid_Formale_Donating_Donor/EsitoVerifica/EsitoKO)&quot;>&#xa;                                                &lt;ns:EsitoKO>&#xa;                                                    &lt;ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;xsl:value-of select=&quot;Valid_Formale_Donating_Donor/EsitoVerifica/EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                    &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                    &lt;ns:CodiceMotivoRifiuto>&#xa;                                                        &lt;xsl:value-of select=&quot;Valid_Formale_Donating_Donor/EsitoVerifica/EsitoKO/CodiceMotivoRifiuto&quot;/>&#xa;                                                    &lt;/ns:CodiceMotivoRifiuto>&#xa;                                                    &lt;ns:DescrizioneRifiuto>&#xa;                                                        &lt;xsl:value-of select=&quot;Valid_Formale_Donating_Donor/EsitoVerifica/EsitoKO/DescrizioneRifiuto&quot;/>&#xa;                                                    &lt;/ns:DescrizioneRifiuto>&#xa;                                                &lt;/ns:EsitoKO>&#xa;                                            &lt;/xsl:when>&#xa;                                            &lt;xsl:otherwise>&#xa;                                                &lt;ns:EsitoOK>&#xa;                                                    &lt;ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;xsl:value-of select=&quot;Valid_Formale_Donating_Donor/EsitoVerifica/EsitoOK/EsitoVerificaRichiesta&quot;/>&#xa;                                                    &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                &lt;/ns:EsitoOK>&#xa;                                            &lt;/xsl:otherwise>&#xa;                                        &lt;/xsl:choose>&#xa;                                    &lt;/ns:EsitoVerifica>&#xa;                                &lt;/ns:Valid_Formale_Donating_Donor>&#xa;                            &lt;/ns:Risposta>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists(Valid_Tecnica_Donating_Donor)&quot;>&#xa;                            &lt;ns:Risposta>&#xa;                                &lt;ns:Valid_Tecnica_Donating_Donor>&#xa;                                    &lt;ns:TipoComunicazione>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Donating_Donor/TipoComunicazione&quot;/>&#xa;                                    &lt;/ns:TipoComunicazione>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Tecnica_Donating_Donor/DatiNotifica&quot;>&#xa;                                        &lt;ns:DatiNotifica>&#xa;                                            &lt;ns:CodiceOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOrdine&quot;/>&#xa;                                            &lt;/ns:CodiceOrdine>&#xa;                                            &lt;ns:DataOrdine>&#xa;                                                &lt;xsl:value-of select=&quot;DataOrdine&quot;/>&#xa;                                            &lt;/ns:DataOrdine>&#xa;                                            &lt;ns:DirectoryNumber>&#xa;                                                &lt;xsl:value-of select=&quot;DirectoryNumber&quot;/>&#xa;                                            &lt;/ns:DirectoryNumber>&#xa;                                            &lt;ns:IdentificativoOperatoreDonor>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoOperatoreDonor&quot;/>&#xa;                                            &lt;/ns:IdentificativoOperatoreDonor>&#xa;                                            &lt;ns:DataInvioMessaggio>&#xa;                                                &lt;xsl:value-of select=&quot;DataInvioMessaggio&quot;/>&#xa;                                            &lt;/ns:DataInvioMessaggio>&#xa;                                            &lt;xsl:if test=&quot;Note&quot;>&#xa;                                                &lt;ns:Note>&#xa;                                                    &lt;xsl:value-of select=&quot;Note&quot;/>&#xa;                                                &lt;/ns:Note>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:CodiceOpRecipient>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceOpRecipient&quot;/>&#xa;                                            &lt;/ns:CodiceOpRecipient>&#xa;                                            &lt;ns:CodiceSegreto>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceSegreto&quot;/>&#xa;                                            &lt;/ns:CodiceSegreto>&#xa;                                            &lt;xsl:for-each select=&quot;TipoLinea&quot;>&#xa;                                                &lt;ns:TipoLinea>&#xa;                                                    &lt;xsl:choose>&#xa;                                                        &lt;xsl:when test=&quot;exists(ISDN)&quot;>&#xa;                                                            &lt;ns:ISDN>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                                &lt;ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                    &lt;xsl:value-of select=&quot;ISDN/FlagNPNumerazioniAggiuntive&quot;/>&#xa;                                                                &lt;/ns:FlagNPNumerazioniAggiuntive>&#xa;                                                                &lt;xsl:for-each select=&quot;ISDN/NPAggiuntive&quot;>&#xa;                                                                    &lt;ns:NPAggiuntive>&#xa;                                                                        &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                                            &lt;ns:NumAggiuntivaPortata>&#xa;                                                                                &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                                            &lt;/ns:NumAggiuntivaPortata>&#xa;                                                                        &lt;/xsl:for-each>&#xa;                                                                    &lt;/ns:NPAggiuntive>&#xa;                                                                &lt;/xsl:for-each>&#xa;                                                            &lt;/ns:ISDN>&#xa;                                                        &lt;/xsl:when>&#xa;                                                        &lt;xsl:otherwise>&#xa;                                                            &lt;ns:GNR>&#xa;                                                                &lt;ns:TipoLineaID>&#xa;                                                                    &lt;xsl:value-of select=&quot;GNR/TipoLineaID&quot;/>&#xa;                                                                &lt;/ns:TipoLineaID>&#xa;                                                            &lt;/ns:GNR>&#xa;                                                        &lt;/xsl:otherwise>&#xa;                                                    &lt;/xsl:choose>&#xa;                                                &lt;/ns:TipoLinea>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;ns:DataAttesaConsegnaServizio>&#xa;                                                &lt;xsl:value-of select=&quot;DataAttesaConsegnaServizio&quot;/>&#xa;                                            &lt;/ns:DataAttesaConsegnaServizio>&#xa;                                            &lt;ns:CognomeCliente_RagioneSociale>&#xa;                                                &lt;xsl:value-of select=&quot;CognomeCliente_RagioneSociale&quot;/>&#xa;                                            &lt;/ns:CognomeCliente_RagioneSociale>&#xa;                                            &lt;xsl:if test=&quot;NomeCliente&quot;>&#xa;                                                &lt;ns:NomeCliente>&#xa;                                                    &lt;xsl:value-of select=&quot;NomeCliente&quot;/>&#xa;                                                &lt;/ns:NomeCliente>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:if test=&quot;CodiceProgetto&quot;>&#xa;                                                &lt;ns:CodiceProgetto>&#xa;                                                    &lt;xsl:value-of select=&quot;CodiceProgetto&quot;/>&#xa;                                                &lt;/ns:CodiceProgetto>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;ns:EmailReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;EmailReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:EmailReferenteRichiedente>&#xa;                                            &lt;ns:TelefonoReferenteRichiedente>&#xa;                                                &lt;xsl:value-of select=&quot;TelefonoReferenteRichiedente&quot;/>&#xa;                                            &lt;/ns:TelefonoReferenteRichiedente>&#xa;                                            &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                &lt;ns:Correlazioni>&#xa;                                                    &lt;ns:IdentificativoCorrelazioni>&#xa;                                                        &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                    &lt;/ns:IdentificativoCorrelazioni>&#xa;                                                    &lt;ns:TotaleRichieste>&#xa;                                                        &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                    &lt;/ns:TotaleRichieste>&#xa;                                                &lt;/ns:Correlazioni>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:DatiNotifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;ns:IdentificativoOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;Valid_Tecnica_Donating_Donor/IdentificativoOperatoreDonating&quot;/>&#xa;                           