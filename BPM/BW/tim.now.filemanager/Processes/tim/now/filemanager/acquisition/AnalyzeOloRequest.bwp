                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns12=&quot;http://www.example.org/ChiusuraFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LocalPath&quot;/>&lt;xsl:param name=&quot;Contatori&quot;/>&lt;xsl:param name=&quot;ParseXmlR_NP&quot;/>&lt;xsl:param name=&quot;ParseXmlN_NP&quot;/>&lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&lt;xsl:param name=&quot;ParseXmlREG&quot;/>&lt;xsl:param name=&quot;ReadFileInfo&quot;/>&lt;xsl:param name=&quot;ControlliFormali&quot;/>&lt;xsl:param name=&quot;ParseXmlGPON&quot;/>&lt;xsl:param name=&quot;Parse103NP_R&quot;/>&lt;xsl:param name=&quot;Parse103NP_N&quot;/>&lt;xsl:param name=&quot;ParseXmlFWA&quot;/>&lt;xsl:param name=&quot;ParseFIBERSTREAM&quot;/>&lt;xsl:template name=&quot;ChiusuraFile-input&quot; match=&quot;/&quot;>&lt;tns12:Input>&lt;tns12:FileName>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileName&quot;/>&lt;/tns12:FileName>&lt;tns12:FileFullName>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:FileFullName&quot;/>&lt;/tns12:FileFullName>&lt;tns12:LocalPath>&lt;xsl:value-of select=&quot;$LocalPath&quot;/>&lt;/tns12:LocalPath>&lt;tns12:IDfile>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&lt;/tns12:IDfile>&lt;tns12:IdEsecProcsoFile>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IdEsecProcsoFile&quot;/>&lt;/tns12:IdEsecProcsoFile>&lt;tns12:Esito>&lt;xsl:value-of select=&quot;&amp;quot;IN AMBITO&amp;quot;&quot;/>&lt;/tns12:Esito>&lt;tns12:ContatoreRichieste>&lt;xsl:value-of select=&quot;xsd:int(count($ParseXmlREG/Richiesta)+count($ParseXmlNGA/tns:Richiesta)+count($ParseXmlxDSL/ns01:Richiesta)+count($ParseXmlR_NP/ComunicazioneNP/Risposta)+count($ParseXmlN_NP/Richiesta)+count($ParseXmlGPON/Richiesta)+count($Parse103NP_R/ComunicazioneNP/Risposta)+count($Parse103NP_N/ComunicazioneNP/Richiesta)+count($ParseXmlFWA/ns02:Richiesta)+count($ParseFIBERSTREAM/RichiestaOAO/Richiesta))&quot;/>&lt;/tns12:ContatoreRichieste>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&lt;tns12:CodiceISP>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&lt;/tns12:CodiceISP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns12:CodiceISP>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&lt;/tns12:CodiceISP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&lt;tns12:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&lt;/tns12:CodificaOLOagcom>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns12:CodificaOLOagcom>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&lt;/tns12:CodificaOLOagcom>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns12:IDintrfc>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDintrfc&quot;/>&lt;/tns12:IDintrfc>&lt;tns12:IDtplg_file>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDtplg_file&quot;/>&lt;/tns12:IDtplg_file>&lt;tns12:Contatori>&lt;xsl:copy-of select=&quot;$Contatori/ancestor-or-self::*/namespace::node()&quot;/>&lt;xsl:copy-of select=&quot;$Contatori/@*&quot;/>&lt;xsl:copy-of select=&quot;$Contatori/node()&quot;/>&lt;/tns12:Contatori>&lt;/tns12:Input>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.ChiusuraFile" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:template name=&quot;REG_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Element>&#xa;            &lt;xsl:copy-of select=&quot;$CodiciOlo&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOISP&quot;>&#xa;                        &lt;ns3:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                        &lt;/ns3:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodISP&quot;>&#xa;                        &lt;ns3:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                        &lt;/ns3:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns3:ID_FILE>&#xa;            &lt;ns3:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/ns3:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay/parameters/tns5:Response/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns5:Response/tns5:outputDate&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;RichiestaOloRegolatorio>&#xa;                &lt;xsl:for-each select=&quot;$Accumulate1/RichiestaOloRegolatorio&quot;>&#xa;                    &lt;Richiesta>&#xa;                        &lt;Testata>&#xa;                            &lt;CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceOlo&quot;/>&#xa;                            &lt;/CodiceOlo>&#xa;                            &lt;CodiceOrdineOlo>&#xa;                                &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceOrdineOlo&quot;/>&#xa;                            &lt;/CodiceOrdineOlo>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/CodiceOrdineOloPadre&quot;>&#xa;                                &lt;CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/CodiceProgetto&quot;>&#xa;                                &lt;CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceProgetto&quot;/>&#xa;                                &lt;/CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:copy-of select=&quot;Richiesta/Testata/Correlazioni&quot;/>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/ReferentiOAOProgettiSpeciali&quot;>&#xa;                                &lt;ReferentiOAOProgettiSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/ReferentiOAOProgettiSpeciali&quot;/>&#xa;                                &lt;/ReferentiOAOProgettiSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/Testata>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/StatoAvanzamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/StatoAvanzamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/CancellazioneAccodamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/CancellazioneAccodamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/InterruzioneMigrazione)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/InterruzioneMigrazione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/Annullamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Annullamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/RimodulazioneDACdaRecipient)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/RimodulazioneDACdaRecipient&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/RimodulazioneAppuntamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/RimodulazioneAppuntamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/InterruzioneSospensione)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/InterruzioneSospensione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Comunicazione&quot;/>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/RichiestaOloRegolatorio>&#xa;        &lt;/ns3:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="REG_SUBPROCESS-input"
                    name="REG_SUBPROCESS"
                    outputVariable="REG_SUBPROCESS"
                    tibex:xpdlId="20b3cc2c-ba5b-4a8e-b23e-a69ac37f88d8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="REG_SUBPROCESSToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns3=&quot;http://www.tim.com/NOW/xsd/REGstart&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getNextWorkingDay.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiciOlo&quot;/>&#xa;    &lt;xsl:param name=&quot;ReadFileInfo&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagOscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Data&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloDate&quot;/>&#xa;    &lt;xsl:param name=&quot;Timezone&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:template name=&quot;REG_SUBPROCESS-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns3:Element>&#xa;            &lt;xsl:copy-of select=&quot;$CodiciOlo&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM)>0&quot;>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:CodOLOdaNome>&#xa;                        &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&#xa;                    &lt;/ns3:CodOLOdaNome>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOISP&quot;>&#xa;                        &lt;ns3:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                        &lt;/ns3:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodISP&quot;>&#xa;                        &lt;ns3:CodISPdaNome>&#xa;                            &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&#xa;                        &lt;/ns3:CodISPdaNome>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns3:ID_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&#xa;            &lt;/ns3:ID_FILE>&#xa;            &lt;ns3:DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&#xa;            &lt;/ns3:DATA_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ns3:NextWorkingDate>&#xa;                                &lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&#xa;                            &lt;/ns3:NextWorkingDate>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($getNextWorkingDay.parameters/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;$getNextWorkingDay.parameters/tns5:outputDate&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns3:NextWorkingDate>&#xa;                        &lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&#xa;                    &lt;/ns3:NextWorkingDate>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;RichiestaOloRegolatorio>&#xa;                &lt;xsl:for-each select=&quot;$Accumulate1/RichiestaOloRegolatorio&quot;>&#xa;                    &lt;Richiesta>&#xa;                        &lt;Testata>&#xa;                            &lt;CodiceOlo>&#xa;                                &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceOlo&quot;/>&#xa;                            &lt;/CodiceOlo>&#xa;                            &lt;CodiceOrdineOlo>&#xa;                                &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceOrdineOlo&quot;/>&#xa;                            &lt;/CodiceOrdineOlo>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/CodiceOrdineOloPadre&quot;>&#xa;                                &lt;CodiceOrdineOloPadre>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceOrdineOloPadre&quot;/>&#xa;                                &lt;/CodiceOrdineOloPadre>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/CodiceProgetto&quot;>&#xa;                                &lt;CodiceProgetto>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/CodiceProgetto&quot;/>&#xa;                                &lt;/CodiceProgetto>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/Note&quot;>&#xa;                                &lt;Note>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/Note&quot;/>&#xa;                                &lt;/Note>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:copy-of select=&quot;Richiesta/Testata/Correlazioni&quot;/>&#xa;                            &lt;xsl:if test=&quot;Richiesta[1]/Testata/ReferentiOAOProgettiSpeciali&quot;>&#xa;                                &lt;ReferentiOAOProgettiSpeciali>&#xa;                                    &lt;xsl:value-of select=&quot;Richiesta[1]/Testata/ReferentiOAOProgettiSpeciali&quot;/>&#xa;                                &lt;/ReferentiOAOProgettiSpeciali>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/Testata>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/Ordine)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Ordine&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/StatoAvanzamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/StatoAvanzamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/CancellazioneAccodamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/CancellazioneAccodamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/InterruzioneMigrazione)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/InterruzioneMigrazione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/Annullamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Annullamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/RimodulazioneDACdaRecipient)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/RimodulazioneDACdaRecipient&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/RimodulazioneAppuntamento)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/RimodulazioneAppuntamento&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Richiesta[1]/InterruzioneSospensione)&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/InterruzioneSospensione&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:copy-of select=&quot;Richiesta[1]/Comunicazione&quot;/>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Richiesta>&#xa;                &lt;/xsl:for-each>&#xa;            &lt;/RichiestaOloRegolatorio>&#xa;        &lt;/ns3:Element>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="tim.now.filemanager.acquisition.SubProcREG" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogREG-input"
                    name="LogREG"
                    tibex:xpdlId="ea9ba5ad-8282-4562-b7cb-8f1f0ad7f1cb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToATT-ANN_Cycle"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlREG&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Log-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Contenuto validato per REG: &amp;#xD;&amp;#xA;&amp;quot;,tib:render-xml($ParseXmlREG))&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="loggerName" processProperty="LoggerName"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value role="Debug"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Contatori"
                    name="ContatoriREG" outputVariable="Contatori"
                    tibex:xpdlId="bd11b5a4-95d9-4e22-ac44-800005364c28" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
