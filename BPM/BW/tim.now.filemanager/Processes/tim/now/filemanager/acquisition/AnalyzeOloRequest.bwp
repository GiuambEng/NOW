                                    <tibex:extActivity
                                    inputVariable="RimuoviDuplicatiInArray-input"
                                    name="RimuoviDuplicatiInArray"
                                    outputVariable="RimuoviDuplicatiInArray"
                                    tibex:xpdlId="9c74c02d-de96-44c9-94df-c7ae0bcd53a6"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToRimuoviDuplicatiInArray"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="RimuoviDuplicatiInArrayToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RimuoviDuplicati/&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&#xa;    &lt;xsl:template name=&quot;RimuoviDuplicatiInArray-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputString>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:EasyIPUBBFTTCAB)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:EasyIPUBBFTTCAB/tns:Accesso/tns:LineaNonFonia/tns:ServiziOpzionali&quot;>&#xa;                        &lt;tns1:Input>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTCAB/tns:Accesso/tns:LineaNonFonia/tns:ServiziOpzionali&quot;>&#xa;                        &lt;tns1:Input>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTH)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:BitstreamNGAFTTH/tns:Accesso/tns:LineaNonFonia/tns:ServiziOpzionali&quot;>&#xa;                        &lt;tns1:Input>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:VULAFTTCAB/tns:Accesso/tns:LineaNonFonia)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:VULAFTTCAB/tns:Accesso/tns:LineaNonFonia/tns:ServiziOpzionali&quot;>&#xa;                        &lt;tns1:Input>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:VULAFTTH/tns:Accesso/tns:LineaNonFonia)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:VULAFTTH/tns:Accesso/tns:LineaNonFonia/tns:ServiziOpzionali&quot;>&#xa;                        &lt;tns1:Input>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$ParseXmlNGA/tns:Richiesta[$index]/tns:TipoRichiesta/tns:Attivazione/tns:EasyIPUBBFTTH/tns:Accesso/tns:LineaNonFonia/tns:ServiziOpzionali&quot;>&#xa;                        &lt;tns1:Input>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodiceServizio&quot;/>&#xa;                        &lt;/tns1:Input>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:InputString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="JavaUtil.RimuoviDuplicatiInArray" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="ea453a95-178a-4fe7-97f4-178cd115a6f0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
