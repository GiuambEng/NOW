                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:ns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6d9df0b9-cf84-486a-8e0c-b93b5edd310c+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&lt;xsl:param name=&quot;ParseXmlREG&quot;/>&lt;xsl:param name=&quot;ParseXmlR_NP&quot;/>&lt;xsl:param name=&quot;ParseXmlN_NP&quot;/>&lt;xsl:param name=&quot;ReadFileInfo&quot;/>&lt;xsl:param name=&quot;Parse103NP_R&quot;/>&lt;xsl:param name=&quot;Parse103NP_N&quot;/>&lt;xsl:param name=&quot;ParseXmlFWA&quot;/>&lt;xsl:param name=&quot;ParseFIBERSTREAM&quot;/>&lt;xsl:template name=&quot;JDBCinsertRecordTotali-input&quot; match=&quot;/&quot;>&lt;ns1:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($ReadFileInfo/tns4:TimestampAperturaFile))>0&quot;>&lt;DataArrivo>&lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:TimestampAperturaFile)&quot;/>&lt;/DataArrivo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DataArrivo>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/DataArrivo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DimensioneFile>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:Size&quot;/>&lt;/DimensioneFile>&lt;IdFileProcstoInput>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&lt;/IdFileProcstoInput>&lt;QtRecordTotali>&lt;xsl:value-of select=&quot;count($ParseXmlREG/Richiesta)+count($ParseXmlNGA/tns:Richiesta)+count($ParseXmlxDSL/ns01:Richiesta)+count($ParseXmlR_NP/ComunicazioneNP/Risposta)+count($ParseXmlN_NP/Richiesta)+count($Parse103NP_R/ComunicazioneNP/Risposta)+count($Parse103NP_N/ComunicazioneNP/Richiesta)+count($ParseXmlFWA/ns02:Richiesta)+count($ParseFIBERSTREAM/RichiestaOAO/Richiesta)&quot;/>&lt;/QtRecordTotali>&lt;/ns1:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
