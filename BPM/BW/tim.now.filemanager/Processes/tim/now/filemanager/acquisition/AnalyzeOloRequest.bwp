                    <bpws:extensionActivity>
                        <tibex:activityExtension
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tibco.com/namespaces/tnt/plugins/parsexml&quot; xmlns:tns9=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ReplaceCharacterInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;ParseXmlGPON-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:xmlString>&#xa;            &lt;xsl:value-of select=&quot;$ReplaceCharacterInvoke/ReplaceCharacterOutput/tns9:OutputString/tns9:NewString&quot;/>&#xa;        &lt;/tns8:xmlString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                            expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                            inputVariable="ParseXmlGPON-input"
