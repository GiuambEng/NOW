                            outputVariable="ParseXmlGPON"
                            tibex:xpdlId="b436c5b6-8077-4ebe-8f57-6cdd4adf0c49" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                            <bpws:targets>
