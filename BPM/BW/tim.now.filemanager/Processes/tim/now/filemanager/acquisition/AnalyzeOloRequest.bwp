         &lt;ns3:CodiceSegreto>&#xa;                                                &lt;xsl:value-of select=&quot;CodiceSegreto&quot;/>&#xa;                                            &lt;/ns3:CodiceSegreto>&#xa;                                            &lt;ns3:TipoLinea>&#xa;                                                &lt;xsl:value-of select=&quot;TipoLinea&quot;/>&#xa;                                            &lt;/ns3:TipoLinea>&#xa;                                            &lt;xsl:if test=&quot;CodiceProgetto&quot;>&#xa;                                                &lt;ns3:CodiceProgetto>&#xa;                                                    &lt;xsl:value-of select=&quot;CodiceProgetto&quot;/>&#xa;                                                &lt;/ns3:CodiceProgetto>&#xa;                                            &lt;/xsl:if>&#xa;                                            &lt;xsl:for-each select=&quot;Correlazioni&quot;>&#xa;                                                &lt;ns3:Correlazioni>&#xa;                                                    &lt;ns3:IdentificativoCorrelazioni>&#xa;                                                        &lt;xsl:value-of select=&quot;IdentificativoCorrelazioni&quot;/>&#xa;                                                    &lt;/ns3:IdentificativoCorrelazioni>&#xa;                                                    &lt;ns3:TotaleRichieste>&#xa;                                                        &lt;xsl:value-of select=&quot;TotaleRichieste&quot;/>&#xa;                                                    &lt;/ns3:TotaleRichieste>&#xa;                                                &lt;/ns3:Correlazioni>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;ns3:IdentificativoOperatoreDonating>&#xa;                                                &lt;xsl:value-of select=&quot;IdentificativoOperatoreDonating&quot;/>&#xa;                                            &lt;/ns3:IdentificativoOperatoreDonating>&#xa;                                        &lt;/ns3:DatiNotifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Com_Esito_Donor_Recipient/EsitoVerifica&quot;>&#xa;                                        &lt;ns3:EsitoVerifica>&#xa;                                            &lt;xsl:for-each select=&quot;EsitoKO&quot;>&#xa;                                                &lt;ns3:EsitoKO>&#xa;                                                    &lt;ns3:EsitoVerificaRichiesta>&#xa;                                                        &lt;xsl:value-of select=&quot;EsitoVerificaRichiesta&quot;/>&#xa;                                                    &lt;/ns3:EsitoVerificaRichiesta>&#xa;                                                    &lt;ns3:CodiceMotivoRifiuto>&#xa;                                                        &lt;xsl:value-of select=&quot;CodiceMotivoRifiuto&quot;/>&#xa;                                                    &lt;/ns3:CodiceMotivoRifiuto>&#xa;                                                    &lt;ns3:DescrizioneRifiuto>&#xa;                                                        &lt;xsl:value-of select=&quot;DescrizioneRifiuto&quot;/>&#xa;                                                    &lt;/ns3:DescrizioneRifiuto>&#xa;                                                &lt;/ns3:EsitoKO>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns3:EsitoVerifica>&#xa;                                    &lt;/xsl:for-each>&#xa;                                &lt;/ns3:Com_Esito_Donor_Recipient>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists(Espletamento_Donor_RecipientDonating)&quot;>&#xa;                                &lt;ns3:Espletamento_Donor_RecipientDonating>&#xa;                  