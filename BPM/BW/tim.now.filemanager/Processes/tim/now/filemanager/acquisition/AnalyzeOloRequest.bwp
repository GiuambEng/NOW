                                    sqlStatement="INSERT INTO FILE_PROCSTO_INPUT (DATA_ARRIVO, DIMENSIONE_FILE, ID_FILE_PROCSTO_INPUT, QT_RECD_TOTALI)&#xa;VALUES(?, ?, ?, ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
