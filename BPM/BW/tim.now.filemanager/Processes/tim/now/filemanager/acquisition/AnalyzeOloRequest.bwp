            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CodiciOlo"
                    name="CodiciAssign" outputVariable="CodiciOlo"
                    tibex:xpdlId="6709e383-733f-42b8-bef0-7c5d2e0abfe0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCodiciAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CodiciAssignToSelectCodiciOLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:ns01=&quot;http://xsd.telecomitalia.it/crm/xdsl/order&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:ns02=&quot;http://fwa.telecomitalia.it/crm/fwa/order&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ParseXmlREG&quot;/>&lt;xsl:param name=&quot;NGAPref&quot;/>&lt;xsl:param name=&quot;ParseXmlxDSL&quot;/>&lt;xsl:param name=&quot;ParseXmlNGA&quot;/>&lt;xsl:param name=&quot;ReadFileInfo&quot;/>&lt;xsl:param name=&quot;N_pref&quot;/>&lt;xsl:param name=&quot;R_pref&quot;/>&lt;xsl:param name=&quot;ControlliFormali&quot;/>&lt;xsl:param name=&quot;GPONPref&quot;/>&lt;xsl:param name=&quot;ParseXmlGPON&quot;/>&lt;xsl:param name=&quot;FWAPref&quot;/>&lt;xsl:param name=&quot;ParseXmlFWA&quot;/>&lt;xsl:param name=&quot;FIBERSTREAMPref&quot;/>&lt;xsl:param name=&quot;ParseFIBERSTREAM&quot;/>&lt;xsl:template name=&quot;CodiciOlo&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP) > 0 and starts-with($ReadFileInfo/tns4:FileName, concat($FWAPref, $ControlliFormali/tns2:CodOLOISP))&quot;>&lt;tns3:CodiciOlo>&lt;xsl:for-each-group select=&quot;$ParseXmlFWA/ns02:Richiesta&quot; group-by=&quot;ns02:Testata/ns02:CodiceOloAgcom&quot;>&lt;tns3:codes>&lt;tns3:CodiceOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:CodiceOLO>&lt;tns3:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;ns02:Testata/ns02:CodiceOloAgcom&quot;/>&lt;/tns3:CodiceOLOAGCOM>&lt;tns3:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:AZIONE>&lt;/tns3:codes>&lt;/xsl:for-each-group>&lt;/tns3:CodiciOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP) > 0 and starts-with($ReadFileInfo/tns4:FileName, concat($GPONPref, $ControlliFormali/tns2:CodOLOISP))&quot;>&lt;tns3:CodiciOlo>&lt;xsl:for-each-group select=&quot;$ParseXmlGPON/Richiesta&quot; group-by=&quot;Testata/CodiceOlo&quot;>&lt;tns3:codes>&lt;tns3:CodiceOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:CodiceOLO>&lt;tns3:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/tns3:CodiceOLOAGCOM>&lt;tns3:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:AZIONE>&lt;/tns3:codes>&lt;/xsl:for-each-group>&lt;/tns3:CodiciOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM) > 0 and (starts-with($ReadFileInfo/tns4:FileName, $ControlliFormali/tns2:CodOLOAGCOM) or starts-with($ReadFileInfo/tns4:FileName, concat($N_pref,$ControlliFormali/tns2:CodOLOAGCOM)) or starts-with($ReadFileInfo/tns4:FileName, concat($R_pref,$ControlliFormali/tns2:CodOLOAGCOM)))&quot;>&lt;tns3:CodiciOlo>&lt;xsl:for-each-group select=&quot;$ParseXmlREG/Richiesta&quot; group-by=&quot;Testata/CodiceOlo&quot;>&lt;tns3:codes>&lt;tns3:CodiceOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:CodiceOLO>&lt;tns3:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOlo&quot;/>&lt;/tns3:CodiceOLOAGCOM>&lt;tns3:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:AZIONE>&lt;/tns3:codes>&lt;/xsl:for-each-group>&lt;/tns3:CodiciOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOAGCOM) > 0 and starts-with($ReadFileInfo/tns4:FileName, concat($FIBERSTREAMPref, $ControlliFormali/tns2:CodOLOAGCOM))&quot;>&lt;tns3:CodiciOlo>&lt;xsl:for-each-group select=&quot;$ParseFIBERSTREAM/RichiestaOAO/Richiesta&quot; group-by=&quot;Testata/CodiceOperatore&quot;>&lt;tns3:codes>&lt;tns3:CodiceOLO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:CodiceOLO>&lt;tns3:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;Testata/CodiceOperatore&quot;/>&lt;/tns3:CodiceOLOAGCOM>&lt;tns3:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:AZIONE>&lt;/tns3:codes>&lt;/xsl:for-each-group>&lt;/tns3:CodiciOlo>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP) > 0 and starts-with($ReadFileInfo/tns4:FileName, concat($NGAPref, $ControlliFormali/tns2:CodOLOISP))&quot;>&lt;tns3:CodiciOlo>&lt;xsl:for-each-group select=&quot;$ParseXmlNGA/tns:Richiesta&quot; group-by=&quot;tns:Testata/tns:CodiceOlo&quot;>&lt;tns3:codes>&lt;tns3:CodiceOLO>&lt;xsl:value-of select=&quot;tns:Testata/tns:CodiceOlo&quot;/>&lt;/tns3:CodiceOLO>&lt;tns3:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:CodiceOLOAGCOM>&lt;tns3:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:AZIONE>&lt;/tns3:codes>&lt;/xsl:for-each-group>&lt;/tns3:CodiciOlo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:CodiciOlo>&lt;xsl:for-each-group select=&quot;$ParseXmlxDSL/ns01:Richiesta&quot; group-by=&quot;ns01:Testata/ns01:CodiceOlo&quot;>&lt;tns3:codes>&lt;tns3:CodiceOLO>&lt;xsl:value-of select=&quot;ns01:Testata/ns01:CodiceOlo&quot;/>&lt;/tns3:CodiceOLO>&lt;tns3:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:CodiceOLOAGCOM>&lt;tns3:AZIONE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns3:AZIONE>&lt;/tns3:codes>&lt;/xsl:for-each-group>&lt;/tns3:CodiciOlo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="CodiciOlo" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="CodiciOlo"
                    name="AssignCoppiaCodiciOLO"
                    outputVariable="CodiciOlo"
                    tibex:xpdlId="9b2fe3d8-ff6e-4cc6-9c75-65195070a069" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EstrazioneOLToAssignCoppiaCodiciOLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignCoppiaCodiciOLOTogetNextWorkingDay"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;EstrazioneOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlliFormali&quot;/>&#xa;    &lt;xsl:template name=&quot;CodiciOlo&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CodiciOlo>&#xa;            &lt;xsl:for-each select=&quot;$EstrazioneOLO/tns3:codes&quot;>&#xa;                &lt;xsl:copy-of select=&quot;.&quot;/>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;count($EstrazioneOLO/tns3:codes) = 0 and string-length($ControlliFormali/tns2:CodOLOISP) > 0 and string-length($ControlliFormali/tns2:CodOLOAGCOM) > 0&quot;>&#xa;                &lt;tns3:codes>&#xa;                    &lt;tns3:CodiceOLO>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&#xa;                    &lt;/tns3:CodiceOLO>&#xa;                    &lt;tns3:CodiceOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&#xa;                    &lt;/tns3:CodiceOLOAGCOM>&#xa;                &lt;/tns3:codes>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:CodiciOlo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="CodiciOlo" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="LogPath-input"
                    name="LogPath"
                    tibex:xpdlId="697ab270-c22b-4367-acca-403a26dd64b5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToLogFileInformation"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogPathToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;LocalPath&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPath-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:ActivityInput>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Application: tim.now.filemanager.application | Process: AnalyzeOloRequest | ProcessInstance &amp;quot;, $_processContext/ProcessInstanceId)&quot;/>&#xa;            &lt;/msgCode>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;Cartella locale: &amp;quot;,$LocalPath)&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns6:ActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
