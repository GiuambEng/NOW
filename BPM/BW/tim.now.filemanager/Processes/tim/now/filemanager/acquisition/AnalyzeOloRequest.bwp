            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:ns2=&quot;http://www.tim.com/NOW/xsd/NGAstart&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&lt;xsl:param name=&quot;ReadFileInfo&quot;/>&lt;xsl:param name=&quot;ControlliFormali&quot;/>&lt;xsl:param name=&quot;ControlloDate&quot;/>&lt;xsl:param name=&quot;Data&quot;/>&lt;xsl:param name=&quot;FlagOscuramento&quot;/>&lt;xsl:param name=&quot;Timezone&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;NGA_SUBPROCESS-input&quot; match=&quot;/&quot;>&lt;ns2:Element>&lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&lt;tns3:CodiciOlo>&lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&lt;/tns3:CodiciOlo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&lt;ns2:CodOLOdaNome>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&lt;/ns2:CodOLOdaNome>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns2:CodOLOdaNome>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&lt;/ns2:CodOLOdaNome>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ReadFileInfo/tns4:CodAGCOM)>0&quot;>&lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;>&lt;ns2:CodAGCOMint>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&lt;/ns2:CodAGCOMint>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;>&lt;ns2:CodAGCOMint>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&lt;/ns2:CodAGCOMint>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns2:ID_FILE>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&lt;/ns2:ID_FILE>&lt;ns2:DATA_FILE>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&lt;/ns2:DATA_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&lt;ns2:NextWorkingDate>&lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&lt;/ns2:NextWorkingDate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns2:NextWorkingDate>&lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&lt;/ns2:NextWorkingDate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($getNextWorkingDay/parameters/tns5:Response/tns5:outputDate) and ((count($FlagOscuramento/Record)>0 and $FlagOscuramento/Record[1]/FLAG_OSCURMENTO='1') or ($Data='KO') or ($ControlloDate='KO'))&quot;>&lt;ns2:NextWorkingDate>&lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns5:Response/tns5:outputDate&quot;/>&lt;/ns2:NextWorkingDate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns2:NextWorkingDate>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/ns2:NextWorkingDate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:TracciatoOLONGA>&lt;xsl:for-each select=&quot;$Accumulate/tns:TracciatoOLONGA&quot;>&lt;tns:Richiesta>&lt;tns:Testata>&lt;tns:CodiceOlo>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOlo&quot;/>&lt;/tns:CodiceOlo>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOlo&quot;>&lt;tns:CodiceOrdineOlo>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOlo&quot;/>&lt;/tns:CodiceOrdineOlo>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOloPadre&quot;>&lt;tns:CodiceOrdineOloPadre>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOrdineOloPadre&quot;/>&lt;/tns:CodiceOrdineOloPadre>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceProgetto&quot;>&lt;tns:CodiceProgetto>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceProgetto&quot;/>&lt;/tns:CodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:Note&quot;>&lt;tns:Note>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:Note&quot;/>&lt;/tns:Note>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:TestMode&quot;>&lt;tns:TestMode>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:TestMode&quot;/>&lt;/tns:TestMode>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:semiVULA)>0&quot;>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:semiVULA&quot;>&lt;tns:semiVULA>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:semiVULA&quot;/>&lt;/tns:semiVULA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:semiBitstreamNGA)>0&quot;>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:semiBitstreamNGA&quot;>&lt;tns:semiBitstreamNGA>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:semiBitstreamNGA&quot;/>&lt;/tns:semiBitstreamNGA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:semiEasyIPNGA)>0&quot;>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:semiEasyIPNGA&quot;>&lt;tns:semiEasyIPNGA>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:semiEasyIPNGA&quot;/>&lt;/tns:semiEasyIPNGA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length(tns:Richiesta[1]/tns:Testata/tns:FullGPONPLUS)>0&quot;>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:FullGPONPLUS&quot;>&lt;tns:FullGPONPLUS>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:FullGPONPLUS&quot;/>&lt;/tns:FullGPONPLUS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:IdReteSecondariaOAO&quot;>&lt;tns:IdReteSecondariaOAO>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:IdReteSecondariaOAO&quot;/>&lt;/tns:IdReteSecondariaOAO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:ReferentiOAOProgettiSpeciali&quot;>&lt;tns:ReferentiOAOProgettiSpeciali>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:ReferentiOAOProgettiSpeciali&quot;/>&lt;/tns:ReferentiOAOProgettiSpeciali>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOperatoreSecondario&quot;>&lt;tns:CodiceOperatoreSecondario>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:CodiceOperatoreSecondario&quot;/>&lt;/tns:CodiceOperatoreSecondario>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Richiesta[1]/tns:Testata/tns:ClusterAccesso&quot;>&lt;tns:ClusterAccesso>&lt;xsl:value-of select=&quot;tns:Richiesta[1]/tns:Testata/tns:ClusterAccesso&quot;/>&lt;/tns:ClusterAccesso>&lt;/xsl:if>&lt;/tns:Testata>&lt;xsl:copy-of select=&quot;tns:Richiesta[1]/tns:TipoRichiesta&quot;/>&lt;/tns:Richiesta>&lt;/xsl:for-each>&lt;/tns:TracciatoOLONGA>&lt;/ns2:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>"
