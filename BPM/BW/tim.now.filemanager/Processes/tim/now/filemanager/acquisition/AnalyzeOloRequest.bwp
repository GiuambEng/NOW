                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:Rientro>&#xa;                                            &lt;/xsl:for-each>&#xa;                                            &lt;xsl:for-each select=&quot;NPAggiuntive&quot;>&#xa;                                                &lt;ns:NPAggiuntive>&#xa;                                                    &lt;xsl:for-each select=&quot;NumAggiuntivaPortata&quot;>&#xa;                                                        &lt;ns:NumAggiuntivaPortata>&#xa;                                                            &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                                        &lt;/ns:NumAggiuntivaPortata>&#xa;                                                    &lt;/xsl:for-each>&#xa;                                                &lt;/ns:NPAggiuntive>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/ns:Telecom>&#xa;                                    &lt;/xsl:for-each>&#xa;                                    &lt;xsl:for-each select=&quot;Valid_Formale_Cessazione/EsitoVerifica&quot;>&#xa;                                        &lt;xsl:choose>&#xa;                                            &lt;xsl:when test=&quot;exists(EsitoKO)&quot;>&#xa;                                                &lt;ns:EsitoVerifica>&#xa;                                                    &lt;ns:EsitoKO>&#xa;                                                        &lt;ns:EsitoVerificaRichiesta>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoKO/EsitoVerificaRichiesta&quot;/>&#xa;                                                        &lt;/ns:EsitoVerificaRichiesta>&#xa;                                                        &lt;ns:CodiceMotivoRifiuto>&#xa;                                                            &lt;xsl:value-of select=&quot;EsitoK