            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns10=&quot;http://www.example.org/FIBERSTREAMstart&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AnalyzeOloRequestUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormaliFile&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReadFileInfo&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiciOlo&quot;/>&lt;xsl:param name=&quot;ReadFileInfo&quot;/>&lt;xsl:param name=&quot;ControlliFormali&quot;/>&lt;xsl:param name=&quot;ParseFIBERSTREAM&quot;/>&lt;xsl:param name=&quot;ControlloDate&quot;/>&lt;xsl:param name=&quot;Timezone&quot;/>&lt;xsl:param name=&quot;Data&quot;/>&lt;xsl:param name=&quot;getNextWorkingDay&quot;/>&lt;xsl:template name=&quot;SubProcFIBERSTREAM-input&quot; match=&quot;/&quot;>&lt;tns10:Element>&lt;xsl:if test=&quot;exists($CodiciOlo/tns3:codes)&quot;>&lt;tns3:CodiciOlo>&lt;xsl:copy-of select=&quot;$CodiciOlo/tns3:codes&quot;/>&lt;/tns3:CodiciOlo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&lt;tns10:CodOLOdaNome>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&lt;/tns10:CodOLOdaNome>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns10:CodOLOdaNome>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&lt;/tns10:CodOLOdaNome>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ReadFileInfo/tns4:CodAGCOM)>0&quot;>&lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;>&lt;tns10:CodAGCOMint>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodAGCOM&quot;/>&lt;/tns10:CodAGCOMint>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;>&lt;tns10:CodAGCOMint>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOAGCOM&quot;/>&lt;/tns10:CodAGCOMint>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlliFormali/tns2:CodOLOISP)>0&quot;>&lt;xsl:if test=&quot;$ControlliFormali/tns2:CodOLOISP&quot;>&lt;tns10:CodISPdaNome>&lt;xsl:value-of select=&quot;$ControlliFormali/tns2:CodOLOISP&quot;/>&lt;/tns10:CodISPdaNome>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$ReadFileInfo/tns4:CodISP&quot;>&lt;tns10:CodISPdaNome>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:CodISP&quot;/>&lt;/tns10:CodISPdaNome>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns10:ID_FILE>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:IDfile&quot;/>&lt;/tns10:ID_FILE>&lt;tns10:DATA_FILE>&lt;xsl:value-of select=&quot;$ReadFileInfo/tns4:DataFile&quot;/>&lt;/tns10:DATA_FILE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlloDate)>0 and $ControlloDate='OK'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(xsd:string($ReadFileInfo/tns4:DataFile),'+')&quot;>&lt;tns10:NextWorkingDate>&lt;xsl:value-of select=&quot;xsd:date($Timezone)&quot;/>&lt;/tns10:NextWorkingDate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns10:NextWorkingDate>&lt;xsl:value-of select=&quot;xsd:date($ReadFileInfo/tns4:DataFile)&quot;/>&lt;/tns10:NextWorkingDate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($getNextWorkingDay/parameters/tns5:Response/tns5:outputDate) and (($Data='KO') or ($ControlloDate='KO'))&quot;>&lt;tns10:NextWorkingDate>&lt;xsl:value-of select=&quot;$getNextWorkingDay/parameters/tns5:Response/tns5:outputDate&quot;/>&lt;/tns10:NextWorkingDate>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns10:NextWorkingDate>&lt;xsl:value-of select=&quot;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,format-date(current-date(),&amp;quot;[Y0001]-[M01]-[D01]&amp;quot;))&quot;/>&lt;/tns10:NextWorkingDate>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;RichiestaOAO>&lt;xsl:copy-of select=&quot;$ParseFIBERSTREAM/RichiestaOAO/Richiesta&quot;/>&lt;/RichiestaOAO>&lt;/tns10:Element>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SubProcFIBERSTREAM-input"
                    name="SubProcFIBERSTREAM"
                    outputVariable="SubProcFIBERSTREAM"
