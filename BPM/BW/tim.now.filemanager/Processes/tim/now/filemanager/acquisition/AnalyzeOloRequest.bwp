                    <bpws:scope name="While" tibex:group="while" tibex:xpdlId="4dcb00f7-193a-4e22-a5b9-a7a5f0c96b2e">
                        <bpws:targets>
                            <bpws:target linkName="ParseXmlNGAToWhile"/>
                        </bpws:targets>
                        <bpws:sources>
                            <bpws:source linkName="WhileToLog2"/>
                        </bpws:sources>
                        <bpws:variables>
                            <bpws:variable name="index"
                                sca-bpel:internal="true" type="xsd:int">
                                <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                </bpws:from>
                            </bpws:variable>
                        </bpws:variables>
                        <bpws:sequence name="sequence" tibex:group="while">
                            <bpws:assign name="GroupInit"
                                tibex:group="groupInit" validate="no">
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+61c35a02-5dc4-4428-9986-4dbfd700bb3a" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:while name="while" tibex:counterName="index">
                                <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index&lt;=count($ParseXmlNGA/ns65:Richiesta)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                </tibex:DesignExpression>
                                <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($ParseXmlNGA/ns65:Richiesta)]]></bpws:condition>
                                <bpws:flow name="flow4">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart1ToRimuoviDuplicatiInArray" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="RimuoviDuplicatiInArrayToMapper" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="MapperToLog" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogToAccumulate" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart1ToMapper" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    </bpws:links>
                                    <bpws:assign name="GroupStart1"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="2134f7e1-e5a7-4c7c-9368-d7c5d54849db" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToRimuoviDuplicatiInArray">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:EasyIPUBBFTTCAB/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or  count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:BitstreamNGAFTTCAB/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:BitstreamNGAFTTH/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:VULAFTTCAB/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:VULAFTTH/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:EasyIPUBBFTTH/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:EasyIPUBBFTTCAB/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or  count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:BitstreamNGAFTTCAB/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:BitstreamNGAFTTH/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:VULAFTTCAB/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:VULAFTTH/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0 or count($ParseXmlNGA/ns65:Richiesta[$index]/ns65:TipoRichiesta/ns65:Attivazione/ns65:EasyIPUBBFTTH/ns65:Accesso/ns65:LineaNonFonia/ns65:ServiziOpzionali)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
