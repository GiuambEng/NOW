<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AssetToponomastica/" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/AssetToponomastica/">

    

    <element name="Request">
    	<complexType>
    		<sequence>
    			<element name="COD_TOPON" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="idContratto" type="int" maxOccurs="1" minOccurs="0"></element>
    			<element name="ID_Rich_OLO" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Offerta" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="idRisorsa" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="Response">
    	<complexType>
    		<sequence>
    			<element name="RecordAssetToponomastica"
    				maxOccurs="unbounded" minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="NUMERO_CIVICO"
    							type="string">
    						</element>
    						<element name="CAP" type="string"></element>
    						<element name="DR" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="DESCR_PARTICELLA_TOPON"
    							type="string">
    						</element>
    						<element name="DESCR_VIA" type="string"></element>
    						<element name="COD_ISTAT_COMUNE"
    							type="string">
    						</element>
    						<element name="COD_VIA" type="decimal" maxOccurs="1" minOccurs="0"></element>
    						<element name="DESCR_COMUNE"
    							type="string">
    						</element>
    						<element name="SIGLA_PROV" type="string"></element>
    						<element name="COD_ISTAT_PROV"
    							type="string">
    						</element>
    						<element name="DESCR_PROV" type="string"></element>
    						<element name="COD_TOPON" type="string"></element>
    						<element name="COD_COMUNE" type="decimal" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    			<element name="RecordIdContratto" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="ID_CONTRATTO_CRMWS" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="Message_code" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Error_code" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>