<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/SequenceOGG" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/SequenceOGG">

    <element name="Input">
    	<complexType>
    		<sequence>
    			<element name="ID_ASSET_NOW" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="id_rich_olo" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Controllo" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Output">
    	<complexType>
    		<sequence>
    			<element name="NextVal" type="decimal" maxOccurs="unbounded" minOccurs="0"></element>
    			<element name="Record" maxOccurs="unbounded"
    				minOccurs="0">
    				<complexType>
    					<sequence>
    						<element name="COD_SERVZ" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CREATED" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_ASSET_CRMWS" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_ASSET_NOW" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_ORDN" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ID_RISORSA" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="LAVRZ" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="MESSAGGIO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="STATO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="TRANSACTION_ID" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="TRANSACTION_ID_PARENT"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="TRANSACTION_ID_ROOT"
    							type="string" maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CODICE_OLO" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="ROW_ID" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="CREATED_BY" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="LAST_UPDT" type="date"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="LAST_UPDT_BY" type="string"
    							maxOccurs="1" minOccurs="0">
    						</element>
    						<element name="MODIFICATION_NUM" type="int" maxOccurs="1" minOccurs="0"></element>
    						<element name="CONFLICT_ID" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="DB_LAST_UPD" type="date" maxOccurs="1" minOccurs="0"></element>
    						<element name="DB_LAST_UPD_SRC" type="string" maxOccurs="1" minOccurs="0"></element>
    						<element name="DN" type="string" maxOccurs="1" minOccurs="0"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="Fault">
    	<complexType>
    		<sequence>
    			<element name="Msg_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="Codice_errore" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>