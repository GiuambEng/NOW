<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/AssetCorrelati/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/AssetCorrelati/"
	xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1"
	xmlns:pref1="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:pref2="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/">

	<import
		schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd"
		namespace="http://NOW.it.telecomitalia.it/casedata_v1">
	</import>
	<import
		schemaLocation="NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping.xsd"
		namespace="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping">
	</import>
	<import schemaLocation="CRMWSNumberPortability.xsd" namespace="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/"></import>
	<element name="Input">
		<complexType>
			<sequence>
				<element name="Asset" type="pref:Asset"
					maxOccurs="unbounded" minOccurs="0">
				</element>
				<element name="Lavorazione" type="string" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="NumeriAggiuntivi" maxOccurs="unbounded"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="NumeriAggiuntivi" type="pref2:AssetAggiuntiviComplexType"></element>
							<element name="NextVal" type="decimal" maxOccurs="1" minOccurs="0"></element>
						</sequence>
					</complexType>
				</element>
				<element name="Richiesta" type="pref:Richiesta"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="Cod_olo" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Output">
		<complexType>
			<sequence>
				<element name="Request" type="pref1:responseType"></element>
			</sequence>
		</complexType>
	</element>

	<element name="Fault">
		<complexType>
			<sequence>
				<element name="Msg_Error" type="string" maxOccurs="1" minOccurs="0"></element>
				<element name="Code_Error" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>