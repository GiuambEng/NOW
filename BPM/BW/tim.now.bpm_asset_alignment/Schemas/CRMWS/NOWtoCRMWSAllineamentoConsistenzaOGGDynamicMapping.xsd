<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1" xmlns:pref1="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping">
	<xsd:import namespace="http://NOW.it.telecomitalia.it/casedata_v1" schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd">
	</xsd:import>
	<xsd:import namespace="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/" schemaLocation="CRMWSNumberPortability.xsd"/>
	<xsd:element name="REQUEST">
		<xsd:complexType>
			<xsd:sequence>

				<xsd:element name="ASSET" type="pref:Asset"/>
				<xsd:element maxOccurs="unbounded" minOccurs="0" name="NumeriAggiuntivi">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element maxOccurs="1" minOccurs="0" name="NumeriAggiuntivi" type="pref1:AssetAggiuntiviComplexType">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="NextVal" type="xsd:decimal">
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element maxOccurs="1" minOccurs="0" name="RICHIESTA" type="pref:Richiesta">
				</xsd:element>
				<xsd:element maxOccurs="1" minOccurs="0" name="NextVal" type="xsd:decimal">
				</xsd:element>
				<xsd:element maxOccurs="1" minOccurs="0" name="IdContratto" type="xsd:string">
				</xsd:element>
				<xsd:element maxOccurs="unbounded" minOccurs="0" name="RecordAsset">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element maxOccurs="1" minOccurs="0" name="NumeroCivico" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="CAP" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="DR" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="DescrParticellaTopon" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="DescrVia" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="CodISTATComune" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="CodVia" type="xsd:int">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="DescrComune" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="SiglaProv" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="CodISTATProv" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="DescrProv" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="Cod_Topon" type="xsd:string">
							</xsd:element>
							<xsd:element maxOccurs="1" minOccurs="0" name="Cod_Comune" type="xsd:string">
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element maxOccurs="1" minOccurs="0" name="CODE_OLO" type="xsd:string">
				</xsd:element>
				<xsd:element maxOccurs="1" minOccurs="0" name="LavorazioneAsset" type="xsd:string">
				</xsd:element>
				<xsd:element maxOccurs="1" minOccurs="0" name="FlagNPBundle" type="xsd:boolean"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RESPONSE">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element maxOccurs="unbounded" minOccurs="1" name="RESPONSE" type="tns:responseType"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="RESPONSE_NP">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element maxOccurs="unbounded" name="RESPONSE_NP" type="tns:responseType"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:complexType name="servizioType">
		<xsd:sequence>
			<xsd:element name="CODICE_OLO">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:length value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="DESCOLO">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="3"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:complexType name="responseType">
		<xsd:sequence>
			<xsd:element name="TRANSACTION_ID">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="50"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="RESPONSE_DATE" type="xsd:dateTime"/>
			<xsd:element name="RETURN_CODE">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="2"/>
						<xsd:enumeration value="OK"/>
						<xsd:enumeration value="KO"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="DESCRIZIONE_ERRORE">
				<xsd:simpleType>
					<xsd:restriction base="xsd:string">
						<xsd:maxLength value="150"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="COD_SRVZ" type="xsd:string"/>
			<xsd:element name="CREATED" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="ID_ASSET_CRMWS" type="xsd:string"/>
			<xsd:element name="ID_ASSET_NOW" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="ID_ORDN" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="ID_RISORSA" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="LAVRZ" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="MESSAGGIO" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="STATO" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="TRANSACTION_ID_ROOT" type="xsd:string">
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="TRANSACTION_ID_PARENT" type="xsd:string">
			</xsd:element>
			<xsd:element maxOccurs="1" minOccurs="0" name="CODICE_OLO" type="xsd:string"/>
			<xsd:element name="ROW_ID" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="CREATED_BY" type="xsd:string"/>
			<xsd:element name="LAST_UPD" type="xsd:date"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="LAST_UPD_BY" type="xsd:string"/>
			<xsd:element name="MODIFICATION_NUM" type="xsd:int"/>
			<xsd:element name="CONFLICT_ID" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="DB_LAST_UPD" type="xsd:date"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="DB_LAST_UPD_SRC" type="xsd:string"/>
			<xsd:element maxOccurs="1" minOccurs="0" name="DN" type="xsd:string"/>
		</xsd:sequence>
	</xsd:complexType>



	<xsd:simpleType name="dateType">
		<xsd:restriction base="xsd:dateTime">
			<xsd:pattern value="\d\d-\d\d-\d\d\d\d \d\d:\d\d:\d\d"/>
		</xsd:restriction>
	</xsd:simpleType>

	<xsd:element name="FAULT">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element maxOccurs="1" minOccurs="0" name="Codice_Errore" type="xsd:string">
				</xsd:element>
				<xsd:element maxOccurs="1" minOccurs="0" name="Messaggio_Errore" type="xsd:string">
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
</xsd:schema>
