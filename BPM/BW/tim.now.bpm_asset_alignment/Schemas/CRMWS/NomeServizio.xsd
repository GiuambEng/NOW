<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/NOWNomeServizio/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NOWNomeServizio/" xmlns:pref="http://NOW.it.telecomitalia.it/casedata_v1">

	<import schemaLocation="../../../tim.now.shared_library/Schemas/BOMCaseData/it.telecomitalia.it.NOW.casedata.xsd" namespace="http://NOW.it.telecomitalia.it/casedata_v1"></import>
	<element name="RequestNomeServizio">
		<complexType>
			<sequence>
				<element name="Lavorazione"
					type="pref:LavorazioneEnumeration" maxOccurs="1" minOccurs="0">
				</element>
				<element name="Offerta" type="pref:OffertaEnumeration"
					maxOccurs="1" minOccurs="0">
				</element>
				<element name="StrutturaRichiesta"
					type="pref:TipoStrutturaRichiestaEnumeration" maxOccurs="1"
					minOccurs="0">
				</element>
				<element name="id_rich_olo" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>

	<element name="ResponseNomeServizio">
		<complexType>
			<sequence>
				<element name="NomeServizio" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>