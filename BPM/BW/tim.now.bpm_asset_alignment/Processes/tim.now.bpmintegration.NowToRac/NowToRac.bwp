            <wsdl:import namespace="http://www.tim.com/NOW/xsd/NowToRac/"/>
            <wsdl:import namespace="http://www.tibco.com/SharedNowToRac/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/xsd/NowToRac/"/>
        </wsdl:definitions>
