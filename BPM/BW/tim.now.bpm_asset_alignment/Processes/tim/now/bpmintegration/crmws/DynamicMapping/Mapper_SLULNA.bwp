                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/ns8:RICHIESTA/lavorazione)='ATTIVAZIONE' or $Start/ns8:LavorazioneAsset='ATTIVAZIONE']]></bpws:transitionCondition>
