            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AttivazioneSLULNA-input"
                    name="AttivazioneSLULNA"
                    outputVariable="AttivazioneSLULNA"
                    tibex:xpdlId="d71514b0-51ae-46e9-a8cd-77e219bad04b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SLULNAToMapper_Attivazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AttivazioneSLULNAToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeSLULNA/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AttivazioneSLULNA-input&quot; match=&quot;/&quot;>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/codificaOLOAGCOM&quot;/>&lt;/ns:DESCOLO>&lt;ns:SLULNA>&lt;ns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&lt;/ns:SERVIZIO>&lt;ns:ATTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:ASSET/codiceOrdineOLO)>11&quot;>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/codiceOrdineOLO&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:ASSET/codiceOrdineTI)>0&quot;>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/codiceOrdineTI&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns:IdContratto&quot;/>&lt;/ns:CONTRATTO>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/IDRisorsa&quot;/>&lt;/ns:RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns:ASSET/IDAsset&quot;>&lt;ns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/IDAsset&quot;/>&lt;/ns:ID_NOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns:ASSET/IDAssetCRMWS&quot;>&lt;ns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/IDAssetCRMWS&quot;/>&lt;/ns:ID_CRMWS>&lt;/xsl:if>&lt;ns:DEC>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/DES&quot;/>&lt;/ns:DEC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ASSET/distretto)  and string-length($Start/tns:ASSET/distretto)>0&quot;>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns:ASSET/distretto)))&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:CLLI_CENTRALE>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/CLLI&quot;/>&lt;/ns:CLLI_CENTRALE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:ASSET/numeroCivico)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:ASSET/numeroCivico&quot;>&lt;ns:CIVICO_EFD>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/numeroCivico&quot;/>&lt;/ns:CIVICO_EFD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo&quot;>&lt;ns:IDARLTI>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:IDARLTI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;CODECENTRALEACLRR&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;CODECENTRALEACLRR&amp;quot;]/valoreAttributo&quot;>&lt;ns:CODICE_CENTRALE_ACLRR>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;CODECENTRALEACLRR&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:CODICE_CENTRALE_ACLRR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;COPPIA&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;COPPIA&amp;quot;]/valoreAttributo&quot;>&lt;ns:COPPIA>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;COPPIA&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:COPPIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;IDSLUCO&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&lt;ns:IDSLUCO_NGOM>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:IDSLUCO_NGOM>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;BITRATE&amp;quot;]) and string-length($Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;BITRATE&amp;quot;]/valoreAttributo) >0&quot;>&lt;ns:DESTINAZIONEUSO>&lt;ns:DATI>&lt;xsl:if test=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;DESTINAZIONEUSO&amp;quot;]/valoreAttributo&quot;>&lt;ns:TIPODATI>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;DESTINAZIONEUSO&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:TIPODATI>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;BITRATE&amp;quot;]/valoreAttributo&quot;>&lt;ns:BITRATE>&lt;xsl:value-of select=&quot;$Start/tns:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;qu