                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AllineamentoSHA.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoXDSLATM.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoMigrazione.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoWLR.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoULLNA.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoSLULNA.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoNPG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoNGAVULA.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoULLLA.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoXDSLGBE.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoVLAN_VP.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoNPNG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoCPS.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoSLULA.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoVULL.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AllineamentoVariazione.Output&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RESPONSE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoNPNG.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNPNG.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNPNG.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNPNG.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoNPNG.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoNPNG.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoVLAN_VP.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVLAN_VP.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVLAN_VP.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVLAN_VP.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoVLAN_VP.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoVLAN_VP.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoCPS.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoCPS.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoCPS.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoCPS.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoCPS.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoCPS.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoVariazione.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVariazione.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVariazione.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVariazione.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoVariazione.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoVariazione.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoVULL.Output/tns:RESPONSE)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVULL.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVULL.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoVULL.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoVULL.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoVULL.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoWLR.Output/tns:RESPONSE)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoWLR.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoWLR.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoWLR.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoWLR.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoWLR.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoMigrazione.Output/tns:RESPONSE)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoMigrazione.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoMigrazione.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoMigrazione.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoMigrazione.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoMigrazione.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoULLLA.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoULLLA.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoULLLA.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoULLLA.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoULLLA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoULLLA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoSLULNA.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSLULNA.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSLULNA.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSLULNA.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoSLULNA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoSLULNA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoXDSLGBE.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoXDSLGBE.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoXDSLGBE.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoXDSLGBE.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoXDSLGBE.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoXDSLGBE.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoXDSLATM.Output/tns:RESPONSE)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoXDSLATM.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoXDSLATM.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoXDSLATM.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoXDSLATM.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoXDSLATM.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoNPG.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNPG.Output/tns:RESPONSE_NP[1]/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNPG.Output/tns:RESPONSE_NP[1]/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNPG.Output/tns:RESPONSE_NP[1]/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoNPG.Output/tns:RESPONSE_NP[1]/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoNPG.Output/tns:RESPONSE_NP[1]/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoNGAVULA.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNGAVULA.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNGAVULA.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoNGAVULA.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoNGAVULA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoNGAVULA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoSLULA.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSLULA.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSLULA.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSLULA.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoSLULA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoSLULA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($AllineamentoSHA.Output)&quot;>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSHA.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSHA.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoSHA.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoSHA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoSHA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoULLNA.Output/tns:RESPONSE/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoULLNA.Output/tns:RESPONSE/tns:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$AllineamentoULLNA.Output/tns:RESPONSE/tns:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$AllineamentoULLNA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;>&#xa;                            &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                &lt;xsl:value-of select=&quot;$AllineamentoULLNA.Output/tns:RESPONSE/tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                            &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RESPONSE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:NOWtoCRMWSAllineamentoConsistenza="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
