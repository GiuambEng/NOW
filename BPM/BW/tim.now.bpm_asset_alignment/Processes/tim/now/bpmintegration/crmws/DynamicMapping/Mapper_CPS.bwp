    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://NOW.it.telecomitalia.it/casedata_v1"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeCPS/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:REQUEST" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogStartMapper_CPS-input" sca-bpel:internal="true"/>
        <bpws:variable name="LogLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable element="ns3:REQUEST"
            name="MapperAttivazione-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:REQUEST" name="MapperAttivazione" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:REQUEST"
            name="MapperCessazione-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:REQUEST" name="MapperCessazione" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogMapperAttivazioneVariazione-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogCessazioneCPS-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:RESPONSE"
            name="MapperOutputCPS-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:RESPONSE" name="MapperOutputCPS" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogMapperOutputCPS-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogENDMapper_CPS-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:FaultDetail" name="FaultDetails" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogFaultMapper_CPS-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:RESPONSE" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogAltreLavorazioni-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Request"
            name="CODE_OLOMigrazione-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:Response" name="CODE_OLOMigrazione" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="ae11f872-5bf8-424a-9553-e1323a4a4b91">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link
                                name="LogFaultMapper_SLULAToRethrow" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogFaultMapper_CPS-input"
                                name="LogFaultMapper_CPS"
                                tibex:xpdlId="87b59a9c-e0ba-4b24-96aa-98052008abb0"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogFaultMapper_SLULAToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LogFaultMapper_CPS-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_CPS&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_CPS&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_CPS&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:MsgCode>&lt;tns:Message>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails,true(),true())&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;'Error'&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws.DynamicMapping'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_SHA&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;'Mapper_SHA_ERROR'&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_SHA_&amp;quot;, $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:ErrorLog>&lt;tns:TimeStamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:TimeStamp>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;concat('Errore su Mapper_SHA , id_richiesta: ', $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&lt;/tns:Descrizione>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:Codice>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:ErrorReport>&lt;tns:StackTrace>&lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&lt;/tns:StackTrace>&lt;tns:Msg>&lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&lt;/tns:Msg>&lt;tns:ProcessStack>&lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&lt;/tns:ProcessStack>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&lt;/tns:MsgCode>&lt;tns:Data/>&lt;/tns:ErrorReport>&lt;/tns:ErrorLog>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="f506874a-f692-4b7a-8f42-d431b8f1c9f4">
                            <bpws:targets>
                                <bpws:target linkName="LogFaultMapper_SLULAToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartMapper_SHAToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToMapper_AttVar"
                    tibex:label="Att/Var" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="EmptyToEmpty1" tibex:label="Ces" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="MapperToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="Mapper2ToCallProcess2" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallProcessToEmpty2" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess2ToEmpty2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty2ToMapper3" tibex:linkType="SUCCESS"/>
                <bpws:link name="Mapper3ToCallProcess3" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess3ToCallProcess4" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess4ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToLogENDMapper_SHA" tibex:linkType="SUCCESS"/>
                <bpws:link name="Empty1ToMapperCessazione" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Empty1ToCODE_OLOMigrazione" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CODE_OLOMigrazioneToMapperCessazione" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="d09c9c8d-490e-486c-be83-d66a901a5159"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="7884a419-6904-4db7-b562-bfc36b32fc2d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess4ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperOutputCPS&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:RESPONSE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperOutputCPS/tns:RESPONSE)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MapperOutputCPS/tns:RESPONSE&quot;>&#xa;                        &lt;tns:RESPONSE>&#xa;                            &lt;tns:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns:TRANSACTION_ID>&#xa;                            &lt;tns:RESPONSE_DATE>&#xa;                                &lt;xsl:value-of select=&quot;tns:RESPONSE_DATE&quot;/>&#xa;                            &lt;/tns:RESPONSE_DATE>&#xa;                            &lt;tns:RETURN_CODE>&#xa;                                &lt;xsl:value-of select=&quot;tns:RETURN_CODE&quot;/>&#xa;                            &lt;/tns:RETURN_CODE>&#xa;                            &lt;xsl:if test=&quot;tns:DESCRIZIONE_ERRORE&quot;>&#xa;                                &lt;tns:DESCRIZIONE_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DESCRIZIONE_ERRORE&quot;/>&#xa;                                &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:COD_SRVZ&quot;>&#xa;                                &lt;tns:COD_SRVZ>&#xa;                                    &lt;xsl:value-of select=&quot;tns:COD_SRVZ&quot;/>&#xa;                                &lt;/tns:COD_SRVZ>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:CREATED>&#xa;                                &lt;xsl:value-of select=&quot;tns:CREATED&quot;/>&#xa;                            &lt;/tns:CREATED>&#xa;                            &lt;xsl:if test=&quot;tns:ID_ASSET_CRMWS&quot;>&#xa;                                &lt;tns:ID_ASSET_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_ASSET_CRMWS&quot;/>&#xa;                                &lt;/tns:ID_ASSET_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ID_ASSET_NOW>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_ASSET_NOW&quot;/>&#xa;                            &lt;/tns:ID_ASSET_NOW>&#xa;                            &lt;xsl:if test=&quot;tns:ID_ORDN&quot;>&#xa;                                &lt;tns:ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_ORDN&quot;/>&#xa;                                &lt;/tns:ID_ORDN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&#xa;                                &lt;tns:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&#xa;                                &lt;/tns:ID_RISORSA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:LAVRZ&quot;>&#xa;                                &lt;tns:LAVRZ>&#xa;                                    &lt;xsl:value-of select=&quot;tns:LAVRZ&quot;/>&#xa;                                &lt;/tns:LAVRZ>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:MESSAGGIO&quot;>&#xa;                                &lt;tns:MESSAGGIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:MESSAGGIO&quot;/>&#xa;                                &lt;/tns:MESSAGGIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:STATO&quot;>&#xa;                                &lt;tns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:STATO&quot;/>&#xa;                                &lt;/tns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:TRANSACTION_ID_ROOT&quot;>&#xa;                                &lt;tns:TRANSACTION_ID_ROOT>&#xa;                                    &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_ROOT&quot;/>&#xa;                                &lt;/tns:TRANSACTION_ID_ROOT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:TRANSACTION_ID_PARENT&quot;>&#xa;                                &lt;tns:TRANSACTION_ID_PARENT>&#xa;                                    &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_PARENT&quot;/>&#xa;                                &lt;/tns:TRANSACTION_ID_PARENT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:CODICE_OLO&quot;>&#xa;                                &lt;tns:CODICE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns:CODICE_OLO&quot;/>&#xa;                                &lt;/tns:CODICE_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ROW_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns:ROW_ID&quot;/>&#xa;                            &lt;/tns:ROW_ID>&#xa;                            &lt;xsl:if test=&quot;tns:CREATED_BY&quot;>&#xa;                                &lt;tns:CREATED_BY>&#xa;                                    &lt;xsl:value-of select=&quot;tns:CREATED_BY&quot;/>&#xa;                                &lt;/tns:CREATED_BY>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:LAST_UPD>&#xa;                                &lt;xsl:value-of select=&quot;tns:LAST_UPD&quot;/>&#xa;                            &lt;/tns:LAST_UPD>&#xa;                            &lt;xsl:if test=&quot;tns:LAST_UPD_BY&quot;>&#xa;                                &lt;tns:LAST_UPD_BY>&#xa;                                    &lt;xsl:value-of select=&quot;tns:LAST_UPD_BY&quot;/>&#xa;                                &lt;/tns:LAST_UPD_BY>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:MODIFICATION_NUM>&#xa;                                &lt;xsl:value-of select=&quot;tns:MODIFICATION_NUM&quot;/>&#xa;                            &lt;/tns:MODIFICATION_NUM>&#xa;                            &lt;tns:CONFLICT_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns:CONFLICT_ID&quot;/>&#xa;                            &lt;/tns:CONFLICT_ID>&#xa;                            &lt;xsl:if test=&quot;tns:DB_LAST_UPD&quot;>&#xa;                                &lt;tns:DB_LAST_UPD>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DB_LAST_UPD&quot;/>&#xa;                                &lt;/tns:DB_LAST_UPD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DB_LAST_UPD_SRC&quot;>&#xa;                                &lt;tns:DB_LAST_UPD_SRC>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DB_LAST_UPD_SRC&quot;/>&#xa;                                &lt;/tns:DB_LAST_UPD_SRC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:DN&quot;>&#xa;                                &lt;tns:DN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:DN&quot;/>&#xa;                                &lt;/tns:DN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:RESPONSE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:RESPONSE>&#xa;                        &lt;tns:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:TRANSACTION_ID>&#xa;                        &lt;tns:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:RESPONSE_DATE>&#xa;                        &lt;tns:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:RETURN_CODE>&#xa;                        &lt;tns:DESCRIZIONE_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:DESCRIZIONE_ERRORE>&#xa;                        &lt;tns:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:COD_SRVZ>&#xa;                        &lt;tns:CREATED>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:CREATED>&#xa;                        &lt;tns:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:ID_ASSET_CRMWS>&#xa;                        &lt;tns:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:ID_ASSET_NOW>&#xa;                        &lt;tns:ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:ID_ORDN>&#xa;                        &lt;tns:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:ID_RISORSA>&#xa;                        &lt;tns:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:LAVRZ>&#xa;                        &lt;tns:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:MESSAGGIO>&#xa;                        &lt;tns:STATO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                        &lt;/tns:STATO>&#xa;                        &lt;tns:ROW_ID>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:ROW_ID>&#xa;                        &lt;tns:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:CREATED_BY>&#xa;                        &lt;tns:LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns:LAST_UPD>&#xa;                        &lt;tns:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:LAST_UPD_BY>&#xa;                        &lt;tns:MODIFICATION_NUM>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns:MODIFICATION_NUM>&#xa;                        &lt;tns:CONFLICT_ID>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns:CONFLICT_ID>&#xa;                    &lt;/tns:RESPONSE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RESPONSE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogStartMapper_CPS-input"
                    name="LogStartMapper_CPS"
                    tibex:xpdlId="1162b477-dd90-4289-aa01-99ca4d01ffcd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartMapper_SHAToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;LogStartMapper_SHA-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_CPS&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_CPS&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_CPS&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start &amp;quot;&amp;quot;Mapper_CPS&amp;quot;&amp;quot;', tib:render-xml($Start, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws.DynamicMapping'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_SHA&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_SHA_&amp;quot;,&amp;quot;STARTED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_SHA_&amp;quot;, $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start))) &quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="a3bce699-fe84-493f-aeee-0a994fc38ff4">
                <bpws:targets>
                    <bpws:target linkName="LogStartMapper_SHAToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapper_AttVar">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/ns0:RICHIESTA/lavorazione)=&quot;ATTIVAZIONE&quot; or  $Start/ns0:LavorazioneAsset='ATTIVAZIONE' " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:RICHIESTA/lavorazione)="ATTIVAZIONE" or  $Start/ns0:LavorazioneAsset='ATTIVAZIONE' ]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:RICHIESTA/lavorazione=&quot;CESSAZIONE&quot; or $Start/ns0:LavorazioneAsset='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns0:RICHIESTA/lavorazione="CESSAZIONE" or $Start/ns0:LavorazioneAsset='CESSAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperAttivazione-input"
                    name="MapperAttivazione"
                    outputVariable="MapperAttivazione"
                    tibex:xpdlId="b8fa59c7-d4eb-4b38-8c5e-76193bbc466b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper_AttVar"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeCPS/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapperAttivazione-input&quot; match=&quot;/&quot;>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string($Start/tns2:NextVal),10,'0'))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns2:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codificaOLOAGCOM&quot;/>&lt;/ns:DESCOLO>&lt;ns:CPS>&lt;ns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;31&amp;quot;&quot;/>&lt;/ns:SERVIZIO>&lt;ns:ATTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/codiceOrdineOLO)>11&quot;>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns2:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineOLO&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineTI&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns2:IdContratto&quot;/>&lt;/ns:CONTRATTO>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDRisorsa&quot;/>&lt;/ns:RISORSA>&lt;xsl:if test=&quot;exists($Start/tns2:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAsset&quot;>&lt;ns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAsset&quot;/>&lt;/ns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;>&lt;ns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;/>&lt;/ns:ID_CRMWS>&lt;/xsl:if>&lt;ns:DEC>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/DES&quot;/>&lt;/ns:DEC>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns2:ASSET/distretto)))&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;xsl:if test=&quot;$Start/tns2:ASSET/CLLI&quot;>&lt;ns:CLLI_CENTRALE>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/CLLI&quot;/>&lt;/ns:CLLI_CENTRALE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPODNRICHIESTO&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPODNRICHIESTO&amp;quot;]/valoreAttributo&quot;>&lt;ns:TIPO_DN_RICHIESTO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPODNRICHIESTO&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:TIPO_DN_RICHIESTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPODNREALE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPODNREALE&amp;quot;]/valoreAttributo&quot;>&lt;ns:TIPO_DN_REALE>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPODNREALE&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:TIPO_DN_REALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEARICHIESTO&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEARICHIESTO&amp;quot;]/valoreAttributo&quot;>&lt;ns:TIPO_LINEA_RICHIESTO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEARICHIESTO&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:TIPO_LINEA_RICHIESTO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEAREALE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEAREALE&amp;quot;]/valoreAttributo&quot;>&lt;ns:TIPO_LINEA_REALE>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEAREALE&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:TIPO_LINEA_REALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITALINEE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITALINEE&amp;quot;]/valoreAttributo&quot;>&lt;ns:QUANTITALINEE>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITALINEE&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:QUANTITALINEE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DN&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DN&amp;quot;]/valoreAttributo&quot;>&lt;ns:DN>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DN&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:DN>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DNPRIMARIO&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DNPRIMARIO&amp;quot;]/valoreAttributo&quot;>&lt;ns:DNPRIMARIO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DNPRIMARIO&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:DNPRIMARIO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;OPZIONETRAFFICO&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;OPZIONETRAFFICO&amp;quot;]/valoreAttributo&quot;>&lt;ns:OPZIONETRAFFICO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;OPZIONETRAFFICO&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:OPZIONETRAFFICO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:DSC>&lt;xsl:value-of select=&quot;tib:create-date(xsd:integer(tib:substring-after-last($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DSC&amp;quot;]/valoreAttributo,'/')),&amp;#xD;&amp;#xA;xsd:integer(substring-after(tib:substring-before-last($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DSC&amp;quot;]/valoreAttributo,'/'),'/')),  xsd:integer(substring-before($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;DSC&amp;quot;]/valoreAttributo,'/')))&quot;/>&lt;/ns:DSC>&lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;RADICALE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;RADICALE&amp;quot;]/valoreAttributo&quot;>&lt;ns:RADICALE>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;RADICALE&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:RADICALE>&lt;/xsl:if>&lt;/xsl:if>&lt;ns:CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:RICHIESTA/ordine/cognomeRagioneSociale)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:RICHIESTA/ordine/cognomeRagioneSociale)>60&quot;>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;substring($Start/tns2:RICHIESTA/ordine/cognomeRagioneSociale,1,60)&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;$Start/tns2:RICHIESTA/ordine/cognomeRagioneSociale&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns2:RICHIESTA/ordine/nome&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;$Start/tns2:RICHIESTA/ordine/nome&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RICHIESTA/ordine/CF&quot;>&lt;ns:CF>&lt;xsl:value-of select=&quot;$Start/tns2:RICHIESTA/ordine/CF&quot;/>&lt;/ns:CF>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RICHIESTA/ordine/PIVA&quot;>&lt;ns:PIVA>&lt;xsl:value-of select=&quot;$Start/tns2:RICHIESTA/ordine/PIVA&quot;/>&lt;/ns:PIVA>&lt;/xsl:if>&lt;/ns:CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Start/tns2:RecordAsset)>0&quot;>&lt;ns:SEDE>&lt;ns:PARTICELLATOPONOMASTICA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrParticellaTopon&quot;/>&lt;/ns:PARTICELLATOPONOMASTICA>&lt;ns:VIA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrVia&quot;/>&lt;/ns:VIA>&lt;ns:CIVICO>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:NumeroCivico&quot;/>&lt;/ns:CIVICO>&lt;ns:LOCALITA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrComune&quot;/>&lt;/ns:LOCALITA>&lt;ns:CAP>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:CAP&quot;/>&lt;/ns:CAP>&lt;xsl:if test=&quot;$Start/tns2:ASSET/complesso&quot;>&lt;ns:COMPLESSO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/complesso&quot;/>&lt;/ns:COMPLESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/scala&quot;>&lt;ns:SCALA>&lt;xsl:value-o