                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeCPS/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CODE_OLOMigrazione&quot;/>&lt;xsl:template name=&quot;MapperCessazione-input&quot; match=&quot;/&quot;>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string($Start/tns2:NextVal),10,'0'))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:RICHIESTA/canaleRichiesta='SDR'&quot;>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$CODE_OLOMigrazione/tns:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns2:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codificaOLOAGCOM&quot;/>&lt;/ns:DESCOLO>&lt;ns:CPS>&lt;ns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;31&amp;quot;&quot;/>&lt;/ns:SERVIZIO>&lt;ns:CESSAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/codiceOrdineOLO)>11&quot;>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns2:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICEORDINEOLO>&l