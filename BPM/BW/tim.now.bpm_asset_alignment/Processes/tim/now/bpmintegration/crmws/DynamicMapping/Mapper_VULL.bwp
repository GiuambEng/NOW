                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVULL/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AttivazioneVULL-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns1:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:DESCOLO>&lt;tns:VULL>&lt;tns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;19&amp;quot;&quot;/>&lt;/tns:CRMWS_SERVICE>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta='VULLLINEANONATTIVA'&quot;>&lt;tns:FLAG_LNA>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/tns:FLAG_LNA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FLAG_LNA>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FLAG_LNA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ATT_VAR_ACCESSO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineOLO)>11&quot;>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns1:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns1:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/IDAssetCRMWS)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;INDICATORADIASSURANCE&amp;quot;]/valoreAttributo)&quot;>&lt;tns:INDICATOREDIASSURANCE>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;INDICATOREDIASSURANCE&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:INDICATOREDIASSURANCE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:INDICATOREDIASSURANCE>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:INDICATOREDIASSURANCE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo=&amp;quot;0&amp;quot;&quot;>&lt;tns:MANTENIMENTO_PRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:MANTENIMENTO_PRODOTTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MANTENIMENTO_PRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/tns:MANTENIMENTO_PRODOTTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns:TIPO_DN>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,&amp;quot;ACCESSO&amp;quot;)]/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:TIPO_DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TIPO_DN>&lt;xsl:value-of select=&quot;&amp;quot;---&amp;quot;&quot;/>&lt;/tns:TIPO_DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:TIPO_LINEA>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;STRUTTURALINEA&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:TIPO_LINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITACANALI&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITACANALI&amp;quot;]/valoreAttributo&quot;>&lt;tns:QUANTITA_LINEE_CANALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITACANALI&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:QUANTITA_LINEE_CANALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITALINEE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITALINEE&amp;quot;]/valoreAttributo&quot;>&lt;tns:QUANTITA_LINEE_CANALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;QUANTITALINEE&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:QUANTITA_LINEE_CANALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;CAPOSTIPITE&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;CAPOSTIPITE&amp;quot;]/valoreAttributo&quot;>&lt;tns:CAPOSTIPITE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;CAPOSTIPITE&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:CAPOSTIPITE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns1:ASSET/distretto)))&quot;/>&lt;/tns:DISTR_TELEFONICO>&lt;tns:PLATFORM_CODE>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOVULL&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;CODICEPIATTAFORMA&amp;quot;]/valoreAttributo)&quot;/>&lt;/tns:PLATFORM_CODE>&lt;tns:CLLI_CENTRALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/CLLI&quot;/>&lt;/tns:CLLI_CENTRALE>&lt;tns:CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale)>60&quot;>&lt;tns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;substring($Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale,1, 60)&quot;/>&lt;/tns:COGNOMERAGSOC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale&quot;/>&lt;/tns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RICHIESTA/ordine/nome)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RICHIESTA/ordine/nome&quot;>&lt;tns:NOME>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/nome&quot;/>&lt;/tns:NOME>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RICHIESTA/ordine/CF)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RICHIESTA/ordine/CF&quot;>&lt;tns:CF>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/CF&quot;/>&lt;/tns:CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RICHIESTA/ordine/PIVA)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RICHIESTA/ordine/PIVA&quot;>&lt;tns:PIVA>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/PIVA&quot;/>&lt;/tns:PIVA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Start/tns1:RecordAsset)>0&quot;>&lt;tns:SEDE>&lt;tns:PARTICELLATOPONOMASTICA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrParticellaTopon&quot;/>&lt;/tns:PARTICELLATOPONOMASTICA>&lt;tns:VIA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrVia&quot;/>&lt;/tns:VIA>&lt;tns:CIVICO>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:NumeroCivico&quot;/>&lt;/tns:CIVICO>&lt;tns:LOCALITA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrComune&quot;/>&lt;/tns:LOCALITA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:CAP)&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CAP>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CAP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/complesso)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/complesso&quot;>&lt;tns:COMPLESSO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/complesso&quot;/>&lt;/tns:COMPLESSO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/scala)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/scala&quot;>&lt;tns:SCALA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/scala&quot;/>&lt;/tns:SCALA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/piano)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/piano&quot;>&lt;tns:PIANO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/piano&quot;/>&lt;/tns:PIANO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/interno)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/interno&quot;>&lt;tns:INTERNO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/interno&quot;/>&lt;/tns:INTERNO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:Cod_Topon&quot;>&lt;tns:CODICEINDIRIZZO>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:Cod_Topon&quot;/>&lt;/tns:CODICEINDIRIZZO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RecordAsset[1]/tns1:CodISTATComune)>0&quot;>&lt;tns:CODICECOMUNE>&lt;xsl:value-of select=&quot;substring($Start/tns1:RecordAsset[1]/tns1:CodISTATComune,string-length($Start/tns1:RecordAsset[1]/tns1:CodISTATComune)-2,3)&quot;/>&lt;/tns:CODICECOMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICECOMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICECOMUNE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:CodVia)&quot;>&lt;tns:CODESTRADA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:CodVia&quot;/>&lt;/tns:CODESTRADA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODESTRADA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODESTRADA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:DescrProv)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrProv&quot;>&lt;tns:PROVINCIA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrProv&quot;/>&lt;/tns:PROVINCIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:SiglaProv)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:SiglaProv&quot;>&lt;tns:SIGLAPROVINCIA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:SiglaProv&quot;/>&lt;/tns:SIGLAPROVINCIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:DR)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:DR&quot;>&lt;tns:DR>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DR&quot;/>&lt;/tns:DR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RecordAsset[1]/tns1:CodISTATComune)>0&quot;>&lt;tns:ISTATPROV>&lt;xsl:value-of select=&quot;substring($Start