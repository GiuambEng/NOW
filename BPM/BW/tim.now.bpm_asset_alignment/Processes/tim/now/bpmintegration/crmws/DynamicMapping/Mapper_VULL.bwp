                <bpws:sources>
                    <bpws:source linkName="EmptyToMapper_AttivazioneVariazione">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:RICHIESTA/lavorazione=&quot;ATTIVAZIONE&quot; or $Start/ns1:RICHIESTA/lavorazione=&quot;VARIAZIONE&quot; or $Start/ns1:LavorazioneAsset='ATTIVAZIONE' or $Start/ns1:LavorazioneAsset='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:RICHIESTA/lavorazione="ATTIVAZIONE" or $Start/ns1:RICHIESTA/lavorazione="VARIAZIONE" or $Start/ns1:LavorazioneAsset='ATTIVAZIONE' or $Start/ns1:LavorazioneAsset='VARIAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToMapper1_Ces">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:RICHIESTA/lavorazione=&quot;CESSAZIONE&quot; or $Start/ns1:LavorazioneAsset='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:RICHIESTA/lavorazione="CESSAZIONE" or $Start/ns1:LavorazioneAsset='CESSAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AttivazioneVULL-input"
                    name="AttivazioneVULL"
                    outputVariable="AttivazioneVULL"
                    tibex:xpdlId="329b0cfc-1cac-4325-9b08-224c77038da8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper_AttivazioneVariazione"/>
