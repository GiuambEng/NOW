                    inputVariable="Variazione-input" name="Variazione"
                    outputVariable="Variazione"
                    tibex:xpdlId="78e82afd-2300-4729-ab73-3be7ea7e346e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
