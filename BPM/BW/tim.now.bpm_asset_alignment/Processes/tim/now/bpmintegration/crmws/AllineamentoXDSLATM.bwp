&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/InsertOGG" xmlns:tns3="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertOGG" xmlns:tns2="http://www.tim.com/NOW/xsd/SequenceOGG" version="2.0"&gt;&lt;xsl:param name="NOWtoCRMWS_AllineamentoXDSLATMIn"/&gt;&lt;xsl:param name="DynamicProcess"/&gt;&lt;xsl:param name="SequenceOGG"/&gt;&lt;xsl:template name="InsertOGG-input" match="/"&gt;&lt;tns1:InsertOGGRequest&gt;&lt;Input&gt;&lt;tns5:Record&gt;&lt;xsl:for-each select="$DynamicProcess/tns:RESPONSE"&gt;&lt;tns5:Record&gt;&lt;xsl:if test="tns:COD_SRVZ"&gt;&lt;tns5:COD_SRVZ&gt;&lt;xsl:value-of select="tns:COD_SRVZ"/&gt;&lt;/tns5:COD_SRVZ&gt;&lt;/xsl:if&gt;&lt;tns5:CREATED&gt;&lt;xsl:value-of select="tns:CREATED"/&gt;&lt;/tns5:CREATED&gt;&lt;xsl:if test="tns:ID_ASSET_CRMWS"&gt;&lt;tns5:ID_ASSET_CRMWS&gt;&lt;xsl:value-of select="tns:ID_ASSET_CRMWS"/&gt;&lt;/tns5:ID_ASSET_CRMWS&gt;&lt;/xsl:if&gt;&lt;tns5:ID_ASSET_NOW&gt;&lt;xsl:value-of select="tns:ID_ASSET_NOW"/&gt;&lt;/tns5:ID_ASSET_NOW&gt;&lt;xsl:if test="tns:ID_ORDN"&gt;&lt;tns5:ID_ORDN&gt;&lt;xsl:value-of select="tns:ID_ORDN"/&gt;&lt;/tns5:ID_ORDN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:ID_RISORSA"&gt;&lt;tns5:ID_RISORSA&gt;&lt;xsl:value-of select="tns:ID_RISORSA"/&gt;&lt;/tns5:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:LAVRZ"&gt;&lt;tns5:LAVRZ&gt;&lt;xsl:value-of select="tns:LAVRZ"/&gt;&lt;/tns5:LAVRZ&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:MESSAGGIO"&gt;&lt;tns5:MESSAGGIO&gt;&lt;xsl:value-of select="tns:MESSAGGIO"/&gt;&lt;/tns5:MESSAGGIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:STATO"&gt;&lt;tns5:STATO&gt;&lt;xsl:value-of select="tns:STATO"/&gt;&lt;/tns5:STATO&gt;&lt;/xsl:if&gt;&lt;tns5:TRANSACTION_ID&gt;&lt;xsl:value-of select="tns:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT)&gt;0"&gt;&lt;xsl:if test="$SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT"&gt;&lt;tns5:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="$SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT"/&gt;&lt;/tns5:TRANSACTION_ID_PARENT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="tns:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID_PARENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT)"&gt;&lt;xsl:if test="$SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT"&gt;&lt;tns5:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="$SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT"/&gt;&lt;/tns5:TRANSACTION_ID_ROOT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="tns:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID_ROOT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="tns:CODICE_OLO"&gt;&lt;tns5:CODICE_OLO&gt;&lt;xsl:value-of select="tns:CODICE_OLO"/&gt;&lt;/tns5:CODICE_OLO&gt;&lt;/xsl:if&gt;&lt;tns5:ROW_ID&gt;&lt;xsl:value-of select="tns:ROW_ID"/&gt;&lt;/tns5:ROW_ID&gt;&lt;xsl:if test="tns:CREATED_BY"&gt;&lt;tns5:CREATED_BY&gt;&lt;xsl:value-of select="tns:CREATED_BY"/&gt;&lt;/tns5:CREATED_BY&gt;&lt;/xsl:if&gt;&lt;tns5:LAST_UPD&gt;&lt;xsl:value-of select="tns:LAST_UPD"/&gt;&lt;/tns5:LAST_UPD&gt;&lt;xsl:if test="tns:LAST_UPD_BY"&gt;&lt;tns5:LAST_UPD_BY&gt;&lt;xsl:value-of select="tns:LAST_UPD_BY"/&gt;&lt;/tns5:LAST_UPD_BY&gt;&lt;/xsl:if&gt;&lt;tns5:MODIFICATION_NUM&gt;&lt;xsl:value-of select="tns:MODIFICATION_NUM"/&gt;&lt;/tns5:MODIFICATION_NUM&gt;&lt;tns5:CONFLICT_ID&gt;&lt;xsl:value-of select="tns:CONFLICT_ID"/&gt;&lt;/tns5:CONFLICT_ID&gt;&lt;xsl:if