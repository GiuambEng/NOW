ot;$Asset/Output/tns3:Response/tns3:RecordIdContratto[1]/tns3:ID_CONTRATTO_CRMWS&quot;/>&lt;/tns1:IdContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Asset/Output/tns3:Response/tns3:RecordAssetToponomastica)>0&quot;>&lt;xsl:for-each select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica&quot;>&lt;tns1:RecordAsset>&lt;tns1:NumeroCivico>&lt;xsl:value-of select=&quot;tns3:NUMERO_CIVICO&quot;/>&lt;/tns1:NumeroCivico>&lt;tns1:CAP>&lt;xsl:value-of select=&quot;tns3:CAP&quot;/>&lt;/tns1:CAP>&lt;xsl:if test=&quot;tns3:DR&quot;>&lt;tns1:DR>&lt;xsl:value-of select=&quot;tns3:DR&quot;/>&lt;/tns1:DR>&lt;/xsl:if>&lt;tns1:DescrParticellaTopon>&lt;xsl:value-of select=&quot;tns3:DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns1:DescrParticellaTopon>&lt;tns1:DescrVia>&lt;xsl:value-of select=&quot;tns3:DESCR_VIA&quot;/>&lt;/tns1:DescrVia>&lt;tns1:CodISTATComune>&lt;xsl:value-of select=&quot;tns3:COD_ISTAT_COMUNE&quot;/>&lt;/tns1:CodISTATComune>&lt;tns1:CodVia>&lt;xsl:value-of select=&quot;xsd:int(tns3:COD_VIA)&quot;/>&lt;/tns1:CodVia>&lt;tns1:DescrComune>&lt;xsl:value-of select=&quot;tns3:DESCR_COMUNE&quot;/>&lt;/tns1:DescrComune>&lt;tns1:SiglaProv>&lt;xsl:value-of select=&quot;tns3:SIGLA_PROV&quot;/>&lt;/tns1:SiglaProv>&lt;tns1:CodISTATProv>&lt;xsl:value-of select=&quot;tns3:COD_ISTAT_PROV&quot;/>&lt;/tns1:CodISTATProv>&lt;tns1:DescrProv>&lt;xsl:value-of select=&quot;tns3:DESCR_PROV&quot;/>&lt;/tns1:DescrProv>&lt;tns1:Cod_Topon>&lt;xsl:value-of select=&quot;tns3:COD_TOPON&quot;/>&lt;/tns1:Cod_Topon>&lt;xsl:if test=&quot;tns3:COD_COMUNE&quot;>&lt;tns1:Cod_Comune>&lt;xsl:value-of select=&quot;tns3:COD_COMUNE&quot;/>&lt;/tns1:Cod_Comune>&lt;/xsl:if>&lt;/tns1:RecordAsset>&lt;/xsl:for-each>&lt;/xsl:if>&lt;tns1:CODE_OLO>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn/Input/tns:REQUEST/tns:SERVIZIO/tns:CODICE_OLO&quot;/>&lt;/tns1:CODE_OLO>&lt;/tns1:REQUEST>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="DynamicProcess-input"
                    name="DynamicProcess"
                    outputVariable="DynamicProcess"
                    tibex:xpdlId="636f6ee1-7d33-4034-919e-b4f968e68608"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StatoToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToLogDynamicProcess"/>
                        <bpws:source
                            linkName="DynamicProcessToCallProcess2"
                            tibex:faultDetailsVar="DynamicProcess" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Asset.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoXDSLATMIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceOGG.Output&quot;/>&#xa;    &lt;xsl:template name=&quot;DynamicProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:REQUEST>&#xa;            &lt;tns1:ASSET>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn.Input/tns:ASSETPRINCIPALE/IDAsset&quot;>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn.Input/tns:ASSETPRINCIPALE/IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                &lt;/xsl:if>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn.Input/tns:ASSETPRINCIPALE/codiceOrdineOLO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn.Input/tns:ASSETPRINCIPALE/codiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn.Input/tns:ASSETPRINCIPALE/codiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_Allin