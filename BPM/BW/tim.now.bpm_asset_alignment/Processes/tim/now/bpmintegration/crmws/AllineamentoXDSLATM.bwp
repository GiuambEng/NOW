                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertOGG&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoXDSLATMIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceOGG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicProcess&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertOGG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Record>&#xa;            &lt;xsl:for-each select=&quot;$DynamicProcess/tns:RESPONSE&quot;>&#xa;                &lt;tns5:Record>&#xa;                    &lt;xsl:if test=&quot;tns:COD_SRVZ&quot;>&#xa;                        &lt;tns5:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;tns:COD_SRVZ&quot;/>&#xa;                        &lt;/tns5:COD_SRVZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:CREATED>&#xa;                        &lt;xsl:value-of select=&quot;tns:CREATED&quot;/>&#xa;                    &lt;/tns5:CREATED>&#xa;                    &lt;xsl:if test=&quot;tns:ID_ASSET_CRMWS&quot;>&#xa;                        &lt;tns5:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;tns:ID_ASSET_CRMWS&quot;/>&#xa;                        &lt;/tns5:ID_ASSET_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:ID_ASSET_NOW>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_ASSET_NOW&quot;/>&#xa;                    &lt;/tns5:ID_ASSET_NOW>&#xa;                    &lt;xsl:if test=&quot;tns:ID_ORDN&quot;>&#xa;                        &lt;tns5:ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;tns:ID_ORDN&quot;/>&#xa;                        &lt;/tns5:ID_ORDN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&#xa;                        &lt;tns5:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&#xa;                        &lt;/tns5:ID_RISORSA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:LAVRZ&quot;>&#xa;                        &lt;tns5:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;tns:LAVRZ&quot;/>&#xa;                        &lt;/tns5:LAVRZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:MESSAGGIO&quot;>&#xa;                        &lt;tns5:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tns:MESSAGGIO&quot;/>&#xa;                        &lt;/tns5:MESSAGGIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:STATO&quot;>&#xa;                        &lt;tns5:STATO>&#xa;                            &lt;xsl:value-of select=&quot;tns:STATO&quot;/>&#xa;                        &lt;/tns5:STATO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns5:TRANSACTION_ID>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT&quot;>&#xa;                                &lt;tns5:TRANSACTION_ID_PARENT>&#xa;                                    &lt;xsl:value-of select=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT&quot;/>&#xa;                                &lt;/tns5:TRANSACTION_ID_PARENT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:TRANSACTION_ID_PARENT>&#xa;                                &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns5:TRANSACTION_ID_PARENT>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT)&quot;>&#xa;                            &lt;xsl:if test=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT&quot;>&#xa;                                &lt;tns5:TRANSACTION_ID_ROOT>&#xa;                                    &lt;xsl:value-of select=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT&quot;/>&#xa;                                &lt;/tns5:TRANSACTION_ID_ROOT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:TRANSACTION_ID_ROOT>&#xa;                                &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns5:TRANSACTION_ID_ROOT>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;tns:CODICE_OLO&quot;>&#xa;                        &lt;tns5:CODICE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;tns:CODICE_OLO&quot;/>&#xa;                        &lt;/tns5:CODICE_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:ROW_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:ROW_ID&quot;/>&#xa;                    &lt;/tns5:ROW_ID>&#xa;                    &lt;xsl:if test=&quot;tns:CREATED_BY&quot;>&#xa;                        &lt;tns5:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns:CREATED_BY&quot;/>&#xa;                        &lt;/tns5:CREATED_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:LAST_UPD>&#xa;                        &lt;xsl:value-of select=&quot;tns:LAST_UPD&quot;/>&#xa;                    &lt;/tns5:LAST_UPD>&#xa;                    &lt;xsl:if test=&quot;tns:LAST_UPD_BY&quot;>&#xa;                        &lt;tns5:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns:LAST_UPD_BY&quot;/>&#xa;                        &lt;/tns5:LAST_UPD_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:MODIFICATION_NUM>&#xa;                        &lt;xsl:value-of select=&quot;tns:MODIFICATION_NUM&quot;/>&#xa;                    &lt;/tns5:MODIFICATION_NUM>&#xa;                    &lt;tns5:CONFLICT_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:CONFLICT_ID&quot;/>&#xa;                    &lt;/tns5:CONFLICT_ID>&#xa;                    &lt;xsl:if test=&quot;tns:DB_LAST_UPD&quot;>&#xa;                        &lt;tns5:DB_LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;tns:DB_LAST_UPD&quot;/>&#xa;                        &lt;/tns5:DB_LAST_UPD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DB_LAST_UPD_SRC&quot;>&#xa;                        &lt;tns5:DB_LAST_UPD_SRC>&#xa;                            &lt;xsl:value-of select=&quot;tns:DB_LAST_UPD_SRC&quot;/>&#xa;                        &lt;/tns5:DB_LAST_UPD_SRC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DN&quot;>&#xa;                        &lt;tns5:DN>&#xa;                            &lt;xsl:value-of select=&quot;tns:DN&quot;/>&#xa;                        &lt;/tns5:DN>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:Record>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn.Input/tns3:ASSETPRINCIPALE/IDRichiestaOLO&quot;>&#xa;                &lt;tns5:Id_rich_olo>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoXDSLATMIn.Input/tns3:ASSETPRINCIPALE/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns5:Id_rich_olo>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:Record>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
