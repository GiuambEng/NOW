                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperOutputSHA&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperOutputSHA/tns:RESPONSE)&quot;>&lt;xsl:for-each select=&quot;$MapperOutputSHA/tns:RESPONSE&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;tns:RESPONSE_DATE&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;tns:RETURN_CODE&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:if test=&quot;tns:DESCRIZIONE_ERRORE&quot;>&lt;tns:DESCRIZIONE_ERRORE>&lt;xsl:value-of select=&quot;tns:DESCRIZIONE_ERRORE&quot;/>&lt;/tns:DESCRIZIONE_ERRORE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COD_SRVZ&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;tns:COD_SRVZ&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;tns:CREATED&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;tns:ID_ASSET_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;tns:ID_ASSET_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;tns:ID_ASSET_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;tns:ID_ORDN&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;tns:ID_ORDN&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:LAVRZ&quot;>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;tns:LAVRZ&quot;/>&lt;/tns:LAVRZ>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MESSAGGIO&quot;>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;tns:MESSAGGIO&quot;/>&lt;/tns:MESSAGGIO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;tns:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TRANSACTION_ID_ROOT&quot;>&lt;tns:TRANSACTION_ID_ROOT>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_ROOT&quot;/>&lt;/tns:TRANSACTION_ID_ROOT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TRANSACTION_ID_PARENT&quot;>&lt;tns:TRANSACTION_ID_PARENT>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_PARENT&quot;/>&lt;/tns:TRANSACTION_ID_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CODICE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;tns:CODICE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;tns:ROW_ID&quot;/>&lt;/tns:ROW_ID>&lt;xsl:if test=&quot;tns:CREATED_BY&quot;>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;tns:CREATED_BY&quot;/>&lt;/tns:CREATED_BY>&lt;/xsl:if>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;tns:LAST_UPD&quot;/>&lt;/tns:LAST_UPD>&lt;xsl:if test=&quot;tns:LAST_UPD_BY&quot;>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;tns:LAST_UPD_BY&quot;/>&lt;/tns:LAST_UPD_BY>&lt;/xsl:if>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;tns:MODIFICATION_NUM&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;tns:CONFLICT_ID&quot;/>&lt;/tns:CONFLICT_ID>&lt;xsl:if test=&quot;tns:DB_LAST_UPD&quot;>&lt;tns:DB_LAST_UPD>&lt;xsl:value-of select=&quot;tns:DB_LAST_UPD&quot;/>&lt;/tns:DB_LAST_UPD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DB_LAST_UPD_SRC&quot;>&lt;tns:DB_LAST_UPD_SRC>&lt;xsl:value-of select=&quot;tns:DB_LAST_UPD_SRC&quot;/>&lt;/tns:DB_LAST_UPD_SRC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;/tns:RESPONSE>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;tns:DESCRIZIONE_ERRORE>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:DESCRIZIONE_ERRORE>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:COD_SRVZ>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:CREATED>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:ID_ORDN>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:STATO>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CREATED_BY>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:LAST_UPD_BY>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CONFLICT_ID>&lt;/tns:RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RESPONSE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogStartMapper_SHA-input"
                    name="LogStartMapper_SHA"
                    tibex:xpdlId="1162b477-dd90-4289-aa01-99ca4d01ffcd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartMapper_SHAToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;LogStartMapper_SHA-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_SHA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_SHA&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_SHA&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start &amp;quot;Mapper_SHA&amp;quot;', tib:render-xml($Start, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws.DynamicMapping'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_SHA&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_SHA_&amp;quot;,&amp;quot;STARTED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_SHA_&amp;quot;, $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start))) &quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="a3bce699-fe84-493f-aeee-0a994fc38ff4">
                <bpws:targets>
                    <bpws:target linkName="LogStartMapper_SHAToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapper_AttVar">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/ns0:RICHIESTA/lavorazione)=&quot;ATTIVAZIONE&quot; or upper-case($Start/ns0:RICHIESTA/lavorazione)=&quot;VARIAZIONE&quot; or $Start/ns0:LavorazioneAsset='ATTIVAZIONE' or $Start/ns0:LavorazioneAsset='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/ns0:RICHIESTA/lavorazione)="ATTIVAZIONE" or upper-case($Start/ns0:RICHIESTA/lavorazione)="VARIAZIONE" or $Start/ns0:LavorazioneAsset='ATTIVAZIONE' or $Start/ns0:LavorazioneAsset='VARIAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToMapper2_Ces">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:RICHIESTA/lavorazione=&quot;CESSAZIONE&quot; or $Start/ns0:LavorazioneAsset='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns0:RICHIESTA/lavorazione="CESSAZIONE" or $Start/ns0:LavorazioneAsset='CESSAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperAttivazioneVariazione-input"
                    name="MapperAttivazioneVariazione"
                    outputVariable="MapperAttivazioneVariazione"
                    tibex:xpdlId="b8fa59c7-d4eb-4b38-8c5e-76193bbc466b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper_AttVar"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeSHA/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapperAttivazioneVariazione-input&quot; match=&quot;/&quot;>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns1:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codificaOLOAGCOM&quot;/>&lt;/ns:DESCOLO>&lt;ns:SHA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta=&amp;quot;SHACONMANODOPERA&amp;quot;&quot;>&lt;ns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;20&amp;quot;&quot;/>&lt;/ns:CRMWS_SERVICE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;21&amp;quot;&quot;/>&lt;/ns:CRMWS_SERVICE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ATT_VAR_ACCESSO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineOLO)>11&quot;>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns1:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineOLO&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineTI&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns1:IdContratto&quot;/>&lt;/ns:CONTRATTO>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRisorsa&quot;/>&lt;/ns:RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAsset&quot;>&lt;ns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAsset&quot;/>&lt;/ns:ID_NOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/IDAssetCRMWS)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;>&lt;ns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;/>&lt;/ns:ID_CRMWS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:DEC>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/DES&quot;/>&lt;/ns:DEC>&lt;ns:CLLI_CENTRALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/CLLI&quot;/>&lt;/ns:CLLI_CENTRALE>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns1:ASSET/distretto)))&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/numeroTelefonico)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/numeroTelefonico&quot;>&lt;ns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/numeroTelefonico&quot;/>&lt;/ns:DN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;BITRATE&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;BITRATE&amp;quot;]/valoreAttributo&quot;>&lt;ns:BITRATE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;BITRATE&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:BITRATE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:POSIZIONEPERMUTATORE1>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;PERMUTATORE1&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:POSIZIONEPERMUTATORE1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;INDICATOREDIASSURANCE&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;INDICATOREDIASSURANCE&amp;quot;]/valoreAttributo&quot;>&lt;ns:INDICATOREDIASSURANCE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;INDICATOREDIASSURANCE&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:INDICATOREDIASSURANCE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:INDICATOREDIASSURANCE>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/ns:INDICATOREDIASSURANCE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSHA&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo=&amp;quot;0&amp;quot;&quot;>&lt;ns:MANTENIMENTOPRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/ns:MANTENIMENTOPRODOTTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:MANTENIMENTOPRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/ns:MANTENIMENTOPRODOTTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:IDULLCO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:IDULLCO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo&quot;>&lt;ns:IDARLTI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:IDARLTI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;CODICECENTRALEACLRR&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;CODICECENTRALEACLRR&amp;quot;]/valoreAttributo&quot;>&lt;ns:CODICE_CENTRALE_ACLRR>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSHA&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;CODICECENTRALEACLRR&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:CODICE_CENTRALE_ACLRR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo&quot;>&lt;ns:PERMUTA_CENTRALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo=&amp;quot;INDPERMUTAMANUALE&amp;quot;]/valoreAttributo&quot;/>&lt;/ns:PERMUTA_CENTRALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;ns:DATI_CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale)>60&quot;>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;substring($Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale,1, 60)&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/cognomeRagioneSociale&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RICHIESTA/ordine/nome)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RICHIESTA/ordine/nome&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/nome&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RICHIESTA/ordine/CF)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RICHIESTA/ordine/CF&quot;>&lt;ns:CF>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/CF&quot;/>&lt;/ns:CF>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RICHIESTA/ordine/PIVA)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RICHIESTA/ordine/PIVA&quot;>&lt;ns:PIVA>&lt;xsl:value-of select=&quot;$Start/tns1:RICHIESTA/ordine/PIVA&quot;/>&lt;/ns:PIVA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns:DATI_CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Start/tns1:RecordAsset)>0&quot;>&lt;ns:SEDE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:Cod_Topon)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:Cod_Topon&quot;>&lt;ns:CODICEINDIRIZZO>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:Cod_Topon&quot;/>&lt;/ns:CODICEINDIRIZZO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrParticellaTopon&quot;>&lt;ns:PARTICELLATOPONOMASTICA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrParticellaTopon&quot;/>&lt;/ns:PARTICELLATOPONOMASTICA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrVia&quot;>&lt;ns:VIA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrVia&quot;/>&lt;/ns:VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:NumeroCivico&quot;>&lt;ns:CIVICO>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:NumeroCivico&quot;/>&lt;/ns:CIVICO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrComune&quot;>&lt;ns:LOCALITA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrComune&quot;/>&lt;/ns:LOCALITA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:CAP)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:CAP&quot;>&lt;ns:CAP>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:CAP&quot;/>&lt;/ns:CAP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/complesso)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/complesso&quot;>&lt;ns:COMPLESSO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/complesso&quot;/>&lt;/ns:COMPLESSO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/scala)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/scala&quot;>&lt;ns:SCALA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/scala&quot;/>&lt;/ns:SCALA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/piano)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/piano&quot;>&lt;ns:PIANO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/piano&quot;/>&lt;/ns:PIANO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/interno)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/interno&quot;>&lt;ns:INTERNO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/interno&quot;/>&lt;/ns:INTERNO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RecordAsset[1]/tns1:CodISTATComune)>0&quot;>&lt;ns:CODICECOMUNE>&lt;xsl:value-of select=&quot;substring($Start/tns1:RecordAsset[1]/tns1:CodISTATComune, string-length($Start/tns1:RecordAsset[1]/tns1:CodISTATComune)-2, 3)&quot;/>&lt;/ns:CODICECOMUNE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset/tns1:CodVia)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:CodVia&quot;>&lt;ns:CODESTRADA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:CodVia&quot;/>&lt;/ns:CODESTRADA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset[1]/tns1:DescrProv)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrProv&quot;>&lt;ns:PROVINCIA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DescrProv&quot;/>&lt;/ns:PROVINCIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset[1]/tns1:SiglaProv)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:SiglaProv&quot;>&lt;ns:SIGLAPROVINCIA>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:SiglaProv&quot;/>&lt;/ns:SIGLAPROVINCIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:RecordAsset[1]/tns1:DR)&quot;>&lt;xsl:if test=&quot;$Start/tns1:RecordAsset[1]/tns1:DR&quot;>&lt;ns:DR>&lt;xsl:value-of select=&quot;$Start/tns1:RecordAsset[1]/tns1:DR&quot;/>&lt;/ns:DR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:RecordAsset[1]/tns1:CodISTATComune)>0&quot;>&lt;ns:ISTATPROV>&lt;xsl:value-of select=&quot;substring($Start/tns1:RecordAsset[1]/tns1:CodISTATComune,1,3)&quot;/>&lt;/ns:ISTATPROV>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/ns:SEDE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:SEDE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceToponomastica) > 0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/codiceToponomastica&quot;>&lt;ns:CODICEINDIRIZZO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceToponomastica&quot;/>&lt;/ns:CODICEINDIRIZZO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICEINDIRIZZO>&lt;xsl:value-of select=&quot;concat($Start/tns1:ASSET/codiceISTATProvincia, &amp;quot;_&amp;quot;, $Start/tns1:ASSET/codiceISTATComune, &amp;quot;_&amp;quot;, $Start/tns1:ASSET/numeroCivico)&quot;/>&lt;/ns:CODICEINDIRIZZO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/descrPartToponomastica)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/descrPartToponomastica&quot;>&lt;ns:PARTICELLATOPONOMASTICA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/descrPartToponomastica&quot;/>&lt;/ns:PARTICELLATOPONOMASTICA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/descrizioneVia)&quot;>&lt;xsl:if