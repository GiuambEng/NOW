                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertOGG&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoXDSLGBEIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceOGG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;CallInterfaccia&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertOGG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Record>&#xa;            &lt;xsl:for-each select=&quot;$CallInterfaccia/tns4:RESPONSE&quot;>&#xa;                &lt;tns5:Record>&#xa;                    &lt;xsl:if test=&quot;tns4:COD_SRVZ&quot;>&#xa;                        &lt;tns5:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;tns4:COD_SRVZ&quot;/>&#xa;                        &lt;/tns5:COD_SRVZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:CREATED>&#xa;                        &lt;xsl:value-of select=&quot;tns4:CREATED&quot;/>&#xa;                    &lt;/tns5:CREATED>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_ASSET_CRMWS&quot;>&#xa;                        &lt;tns5:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ID_ASSET_CRMWS&quot;/>&#xa;                        &lt;/tns5:ID_ASSET_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:ID_ASSET_NOW>&#xa;                        &lt;xsl:value-of select=&quot;tns4:ID_ASSET_NOW&quot;/>&#xa;                    &lt;/tns5:ID_ASSET_NOW>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_ORDN&q