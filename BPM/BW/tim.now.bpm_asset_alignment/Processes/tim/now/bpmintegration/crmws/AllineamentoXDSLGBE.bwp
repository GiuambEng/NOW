                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/InsertOGG" xmlns:tns4="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertOGG" xmlns:tns="http://www.tim.com/NOW/xsd/SequenceOGG" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza" version="2.0"&gt;&lt;xsl:param name="CallInterfaccia"/&gt;&lt;xsl:param name="SequenceOGG"/&gt;&lt;xsl:param name="NOWtoCRMWS_AllineamentoXDSLGBEIn"/&gt;&lt;xsl:template name="InsertOGG-input" match="/"&gt;&lt;tns1:InsertOGGRequest&gt;&lt;Input&gt;&lt;tns5:Record&gt;&lt;xsl:for-each select="$CallInterfaccia/tns4:RESPONSE"&gt;&lt;tns5:Record&gt;&lt;xsl:if test="tns4:COD_SRVZ"&gt;&lt;tns5:COD_SRVZ&gt;&lt;xsl:value-of select="tns4:COD_SRVZ"/&gt;&lt;/tns5:COD_SRVZ&gt;&lt;/xsl:if&gt;&lt;tns5:CREATED&gt;&lt;xsl:value-of select="tns4:CREATED"/&gt;&lt;/tns5:CREATED&gt;&lt;xsl:if test="tns4:ID_ASSET_CRMWS"&gt;&lt;tns5:ID_ASSET_CRMWS&gt;&lt;xsl:value-of select="tns4:ID_ASSET_CRMWS"/&gt;&lt;/tns5:ID_ASSET_CRMWS&gt;&lt;/xsl:if&gt;&lt;tns5:ID_ASSET_NOW&gt;&lt;xsl:value-of select="tns4:ID_ASSET_NOW"/&gt;&lt;/tns5:ID_ASSET_NOW&gt;&lt;xsl:if test="tns4:ID_ORDN"&gt;&lt;tns5:ID_ORDN&gt;&lt;xsl:value-of select="tns4:ID_ORDN"/&gt;&lt;/tns5:ID_ORDN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:ID_RISORSA"&gt;&lt;tns5:ID_RISORSA&gt;&lt;xsl:value-of select="tns4:ID_RISORSA"/&gt;&lt;/tns5:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:LAVRZ"&gt;&lt;tns5:LAVRZ&gt;&lt;xsl:value-of select="tns4:LAVRZ"/&gt;&lt;/tns5:LAVRZ&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:MESSAGGIO"&gt;&lt;tns5:MESSAGGIO&gt;&lt;xsl:value-of select="tns4:MESSAGGIO"/&gt;&lt;/tns5:MESSAGGIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:STATO"&gt;&lt;tns5:STATO&gt;&lt;xsl:value-of select="tns4:STATO"/&gt;&lt;/tns5:STATO&gt;&lt;/xsl:if&gt;&lt;tns5:TRANSACTION_ID&gt;&lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($SequenceOGG/Output/tns:Output/tns:Record/tns:TRANSACTION_ID_PARENT)"&gt;&lt;xsl:if test="$SequenceOGG/Output/tns:Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT"&gt;&lt;tns5:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="$SequenceOGG/Output/tns:Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT"/&gt;&lt;/tns5:TRANSACTION_ID_PARENT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID_PARENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($SequenceOGG/Output/tns:Output/tns:Record/tns:TRANSACTION_ID_ROOT)"&gt;&lt;xsl:if test="$SequenceOGG/Output/tns:Output/tns:Record/tns:TRANSACTION_ID_ROOT"&gt;&lt;tns5:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="$SequenceOGG/Output/tns:Output/tns:Record/tns:TRANSACTION_ID_ROOT"/&gt;&lt;/tns5:TRANSACTION_ID_ROOT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID_ROOT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="tns4:CODICE_OLO"&gt;&lt;tns5:CODICE_OLO&gt;&lt;xsl:value-of select="tns4:CODICE_OLO"/&gt;&lt;/tns5:CODICE_OLO&gt;&lt;/xsl:if&gt;&lt;tns5:ROW_ID&gt;&lt;xsl:value-of select="tns4:ROW_ID"/&gt;&lt;/tns5:ROW_ID&gt;&lt;xsl:if test="tns4:CREATED_BY"&gt;&lt;tns5:CREATED_BY&gt;&lt;xsl:value-of select="tns4:CREATED_BY"/&gt;&lt;/tns5:CREATED_BY&gt;&lt;/xsl:if&gt;&lt;tns5:LAST_UPD&gt;&lt;xsl:value-of select="tns4:LAST_UPD"/&gt;&lt;/tns5:LAST_UPD&gt;&lt;xsl:if test="tns4:LAST_UPD_BY"&gt;&lt;tns5:LAST_UPD_BY&gt;&lt;xsl:value-of select="tns4:LAST_UPD_BY"/&gt;&lt;/tns5:LAST_UPD_BY&gt;&lt;/xsl:if&gt;&lt;tns5:MODIFICATION_NUM&gt;&lt;xsl:value-of select="tns4:MODIFICATION_NUM"/&gt;&lt;/tns5:MODIFICATION_NUM&gt;&lt;tns5:CONFLICT_ID&gt;&lt;xsl:value-of select="tns4:CONFLICT_ID"/&gt;&lt;/tns5:CONFLICT_ID&gt;&lt;xsl:if test="tns4:DB_LA