            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="TipoLinea"
                    name="TipoLinea" outputVariable="TipoLinea"
                    tibex:xpdlId="a51006be-93a9-464e-b5b6-fec4129c47fe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToTipoLinea"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToMapperCessazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:RICHIESTA/lavorazione=&quot;CESSAZIONE&quot; or $Start/tns:LavorazioneAsset='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:RICHIESTA/lavorazione="CESSAZIONE" or $Start/tns:LavorazioneAsset='CESSAZIONE']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToMapperAttivazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:RICHIESTA/lavorazione=&quot;ATTIVAZIONE&quot; or $Start/tns:LavorazioneAsset='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:RICHIESTA/lavorazione="ATTIVAZIONE" or $Start/tns:LavorazioneAsset='ATTIVAZIONE']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToMapperVariazione">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/tns:RICHIESTA/lavorazione=&quot;VARIAZIONE&quot; or $Start/tns:LavorazioneAsset='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Start/tns:RICHIESTA/lavorazione="VARIAZIONE" or $Start/tns:LavorazioneAsset='VARIAZIONE']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="TipoLineaToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/TipoLinea/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;TipoLinea&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($Start/tns2:ASSET/dettaglioasset/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)),'POTS')&quot;>&lt;tns:TIPOLINEA>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;'POTS'&quot;/>&lt;/tns:TipoLinea>&lt;/tns:TIPOLINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($Start/tns2:ASSET/dettaglioasset/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)),'ISDN')&quot;>&lt;tns:TIPOLINEA>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;'ISDN'&quot;/>&lt;/tns:TipoLinea>&lt;/tns:TIPOLINEA>&lt;/xsl:when>&lt;xsl:when test=&quot; exists($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo) and   string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)>0&quot;>&lt;tns:TIPOLINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)='LINEANONFONIA'&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:TIPOLINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TIPOLINEA>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:TipoLinea>&lt;/tns:TIPOLINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="TipoLinea" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="9b452fe9-37fc-4cb9-9731-885a438567b6">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToCallProcess"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+bb37b2de-d069-4918-bbd9-0b0e57bcd153" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=$Ciclo" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=$Ciclo]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="73264187-862d-4fa1-9278-2d19fd50f7e0">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="bb37b2de-d069-4918-bbd9-0b0e57bcd153" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>SelectProfiloBMD</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SelectProfiloBMD-input"
                                    name="SelectProfiloBMD"
                                    outputVariable="SelectProfiloBMD"
                                    tibex:xpdlId="3d66915b-b0ea-4c02-9625-7f605b543e4e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3d66915b-b0ea-4c02-9625-7f605b543e4e+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;SelectProfiloBMD-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente='GBEVC'][number($index)]/attributidettaglioasset[nomeAttributo='PROFILOBMD']/valoreAttributo)&quot;>&lt;ID_PROFILO_BMD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente='GBEVC'][number($index)]/attributidettaglioasset[nomeAttributo='PROFILOBMD']/valoreAttributo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente='GBEVC'][number($index)]/attributidettaglioasset[nomeAttributo='PROFILOBMD']/valoreAttributo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PROFILO_BMD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_PROFILO_BMD>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente='USERVLAN'][number($index)]/attributidettaglioasset[nomeAttributo='PROFILOBMD']/valoreAttributo)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente='USERVLAN'][number($index)]/attributidettaglioasset[nomeAttributo='PROFILOBMD']/valoreAttributo&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PROFILO_BMD>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT PROFILO,ID_PROFILO_BMD&#xd;&#xa;FROM PROFILO_VLAN_BMD&#xd;&#xa;WHERE ID_PROFILO_BMD = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_PROFILO_BMD"/>
                                    <columnMetadata
                                    columnName="PROFILO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_PROFILO_BMD"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogSelectProfiloBMD-input"
                    name="LogSelectProfiloBMD"
