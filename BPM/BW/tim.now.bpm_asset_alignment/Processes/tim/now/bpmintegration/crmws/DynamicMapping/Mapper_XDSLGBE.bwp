            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperOutput-input"
                    name="MapperOutput" outputVariable="MapperOutput"
                    tibex:xpdlId="90b1c8e4-c8e5-47d2-b145-44ec218c892c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToMapper3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper3ToCallProcess4"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeXDSLGBE/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperCessazione&quot;/>&lt;xsl:param name=&quot;MapperVariazione&quot;/>&lt;xsl:param name=&quot;MapperAttivazione&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapperOutput-input&quot; match=&quot;/&quot;>&lt;tns:RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperCessazione)&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$MapperCessazione/ns1:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:SERVIZIO)&quot;>&lt;xsl:if test=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:SERVIZIO&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:SERVIZIO&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:ID_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:ID_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:ID_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:CODICEORDINEOLO&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:CODICEORDINEOLO&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$MapperCessazione/ns1:SERVIZIO/ns1:CESSAZIONE/ns1:RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;tib:render-xml($MapperCessazione,true(),true())&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;&amp;quot;DA LAVORARE&amp;quot;&quot;/>&lt;/tns:STATO>&lt;xsl:if test=&quot;$Start/tns:CODE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:CODE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;$Start/tns:NextVal&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:CREATED_BY>&#xa;                                                                                                                                                                                                &lt;!--Stesso problema di LAST_UPD_BY, aprire OP-->&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:LAST_UPD_BY>&#xa;                                                                                                                                                                                                                &lt;!--Sul DB è obbligatorio, da specifiche invece è detto di metterlo vuoto-->&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:CONFLICT_ID>&lt;/tns:RESPONSE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($MapperVariazione)&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$MapperVariazione/ns1:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:if test=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:SERVIZIO&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:SERVIZIO&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:ID_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:ID_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:ID_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:CODICEORDINEOLO&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:CODICEORDINEOLO&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;&amp;quot;VARIAZIONE&amp;quot;&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;tib:render-xml($MapperVariazione,true(),true())&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;&amp;quot;DA LAVORARE&amp;quot;&quot;/>&lt;/tns:STATO>&lt;xsl:if test=&quot;$Start/tns:CODE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:CODE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;$Start/tns:NextVal&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:CREATED_BY>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:LAST_UPD_BY>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!--Aprire OP-->&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:CONFLICT_ID>&lt;xsl:if test=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:BTSATMGBEEASYIP/ns1:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$MapperVariazione/ns1:SERVIZIO/ns1:VARIAZIONE/ns1:BTSATMGBEEASYIP/ns1:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;/tns:RESPONSE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$MapperAttivazione/ns1:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:GBE/ns1:SERVIZIO)&quot;>&lt;xsl:if test=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:GBE/ns1:SERVIZIO&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:GBE/ns1:SERVIZIO&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:ID_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:ID_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:ID_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:CODICEORDINEOLO&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:CODICEORDINEOLO&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;tib:render-xml($MapperAttivazione,true(),true())&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;&amp;quot;DA LAVORARE&amp;quot;&quot;/>&lt;/tns:STATO>&lt;xsl:if test=&quot;$Start/tns:CODE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:CODE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;$Start/tns:NextVal&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:CREATED_BY>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:LAST_UPD_BY>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                &lt;!--Aprire OP-->&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:CONFLICT_ID>&lt;xsl:if test=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:GBE/ns1:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$MapperAttivazione/ns1:SERVIZIO/ns1:ATTIVAZIONE/ns1:GBE/ns1:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;/tns:RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RESPONSE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping"
