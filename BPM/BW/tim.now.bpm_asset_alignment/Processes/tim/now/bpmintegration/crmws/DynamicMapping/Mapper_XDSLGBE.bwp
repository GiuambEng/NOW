            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="fb281a72-49a4-4184-836d-25c119283990" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess5ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperOutput&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperOutput)&quot;>&lt;xsl:for-each select=&quot;$MapperOutput/tns:RESPONSE&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;tns:RESPONSE_DATE&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;tns:RETURN_CODE&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:if test=&quot;tns:DESCRIZIONE_ERRORE&quot;>&lt;tns:DESCRIZIONE_ERRORE>&lt;xsl:value-of select=&quot;tns:DESCRIZIONE_ERRORE&quot;/>&lt;/tns:DESCRIZIONE_ERRORE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COD_SRVZ&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;tns:COD_SRVZ&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;tns:CREATED&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;tns:ID_ASSET_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;tns:ID_ASSET_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;tns:ID_ASSET_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;tns:ID_ORDN&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;tns:ID_ORDN&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:LAVRZ&quot;>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;tns:LAVRZ&quot;/>&lt;/tns:LAVRZ>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MESSAGGIO&quot;>&lt;tns:MESSAGGIO