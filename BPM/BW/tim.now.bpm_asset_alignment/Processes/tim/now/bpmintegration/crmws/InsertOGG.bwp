                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:reply faultName="fault" name="Reply"
                            operation="InsertOGG"
                            partnerLink="InsertOGGPortType"
                            portType="ns1:InsertOGGPortType"
                            tibex:xpdlId="564daec6-4fe0-4f69-a3a9-0ada21b209b8" variable="Reply-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertOGG" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertOGG " xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:tns2="http://www.tim.com/NOW/xsd/InsertOGG" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns:InsertOGGFault&gt;&lt;Fault&gt;&lt;tns2:Fault&gt;&lt;tns2:Msg_Code&gt;&lt;xsl:value-of select="tib:render-xml($FaultDetails, true(), true())"/&gt;&lt;/tns2:Msg_Code&gt;&lt;tns2:Code_Error&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/tns2:Code_Error&gt;&lt;/tns2:Fault&gt;&lt;/Fault&gt;&lt;/tns:InsertOGGFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertOGG&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertOGG &quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Fault>&#xa;            &lt;tns2:Msg_Code>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;            &lt;/tns2:Msg_Code>&#xa;            &lt;tns2:Code_Error>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;            &lt;/tns2:Code_Error>&#xa;        &lt;/tns2:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
