                    eventTimeout="0" name="StartMapperInterface"
                    tibex:xpdlId="8989cbb5-1265-41a5-8f42-bccaf806fa9b"
                    variable="StartMapperInterface" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
