                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;EndMapperInterface-input&quot; match=&quot;/&quot;>&lt;tns:RESPONSE>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:COD_SRVZ>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CREATED>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ORDN>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:STATO>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CREATED_BY>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:LAST_UPD_BY>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CONFLICT_ID>&lt;/tns:RESPONSE>&lt;/tns:RESPONSE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
