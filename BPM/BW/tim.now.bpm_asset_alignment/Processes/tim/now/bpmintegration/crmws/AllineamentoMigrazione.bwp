                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/NOWAssetCorrelati/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_MigrazioneIn.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;ASSETCORRELATI_CESSAZIONE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;xsl:for-each select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETCORRELATI_CESSAZIONE[offerta!='SEMIEASYIPNGAFTTH' and offerta!='SEMIBITSTREAMNGAFTTH' and offerta!='SEMIVULAFTTH']&quot;>&#xa;                &lt;tns2:Asset>&#xa;                    &lt;xsl:if test=&quot;IDAsset&quot;>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;codiceOrdineOLO&quot;/>&#xa;                    &lt;/codiceOrdineOLO>&#xa;                    &lt;xsl:if test=&quot;codiceOrdineTI&quot;>&#xa;                        &lt;codiceOrdineTI>&#xa;                            &lt;xsl:value-of select=&quot;codiceOrdineTI&quot;/>&#xa;                        &lt;/codiceOrdineTI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;codificaOLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;codificaOLOAGCOM&quot;/>&#xa;                    &lt;/codificaOLOAGCOM>&#xa;                    &lt;xsl:if test=&quot;invariante&quot;>&#xa;                        &lt;invariante>&#xa;                            &lt;xsl:value-of select=&quot;invariante&quot;/>&#xa;                        &lt;/invariante>&