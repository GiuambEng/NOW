                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/NOWAssetCorrelati/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns4=&quot;http://www.example.org/AccumulateNPOGG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_MigrazioneIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:template name=&quot;AssetPrincipale-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:Asset>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/IDAsset&quot;>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                &lt;/xsl:if>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/codiceOrdineOLO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/codiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/codiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/codificaOLOAGCOM&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;x