                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/NOWAssetCorrelati/" xmlns:tns2="http://www.tim.com/NOW/xsd/AssetCorrelati/" version="2.0"&gt;&lt;xsl:param name="NOWtoCRMWS_MigrazioneIn"/&gt;&lt;xsl:template name="ASSETCORRELATI_CESSAZIONE-input" match="/"&gt;&lt;tns1:AssetCorrelatiRequest&gt;&lt;Input&gt;&lt;tns2:Input&gt;&lt;xsl:for-each select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:ASSETCORRELATI_CESSAZIONE[offerta!='SEMIEASYIPNGAFTTH' and offerta!='SEMIBITSTREAMNGAFTTH' and offerta!='SEMIVULAFTTH']"&gt;&lt;tns2:Asset&gt;&lt;xsl:if test="IDAsset"&gt;&lt;IDAsset&gt;&lt;xsl:value-of select="IDAsset"/&gt;&lt;/IDAsset&gt;&lt;/xsl:if&gt;&lt;codiceOrdineOLO&gt;&lt;xsl:value-of select="codiceOrdineOLO"/&gt;&lt;/codiceOrdineOLO&gt;&lt;xsl:if test="codiceOrdineTI"&gt;&lt;codiceOrdineTI&gt;&lt;xsl:value-of select="codiceOrdineTI"/&gt;&lt;/codiceOrdineTI&gt;&lt;/xsl:if&gt;&lt;codificaOLOAGCOM&gt;&lt;xsl:value-of select="codificaOLOAGCOM"/&gt;&lt;/codificaOLOAGCOM&gt;&lt;xsl:if test="invariante"&gt;&lt;invariante&gt;&lt;xsl:value-of select="invariante"/&gt;&lt;/invariante&gt;&lt;/xsl:if&gt;&lt;created&gt;&lt;xsl:value-of select="created"/&gt;&lt;/created&gt;&lt;xsl:if test="lastUpdate"&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;/xsl:if&gt;&lt;operatore&gt;&lt;xsl:value-of select="operatore"/&gt;&lt;/operatore&gt;&lt;xsl:if test="IDRichiestaOLO"&gt;&lt;IDRichiestaOLO&gt;&lt;xsl:value-of select="IDRichiestaOLO"/&gt;&lt;/IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDPrimoOrdine"&gt;&lt;IDPrimoOrdine&gt;&lt;xsl:value-of select="IDPrimoOrdine"/&gt;&lt;/IDPrimoOrdine&gt;&lt;/xsl:if&gt;&lt;IDContratto&gt;&lt;xsl:value-of select="IDContratto"/&gt;&lt;/IDContratto&gt;&lt;xsl:if test="DEC"&gt;&lt;DEC&gt;&lt;xsl:value-of select="DEC"/&gt;&lt;/DEC&gt;&lt;/xsl:if&gt;&lt;statoAsset&gt;&lt;xsl:v