                                portType="ns5:SequenceOGG" tibex:xpdlId="f9d8427b-fdcf-4804-9fcf-a33131f9e413">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/" xmlns:tns1="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/SequenceOGG" xmlns:tns3="http://www.tim.com/NOW/xsd/SequenceOGG" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="NOWtoCRMWS_MigrazioneIn"/&gt;&lt;xsl:template name="SelectNextvalNumeriAggiuntivi-input" match="/"&gt;&lt;tns2:SequenceOGGRequest&gt;&lt;Input&gt;&lt;tns3:Input&gt;&lt;xsl:if test="$NOWtoCRMWS_MigrazioneIn/Input/tns1:REQUEST/tns1:NumeriAggiuntivi[number($index)]/tns:IDAsset"&gt;&lt;tns3:ID_ASSET_NOW&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns1:REQUEST/tns1:NumeriAggiuntivi[number($index)]/tns:IDAsset"/&gt;&lt;/tns3:ID_ASSET_NOW&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$NOWtoCRMWS_MigrazioneIn/Input/tns1:REQUEST/tns1:ASSETPRINCIPALE/IDRichiestaOLO"&gt;&lt;tns3:id_rich_olo&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns1:REQUEST/tns1:ASSETPRINCIPALE/IDRichiestaOLO"/&gt;&lt;/tns3:id_rich_olo&gt;&lt;/xsl:if&gt;&lt;/tns3:Input&gt;&lt;/Input&gt;&lt;/tns2:SequenceOGGRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/SequenceOGG&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_MigrazioneIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectNextvalNumeriAggiuntivi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Input>&#xa;            &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns1:NumeriAggiuntivi[number($index)]/tns:IDAsset&quot;>&#xa;                &lt;tns3:ID_ASSET_NOW>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns1:NumeriAggiuntivi[number($index)]/tns:IDAsset&quot;/>&#xa;                &lt;/tns3:ID_ASSET_NOW>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns1:ASSETPRINCIPALE/IDRichiestaOLO&quot;>&#xa;                &lt;tns3:id_rich_olo>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns1:ASSETPRINCIPALE/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:id_rich_olo>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
