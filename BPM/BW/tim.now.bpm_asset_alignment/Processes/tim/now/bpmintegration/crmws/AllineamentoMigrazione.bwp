                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AccumulateNPOGG&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectNextvalNumeriAggiuntivi.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_MigrazioneIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NP>&#xa;            &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:NextVal[1]&quot;>&#xa;                &lt;tns:Nextval>&#xa;                    &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:NextVal[1]&quot;/>&#xa;                &lt;/tns:Nextval>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:NumeriAggiuntivi>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NumeroTelefonico&quot;>&#xa;                    &lt;tns2:NumeroTelefonico>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NumeroTelefonico&quot;/>&#xa;                    &lt;/tns2:NumeroTelefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDAsset&quot;>&#xa;                    &lt;tns2:IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDAsset&quot;/>&#xa;                    &lt;/tns2:IDAsset>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDContratto&quot;>&#xa;                    &lt;tns2:IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDContratto&quot;/>&#xa;                    &lt;/tns2:IDContratto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodiceOrdineOLO&quot;>&#xa;                    &lt;tns2:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodiceOrdineOLO&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodiceOrdineTI&quot;>&#xa;                    &lt;tns2:CodiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodiceOrdineTI&quot;/>&#xa;                    &lt;/tns2:CodiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDRisorsa&quot;>&#xa;                    &lt;tns2:IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDRisorsa&quot;/>&#xa;                    &lt;/tns2:IDRisorsa>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDAssetCRMWS&quot;>&#xa;                    &lt;tns2:IDAssetCRMWS>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDAssetCRMWS&quot;/>&#xa;                    &lt;/tns2:IDAssetCRMWS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:DES&quot;>&#xa;                    &lt;tns2:DES>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:DES&quot;/>&#xa;                    &lt;/tns2:DES>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:Distretto&quot;>&#xa;                    &lt;tns2:Distretto>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:Distretto&quot;/>&#xa;                    &lt;/tns2:Distretto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodificaOLOAgicomDonating&quot;>&#xa;                    &lt;tns2:CodificaOLOAgicomDonating>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodificaOLOAgicomDonating&quot;/>&#xa;                    &lt;/tns2:CodificaOLOAgicomDonating>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NumeroTelefonicoPrincipale&quot;>&#xa;                    &lt;tns2:NumeroTelefonicoPrincipale>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NumeroTelefonicoPrincipale&quot;/>&#xa;                    &lt;/tns2:NumeroTelefonicoPrincipale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:Nome&quot;>&#xa;                    &lt;tns2:Nome>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:Nome&quot;/>&#xa;                    &lt;/tns2:Nome>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CF&quot;>&#xa;                    &lt;tns2:CF>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CF&quot;/>&#xa;                    &lt;/tns2:CF>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:cognomeragsociale&quot;>&#xa;                    &lt;tns2:cognomeragsociale>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:cognomeragsociale&quot;/>&#xa;                    &lt;/tns2:cognomeragsociale>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:PartitaIVA&quot;>&#xa;                    &lt;tns2:PartitaIVA>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:PartitaIVA&quot;/>&#xa;                    &lt;/tns2:PartitaIVA>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:NUMBERPORTABILITY>&#xa;                    &lt;tns2:AttributiNumeriAggiunti>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:PRINCIPALE&quot;>&#xa;                            &lt;tns2:PRINCIPALE>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:PRINCIPALE&quot;/>&#xa;                            &lt;/tns2:PRINCIPALE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:RADICALE&quot;>&#xa;                            &lt;tns2:RADICALE>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:RADICALE&quot;/>&#xa;                            &lt;/tns2:RADICALE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TIPOLINEANP&quot;>&#xa;                            &lt;tns2:TIPOLINEANP>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TIPOLINEANP&quot;/>&#xa;                            &lt;/tns2:TIPOLINEANP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:ROUTINGNUMBER&quot;>&#xa;                            &lt;tns2:ROUTINGNUMBER>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:ROUTINGNUMBER&quot;/>&#xa;                            &lt;/tns2:ROUTINGNUMBER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TOTALEAGGIUNTIVI&quot;>&#xa;                            &lt;tns2:TOTALEAGGIUNTIVI>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TOTALEAGGIUNTIVI&quot;/>&#xa;                            &lt;/tns2:TOTALEAGGIUNTIVI>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TOTALELINEE&quot;>&#xa;                            &lt;tns2:TOTALELINEE>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TOTALELINEE&quot;/>&#xa;                            &lt;/tns2:TOTALELINEE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TIPOSERVIZIO&quot;>&#xa;                            &lt;tns2:TIPOSERVIZIO>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TIPOSERVIZIO&quot;/>&#xa;                            &lt;/tns2:TIPOSERVIZIO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:PIATTAFORME&quot;>&#xa;                            &lt;tns2:PIATTAFORME>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:PIATTAFORME&quot;/>&#xa;                            &lt;/tns2:PIATTAFORME>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TIPONUMERO&quot;>&#xa;                            &lt;tns2:TIPONUMERO>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:TIPONUMERO&quot;/>&#xa;                            &lt;/tns2:TIPONUMERO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:OLORETAILER&quot;>&#xa;                            &lt;tns2:OLORETAILER>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:OLORETAILER&quot;/>&#xa;                            &lt;/tns2:OLORETAILER>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:CODICERO&quot;>&#xa;                            &lt;tns2:CODICERO>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:CODICERO&quot;/>&#xa;                            &lt;/tns2:CODICERO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:CAPOSERIE&quot;>&#xa;                            &lt;tns2:CAPOSERIE>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:NUMBERPORTABILITY/tns2:AttributiNumeriAggiunti/tns2:CAPOSERIE&quot;/>&#xa;                            &lt;/tns2:CAPOSERIE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:AttributiNumeriAggiunti>&#xa;                &lt;/tns2:NUMBERPORTABILITY>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:Offerta&quot;>&#xa;                    &lt;tns2:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:Offerta&quot;/>&#xa;                    &lt;/tns2:Offerta>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDRichOLO&quot;>&#xa;                    &lt;tns2:IDRichOLO>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:IDRichOLO&quot;/>&#xa;                    &lt;/tns2:IDRichOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodificaOLOAgcom&quot;>&#xa;                    &lt;tns2:CodificaOLOAgcom>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns3:NumeriAggiuntivi[number($index)]/tns2:CodificaOLOAgcom&quot;/>&#xa;                    &lt;/tns2:CodificaOLOAgcom>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns:NumeriAggiuntivi>&#xa;            &lt;tns:Record>&#xa;                &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:COD_SERVZ&quot;>&#xa;                    &lt;tns:COD_SERVZ>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:COD_SERVZ&quot;/>&#xa;                    &lt;/tns:COD_SERVZ>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:CREATED&quot;>&#xa;                    &lt;tns:CREATED>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:CREATED&quot;/>&#xa;                    &lt;/tns:CREATED>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_ASSET_CRMWS&quot;>&#xa;                    &lt;tns:ID_ASSET_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_ASSET_CRMWS&quot;/>&#xa;                    &lt;/tns:ID_ASSET_CRMWS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_ASSET_NOW&quot;>&#xa;                    &lt;tns:ID_ASSET_NOW>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_ASSET_NOW&quot;/>&#xa;                    &lt;/tns:ID_ASSET_NOW>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_ORDN&quot;>&#xa;                    &lt;tns:ID_ORDN>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_ORDN&quot;/>&#xa;                    &lt;/tns:ID_ORDN>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_RISORSA&quot;>&#xa;                    &lt;tns:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:ID_RISORSA&quot;/>&#xa;                    &lt;/tns:ID_RISORSA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns1:Record[1]/tns1:LAVRZ&quot;>&#xa;                    &lt