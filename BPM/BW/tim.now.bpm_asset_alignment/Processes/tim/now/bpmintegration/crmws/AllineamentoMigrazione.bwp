            <bpws:reply name="NOWtoCRMWS_MigrazioneOut"
                operation="NOWtoCRMWS_Migrazione"
                partnerLink="NOWtoCRMWS_AllineamentoConsistenzaOGG"
                portType="ns1:NOWtoCRMWS_AllineamentoConsistenzaOGG"
                tibex:xpdlId="f3effea5-9846-4885-9ddd-f4af6cbca0e9" variable="NOWtoCRMWS_MigrazioneOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOWtoCRMWSAllineamentoConsistenzaOGG" xmlns:tns1="http://www.tim.com/NOW/xsd/AssetCorrelati/" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns3="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza" version="2.0"&gt;
    &lt;xsl:param name="AssetPrincipale"/&gt;
    &lt;xsl:param name="ASSETCORRELATI_CESSAZIONE"/&gt;
    &lt;xsl:param name="ASSETCORRELATI_ATTIVAZIONE"/&gt;
    &lt;xsl:param name="ASSETCORRELATI_VARIAZIONE"/&gt;
    &lt;xsl:template name="NOWtoCRMWS_MigrazioneOut-input" match="/"&gt;
        &lt;tns:NOWtoCRMWS_MigrazioneResponse&gt;
            &lt;Output&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="exists($AssetPrincipale/Output/tns1:Output)"&gt;
                        &lt;tns3:RESPONSE&gt;
                            &lt;tns3:RESPONSE&gt;
                                &lt;tns3:TRANSACTION_ID&gt;
                                    &lt;xsl:value-of select="$AssetPrincipale/Output/tns1:Output/tns1:Request/tns2:TRANSACTION_ID"/&gt;
                                &lt;/tns3:TRANSACTION_ID&gt;
                                &lt;tns3:RESPONSE_DATE&gt;
                                    &lt;xsl:value-of select="$AssetPrincipale/Output/tns1:Output/tns1:Request/tns2:RESPONSE_DATE"/&gt;
                                &lt;/tns3:RESPONSE_DATE&gt;
                                &lt;tns3:RETURN_CODE&gt;
                                    &lt;xsl:value-of select="$AssetPrincipale/Output/tns1:Output/tns1:Request/tns2:RETURN_CODE"/&gt;
                                &lt;/tns3:RETURN_CODE&gt;
                                &lt;xsl:if test="$AssetPrincipale/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"&gt;
                                    &lt;tns3:DESCRIZIONE_ERRORE&gt;
                                        &lt;xsl:value-of select="$AssetPrincipale/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"/&gt;
                                    &lt;/tns3:DESCRIZIONE_ERRORE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/tns3:RESPONSE&gt;
                        &lt;/tns3:RESPONSE&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($ASSETCORRELATI_CESSAZIONE/Output/tns1:Output)"&gt;
                                &lt;tns3:RESPONSE&gt;
                                    &lt;tns3:RESPONSE&gt;
                                        &lt;tns3:TRANSACTION_ID&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_CESSAZIONE/Output/tns1:Output/tns1:Request/tns2:TRANSACTION_ID"/&gt;
                                        &lt;/tns3:TRANSACTION_ID&gt;
                                        &lt;tns3:RESPONSE_DATE&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_CESSAZIONE/Output/tns1:Output/tns1:Request/tns2:RESPONSE_DATE"/&gt;
                                        &lt;/tns3:RESPONSE_DATE&gt;
                                        &lt;tns3:RETURN_CODE&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_CESSAZIONE/Output/tns1:Output/tns1:Request/tns2:RETURN_CODE"/&gt;
                                        &lt;/tns3:RETURN_CODE&gt;
                                        &lt;xsl:if test="$ASSETCORRELATI_CESSAZIONE/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"&gt;
                                            &lt;tns3:DESCRIZIONE_ERRORE&gt;
                                                &lt;xsl:value-of select="$ASSETCORRELATI_CESSAZIONE/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"/&gt;
                                            &lt;/tns3:DESCRIZIONE_ERRORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:RESPONSE&gt;
                                &lt;/tns3:RESPONSE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($ASSETCORRELATI_ATTIVAZIONE/Output/tns1:Output)"&gt;
                                &lt;tns3:RESPONSE&gt;
                                    &lt;tns3:RESPONSE&gt;
                                        &lt;tns3:TRANSACTION_ID&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_ATTIVAZIONE/Output/tns1:Output/tns1:Request/tns2:TRANSACTION_ID"/&gt;
                                        &lt;/tns3:TRANSACTION_ID&gt;
                                        &lt;tns3:RESPONSE_DATE&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_ATTIVAZIONE/Output/tns1:Output/tns1:Request/tns2:RESPONSE_DATE"/&gt;
                                        &lt;/tns3:RESPONSE_DATE&gt;
                                        &lt;tns3:RETURN_CODE&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_ATTIVAZIONE/Output/tns1:Output/tns1:Request/tns2:RETURN_CODE"/&gt;
                                        &lt;/tns3:RETURN_CODE&gt;
                                        &lt;xsl:if test="$ASSETCORRELATI_ATTIVAZIONE/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"&gt;
                                            &lt;tns3:DESCRIZIONE_ERRORE&gt;
                                                &lt;xsl:value-of select="$ASSETCORRELATI_ATTIVAZIONE/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"/&gt;
                                            &lt;/tns3:DESCRIZIONE_ERRORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:RESPONSE&gt;
                                &lt;/tns3:RESPONSE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="exists($ASSETCORRELATI_VARIAZIONE/Output/tns1:Output)"&gt;
                                &lt;tns3:RESPONSE&gt;
                                    &lt;tns3:RESPONSE&gt;
                                        &lt;tns3:TRANSACTION_ID&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_VARIAZIONE/Output/tns1:Output/tns1:Request/tns2:TRANSACTION_ID"/&gt;
                                        &lt;/tns3:TRANSACTION_ID&gt;
                                        &lt;tns3:RESPONSE_DATE&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_VARIAZIONE/Output/tns1:Output/tns1:Request/tns2:RESPONSE_DATE"/&gt;
                                        &lt;/tns3:RESPONSE_DATE&gt;
                                        &lt;tns3:RETURN_CODE&gt;
                                            &lt;xsl:value-of select="$ASSETCORRELATI_VARIAZIONE/Output/tns1:Output/tns1:Request/tns2:RETURN_CODE"/&gt;
                                        &lt;/tns3:RETURN_CODE&gt;
                                        &lt;xsl:if test="$ASSETCORRELATI_VARIAZIONE/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"&gt;
                                            &lt;tns3:DESCRIZIONE_ERRORE&gt;
                                                &lt;xsl:value-of select="$ASSETCORRELATI_VARIAZIONE/Output/tns1:Output/tns1:Request/tns2:DESCRIZIONE_ERRORE"/&gt;
                                            &lt;/tns3:DESCRIZIONE_ERRORE&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:RESPONSE&gt;
                                &lt;/tns3:RESPONSE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;tns3:RESPONSE&gt;
                                    &lt;tns3:RESPONSE&gt;
                                        &lt;tns3:TRANSACTION_ID&gt;
                                            &lt;xsl:value-of select="''"/&gt;
                                        &lt;/tns3:TRANSACTION_ID&gt;
                                        &lt;tns3:RESPONSE_DATE&gt;
                                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                                        &lt;/tns3:RESPONSE_DATE&gt;
                                        &lt;tns3:RETURN_CODE&gt;
                                            &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
