            <bpws:empty name="TLC" tibex:xpdlId="0bff8e1b-2949-425e-a419-12126b35fb70">
                <bpws:targets>
                    <bpws:target linkName="LogAssetPrincipaleToEmpty"/>
                    <bpws:target linkName="ControlloAssetPrincipaleToEmpty"/>
                    <bpws:target linkName="EmptyToTLC"/>
                </bpws:targets>
