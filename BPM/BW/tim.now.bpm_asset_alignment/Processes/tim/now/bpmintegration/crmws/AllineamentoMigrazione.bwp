                                        &lt;/tns3:DESCRIZIONE_ERRORE&gt;
                                    &lt;/tns3:RESPONSE&gt;
                                &lt;/tns3:RESPONSE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/Output&gt;
        &lt;/tns:NOWtoCRMWS_MigrazioneResponse&gt;
