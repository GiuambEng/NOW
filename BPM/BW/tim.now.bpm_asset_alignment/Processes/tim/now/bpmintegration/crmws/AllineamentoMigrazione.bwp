            <bpws:empty name="ControlloAssetPrincipale" tibex:xpdlId="e6ae8ce9-81f1-40f5-8fd0-01971e690951">
                <bpws:targets>
                    <bpws:target linkName="EmptyToControlloAssetPrincipale"/>
                    <bpws:target linkName="TipologiaVariazioneToControlloAssetPrincipale"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ControlloAssetPrincipaleToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:ASSETPRINCIPALE)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ControlloAssetPrincipaleToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
