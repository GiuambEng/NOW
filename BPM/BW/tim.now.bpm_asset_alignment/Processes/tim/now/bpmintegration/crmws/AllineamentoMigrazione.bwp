;/xsl:if&gt;&lt;xsl:if test="LNA_LA"&gt;&lt;LNA_LA&gt;&lt;xsl:value-of select="LNA_LA"/&gt;&lt;/LNA_LA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="modalitaFatturazione"&gt;&lt;modalitaFatturazione&gt;&lt;xsl:value-of select="modalitaFatturazione"/&gt;&lt;/modalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDRisorsaOLD"&gt;&lt;IDRisorsaOLD&gt;&lt;xsl:value-of select="IDRisorsaOLD"/&gt;&lt;/IDRisorsaOLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="IDRisorsaCorrelato"&gt;&lt;IDRisorsaCorrelato&gt;&lt;xsl:value-of select="IDRisorsaCorrelato"/&gt;&lt;/IDRisorsaCorrelato&gt;&lt;/xsl:if&gt;&lt;/tns2:Asset&gt;&lt;/xsl:for-each&gt;&lt;tns2:Lavorazione&gt;&lt;xsl:value-of select="'CESSAZIONE'"/&gt;&lt;/tns2:Lavorazione&gt;&lt;xsl:if test="exists($NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA)"&gt;&lt;tns2:Richiesta&gt;&lt;created&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/created"/&gt;&lt;/created&gt;&lt;lastUpdate&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/lastUpdate"/&gt;&lt;/lastUpdate&gt;&lt;operatore&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/operatore"/&gt;&lt;/operatore&gt;&lt;IDRichiestaOLO&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/IDRichiestaOLO"/&gt;&lt;/IDRichiestaOLO&gt;&lt;statoRichiestaNOW&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/statoRichiestaNOW"/&gt;&lt;/statoRichiestaNOW&gt;&lt;xsl:if test="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/statoRichiestaPrecedNOW"&gt;&lt;statoRichiestaPrecedNOW&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/statoRichiestaPrecedNOW"/&gt;&lt;/statoRichiestaPrecedNOW&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICHIESTA/statoRichiestaOLO"&gt;&lt;statoRichiestaOLO&gt;&lt;xsl:value-of select="$NOWtoCRMWS_MigrazioneIn/Input/tns:REQUEST/tns:RICH