/tns:ASSETPRINCIPALE/interno&quot;/>&#xa;                    &lt;/interno>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/piano&quot;>&#xa;                    &lt;piano>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/piano&quot;/>&#xa;                    &lt;/piano>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/scala&quot;>&#xa;                    &lt;scala>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/scala&quot;/>&#xa;                    &lt;/scala>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$NOWtoCRMWS_MigrazioneIn.Input/tns:ASSETPRINCIPALE/dettaglioasset&quot;>&#xa;                    &lt;dettaglioasset>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                        &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                            &lt;IDDettaglioAssetParent>&#xa;                                &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                            &lt;/IDDettaglioAssetParent>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                            &lt;IDDettaglioAssetRoot>&#xa;                                &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                            &lt;/IDDettaglioAssetRoot>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;integrationID>&#xa;                            &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                        &lt;/integrationID>&#xa;                        &lt;created>&#xa;    