xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:CODICE_OLO&quot;>&#xa;                        &lt;tns4:CODICE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;tns:CODICE_OLO&quot;/>&#xa;                        &lt;/tns4:CODICE_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns4:ROW_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:ROW_ID&quot;/>&#xa;                    &lt;/tns4:ROW_ID>&#xa;                    &lt;xsl:if test=&quot;tns:CREATED_BY&quot;>&#xa;                        &lt;tns4:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns:CREATED_BY&quot;/>&#xa;                        &lt;/tns4:CREATED_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns4:LAST_UPD>&#xa;                        &lt;xsl:value-of select=&quot;tns:LAST_UPD&quot;/>&#xa;                    &lt;/tns4:LAST_UPD>&#xa;                    &lt;xsl:if test=&quot;tns:LAST_UPD_BY&quot;>&#xa;                        &lt;tns4:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns:LAST_UPD_BY&quot;/>&#xa;                        &lt;/tns4:LAST_UPD_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns4:MODIFICATION_NUM>&#xa;                        &lt;xsl:value-of select=&quot;tns:MODIFICATION_NUM&quot;/>&#xa;                    &lt;/tns4:MODIFICATION_NUM>&#xa;                    &lt;tns4:CONFLICT_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:CONFLICT_ID&quot;/>&#xa;                    &lt;/tns4:CONFLICT_ID>&#xa;                    &lt;xsl:if test=&quot;tns:DB_LAST_UPD&quot;>&#xa;                        &lt;tns4:DB_LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;tns:DB_LAST_UPD&quot;/>&#xa;                        &lt;/tns4:DB_LAST_UPD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DB_LAST_UPD_SRC&quot;>&#xa;                        &lt;tns4