                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AccumulateNPOGG&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectNextvalNumeriAggiuntivi.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoNPGIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NP>&#xa;            &lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns3:NextVal[1]&quot;>&#xa;                &lt;tns:Nextval>&#xa;                    &lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi.Output/tns3:NextVal[1]&quot;/>&#xa;                &lt;/tns:Nextval>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:NumeriAggiuntivi>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NumeroTelefonico&quot;>&#xa;                    &lt;tns1:NumeroTelefonico>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NumeroTelefonico&quot;/>&#xa;                    &lt;/tns1:NumeroTelefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:IDAsset&quot;>&#xa;                    &lt;tns1:IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:IDAsset&quot;/>&#xa;                    &lt;/tns1:IDAsset>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:NUMBERPORTABILITY>&#xa;                    &lt;tns1:AttributiNumeriAggiunti>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:PRINCIPALE&quot;>&#xa;                            &lt;tns1:PRINCIPALE>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:PRINCIPALE&quot;/>&#xa;                            &lt;/tns1:PRINCIPALE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:RADICALE&quot;>&#xa;                            &lt;tns1:RADICALE>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:RADICALE&quot;/>&#xa;                            &lt;/tns1:RADICALE>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TIPOLINEANP&quot;>&#xa;                            &lt;tns1:TIPOLINEANP>&#xa;                                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TIPOLINEANP&quot;/>&#xa;                            &lt;/tns1:TIPOLINEANP>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:ROUTINGNUMBER&