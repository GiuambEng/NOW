                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectNextvalNumeriAggiuntivi.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoNPGIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectNextvalNumeriAggiuntivi-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AllineamentoNPG&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOWtoCRMWS_AllineamentoConsistenzaOGG&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOWtoCRMWS_AllineamentoNPG&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:ASSETPRINCIPALE/IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn.Input/tns2:ASSETPRINCIPALE/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('SelectNextvalNumeriAggiuntivi', tib:render-xml($SelectNextvalNumeriAggiuntivi.Output, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.org/AccumulateNPOGG&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectNextvalNumeriAggiuntivi&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoNPGIn&quot;/>&lt;xsl:template name=&quot;Accumulate-input&quot; match=&quot;/&quot;>&lt;tns:NP>&lt;xsl:if test=&quot;$SelectNextvalNumeriAggiuntivi/Output/tns3:Output/tns3:NextVal[1]&quot;>&lt;tns:Nextval>&lt;xsl:value-of select=&quot;$SelectNextvalNumeriAggiuntivi/Output/tns3:Output/tns3:NextVal[1]&quot;/>&lt;/tns:Nextval>&lt;/xsl:if>&lt;tns:NumeriAggiuntivi>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NumeroTelefonico&quot;>&lt;tns1:NumeroTelefonico>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NumeroTelefonico&quot;/>&lt;/tns1:NumeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:IDAsset&quot;>&lt;tns1:IDAsset>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:IDAsset&quot;/>&lt;/tns1:IDAsset>&lt;/xsl:if>&lt;tns1:NUMBERPORTABILITY>&lt;tns1:AttributiNumeriAggiunti>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:PRINCIPALE&quot;>&lt;tns1:PRINCIPALE>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2