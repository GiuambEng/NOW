index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TOTALELINEE&quot;>&lt;tns1:TOTALELINEE>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TOTALELINEE&quot;/>&lt;/tns1:TOTALELINEE>&lt;/xsl:if>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TIPOSERVIZIO&quot;>&lt;tns1:TIPOSERVIZIO>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TIPOSERVIZIO&quot;/>&lt;/tns1:TIPOSERVIZIO>&lt;/xsl:if>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:PIATTAFORME&quot;>&lt;tns1:PIATTAFORME>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:PIATTAFORME&quot;/>&lt;/tns1:PIATTAFORME>&lt;/xsl:if>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TIPONUMERO&quot;>&lt;tns1:TIPONUMERO>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:TIPONUMERO&quot;/>&lt;/tns1:TIPONUMERO>&lt;/xsl:if>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti/tns1:OLORETAILER&quot;>&lt;tns1:OLORETAILER>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPGIn/Input/tns2:REQUEST/tns2:NumeriAggiuntivi[number($index)]/tns1:NUMBERPORTABILITY/tns1:AttributiNumeriAggiunti