                            tibex:xpdlId="090c862e-468f-4dc5-bf3b-79ea69829d19" variable="ReplyFault-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/AssetToponomastica/" xmlns:tns1="http://www.tim.com/NOW/xsd/AssetToponomastica/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="ReplyFault-input" match="/"&gt;&lt;tns:AssetFault&gt;&lt;Fault&gt;&lt;tns1:Fault&gt;&lt;tns1:Message_code&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/tns1:Message_code&gt;&lt;tns1:Error_code&gt;&lt;xsl:value-of select="tib:render-xml($FaultDetails,true(), true())"/&gt;&lt;/tns1:Error_code&gt;&lt;/tns1:Fault&gt;&lt;/Fault&gt;&lt;/tns:AssetFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/AssetToponomastica/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyFault-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Fault>&#xa;            &lt;tns1:Message_code>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;            &lt;/tns1:Message_code>&#xa;            &lt;tns1:Error_code>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails,true(), true())&quot;/>&#xa;            &lt;/tns1:Error_code>&#xa;        &lt;/tns1:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="CallProcessToReply"/>
