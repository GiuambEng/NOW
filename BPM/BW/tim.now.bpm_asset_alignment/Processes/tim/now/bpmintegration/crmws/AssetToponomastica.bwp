            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;AssetIn&quot;/>&lt;xsl:template name=&quot;LogStartAsset-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;AssetToponomastica&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$AssetIn/Input/tns1:Request/tns1:ID_Rich_OLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$AssetIn/Input/tns1:Request/tns1:ID_Rich_OLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;StartAsset &amp;quot;, tib:render-xml($AssetIn/Input/tns1:Request, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$AssetIn/Input/tns1:Request/tns1:ID_Rich_OLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$AssetIn/Input/tns1:Request/tns1:ID_Rich_OLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;Asset_STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;AssetToponomastica_&amp;quot;, $AssetIn/Input/tns1:Request/tns1:ID_Rich_OLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($AssetIn/Input/tns1:Request))) &quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($AssetIn/Input/tns1:Request, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogStartAsset-input"
                    name="LogStartAsset"
                    tibex:xpdlId="877e3b37-c1f3-4903-990a-371cbb4d1fe4"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssetInToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBCQuery_Regolatorio">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($AssetIn/Input/tns:Request/tns:Offerta)='ULLLINEANONATTIVA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='ULLDATILINEANONATTIVA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='ULLDATILINEAATTIVA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='ULLLINEAATTIVA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='ULLDATILINEAATTIVANP' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='ULLLINEAATTIVANP' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='SLULINEANONATTIVA'  or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='SLULINEAATTIVA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='SLULINEAATTIVANP' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VULLLINEANONATTIVA' or  upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VULL' or starts-with($AssetIn/Input/tns:Request/tns:Offerta,'SHA') or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='WLRLINEAATTIVA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='WLRLINEANONATTIVA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='WLR'  or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='CPS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($AssetIn.Input/tns:Offerta)='ULLLINEANONATTIVA' or upper-case($AssetIn.Input/tns:Offerta)='ULLDATILINEANONATTIVA' or upper-case($AssetIn.Input/tns:Offerta)='ULLDATILINEAATTIVA' or upper-case($AssetIn.Input/tns:Offerta)='ULLLINEAATTIVA' or upper-case($AssetIn.Input/tns:Offerta)='ULLDATILINEAATTIVANP' or upper-case($AssetIn.Input/tns:Offerta)='ULLLINEAATTIVANP' or upper-case($AssetIn.Input/tns:Offerta)='SLULINEANONATTIVA'  or upper-case($AssetIn.Input/tns:Offerta)='SLULINEAATTIVA' or upper-case($AssetIn.Input/tns:Offerta)='SLULINEAATTIVANP' or upper-case($AssetIn.Input/tns:Offerta)='VULLLINEANONATTIVA' or  upper-case($AssetIn.Input/tns:Offerta)='VULL' or starts-with($AssetIn.Input/tns:Offerta,'SHA') or upper-case($AssetIn.Input/tns:Offerta)='WLRLINEAATTIVA' or upper-case($AssetIn.Input/tns:Offerta)='WLRLINEANONATTIVA' or upper-case($AssetIn.Input/tns:Offerta)='WLR'  or upper-case($AssetIn.Input/tns:Offerta)='CPS']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartAssetToJDBCQuery_XDSL-NGA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMNGAFTTCAB' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMNGAFTTH' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VULAFTTCAB' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VULAFTTH' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMATMASIMMETRICOFLAT' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMATMSIMMETRICOFLAT' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMATMASIMMETRICOHL' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMATMSIMMETRICOHL' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMATMASIMMETRICOLITE' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='EASYIPBASEPLUSFLAT' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='EASYIPBASEPLUSLITE' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='EASYIPSPECIALPROFILEFLAT'or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='EASYIPSPECIALPROFILELITE' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMGBEASIMMETRICOFLAT' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='BITSTREAMGBESIMMETRICOFLAT' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VP' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VLANNGA' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VLAN' or upper-case($AssetIn/Input/tns:Request/tns:Offerta)='VLANVULA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMNGAFTTCAB' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMNGAFTTH' or upper-case($AssetIn.Input/tns:Offerta)='VULAFTTCAB' or upper-case($AssetIn.Input/tns:Offerta)='VULAFTTH' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMATMASIMMETRICOFLAT' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMATMSIMMETRICOFLAT' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMATMASIMMETRICOHL' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMATMSIMMETRICOHL' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMATMASIMMETRICOLITE' or upper-case($AssetIn.Input/tns:Offerta)='EASYIPBASEPLUSFLAT' or upper-case($AssetIn.Input/tns:Offerta)='EASYIPBASEPLUSLITE' or upper-case($AssetIn.Input/tns:Offerta)='EASYIPSPECIALPROFILEFLAT'or upper-case($AssetIn.Input/tns:Offerta)='EASYIPSPECIALPROFILELITE' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMGBEASIMMETRICOFLAT' or upper-case($AssetIn.Input/tns:Offerta)='BITSTREAMGBESIMMETRICOFLAT' or upper-case($AssetIn.Input/tns:Offerta)='VP' or upper-case($AssetIn.Input/tns:Offerta)='VLANNGA' or upper-case($AssetIn.Input/tns:Offerta)='VLAN' or upper-case($AssetIn.Input/tns:Offerta)='VLANVULA']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartAssetToSelect_NumberPortability">
