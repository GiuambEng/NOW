                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/AssetToponomastica/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Select_IdContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;Controllo&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectDATISEDE&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAssetToponomastica&quot;/>&#xa;    &lt;xsl:template name=&quot;AssetOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Controllo='False'&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$SelectDATISEDE/Record&quot;>&#xa;                        &lt;tns1:RecordAssetToponomastica>&#xa;                            &lt;tns1:NUMERO_CIVICO>&#xa;                                &lt;xsl:value-of select=&quot;NUMERO_CIVICO&quot;/>&#xa;                            &lt;/tns1:NUMERO_CIVICO>&#xa;                            &lt;tns1:CAP>&#xa;                                &lt;xsl:value-of select=&quot;CAP&quot;/>&#xa;                            &lt;/tns1:CAP>&#xa;                            &lt;xsl:if test=&quot;DR&quot;>&#xa;                                &lt;tns1:DR>&#xa;                                    &lt;xsl:value-of select=&quot;DR&quot;/>&#xa;                                &lt;/tns1:DR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:DESCR_PARTICELLA_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_PARTICELLA_TOPON&quot;/>&#xa;                            &lt;/tns1:DESCR_PARTICELLA_TOPON>&#xa;                            &lt;tns1:DESCR_VIA>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_VIA&quot;/>&#xa;                          