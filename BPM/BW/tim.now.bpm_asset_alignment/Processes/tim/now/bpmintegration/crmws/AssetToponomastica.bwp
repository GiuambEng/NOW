                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($AssetIn.Input/tns:Offerta)='NP' or upper-case($AssetIn.Input/tns:Offerta)='NPNG']]></bpws:transitionCondition>
