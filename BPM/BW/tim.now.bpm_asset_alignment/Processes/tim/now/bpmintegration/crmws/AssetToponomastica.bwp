                                    sqlStatement="SELECT PARTICELLA.DESCR_PARTICELLA_TOPON, VIA.DESCR_VIA,NUMERO_CIVICO,&#xa;       COMUNE_O_LOCALITA.DESCR_COMUNE, NUMERO_CIVICO.CAP,NUMERO_CIVICO.COD_TOPON, &#xa;       VIA.COD_COMUNE, VIA.COD_ISTAT_COMUNE,VIA.COD_VIA,PROV.DESCR_PROV,PROV.SIGLA_PROV,NUMERO_CIVICO.DR,&#xa;       PROV.COD_ISTAT_PROV&#xa;  FROM NUMERO_CIVICO,VIA,COMUNE_O_LOCALITA,PARTICELLA,PROV,BDS_1_CASEDATA_ASSET&#xa;  WHERE BDS_1_CASEDATA_ASSET.IDRISORSA = ?&#xa;  AND BDS_1_CASEDATA_ASSET.CODICETOPONOMASTICA= NUMERO_CIVICO.COD_TOPON AND NUMERO_CIVICO.COD_STRADA = VIA.COD_STRADA &#xa;  AND VIA.COD_PARTICELLA_TOPON= PARTICELLA.COD_PARTICELLA_TOPON AND VIA.COD_COMUNE = COMUNE_O_LOCALITA.COD_COMUNE &#xa;  AND COMUNE_O_LOCALITA.COD_PROV = PROV.COD_PROV" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <columnMetadata
                                    columnName="DESCR_PARTICELLA_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_VIA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMERO_CIVICO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="CAP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_COMUNE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_VIA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_PROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="SIGLA_PROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="DR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_PROV"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;AssetIn&quot;/>&lt;xsl:param name=&quot;SelectDATISEDE&quot;/>&lt;xsl:template name=&quot;LogSelectDatiSede-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;AssetToponomastica&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Asset&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$AssetIn/Input/tns1:Request/tns1:ID_Rich_OLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$AssetIn/Input/tns1:Request/tns1:ID_Rich_OLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectDATISEDE/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('SelectDatiSede', xsd:string(count($SelectDATISEDE/Record)))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'SelectAssetToponomastica Record non trovato'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESS