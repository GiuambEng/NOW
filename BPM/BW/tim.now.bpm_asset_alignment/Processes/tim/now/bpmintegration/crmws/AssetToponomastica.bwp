                              &lt;/tns1:COD_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:RecordAssetToponomastica>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Controllo='True'&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$SelectAssetToponomastica/Record&quot;>&#xa;                        &lt;tns1:RecordAssetToponomastica>&#xa;                            &lt;tns1:NUMERO_CIVICO>&#xa;                                &lt;xsl:value-of select=&quot;NUMERO_CIVICO&quot;/>&#xa;                            &lt;/tns1:NUMERO_CIVICO>&#xa;                            &lt;tns1:CAP>&#xa;                                &lt;xsl:value-of select=&quot;CAP&quot;/>&#xa;                            &lt;/tns1:CAP>&#xa;                            &lt;xsl:if test=&quot;DR&quot;>&#xa;                                &lt;tns1:DR>&#xa;                                    &lt;xsl:value-of select=&quot;DR&quot;/>&#xa;                                &lt;/tns1:DR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:DESCR_PARTICELLA_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_PARTICELLA_TOPON&quot;/>&#xa;                            &lt;/tns1:DESCR_PARTICELLA_TOPON>&#xa;                            &lt;tns1:DESCR_VIA>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_VIA&quot;/>&#xa;                            &lt;/tns1:DESCR_VIA>&#xa;                            &lt;tns1:COD_ISTAT_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;COD_ISTAT_COMUNE&quot;/>&#xa;                            &lt;/tns1:COD_ISTAT_COMUNE>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(COD_VIA)&quot;>&#xa;                                    &lt;tns1:COD_VIA>&#xa;                                        &lt;xsl:value-of select=&quot;COD_VIA&quot;/>&#xa;                                    &lt;/tns1:COD_VIA>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns1:DESCR_COMUNE>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_COMUNE&quot;/>&#xa;                            &lt;/tns1:DESCR_COMUNE>&#xa;                            &lt;tns1:SIGLA_PROV>&#xa;                                &lt;xsl:value-of select=&quot;SIGLA_PROV&quot;/>&#xa;                            &lt;/tns1:SIGLA_PROV>&#xa;                            &lt;tns1:COD_ISTAT_PROV>&#xa;                                &lt;xsl:value-of select=&quot;COD_ISTAT_PROV&quot;/>&#xa;                            &lt;/tns1:COD_ISTAT_PROV>&#xa;                            &lt;tns1:DESCR_PROV>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_PROV&quot;/>&#xa;                            &lt;/tns1:DESCR_PROV>&#xa;                            &lt;tns1:COD_TOPON>&#xa;                                &lt;xsl:value-of select=&quot;COD_TOPON&quot;/>&#xa;                            &lt;/tns1:COD_TOPON>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists(COD_COMUNE)&quot;>&#xa;                                    &lt;tns1:COD_COMUNE>&#xa;                                        &lt;xsl:value-of select=&quot;COD_COMUNE&quot;/>&#xa;                                    &lt;/tns1:COD_COMUNE>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise/>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:RecordAssetToponomastica>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:for-each select=&quot;$Select_IdContratto/Record&quot;>&#xa;                &lt;tns1:RecordIdContratto>&#xa;                    &lt;tns1:ID_CONTRATTO_CRMWS>&#xa;                        &lt;xsl:value-of select=&quot;ID_CONTRATTO_CRMWS&quot;/>&#xa;                    &lt;/tns1:ID_CONTRATTO_CRMWS>&#xa;                &lt;/tns1:RecordIdContratto>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
