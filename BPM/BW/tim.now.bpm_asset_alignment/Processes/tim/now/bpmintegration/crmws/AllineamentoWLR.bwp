f test="tns:DB_LAST_UPD"&gt;&lt;tns2:DB_LAST_UPD&gt;&lt;xsl:value-of select="tns:DB_LAST_UPD"/&gt;&lt;/tns2:DB_LAST_UPD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:DB_LAST_UPD_SRC"&gt;&lt;tns2:DB_LAST_UPD_SRC&gt;&lt;xsl:value-of select="tns:DB_LAST_UPD_SRC"/&gt;&lt;/tns2:DB_LAST_UPD_SRC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:DN"&gt;&lt;tns2:DN&gt;&lt;xsl:value-of select="tns:DN"/&gt;&lt;/tns2:DN&gt;&lt;/xsl:if&gt;&lt;/tns2:Record&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$NOWtoCRMWS_AllineamentoWLRIn/Input/tns3:REQUEST/tns3:ASSETPRINCIPALE/IDRichiestaOLO"&gt;&lt;tns2:Id_rich_olo&gt;&lt;xsl:value-of select="$NOWtoCRMWS_AllineamentoWLRIn/Input/tns3:REQUEST/tns3:ASSETPRINCIPALE/IDRichiestaOLO"/&gt;&lt;/tns2:Id_rich_olo&gt;&lt;/xsl:if&gt;&lt;/tns2:Record&gt;&lt;/Input&gt;&lt;/tns1:InsertOGGRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
