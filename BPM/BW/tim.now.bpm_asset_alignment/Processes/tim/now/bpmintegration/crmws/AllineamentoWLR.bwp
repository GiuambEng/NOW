>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/interno&quot;>&#xa;                    &lt;interno>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/interno&quot;/>&#xa;                    &lt;/interno>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/piano&quot;>&#xa;                    &lt;piano>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/piano&quot;/>&#xa;                    &lt;/piano>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/scala&quot;>&#xa;                    &lt;scala>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/scala&quot;/>&#xa;                    &lt;/scala>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:copy-of select=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/dettaglioasset&quot;/>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/DESPrimoOrdine&quot;>&#xa;                    &lt;DESPrimoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/DESPrimoOrdine&quot;/>&#xa;                    &lt;/DESPrimoOrdine>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/CAP&quot;>&#xa;                    &lt;CAP>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSETPRINCIPALE/CAP&quot;/>&#xa;                    &lt;/CAP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoWLRIn.Input/tns:ASSE