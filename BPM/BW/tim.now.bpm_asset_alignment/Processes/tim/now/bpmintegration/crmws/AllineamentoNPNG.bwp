&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;exists($NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/assetTarget)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/assetTarget&quot;/>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:RICHIESTA>&#xa;            &lt;xsl:if test=&quot;$SequenceOGG/Output/tns2:Output/tns2:NextVal[1]&quot;>&#xa;                &lt;tns1:NextVal>&#xa;                    &lt;xsl:value-of select=&quot;$SequenceOGG/Output/tns2:Output/tns2:NextVal[1]&quot;/>&#xa;                &lt;/tns1:NextVal>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordIdContratto[1]/tns3:ID_CONTRATTO_CRMWS&quot;>&#xa;                &lt;tns1:IdContratto>&#xa;                    &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordIdContratto[1]/tns3:ID_CONTRATTO_CRMWS&quot;/>&#xa;                &lt;/tns1:IdContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;count($Asset/Output/tns3:Response/tns3:RecordAssetToponomastica)>0&quot;>&#xa;                &lt;tns1:RecordAsset>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:NUMERO_CIVICO&quot;>&#xa;                        &lt;tns1:NumeroCivico>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:NUMERO_CIVICO&quot;/>&#xa;                        &lt;/tns1:NumeroCivico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:CAP&quot;>&#xa;                        &lt;tns1:CAP>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:CAP&quot;/>&#xa;                        &lt;/tns1:CAP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DR&quot;>&#xa;                        &lt;tns1:DR>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DR&quot;/>&#xa;                        &lt;/tns1:DR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_PARTICELLA_TOPON&quot;>&#xa;                        &lt;tns1:DescrParticellaTopon>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_PARTICELLA_TOPON&quot;/>&#xa;                        &lt;/tns1:DescrParticellaTopon>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_VIA&quot;>&#xa;                        &lt;tns1:DescrVia>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_VIA&quot;/>&#xa;                        &lt;/tns1:DescrVia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_ISTAT_COMUNE&quot;>&#xa;                        &lt;tns1:CodISTATComune>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_ISTAT_COMUNE&quot;/>&#xa;                        &lt;/tns1:CodISTATComune>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:CodVia>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_VIA)&quot;/>&#xa;                    &lt;/tns1:CodVia>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_COMUNE&quot;>&#xa;                        &lt;tns1:DescrComune>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_COMUNE&quot;/>&#xa;                        &lt;/tns1:DescrComune>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:SIGLA_PROV&quot;>&#xa;                        &lt;tns1:SiglaProv>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:SIGLA_PROV&quot;/>&#xa;                        &lt;/tns1:SiglaProv>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_ISTAT_PROV&quot;>&#xa;                        &lt;tns1:CodISTATProv>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_ISTAT_PROV&quot;/>&#xa;                        &lt;/tns1:CodISTATProv>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_PROV&quot;>&#xa;                        &lt;tns1:DescrProv>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:DESCR_PROV&quot;/>&#xa;                        &lt;/tns1:DescrProv>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_TOPON&quot;>&#xa;                        &lt;tns1:Cod_Topon>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_TOPON&quot;/>&#xa;                        &lt;/tns1:Cod_Topon>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_COMUNE&quot;>&#xa;                        &lt;tns1:Cod_Comune>&#xa;                            &lt;xsl:value-of select=&quot;$Asset/Output/tns3:Response/tns3:RecordAssetToponomastica[1]/tns3:COD_COMUNE&quot;/>&#xa;                        &lt;/tns1:Cod_Comune>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:RecordAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:CODE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:SERVIZIO/tns:CODICE_OLO&quot;/>&#xa;            &lt;/tns1:CODE_OLO>&#xa;        &lt;/tns1:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
