&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/InsertOGG" xmlns:tns4="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertOGG" xmlns:tns="http://www.tim.com/NOW/xsd/SequenceOGG" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza" version="2.0"&gt;
    &lt;xsl:param name="SequenceOGG"/&gt;
    &lt;xsl:param name="DynamicMapper"/&gt;
    &lt;xsl:param name="NOWtoCRMWS_AllineamentoNPNGIn"/&gt;
    &lt;xsl:template name="InsertOGG-input" match="/"&gt;
        &lt;tns1:InsertOGGRequest&gt;
            &lt;Input&gt;
                &lt;tns5:Record&gt;
                    &lt;xsl:for-each select="$DynamicMapper/tns4:RESPONSE"&gt;
                        &lt;tns5:Record&gt;
                            &lt;xsl:if test="tns4:COD_SRVZ"&gt;
                                &lt;tns5:COD_SRVZ&gt;
                                    &lt;xsl:value-of select="tns4:COD_SRVZ"/&gt;
                                &lt;/tns5:COD_SRVZ&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:CREATED&gt;
                                &lt;xsl:value-of select="tns4:CREATED"/&gt;
                            &lt;/tns5:CREATED&gt;
                            &lt;xsl:if test="tns4:ID_ASSET_CRMWS"&gt;
                                &lt;tns5:ID_ASSET_CRMWS&gt;
                                    &lt;xsl:value-of select="tns4:ID_ASSET_CRMWS"/&gt;
                                &lt;/tns5:ID_ASSET_CRMWS&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:ID_ASSET_NOW&gt;
                                &lt;xsl:value-of select="tns4:ID_ASSET_NOW"/&gt;
                            &lt;/tns5:ID_ASSET_NOW&gt;
                            &lt;xsl:if test="tns4:ID_ORDN"&gt;
                                &lt;tns5:ID_ORDN&gt;
                                    &lt;xsl:value-of select="tns4:ID_ORDN"/&gt;
                                &lt;/tns5:ID_ORDN&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns4:ID_RISORSA"&gt;
                                &lt;tns5:ID_RISORSA&gt;
                                    &lt;xsl:value-of select="tns4:ID_RISORSA"/&gt;
                                &lt;/tns5:ID_RISORSA&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns4:LAVRZ"&gt;
                                &lt;tns5:LAVRZ&gt;
                                    &lt;xsl:value-of select="tns4:LAVRZ"/&gt;
                                &lt;/tns5:LAVRZ&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns4:MESSAGGIO"&gt;
                                &lt;tns5:MESSAGGIO&gt;
                                    &lt;xsl:value-of select="tns4:MESSAGGIO"/&gt;
                                &lt;/tns5:MESSAGGIO&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns4:STATO"&gt;
                                &lt;tns5:STATO&gt;
                                    &lt;xsl:value-of select="tns4:STATO"/&gt;
                                &lt;/tns5:STATO&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;
                            &lt;/tns5:TRANSACTION_ID&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($SequenceOGG/Output/tns:Output/tns:Record/tns:TRANSACTION_ID_PARENT)"&gt;
                                    &lt;xsl:if test="$SequenceOGG/Output/tns:Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT"&gt;
                                        &lt;tns5:TRANSACTION_ID_PARENT&gt;
                                            &lt;xsl:value-of select="$SequenceOGG/Output/tns:Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT"/&gt;
                                        &lt;/tns5:TRANSACTION_ID_PARENT&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns5:TRANSACTION_ID_PARENT&gt;
                                        &lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;
                                    &lt;/tns5:TRANSACTION_ID_PARENT&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($SequenceOGG/Output/tns:Output/tns:Record/tns:TRANSACTION_ID_ROOT)"&gt;
                                    &lt;xsl:if test="$SequenceOGG/Output/tns:Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT"&gt;
                                        &lt;tns5:TRANSACTION_ID_ROOT&gt;
                                            &lt;xsl:value-of select="$SequenceOGG/Output/tns:Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT"/&gt;
                                        &lt;/tns5:TRANSACTION_ID_ROOT&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns5:TRANSACTION_ID_ROOT&gt;
                                        &lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;
                                    &lt;/tns5:TRANSACTION_ID_ROOT&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:if test="tns4:CODICE_OLO"&gt;
                                &lt;tns5:CODICE_OLO&gt;
                                    &lt;xsl:value-of select="tns4:CODICE_OLO"/&gt;
                                &lt;/tns5:CODICE_OLO&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:ROW_ID&gt;
                                &lt;xsl:value-of select="tns4:ROW_ID"/&gt;
                            &lt;/tns5:ROW_ID&gt;
                            &lt;xsl:if test="tns4:CREATED_BY"&gt;
                                &lt;tns5:CREATED_BY&gt;
                                    &lt;xsl:value-of select="tns4:CREATED_BY"/&gt;
                                &lt;/tns5:CREATED_BY&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:LAST_UPD&gt;
                                &lt;xsl:value-of select="tns4:LAST_UPD"/&gt;
                            &lt;/tns5:LAST_UPD&gt;
                            &lt;xsl:if test="tns4:LAST_UPD_BY"&gt;
                                &lt;tns5:LAST_UPD_BY&gt;
                                    &lt;xsl:value-of select="tns4:LAST_UPD_BY"/&gt;
                                &lt;/tns5:LAST_UPD_BY&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:MODIFICATION_NUM&gt;
                                &lt;xsl:value-of select="tns4:MODIFICATION_NUM"/&gt;
                            &lt;/tns5:MODIFICATION_NUM&gt;
                            &lt;tns5:CONFLICT_ID&gt;
                                &lt;xsl:value-of select="tns4:CONFLICT_ID"/&gt;
                            &lt;/tns5:CONFLICT_ID&gt;
                            &lt;xsl:if test="tns4:DB_LAST_UPD"&gt;
                                &lt;tns5:DB_LAST_UPD&gt;
                                    &lt;xsl:value-of select="tns4:DB_LAST_UPD"/&gt;
                                &lt;/tns5:DB_LAST_UPD&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns4:DB_LAST_UPD_SRC"&gt;
                                &lt;tns5:DB_LAST_UPD_SRC&gt;
                                    &lt;xsl:value-of select="tns4:DB_LAST_UPD_SRC"/&gt;
                                &lt;/tns5:DB_LAST_UPD_SRC&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns4:DN"&gt;
                                &lt;tns5:DN&gt;
                                    &lt;xsl:value-of select="tns4:DN"/&gt;
                                &lt;/tns5:DN&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns5:Record&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;xsl:if test="$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns2:REQUEST/tns2:ASSETPRINCIPALE/IDRichiestaOLO"&gt;
                        &lt;tns5:Id_rich_olo&gt;
                            &lt;xsl:value-of select="$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns2:REQUEST/tns2:ASSETPRINCIPALE/IDRichiestaOLO"/&gt;
                        &lt;/tns5:Id_rich_olo&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns5:Record&gt;
            &lt;/Input&gt;
        &lt;/tns1:InsertOGGRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertOGG&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoNPNGIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceOGG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;DynamicMapper&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertOGG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Record>&#xa;            &lt;xsl:for-each select=&quot;$DynamicMapper/tns4:RESPONSE&quot;>&#xa;                &lt;tns5:Record>&#xa;                    &lt;xsl:if test=&quot;tns4:COD_SRVZ&quot;>&#xa;                        &lt;tns5:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;tns4:COD_SRVZ&quot;/>&#xa;                        &lt;/tns5:COD_SRVZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:CREATED>&#xa;                        &lt;xsl:value-of select=&quot;tns4:CREATED&quot;/>&#xa;                    &lt;/tns5:CREATED>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_ASSET_CRMWS&quot;>&#xa;                        &lt;tns5:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ID_ASSET_CRMWS&quot;/>&#xa;                        &lt;/tns5:ID_ASSET_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:ID_ASSET_NOW>&#xa;                        &lt;xsl:value-of select=&quot;tns4:ID_ASSET_NOW&quot;/>&#xa;                    &lt;/tns5:ID_ASSET_NOW>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_ORDN&quot;>&#xa;                        &lt;tns5:ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ID_ORDN&quot;/>&#xa;                        &lt;/tns5:ID_ORDN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_RISORSA&quot;>&#xa;                        &lt;tns5:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ID_RISORSA&quot;/>&#xa;                        &lt;/tns5:ID_RISORSA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:LAVRZ&quot;>&#xa;                        &lt;tns5:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;tns4:LAVRZ&quot;/>&#xa;                        &lt;/tns5:LAVRZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:MESSAGGIO&quot;>&#xa;                        &lt;tns5:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tns4:MESSAGGIO&quot;/>&#xa;                        &lt;/tns5:MESSAGGIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:STATO&quot;>&#xa;                        &lt;tns5:STATO>&#xa;                            &lt;xsl:value-of select=&quot;tns4:STATO&quot;/>&#xa;                        &lt;/tns5:STATO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns4:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns5:TRANSACTION_ID>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SequenceOGG.Output/tns:Record/tns:TRANSACTION_ID_PARENT)&quot;>&#xa;                            &lt;xsl:if test=&quot;$SequenceOGG.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT&quot;>&#xa;                                &lt;tns5:TRANSACTION_ID_PARENT>&#xa;                                    &lt;xsl:value-of select=&quot;$SequenceOGG.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT&quot;/>&#xa;                                &lt;/tns5:TRANSACTION_ID_PARENT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:TRANSACTION_ID_PARENT>&#xa;                                &lt;xsl:value-of select=&quot;tns4:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns5:TRANSACTION_ID_PARENT>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SequenceOGG.Output/tns:Record/tns:TRANSACTION_ID_ROOT)&quot;>&#xa;                            &lt;xsl:if test=&quot;$SequenceOGG.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT&quot;>&#xa;                                &lt;tns5:TRANSACTION_ID_ROOT>&#xa;                                    &lt;xsl:value-of select=&quot;$SequenceOGG.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT&quot;/>&#xa;                                &lt;/tns5:TRANSACTION_ID_ROOT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:TRANSACTION_ID_ROOT>&#xa;                                &lt;xsl:value-of select=&quot;tns4:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns5:TRANSACTION_ID_ROOT>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;tns4:CODICE_OLO&quot;>&#xa;                        &lt;tns5:CODICE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;tns4:CODICE_OLO&quot;/>&#xa;                        &lt;/tns5:CODICE_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:ROW_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns4:ROW_ID&quot;/>&#xa;                    &lt;/tns5:ROW_ID>&#xa;                    &lt;xsl:if test=&quot;tns4:CREATED_BY&quot;>&#xa;                        &lt;tns5:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns4:CREATED_BY&quot;/>&#xa;                        &lt;/tns5:CREATED_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:LAST_UPD>&#xa;                        &lt;xsl:value-of select=&quot;tns4:LAST_UPD&quot;/>&#xa;                    &lt;/tns5:LAST_UPD>&#xa;                    &lt;xsl:if test=&quot;tns4:LAST_UPD_BY&quot;>&#xa;                        &lt;tns5:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns4:LAST_UPD_BY&quot;/>&#xa;                        &lt;/tns5:LAST_UPD_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:MODIFICATION_NUM>&#xa;                        &lt;xsl:value-of select=&quot;tns4:MODIFICATION_NUM&quot;/>&#xa;                    &lt;/tns5:MODIFICATION_NUM>&#xa;                    &lt;tns5:CONFLICT_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns4:CONFLICT_ID&quot;/>&#xa;                    &lt;/tns5:CONFLICT_ID>&#xa;                    &lt;xsl:if test=&quot;tns4:DB_LAST_UPD&quot;>&#xa;                        &lt;tns5:DB_LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DB_LAST_UPD&quot;/>&#xa;                        &lt;/tns5:DB_LAST_UPD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:DB_LAST_UPD_SRC&quot;>&#xa;                        &lt;tns5:DB_LAST_UPD_SRC>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DB_LAST_UPD_SRC&quot;/>&#xa;                        &lt;/tns5:DB_LAST_UPD_SRC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:DN&quot;>&#xa;                        &lt;tns5:DN>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DN&quot;/>&#xa;                        &lt;/tns5:DN>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:Record>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input/tns2:ASSETPRINCIPALE/IDRichiestaOLO&quot;>&#xa;                &lt;tns5:Id_rich_olo>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input/tns2:ASSETPRINCIPALE/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns5:Id_rich_olo>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:Record>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
