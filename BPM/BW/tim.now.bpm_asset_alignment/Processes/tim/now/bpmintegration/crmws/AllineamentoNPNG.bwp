                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Asset.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoNPNGIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceOGG.Output&quot;/>&#xa;    &lt;xsl:template name=&quot;DynamicMapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:REQUEST>&#xa;            &lt;tns1:ASSET>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input/tns:ASSETPRINCIPALE/IDAsset&quot;>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input/tns:ASSETPRINCIPALE/IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                &lt;/xsl:if>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input/tns:ASSETPRINCIPALE/codiceOrdineOLO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input/tns:ASSETPRINCIPALE/codiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input/tns:ASSETPRINCIPALE/codiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn.Input