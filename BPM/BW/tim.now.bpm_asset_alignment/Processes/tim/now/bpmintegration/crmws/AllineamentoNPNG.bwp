ns:REQUEST/tns:RICHIESTA/codiceRisorsaDonating&quot;/>&#xa;                    &lt;/codiceRisorsaDonating>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/codiceRisorsaDonating2&quot;>&#xa;                    &lt;codiceRisorsaDonating2>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/codiceRisorsaDonating2&quot;/>&#xa;                    &lt;/codiceRisorsaDonating2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/cowCodeOLO&quot;>&#xa;                    &lt;cowCodeOLO>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/cowCodeOLO&quot;/>&#xa;                    &lt;/cowCodeOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/cowCodeOLO2&quot;>&#xa;                    &lt;cowCodeOLO2>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/cowCodeOLO2&quot;/>&#xa;                    &lt;/cowCodeOLO2>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/codiceSessione&quot;>&#xa;                    &lt;codiceSessione>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/codiceSessione&quot;/>&#xa;                    &lt;/codiceSessione>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns:RICHIESTA/codiceSessione2&quot;>&#xa;                    &lt;codiceSessione2>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoNPNGIn/Input/tns:REQUEST/tns: