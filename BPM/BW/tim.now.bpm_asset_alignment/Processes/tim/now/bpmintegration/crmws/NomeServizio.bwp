COHL' or upper-case($NomeServizioIn.Input/tns:Offerta)='BITSTREAMATMSIMMETRICOHL' or upper-case($NomeServizioIn.Input/tns:Offerta)='BITSTREAMATMASIMMETRICOLITE' or  upper-case($NomeServizioIn.Input/tns:Offerta)='EASYIPBASEPLUSFLAT' or upper-case($NomeServizioIn.Input/tns:Offerta)='EASYIPBASEPLUSLITE' or upper-case($NomeServizioIn.Input/tns:Offerta)='EASYIPSPECIALPROFILEFLAT'or upper-case($NomeServizioIn.Input/tns:Offerta)='EASYIPSPECIALPROFILELITE') then concat($Nome,'XDSLATM') else if (upper-case($NomeServizioIn.Input/tns:Offerta)='BITSTREAMGBEASIMMETRICOFLAT' or upper-case($NomeServizioIn.Input/tns:Offerta)='BITSTREAMGBESIMMETRICOFLAT') then concat($Nome,'XDSLGBE') else if(upper-case($NomeServizioIn.Input/tns:Offerta)='VULL' or upper-case($NomeServizioIn.Input/tns:Offerta)='VULLLINEANONATTIVA') then concat($Nome,'VULL')  else if(upper-case($NomeServizioIn.Input/tns:Offerta)='CPS') then concat($Nome,'CPS') else &#xd;&#xa;if(upper-case($NomeServizioIn.Input/tns:Offerta)='NPNG') then concat($Nome,'NPNG') else &#xd;&#xa;if(upper-case($NomeServizioIn.Input/tns:Offerta)='VP') then concat($Nome,'VP') else if(upper-case($NomeServizioIn.Input/tns:Offerta)='VLANNGA') then concat($Nome,'VLANNGA') else if(upper-case($NomeServizioIn.Input/tns:Offerta)='VLAN') then concat($Nome,'VLAN') else if(upper-case($NomeServizioIn.Input/tns:Offerta)='VLANVULA') then concat($Nome,'VLANVULA') else concat($Nome,'Interface')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
