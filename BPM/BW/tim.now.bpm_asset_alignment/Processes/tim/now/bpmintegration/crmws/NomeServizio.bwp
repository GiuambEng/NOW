&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NomeServizio" xmlns:tns1="http://www.tim.com/NOW/xsd/NOWNomeServizio/" version="2.0"&gt;&lt;xsl:param name="Nome"/&gt;&lt;xsl:template name="NomeServizioOut-input" match="/"&gt;&lt;tns:NomeServizioResponse&gt;&lt;Output&gt;&lt;tns1:ResponseNomeServizio&gt;&lt;tns1:NomeServizio&gt;&lt;xsl:value-of select="$Nome"/&gt;&lt;/tns1:NomeServizio&gt;&lt;/tns1:ResponseNomeServizio&gt;&lt;/Output&gt;&lt;/tns:NomeServizioResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NomeServizio&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWNomeServizio/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Nome&quot;/>&#xa;    &lt;xsl:template name=&quot;NomeServizioOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ResponseNomeServizio>&#xa;            &lt;tns1:NomeServizio>&#xa;                &lt;xsl:value-of select=&quot;$Nome&quot;/>&#xa;            &lt;/tns1:NomeServizio>&#xa;        &lt;/tns1:ResponseNomeServizio>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
