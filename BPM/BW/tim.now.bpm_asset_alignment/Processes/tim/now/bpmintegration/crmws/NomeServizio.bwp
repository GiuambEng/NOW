            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if(upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='ULLLINEANONATTIVA' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='ULLDATILINEANONATTIVA') then concat($Nome,'ULLLNA') else if(upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='NP') then concat($Nome,'NPG') else if(upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='ULLDATILINEAATTIVA' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='ULLLINEAATTIVA' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='ULLDATILINEAATTIVANP' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='ULLLINEAATTIVANP') then concat($Nome,'ULLLA') else if ( upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='WLR' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='WLRLINEAATTIVA' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='WLRLINEANONATTIVA' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='VARIAZIONEWLR' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='CESSAZIONEWLRLINEAATTIVA' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='CESSAZIONEWLRLINEANONATTIVA') then concat($Nome,'WLR') else if (upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='SLULINEANONATTIVA') then concat ($Nome,'SLULNA') else if (upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='SLULINEAATTIVA' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='SLULINEAATTIVANP' ) then concat ($Nome,'SLULA') else if (starts-with($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta,'SHA')) then concat ($Nome,'SHA') else if (upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='BITSTREAMNGAFTTCAB' or upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='BITSTREAMNGAFT