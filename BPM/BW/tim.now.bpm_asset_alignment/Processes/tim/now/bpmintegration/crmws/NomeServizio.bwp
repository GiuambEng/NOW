ncat($Nome,'VP') else if(upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='VLANNGA') then concat($Nome,'VLANNGA') else if(upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='VLAN') then concat($Nome,'VLAN') else if(upper-case($NomeServizioIn/Input/tns:RequestNomeServizio/tns:Offerta)='VLANVULA') then concat($Nome,'VLANVULA') else concat($Nome,'Interface')"
