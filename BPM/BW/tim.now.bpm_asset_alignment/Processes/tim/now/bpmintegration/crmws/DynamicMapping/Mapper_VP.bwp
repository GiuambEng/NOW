                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToLogMappingAttivazione_VP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVP/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Attivazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns1:REQUEST>&#xa;            &lt;ns1:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns2:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&#xa;            &lt;/ns1:TRANSACTION_ID>&#xa;            &lt;ns1:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&#xa;            &lt;/ns1:TRANSACTION_DATE>&#xa;            &lt;ns1:SERVIZIO>&#xa;                &lt;ns1:CODICEOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:CODE_OLO&quot;/>&#xa;                &lt;/ns1:CODICEOLO>&#xa;                &lt;ns1:DESCOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codificaOLOAGCOM&quot;/>&#xa;                &lt;/ns1:DESCOLO>&#xa;                &lt;ns1:VP>&#xa;                    &lt;ns1:SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;35&amp;quot;&quot;/>&#xa;                    &lt;/ns1:SERVIZIO>&#xa;                    &lt;ns1:ATTIVAZIONE>&#xa;                        &lt;ns1:CODICEORDINEOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineOLO&quot;/>&#xa;                        &lt;/ns1:CODICEORDINEOLO>&#xa;                        &lt;ns1:CODICE_ORDINE_TI>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineTI&quot;/>&#xa;                        &lt;/ns1:CODICE_ORDINE_TI>&#xa;                        &lt;ns1:CONTRATTO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:IdContratto&quot;/>&#xa;                        &lt;/ns1:CONTRATTO>&#xa;                        &lt;ns1:RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDRisorsa&quot;/>&#xa;                        &lt;/ns1:RISORSA>&#xa;                        &lt;xsl:if test=&quot;exists($Start/tns2:ASSET/IDAsset)&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAsset&quot;>&#xa;                                &lt;ns1:ID_NOW>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAsset&quot;/>&#xa;                                &lt;/ns1:ID_NOW>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/IDAssetCRMWS)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;>&#xa;                                &lt;ns1:ID_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;/>&#xa;                                &lt;/ns1:ID_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ns1:DEC>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/DES&quot;/>&#xa;                        &lt;/ns1:DEC>&#xa;                        &lt;ns1:CODICECLLI>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/CLLI&quot;/>&#xa;                        &lt;/ns1:CODICECLLI>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='NOMECLLI']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='NOMECLLI']/valoreAttributo&quot;>&#xa;                                &lt;ns1:NOMECLLI>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='NOMECLLI']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:NOMECLLI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TIPOVLAN']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TIPOVLAN']/valoreAttributo&quot;>&#xa;                                &lt;ns1:TIPOVLAN>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TIPOVLAN']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:TIPOVLAN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ns1:CODICETDKIT>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CODICETDKIT']/valoreAttributo&quot;/>&#xa;                        &lt;/ns1:CODICETDKIT>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CODICEMACROAREA']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CODICEMACROAREA']/valoreAttributo&quot;>&#xa;                                &lt;ns1:CODICEMACROAREA>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CODICEMACROAREA']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:CODICEMACROAREA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='NOMEMACROAREA']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='NOMEMACROAREA']/valoreAttributo&quot;>&#xa;                                &lt;ns1:NOMEMACROAREA>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='NOMEMACROAREA']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:NOMEMACROAREA>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDMADRCRMWS']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDMADRCRMWS']/valoreAttributo&quot;>&#xa;                                &lt;ns1:IDMADRCRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDMADRCRMWS']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:IDMADRCRMWS>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TRASPORTO']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TRASPORTO']/valoreAttributo&quot;>&#xa;                                &lt;ns1:TRASPORTO>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='TRASPORTO']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:TRASPORTO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo&quot;>&#xa;                                &lt;ns1:VPI>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VPI']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:VPI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VPIRETE']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VPIRETE']/valoreAttributo&quot;>&#xa;                                &lt;ns1:VPIRETE>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VPIRETE']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:VPIRETE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='BANDAMCR']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='BANDAMCR']/valoreAttributo&quot;>&#xa;                                &lt;ns1:BANDAMCR>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='BANDAMCR']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:BANDAMCR>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='BANDAPCR']/valoreAttributo)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='BANDAPCR']/valoreAttributo&quot;>&#xa;                                &lt;ns1:BANDAPCR>&#xa;                                    &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='BANDAPCR']/valoreAttributo&quot;/>&#xa;                                &lt;/ns1:BANDAPCR>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;ns1:CARATTERISTICAVP>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CARATTERISTICAVP']/valoreAttributo&quot;/>&#xa;                        &lt;/ns1:CARATTERISTICAVP>&#xa;                    &lt;/ns1:ATTIVAZIONE>&#xa;                &lt;/ns1:VP>&#xa;            &lt;/ns1:SERVIZIO>&#xa;        &lt;/ns1:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
