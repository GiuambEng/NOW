            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper3-input"
                    name="Mapper3" outputVariable="Mapper3"
                    tibex:xpdlId="a1c3a12c-7f76-4818-826d-bf16e327f4d9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogMappingAttivazione_VPToMapper3"/>
                        <bpws:target linkName="LogMappingVariazione_VPToMapper3"/>
                        <bpws:target linkName="LogMappingCessazione_VPToMapper3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper3ToLogMapperOutputVP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVP/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Cessazione&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Attivazione&quot;/>&lt;xsl:param name=&quot;Variazione&quot;/>&lt;xsl:template name=&quot;Mapper3-input&quot; match=&quot;/&quot;>&lt;tns:RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Cessazione)&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$Cessazione/ns:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Cessazione/ns:SERVIZIO/ns:VP/ns:SERVIZIO)&quot;>&lt;xsl:if test=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:SERVIZIO&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:SERVIZIO&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:CESSAZIONE/ns:ID_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:CESSAZIONE/ns:ID_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:CESSAZIONE/ns:ID_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:CESSAZIONE/ns:CODICEORDINEOLO&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:CESSAZIONE/ns:CODICEORDINEOLO&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:CESSAZIONE/ns:RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$Cessazione/ns:SERVIZIO/ns:VP/ns:CESSAZIONE/ns:RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;&amp;quot;CESSAZIONE&amp;quot;&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;tib:render-xml($Cessazione,true(), true())&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;&amp;quot;DA LAVORARE&amp;quot;&quot;/>&lt;/tns:STATO>&lt;xsl:if test=&quot;$Start/tns:CODE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;$Start/tns:CODE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;$Start/tns:NextVal&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:CREATED_BY>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;'Null'&quot;/>&lt;/tns:LAST_UPD_BY>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;'0'&quot;/>&lt;/tns:CONFLICT_ID>&lt;/tns:RESPONSE>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Variazione)&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$Variazione/ns:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Variazione/ns:SERVIZIO/ns:VP/ns:SERVIZIO)&quot;>&lt;xsl:if test=&quot;