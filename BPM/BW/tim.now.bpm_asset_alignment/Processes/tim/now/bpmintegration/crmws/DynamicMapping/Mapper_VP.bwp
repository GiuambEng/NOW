                    outputVariable="Attivazione"
                    tibex:xpdlId="42d9c6ca-ea45-4f9c-8dae-fcf3f019c5a7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
