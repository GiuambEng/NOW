                                    <value
                                    inputQName="NOW_CRMWS_AllineamentoConsistenzeVP:REQUEST" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
