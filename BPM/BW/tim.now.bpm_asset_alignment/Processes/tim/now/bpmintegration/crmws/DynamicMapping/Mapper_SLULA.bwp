        <bpws:variable element="ns2:RESPONSE" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogFaultMapper_SLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
