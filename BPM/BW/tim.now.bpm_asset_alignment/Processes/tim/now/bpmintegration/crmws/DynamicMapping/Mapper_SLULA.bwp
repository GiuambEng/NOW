                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeSLULA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AttivazioneSLULA-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns1:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:DESCOLO>&lt;tns:SLULA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta=&amp;quot;SLULINEAATTIVA&amp;quot;&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;26&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;27&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ATTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineOLO)>11&quot;>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns1:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns1:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/IDAssetCRMWS)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/numeroTelefonico&quot;/>&lt;/tns:DN>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/distretto)  and string-length($Start/tns1:ASSET/distretto)>0&quot;>&lt;tns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns1:ASSET/distretto)))&quot;/>&lt;/tns:DISTR_TELEFONICO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:DISTR_TELEFONICO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CLLI_CENTRALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/CLLI&quot;/>&lt;/tns:CLLI_CENTRALE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo&quot;>&lt;tns:IDARLTI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente=&amp;quot;ACCESSOSLU&amp;quot;]/attributidettaglioasset[nomeAttributo=&amp;quot;IDARLTI&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:IDARLTI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;CODECENTRALEACLRR&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;CODECENTRALEACLRR&amp;quot;]/valoreAttributo&quot;>&lt;tns:CODICE_CENTRALE_ACLRR>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;CODECENTRALEACLRR&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:CODICE_CENTRALE_ACLRR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;COPPIA&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;COPPIA&amp;quot;]/valoreAttributo&quot;>&lt;tns:COPPIA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;COPPIA&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:COPPIA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;IDSLUCO&amp;quot;]/valoreAttributo)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;>&lt;tns:IDSLUCO_NGOM>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;IDSLUCO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:IDSLUCO_NGOM>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta=&amp;quot;SLULINEAATTIVANP&amp;quot;&quot;>&lt;tns:FLAG_BUNDLE>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FLAG_BUNDLE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:AGGIUNTIVI>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns:AGGIUNTIVI>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;FLAGMANTENIMENTOPRODOTTI&amp;quot;]/valoreAttributo=&amp;quot;0&amp;quot;&quot;>&lt;tns:MANTENIMENTO_PRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:MANTENIMENTO_PRODOTTI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MANTENIMENTO_PRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;S&amp;quot;&quot;/>&lt;/tns:MANTENIMENTO_PRODOTTI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[nomeComponente =&amp;quot;ACCESSOSLU&amp;quot;]&amp;#xD;&amp;#xA;/attributidettaglioasset[nomeAttributo=&amp;quot;TIPOLINEA&amp;quot;]/valoreAttributo)>0&quot;>&lt;tns:TIPO_DN>&lt;xsl:value-of select=&quot;up