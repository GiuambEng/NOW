        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogStartMapper_SLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:REQUEST"
            name="AttivazioneSLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:REQUEST" name="AttivazioneSLULA" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:REQUEST"
            name="VariazioneSLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:REQUEST" name="VariazioneSLULA" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:REQUEST"
            name="CessazioneSLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:REQUEST" name="CessazioneSLULA" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogAttivazioneSLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogVariazioneSLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogCessazioneSLULA-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:CW_BUS_MESSAGE"
            name="LogMapperOutput-input" sca-bpel:internal="true"/>
