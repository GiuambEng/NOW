                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeSLULA/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;VariazioneSLULA-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns1:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:DESCOLO>&lt;tns:SLULA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta=&amp;quot;SLULINEAATTIVA&amp;quot;&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;26&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;27&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:VARIAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineOLO)>11&quot;>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns1:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/