            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AttivazioneSLULA-input"
                    name="AttivazioneSLULA"
                    outputVariable="AttivazioneSLULA"
                    tibex:xpdlId="9138da79-28a1-420a-a9e1-701f30fa036f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
