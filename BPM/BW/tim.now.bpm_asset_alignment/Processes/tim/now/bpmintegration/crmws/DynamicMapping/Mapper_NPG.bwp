                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/MappingNPGOGG /&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CODE_OLO&quot;/>&lt;xsl:template name=&quot;MapperCessazioneNPBundle-input&quot; match=&quot;/&quot;>&lt;tns2:ROOT_ATTIVAZIONE_NP>&lt;xsl:for-each select=&quot;$Start/tns1:NumeriAggiuntivi&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string(tns1:NextVal),10,'0'))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CODE_OLO/tns3:CODE_OLO)>0&quot;>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$CODE_OLO/tns3:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns4:CodificaOLOAgcom&quot;/>&lt;/tns:DESCOLO>&lt;tns:NPG>&lt;tns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&lt;/tns:CRMWS_SERVICE>&lt;tns:CESSAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;tn