alue-of select=&quot;../tns4:RICHIESTA/ordine/CF&quot;/>&lt;/ns:CF>&lt;/xsl:if>&lt;xsl:if test=&quot;../tns4:RICHIESTA/ordine/PIVA&quot;>&lt;ns:PIVA>&lt;xsl:value-of select=&quot;../tns4:RICHIESTA/ordine/PIVA&quot;/>&lt;/ns:PIVA>&lt;/xsl:if>&lt;/ns:CLIENTE>&lt;/ns:ATTIVAZIONE>&lt;/ns:NPG>&lt;/ns:SERVIZIO>&lt;/ns:REQUEST>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns:ROOT_ATTIVAZIONE_NP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
