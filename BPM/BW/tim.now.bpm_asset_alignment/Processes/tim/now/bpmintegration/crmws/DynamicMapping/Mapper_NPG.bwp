                                    inputVariable="LogAccumulateAttivazioneTransactionID_Root-input"
                                    name="LogAccumulateAttivazioneTransactionID_Root"
                                    tibex:xpdlId="e0a26f47-3f72-4330-b0a3-81affdb6c20b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToCallProcess1"/>
