                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns1=&quot;http://www.example.org/AccumulateNPOGG&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TransactionID_RootAttivazione&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;MapperAttivazioneNPG&quot;/>&lt;xsl:param name=&quot;MapperAttivazioneNPBundle&quot;/>&lt;xsl:template name=&quot;AccumulateAttivazioneTransactionID_Root-input&quot; match=&quot;/&quot;>&lt;tns1:NP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperAttivazioneNPG/ns:REQUEST)&quot;>&lt;tns1:Record>&lt;xsl:if test=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CRMWS_SERVICE&quot;>&lt;tns1:COD_SERVZ>&lt;xsl:value-of select=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CRMWS_SERVICE&quot;/>&lt;/tns1:COD_SERVZ>&lt;/xsl:if>&lt;tns1:CREATED>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:CREATED>&lt;xsl:if test=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_CRMWS&quot;>&lt;tns1:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_CRMWS&quot;/>&lt;/tns1:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW&quot;>&lt;tns1:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW&quot;/>&lt;/tns1:ID_ASSET_NOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVI