GGIO&quot;/>&#xa;                                &lt;/tns:MESSAGGIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:STATO&quot;>&#xa;                                &lt;tns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:STATO&quot;/>&#xa;                                &lt;/tns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:TRANSACTION_ID_ROOT&quot;>&#xa;                                &lt;tns:TRANSACTION_ID_ROOT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:TRANSACTION_ID_ROOT&quot;/>&#xa;                                &lt;/tns:TRANSACTION_ID_ROOT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:TRANSACTION_ID_PARENT&quot;>&#xa;                                &lt;tns:TRANSACTION_ID_PARENT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:TRANSACTION_ID_PARENT&quot;/>&#xa;                                &lt;/tns:TRANSACTION_ID_PARENT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:CODICE_OLO&quot;>&#xa;                                &lt;tns:CODICE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:CODICE_OLO&quot;/>&#xa;                                &lt;/tns:CODICE_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ROW_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:ROW_ID&quot;/>&#xa;                            &lt;/tns:ROW_ID>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:CREATED_BY&quot;>&#xa;                                &lt;tns:CREATED_BY>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:CREATED_BY&quot;/>&#xa;                                &lt;/tns:CREATED_BY>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:LAST_UPD>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:LAST_UPDT&quot;/>&#xa;                            &lt;/tns:LAST_UPD>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:LAST_UPDT_BY&quot;>&#xa;                                &lt;tns:LAST_UPD_BY>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:LAST_UPDT_BY&quot;/>&#xa;                                &lt;/tns:LAST_UPD_BY>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:MODIFICATION_NUM>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:MODIFICATION_NUM&quot;/>&#xa;                            &lt;/tns:MODIFICATION_NUM>&#xa;                            &lt;tns:CONFLICT_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:CONFLICT_ID&quot;/>&#xa;                            &lt;/tns:CONFLICT_ID>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:DB_LAST_UPD&quot;>&#xa;                                &lt;tns:DB_LAST_UPD>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:DB_LAST_UPD&quot;/>&#xa;                                &lt;/tns:DB_LAST_UPD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:DB_LAST_UPD_SRC&quot;>&#xa;                                &lt;tns:DB_LAST_UPD_SRC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:DB_LAST_UPD_SRC&quot;/>&#xa;                                &lt;/tns:DB_LAST_UPD_SRC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:DN&quot;>&#xa;                                &lt;tns:DN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:DN&quot;/>&#xa;                                &lt;/tns:DN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:RESPONSE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$Accumulate1/tns1:NP&quot;>&#xa;                        &lt;tns:RESPONSE>&#xa;                            &lt;tns:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns:TRANSACTION_ID>&#xa;                            &lt;tns:RESPONSE_DATE>&#xa;                                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                            &lt;/tns:RESPONSE_DATE>&#xa;                            &lt;tns:RETURN_CODE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns:RETURN_CODE>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:COD_SERVZ&quot;>&#xa;                                &lt;tns:COD_SRVZ>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:COD_SERVZ&quot;/>&#xa;                                &lt;/tns:COD_SRVZ>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:CREATED>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:CREATED&quot;/>&#xa;                            &lt;/tns:CREATED>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:ID_ASSET_CRMWS&quot;>&#xa;                                &lt;tns:ID_ASSET_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:ID_ASSET_CRMWS&quot;/>&#xa;                                &lt;/tns:ID_ASSET_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ID_ASSET_NOW>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:ID_ASSET_NOW&quot;/>&#xa;                            &lt;/tns:ID_ASSET_NOW>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:ID_ORDN&quot;>&#xa;                                &lt;tns:ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:ID_ORDN&quot;/>&#xa;                                &lt;/tns:ID_ORDN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:ID_RISORSA&quot;>&#xa;                                &lt;tns:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:ID_RISORSA&quot;/>&#xa;                                &lt;/tns:ID_RISORSA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:LAVRZ&quot;>&#xa;                                &lt;tns:LAVRZ>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:LAVRZ&quot;/>&#xa;                                &lt;/tns:LAVRZ>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:MESSAGGIO&quot;>&#xa;                                &lt;tns:MESSAGGIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:MESSAGGIO&quot;/>&#xa;                                &lt;/tns:MESSAGGIO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:STATO&quot;>&#xa;                                &lt;tns:STATO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:STATO&quot;/>&#xa;                                &lt;/tns:STATO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:TRANSACTION_ID_ROOT&quot;>&#xa;                                &lt;tns:TRANSACTION_ID_ROOT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:TRANSACTION_ID_ROOT&quot;/>&#xa;                                &lt;/tns:TRANSACTION_ID_ROOT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:TRANSACTION_ID_PARENT&quot;>&#xa;                                &lt;tns:TRANSACTION_ID_PARENT>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:TRANSACTION_ID_PARENT&quot;/>&#xa;                                &lt;/tns:TRANSACTION_ID_PARENT>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:CODICE_OLO&quot;>&#xa;                                &lt;tns:CODICE_OLO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:CODICE_OLO&quot;/>&#xa;                                &lt;/tns:CODICE_OLO>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:ROW_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:ROW_ID&quot;/>&#xa;                            &lt;/tns:ROW_ID>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:CREATED_BY&quot;>&#xa;                                &lt;tns:CREATED_BY>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:CREATED_BY&quot;/>&#xa;                                &lt;/tns:CREATED_BY>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:LAST_UPD>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:LAST_UPDT&quot;/>&#xa;                            &lt;/tns:LAST_UPD>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:LAST_UPDT_BY&quot;>&#xa;                                &lt;tns:LAST_UPD_BY>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:LAST_UPDT_BY&quot;/>&#xa;                                &lt;/tns:LAST_UPD_BY>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:MODIFICATION_NUM>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:MODIFICATION_NUM&quot;/>&#xa;                            &lt;/tns:MODIFICATION_NUM>&#xa;                            &lt;tns:CONFLICT_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns1:Record/tns1:CONFLICT_ID&quot;/>&#xa;                            &lt;/tns:CONFLICT_ID>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:DB_LAST_UPD&quot;>&#xa;                                &lt;tns:DB_LAST_UPD>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:DB_LAST_UPD&quot;/>&#xa;                                &lt;/tns:DB_LAST_UPD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:DB_LAST_UPD_SRC&quot;>&#xa;                                &lt;tns:DB_LAST_UPD_SRC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:DB_LAST_UPD_SRC&quot;/>&#xa;                                &lt;/tns:DB_LAST_UPD_SRC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:Record/tns1:DN&quot;>&#xa;                                &lt;tns:DN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:Record/tns1:DN&quot;/>&#xa;                                &lt;/tns:DN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:RESPONSE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:RESPONSE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
