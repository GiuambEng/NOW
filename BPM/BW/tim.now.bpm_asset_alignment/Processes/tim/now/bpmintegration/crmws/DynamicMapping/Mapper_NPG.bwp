            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="bba883f2-11b0-4cdc-9c60-6f5dc7a65603">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToEmpty"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
