                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="e7a8d452-9628-40fe-ae31-16dcf4aa8863">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToTransactionID_RootCessazione"/>
                                </bpws:sources>
                            </bpws:empty>
