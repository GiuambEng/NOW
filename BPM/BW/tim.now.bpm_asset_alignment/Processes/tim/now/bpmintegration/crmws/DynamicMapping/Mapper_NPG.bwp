                    <bpws:sources>
                        <bpws:source linkName="Mapper1ToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingNPGOGG /&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CODE_OLO&quot;/>&lt;xsl:template name=&quot;MapperCessazioneNPG-input&quot; match=&quot;/&quot;>&lt;tns:ROOT_CESSAZIONE_NP>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string($Start/tns4:NextVal),10,'0'))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CODE_OLO/tns1:CODE_OLO)>0&quot;>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$CODE_OLO/tns1:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODICEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/codificaOLOAGCOM&quot;/>&lt;/ns:DESCOLO>&lt;ns:NPG>&lt;ns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&lt;/ns:CRMWS_SERVICE>&lt;ns:CESSAZIONE>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/codiceOrdineOLO&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns4:ASSET/codiceOrdineTI)>0&quot;>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/codiceOrdineTI&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns4:IdContratto&quot;>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns4:IdContratto&quot;/>&lt;/ns:CONTRATTO>&lt;/xsl:if>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/IDRisorsa&quot;/>&lt;/ns:RISORSA>&lt;xsl:if test=&quot;exists($Start/tns4:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns4:ASSET/IDAsset&quot;>&lt;ns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/IDAsset&quot;/>&lt;/ns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns4:ASSET/IDAssetCRMWS&quot;>&lt;ns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/IDAssetCRMWS&quot;/>&lt;/ns:ID_CRMWS>&lt;/xsl:if>&lt;ns:DEC>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/DES&quot;/>&lt;/ns:DEC>&lt;/ns:CESSAZIONE>&lt;/ns:NPG>&lt;/ns:SERVIZIO>&lt;/ns:REQUEST>&lt;xsl:if test=&quot;count($Start/tns4:NumeriAggiuntivi)>0&quot;>&lt;xsl:for-each select=&quot;$Start/tns4:NumeriAggiuntivi&quot;>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string(tns4:NextVal),10,'0'))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;../tns4:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;../tns4:ASSET/codificaOLOAGCOM&quot;/>&lt;/ns:DESCOLO>&lt;ns:NPG>&lt;ns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&lt;/ns:CRMWS_SERVICE>&lt;ns:CESSAZIONE>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;../tns4:ASSET/codiceOrdineOLO&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../tns4:ASSET/codiceOrdineTI)>0&quot;>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;../tns4:ASSET/codiceOrdineTI&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;../tns4:IdContratto&quot;>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;../tns4:IdContratto&quot;/>&lt;/ns:CONTRATTO>&lt;/xsl:if>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;tns4:NumeriAggiuntivi/tns3:NumeroTelefonico&quot;/>&lt;/ns:RISORSA>&lt;xsl:if test=&quot;exists(tns4:NumeriAggiuntivi/tns3:IDAsset)&quot;>&lt;xsl:if test=&quot;tns4:NumeriAggiuntivi/tns3:IDAsset&quot;>&lt;ns:ID_NOW>&lt;xsl:value-of select=&quot;tns4:NumeriAggiuntivi/tns3:IDAsset&quot;/>&lt;/ns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;../tns4:ASSET/IDAssetCRMWS&quot;>&lt;ns:ID_CRMWS>&lt;xsl:value-of select=&quot;../tns4:ASSET/IDAssetCRMWS&quot;/>&lt;/ns:ID_CRMWS>&lt;/xsl:if>&lt;ns:DEC>&lt;xsl:value-of select=&quot;../tns4:ASSET/DES&quot;/>&lt;/ns:DEC>&lt;/ns:CESSAZIONE>&lt;/ns:NPG>&lt;/ns:SERVIZIO>&lt;/ns:REQUEST>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns:ROOT_CESSAZIONE_NP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
