                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingNPGOGG /&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;CODE_OLOAttivazione&quot;/>&lt;xsl:template name=&quot;MapperAttivazioneNPBundle-input&quot; match=&quot;/&quot;>&lt;tns:ROOT_ATTIVAZIONE_NP>&lt;xsl:for-each select=&quot;$Start/tns1:NumeriAggiuntivi&quot;>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string(tns1:NextVal),10,'0'))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$CODE_OLOAttivazione/tns2:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:CodificaOLOAgcom&quot;/>&lt;/ns:DESCOLO>&lt;ns:NPG>&lt;ns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&lt;/ns:CRMWS_SERVICE>&lt;ns:ATTIVAZIONE>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:CodiceOrdineOLO&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:NumeriAggiuntivi/tns3:CodiceOrdineTI)>0&quot;>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:CodiceOrdineTI&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../tns1:IdContratto)>0&quot;>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;../tns1:IdContratto&quot;/>&lt;/ns:CONTRATTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:CONTRATTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;position()=1&quot;>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:IDRisorsa&quot;/>&lt;/ns:RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NumeroTelefonico&quot;/>&lt;/ns:RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists(tns1:NumeriAggiuntivi/tns3:IDAsset)&quot;>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:IDAsset&quot;>&lt;ns:ID_NOW>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:IDAsset&quot;/>&lt;/ns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:IDAssetCRMWS&quot;>&lt;ns:ID_CRMWS>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:IDAssetCRMWS&quot;/>&lt;/ns:ID_CRMWS>&lt;/xsl:if>&lt;ns:DEC>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:DES&quot;/>&lt;/ns:DEC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns1:NumeriAggiuntivi/tns3:Distretto) and string-length(tns1:NumeriAggiuntivi/tns3:Distretto)>0&quot;>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer(tns1:NumeriAggiuntivi/tns3:Distretto)))&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ROUTING_NUMBER>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:ROUTINGNUMBER&quot;/>&lt;/ns:ROUTING_NUMBER>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:CodificaOLOAgicomDonating&quot;>&lt;ns:CODICE_OLO_DONATING>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:CodificaOLOAgicomDonating&quot;/>&lt;/ns:CODICE_OLO_DONATING>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:OLORETAILER)>0&quot;>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:OLORETAILER&quot;>&lt;ns:CODICEOLO_RETAILER>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:OLORETAILER&quot;/>&lt;/ns:CODICEOLO_RETAILER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:PRINCIPALE&quot;>&lt;ns:PRIMARY_NUMBER>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:PRINCIPALE&quot;/>&lt;/ns:PRIMARY_NUMBER>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='RTG' and upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_DN>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns:TIPO_DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_DN>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ns:TIPO_DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='NATIVO VOIP IMS'&amp;#xD;&amp;#xA;&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ALICE MIA' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ALICE NAKED' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)= 'BMO IP CENTREX' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='FONIA IP PBX' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='FONIA IP PBX P' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='FONIA VPBX TOP' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR IP CENTREX' or &amp;#xD;&amp;#xA;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR IP PBX'  or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR IP PBX P' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR VPBX TOP' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='RTG IP CENTREX'  or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='VPBX BASIC' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='VPBX PLUS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ALICE MIA'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ALICE NAKED'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='RTG' and upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='CAPOSERIE' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='LINEA PBX') and upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='GNR RADICALE' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='RADICALE ACCORPATO' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='GNR LINEE'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='B10' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ISDN BMO') and upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:RADICALE&quot;>&lt;ns:RADICE_GNR>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:RADICALE&quot;/>&lt;/ns:RADICE_GNR>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='NATIVO VOIP IMS'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALEAGGIUNTIVI)>0&quot;>&lt;ns:NUMERO_LINEE>&lt;xsl:value-of select=&quot;xsd:int(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALEAGGIUNTIVI)&quot;/>&lt;/ns:NUMERO_LINEE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ALICE MIA' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ALICE NAKED' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)= 'BMO IP CENTREX' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='FONIA IP PBX' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='FONIA IP PBX P' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='FONIA VPBX TOP' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR IP CENTREX' or &amp;#xD;&amp;#xA;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR IP PBX'  or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR IP PBX P' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='GNR VPBX TOP' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='RTG IP CENTREX'  or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='VPBX BASIC' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='VPBX PLUS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALEAGGIUNTIVI)>0&quot;>&lt;ns:NUMERO_LINEE>&lt;xsl:value-of select=&quot;xsd:int(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALEAGGIUNTIVI)&quot;/>&lt;/ns:NUMERO_LINEE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='RTG' and upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)!='NATIVO VOIP IMS'&quot;>&lt;ns:NUMERO_LINEE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/ns:NUMERO_LINEE>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='CAPOSERIE' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='LINEA PBX') and upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)!='NATIVO VOIP IMS'&quot;>&lt;ns:NUMERO_LINEE>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/ns:NUMERO_LINEE>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='GNR RADICALE' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='RADICALE ACCORPATO' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)='GNR LINEE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALELINEE)>0&quot;>&lt;ns:NUMERO_LINEE>&lt;xsl:value-of select=&quot;xsd:int(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALELINEE)&quot;/>&lt;/ns:NUMERO_LINEE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='B10' or upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPOSERVIZIO)='ISDN BMO') and upper-case(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TIPONUMERO)!='NATIVO VOIP IMS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALEAGGIUNTIVI)>0&quot;>&lt;ns:NUMERO_LINEE>&lt;xsl:value-of select=&quot;xsd:int(tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:TOTALEAGGIUNTIVI)&quot;/>&lt;/ns:NUMERO_LINEE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:CODICERO&quot;>&lt;ns:CODICE_RO>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:CODICERO&quot;/>&lt;/ns:CODICE_RO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:CAPOSERIE&quot;>&lt;ns:CAPOSTIPITE>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:CAPOSERIE&quot;/>&lt;/ns:CAPOSTIPITE>&lt;/xsl:if>&lt;ns:PIATTAFORMA_COMMERCIALE>&lt;xsl:value-of select=&quot;tns1:NumeriAggiuntivi/tns3:NUMBERPORTABILITY/tns3:AttributiNumeriAggiunti/tns3:PIATTAFORME&quot;/>&lt;/ns:PIATTAFORMA_COMMERCIALE>&lt;ns:CLIENTE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../tns1:RICHIESTA/ordine/cognomeRagioneSociale)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../tns1:RICHIESTA/ordine/cognomeRagioneSociale)>60&quot;>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;substring(../tns1:RICHIESTA/ordine/cognomeRagioneSociale,1,60)&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;../tns1:RICHIESTA/ordine/cognomeRagioneSociale&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:COGNOMERAGSOC>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:COGNOMERAGSOC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;../tns1:RICHIESTA/ordine/nome&quot;>&lt;ns:NOME>&lt;xsl:value-of select=&quot;../tns1:RICHIESTA/ordine/nome&quot;/>&lt;/ns:NOME>&lt;/xsl:if>&lt;xsl:if test=&quot;../tns1:RICHIESTA/ordine/CF&quot;>&lt;ns:CF>&lt;xsl:value-of select=&quot;../tns1:RICHIESTA/ordine/CF&quot;/>&lt;/ns:CF>&lt;/xsl:if>&lt;xsl:if test=&quot;../tns1:RICHIESTA/ordine/PIVA&quot;>&lt;ns:PIVA>&lt;xsl:value-of select=&quot;../tns1:RICHIESTA/ordine/PIVA&quot;/>&lt;/ns:PIVA>&lt;/xsl:if>&lt;/ns:CLIENTE>&lt;/ns:ATTIVAZIONE>&lt;/ns:NPG>&lt;/ns:SERVIZIO>&lt;/ns:REQUEST>&lt;/xsl:for-each>&lt;/tns:ROOT_ATTIVAZIONE_NP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
