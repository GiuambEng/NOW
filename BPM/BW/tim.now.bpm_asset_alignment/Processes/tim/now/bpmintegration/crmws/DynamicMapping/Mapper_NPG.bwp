                    <bpws:sources>
                        <bpws:source linkName="LogEndMapping_NPGToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogEndMapping_NPG-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;'End Processo dinamico Mapper_NPG'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws.DynamicMapping'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;'Mapper_NPG_COMPLETED'&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_NPG_&amp;quot;, $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'OUT'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="NPG" tibex:xpdlId="c0d892de-8a97-410e-852e-182fb538346e">
                <bpws:targets>
                    <bpws:target linkName="LogStartMapping_NPGToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="NPGToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/tns:RICHIESTA/lavorazione)='ATTIVAZIONE' or $Start/tns:LavorazioneAsset='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/tns:RICHIESTA/lavorazione)='ATTIVAZIONE' or $Start/tns:LavorazioneAsset='ATTIVAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="NPGToCODE_OLO">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/tns:RICHIESTA/lavorazione)='CESSAZIONE' or $Start/tns:LavorazioneAsset='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/tns:RICHIESTA/lavorazione)='CESSAZIONE' or $Start/tns:LavorazioneAsset='CESSAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="NPGToCallProcess_AltreLavorazionenonammesse">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperAttivazioneNPG-input"
                    name="MapperAttivazioneNPG"
                    outputVariable="MapperAttivazioneNPG"
                    tibex:xpdlId="b6f09712-d5e5-4b4b-926d-4565a96d76f5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToMapperAttivazioneNPG"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/MappingNPGOGG /&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapperAttivazioneNPG-input&quot; match=&quot;/&quot;>&lt;tns:ROOT_ATTIVAZIONE_NP>&lt;ns:REQUEST>&lt;ns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string($Start/tns4:NextVal),10,'0'))&quot;/>&lt;/ns:TRANSACTION_ID>&lt;ns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/ns:TRANSACTION_DATE>&lt;ns:SERVIZIO>&lt;ns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns4:CODE_OLO&quot;/>&lt;/ns:CODICEOLO>&lt;ns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/codificaOLOAGCOM&quot;/>&lt;/ns:DESCOLO>&lt;ns:NPG>&lt;ns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;16&amp;quot;&quot;/>&lt;/ns:CRMWS_SERVICE>&lt;ns:ATTIVAZIONE>&lt;ns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/codiceOrdineOLO&quot;/>&lt;/ns:CODICEORDINEOLO>&lt;ns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/codiceOrdineTI&quot;/>&lt;/ns:CODICE_ORDINE_TI>&lt;ns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns4:IdContratto&quot;/>&lt;/ns:CONTRATTO>&lt;ns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/IDRisorsa&quot;/>&lt;/ns:RISORSA>&lt;xsl:if test=&quot;exists($Start/tns4:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns4:ASSET/IDAsset&quot;>&lt;ns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/IDAsset&quot;/>&lt;/ns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns4:ASSET/IDAssetCRMWS&quot;>&lt;ns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/IDAssetCRMWS&quot;/>&lt;/ns:ID_CRMWS>&lt;/xsl:if>&lt;ns:DEC>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/DES&quot;/>&lt;/ns:DEC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns4:ASSET/distretto) and string-length($Start/tns4:ASSET/distretto)>0&quot;>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns4:ASSET/distretto)))&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/ns:DISTR_TELEFONICO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ns:ROUTING_NUMBER>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='ROUTINGNUMBER']/valoreAttributo&quot;/>&lt;/ns:ROUTING_NUMBER>&lt;xsl:if test=&quot;$Start/tns4:ASSET/codificaOLOAGCOMDonating&quot;>&lt;ns:CODICE_OLO_DONATING>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/codificaOLOAGCOMDonating&quot;/>&lt;/ns:CODICE_OLO_DONATING>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns4:ASSET/dettaglioasset[nomeComponente='NUMBERPORTABILITY']/attributidettaglioasset[nomeAttributo='OLORETAILER']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns4:ASSET/dettaglioasset[nomeComponente='NUMBERPORTABILITY']/attributidettaglioasset[nomeAttributo='OLORETAILER']/valoreAttributo&quot;>&lt;ns:CODICEOLO_RETAILER>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/dettaglioasset[nomeComponente='NUMBERPORTABILITY']/attributidettaglioasset[nomeAttributo='OLORETAILER']/valoreAttributo&quot;/>&lt;/ns:CODICEOLO_RETAILER>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns4:ASSET/numTelPrincipale&quot;>&lt;ns:PRIMARY_NUMBER>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/numTelPrincipale&quot;/>&lt;/ns:PRIMARY_NUMBER>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='RTG' and upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_DN>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns:TIPO_DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_DN>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ns:TIPO_DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)='NATIVO VOIP IMS'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;9&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='ALICE MIA' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='ALICE NAKED' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)= 'BMO IP CENTREX' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='FONIA IP PBX' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='FONIA IP PBX P' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='FONIA VPBX TOP' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='GNR IP CENTREX' or &amp;#xD;&amp;#xA;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='GNR IP PBX'  or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='GNR IP PBX P' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='GNR VPBX TOP' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='RTG IP CENTREX'  or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='VPBX BASIC' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='VPBX PLUS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='ALICE MIA'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;7&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='ALICE NAKED'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;4&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;8&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='RTG' and upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='CAPOSERIE' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='LINEA PBX') and upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)='GNR RADICALE' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)='RADICALE ACCORPATO' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)='GNR LINEE'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='B10' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='ISDN BMO') and upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)!='NATIVO VOIP IMS'&quot;>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;5&amp;quot;&quot;/>&lt;/ns:TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='RADICALE']/valoreAttributo&quot;>&lt;ns:RADICE_GNR>&lt;xsl:value-of select=&quot;$Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='RADICALE']/valoreAttributo&quot;/>&lt;/ns:RADICE_GNR>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPONUMERO']/valoreAttributo)='NATIVO VOIP IMS'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TOTALEAGGIUNTIVI']/valoreAttributo)>0&quot;>&lt;ns:NUMERO_LINEE>&lt;xsl:value-of select=&quot;xsd:int($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TOTALEAGGIUNTIVI']/valoreAttributo)&quot;/>&lt;/ns:NUMERO_LINEE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='ALICE MIA' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='ALICE NAKED' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)= 'BMO IP CENTREX' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='FONIA IP PBX' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='FONIA IP PBX P' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUMBERPORTABILITY']/attributidettaglioasset[upper-case(nomeAttributo)='TIPOSERVIZIO']/valoreAttributo)='FONIA VPBX TOP' or upper-case($Start/tns4:ASSET/dettaglioasset[upper-case(nomeComponente)='NUM