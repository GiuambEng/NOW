                            <bpws:invoke
                                inputVariable="TransactionID_RootAttivazione-input"
                                name="TransactionID_RootAttivazione"
                                operation="SequenceOGG"
                                outputVariable="TransactionID_RootAttivazione"
                                partnerLink="SequenceOGG"
                                portType="ns9:SequenceOGG" tibex:xpdlId="2e94c703-5529-42bb-ac93-8f763d0521be">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SequenceOGG" xmlns:tns1="http://www.tim.com/NOW/xsd/SequenceOGG" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns3="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="MapperAttivazioneNPG"/&gt;&lt;xsl:param name="MapperAttivazioneNPBundle"/&gt;&lt;xsl:template name="TransactionID_RootAttivazione-input" match="/"&gt;&lt;tns:SequenceOGGRequest&gt;&lt;Input&gt;&lt;tns1:Input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($MapperAttivazioneNPG/ns:REQUEST)"&gt;&lt;xsl:if test="$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW"&gt;&lt;tns1:ID_ASSET_NOW&gt;&lt;xsl:value-of select="$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW"/&gt;&lt;/tns1:ID_ASSET_NOW&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$MapperAttivazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW"&gt;&lt;tns1:ID_ASSET_NOW&gt;&lt;xsl:value-of select="$MapperAttivazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW"/&gt;&lt;/tns1:ID_ASSET_NOW&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($MapperAttivazioneNPG/ns:REQUEST)"&gt;&lt;xsl:if test="$Start/tns2:ASSET/IDRichiestaOLO"&gt;&lt;tns1:id_rich_olo&gt;&lt;xsl:value-of select="$Start/tns2:ASSET/IDRichiestaOLO"/&gt;&lt;/tns1:id_rich_olo&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO"&gt;&lt;tns1:id_rich_olo&gt;&lt;xsl:value-of select="$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO"/&gt;&lt;/tns1:id_rich_olo&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:Controllo&gt;&lt;xsl:value-of select="'NumberPortability'"/&gt;&lt;/tns1:Controllo&gt;&lt;/tns1:Input&gt;&lt;/Input&gt;&lt;/tns:SequenceOGGRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SequenceOGG&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperAttivazioneNPG&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperAttivazioneNPBundle&quot;/>&#xa;    &lt;xsl:template name=&quot;TransactionID_RootAttivazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperAttivazioneNPG/ns:REQUEST)&quot;>&#xa;                    &lt;xsl:if test=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW&quot;>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$MapperAttivazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$MapperAttivazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW&quot;>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$MapperAttivazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:ATTIVAZIONE/ns:ID_NOW&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperAttivazioneNPG/ns:REQUEST)&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns2:ASSET/IDRichiestaOLO&quot;>&#xa;                        &lt;tns1:id_rich_olo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:id_rich_olo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO&quot;>&#xa;                        &lt;tns1:id_rich_olo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO&quot;/>&#xa;                        &lt;/tns1:id_rich_olo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:Controllo>&#xa;                &lt;xsl:value-of select=&quot;'NumberPortability'&quot;/>&#xa;            &lt;/tns1:Controllo>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToTransactionID_RootAttivazione"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="TransactionID_RootAttivazioneToCallProcess"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TransactionID_RootAttivazione&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogTransactionID_RootAttivazione-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('TransactionID_RootAttivazione', tib:render-xml($TransactionID_RootAttivazione/Output/tns2:Output, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices/>&lt;/tns:CW_B