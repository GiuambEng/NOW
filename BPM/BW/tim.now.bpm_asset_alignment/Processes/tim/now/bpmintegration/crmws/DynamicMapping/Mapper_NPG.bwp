                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperInsert&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns:RICHIESTA/lavorazione)='ATTIVAZIONE' or upper-case($Start/tns:RICHIESTA/lavorazione)='CESSAZIONE' or $Start/tns:LavorazioneAsset='ATTIVAZIONE' or $Start/tns:LavorazioneAsset='CESSAZIONE'&quot;>&lt;tns:RESPONSE>&lt;xsl:for-each select=&quot;$MapperInsert/tns:RESPONSE&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;tns:RESPONSE_DATE&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;tns:RETURN_CODE&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:if test=&quot;tns:DESCRIZIONE_ERRORE&quot;>&lt;tns:DESCRIZIONE_ERRORE>&lt;xsl:value-of select=&quot;tns:DESCRIZIONE_ERRORE&quot;/>&lt;/tns:DESCRIZIONE_ERRORE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COD_SRVZ&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;tns:COD_SRVZ&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;tns:CREATED&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;tns:ID_ASSET_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;tns:ID_ASSET_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;tns:ID_ASSET_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;tns:ID_ORDN&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;tns:ID_ORDN&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:LAVRZ&quot;>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;tns:LAVRZ&quot;/>&lt;/tns:LAVRZ>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MESSAGGIO&quot;>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;tns:MESSAGGIO&quot;/>&lt;/tns:MESSAGGIO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;tns:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TRANSACTION_ID_ROOT&quot;>&lt;tns:TRANSACTION_ID_ROOT>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_ROOT&quot;/>&lt;/tns:TRANSACTION_ID_ROOT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TRANSACTION_ID_PARENT&quot;>&lt;tns:TRANSACTION_ID_PARENT>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_PARENT&quot;/>&lt;/tns:TRANSACTION_ID_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CODICE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;tns:CODICE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;tns:ROW_ID&quot;/>&lt;/tns:ROW_ID>&lt;xsl:if test=&quot;tns:CREATED_BY&quot;>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;tns:CREATED_BY&quot;/>&lt;/tns:CREATED_BY>&lt;/xsl:if>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;tns:LAST_UPD&quot;/>&lt;/tns:LAST_UPD>&lt;xsl:if test=&quot;tns:LAST_UPD_BY&quot;>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;tns:LAST_UPD_BY&quot;/>&lt;/tns:LAST_UPD_BY>&lt;/xsl:if>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;tns:MODIFICATION_NUM&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;tns:CONFLICT_ID&quot;/>&lt;/tns:CONFLICT_ID>&lt;xsl:if test=&quot;tns:DB_LAST_UPD&quot;>&lt;tns:DB_LAST_UPD>&lt;xsl:value-of select=&quot;tns:DB_LAST_UPD&quot;/>&lt;/tns:DB_LAST_UPD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DB_LAST_UPD_SRC&quot;>&lt;tns:DB_LAST_UPD_SRC>&lt;xsl:value-of select=&quot;tns:DB_LAST_UPD_SRC&quot;/>&lt;/tns:DB_LAST_UPD_SRC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;/tns:RESPONSE>&lt;/xsl:for-each>&lt;/tns:RESPONSE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RESPONSE>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:COD_SRVZ>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CREATED>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ORDN>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:STATO>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CREATED_BY>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:LAST_UPD_BY>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CONFLICT_ID>&lt;/tns:RESPONSE>&lt;/tns:RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogStartMapping_NPG-input"
                    name="LogStartMapping_NPG"
                    tibex:xpdlId="bf66920d-9ee9-453f-9a26-7ccad2bebddb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartMapping_NPGToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogStartMapping_NPG-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start Mapper_NPG', tib:render-xml($Start, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws.DynamicMapping'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_NPG&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_NPG_&amp;quot;,&amp;quot;STARTED&amp;quot;)&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Mapper_NPG_&amp;quot;, $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start))) &quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogEndMapping_NPG-input"
                    name="LogEndMapping_NPG"
                    tibex:xpdlId="aef2308e-c226-422d-9b72-79afb395ef57"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogMapperInsertToLogEndMapping_NPG"/>
