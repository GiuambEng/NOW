                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/SequenceOGG&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperCessazioneNPG&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperCessazioneNPBundle&quot;/>&#xa;    &lt;xsl:template name=&quot;TransactionID_RootCessazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Input>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperCessazioneNPG)&quot;>&#xa;                    &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperCessazioneNPG)&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns2:ASSET/IDRichiestaOLO&quot;>&#xa;                        &lt;tns1:id_rich_olo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:id_rich_olo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO&quot;>&#xa;                        &lt;tns1:id_rich_olo>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO&quot;/>&#xa;                        &lt;/tns1:id_rich_olo>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:Controllo>&#xa;                &lt;xsl:value-of select=&quot;'NumberPortability'&quot;/>&#xa;            &lt;/tns1:Controllo>&#xa;        &lt;/tns1:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToTransactionID_RootCessazione"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="TransactionID_RootCessazioneToCallProcess1"/>
                                </bpws:sources>
                            </bpws:invoke>
