                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&lt;tns2:Request>&lt;xsl:if test=&quot;$Start/tns1:NumeriAggiuntivi[1]/tns1:NumeriAggiuntivi/tns:CodificaOLOAgcom&quot;>&lt;tns2:CodificaOLOAgicom>&lt;xsl:value-of select=&quot;$Start/tns1:NumeriAggiuntivi[1]/tns1:NumeriAggiuntivi/tns:CodificaOLOAgcom&quot;/>&lt;/tns2:CodificaOLOAgicom>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:NumeriAggiuntivi[1]/tns1:NumeriAggiuntivi/tns:IDRichOLO&quot;>&lt;tns2:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns1:NumeriAggiuntivi[1]/tns1:NumeriAggiuntivi/tns:IDRichOLO&quot;/>&lt;/tns2:IDRichiestaOLO>&lt;/xsl:if>&lt;/tns2:Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
