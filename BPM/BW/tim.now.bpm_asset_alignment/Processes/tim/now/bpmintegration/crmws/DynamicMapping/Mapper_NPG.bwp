                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns1=&quot;http://www.example.org/AccumulateNPOGG&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransactionID_RootCessazione.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperCessazioneNPG&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperCessazioneNPBundle&quot;/>&#xa;    &lt;xsl:template name=&quot;AccumulateCessazioneTransactionID_Root-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NP>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($MapperCessazioneNPG/ns:REQUEST)&quot;>&#xa;                    &lt;tns1:Record>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CRMWS_SERVICE&quot;>&#xa;                            &lt;tns1:COD_SERVZ>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CRMWS_SERVICE&quot;/>&#xa;                            &lt;/tns1:COD_SERVZ>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:CREATED>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:CREATED>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_CRMWS&quot;>&#xa;                            &lt;tns1:ID_ASSET_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_CRMWS&quot;/>&#xa;                            &lt;/tns1:ID_ASSET_CRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;>&#xa;                            &lt;tns1:ID_ASSET_NOW>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;/>&#xa;                            &lt;/tns1:ID_ASSET_NOW>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:CODICEORDINEOLO&quot;>&#xa;                            &lt;tns1:ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:CODICEORDINEOLO&quot;/>&#xa;                            &lt;/tns1:ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:RISORSA&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:RISORSA&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                        &lt;/tns1:LAVRZ>&#xa;                        &lt;tns1:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperCessazioneNPG/ns:REQUEST[number($index)],true(), true())&quot;/>&#xa;                        &lt;/tns1:MESSAGGIO>&#xa;                        &lt;tns1:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                        &lt;/tns1:STATO>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;>&#xa;                            &lt;tns1:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_PARENT>&#xa;                                        &lt;xsl:value-of select=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_PARENT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_PARENT>&#xa;                                        &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_PARENT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_ROOT>&#xa;                                        &lt;xsl:value-of select=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_ROOT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_ROOT>&#xa;                                        &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_ROOT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:CODICEOLO&quot;>&#xa;                            &lt;tns1:CODICE_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:CODICEOLO&quot;/>&#xa;                            &lt;/tns1:CODICE_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ROW_ID>&#xa;                            &lt;xsl:value-of select=&quot;substring($MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:TRANSACTION_ID, 3)&quot;/>&#xa;                        &lt;/tns1:ROW_ID>&#xa;                        &lt;!--verificare se è possibile usare la funzione right invece di substring-->&#xa;                        &lt;tns1:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:CREATED_BY>&#xa;                        &lt;tns1:LAST_UPDT>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns1:LAST_UPDT>&#xa;                        &lt;tns1:LAST_UPDT_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:LAST_UPDT_BY>&#xa;                        &lt;tns1:MODIFICATION_NUM>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:MODIFICATION_NUM>&#xa;                        &lt;tns1:CONFLICT_ID>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/tns1:CONFLICT_ID>&#xa;                    &lt;/tns1:Record>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Record>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CRMWS_SERVICE&quot;>&#xa;                            &lt;tns1:COD_SERVZ>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CRMWS_SERVICE&quot;/>&#xa;                            &lt;/tns1:COD_SERVZ>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:CREATED>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:CREATED>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_CRMWS&quot;>&#xa;                            &lt;tns1:ID_ASSET_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_CRMWS&quot;/>&#xa;                            &lt;/tns1:ID_ASSET_CRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;>&#xa;                            &lt;tns1:ID_ASSET_NOW>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW&quot;/>&#xa;                            &lt;/tns1:ID_ASSET_NOW>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:CODICEORDINEOLO&quot;>&#xa;                            &lt;tns1:ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:CODICEORDINEOLO&quot;/>&#xa;                            &lt;/tns1:ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:RISORSA&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:RISORSA&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                        &lt;/tns1:LAVRZ>&#xa;                        &lt;tns1:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($MapperCessazioneNPBundle/ns:REQUEST[number($index)],true(), true())&quot;/>&#xa;                        &lt;/tns1:MESSAGGIO>&#xa;                        &lt;tns1:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                        &lt;/tns1:STATO>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;>&#xa;                            &lt;tns1:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_PARENT>&#xa;                                        &lt;xsl:value-of select=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_PARENT&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_PARENT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_PARENT>&#xa;                                        &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_PARENT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_ROOT>&#xa;                                        &lt;xsl:value-of select=&quot;$TransactionID_RootCessazione.Output/tns:Record[1]/tns:TRANSACTION_ID_ROOT&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_ROOT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;>&#xa;                                    &lt;tns1:TRANSACTION_ID_ROOT>&#xa;                                        &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:TRANSACTION_ID&quot;/>&#xa;                                    &lt;/tns1:TRANSACTION_ID_ROOT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:CODICEOLO&quot;>&#xa;                            &lt;tns1:CODICE_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:CODICEOLO&quot;/>&#xa;                            &lt;/tns1:CODICE_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ROW_ID>&#xa;                            &lt;xsl:value-of select=&quot;substring($MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:TRANSACTION_ID, 3)&quot;/>&#xa;                        &lt;/tns1:ROW_ID>&#xa;                        &lt;!--verificare se è possibile usare la funzione right invece di substring-->&#xa;                        &lt;tns1:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:CREATED_BY>&#xa;                        &lt;tns1:LAST_UPDT>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns1:LAST_UPDT>&#xa;                        &lt;tns1:LAST_UPDT_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:LAST_UPDT_BY>&#xa;                        &lt;tns1:MODIFICATION_NUM>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:MODIFICATION_NUM>&#xa;                        &lt;tns1:CONFLICT_ID>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/tns1:CONFLICT_ID>&#xa;                    &lt;/tns1:Record>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:NP>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
