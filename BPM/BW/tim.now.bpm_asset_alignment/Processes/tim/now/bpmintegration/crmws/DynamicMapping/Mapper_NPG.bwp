                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/SequenceOGG" xmlns:tns1="http://www.tim.com/NOW/xsd/SequenceOGG" xmlns:ns="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNPG/" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns3="http://www.tim.com/NOW/xsd/CRMWSNumberPortability/" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="MapperCessazioneNPG"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="MapperCessazioneNPBundle"/&gt;&lt;xsl:template name="TransactionID_RootCessazione-input" match="/"&gt;&lt;tns:SequenceOGGRequest&gt;&lt;Input&gt;&lt;tns1:Input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($MapperCessazioneNPG)"&gt;&lt;xsl:if test="$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW"&gt;&lt;tns1:ID_ASSET_NOW&gt;&lt;xsl:value-of select="$MapperCessazioneNPG/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW"/&gt;&lt;/tns1:ID_ASSET_NOW&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW"&gt;&lt;tns1:ID_ASSET_NOW&gt;&lt;xsl:value-of select="$MapperCessazioneNPBundle/ns:REQUEST[number($index)]/ns:SERVIZIO/ns:NPG/ns:CESSAZIONE/ns:ID_NOW"/&gt;&lt;/tns1:ID_ASSET_NOW&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($MapperCessazioneNPG)"&gt;&lt;xsl:if test="$Start/tns2:ASSET/IDRichiestaOLO"&gt;&lt;tns1:id_rich_olo&gt;&lt;xsl:value-of select="$Start/tns2:ASSET/IDRichiestaOLO"/&gt;&lt;/tns1:id_rich_olo&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO"&gt;&lt;tns1:id_rich_olo&gt;&lt;xsl:value-of select="$Start/tns2:NumeriAggiuntivi[1]/tns2:NumeriAggiuntivi/tns3:IDRichOLO"/&gt;&lt;/tns1:id_rich_ol