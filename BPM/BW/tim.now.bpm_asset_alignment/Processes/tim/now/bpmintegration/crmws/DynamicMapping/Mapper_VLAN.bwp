    <tibex:VariableDescriptor type="MemorySaving">
        <task name="End">
            <endingVariables>
                <variable>MapperOutputVLAN</variable>
            </endingVariables>
        </task>
        <task name="LogStart_VLAN">
            <endingVariables>
                <variable>LogStart_VLAN-input</variable>
            </endingVariables>
        </task>
        <task name="Variazione">
            <endingVariables>
                <variable>Variazione-input</variable>
            </endingVariables>
        </task>
        <task name="Attivazione">
            <endingVariables>
                <variable>Attivazione-input</variable>
            </endingVariables>
        </task>
        <task name="Cessazione">
            <endingVariables>
                <variable>Cessazione-input</variable>
            </endingVariables>
        </task>
        <task name="LogMappingAttivazione_VLAN">
            <endingVariables>
                <variable>LogMappingAttivazione_VLAN-input</variable>
            </endingVariables>
        </task>
        <task name="LogMappingVariazione_VLAN">
            <endingVariables>
                <variable>LogMappingVariazione_VLAN-input</variable>
            </endingVariables>
        </task>
        <task name="LogMappingCessazione_VLAN">
            <endingVariables>
                <variable>LogMappingCessazione_VLAN-input</variable>
            </endingVariables>
        </task>
        <task name="LogAltreLavorazioni">
            <endingVariables>
                <variable>LogAltreLavorazioni-input</variable>
            </endingVariables>
        </task>
        <task name="MapperOutputVLAN">
            <endingVariables>
                <variable>MapperOutputVLAN-input</variable>
                <variable>Variazione</variable>
                <variable>Attivazione</variable>
                <variable>Cessazione</variable>
            </endingVariables>
        </task>
        <task name="LogMapperOutputVLAN">
            <endingVariables>
                <variable>LogMapperOutputVLAN-input</variable>
            </endingVariables>
        </task>
        <task name="LogEndMapper_VLAN">
            <endingVariables>
                <variable>LogEndMapper_VLAN-input</variable>
                <variable>LogLevel</variable>
            </endingVariables>
        </task>
        <task name="LogErrorMapperVLAN">
            <endingVariables>
                <variable>LogErrorMapperVLAN-input</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
            elementFormDefault="qualified"
            targetNamespace="http://www.tibco.com/pe/EngineTypes"
            xmlns:tns="http://www.tibco.com/pe/EngineTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <xs:complexType block="extension restriction"
                final="extension restriction" name="ErrorReport">
                <xs:sequence>
                    <xs:element
