                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogStart_VLAN-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_VLAN&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_VLAN&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_VLAN&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Start &amp;quot;Mapper_VLAN&amp;quot;', tib:render-xml($Start, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws.DynamicMapping'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Mapper_VLAN&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;MAPPER_VLAN&amp;quot;,$Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="bf2c5b1e-19a9-4ec0-8055-618e758b871e">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToEnd"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEnd_VAR">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:RICHIESTA/lavorazione=&quot;VARIAZIONE&quot; or $Start/ns1:LavorazioneAsset='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:RICHIESTA/lavorazione="VARIAZIONE" or $Start/ns1:LavorazioneAsset='VARIAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToMapper2_CES">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:RICHIESTA/lavorazione=&quot;CESSAZIONE&quot; or $Start/ns1:LavorazioneAsset='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:RICHIESTA/lavorazione="CESSAZIONE" or $Start/ns1:LavorazioneAsset='CESSAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToMapper1_ATT">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns1:RICHIESTA/lavorazione=&quot;ATTIVAZIONE&quot; or $Start/ns1:LavorazioneAsset='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns1:RICHIESTA/lavorazione="ATTIVAZIONE" or $Start/ns1:LavorazioneAsset='ATTIVAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCallProcess5">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Variazione-input" name="Variazione"
                    outputVariable="Variazione"
                    tibex:xpdlId="da64129b-5941-4223-bb65-9727d91bd400" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToEnd_VAR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeVLANGBE/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Variazione-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string($Start/tns1:NextVal),10,'0'))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:DESCOLO>&lt;tns:VLANGBE>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;33&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;tns:VARIAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns1:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;xsl:if test=&quot;exists($Start/tns1:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Start/tns1:ASSET/IDAssetCRMWS)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;/xsl:if>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;tns:CODICECLLI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/CLLI&quot;/>&lt;/tns:CODICECLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:RICHIESTA/tipologiaSottolav='VARIAZIONETDKIT'&quot;>&lt;tns:TIPOLOGIA_VARIAZIONE>&lt;xsl:value-of select=&quot;'16'&quot;/>&lt;/tns:TIPOLOGIA_VARIAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RICHIESTA/tipologiaSottolav='VARIAZIONENUMEROCONDIVISORI'&quot;>&lt;tns:TIPOLOGIA_VARIAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;19&amp;quot;&quot;/>&lt;/tns:TIPOLOGIA_VARIAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:RICHIESTA/tipologiaSottolav='VARIAZIONECAR'&quot;>&lt;tns:TIPOLOGIA_VARIAZIONE>&lt;xsl:value-of select=&quot;'18'&quot;/>&lt;/tns:TIPOLOGIA_VARIAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TIPOLOGIA_VARIAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;17&amp;quot;&quot;/>&lt;/tns:TIPOLOGIA_VARIAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCAR']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCAR']/valoreAttributo&quot;>&lt;tns:IDENTIFICATIVOCAR>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCAR']/valoreAttributo&quot;/>&lt;/tns:IDENTIFICATIVOCAR>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDENTIFICATIVOVLANOLO']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDENTIFICATIVOVLANOLO']/valoreAttributo&quot;>&lt;tns:IDENTIFICATIVOVLANOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='IDENTIFICATIVOVLANOLO']/valoreAttributo&quot;/>&lt;/tns:IDENTIFICATIVOVLANOLO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CODICETDKIT']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CODICETDKIT']/valoreAttributo&quot;>&lt;tns:CODICETDKIT>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='CODICETDKIT']/valoreAttributo&quot;/>&lt;/tns:CODICETDKIT>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='PROFILOBMC']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='PROFILOBMC']/valoreAttributo&quot;>&lt;tns:PROFILO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='PROFILOBMC']/valoreAttributo&quot;/>&lt;/tns:PROFILO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VARIAZIONECONCORDATA']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VARIAZIONECONCORDATA']/valoreAttributo&quot;>&lt;tns:VARIAZIONECONCORDATA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='VARIAZIONECONCORDATA']/valoreAttributo&quot;/>&lt;/tns:VARIAZIONECONCORDATA>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='SUPERMACROAREA']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='SUPERMACROAREA']/valoreAttributo&quot;>&lt;tns:SUPERMACROAREA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'RACCOLTA')]/attributidettaglioasset[nomeAttributo='SUPERMACROAREA']/valoreAttributo&quot;/>&lt;/tns:SUPERMACROAREA>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo)>0 and $Start/tns1:RICHIESTA/tipologiaSottolav='VARIAZIONEBANDA' and count($Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS'])=1&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo, '.')&quot;>&lt;tns:BANDA>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo,'.'),',',substring-after($Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo, '.'))&quot;/>&lt;/tns:BANDA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo&quot;>&lt;tns:BANDA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo&quot;/>&lt;/tns:BANDA>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot; string-length($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='3']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo)>0  and $Start/tns1:RICHIESTA/tipologiaSottolav='VARIAZIONEBANDA' and count($Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS'])=2 &quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='3']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo, '.')&quot;>&lt;tns:BANDACOS3>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='3']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo,'.'),',',substring-after($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='3']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo, '.'))&quot;/>&lt;/tns:BANDACOS3>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='3']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo&quot;>&lt;tns:BANDACOS3>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='3']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo&quot;/>&lt;/tns:BANDACOS3>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot; string-length($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='5']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo)>0  and $Start/tns1:RICHIESTA/tipologiaSottolav='VARIAZIONEBANDA' and count($Start/tns1:ASSET/dettaglioasset[nomeComponente='TIPOCOS'])=2 &quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='5']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo, '.')&quot;>&lt;tns:BANDACOS5>&lt;xsl:value-of select=&quot;concat(substring-before($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='5']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo,'.'),',',substring-after($Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='5']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo, '.'))&quot;/>&lt;/tns:BANDACOS5>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='5']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo&quot;>&lt;tns:BANDACOS5>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente = &amp;quot;TIPOCOS&amp;quot; and attributidettaglioasset[nomeAttributo='IDENTIFICATIVOCOS']/valoreAttributo='5']/attributidettaglioasset[nomeAttributo='BANDA']/valoreAttributo&quot;/>&lt;/tns:BANDACOS5>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns1:RICHIESTA/ordine/dettaglioordine[nomeComponente='OLOVLAN' and (string-length(attributiDettaglioOrdine[nomeAttributo='AZIONE']/valoreAttributo)>0 or string-length(attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo)>0)]&quot;>&lt;tns:SUBCONTRACTOR>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='AZIONE']/valoreAttributo)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(attributiDettaglioOrdine[nomeAttributo='AZIONE']/valoreAttributo)='D'&quot;>&lt;tns:AZIONESUBCONTRACTOR>&lt;xsl:value-of select=&quot;&amp;quot;C&amp;quot;&quot;/>&lt;/tns:AZIONESUBCONTRACTOR>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:AZIONESUBCONTRACTOR>&lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&lt;/tns:AZIONESUBCONTRACTOR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo&quot;>&lt;tns:CODOLOSUB>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODIFICAOLOAGCOM']/valoreAttributo&quot;/>&lt;/tns:CODOLOSUB>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:SUBCONTRACTOR>&lt;/xsl:for-each>&lt;/tns:VARIAZIONE>&lt;/tns:VLANGBE>&lt;/tns:SERVIZIO>&lt;/tns:REQUEST>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
