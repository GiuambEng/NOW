            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="ad9fe42e-bcad-4d81-a1ed-615bdd1e1cad" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperInsert&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:RESPONSE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperInsert)&quot;>&lt;xsl:for-each select=&quot;$MapperInsert/tns:RESPONSE&quot;>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;tns:RESPONSE_DATE&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;tns:RETURN_CODE&quot;/>&lt;/tns:RETURN_CODE>&lt;xsl:if test=&quot;tns:DESCRIZIONE_ERRORE&quot;>&lt;tns:DESCRIZIONE_ERRORE>&lt;xsl:value-of select=&quot;tns:DESCRIZIONE_ERRORE&quot;/>&lt;/tns:DESCRIZIONE_ERRORE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:COD_SRVZ&quot;>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;tns:COD_SRVZ&quot;/>&lt;/tns:COD_SRVZ>&lt;/xsl:if>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;tns:CREATED&quot;/>&lt;/tns:CREATED>&lt;xsl:if test=&quot;tns:ID_ASSET_CRMWS&quot;>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;tns:ID_ASSET_CRMWS&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;/xsl:if>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;tns:ID_ASSET_NOW&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;xsl:if test=&quot;tns:ID_ORDN&quot;>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;tns:ID_ORDN&quot;/>&lt;/tns:ID_ORDN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:LAVRZ&quot;>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;tns:LAVRZ&quot;/>&lt;/tns:LAVRZ>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:MESSAGGIO&quot;>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;tns:MESSAGGIO&quot;/>&lt;/tns:MESSAGGIO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;tns:STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TRANSACTION_ID_ROOT&quot;>&lt;tns:TRANSACTION_ID_ROOT>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_ROOT&quot;/>&lt;/tns:TRANSACTION_ID_ROOT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TRANSACTION_ID_PARENT&quot;>&lt;tns:TRANSACTION_ID_PARENT>&lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_PARENT&quot;/>&lt;/tns:TRANSACTION_ID_PARENT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CODICE_OLO&quot;>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;tns:CODICE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;/xsl:if>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;tns:ROW_ID&quot;/>&lt;/tns:ROW_ID>&lt;xsl:if test=&quot;tns:CREATED_BY&quot;>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;tns:CREATED_BY&quot;/>&lt;/tns:CREATED_BY>&lt;/xsl:if>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;tns:LAST_UPD&quot;/>&lt;/tns:LAST_UPD>&lt;xsl:if test=&quot;tns:LAST_UPD_BY&quot;>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;tns:LAST_UPD_BY&quot;/>&lt;/tns:LAST_UPD_BY>&lt;/xsl:if>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;tns:MODIFICATION_NUM&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;tns:CONFLICT_ID&quot;/>&lt;/tns:CONFLICT_ID>&lt;xsl:if test=&quot;tns:DB_LAST_UPD&quot;>&lt;tns:DB_LAST_UPD>&lt;xsl:value-of select=&quot;tns:DB_LAST_UPD&quot;/>&lt;/tns:DB_LAST_UPD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DB_LAST_UPD_SRC&quot;>&lt;tns:DB_LAST_UPD_SRC>&lt;xsl:value-of select=&quot;tns:DB_LAST_UPD_SRC&quot;/>&lt;/tns:DB_LAST_UPD_SRC>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DN&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;tns:DN&quot;/>&lt;/tns:DN>&lt;/xsl:if>&lt;/tns:RESPONSE>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:RESPONSE>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:RESPONSE_DATE>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:RESPONSE_DATE>&lt;tns:RETURN_CODE>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:RETURN_CODE>&lt;tns:COD_SRVZ>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:COD_SRVZ>&lt;tns:CREATED>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CREATED>&lt;tns:ID_ASSET_CRMWS>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ASSET_CRMWS>&lt;tns:ID_ASSET_NOW>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ASSET_NOW>&lt;tns:ID_ORDN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_ORDN>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:LAVRZ>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:LAVRZ>&lt;tns:MESSAGGIO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:MESSAGGIO>&lt;tns:STATO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:STATO>&lt;tns:ROW_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:ROW_ID>&lt;tns:CREATED_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CREATED_BY>&lt;tns:LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:LAST_UPD>&lt;tns:LAST_UPD_BY>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:LAST_UPD_BY>&lt;tns:MODIFICATION_NUM>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:MODIFICATION_NUM>&lt;tns:CONFLICT_ID>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CONFLICT_ID>&lt;tns:DB_LAST_UPD>&lt;xsl:value-of select=&quot;current-date()&quot;/>&lt;/tns:DB_LAST_UPD>&lt;/tns:RESPONSE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:RESPONSE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
