                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AttivazioneULLLA-input"
                    name="AttivazioneULLLA"
                    outputVariable="AttivazioneULLLA"
                    tibex:xpdlId="ff5ce6d4-9195-4085-8277-7fd44edcdd91" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper_Attivazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeULLLA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AttivazioneULLLA-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns1:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:DESCOLO>&lt;tns:ULLLA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta='ULLLINEAATTIVA'&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;22&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta='ULLDATILINEAATTIVA'&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;23&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:ASSET/offerta='ULLLINEAATTIVANP'&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;24&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;25&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ATTIVAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineOLO)>11&quot;>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns1:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineTI)>0&quot;>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns1:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/numeroTelefonico)>0&quot;>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/numeroTelefonico&quot;/>&lt;/tns:DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DN>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;tns:IDULLCO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO