;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_RISORSA&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_RISORSA&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:LAVRZ&quot;>&#xa;                            &lt;tns1:LAVRZ>&#xa;                                &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:LAVRZ&quot;/>&#xa;                            &lt;/tns1:LAVRZ>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:MESSAGGIO&quot;>&#xa;                            &lt;tns1:MESSAGGIO>&#xa;                                &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:MESSAGGIO&quot;/>&#xa;                            &lt;/tns1:MESSAGGIO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:STATO&quot;>&#xa;                            &lt;tns1:STATO>&#xa;                                &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:STATO&quot;/>&#xa;                            &lt;/tns1:STATO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID_ROOT&quot;>&#xa;                            &lt;tns1:TRANSACTION_ID_ROOT>&#xa;                                &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID_ROOT&quot;/>&#xa;                            &lt;/tns1:TRANSAC