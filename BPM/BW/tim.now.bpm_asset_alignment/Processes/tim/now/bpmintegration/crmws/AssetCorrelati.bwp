                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AssetCorrelatiIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;CODE_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Request>&#xa;            &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/codificaOLOAGCOM&quot;>&#xa;                &lt;tns1:CodificaOLOAgicom>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                &lt;/tns1:CodificaOLOAgicom>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                &lt;tns1:IDRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.bpmintegration.crmws.CODE_OLOMigrazione" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9c10b2b5-9963-445b-9c7a-4744c0169bbb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;AssetCorrelatiIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;ID_ASSET_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/IDAsset)&quot;>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/IDAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ASSET_NOW>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/codiceOrdineOLO)>11&quot;>&lt;ID_ORDINE>&lt;xsl:value-of select=&quot;substring($AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/codiceOrdineOLO,1,11)&quot;/>&lt;/ID_ORDINE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/codiceOrdineOLO)&quot;>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[number($index)]/codiceOrdineOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ORDINE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;LAVORAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AssetCorrelatiIn/Input/tns1:Input/tns1:Lavorazione)&quot;>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/LAVORAZIONE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Transaction-input"
                                    name="Transaction"
                                    outputVariable="Transaction"
                                    tibex:xpdlId="9c10b2b5-9963-445b-9c7a-4744c0169bbb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
