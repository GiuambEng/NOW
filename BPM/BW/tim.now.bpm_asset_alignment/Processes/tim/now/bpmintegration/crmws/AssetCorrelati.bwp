                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertOGG&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AssetCorrelatiIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertOGG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Record>&#xa;            &lt;xsl:for-each select=&quot;$Accumulate1/tns:RESPONSE/tns:RESPONSE&quot;>&#xa;                &lt;tns2:Record>&#xa;                    &lt;xsl:if test=&quot;tns:COD_SRVZ&quot;>&#xa;                        &lt;tns2:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;tns:COD_SRVZ&quot;/>&#xa;                        &lt;/tns2:COD_SRVZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:CREATED>&#xa;                        &lt;xsl:value-of select=&quot;tns:CREATED&quot;/>&#xa;                    &lt;/tns2:CREATED>&#xa;                    &lt;xsl:if test=&quot;tns:ID_ASSET_CRMWS&quot;>&#xa;                        &lt;tns2:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;tns:ID_ASSET_CRMWS&quot;/>&#xa;                        &lt;/tns2:ID_ASSET_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:ID_ASSET_NOW>&#xa;                        &lt;xsl:value-of select=&quot;tns:ID_ASSET_NOW&quot;/>&#xa;                    &lt;/tns2:ID_ASSET_NOW>&#xa;                    &lt;xsl:if test=&quot;tns:ID_ORDN&quot;>&#xa;                        &lt;tns2:ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;tns:ID_ORDN&quot;/>&#xa;                        &lt;/tns2:ID_ORDN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:ID_RISORSA&quot;>&#xa;                        &lt;tns2:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;tns:ID_RISORSA&quot;/>&#xa;                        &lt;/tns2:ID_RISORSA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:LAVRZ&quot;>&#xa;                        &lt;tns2:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;tns:LAVRZ&quot;/>&#xa;                        &lt;/tns2:LAVRZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:MESSAGGIO&quot;>&#xa;                        &lt;tns2:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tns:MESSAGGIO&quot;/>&#xa;                        &lt;/tns2:MESSAGGIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:STATO&quot;>&#xa;                        &lt;tns2:STATO>&#xa;                            &lt;xsl:value-of select=&quot;tns:STATO&quot;/>&#xa;                        &lt;/tns2:STATO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns2:TRANSACTION_ID>&#xa;                    &lt;xsl:if test=&quot;tns:TRANSACTION_ID_PARENT&quot;>&#xa;                        &lt;tns2:TRANSACTION_ID_PARENT>&#xa;                            &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_PARENT&quot;/>&#xa;                        &lt;/tns2:TRANSACTION_ID_PARENT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:TRANSACTION_ID_ROOT&quot;>&#xa;                        &lt;tns2:TRANSACTION_ID_ROOT>&#xa;                            &lt;xsl:value-of select=&quot;tns:TRANSACTION_ID_ROOT&quot;/>&#xa;                        &lt;/tns2:TRANSACTION_ID_ROOT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:CODICE_OLO&quot;>&#xa;                        &lt;tns2:CODICE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;tns:CODICE_OLO&quot;/>&#xa;                        &lt;/tns2:CODICE_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:ROW_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:ROW_ID&quot;/>&#xa;                    &lt;/tns2:ROW_ID>&#xa;                    &lt;xsl:if test=&quot;tns:CREATED_BY&quot;>&#xa;                        &lt;tns2:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns:CREATED_BY&quot;/>&#xa;                        &lt;/tns2:CREATED_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:LAST_UPD>&#xa;                        &lt;xsl:value-of select=&quot;tns:LAST_UPD&quot;/>&#xa;                    &lt;/tns2:LAST_UPD>&#xa;                    &lt;xsl:if test=&quot;tns:LAST_UPD_BY&quot;>&#xa;                        &lt;tns2:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns:LAST_UPD_BY&quot;/>&#xa;                        &lt;/tns2:LAST_UPD_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:MODIFICATION_NUM>&#xa;                        &lt;xsl:value-of select=&quot;tns:MODIFICATION_NUM&quot;/>&#xa;                    &lt;/tns2:MODIFICATION_NUM>&#xa;                    &lt;tns2:CONFLICT_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns:CONFLICT_ID&quot;/>&#xa;                    &lt;/tns2:CONFLICT_ID>&#xa;                    &lt;xsl:if test=&quot;tns:DB_LAST_UPD&quot;>&#xa;                        &lt;tns2:DB_LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;tns:DB_LAST_UPD&quot;/>&#xa;                        &lt;/tns2:DB_LAST_UPD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DB_LAST_UPD_SRC&quot;>&#xa;                        &lt;tns2:DB_LAST_UPD_SRC>&#xa;                            &lt;xsl:value-of select=&quot;tns:DB_LAST_UPD_SRC&quot;/>&#xa;                        &lt;/tns2:DB_LAST_UPD_SRC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:DN&quot;>&#xa;                        &lt;tns2:DN>&#xa;                            &lt;xsl:value-of select=&quot;tns:DN&quot;/>&#xa;                        &lt;/tns2:DN>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Record>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[1]/IDRichiestaOLO&quot;>&#xa;                &lt;tns2:Id_rich_olo>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[1]/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:Id_rich_olo>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:Record>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty1ToInsertOGG"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertOGGToCallProcess"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;AssetCorrelatiIn&quot;/>&lt;xsl:param name=&quot;InsertOGG&quot;/>&lt;xsl:template name=&quot;LogInsertOGG-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelati&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelatiPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelati&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[1]/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[1]/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('InsertOGG', tib:render-xml($InsertOGG/Output/tns3:Output, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelati&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[1]/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[1]/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;'AssetCorrelati_SUB-PROCESS'&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat('AssetCorrelati_', $AssetCorrelatiIn/Input/tns1:Input/tns1:Asset[1]/IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInsertOGG-input"
                    name="LogInsertOGG"
                    tibex:xpdlId="94420ea5-0488-4bd4-9946-fcc793ac4a68"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertOGGToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToLogAssetCorrelatiOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AssetCorrelatiIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertOGG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInsertOGG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelati&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelatiPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelati&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns1:Asset[1]/IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns1:Asset[1]/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('InsertOGG', tib:render-xml($InsertOGG.Output, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws'&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelati&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns1:Asset[1]/IDRichiestaOLO&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns1:Asset[1]/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'AssetCorrelati_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('AssetCorrelati_', $AssetCorrelatiIn.Input/tns1:Asset[1]/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty1" tibex:xpdlId="c49743eb-01a1-4d21-b5a9-8bf113d0a3b1">
                <bpws:targets>
                    <bpws:target linkName="WhileToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToInsertOGG">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Accumulate1/ns6:RESPONSE/ns6:RESPONSE)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($Accumulate1/ns6:RESPONSE/ns6:RESPONSE)>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ControlTransaction" name="Assign"
                    outputVariable="ControlTransaction"
                    tibex:xpdlId="b3a53f2b-10d2-47e6-a886-cccc74b895fc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogAssetCorrelatiOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="'True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ControlTransaction" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
