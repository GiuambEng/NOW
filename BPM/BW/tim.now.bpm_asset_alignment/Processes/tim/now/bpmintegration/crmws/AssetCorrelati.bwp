            <element name="jdbcQueryActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_ASSET_NOW" nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_RISORSA" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="ID_ORDINE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="LAVORAZIONE" nillable="true" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="maxRows" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+9c10b2b5-9963-445b-9c7a-4744c0169bbb+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+9c10b2b5-9963-445b-9c7a-4744c0169bbb+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="TRANSACTION_ID"
                                    nillable="false" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
