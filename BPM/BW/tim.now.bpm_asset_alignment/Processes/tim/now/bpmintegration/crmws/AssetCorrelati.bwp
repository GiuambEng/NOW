            </plnk:partnerLinkType>
            <plnk:partnerLinkType name="partnerLinkType4">
                <plnk:role name="use" portType="ptyp5:InsertOGGPortType"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/NOWAssetCorrelati/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/AssetToponomastica/"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/NomeServizio"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/SequenceOGG"/>
            <wsdl:import namespace="http://www.tim.com/NOW/wsdl/abstract/InsertOGG"/>
        </wsdl:definitions>
