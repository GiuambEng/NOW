                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NOWAssetCorrelati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Accumulate1&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlTransaction&quot;/>&#xa;    &lt;xsl:template name=&quot;AssetCorrelatiOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Output>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ControlTransaction='True'&quot;>&#xa;                    &lt;tns2:Request>&#xa;                        &lt;tns1:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;tns1:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:RESPONSE_DATE>&#xa;                        &lt;tns1:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:RETURN_CODE>&#xa;                        &lt;tns1:DESCRIZIONE_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE_ERRORE>&#xa;                        &lt;tns1:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:COD_SRVZ>&#xa;                        &lt;tns1:CREATED>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:CREATED>&#xa;                        &lt;tns1:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_CRMWS>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                        &lt;tns1:ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_ORDN>&#xa;                        &lt;tns1:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_RISORSA>&#xa;                        &lt;tns1:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:LAVRZ>&#xa;                        &lt;tns1:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:MESSAGGIO>&#xa;                        &lt;tns1:STATO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:STATO>&#xa;                        &lt;tns1:TRANSACTION_ID_ROOT>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID_ROOT>&#xa;                        &lt;tns1:TRANSACTION_ID_PARENT>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID_PARENT>&#xa;                        &lt;tns1:CODICE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:CODICE_OLO>&#xa;                        &lt;tns1:ROW_ID>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ROW_ID>&#xa;                        &lt;tns1:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:CREATED_BY>&#xa;                        &lt;tns1:LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns1:LAST_UPD>&#xa;                        &lt;tns1:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:LAST_UPD_BY>&#xa;                        &lt;tns1:MODIFICATION_NUM>&#xa;                            &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                        &lt;/tns1:MODIFICATION_NUM>&#xa;                        &lt;tns1:CONFLICT_ID>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:CONFLICT_ID>&#xa;                        &lt;tns1:DB_LAST_UPD_SRC>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:DB_LAST_UPD_SRC>&#xa;                        &lt;tns1:DN>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:DN>&#xa;                    &lt;/tns2:Request>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Request>&#xa;                        &lt;tns1:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;tns1:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:RESPONSE_DATE&quot;/>&#xa;                        &lt;/tns1:RESPONSE_DATE>&#xa;                        &lt;tns1:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:RETURN_CODE&quot;/>&#xa;                        &lt;/tns1:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$Accumulate1/tns1:RES