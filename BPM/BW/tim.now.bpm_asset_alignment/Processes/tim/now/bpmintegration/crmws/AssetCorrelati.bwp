            &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$DynamicProcess/tns:RESPONSE[1]/tns:STATO&quot;>&#xa;                            &lt;tns:STATO>&#xa;                                &lt;xsl:value-of select=&quot;$DynamicProcess/tns:RESPONSE[1]/tns:STATO&quot;/>&#xa;                            &lt;/tns:STATO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT&quot;>&#xa;                                    &lt;tns:TRANSACTION_ID_ROOT>&#xa;                                        &lt;xsl:value-of select=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT&quot;/>&#xa;                                    &lt;/tns:TRANSACTION_ID_ROOT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:TRANSACTION_ID_ROOT>&#xa;                                    &lt;xsl:value-of select=&quot;$DynamicProcess/tns:RESPONSE[1]/tns:TRANSACTION_ID&quot;/>&#xa;                                &lt;/tns:TRANSACTION_ID_ROOT>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT&quot;>&#xa;                                    &lt;tns:TRANSACTION_ID_PARENT>&#xa;                                        &lt;xsl:value-of select=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT&quot;/>&#x