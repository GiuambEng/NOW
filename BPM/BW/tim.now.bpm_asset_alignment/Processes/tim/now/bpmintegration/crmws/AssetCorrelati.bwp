                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/CODE_OLOMigrazione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AssetToponomastica.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;AssetCorrelatiIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceOGG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CODE_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;DynamicProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:REQUEST>&#xa;            &lt;tns1:ASSET>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDAsset&quot;>&#xa;                    &lt;IDAsset>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDAsset&quot;/>&#xa;                    &lt;/IDAsset>&#xa;                &lt;/xsl:if>&#xa;                &lt;codiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceOrdineOLO&quot;/>&#xa;                &lt;/codiceOrdineOLO>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceOrdineTI&quot;>&#xa;                    &lt;codiceOrdineTI>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceOrdineTI&quot;/>&#xa;                    &lt;/codiceOrdineTI>&#xa;                &lt;/xsl:if>&#xa;                &lt;codificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codificaOLOAGCOM&quot;/>&#xa;                &lt;/codificaOLOAGCOM>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/invariante&quot;>&#xa;                    &lt;invariante>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/invariante&quot;/>&#xa;                    &lt;/invariante>&#xa;                &lt;/xsl:if>&#xa;                &lt;created>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/created&quot;/>&#xa;                &lt;/created>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/lastUpdate&quot;>&#xa;                    &lt;lastUpdate>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/lastUpdate&quot;/>&#xa;                    &lt;/lastUpdate>&#xa;                &lt;/xsl:if>&#xa;                &lt;operatore>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/operatore&quot;/>&#xa;                &lt;/operatore>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                    &lt;IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                    &lt;/IDRichiestaOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDPrimoOrdine&quot;>&#xa;                    &lt;IDPrimoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDPrimoOrdine&quot;/>&#xa;                    &lt;/IDPrimoOrdine>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDContratto>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDContratto&quot;/>&#xa;                &lt;/IDContratto>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/DEC&quot;>&#xa;                    &lt;DEC>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/DEC&quot;/>&#xa;                    &lt;/DEC>&#xa;                &lt;/xsl:if>&#xa;                &lt;statoAsset>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/statoAsset&quot;/>&#xa;                &lt;/statoAsset>&#xa;                &lt;IDRisorsa>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDRisorsa&quot;/>&#xa;                &lt;/IDRisorsa>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/numeroTelefonico&quot;>&#xa;                    &lt;numeroTelefonico>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/numeroTelefonico&quot;/>&#xa;                    &lt;/numeroTelefonico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDAssetCRMWS&quot;>&#xa;                    &lt;IDAssetCRMWS>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDAssetCRMWS&quot;/>&#xa;                    &lt;/IDAssetCRMWS>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDAssetDa&quot;>&#xa;                    &lt;IDAssetDa>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDAssetDa&quot;/>&#xa;                    &lt;/IDAssetDa>&#xa;                &lt;/xsl:if>&#xa;                &lt;DES>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/DES&quot;/>&#xa;                &lt;/DES>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/ORA_DES&quot;>&#xa;                    &lt;ORA_DES>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/ORA_DES&quot;/>&#xa;                    &lt;/ORA_DES>&#xa;                &lt;/xsl:if>&#xa;                &lt;tipologiaAccesso>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/tipologiaAccesso&quot;/>&#xa;                &lt;/tipologiaAccesso>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/RO&quot;>&#xa;                    &lt;RO>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/RO&quot;/>&#xa;                    &lt;/RO>&#xa;                &lt;/xsl:if>&#xa;                &lt;offerta>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/offerta&quot;/>&#xa;                &lt;/offerta>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/lineaRiferimento&quot;>&#xa;                    &lt;lineaRiferimento>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/lineaRiferimento&quot;/>&#xa;                    &lt;/lineaRiferimento>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/complesso&quot;>&#xa;                    &lt;complesso>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/complesso&quot;/>&#xa;                    &lt;/complesso>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/interno&quot;>&#xa;                    &lt;interno>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/interno&quot;/>&#xa;                    &lt;/interno>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/piano&quot;>&#xa;                    &lt;piano>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/piano&quot;/>&#xa;                    &lt;/piano>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/scala&quot;>&#xa;                    &lt;scala>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/scala&quot;/>&#xa;                    &lt;/scala>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:for-each select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/dettaglioasset&quot;>&#xa;                    &lt;dettaglioasset>&#xa;                        &lt;IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                        &lt;/IDAsset>&#xa;                        &lt;xsl:if test=&quot;IDDettaglioAssetParent&quot;>&#xa;                            &lt;IDDettaglioAssetParent>&#xa;                                &lt;xsl:value-of select=&quot;IDDettaglioAssetParent&quot;/>&#xa;                            &lt;/IDDettaglioAssetParent>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;IDDettaglioAssetRoot&quot;>&#xa;                            &lt;IDDettaglioAssetRoot>&#xa;                                &lt;xsl:value-of select=&quot;IDDettaglioAssetRoot&quot;/>&#xa;                            &lt;/IDDettaglioAssetRoot>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;integrationID>&#xa;                            &lt;xsl:value-of select=&quot;integrationID&quot;/>&#xa;                        &lt;/integrationID>&#xa;                        &lt;created>&#xa;                            &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                        &lt;/created>&#xa;                        &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                            &lt;lastUpdate>&#xa;                                &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                            &lt;/lastUpdate>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;operatore>&#xa;                            &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                        &lt;/operatore>&#xa;                        &lt;IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;IDRisorsa&quot;/>&#xa;                        &lt;/IDRisorsa>&#xa;                        &lt;nomeComponente>&#xa;                            &lt;xsl:value-of select=&quot;nomeComponente&quot;/>&#xa;                        &lt;/nomeComponente>&#xa;                        &lt;xsl:for-each select=&quot;attributidettaglioasset&quot;>&#xa;                            &lt;attributidettaglioasset>&#xa;                                &lt;IDAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDAsset&quot;/>&#xa;                                &lt;/IDAsset>&#xa;                                &lt;created>&#xa;                                    &lt;xsl:value-of select=&quot;created&quot;/>&#xa;                                &lt;/created>&#xa;                                &lt;xsl:if test=&quot;lastUpdate&quot;>&#xa;                                    &lt;lastUpdate>&#xa;                                        &lt;xsl:value-of select=&quot;lastUpdate&quot;/>&#xa;                                    &lt;/lastUpdate>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;operatore>&#xa;                                    &lt;xsl:value-of select=&quot;operatore&quot;/>&#xa;                                &lt;/operatore>&#xa;                                &lt;nomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;nomeAttributo&quot;/>&#xa;                                &lt;/nomeAttributo>&#xa;                                &lt;valoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;valoreAttributo&quot;/>&#xa;                                &lt;/valoreAttributo>&#xa;                                &lt;tipologiaDato>&#xa;                                    &lt;xsl:value-of select=&quot;tipologiaDato&quot;/>&#xa;                                &lt;/tipologiaDato>&#xa;                                &lt;IDDettaglioAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                                &lt;/IDDettaglioAsset>&#xa;                            &lt;/attributidettaglioasset>&#xa;                        &lt;/xsl:for-each>&#xa;                        &lt;IDRisorsaNOW>&#xa;                            &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                        &lt;/IDRisorsaNOW>&#xa;                        &lt;IDDettaglioAsset>&#xa;                            &lt;xsl:value-of select=&quot;IDDettaglioAsset&quot;/>&#xa;                        &lt;/IDDettaglioAsset>&#xa;                        &lt;statoDettaglioAsset>&#xa;                            &lt;xsl:value-of select=&quot;statoDettaglioAsset&quot;/>&#xa;                        &lt;/statoDettaglioAsset>&#xa;                        &lt;progressivo>&#xa;                            &lt;xsl:value-of select=&quot;progressivo&quot;/>&#xa;                        &lt;/progressivo>&#xa;                    &lt;/dettaglioasset>&#xa;                &lt;/xsl:for-each>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/DESPrimoOrdine&quot;>&#xa;                    &lt;DESPrimoOrdine>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/DESPrimoOrdine&quot;/>&#xa;                    &lt;/DESPrimoOrdine>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/CAP&quot;>&#xa;                    &lt;CAP>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/CAP&quot;/>&#xa;                    &lt;/CAP>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceISTATComune&quot;>&#xa;                    &lt;codiceISTATComune>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceISTATComune&quot;/>&#xa;                    &lt;/codiceISTATComune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceISTATProvincia&quot;>&#xa;                    &lt;codiceISTATProvincia>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceISTATProvincia&quot;/>&#xa;                    &lt;/codiceISTATProvincia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceToponomastica&quot;>&#xa;                    &lt;codiceToponomastica>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceToponomastica&quot;/>&#xa;                    &lt;/codiceToponomastica>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/comune&quot;>&#xa;                    &lt;comune>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/comune&quot;/>&#xa;                    &lt;/comune>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/descrPartToponomastica&quot;>&#xa;                    &lt;descrPartToponomastica>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/descrPartToponomastica&quot;/>&#xa;                    &lt;/descrPartToponomastica>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/descrizioneVia&quot;>&#xa;                    &lt;descrizioneVia>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/descrizioneVia&quot;/>&#xa;                    &lt;/descrizioneVia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/localita&quot;>&#xa;                    &lt;localita>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/localita&quot;/>&#xa;                    &lt;/localita>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/numeroCivico&quot;>&#xa;                    &lt;numeroCivico>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/numeroCivico&quot;/>&#xa;                    &lt;/numeroCivico>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/provincia&quot;>&#xa;                    &lt;provincia>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/provincia&quot;/>&#xa;                    &lt;/provincia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/siglaProvincia&quot;>&#xa;                    &lt;siglaProvincia>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/siglaProvincia&quot;/>&#xa;                    &lt;/siglaProvincia>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/distretto&quot;>&#xa;                    &lt;distretto>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/distretto&quot;/>&#xa;                    &lt;/distretto>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/CLLI&quot;>&#xa;                    &lt;CLLI>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/CLLI&quot;/>&#xa;                    &lt;/CLLI>&#xa;                &lt;/xsl:if>&#xa;                &lt;CRMOrigine>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/CRMOrigine&quot;/>&#xa;                &lt;/CRMOrigine>&#xa;                &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceSLAAssurance&quot;>&#xa;                    &lt;codiceSLAAssurance>&#xa;                        &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/codiceSLAAssurance&quot;/>&#xa;                    &lt;/codiceSLAAssurance>&#xa;                &lt;/xsl:if>&#xa;                &lt;IDRisorsaNOW>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[number($index)]/IDRisorsaNOW&quot;/>&#xa;                &lt;/IDRisorsaNOW>&#xa;                &lt;IDOfferta>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns3:Asset[