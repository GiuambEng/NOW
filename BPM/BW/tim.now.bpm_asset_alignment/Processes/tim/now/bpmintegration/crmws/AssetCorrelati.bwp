&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NOWAssetCorrelati/" xmlns:tns1="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns2="http://www.tim.com/NOW/xsd/AssetCorrelati/" version="2.0"&gt;&lt;xsl:param name="Accumulate1"/&gt;&lt;xsl:param name="ControlTransaction"/&gt;&lt;xsl:template name="AssetCorrelatiOut-input" match="/"&gt;&lt;tns:AssetCorrelatiResponse&gt;&lt;Output&gt;&lt;tns2:Output&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$ControlTransaction='True'"&gt;&lt;tns2:Request&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;tns1:RESPONSE_DATE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns1:RESPONSE_DATE&gt;&lt;tns1:RETURN_CODE&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:RETURN_CODE&gt;&lt;tns1:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:DESCRIZIONE_ERRORE&gt;&lt;tns1:COD_SRVZ&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:COD_SRVZ&gt;&lt;tns1:CREATED&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:CREATED&gt;&lt;tns1:ID_ASSET_CRMWS&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:ID_ASSET_CRMWS&gt;&lt;tns1:ID_ASSET_NOW&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:ID_ASSET_NOW&gt;&lt;tns1:ID_ORDN&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:ID_ORDN&gt;&lt;tns1:ID_RISORSA&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:ID_RISORSA&gt;&lt;tns1:LAVRZ&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:LAVRZ&gt;&lt;tns1:MESSAGGIO&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:MESSAGGIO&gt;&lt;tns1:STATO&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:STATO&gt;&lt;tns1:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:TRANSACTION_ID_ROOT&gt;&lt;tns1:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:TRANSACTION_ID_PARENT&gt;&lt;tns1:CODICE_OLO&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:CODICE_OLO&gt;&lt;tns1:ROW_ID&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:ROW_ID&gt;&lt;tns1:CREATED_BY&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:CREATED_BY&gt;&lt;tns1:LAST_UPD&gt;&lt;xsl:value-of select="current-date()"/&gt;&lt;/tns1:LAST_UPD&gt;&lt;tns1:LAST_UPD_BY&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:LAST_UPD_BY&gt;&lt;tns1:MODIFICATION_NUM&gt;&lt;xsl:value-of select="1"/&gt;&lt;/tns1:MODIFICATION_NUM&gt;&lt;tns1:CONFLICT_ID&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:CONFLICT_ID&gt;&lt;tns1:DB_LAST_UPD_SRC&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:DB_LAST_UPD_SRC&gt;&lt;tns1:DN&gt;&lt;xsl:value-of select="''"/&gt;&lt;/tns1:DN&gt;&lt;/tns2:Request&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Request&gt;&lt;tns1:TRANSACTION_ID&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID"/&gt;&lt;/tns1:TRANSACTION_ID&gt;&lt;tns1:RESPONSE_DATE&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:RESPONSE_DATE"/&gt;&lt;/tns1:RESPONSE_DATE&gt;&lt;tns1:RETURN_CODE&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:RETURN_CODE"/&gt;&lt;/tns1:RETURN_CODE&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DESCRIZIONE_ERRORE"&gt;&lt;tns1:DESCRIZIONE_ERRORE&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DESCRIZIONE_ERRORE"/&gt;&lt;/tns1:DESCRIZIONE_ERRORE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:COD_SRVZ"&gt;&lt;tns1:COD_SRVZ&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:COD_SRVZ"/&gt;&lt;/tns1:COD_SRVZ&gt;&lt;/xsl:if&gt;&lt;tns1:CREATED&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:CREATED"/&gt;&lt;/tns1:CREATED&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_ASSET_CRMWS"&gt;&lt;tns1:ID_ASSET_CRMWS&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_ASSET_CRMWS"/&gt;&lt;/tns1:ID_ASSET_CRMWS&gt;&lt;/xsl:if&gt;&lt;tns1:ID_ASSET_NOW&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_ASSET_NOW"/&gt;&lt;/tns1:ID_ASSET_NOW&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_ORDN"&gt;&lt;tns1:ID_ORDN&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_ORDN"/&gt;&lt;/tns1:ID_ORDN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_RISORSA"&gt;&lt;tns1:ID_RISORSA&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ID_RISORSA"/&gt;&lt;/tns1:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:LAVRZ"&gt;&lt;tns1:LAVRZ&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:LAVRZ"/&gt;&lt;/tns1:LAVRZ&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:MESSAGGIO"&gt;&lt;tns1:MESSAGGIO&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:MESSAGGIO"/&gt;&lt;/tns1:MESSAGGIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:STATO"&gt;&lt;tns1:STATO&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:STATO"/&gt;&lt;/tns1:STATO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID_ROOT"&gt;&lt;tns1:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID_ROOT"/&gt;&lt;/tns1:TRANSACTION_ID_ROOT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID_PARENT"&gt;&lt;tns1:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:TRANSACTION_ID_PARENT"/&gt;&lt;/tns1:TRANSACTION_ID_PARENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:CODICE_OLO"&gt;&lt;tns1:CODICE_OLO&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:CODICE_OLO"/&gt;&lt;/tns1:CODICE_OLO&gt;&lt;/xsl:if&gt;&lt;tns1:ROW_ID&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:ROW_ID"/&gt;&lt;/tns1:ROW_ID&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:CREATED_BY"&gt;&lt;tns1:CREATED_BY&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:CREATED_BY"/&gt;&lt;/tns1:CREATED_BY&gt;&lt;/xsl:if&gt;&lt;tns1:LAST_UPD&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:LAST_UPD"/&gt;&lt;/tns1:LAST_UPD&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:LAST_UPD_BY"&gt;&lt;tns1:LAST_UPD_BY&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:LAST_UPD_BY"/&gt;&lt;/tns1:LAST_UPD_BY&gt;&lt;/xsl:if&gt;&lt;tns1:MODIFICATION_NUM&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:MODIFICATION_NUM"/&gt;&lt;/tns1:MODIFICATION_NUM&gt;&lt;tns1:CONFLICT_ID&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:CONFLICT_ID"/&gt;&lt;/tns1:CONFLICT_ID&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DB_LAST_UPD"&gt;&lt;tns1:DB_LAST_UPD&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DB_LAST_UPD"/&gt;&lt;/tns1:DB_LAST_UPD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DB_LAST_UPD_SRC"&gt;&lt;tns1:DB_LAST_UPD_SRC&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DB_LAST_UPD_SRC"/&gt;&lt;/tns1:DB_LAST_UPD_SRC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DN"&gt;&lt;tns1:DN&gt;&lt;xsl:value-of select="$Accumulate1/tns1:RESPONSE[1]/tns1:RESPONSE[1]/tns1:DN"/&gt;&lt;/tns1:DN&gt;&lt;/xsl:if&gt;&lt;/tns2:Request&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns2:Output&gt;&lt;/Output&gt;&lt;/tns:AssetCorrelatiResponse&gt;&lt;/xsl:temp