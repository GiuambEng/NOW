DACFile>&lt;/xsl:if>&lt;xsl:if test=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Richiesta/tipologiaSottolav&quot;>&lt;tipologiaSottolav>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Richiesta/tipologiaSottolav&quot;/>&lt;/tipologiaSottolav>&lt;/xsl:if>&lt;xsl:if test=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Richiesta/codiceRifiuto&quot;>&lt;codiceRifiuto>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Richiesta/codiceRifiuto&quot;/>&lt;/codiceRifiuto>&lt;/xsl:if>&lt;/tns1:RICHIESTA>&lt;/xsl:if>&lt;xsl:if test=&quot;$SequenceOGG/Output/tns2:Output/tns2:NextVal[1]&quot;>&lt;tns1:NextVal>&lt;xsl:value-of select=&quot;$SequenceOGG/Output/tns2:Output/tns2:NextVal[1]&quot;/>&lt;/tns1:NextVal>&lt;/xsl:if>&lt;xsl:if test=&quot;$AssetToponomastica/Output/tns:Response/tns:RecordIdContratto[1]/tns:ID_CONTRATTO_CRMWS&quot;>&lt;tns1:IdContratto>&lt;xsl:value-of select=&quot;$AssetToponomastica/Output/tns:Response/tns:RecordIdContratto[1]/tns:ID_CONTRATTO_CRMWS&quot;/>&lt;/tns1:IdContratto>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$AssetToponomastica/Output/tns:Response/tns:RecordAssetToponomastica&quot;>&lt;tns1:RecordAsset>&lt;tns1:NumeroCivico>&lt;xsl:value-of select=&quot;tns:NUMERO_CIVICO&quot;/>&lt;/tns1:NumeroCivico>&lt;tns1:CAP>&lt;xsl:value-of select=&quot;tns:CAP&quot;/>&lt;/tns1:CAP>&lt;xsl:if test=&quot;tns:DR&quot;>&lt;tns1:DR>&lt;xsl:value-of select=&quot;tns:DR&quot;/>&lt;/tns1:DR>&lt;/xsl:if>&lt;tns1:DescrParticellaTopon>&lt;xsl:value-of select=&quot;tns:DESCR_PARTICELLA_TOPON&quot;/>&lt;/tns1:DescrParticellaTopon>&lt;tns1:DescrVia>&lt;xsl:value-of select=&quot;tns:DESCR_VIA&quot;/>&lt;/tns1:DescrVia>&lt;tns1:CodISTATComune>&lt;xsl:value-of select=&quot;tns:COD_ISTAT_COMUNE&quot;/>&lt;/tns1:CodISTATComune>&lt;tns1:CodVia>&lt;xsl:value-of select=&quot;xsd:int(tns:COD_VIA)&quot;/>&lt;/tns1:CodVia>&lt;tns1:DescrComune>&lt;xsl:value-of select=&quot;tns:DESCR_COMUNE&quot;/>&lt;/tns1:DescrComune>&lt;tns1:SiglaProv>&lt;xsl:value-of select=&quot;tns:SIGLA_PROV&quot;/>&lt;/tns1:SiglaProv>&lt;tns1:CodISTATProv>&lt;xsl:value-of select=&quot;tns:COD_ISTAT_PROV&quot;/>&lt;/tns1:CodISTATProv>&lt;tns1:DescrProv>&lt;xsl:value-of select=&quot;tns:DESCR_PROV&quot;/>&lt;/tns1:DescrProv>&lt;tns1:Cod_Topon>&lt;xsl:value-of select=&quot;tns:COD_TOPON&quot;/>&lt;/tns1:Cod_Topon>&lt;xsl:if test=&quot;tns:COD_COMUNE&quot;>&lt;tns1:Cod_Comune>&lt;xsl:value-of select=&quot;tns:COD_COMUNE&quot;/>&lt;/tns1:Cod_Comune>&lt;/xsl:if>&lt;/tns1:RecordAsset>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($AssetCorrelatiIn/Input/tns3:Input/tns3:Cod_olo)>0&quot;>&lt;xsl:if test=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Cod_olo&quot;>&lt;tns1:CODE_OLO>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Cod_olo&quot;/>&lt;/tns1:CODE_OLO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$CODE_OLO/tns6:CODE_OLO&quot;>&lt;tns1:CODE_OLO>&lt;xsl:value-of select=&quot;$CODE_OLO/tns6:CODE_OLO&quot;/>&lt;/tns1:CODE_OLO>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Lavorazione&quot;>&lt;tns1:LavorazioneAsset>&lt;xsl:value-of select=&quot;$AssetCorrelatiIn/Input/tns3:Input/tns3:Lavorazione&quot;/>&lt;/tns1:LavorazioneAsset>&lt;/xsl:if>&lt;/tns1:REQUEST>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
