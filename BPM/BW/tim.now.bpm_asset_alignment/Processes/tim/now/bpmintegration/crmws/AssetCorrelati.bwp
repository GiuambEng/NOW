                                    name="CallProcessToDynamicName" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogNomeServizioToDynamicName" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="JDBCQueryToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="EmptyToAssetToponomastica" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="EmptyToCallProcess1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToTransaction" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="RecordTrovatiToAccumulate1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogAccumulateToAccumulate1" tibex:linkType="SUCCESS"/>
