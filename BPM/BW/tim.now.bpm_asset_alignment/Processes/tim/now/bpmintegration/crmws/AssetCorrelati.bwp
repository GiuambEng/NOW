                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/AssetToponomastica/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssetToponomastica/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AssetCorrelatiIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;AssetToponomastica-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Request>&#xa;            &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/codiceToponomastica&quot;>&#xa;                &lt;tns2:COD_TOPON>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/codiceToponomastica&quot;/>&#xa;                &lt;/tns2:COD_TOPON>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/IDContratto&quot;>&#xa;                &lt;tns2:idContratto>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/IDContratto&quot;/>&#xa;                &lt;/tns2:idContratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/IDRichiestaOLO&quot;>&#xa;                &lt;tns2:ID_Rich_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:ID_Rich_OLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/offerta&quot;>&#xa;                &lt;tns2:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;$AssetCorrelatiIn.Input/tns:Asset[number($index)]/offerta&quot;/>&#xa;                &lt;/