                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BundleNPIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;LogErrorDynamicProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BundleNP&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelatiPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AssetCorrelati&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$BundleNPIn.Input/tns1:NumeriAggiuntivi[1]/tns1:NumeriAggiuntivi/tns2:IDRichOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$BundleNPIn.Input/tns1:NumeriAggiuntivi[1]/tns1:NumeriAggiuntivi/tns2:IDRichOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Error nel processo dinamico',  $_error/StackTrace,$_error/Msg,$_error/FullClass,$_error/Class,$_error/MsgCode,$_error/ProcessStack)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="a609e8a7-6cfc-40a9-aaa8-ed51564cdff2">
                <bpws:targets>
                    <bpws:target linkName="While1ToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToAssetToponomastica">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Accumulate/ns13:resultSet[Record[string-length(TRANSACTION_ID)>0]])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($Accumulate/ns13:resultSet[Record[string-length(TRANSACTION_ID)>0]])>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Control"
                    name="Assign" outputVariable="Control"
                    tibex:xpdlId="ef029b5b-c9ca-4af5-96cd-bfe5ffb159ed" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogBundleNPOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="'True'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Control" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="a781fb80-1f15-43ef-a9fe-f0cc0eecbb02">
                <bpws:targets>
                    <bpws:target linkName="LogBundleNPInToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToEmpty"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+a87cbd56-30ca-4a7f-99ec-13d17db491b2" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($BundleNPIn/Input/tns1:Input/tns1:NumeriAggiuntivi)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($BundleNPIn.Input/tns1:NumeriAggiuntivi)]]></bpws:condition>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart1ToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="a0219ee2-2232-4ba5-9a60-a44513dc538f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery1"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="a87cbd56-30ca-4a7f-99ec-13d17db491b2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQuery1ToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>JDBCQuery1</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1dfaf37e-4344-4710-93e9-6aa5c2ad47ee+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+de47f039-aa25-482c-bcad-594b5531f22b+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;BundleNPIn&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns3:jdbcQueryActivityInput>&lt;ID_ASSET_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDAsset)&quot;>&lt;xsl:value-of select=&quot;$BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ASSET_NOW>&lt;xsl:choose>&lt;xsl:when test=&quot;$index=1&quot;>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDRisorsa)&quot;>&lt;xsl:value-of select=&quot;$BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:NumeroTelefonico)&quot;>&lt;xsl:value-of select=&quot;$BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:NumeroTelefonico&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RISORSA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_ORDINE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:CodiceOrdineOLO)&quot;>&lt;xsl:value-of select=&quot;$BundleNPIn/Input/tns2:Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:CodiceOrdineOLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ORDINE>&lt;LAVORAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($BundleNPIn/Input/tns2:Input/tns2:Lavorazione)&quot;>&lt;xsl:value-of select=&quot;$BundleNPIn/Input/tns2:Input/tns2:Lavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/LAVORAZIONE>&lt;/tns3:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQuery1-input"
                                    name="JDBCQuery1"
                                    outputVariable="JDBCQuery1"
                                    tibex:xpdlId="de47f039-aa25-482c-bcad-594b5531f22b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1dfaf37e-4344-4710-93e9-6aa5c2ad47ee+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/CRMWSNumberPortability/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/AssetCorrelati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+de47f039-aa25-482c-bcad-594b5531f22b+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;BundleNPIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;ID_ASSET_NOW>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ASSET_NOW>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$index=1&quot;>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDRisorsa)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:IDRisorsa&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_RISORSA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:NumeroTelefonico)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:NumeroTelefonico&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_RISORSA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ORDINE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:CodiceOrdineOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$BundleNPIn.Input/tns2:NumeriAggiuntivi[number($index)]/tns2:NumeriAggiuntivi/tns1:CodiceOrdineOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ORDINE>&#xa;            &lt;LAVORAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($BundleNPIn.Input/tns2:Lavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$BundleNPIn.Input/tns2:Lavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/LAVORAZIONE>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="Property"
                                    sqlStatement="SELECT TRANSACTION_ID FROM OGG_ALMTO_COSTZ_DA_NOW_REQUEST WHERE ID_ASSET_NOW=? &#xa;AND ID_RISORSA=? AND ID_ORDINE=? AND LAVORAZIONE=?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_ASSET_NOW"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ORDINE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="LAVORAZIONE"/>
                                    <columnMetadata
                                    columnName="TRANSACTION_ID"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
