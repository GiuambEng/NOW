t;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;provincia&quot;>&#xa;                        &lt;provincia>&#xa;                            &lt;xsl:value-of select=&quot;provincia&quot;/>&#xa;                        &lt;/provincia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;siglaProvincia&quot;>&#xa;                        &lt;siglaProvincia>&#xa;                            &lt;xsl:value-of select=&quot;siglaProvincia&quot;/>&#xa;                        &lt;/siglaProvincia>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;distretto&quot;>&#xa;                        &lt;distretto>&#xa;                            &lt;xsl:value-of select=&quot;distretto&quot;/>&#xa;                        &lt;/distretto>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;CLLI&quot;>&#xa;                        &lt;CLLI>&#xa;                            &lt;xsl:value-of select=&quot;CLLI&quot;/>&#xa;                        &lt;/CLLI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;CRMOrigine>&#xa;                        &lt;xsl:value-of select=&quot;CRMOrigine&quot;/>&#xa;                    &lt;/CRMOrigine>&#xa;                    &lt;xsl:if test=&quot;codiceSLAAssurance&quot;>&#xa;                        &lt;codiceSLAAssurance>&#xa;                            &lt;xsl:value-of select=&quot;codiceSLAAssurance&quot;/>&#xa;                        &lt;/codiceSLAAssurance>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;IDRisorsaNOW>&#xa;                        &lt;xsl:value-of select=&quot;IDRisorsaNOW&quot;/>&#xa;                    &lt;/IDRisorsaNOW>&#xa;                    &lt;IDOfferta>&#xa;                        &lt;xsl:value-of select=&quot;IDOfferta&quot;/>&#xa;                    &lt;/IDOfferta>&#xa;                    &lt;xsl:if test=&quot;indirizzoEstesoNonCert&quot;>&#xa;                        &lt;indirizzoEstesoNonCert>&#xa;     