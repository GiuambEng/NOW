            <xs:import namespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+de47f039-aa25-482c-bcad-594b5531f22b+output"/>
            <xs:element name="AccumulatedOutput" type="tns:AccumulatedOutputType"/>
            <xs:complexType name="AccumulatedOutputType">
                <xs:sequence maxOccurs="1" minOccurs="0">
                    <xs:element maxOccurs="unbounded" minOccurs="0" ref="Q1:resultSet"/>
                </xs:sequence>
            </xs:complexType>
        </xs:schema>
