                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeULLLNA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapperVariazioneULLLNA-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string($Start/tns3:NextVal),10,'0'))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns3:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:DESCOLO>&lt;tns:ULLLNA>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns3:ASSET/offerta)=&amp;quot;ULLLINEANONATTIVA&amp;quot;&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:VARIAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/codiceOrdineOLO)>11&quot;>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns3:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/codiceOrdineTI)>0&quot;>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:IdContratto)>0&quot;>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns3:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CONTRATTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;xsl:if test=&quot;exists($Start/tns3:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns3:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns3:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns3:RICHIESTA/ordine/tipologiaSottolav)='TRASLOCO'&quot;>&lt;tns:TIPOLOGIA_VARIAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/tns:TIPOLOGIA_VARIAZIONE>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns3:RICHIESTA/ordine/tipologiaSottolav)='CAMBIOCOPPIA'&quot;>&lt;tns:TIPOLOGIA_VARIAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&lt;/tns:TIPOLOGIA_VARIAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TIPOLOGIA_VARIAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:TIPOLOGIA_VARIAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns3:RICHIESTA/ordine/tipologiaSottolav)='TRASLOCO' or upper-case($Start/tns3:RICHIESTA/ordine/tipologiaSottolav)='CAMBIOCOPPIA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO') ]/attributidettaglioasset[nomeAttributo= &amp;quot;IDULLCO&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns3:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO') ]/attributidettaglioasset[nomeAttributo= &amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;>&lt;tns:IDULLCO>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO') ]/attributidettaglioasset[nomeAttributo= &amp;quot;IDULLCO&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:IDULLCO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns3:RICHIESTA/ordine/tipologiaSottolav)='TRASLOCO' or upper-case($Start/tns3:RICHIESTA/ordine/tipologiaSottolav)='CAMBIOCOPPIA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO') ]/attributidettaglioasset[nomeAttributo= &amp;quot;PERMUTATORE1&amp;quot;]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns3:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO') ]/attributidettaglioasset[nomeAttributo= &amp;quot;PERMUTATORE1&amp;quot;]/valoreAttributo&quot;>&lt;tns:POSIZIONEPERMUTATORE1>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO') ]/attributidettaglioasset[nomeAttributo= &amp;quot;PERMUTATORE1&amp;quot;]/valoreAttributo&quot;/>&lt;/tns:POSIZIONEPERMUTATORE1>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/dett