;/xsl:if>&lt;xsl:if test=&quot;$Start/tns3:ASSET/interno&quot;>&lt;tns:INTERNO>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/interno&quot;/>&lt;/tns:INTERNO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/codiceToponomastica)>0&quot;>&lt;tns:CODICEINDIRIZZO>&lt;xsl:value-of select=&quot;string-length($Start/tns3:ASSET/codiceToponomastica)>0&quot;/>&lt;/tns:CODICEINDIRIZZO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEINDIRIZZO>&lt;xsl:value-of select=&quot;concat($Start/tns3:ASSET/codiceISTATProvincia,'_' ,$Start/tns3:ASSET/codiceISTATComune,'_',$Start/tns3:ASSET/numeroCivico)&quot;/>&lt;/tns:CODICEINDIRIZZO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/codiceISTATComune)=6&quot;>&lt;tns:CODICECOMUNE>&lt;xsl:value-of select=&quot;substring($Start/tns3:ASSET/codiceISTATComune,string-length($Start/tns3:ASSET/codiceISTATComune)-2,3)&quot;/>&lt;/tns:CODICECOMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/codiceISTATComune)>0&quot;>&lt;tns:CODICECOMUNE>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/codiceISTATComune&quot;/>&lt;/tns:CODICECOMUNE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICECOMUNE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICECOMUNE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:RICHIESTA/ordine/sede[1]/codiceVia)>0&quot;>&lt;tns:CODESTRADA>&lt;xsl:value-of select=&quot;$Start/tns3:RICHIESTA/ordine/sede[1]/codiceVia&quot;/>&lt;/tns:CODESTRADA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODESTRADA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODESTRADA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns3:ASSET/provincia)>0&quot;>&lt;tns:PROVINCIA>&lt;xsl:value-of select=&quot;$Start/tns3:ASSET/provincia&quot;/>&lt;/tns:PROVINCIA>&lt;/xsl:when>&lt;xsl:otherwise