                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeXDSLATM/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CessazioneXDSLATM-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns2:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;$Start/tns2:CODE_OLO&quot;/>&lt;/tns:OLO_CODE>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:OLO_CODING>&lt;tns:CESSAZIONE>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;BITSTREAMATMSIMMETRICOHL&amp;quot;&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;28&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;BITSTREAMATMSIMMETRICOFLAT&amp;quot;&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;&amp;quot;29&amp;quot;&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;BITSTREAMATMASIMMETRICOFLAT&amp;quot;&quot;>&lt;tns:SERVIZIO>&lt;xsl:value-of select=&quot;'08'&quot;/>&lt;/tns:SERVIZIO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;