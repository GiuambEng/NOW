                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeXDSLATM/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+be676a6e-8cbd-49e0-874d-34220723a9e2+output&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;AttivazioneXDSLATM-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns2:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;$Start/tns2:CODE_OLO&quot;/>&lt;/tns:OLO_CODE>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:OLO_CODING>&lt;tns:ATTIVAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/codiceOrdineTI)>0&quot;>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns2:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:ASSET/IDAssetCRMWS)&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/CLLI&quot;/>&lt;/tns:CLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Start/tns2:RecordAsset)>0&quot;>&lt;tns:DATI_SEDE>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrParticellaTopon&quot;>&lt;tns:PARTICELLATOPONOMASTICA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrParticellaTopon&quot;/>&lt;/tns:PARTICELLATOPONOMASTICA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrVia&quot;>&lt;tns:VIA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrVia&quot;/>&lt;/tns:VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:NumeroCivico&quot;>&lt;tns:CIVICO>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:NumeroCivico&quot;/>&lt;/tns:CIVICO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrComune&quot;>&lt;tns:LOCALITA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrComune&quot;/>&lt;/tns:LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:CAP&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/complesso&quot;>&lt;tns:COMPLESSO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/complesso&quot;/>&lt;/tns:COMPLESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/scala&quot;>&lt;tns:SCALA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/scala&quot;/>&lt;/tns:SCALA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/piano&quot;>&lt;tns:PIANO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/piano&quot;/>&lt;/tns:PIANO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/interno&quot;>&lt;tns:INTERNO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/interno&quot;/>&lt;/tns:INTERNO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:Cod_Topon&quot;>&lt;tns:CODICEINDIRIZZO>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:Cod_Topon&quot;/>&lt;/tns:CODICEINDIRIZZO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:RecordAsset[1]/tns2:CodISTATComune)>0&quot;>&lt;tns:CODICECOMUNE>&lt;xsl:value-of select=&quot;substring($Start/tns2:RecordAsset[1]/tns2:CodISTATComune, string-length($Start/tns2:RecordAsset[1]/tns2:CodISTATComune)-2, 3)&quot;/>&lt;/tns:CODICECOMUNE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:CODESTRADA>&lt;xsl:value-of select=&quot;string(xsd:integer($Start/tns2:RecordAsset[1]/tns2:CodVia))&quot;/>&lt;/tns:CODESTRADA>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrProv&quot;>&lt;tns:PROVINCIA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DescrProv&quot;/>&lt;/tns:PROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:SiglaProv&quot;>&lt;tns:SIGLAPROVINCIA>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:SiglaProv&quot;/>&lt;/tns:SIGLAPROVINCIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:RecordAsset[1]/tns2:DR&quot;>&lt;tns:DR>&lt;xsl:value-of select=&quot;$Start/tns2:RecordAsset[1]/tns2:DR&quot;/>&lt;/tns:DR>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:RecordAsset[1]/tns2:CodISTATComune)>0&quot;>&lt;tns:ISTATPROV>&lt;xsl:value-of select=&quot;substring($Start/tns2:RecordAsset[1]/tns2:CodISTATComune, 1, 3)&quot;/>&lt;/tns:ISTATPROV>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:DATI_SEDE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DATI_SEDE>&lt;xsl:if test=&quot;$Start/tns2:ASSET/descrPartToponomastica&quot;>&lt;tns:PARTICELLATOPONOMASTICA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/descrPartToponomastica&quot;/>&lt;/tns:PARTICELLATOPONOMASTICA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/descrizioneVia&quot;>&lt;tns:VIA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/descrizioneVia&quot;/>&lt;/tns:VIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/numeroCivico&quot;>&lt;tns:CIVICO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/numeroCivico&quot;/>&lt;/tns:CIVICO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/localita&quot;>&lt;tns:LOCALITA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/localita&quot;/>&lt;/tns:LOCALITA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/CAP&quot;>&lt;tns:CAP>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/CAP&quot;/>&lt;/tns:CAP>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/complesso&quot;>&lt;tns:COMPLESSO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/complesso&quot;/>&lt;/tns:COMPLESSO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/scala&quot;>&lt;tns:SCALA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/scala&quot;/>&lt;/tns:SCALA>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/piano&quot;>&lt;tns:PIANO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/piano&quot;/>&lt;/tns:PIANO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:ASSET/interno&quot;>&lt;tns:INTERNO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/interno&quot;/>&lt;/tns:INTERNO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/codiceToponomastica)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/codiceToponomastica&quot;>&lt;tns