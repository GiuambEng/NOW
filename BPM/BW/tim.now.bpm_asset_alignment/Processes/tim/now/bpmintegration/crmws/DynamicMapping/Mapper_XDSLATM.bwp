STATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;azione&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:STATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(../DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;azione='A' or azione='D' or azione='M'&quot;>&lt;tns:DATA_ESPLETAMENTO>&lt;xsl:value-of select=&quot;tib:parse-dateTime('yyyy-MM-dd', string(../DES))&quot;/>&lt;/tns:DATA_ESPLETAMENTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!--DATA_ESPLETAMENTO:Al momento nell'otherwise c'è current datatime() in attesa del nuovo tracciato in cui diventerà opzionale-->&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='VPISP']/valoreAttributo)>0&quot;>&lt;tns:VPI_RETE>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='VPISP']/valoreAttributo)&quot;/>&lt;/tns:VPI_RETE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='VCISP']/valoreAttributo)>0&quot;>&lt;tns:VCI_RETE>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='VCISP']/valoreAttributo)&quot;/>&lt;/tns:VCI_RETE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo)>0&quot;>&lt;tns:VPI>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='VPI']/valoreAttributo)&quot;/>&lt;/tns:VPI>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo)>0&quot;>&lt;tns:VCI>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='VCI']/valoreAttributo)&quot;/>&lt;/tns:VCI>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICETD']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICETD']/valoreAttributo&quot;>&lt;tns:CODICE_TD>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICETD']/valoreAttributo&quot;/>&lt;/tns:CODICE_TD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CODICEVP']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEVP']/valoreAttributo&quot;>&lt;tns:CODICE_VP>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='CODICEVP']/valoreAttributo&quot;/>&lt;/tns:CODICE_VP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='TRASPORTO']/valoreAttributo)>0&quot;>&lt;tns:TRASPORTO>&lt;xsl:value-of select=&quot;upper-case(attributiDettaglioOrdine[nomeAttributo='TRASPORTO']/valoreAttributo)&quot;/>&lt;/tns:TRASPORTO>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:ASSET/dettaglioasset[nomeComponente= 'PROTOCOLLO']/attributidettaglioasset[nomeAttributo='TIPOPROTOCOLLO'][1]/valoreAttributo='FR'&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo&quot;>&lt;tns:DLCI>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='DLCI']/valoreAttributo&quot;/>&lt;/tns:DLCI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns:PROFILOVC>&lt;tns:TIPOPROFILOVC>&lt;xsl:value-of select=&quot;upper-case(attributiDettaglioOrdine[nomeAttributo='TIPOPROFILOVC']/valoreAttributo)&quot;/>&lt;/tns:TIPOPROFILOVC>&lt;tns:MCRDOWN>&lt;xsl:value-of select=&quot;xsd:integer($Accumulate/tns1:resultSet[Record/ID_PRFL_VC=number($ID_PROFILO_VC)][1]/Record[1]/MCR_DOWN)&quot;/>&lt;/tns:MCRDOWN>&lt;tns:MCRUP>&lt;xsl:value-of select=&quot;xsd:integer($Accumulate/tns1:resultSet[Record/ID_PRFL_VC=number($ID_PROFILO_VC)][1]/Record[1]/MCR_UP)&quot;/>&lt;/tns:MCRUP>&lt;tns:PCRDOWN>&lt;xsl:value-of select=&quot;xsd:integer($Accumulate/tns1:resultSet[Record/ID_PRFL_VC=number($ID_PROFILO_VC)][1]/Record[1]/PCR_DOWN)&quot;/>&lt;/tns:PCRDOWN>&lt;tns:PCRUP>&lt;xsl:value-of select=&quot;xsd:integer($Accumulate/tns1:resultSet[Record/ID_PRFL_VC=number($ID_PROFILO_VC)][1]/Record[1]/PCR_UP)&quot;/>&lt;/tns:PCRUP>&lt;tns:SCRDOWN>&lt;xsl:value-of select=&quot;xsd:integer($Accumulate/tns1:resultSet[Record/ID_PRFL_VC=number($ID_PROFILO_VC)][1]/Record[1]/SCR_DOWN)&quot;/>&lt;/tns:SCRDOWN>&lt;tns:SCRUP>&lt;xsl:value-of select=&quot;xsd:integer($Accumulate/tns1:resultSet[Record/ID_PRFL_VC=number($ID_PROFILO_VC)][1]/Record[1]/SCR_UP)&quot;/>&lt;/tns:SCRUP>&lt;/tns:PROFILOVC>&lt;/tns:DATIVCATM>&lt;/xsl:for-each>&lt;/tns:BTSATMGBEEASYIP>&lt;/tns:VARIAZIONE>&lt;/tns:SERVIZIO>&lt;/tns:REQUEST>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
