                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="maxRows" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+be676a6e-8cbd-49e0-874d-34220723a9e2+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+be676a6e-8cbd-49e0-874d-34220723a9e2+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="MCR_UP" nillable="false" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="MCR_DOWN" nillable="false" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="PCR_UP" nillable="false" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="PCR_DOWN" nillable="false" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="SCR_DOWN" nillable="false" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="SCR_UP" nillable="false" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="ID_PRFL_VC" type="decimal"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <xs:schema elementFormDefault="qualified"
