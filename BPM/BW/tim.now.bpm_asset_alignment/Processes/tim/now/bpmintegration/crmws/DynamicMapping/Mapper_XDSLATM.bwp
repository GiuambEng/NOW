                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeXDSLATM/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+be676a6e-8cbd-49e0-874d-34220723a9e2+output&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;VariazioneXDSLATM-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns2:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;$Start/tns2:CODE_OLO&quot;/>&lt;/tns:OLO_CODE>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:OLO_CODING>&lt;tns:VARIAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/codiceOrdineTI)>0&quot;>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:CONTRATTO>&lt;xsl:value-of select=