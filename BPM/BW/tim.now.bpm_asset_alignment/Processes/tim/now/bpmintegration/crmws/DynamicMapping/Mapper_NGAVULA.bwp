loreAttributo&quot;/>&lt;/tns:UserVLAN_1_TAGGING>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;>&lt;tns:UserVLAN_1_TAGGING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSONGAFTTCAB')]/attributidettaglioasset[nomeAttributo='USERVLAN1TAGGING']/valoreAttributo&quot;/>&lt;/tns:UserVLAN_1_TAGGING>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;>&lt;tns:UserVLAN_1_TAGGING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSONGAFTTH')]/attributidettaglioasset[nomeAttributo='USERVLAN1TAGGING']/valoreAttributo&quot;/>&lt;/tns:UserVLAN_1_TAGGING>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;VULAFTTCAB&amp;quot;&quot;>&lt;tns:UserVLAN_1_TAGGING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSOVULAFTTCAB')]/attributidettaglioasset[nomeAttributo='USERVLAN1TAGGING']/valoreAttributo&quot;/>&lt;/tns:UserVLAN_1_TAGGING>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:UserVLAN_1_TAGGING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSOVULAFTTH')]/attributidettaglioasset[nomeAttributo='USERVLAN1TAGGING']/valoreAttributo&quot;/>&lt;/tns:UserVLAN_1_TAGGING>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:DISTRETTO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns2:ASSET/distretto)))&quot;/>&lt;/tns:DISTRETTO>&lt;xsl:if test=&quot;$Start/tns2:ASSET/numeroFittizio&quot;>&lt;tns:AGGIUNTIVO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/numeroFittizio&quot;/>&lt;/tns:AGGIUNTIVO>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns2:RICHIESTA/ordine/dettaglioordine[nomeComponente='USERVLAN']&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists(attributiDettaglioOrdine[nomeAttributo='FLAGMULTICAST']))&quot;>&lt;tns:USERVLAN>&lt;xsl:variable name=&quot;ID_PROFILO_BMD&quot; select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='PROFILOBMD'][1]/valoreAttributo)&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='IDRISORSAUSERVLAN'][1]/valoreAttributo)>0&quot;>&lt;tns:IdRisorsaUserVLAN>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='IDRISORSAUSERVLAN'][1]/valoreAttributo&quot;/>&lt;/tns:IdRisorsaUserVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IdRisorsaUserVLAN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:IdRisorsaUserVLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='USERVLANID'][1]/valoreAttributo) > 0&quot;>&lt;tns:UserVLANId>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='USERVLANID'][1]/valoreAttributo)&quot;/>&lt;/tns:UserVLANId>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='SVLANCODE'][1]/valoreAttributo) > 0&quot;>&lt;tns:CODICE_VLAN>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='SVLANCODE'][1]/valoreAttributo&quot;/>&lt;/tns:CODICE_VLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_VLAN>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:CODICE_VLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='CVLANID'][1]/valoreAttributo) > 0&quot;>&lt;tns:CVLAN_ID>&lt;xsl:value-of select=&quot;xsd:int(attributiDettaglioOrdine[nomeAttributo='CVLANID'][1]/valoreAttributo)&quot;/>&lt;/tns:CVLAN_ID>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Accumulate/tns3:resultSet[$ID_PROFILO_BMD=Record/ID_PROFILO_BMD][1]/Record[1])&quot;>&lt;xsl:if test=&quot;$Accumulate/tns3:resultSet[$ID_PROFILO_BMD=Record/ID_PROFILO_BMD][1]/Record[1]/PROFILO&quot;>&lt;tns:PROFILO_BMD>&lt;xsl:value-of select=&quot;$Accumulate/tns3:resultSet[$ID_PROFILO_BMD=Record/ID_PROFILO_BMD][1]/Record[1]/PROFILO&quot;/>&lt;/tns:PROFILO_BMD>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='BANDAPICCOUP'][1]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='BANDAPICCOUP'][1]/valoreAttributo&quot;>&lt;tns:BANDA_PICCO_UP>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='BANDAPICCOUP'][1]/valoreAttributo&quot;/>&lt;/tns:BANDA_PICCO_UP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='BANDAPICCODOWN'][1]/valoreAttributo) > 0&quot;>&lt;xsl:if test=&quot;attributiDettaglioOrdine[nomeAttributo='BANDAPICCODOWN'][1]/valoreAttributo&quot;>&lt;tns:BANDA_PICCO_DOWN>&lt;xsl:value-of select=&quot;attributiDettaglioOrdine[nomeAttributo='BANDAPICCODOWN'][1]/valoreAttributo&quot;/>&lt;/tns:BANDA_PICCO_DOWN>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;azione='D'&quot;>&lt;tns:STATO_USERVLAN>&lt;xsl:value-of select=&quot;&amp;quot;Inactive&amp;quot;&quot;/>&lt;/tns:STATO_USERVLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:STATO_USERVLAN>&lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&lt;/tns:STATO_USERVLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(../DES)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;azione='D' or azione='A' or azione='M'  &quot;>&lt;tns:DATA_ESPT_USERVLAN>&lt;xsl:value-of select=&quot;tib:parse-dateTime('yyyy-MM-dd', string(../DES))&quot;/>&lt;/tns:DATA_ESPT_USERVLAN>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributiDettaglioOrdine[nomeAttributo='TIPOTRASPORTO'][1]/valoreAttributo) > 0&quot;>&lt;tns:TRASPORTO>&lt;xsl:value-of