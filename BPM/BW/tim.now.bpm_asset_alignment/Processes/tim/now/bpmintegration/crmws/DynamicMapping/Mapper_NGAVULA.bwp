                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/TipoLinea/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;TipoLinea&quot; match=&quot;/&quot;>&lt;tns:TIPOLINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($Start/tns2:ASSET/dettaglioasset/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)),'POTS')&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;POTS&amp;quot;&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($Start/tns2:ASSET/dettaglioasset/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)),'ISDN')&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;&amp;quot;ISDN&amp;quot;&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot; or starts-with($Start/tns2:ASSET/offerta, 'SEMI')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA']/valoreAttributo)='LINEANONFONIA'&quot;>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TipoLinea>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:TipoLinea>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:ASSET/offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSONGAFTTH')]/attributidettaglioasset[nomeAtt