                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeNGAVULA/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/TipoLinea/&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fffc8dc7-efe7-4756-9382-d0cdb3ae4ea6+output&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TipoLinea&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;Attivazione-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat('N','-',tib:pad-front(xsd:string($Start/tns2:NextVal),10,'0'))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:OLO_CODE>&lt;xsl:value-of select=&quot;$Start/tns2:CODE_OLO&quot;/>&lt;/tns:OLO_CODE>&lt;tns:OLO_CODING>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:OLO_CODING>&lt;tns:ATTIVAZIONE>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:ASSET/codiceOrdineTI)&quot;>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:IdContratto)&quot;>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns2:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns:CONTRATTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;tns:RISORSA_TI>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDRisorsaNOW&quot;/>&lt;/tns:RISORSA_TI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/CLLI&quot;/>&lt;/tns:CLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/operatoreRete)>0&quot;>&lt;tns:CUSTOMER>&lt;xsl:value-of select=&quot;&amp;quot;CSPA&amp;quot;&quot;/>&lt;/tns:CUSTOMER>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:ASSET/opzioneDinamica)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:ASSET/opzioneDinamica&quot;>&lt;tns:OPZIONE_DINAMICA>&lt;xsl:value-of select=&quot;$Start/tns2:ASSET/opzioneDinamica&quot;/>&lt;/tns:OPZIONE_DINAMICA>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($Start/tns2:ASSET/dettaglioasset[starts-with(nomeComponente,'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLOGIACLUSTERCOMUNE']/valoreAttributo)>0&quot;>&lt;tns:TIPOLOGIA_CLUSTER_COMUNE>&lt;xs