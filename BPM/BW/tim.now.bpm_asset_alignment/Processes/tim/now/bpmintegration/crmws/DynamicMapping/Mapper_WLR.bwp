            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogMapperInsert-input"
                    name="LogMapperInsert"
                    tibex:xpdlId="6e2342b7-7ca1-4d96-9b87-54af9cffb8af"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
