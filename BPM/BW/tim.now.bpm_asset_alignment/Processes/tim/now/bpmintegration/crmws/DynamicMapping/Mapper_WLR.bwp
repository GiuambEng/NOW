                       &lt;xsl:value-of select=&quot;tns1:LAST_UPD&quot;/>&#xa;                            &lt;/tns1:LAST_UPD>&#xa;                            &lt;xsl:if test=&quot;tns1:LAST_UPD_BY&quot;>&#xa;                                &lt;tns1:LAST_UPD_BY>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:LAST_UPD_BY&quot;/>&#xa;                                &lt;/tns1:LAST_UPD_BY>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:MODIFICATION_NUM>&#xa;                                &lt;xsl:value-of select=&quot;tns1:MODIFICATION_NUM&quot;/>&#xa;                            &lt;/tns1:MODIFICATION_NUM>&#xa;                            &lt;tns1:CONFLICT_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns1:CONFLICT_ID&quot;/>&#xa;                            &lt;/tns1:CONFLICT_ID>&#xa;                            &lt;xsl:if test=&quot;tns1:DB_LAST_UPD&quot;>&#xa;                                &lt;tns1:DB_LAST_UPD>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DB_LAST_UPD&quot;/>&#xa;                                &lt;/tns1:DB_LAST_UPD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DB_LAST_UPD_SRC&quot;>&#xa;                                &lt;tns1:DB_LAST_UPD_SRC>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DB_LAST_UPD_SRC&quot;/>&#xa;                                &lt;/tns1:DB_LAST_UPD_SRC>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:DN&quot;>&#xa;                                &lt;tns1:DN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DN&quot;/>&#xa;                                &lt;/tns1:DN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:RESPONSE>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/tns1:RESPONSE>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:RESPONSE>&#xa;                    &lt;tns1:RESPONSE>&#xa;                        &lt;tns1:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;tns1:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:RESPONSE_DATE>&#xa;                        &lt;tns1:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:RETURN_CODE>&#xa;                        &lt;tns1:DESCRIZIONE_ERRORE>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:DESCRIZIONE_ERRORE>&#xa;                        &lt;tns1:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:COD_SRVZ>&#xa;                        &lt;tns1:CREATED>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:CREATED>&#xa;                        &lt;tns1:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_CRMWS>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                        &lt;tns1:ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_ORDN>&#xa;                        &lt;tns1:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                        &lt;/tns1:ID_RISORSA>&#xa;                        &lt;tns1:LAVRZ>&#xa;                           