    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="9e2c6e03-8a65-4591-a033-e7f1f0c6159b">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="CallProcess2ToRethrow" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="95c4ebe3-3fc4-4795-8024-7ceac89c9cec">
                            <bpws:targets>
                                <bpws:target linkName="CallProcess2ToRethrow"/>
                            </bpws:targets>
                        </bpws:rethrow>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogFaultMapper_WLR-input"
                                name="LogFaultMapper_WLR"
                                tibex:xpdlId="8e26141b-739a-4f87-9104-bffdf0c16a35"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="CallProcess2ToRethrow"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;LogFaultMapper_WLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'Mapper_WLR'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'Mapper_WLR'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'Mapper_WLR'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                &lt;/tns2:MsgCode>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails,true(),true())&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.crmws.DynamicMapping'&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'Mapper_WLR'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'Mapper_WLR_ERROR'&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('Mapper_WLR_', $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:ErrorLog>&#xa;                        &lt;tns2:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns2:TimeStamp>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;concat('Errore su Mapper_WLR, id_richiesta: ', $Start/tns1:ASSET/IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:track_position>&#xa;                            &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                        &lt;/tns2:track_position>&#xa;                        &lt;tns2:ErrorReport>&#xa;                            &lt;tns2:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                            &lt;/tns2:StackTrace>&#xa;                            &lt;tns2:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                            &lt;/tns2:Msg>&#xa;                            &lt;tns2:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                            &lt;/tns2:ProcessStack>&#xa;                            &lt;tns2:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                            &lt;/tns2:MsgCode>&#xa;                            &lt;tns2:Data/>&#xa;                        &lt;/tns2:ErrorReport>&#xa;                    &lt;/tns2:ErrorLog>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="CallProcess1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStarttMapper_WLRToJDBCCallProcedure" tibex:linkType="SUCCESS"/>
                <bpws:link name="WLRToMapper_Attivazione-Variazione"
                    tibex:label="Attivazione-Variazione" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="WLRToMapper1_Cessazione"
                    tibex:label="Cessazione" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Mapper1ToCallProcess4" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToCallProcess3" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess4ToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess3ToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess5ToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="WLRToCallProcess5_Altrelavorazioni"
                    tibex:label="Altre lavorazioni" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToMapper2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Mapper2ToCallProcess6" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcess6ToCallProcess1" tibex:linkType="SUCCESS"/>
                <bpws:link name="SelectCodiceDestinatarioToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToWLR" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="1516dd32-01ff-4e7f-97e0-60295fa8f9bc"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="fbfc1b44-663d-4fa6-acc0-db66df9431c4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperInsert&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($MapperInsert)&quot;>&#xa;                &lt;tns1:RESPONSE>&#xa;                    &lt;xsl:for-each select=&quot;$MapperInsert/tns1:RESPONSE&quot;>&#xa;                        &lt;tns1:RESPONSE>&#xa;                            &lt;tns1:TRANSACTION_ID>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns1:TRANSACTION_ID>&#xa;                            &lt;tns1:RESPONSE_DATE>&#xa;                                &lt;xsl:value-of select=&quot;tns1:RESPONSE_DATE&quot;/>&#xa;                            &lt;/tns1:RESPONSE_DATE>&#xa;                            &lt;tns1:RETURN_CODE>&#xa;                                &lt;xsl:value-of select=&quot;tns1:RETURN_CODE&quot;/>&#xa;                            &lt;/tns1:RETURN_CODE>&#xa;                            &lt;xsl:if test=&quot;tns1:DESCRIZIONE_ERRORE&quot;>&#xa;                                &lt;tns1:DESCRIZIONE_ERRORE>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:DESCRIZIONE_ERRORE&quot;/>&#xa;                                &lt;/tns1:DESCRIZIONE_ERRORE>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:COD_SRVZ&quot;>&#xa;                                &lt;tns1:COD_SRVZ>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:COD_SRVZ&quot;/>&#xa;                                &lt;/tns1:COD_SRVZ>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:CREATED>&#xa;                                &lt;xsl:value-of select=&quot;tns1:CREATED&quot;/>&#xa;                            &lt;/tns1:CREATED>&#xa;                            &lt;xsl:if test=&quot;tns1:ID_ASSET_CRMWS&quot;>&#xa;                                &lt;tns1:ID_ASSET_CRMWS>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ID_ASSET_CRMWS&quot;/>&#xa;                                &lt;/tns1:ID_ASSET_CRMWS>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:ID_ASSET_NOW>&#xa;                                &lt;xsl:value-of select=&quot;tns1:ID_ASSET_NOW&quot;/>&#xa;                            &lt;/tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:if test=&quot;tns1:ID_ORDN&quot;>&#xa;                                &lt;tns1:ID_ORDN>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ID_ORDN&quot;/>&#xa;                                &lt;/tns1:ID_ORDN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:ID_RISORSA&quot;>&#xa;                                &lt;tns1:ID_RISORSA>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:ID_RISORSA&quot;/>&#xa;                                &lt;/tns1:ID_RISORSA>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:LAVRZ&quot;>&#xa;                                &lt;tns1:LAVRZ>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:LAVRZ&quot;/>&#xa;                                &lt;/tns1:LAVRZ>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns1:MESSAGGIO&quot;>&#xa;                                &lt;tns1:MESSAGGIO>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:MESSAGGIO&quot;/>&#xa;                                &lt;/tns1:MESSAGGIO>&#xa;     