            <bpws:empty name="WLR" tibex:xpdlId="ca0b0f6f-c665-4f77-b359-3656b12ef177">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWLR"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WLRToMapper_Attivazione-Variazione">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/ns9:RICHIESTA/lavorazione)='ATTIVAZIONE' or upper-case($Start/ns9:RICHIESTA/lavorazione)='VARIAZIONE' or $Start/ns9:LavorazioneAsset='ATTIVAZIONE' or $Start/ns9:LavorazioneAsset='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/ns9:RICHIESTA/lavorazione)='ATTIVAZIONE' or upper-case($Start/ns9:RICHIESTA/lavorazione)='VARIAZIONE' or $Start/ns9:LavorazioneAsset='ATTIVAZIONE' or $Start/ns9:LavorazioneAsset='VARIAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="WLRToMapper1_Cessazione">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/ns9:RICHIESTA/lavorazione)='CESSAZIONE' or $Start/ns9:LavorazioneAsset='CESSAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($Start/ns9:RICHIESTA/lavorazione)='CESSAZIONE' or $Start/ns9:LavorazioneAsset='CESSAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="WLRToCallProcess5_Altrelavorazioni">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Attivazione-VariazioneWLR-input"
                    name="Attivazione-VariazioneWLR"
                    outputVariable="Attivazione-VariazioneWLR"
                    tibex:xpdlId="58355ac1-47ba-49c6-bce8-6bb4c2801cac" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WLRToMapper_Attivazione-Variazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess3"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeWLR/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectCodiceDestinatario&quot;/>&lt;xsl:template name=&quot;Attivazione-VariazioneWLR-input&quot; match=&quot;/&quot;>&lt;tns:REQUEST>&lt;tns:TRANSACTION_ID>&lt;xsl:value-of select=&quot;concat(&amp;quot;N&amp;quot;,&amp;quot;-&amp;quot;, tib:pad-front(xsd:string($Start/tns1:NextVal), 10, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_ID>&lt;tns:TRANSACTION_DATE>&lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&lt;/tns:TRANSACTION_DATE>&lt;tns:SERVIZIO>&lt;tns:CODICEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&lt;/tns:CODICEOLO>&lt;tns:DESCOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codificaOLOAGCOM&quot;/>&lt;/tns:DESCOLO>&lt;tns:WLR>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:ASSET/offerta)='WLRLINEAATTIVA'&quot;>&lt;tns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;18&amp;quot;&quot;/>&lt;/tns:CRMWS_SERVICE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CRMWS_SERVICE>&lt;xsl:value-of select=&quot;&amp;quot;17&amp;quot;&quot;/>&lt;/tns:CRMWS_SERVICE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ATT_VAR_ACCESSO>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineOLO)>11&quot;>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;substring($Start/tns1:ASSET/codiceOrdineOLO,1,11)&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICEORDINEOLO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineOLO&quot;/>&lt;/tns:CODICEORDINEOLO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/codiceOrdineTI)>0&quot;>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/codiceOrdineTI&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CODICE_ORDINE_TI>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CODICE_ORDINE_TI>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:IdContratto)>0&quot;>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;$Start/tns1:IdContratto&quot;/>&lt;/tns:CONTRATTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CONTRATTO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CONTRATTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:RISORSA>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRisorsa&quot;/>&lt;/tns:RISORSA>&lt;xsl:if test=&quot;exists($Start/tns1:ASSET/IDAsset)&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAsset&quot;>&lt;tns:ID_NOW>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAsset&quot;/>&lt;/tns:ID_NOW>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;>&lt;tns:ID_CRMWS>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDAssetCRMWS&quot;/>&lt;/tns:ID_CRMWS>&lt;/xsl:if>&lt;tns:DEC>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/DES&quot;/>&lt;/tns:DEC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:ASSET/distretto)  and string-length($Start/tns1:ASSET/distretto)>0&quot;>&lt;tns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;concat('0', string(xsd:integer($Start/tns1:ASSET/distretto)))&quot;/>&lt;/tns:DISTR_TELEFONICO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DISTR_TELEFONICO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:DISTR_TELEFONICO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/CLLI)>0&quot;>&lt;tns:CLLI_CENTRALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/CLLI&quot;/>&lt;/tns:CLLI_CENTRALE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CLLI_CENTRALE>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:CLLI_CENTRALE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODECENTRALEACLRR']/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODECENTRALEACLRR']/valoreAttributo&quot;>&lt;tns:CODICE_CENTRALE_ACLRR>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODECENTRALEACLRR']/valoreAttributo&quot;/>&lt;/tns:CODICE_CENTRALE_ACLRR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(upper-case(tib:trim($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='TIPOLINEA'][1]/valoreAttributo)),'ISDN')&quot;>&lt;tns:TIPO_DN>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns:TIPO_DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TIPO_DN>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns:TIPO_DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA'][1]/valoreAttributo)='SIMPLEX'&quot;>&lt;tns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;SX&amp;quot;&quot;/>&lt;/tns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA'][1]/valoreAttributo)='BRA MONO' or upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA'][1]/valoreAttributo)='BRAMONO' &quot;>&lt;tns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;BMO&amp;quot;&quot;/>&lt;/tns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA'][1]/valoreAttributo)='BRA MULTI' or upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA'][1]/valoreAttributo)='BRAMULTI'&quot;>&lt;tns:TIPO_LINEA>&lt;xsl:value-of select=&quot;&amp;quot;BMU&amp;quot;&quot;/>&lt;/tns:TIPO_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TIPO_LINEA>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA'][1]/valoreAttributo)&quot;/>&lt;/tns:TIPO_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='STRUTTURALINEA'][1]/valoreAttributo='GNR'&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='RADICALE'][1]/valoreAttributo&quot;>&lt;tns:RADICALE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='RADICALE'][1]/valoreAttributo&quot;/>&lt;/tns:RADICALE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='DIREZIONALITA'][1]/valoreAttributo)>0&quot;>&lt;tns:DIREZIONALITA>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='DIREZIONALITA'][1]/valoreAttributo)&quot;/>&lt;/tns:DIREZIONALITA>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='QUANTITACANALI'][1]/valoreAttributo)>0&quot;>&lt;tns:QTA_LINEE>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='QUANTITACANALI'][1]/valoreAttributo)&quot;/>&lt;/tns:QTA_LINEE>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='QUANTITALINEE'][1]/valoreAttributo)>0&quot;>&lt;tns:QTA_LINEE>&lt;xsl:value-of select=&quot;xsd:int($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='QUANTITALINEE'][1]/valoreAttributo)&quot;/>&lt;/tns:QTA_LINEE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='SELEZIONEPASSANTE'][1]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='SELEZIONEPASSANTE'][1]/valoreAttributo&quot;>&lt;tns:SELEZIONE_PASSANTE>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='SELEZIONEPASSANTE'][1]/valoreAttributo&quot;/>&lt;/tns:SELEZIONE_PASSANTE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='ACCESSONUMERICO'][1]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='ACCESSONUMERICO'][1]/valoreAttributo&quot;>&lt;tns:ACCESSO_NUMERICO>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='ACCESSONUMERICO'][1]/valoreAttributo&quot;/>&lt;/tns:ACCESSO_NUMERICO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='IDRISORSABTSNAKED'][1]/valoreAttributo)>0&quot;>&lt;xsl:if test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='IDRISORSABTSNAKED'][1]/valoreAttributo&quot;>&lt;tns:ID_RISORSA_BTS_NAKED>&lt;xsl:value-of select=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='IDRISORSABTSNAKED'][1]/valoreAttributo&quot;/>&lt;/tns:ID_RISORSA_BTS_NAKED>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='BORCHIANT1PLUS'][1]/valoreAttributo)>0&quot;>&lt;tns:BORCHIA_NT1_PLUS>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='BORCHIANT1PLUS'][1]/valoreAttributo)&quot;/>&lt;/tns:BORCHIA_NT1_PLUS>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODICEPIATTAFORMA'][1]/valoreAttributo)>0&quot;>&lt;tns:CODICE_PIATTAFORMA>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODICEPIATTAFORMA'][1]/valoreAttributo)&quot;/>&lt;/tns:CODICE_PIATTAFORMA>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE'][1]/valoreAttributo)>0&quot;>&lt;tns:CODICE_FATTURAZIONE>&lt;xsl:value-of select=&quot;upper-case($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE'][1]/valoreAttributo)&quot;/>&lt;/tns:CODICE_FATTURAZIONE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:RICHIESTA/lavorazione)='ATTIVAZIONE' or $Start/tns1:LavorazioneAsset='ATTIVAZIONE'&quot;>&lt;tns:TIPO_LAVORAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;A&amp;quot;&quot;/>&lt;/tns:TIPO_LAVORAZIONE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TIPO_LAVORAZIONE>&lt;xsl:value-of select=&quot;&amp;quot;V&amp;quot;&quot;/>&lt;/tns:TIPO_LAVORAZIONE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns1:RICHIESTA/ordine/tipologiaLavorazione)='VARIAZIONE'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectCodiceDestinatario/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO)>0&quot;>&lt;xsl:if test=&quot;not((string($SelectCodiceDestinatario/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[1]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SelectCodiceDestinatario/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[1]/COD_CAUS_DESTNRIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SelectCodiceDestinatario/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[1]/COD_CAUS_DESTNRIO)&quot;>&lt;tns:SOTTO_LAVORAZIONE>&lt;xsl:value-of select=&quot;$SelectCodiceDestinatario/outputSet/RESULTSET/APPUSER.TOUTS_TRASCDFC_DESTINATARIO[1]/COD_CAUS_DESTNRIO&quot;/>&lt;/tns:SOTTO_LAVORAZIONE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGMANTENIMENTOPRODOTTI'][1]/valoreAttributo)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGMANTENIMENTOPRODOTTI'][1]/valoreAttributo='0'&quot;>&lt;tns:FLG_MANTENIMENTO_PRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FLG_MANTENIMENTO_PRODOTTI>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:ASSET/dettaglioasset[starts-with(nomeComponente, 'ACCESSO')]/attributidettaglioasset[nomeAttributo='FLAGMANTENIMENTOPRODOTTI'][1]/valoreAttributo='1'&quot;>&lt;tns:FLG_MANTENIMENTO_PRODOTTI>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FLG_MANTENIMENTO_PRODOTTI>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$Start/tns1:ASSET/dettaglioasset[nomeComponente='AGGIUNTIVO']&quot;>&lt;tns:AGGIUNTIVI>&lt;xsl:if test=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;>&lt;tns:NUMERO>&lt;xsl:value-of select=&quot;attributidettaglioasset[nomeAttributo='NUMEROTELEFONICO']/valoreAttributo&quot;/>&lt;/tns:NUMERO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)>0&quot;>&lt;tns:CODICE_FATTURAZIONE>&lt;xsl:value-of select=&quot;upper-case(attributidettaglioasset[nomeAttributo='CODICEFATTURAZIONE']/valoreAttributo)&quot;/>&lt;/tns:CODICE_FATTURAZIONE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/tns:AGGIUNTIVI>&lt;/xsl:for-each>&lt;xsl:for-eac