            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogEndMapper_WLR-input"
                    name="LogEndMapper_WLR"
                    tibex:xpdlId="0715488c-7d1e-4dea-ba35-71812b0599a1"
