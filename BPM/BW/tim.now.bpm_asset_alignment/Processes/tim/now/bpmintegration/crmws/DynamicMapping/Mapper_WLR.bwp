                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:NOW_CRMWS_AllineamentoConsistenzeWLR="http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeWLR/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NOW_CRMWS_AllineamentoConsistenzeWLR:REQUEST" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogAttivazione-VariazioneWLR-input"
                    name="LogAttivazione-VariazioneWLR"
                    tibex:xpdlId="e50bc8fe-4d8b-4719-a66e-397bc76ca014"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToCallProcess3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess3ToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Attivazione-VariazioneWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAttivazione-VariazioneWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Mapper_WLR', tib:render-xml($Attivazione-VariazioneWLR, true(),true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogCessazioneWLR-input"
                    name="LogCessazioneWLR"
                    tibex:xpdlId="2d19b995-256a-4f6f-8edf-f66fb8f7a98f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Mapper1ToCallProcess4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess4ToEmpty"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;CessazioneWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCessazioneWLR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Start Mapper_WLR', tib:render-xml($CessazioneWLR, true(),true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogAltreLavorazioni-input"
                    name="LogAltreLavorazioni"
                    tibex:xpdlId="2a964997-5dd3-45bc-9c8f-9c77eccfbfc5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WLRToCallProcess5_Altrelavorazioni"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess5ToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAltreLavorazioni-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Mapper_WLR&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:ASSET/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;'Altre Lavorazioni non ammesse'&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="0e6b739e-f973-4391-970b-ddb09721b08f">
                <bpws:targets>
                    <bpws:target linkName="CallProcess4ToEmpty"/>
                    <bpws:target linkName="CallProcess3ToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToMapper2"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperInsert-input"
                    name="MapperInsert" outputVariable="MapperInsert"
                    tibex:xpdlId="fd697be9-18cf-428b-9085-df0ed5aa24b8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToMapper2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper2ToCallProcess6"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW_CRMWS_AllineamentoConsistenzeWLR/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Attivazione-VariazioneWLR&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CessazioneWLR&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperInsert-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RESPONSE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Attivazione-VariazioneWLR)&quot;>&#xa;                    &lt;tns1:RESPONSE>&#xa;                        &lt;tns1:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;tns1:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:TRANSACTION_DATE&quot;/>&#xa;                        &lt;/tns1:RESPONSE_DATE>&#xa;                        &lt;tns1:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:CRMWS_SERVICE&quot;>&#xa;                            &lt;tns1:COD_SRVZ>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:CRMWS_SERVICE&quot;/>&#xa;                            &lt;/tns1:COD_SRVZ>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:CREATED>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:CREATED>&#xa;                        &lt;xsl:if test=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:ID_CRMWS&quot;>&#xa;                            &lt;tns1:ID_ASSET_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:ID_CRMWS&quot;/>&#xa;                            &lt;/tns1:ID_ASSET_CRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:ID_NOW&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                        &lt;xsl:if test=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:CODICEORDINEOLO&quot;>&#xa;                            &lt;tns1:ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:CODICEORDINEOLO&quot;/>&#xa;                            &lt;/tns1:ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:RISORSA&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:RISORSA&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;upper-case($Start/tns1:RICHIESTA/lavorazione)='ATTIVAZIONE' or $Start/tns1:LavorazioneAsset='ATTIVAZIONE'&quot;>&#xa;                                &lt;tns1:LAVRZ>&#xa;                                    &lt;xsl:value-of select=&quot;'ATTIVAZIONE'&quot;/>&#xa;                                &lt;/tns1:LAVRZ>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:LAVRZ>&#xa;                                    &lt;xsl:value-of select=&quot;'VARIAZIONE'&quot;/>&#xa;                                &lt;/tns1:LAVRZ>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns1:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($Attivazione-VariazioneWLR, true(), true())&quot;/>&#xa;                        &lt;/tns1:MESSAGGIO>&#xa;                        &lt;tns1:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                        &lt;/tns1:STATO>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:CODE_OLO&quot;>&#xa;                            &lt;tns1:CODICE_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&#xa;                            &lt;/tns1:CODICE_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ROW_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:NextVal&quot;/>&#xa;                        &lt;/tns1:ROW_ID>&#xa;                        &lt;tns1:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:CREATED_BY>&#xa;                        &lt;tns1:LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns1:LAST_UPD>&#xa;                        &lt;tns1:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:LAST_UPD_BY>&#xa;                        &lt;tns1:MODIFICATION_NUM>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:MODIFICATION_NUM>&#xa;                        &lt;tns1:CONFLICT_ID>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/tns1:CONFLICT_ID>&#xa;                        &lt;xsl:if test=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:AGGIUNTIVI[1]/tns:NUMERO&quot;>&#xa;                            &lt;tns1:DN>&#xa;                                &lt;xsl:value-of select=&quot;$Attivazione-VariazioneWLR/tns:SERVIZIO/tns:WLR/tns:ATT_VAR_ACCESSO/tns:AGGIUNTIVI[1]/tns:NUMERO&quot;/>&#xa;                            &lt;/tns1:DN>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:RESPONSE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:RESPONSE>&#xa;                        &lt;tns1:TRANSACTION_ID>&#xa;                            &lt;xsl:value-of select=&quot;$CessazioneWLR/tns:TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns1:TRANSACTION_ID>&#xa;                        &lt;tns1:RESPONSE_DATE>&#xa;                            &lt;xsl:value-of select=&quot;$CessazioneWLR/tns:TRANSACTION_DATE&quot;/>&#xa;                        &lt;/tns1:RESPONSE_DATE>&#xa;                        &lt;tns1:RETURN_CODE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:RETURN_CODE>&#xa;                        &lt;xsl:if test=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CRMWS_SERVICE&quot;>&#xa;                            &lt;tns1:COD_SRVZ>&#xa;                                &lt;xsl:value-of select=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CRMWS_SERVICE&quot;/>&#xa;                            &lt;/tns1:COD_SRVZ>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:CREATED>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns1:CREATED>&#xa;                        &lt;xsl:if test=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CESSAZIONE/tns:ID_CRMWS&quot;>&#xa;                            &lt;tns1:ID_ASSET_CRMWS>&#xa;                                &lt;xsl:value-of select=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CESSAZIONE/tns:ID_CRMWS&quot;/>&#xa;                            &lt;/tns1:ID_ASSET_CRMWS>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ID_ASSET_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CESSAZIONE/tns:ID_NOW&quot;/>&#xa;                        &lt;/tns1:ID_ASSET_NOW>&#xa;                        &lt;xsl:if test=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CESSAZIONE/tns:CODICEORDINEOLO&quot;>&#xa;                            &lt;tns1:ID_ORDN>&#xa;                                &lt;xsl:value-of select=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CESSAZIONE/tns:CODICEORDINEOLO&quot;/>&#xa;                            &lt;/tns1:ID_ORDN>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CESSAZIONE/tns:RISORSA&quot;>&#xa;                            &lt;tns1:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$CessazioneWLR/tns:SERVIZIO/tns:WLR/tns:CESSAZIONE/tns:RISORSA&quot;/>&#xa;                            &lt;/tns1:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;'CESSAZIONE'&quot;/>&#xa;                        &lt;/tns1:LAVRZ>&#xa;                        &lt;tns1:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tib:render-xml($CessazioneWLR, true(),true())&quot;/>&#xa;                        &lt;/tns1:MESSAGGIO>&#xa;                        &lt;tns1:STATO>&#xa;                            &lt;xsl:value-of select=&quot;'DA LAVORARE'&quot;/>&#xa;                        &lt;/tns1:STATO>&#xa;                        &lt;xsl:if test=&quot;$Start/tns1:CODE_OLO&quot;>&#xa;                            &lt;tns1:CODICE_OLO>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:CODE_OLO&quot;/>&#xa;                            &lt;/tns1:CODICE_OLO>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:ROW_ID>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns1:NextVal&quot;/>&#xa;                        &lt;/tns1:ROW_ID>&#xa;                        &lt;tns1:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:CREATED_BY>&#xa;                        &lt;tns1:LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/tns1:LAST_UPD>&#xa;                        &lt;tns1:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;'Null'&quot;/>&#xa;                        &lt;/tns1:LAST_UPD_BY>&#xa;                        &lt;tns1:MODIFICATION_NUM>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:MODIFICATION_NUM>&#xa;                        &lt;tns1:CONFLICT_ID>&#xa;                            &lt;xsl:value-of select=&quot;'0'&quot;/>&#xa;                        &lt;/tns1:CONFLICT_ID>&#xa;                    &lt;/tns1:RESPONSE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:RESPONSE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
