rov>&lt;xsl:value-of select=&quot;tns3:SIGLA_PROV&quot;/>&lt;/tns1:SiglaProv>&lt;tns1:CodISTATProv>&lt;xsl:value-of select=&quot;tns3:COD_ISTAT_PROV&quot;/>&lt;/tns1:CodISTATProv>&lt;tns1:DescrProv>&lt;xsl:value-of select=&quot;tns3:DESCR_PROV&quot;/>&lt;/tns1:DescrProv>&lt;tns1:Cod_Topon>&lt;xsl:value-of select=&quot;tns3:COD_TOPON&quot;/>&lt;/tns1:Cod_Topon>&lt;xsl:if test=&quot;tns3:COD_COMUNE&quot;>&lt;tns1:Cod_Comune>&lt;xsl:value-of select=&quot;tns3:COD_COMUNE&quot;/>&lt;/tns1:Cod_Comune>&lt;/xsl:if>&lt;/tns1:RecordAsset>&lt;/xsl:for-each>&lt;/xsl:if>&lt;tns1:CODE_OLO>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoULLLNAIn/Input/tns:REQUEST/tns:SERVIZIO/tns:CODICE_OLO&quot;/>&lt;/tns1:CODE_OLO>&lt;/tns1:REQUEST>&lt;/xsl:template>&lt;/xsl:stylesheet>"
