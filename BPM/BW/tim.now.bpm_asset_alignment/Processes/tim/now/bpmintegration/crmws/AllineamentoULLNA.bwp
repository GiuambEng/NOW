                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/InsertOGG" xmlns:tns4="http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping" xmlns:tns5="http://www.tim.com/NOW/xsd/InsertOGG" xmlns:tns2="http://www.tim.com/NOW/xsd/SequenceOGG" version="2.0"&gt;&lt;xsl:param name="NOWtoCRMWS_AllineamentoULLLNAIn"/&gt;&lt;xsl:param name="ProcessDynamic"/&gt;&lt;xsl:param name="SequenceOGG"/&gt;&lt;xsl:template name="InsertOGG-input" match="/"&gt;&lt;tns1:InsertOGGRequest&gt;&lt;Input&gt;&lt;tns5:Record&gt;&lt;xsl:for-each select="$ProcessDynamic/tns4:RESPONSE"&gt;&lt;tns5:Record&gt;&lt;xsl:if test="tns4:COD_SRVZ"&gt;&lt;tns5:COD_SRVZ&gt;&lt;xsl:value-of select="tns4:COD_SRVZ"/&gt;&lt;/tns5:COD_SRVZ&gt;&lt;/xsl:if&gt;&lt;tns5:CREATED&gt;&lt;xsl:value-of select="tns4:CREATED"/&gt;&lt;/tns5:CREATED&gt;&lt;xsl:if test="tns4:ID_ASSET_CRMWS"&gt;&lt;tns5:ID_ASSET_CRMWS&gt;&lt;xsl:value-of select="tns4:ID_ASSET_CRMWS"/&gt;&lt;/tns5:ID_ASSET_CRMWS&gt;&lt;/xsl:if&gt;&lt;tns5:ID_ASSET_NOW&gt;&lt;xsl:value-of select="tns4:ID_ASSET_NOW"/&gt;&lt;/tns5:ID_ASSET_NOW&gt;&lt;xsl:if test="tns4:ID_ORDN"&gt;&lt;tns5:ID_ORDN&gt;&lt;xsl:value-of select="tns4:ID_ORDN"/&gt;&lt;/tns5:ID_ORDN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:ID_RISORSA"&gt;&lt;tns5:ID_RISORSA&gt;&lt;xsl:value-of select="tns4:ID_RISORSA"/&gt;&lt;/tns5:ID_RISORSA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:LAVRZ"&gt;&lt;tns5:LAVRZ&gt;&lt;xsl:value-of select="tns4:LAVRZ"/&gt;&lt;/tns5:LAVRZ&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:MESSAGGIO"&gt;&lt;tns5:MESSAGGIO&gt;&lt;xsl:value-of select="tns4:MESSAGGIO"/&gt;&lt;/tns5:MESSAGGIO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:STATO"&gt;&lt;tns5:STATO&gt;&lt;xsl:value-of select="tns4:STATO"/&gt;&lt;/tns5:STATO&gt;&lt;/xsl:if&gt;&lt;tns5:TRANSACTION_ID&gt;&lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT)&gt;0"&gt;&lt;xsl:if test="$SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT"&gt;&lt;tns5:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="$SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT"/&gt;&lt;/tns5:TRANSACTION_ID_PARENT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:TRANSACTION_ID_PARENT&gt;&lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID_PARENT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length($SequenceOGG/Output/tns2:Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT)&gt;0"&gt;&lt;xsl:if test="tns4:TRANSACTION_ID_ROOT"&gt;&lt;tns5:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="tns4:TRANSACTION_ID_ROOT"/&gt;&lt;/tns5:TRANSACTION_ID_ROOT&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:TRANSACTION_ID_ROOT&gt;&lt;xsl:value-of select="tns4:TRANSACTION_ID"/&gt;&lt;/tns5:TRANSACTION_ID_ROOT&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="tns4:CODICE_OLO"&gt;&lt;tns5:CODICE_OLO&gt;&lt;xsl:value-of select="tns4:CODICE_OLO"/&gt;&lt;/tns5:CODICE_OLO&gt;&lt;/xsl:if&gt;&lt;tns5:ROW_ID&gt;&lt;xsl:value-of select="tns4:ROW_ID"/&gt;&lt;/tns5:ROW_ID&gt;&lt;xsl:if test="tns4:CREATED_BY"&gt;&lt;tns5:CREATED_BY&gt;&lt;xsl:value-of select="tns4:CREATED_BY"/&gt;&lt;/tns5:CREATED_BY&gt;&lt;/xsl:if&gt;&lt;tns5:LAST_UPD&gt;&lt;xsl:value-of select="tns4:LAST_UPD"/&gt;&lt;/tns5:LAST_UPD&gt;&lt;xsl:if test="tns4:LAST_UPD_BY"&gt;&lt;tns5:LAST_UPD_BY&gt;&lt;xsl:value-of select="tns4:LAST_UPD_BY"/&gt;&lt;/tns5:LAST_UPD_BY&gt;&lt;/xsl:if&gt;&lt;tns5:MODIFICATION_NUM&gt;&lt;xsl:value-of select="tns4:MODIFICATION_NUM"/&gt;&lt;/tns5:MODIFICATION_NUM&gt;&lt;tns5:CONFLICT_ID&gt;&lt;xsl:value-of select="tns4:CONFLICT_ID"/&gt;&lt;/tns5:CONFLICT_ID&gt;&lt;xsl:if test="tns4:DB_LAST_UPD"&gt;&lt;tns5:DB_LAST_UPD&gt;&lt;xsl:value-of select="tns4:DB_LAST_UPD"/&gt;&lt;/tns5:DB_LAST_UPD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:DB_LAST_UPD_SRC"&gt;&lt;tns5:DB_LAST_UPD_SRC&gt;&lt;xsl:value-of select="tns4:DB_LAST_UPD_SRC"/&gt;&lt;/tns5:DB_LAST_UPD_SRC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns4:DN"&gt;&lt;tns5:DN&gt;&lt;xsl:value-of select="tns4:DN"/&gt;&lt;/tns5:DN&gt;&lt;/xsl:if&gt;&lt;/tns5:Record&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$NOWtoCRMWS_AllineamentoULLLNAIn/Input/tns:REQUEST/tns:ASSETPRINCIPALE/IDRichiestaOLO"&gt;&lt;tns5:Id_rich_olo&gt;&lt;xsl:value-of select="$NOWtoCRMWS_AllineamentoULLLNAIn/Input/tns:REQUEST/tns:ASSETPRINCIPALE/IDRichiestaOLO"/&gt;&lt;/tns5:Id_rich_olo&gt;&lt;/xsl:if&gt;&lt;/tns5:Record&gt;&lt;/Input&gt;&lt;/tns1:InsertOGGRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertOGG&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenzaOGGDynamicMapping&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/InsertOGG&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SequenceOGG&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoULLLNAIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SequenceOGG.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessDynamic&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertOGG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Record>&#xa;            &lt;xsl:for-each select=&quot;$ProcessDynamic/tns4:RESPONSE&quot;>&#xa;                &lt;tns5:Record>&#xa;                    &lt;xsl:if test=&quot;tns4:COD_SRVZ&quot;>&#xa;                        &lt;tns5:COD_SRVZ>&#xa;                            &lt;xsl:value-of select=&quot;tns4:COD_SRVZ&quot;/>&#xa;                        &lt;/tns5:COD_SRVZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:CREATED>&#xa;                        &lt;xsl:value-of select=&quot;tns4:CREATED&quot;/>&#xa;                    &lt;/tns5:CREATED>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_ASSET_CRMWS&quot;>&#xa;                        &lt;tns5:ID_ASSET_CRMWS>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ID_ASSET_CRMWS&quot;/>&#xa;                        &lt;/tns5:ID_ASSET_CRMWS>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:ID_ASSET_NOW>&#xa;                        &lt;xsl:value-of select=&quot;tns4:ID_ASSET_NOW&quot;/>&#xa;                    &lt;/tns5:ID_ASSET_NOW>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_ORDN&quot;>&#xa;                        &lt;tns5:ID_ORDN>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ID_ORDN&quot;/>&#xa;                        &lt;/tns5:ID_ORDN>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:ID_RISORSA&quot;>&#xa;                        &lt;tns5:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;tns4:ID_RISORSA&quot;/>&#xa;                        &lt;/tns5:ID_RISORSA>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:LAVRZ&quot;>&#xa;                        &lt;tns5:LAVRZ>&#xa;                            &lt;xsl:value-of select=&quot;tns4:LAVRZ&quot;/>&#xa;                        &lt;/tns5:LAVRZ>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:MESSAGGIO&quot;>&#xa;                        &lt;tns5:MESSAGGIO>&#xa;                            &lt;xsl:value-of select=&quot;tns4:MESSAGGIO&quot;/>&#xa;                        &lt;/tns5:MESSAGGIO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:STATO&quot;>&#xa;                        &lt;tns5:STATO>&#xa;                            &lt;xsl:value-of select=&quot;tns4:STATO&quot;/>&#xa;                        &lt;/tns5:STATO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns4:TRANSACTION_ID&quot;/>&#xa;                    &lt;/tns5:TRANSACTION_ID>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT&quot;>&#xa;                                &lt;tns5:TRANSACTION_ID_PARENT>&#xa;                                    &lt;xsl:value-of select=&quot;$SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_PARENT&quot;/>&#xa;                                &lt;/tns5:TRANSACTION_ID_PARENT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:TRANSACTION_ID_PARENT>&#xa;                                &lt;xsl:value-of select=&quot;tns4:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns5:TRANSACTION_ID_PARENT>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SequenceOGG.Output/tns2:Record[1]/tns2:TRANSACTION_ID_ROOT)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;tns4:TRANSACTION_ID_ROOT&quot;>&#xa;                                &lt;tns5:TRANSACTION_ID_ROOT>&#xa;                                    &lt;xsl:value-of select=&quot;tns4:TRANSACTION_ID_ROOT&quot;/>&#xa;                                &lt;/tns5:TRANSACTION_ID_ROOT>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:TRANSACTION_ID_ROOT>&#xa;                                &lt;xsl:value-of select=&quot;tns4:TRANSACTION_ID&quot;/>&#xa;                            &lt;/tns5:TRANSACTION_ID_ROOT>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;tns4:CODICE_OLO&quot;>&#xa;                        &lt;tns5:CODICE_OLO>&#xa;                            &lt;xsl:value-of select=&quot;tns4:CODICE_OLO&quot;/>&#xa;                        &lt;/tns5:CODICE_OLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:ROW_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns4:ROW_ID&quot;/>&#xa;                    &lt;/tns5:ROW_ID>&#xa;                    &lt;xsl:if test=&quot;tns4:CREATED_BY&quot;>&#xa;                        &lt;tns5:CREATED_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns4:CREATED_BY&quot;/>&#xa;                        &lt;/tns5:CREATED_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:LAST_UPD>&#xa;                        &lt;xsl:value-of select=&quot;tns4:LAST_UPD&quot;/>&#xa;                    &lt;/tns5:LAST_UPD>&#xa;                    &lt;xsl:if test=&quot;tns4:LAST_UPD_BY&quot;>&#xa;                        &lt;tns5:LAST_UPD_BY>&#xa;                            &lt;xsl:value-of select=&quot;tns4:LAST_UPD_BY&quot;/>&#xa;                        &lt;/tns5:LAST_UPD_BY>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:MODIFICATION_NUM>&#xa;                        &lt;xsl:value-of select=&quot;tns4:MODIFICATION_NUM&quot;/>&#xa;                    &lt;/tns5:MODIFICATION_NUM>&#xa;                    &lt;tns5:CONFLICT_ID>&#xa;                        &lt;xsl:value-of select=&quot;tns4:CONFLICT_ID&quot;/>&#xa;                    &lt;/tns5:CONFLICT_ID>&#xa;                    &lt;xsl:if test=&quot;tns4:DB_LAST_UPD&quot;>&#xa;                        &lt;tns5:DB_LAST_UPD>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DB_LAST_UPD&quot;/>&#xa;                        &lt;/tns5:DB_LAST_UPD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:DB_LAST_UPD_SRC&quot;>&#xa;                        &lt;tns5:DB_LAST_UPD_SRC>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DB_LAST_UPD_SRC&quot;/>&#xa;                        &lt;/tns5:DB_LAST_UPD_SRC>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns4:DN&quot;>&#xa;                        &lt;tns5:DN>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DN&quot;/>&#xa;                        &lt;/tns5:DN>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:Record>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoULLLNAIn.Input/tns:ASSETPRINCIPALE/IDRichiestaOLO&quot;>&#xa;                &lt;tns5:Id_rich_olo>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoULLLNAIn.Input/tns:ASSETPRINCIPALE/IDRichiestaOLO&quot;/>&#xa;                &lt;/tns5:Id_rich_olo>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:Record>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogProcessDynamicToInsertOGG"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertOGGToLogInsertOGG"/>
                    <bpws:source linkName="InsertOGGToCallProcess2"
                        tibex:faultDetailsVar="InsertOGG" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoULLLNAIn&quot;/>&lt;xsl:param name=&quot;ProcessDynamic&quot;/>&lt;xsl:template name=&quot;LogProcessDynamic-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;AllineamentoULLNA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;NOWtoCRMWS_AllineamentoConsistenzaOGG&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;NOWtoCRMWS_AllineamentoULLNA&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoULLLNAIn/Input/tns1:REQUEST/tns1:ASSETPRINCIPALE/IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoULLLNAIn/Input/tns1:REQUEST/tns1:ASSETPRINCIPALE/IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;ProcessDynamic&amp;quot;,tib:render-xml($ProcessDynamic, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices/>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogProcessDynamic-input"
                    name="LogProcessDynamic"
                    tibex:xpdlId="cae631f6-3547-4caf-9c5c-8b855692b53e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ProcessDynamicToLogProcessDynamic"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogProcessDynamicToInsertOGG"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWSAllineamentoConsistenza&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_AllineamentoULLLNAIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ProcessDynamic&quot;/>&#xa;    &lt;xsl:template name=&quot;LogProcessDynamic-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpm_asset_alignment.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AllineamentoULLNA&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOWtoCRMWS_AllineamentoConsistenzaOGG&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOWtoCRMWS_AllineamentoULLNA&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$NOWtoCRMWS_AllineamentoULLLNAIn.Input/tns1:ASSETPRINCIPALE/IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$NOWtoCRMWS_AllineamentoULLLNAIn.Input/tns1:ASSETPRINCIPALE/IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;ProcessDynamic&amp;quot;,tib:render-xml($ProcessDynamic, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices/>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
