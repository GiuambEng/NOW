                    <bpws:targets>
                        <bpws:target linkName="StatoToProcessDynamic"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ProcessDynamicToLogProcessDynamic"/>
                        <bpws:source
                            linkName="ProcessDynamicToCallProcess1"
                            tibex:faultDetailsVar="ProcessDynamic" tibex:faultNameVar="FaultName">
