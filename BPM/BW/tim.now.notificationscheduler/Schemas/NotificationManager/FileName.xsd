<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/FileName" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/FileName">

    <element name="FileNameResponse">
    	<complexType>
    		<sequence>
    			<element name="FileName" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FileNameAQ" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FileNameCPS" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="FileNameRequest">
    	<complexType>
    		<sequence>
    			<element name="TempoNotifica" type="string"></element>
    			<element name="StrutturaRichiesta" type="string"></element>
    			<element name="Lavorazione" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CodiceOLO" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CodiceOLOAGCOM" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="ProcessIstanceID" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="NomeFileCPS" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FlagNP_103" type="string" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="ContenutoFile">
    	<complexType>
    		<sequence>
    			<element name="ContenutoFile" type="string" maxOccurs="1" minOccurs="0"></element>
    			<element name="ContenutoFileAQ" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
</schema>