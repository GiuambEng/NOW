<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http:///www.tim.com/NOW/xsd/SendFile" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http:///www.tim.com/NOW/xsd/SendFile">
    <element name="SendFileRequest">
    	<complexType>
    		<sequence>
    			<element name="CodiceOLO" type="string"></element>
    			<element name="CodiceOLOAGCOM" type="string"></element>
    			<element name="IDInterfaccia" type="int"></element>
                <element name="StrutturaRichiesta" type="string"></element>
                <element name="IDProcsoFile" type="string"></element>
    			<element name="DatiPutFile">
    				<complexType>
    					<sequence>
    						<element name="PathFile" type="string"></element>
    						<element name="RemotePath" type="string"></element>
    						<element name="Host" type="string"></element>
    						<element name="Port" type="int"></element>
    						<element name="User" type="string"></element>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="SendFileResponse" type="string"></element>
    <element name="SendFileFault" type="string"></element>
    <element name="SendFileTappoRequest">
    	<complexType>
    		<sequence>
    			<element maxOccurs="1" minOccurs="1" name="FileToBeSend" type="string"/>
    			<element maxOccurs="1" minOccurs="1" name="RomoteDirectory" type="string"/>
                <element name="Credentials">
    				<complexType>
    					<sequence>
				   			<element maxOccurs="1" minOccurs="1" name="Host" type="string"/>
				   			<element maxOccurs="1" minOccurs="1" name="Port" type="int"/>
				   			<element maxOccurs="1" minOccurs="1" name="User" type="string"/>
				   			<element maxOccurs="1" minOccurs="0" name="Password" type="string"/>
				   			
                        </sequence>
    				</complexType>
    			</element>
            </sequence>
    	</complexType>
    </element>
</schema>