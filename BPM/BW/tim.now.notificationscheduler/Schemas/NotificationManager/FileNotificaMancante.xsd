<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/FileNotificaMancante" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/FileNotificaMancante">
 <element name="FileNotificaMancanteRequest">
    	<complexType>
    		<sequence>
    			<element name="TempoNotifica" type="string" />
    			<element name="StrutturaRichiesta" type="string" />
    			<element maxOccurs="1" minOccurs="0" name="Lavorazione"
    				type="string" />
    			<element name="FileName" type="string" />
                <element name="PathFile" type="string"></element>
                <element maxOccurs="1" minOccurs="0" name="TipoFile"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0" name="CodiceOLO"
    				type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="CodiceOLOAGCOM" type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="FlagNamespaceFileNotifica" type="string" />
    			<element maxOccurs="1" minOccurs="0"
    				name="ProcessIstanceID" type="string" />
    		</sequence>
    	</complexType>
    </element>
    <element name="FileNotificaMancanteResponse">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string"/>
            </sequence>
    	</complexType>
    </element>
    <element name="NumeroFile">
    	<complexType>
    		<sequence>
    			<element name="NumeroFile" type="integer"/>
            </sequence>
    	</complexType>
    </element>
    <element name="Duration">
    	<complexType>
    		<sequence>
    			<element name="Duration" type="duration"/>
            </sequence>
    	</complexType>
    </element>
</schema>
