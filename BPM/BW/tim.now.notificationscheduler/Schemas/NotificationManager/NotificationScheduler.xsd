<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/NotificationScheduler" elementFormDefault="qualified" targetNamespace="http://www.tim.com/NOW/xsd/NotificationScheduler">

    <element name="Record">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="RecordNotifiche">
    				<complexType>
    					<sequence>
    						<element name="CodiceOLO" type="string"/>
    						<element name="CodiceOLOAGCOM" type="string"/>
                            <element name="IDNotifica" type="decimal"/>
                            <element name="TipologiaNotifica" type="string"/>
    						<element name="IDRichiestaOLO" type="string"/>
    						<element name="TimestampNotifica" type="dateTime"/>
    						<element name="StrutturaRichiesta" type="string"/>
    						<element name="TracciatoFile" type="string"/>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="SchedulerOutput" type="string"/>

    <element name="SchedulerInput">
    	<complexType>
    		<sequence>
    			<element name="TempoNotifica" type="string"/>
    			<element name="StrutturaRichiesta" type="string"/>
    			<element name="CodiceOLO" type="string"/>
    			<element name="CodiceOLOAGCOM" type="string"/>
    			<element minOccurs="0" name="FlagNamespaceFileNotifica" type="string"/>
    			<element maxOccurs="1" minOccurs="0" name="LocalPath" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="NomeFileCPS" type="string">
    			</element>
    			<element maxOccurs="1" minOccurs="0" name="NomeFileNPNG" type="string">
    			</element>
    			<element minOccurs="0" name="FlagNP103" type="string"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="SchedulerFault" type="string"/>

    <element name="NumeroNotificheGeneriche">
    	<complexType>
    		<sequence>
    			<element name="NumeroNotifiche" type="tns:NumeroNotificheType"/>
    			<element name="NumeroNotificheAQ" type="tns:NumeroNotificheType"/>
    		</sequence>
    	</complexType>
    </element>
    <complexType name="NumeroNotificheType">
    	<sequence>
    		<element name="NotificheTotali" type="int"/>
    		<element name="NotificheOK" type="int"/>
    		<element name="NoticheKO" type="int"/>
    		<element name="NotificheIntermedie" type="int"/>
    		<element name="NotificheMigrazioni" type="int"/>
    		<element maxOccurs="unbounded" minOccurs="0" name="IDNotifica" type="int"/>
    	</sequence>
    </complexType>

    <element name="IDNotifiche">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="IDNotifiche" type="int"/>

    		</sequence>
    	</complexType>
    </element>
    <element name="Notifiche">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="Notifiche" type="string"/>
    		</sequence>
    	</complexType>
    </element>
    <element name="TimetoSecond">
    	<complexType>
    		<sequence>
    			<element name="OraInvio" type="int"/>
    			<element name="MinutiInvio" type="int"/>
    			<element name="OraStart" type="int"/>
    			<element name="MinutiStart" type="int"/>
    			<element name="OraEnd" type="int"/>
    			<element name="MinutiEnd" type="int"/>
    		</sequence>
    	</complexType>
    </element>

    <element name="ContenutoXML">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="ContenutoXML">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="ContenutoXML" type="string">
    						</element>
    						<element maxOccurs="1" minOccurs="0" name="IDNotifica" type="int"/>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>

    <element name="NumeriTelefonici">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="NumeriTelefonici">
    				<complexType>
    					<sequence>
    						<element maxOccurs="1" minOccurs="0" name="CognomeReferente" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="NomeReferente" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="TelefonoFissoReferente" type="string"/>
    						<element maxOccurs="1" minOccurs="0" name="TelefonoMobileReferente" type="string"/>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
    </element>
    <element name="operationRequest">
    <complexType>
      <sequence>
        <element name="in" type="string"/>
      </sequence>
    </complexType>
  </element>
  <element name="OrariCPS">
    	<complexType>
    		<sequence>
    			<element maxOccurs="unbounded" minOccurs="0" name="OrariCPS">
    				<complexType>
    					<sequence>
    						<element name="Ora" type="string"/>
    					</sequence>
    				</complexType>
    			</element>
    		</sequence>
    	</complexType>
   </element>
</schema>
