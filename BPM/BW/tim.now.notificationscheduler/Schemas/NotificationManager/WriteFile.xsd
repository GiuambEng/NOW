<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/WriteFile" elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/WriteFile">

    <element name="WriteFileRequest">
    	<complexType>
    		<sequence>
    			<element name="FileName" type="string"></element>
    			<element name="Notifiche" type="string"></element>
    			<element name="CodiceOLO" type="string"></element>
    			<element name="CodiceOLOAGCOM" type="string"></element>
    			<element name="StrutturaRichiesta" type="string"></element>
                <element name="NumeroRecord" type="int"></element>
                <element name="IDInterfaccia" type="int"></element>
    			<element name="IDTipologiaFile" type="int"></element>
    			<element name="IDProcsoFile" type="string"></element>
    		</sequence>
    	</complexType>
    </element>
    
    <element name="WriteFileResponse">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string"></element>
    			<element name="IDFile" type="int" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>

    <element name="WriteFileFault" type="string"></element>
      <element name="ZipFileRequest">
    	<complexType>
    		<sequence>
    			<element name="FullName" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="FileName" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Size" type="int" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="CodiceOLO" type="string"></element>
    			<element name="CodiceOLOAGCOM" type="string"></element>
    			<element name="StrutturaRichiesta" type="string"></element>
    			<element name="NumeroRecord" type="int"></element>
    			<element name="IDInterfaccia" type="int"></element>
    			<element name="IDTipologiaFile" type="int"></element>
    			<element name="IDProcsoFile" type="string"></element>
    			<element name="ProcessIstanceID" type="string"
    				maxOccurs="1" minOccurs="0">
    			</element>
    			<element name="FullNameCPS" type="string" maxOccurs="1"
    				minOccurs="0">
    			</element>
    			<element name="Tokenizzazione" type="string" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="ZipFileResponse">
    	<complexType>
    		<sequence>
    			<element name="Esito" type="string"></element>
    			<element name="IDFile" type="int" maxOccurs="1" minOccurs="0"></element>
    		</sequence>
    	</complexType>
    </element>
    <element name="ZipFileFault" type="string"></element>
    <element name="QuerySistemaIPInterfacciaOutput" type="string"></element>
</schema>