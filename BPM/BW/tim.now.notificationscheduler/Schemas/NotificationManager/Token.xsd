<?xml version="1.0" encoding="UTF-8"?>
<schema targetNamespace="http://www.tim.com/NOW/xsd/Token/"
	elementFormDefault="qualified" xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.tim.com/NOW/xsd/Token/"
	xmlns:pref="http://www.tim.com/NOW/xsd/NOW_SECOLO/" xmlns:pref1="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/">

	<import schemaLocation="NOW_SECOLO.xsd"
		namespace="http://www.tim.com/NOW/xsd/NOW_SECOLO/">
	</import>
	<import schemaLocation="NOW_SECOLO_ROLLOUT.xsd" namespace="http://www.tim.com/NOW/xsd/NOW_SECOLO_ROLLOUT/"></import>
	<element name="Request">
		<complexType>
			<sequence>
				<element name="RequestVerificaRollout" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="CodificaOLOAGCOM"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="CodificaOloNumerico"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="Offerta" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="Lavorazione" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="CodiceIstatComune"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="FlagReferente" minOccurs="0"
								maxOccurs="1" type="boolean" />
						</sequence>
					</complexType>
				</element>
				<element name="RequestCreate_token" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="CodificaOLOAGCOM"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="CodiceOrdineOLO"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="Funzione" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="ChiaveRiferimento"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="Operatore" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="IPClient" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="N_Recap_Cliente"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="N_Recap_Cliente_ALT"
								minOccurs="0" maxOccurs="1" type="string" />
								<element name="Note" type="string" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
				<element name="RequestDecode_token" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="CodificaOLOAGCOM"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="CodiceOrdineOLO"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="Funzione" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="ChiaveRiferimento"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="Operatore" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="IPClient" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="Token" minOccurs="0"
								maxOccurs="1" type="string" />
						</sequence>

					</complexType>
				</element>
				<element name="ProcessIstance" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>


	<element name="Response">
		<complexType>
			<sequence>
				<element name="ResponseCreate_token" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="Token" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="ESITO" minOccurs="1"
								maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="2" />
										<enumeration value="OK" />
										<enumeration value="KO" />
									</restriction>
								</simpleType>
							</element>
							<element name="DESCRIZIONE" minOccurs="0"
								maxOccurs="1" type="string" />
						</sequence>
					</complexType>
				</element>
				<element name="ResponseDecode_token" maxOccurs="1"
					minOccurs="0">
					<complexType>
						<sequence>
							<element name="ESITO" minOccurs="1"
								maxOccurs="1">
								<simpleType>
									<restriction base="string">
										<maxLength value="2" />
										<enumeration value="OK" />
										<enumeration value="KO" />
									</restriction>
								</simpleType>
							</element>
							<element name="DESCRIZIONE" minOccurs="0"
								maxOccurs="1" type="string" />
							<element name="N_Recap_Cliente"
								minOccurs="0" maxOccurs="1" type="string" />
							<element name="N_Recap_Cliente_ALT"
								minOccurs="0" maxOccurs="1" type="string" />
								<element name="Note" type="string" minOccurs="0"/>
						</sequence>
					</complexType>
				</element>
				<element name="Rollout" type="string" maxOccurs="1" minOccurs="0"></element>
			</sequence>
		</complexType>
	</element>
</schema>