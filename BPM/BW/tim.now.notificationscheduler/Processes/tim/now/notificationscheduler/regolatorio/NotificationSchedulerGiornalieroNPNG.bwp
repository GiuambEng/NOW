                                </bpws:targets>
                            </bpws:empty>
                            <bpws:invoke inputVariable="Invoke1-input"
                                name="Invoke1" operation="NPNGScheduler"
                                partnerLink="NPNGSchedulerPortType"
                                portType="ns0:NPNGSchedulerPortType" tibex:xpdlId="b586d809-db92-469a-bc1c-7e38d9515802">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" version="2.0"&gt;&lt;xsl:param name="JDBCQueryFiles"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="JDBCQueryOLO"/&gt;&lt;xsl:template name="Invoke1-input" match="/"&gt;&lt;tns:NPNGSchedulerRequest&gt;&lt;SchedulerInput&gt;&lt;tns1:SchedulerInput&gt;&lt;tns1:TempoNotifica&gt;&lt;xsl:value-of select="&amp;quot;GIORNALIERO&amp;quot;"/&gt;&lt;/tns1:TempoNotifica&gt;&lt;tns1:StrutturaRichiesta&gt;&lt;xsl:value-of select="'NPNG'"/&gt;&lt;/tns1:StrutturaRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$JDBCQueryOLO/Record[$index]/COD_OLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;tns1:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$JDBCQueryOLO/Record[$index]/CODFC_OLO_AGCOM"/&gt;&lt;/tns1:CodiceOLOAGCOM&gt;&lt;xsl:if test="$JDBCQueryFiles/Record[substring(NOME_FILE,12,3)=$JDBCQueryOLO/Record[$index][1]/CODFC_OLO_AGCOM]/LOCAL_PATH"&gt;&lt;tns1:LocalPath&gt;&lt;xsl:value-of select="$JDBCQueryFiles/Record[substring(NOME_FILE,12,3)=$JDBCQueryOLO/Record[$index][1]/CODFC_OLO_AGCOM]/LOCAL_PATH"/&gt;&lt;/tns1:LocalPath&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$JDBCQueryFiles/Record[substring(NOME_FILE,12,3)=$JDBCQueryOLO/Record[$index][1]/CODFC_OLO_AGCOM]/NOME_FILE"&gt;&lt;tns1:NomeFileNPNG&gt;&lt;xsl:value-of select="$JDBCQueryFiles/Record[substring(NOME_FILE,12,3)=$JDBCQueryOLO/Record[$index][1]/CODFC_OLO_AGCOM]/NOME_FILE"/&gt;&lt;/tns1:NomeFileNPNG&gt;&lt;/xsl:if&gt;&lt;/tns1:SchedulerInput&gt;&lt;/SchedulerInput&gt;&lt;/tns:NPNGSchedulerRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryFiles&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SchedulerInput>&#xa;            &lt;tns1:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GIORNALIERO&amp;quot;&quot;/>&#xa;            &lt;/tns1:TempoNotifica>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'NPNG'&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$JDBCQueryOLO/Record[$index]/COD_OLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$JDBCQueryOLO/Record[$index]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$JDBCQueryFiles/Record[substring(NOME_FILE,12,3)=$JDBCQueryOLO/Record[$index][1]/CODFC_OLO_AGCOM]/LOCAL_PATH&quot;>&#xa;                &lt;tns1:LocalPath>&#xa;                    &lt;xsl:value-of select=&quot;$JDBCQueryFiles/Record[substring(NOME_FILE,12,3)=$JDBCQueryOLO/Record[$index][1]/CODFC_OLO_AGCOM]/LOCAL_PATH&quot;/>&#xa;                &lt;/tns1:LocalPath>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$JDBCQueryFiles/Record[substring(NOME_FILE,12,3)=$JDBCQueryOLO/Record[$index][1]/CODFC_OLO_AGCOM]/NOME_FILE&quot;>&#xa;                &lt;tns1:NomeFileNPNG>&#xa;                    &lt;xsl:value-of selec