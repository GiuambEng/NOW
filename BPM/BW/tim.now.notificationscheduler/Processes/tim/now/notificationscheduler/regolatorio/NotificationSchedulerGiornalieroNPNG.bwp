            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryOLO-input"
                    name="JDBCQueryOLO" outputVariable="JDBCQueryOLO"
                    tibex:xpdlId="9599e741-d931-41ec-95b1-677b18ff6be4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToJDBCQueryOLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryOLOToLogJDBC_OLO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9599e741-d931-41ec-95b1-677b18ff6be4+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IDInterfacciaNPNG&quot;/>&lt;xsl:param name=&quot;IDSistemaOLO&quot;/>&lt;xsl:template name=&quot;JDBCQueryOLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDInterfacciaREG>&lt;xsl:value-of select=&quot;$IDInterfacciaNPNG&quot;/>&lt;/IDInterfacciaREG>&lt;IDSistema>&lt;xsl:value-of select=&quot;$IDSistemaOLO&quot;/>&lt;/IDSistema>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
