                                <bpws:link name="JDBCUpdateToInvoke1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate1ToGroupEnd2" tibex:linkType="SUCCESS"/>
                            </bpws:links>
