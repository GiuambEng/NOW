                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;GenericLogger2-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'GenerazioneNotificaOrarioCPS'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'GenerazioneNotificaOrarioCPS'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'GenerazioneNotificaOrarioCPS'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Record trovato su TRACC_CRMWS_CPS' ,tib:render-xml($JDBCQuery, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Record non trovato su TRACC_CRMWS_CPS'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="63bcb051-7086-4dc2-8ba4-8461e273cb6d">
                <bpws:targets>
                    <bpws:target linkName="LogJDBC_OLOToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToGenericLogger1"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index1"
                        sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index1&lt;=count($JDBCQuery/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($JDBCQuery/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="WhileToJDBCUpdate1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdateToWhile" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart1ToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCUpdate1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="8540456f-a036-48f5-9ed5-892dc3145b19">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCUpdate"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd1"
                                tibex:group="groupEnd" tibex:xpdlId="57906c31-d61b-402b-b8f4-6706b660d6e3">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdate1ToGroupEnd1"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="4aa5c974-6305-440c-805e-5ee1e5a38add">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateToWhile"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="WhileToJDBCUpdate1"/>
                                </bpws:sources>
                                <bpws:variables>
                                    <bpws:variable name="index"
                                    sca-bpel:internal="true" type="xsd:int">
                                    <bpws:from>
                                    <bpws:literal>1</bpws:literal>
                                    </bpws:from>
                                    </bpws:variable>
                                </bpws:variables>
                                <bpws:sequence name="sequence"
                                    tibex:group="while" tibex:xpdlId="6dc6acd5-d73a-4c8b-92a1-8131d3e346a1">
                                    <bpws:empty name="GroupInit"
                                    tibex:group="groupInit" tibex:xpdlId="fb0f64fe-f285-414e-bd83-bfad8d22f522"/>
                                    <bpws:while name="while"
                                    tibex:counterName="index" tibex:xpdlId="4ea62d01-17be-4440-a2f6-291baf1ebd4e">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index &lt;= count($JDBC_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_OLO/Record)]]></bpws:condition>
                                    <bpws:flow name="flow1" tibex:xpdlId="e1e31af0-fb28-4bb9-a721-afa5b4aeb745">
                                    <bpws:links>
                                    <bpws:link
                                    name="InvokeToError" tibex:linkType="ERROR"/>
                                    <bpws:link
                                    name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="InvokeToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToInvoke" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="GroupStartToGroupEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    </bpws:links>
                                    <bpws:empty
                                    name="GroupStart"
                                    tibex:group="groupStart" tibex:xpdlId="c0a719bd-2948-4dd2-bb68-1dc7f8846239">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvoke">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="$JDBC_OLO/Record[$index]/CODFC_OLO_AGCOM=substring(substring-before($JDBCQuery/Record[$index1]/NOME_FILE, 'N_'),12,3)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$JDBC_OLO/Record[$index]/CODFC_OLO_AGCOM=substring(substring-before($JDBCQuery/Record[$index1]/NOME_FILE, 'N_'),12,3)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToGroupEnd">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    </bpws:empty>
                                    <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="53a6955b-39b9-428e-bd0a-d634408370b6">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    <bpws:target linkName="InvokeToGroupEnd"/>
                                    <bpws:target linkName="GroupStartToGroupEnd"/>
                                    </bpws:targets>
                                    </bpws:empty>
