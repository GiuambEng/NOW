                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_FILE,NOME_FILE,ID_ESEC,TIMSTP_INSMTO,FLAG_ELABORAZIONE,LOCAL_PATH&#xa;FROM TRACC_CRMWS_CPS&#xa;WHERE FLAG_ELABORAZIONE='N' AND FLAG_ORARIO='Y' ORDER BY TIMSTP_INSMTO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ESEC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="FLAG_ELABORAZIONE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DateTime"
                    name="Assign" outputVariable="DateTime"
