                                    name="PORT" nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="UTENZA" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema elementFormDefault="unqualified"
