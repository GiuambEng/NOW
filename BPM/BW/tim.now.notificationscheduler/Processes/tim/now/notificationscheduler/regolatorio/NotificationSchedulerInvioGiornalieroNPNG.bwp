                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[hours-from-dateTime($DateTimeAvvio)  = hours-from-dateTime($DateTimeInvioGiornalieroNPNG) and minutes-from-dateTime($DateTimeAvvio) = minutes-from-dateTime($DateTimeInvioGiornalieroNPNG)]]></bpws:transitionCondition>
