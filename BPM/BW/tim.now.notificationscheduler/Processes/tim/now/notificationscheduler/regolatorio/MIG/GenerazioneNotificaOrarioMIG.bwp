    xmlns:ns6="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+3c604ce6-7c89-4d6d-8817-6848bcaed70b"
    xmlns:ns7="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+7dc055e4-b383-4ab3-9ee8-7ba21c99c396"
    xmlns:ns8="http://www.tibco.com/namespaces/tnt/plugins/jms+af59545c-c076-4aa0-a888-c718dcd328a3+output"
    xmlns:sca="http://docs.oasis-open.org/ns/opencsa/sca/200912"
