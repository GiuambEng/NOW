                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="JDBC_OLO"/&gt;&lt;xsl:template name="RegolatorioMIGScheduler-input" match="/"&gt;&lt;tns:RegolatorioMIGSchedulerRequest&gt;&lt;SchedulerInput&gt;&lt;tns1:SchedulerInput&gt;&lt;tns1:TempoNotifica&gt;&lt;xsl:value-of select="&amp;quot;ORARIO&amp;quot;"/&gt;&lt;/tns1:TempoNotifica&gt;&lt;tns1:StrutturaRichiesta&gt;&lt;xsl:value-of select="&amp;quot;REGOLATORIO&amp;quot;"/&gt;&lt;/tns1:StrutturaRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/COD_OLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;tns1:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM"/&gt;&lt;/tns1:CodiceOLOAGCOM&gt;&lt;/tns1:SchedulerInput&gt;&lt;/SchedulerInput&gt;&lt;/tns:RegolatorioMIGSchedulerRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;RegolatorioMIGScheduler-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SchedulerInput>&#xa;            &lt;tns1:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORARIO&amp;quot;&quot;/>&#xa;            &lt;/tns1:TempoNotifica>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;REGOLATORIO&amp;quot;&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/COD_OLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;        &lt;/tns1:SchedulerInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
