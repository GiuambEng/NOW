                <bpws:sequence name="sequence" tibex:group="while" tibex:xpdlId="7371a6bc-f9a6-4920-ae60-50f0abf27489">
                    <bpws:empty name="GroupInit" tibex:group="groupInit" tibex:xpdlId="dac48a22-6746-4dc8-926c-34970f20d3ac"/>
                    <bpws:while name="while" tibex:counterName="index" tibex:xpdlId="7acd40ef-34c8-4728-8fe1-2376d3492b25">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBC_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_OLO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1" tibex:xpdlId="58cba4a2-d7ef-48db-a647-2ea0b3a25ad7">
                            <bpws:links>
