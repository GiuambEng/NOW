            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a1eed3a0-1dde-4f01-9010-f5a1c495f748">
                <bpws:targets>
                    <bpws:target linkName="FileNotificaMancanteToWhile"/>
                    <bpws:target linkName="IsConfermedAssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToWriteFile">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="(count($JDBC_ORARIO/Record) > 0 or count($JDBC_GIORNALIERO/Record) > 0) and (count($JDBC_ORARIO/Record) > count($NotificheErrate/ns5:IDNotifiche) or count($JDBC_GIORNALIERO/Record) > count($NotificheErrate/ns5:IDNotifiche))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[(count($JDBC_ORARIO/Record) > 0 or count($JDBC_GIORNALIERO/Record) > 0) and (count($JDBC_ORARIO/Record) > count($NotificheErrate/ns5:IDNotifiche) or count($JDBC_GIORNALIERO/Record) > count($NotificheErrate/ns5:IDNotifiche))]]></bpws:transitionCondition>
                    </bpws:source>
