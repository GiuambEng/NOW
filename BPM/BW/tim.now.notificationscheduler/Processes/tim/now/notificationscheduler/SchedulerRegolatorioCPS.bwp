            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;TestataNamespace&quot;/>&lt;xsl:param name=&quot;Namespace&quot;/>&lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&lt;xsl:param name=&quot;CodaNamespace&quot;/>&lt;xsl:param name=&quot;NotificheErrate&quot;/>&lt;xsl:param name=&quot;ReadFile&quot;/>&lt;xsl:param name=&quot;FileNameInvoke&quot;/>&lt;xsl:template name=&quot;WriteFile1-input&quot; match=&quot;/&quot;>&lt;tns:WriteActivityInputTextClass>&lt;xsl:if test=&quot;$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileName&quot;>&lt;fileName>&lt;xsl:value-of select=&quot;$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileName&quot;/>&lt;/fileName>&lt;/xsl:if>&lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns2:IDNotifiche/tns2:IDNotifiche&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReadFile) and contains($ReadFile/fileContent/textContent,'&amp;lt;/NotificaOloRegolatorio>')&quot;>&lt;textContent>&lt;xsl:value-of select=&quot;concat(substring-before($ReadFile/fileContent/textContent,'&amp;lt;/NotificaOloRegolatorio>'),tib:concat-sequence-format($JDBC_ORARIO/Record[not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;),'&amp;lt;/NotificaOloRegolatorio>')&quot;/>&lt;/textContent>&lt;/xsl:when>&lt;xsl:otherwise>&lt;textContent>&lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, tib:concat-sequence-format($JDBC_ORARIO/Record[not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&lt;/textContent>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ReadFile) and contains($ReadFile/fileContent/textContent,'&amp;lt;/NotificaOloRegolatorio>')&quot;>&lt;textContent>&lt;xsl:value-of select=&quot;concat(substring-before($ReadFile/fileContent/textContent,'&amp;lt;/NotificaOloRegolatorio>'),tib:concat-sequence-format($JDBC_GIORNALIERO/Record[not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;),'&amp;lt;/NotificaOloRegolatorio>')&quot;/>&lt;/textContent>&lt;/xsl:when>&lt;xsl:otherwise>&lt;textContent>&lt;xsl:value-of select=&quot;concat($TestataNamespace, $Namespace, tib:concat-sequence-format($JDBC_GIORNALIERO/Record[not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&lt;/textContent>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:WriteActivityInputTextClass>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
