                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+37b28cde-c24d-4197-a1c1-7f6cf8c43ffe" version="2.0"> <xsl:template name="NotificheErrate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="NotificheErrate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="if($RegolatorioSchedulerIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;) then $index &lt;= count($JDBC_ORARIO/Record) else $index &lt;= count($JDBC_GIORNALIERO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if($RegolatorioSchedulerIn.SchedulerInput/ns5:TempoNotifica = "ORARIO") then $index <= count($JDBC_ORARIO/Record) else $index <= count($JDBC_GIORNALIERO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="MapperIDToEmpty1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToParseXml" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCUpdateErroreToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ParseXmlToEmpty" tibex:linkType="SUCCESS"/>
                                <bpws:link name="ParseXmlToMapperID" tibex:linkType="ERROR"/>
                                <bpws:link name="EmptyToNotificheErrate" tibex:linkType="SUCCESSWITHNOCONDITION"/>
