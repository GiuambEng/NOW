                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+eb604866-7d5a-4b0e-9fe8-a1a6b56714b3+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_FILE_STANDARD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns2:IDNotifiche/tns2:IDNotifiche&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$JDBC_ORARIO/Record[not(ID_NOTF = $NotificheErrate)]&quot;>&#xa;                        &lt;Record>&#xa;                            &lt;IDFile>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($ZipFileInvoke/ZipFileOutput/tns5:ZipFileResponse/tns5:IDFile)&quot;>&#xa;                                        &lt;xsl:value-of select=&quot;$ZipFileInvoke/ZipFileOutput/tns5:ZipFileResponse/tns5:IDFile&quot;/>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:attribute name=&quot;x