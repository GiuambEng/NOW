            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+696599a4-3789-4277-aaf6-e676ea05a867+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_ORARIO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:StrutturaRichiesta&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;            &lt;Lavorazione1>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione1>&#xa;            &lt;Lavorazione2>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione2>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_ORARIO-input" name="JDBC_ORARIO"
                    outputVariable="JDBC_ORARIO"
                    tibex:xpdlId="696599a4-3789-4277-aaf6-e676ea05a867" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBC_ORARIO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_ORARIOToJDBCUpdate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBC_ORARIO/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBC_ORARIO/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCQueryToLOG_NessunaNotifica1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+696599a4-3789-4277-aaf6-e676ea05a867+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_ORARIO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:StrutturaRichiesta&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;            &lt;Lavorazione1>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;MIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione1>&#xa;            &lt;Lavorazione2>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;/>&#xa;            &lt;/Lavorazione2>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutScheduler"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOTF.COD_TIPOLG_NOTF, NOTF.ID_NOTF, NOTF.ID_RICH_OLO, STRUTTURA_RICH, NOTF.TIMSTP_CREAZIONE, NOTF.TRACCIATO_FILE, NOTF.CODFC_OLO_NOW, NOTF.CODFC_OLO_AGCOM&#xa;  FROM RICH_ORDN_COMUNIC_NOTF NOTF, OLO OLO&#xa;  WHERE STRUTTURA_RICH = ? AND IDTPLG_STNTF_FILE_ORARIO = '1' AND NOTF.CODFC_OLO_AGCOM = OLO.CODFC_OLO_AGCOM&#xa;  AND (OLO.CODFC_OLO_AGCOM = ? OR OLO.COD_OLO_ACCORPANTE = ?) AND (LAVORAZIONE IS NULL OR (LAVORAZIONE != ? AND LAVORAZIONE != ?)) ORDER BY CODFC_OLO_AGCOM ASC, ID_RICH_OLO ASC, TIMSTP_CREAZIONE ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="StrutturaRichiesta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodiceOLOAccorpante"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Lavorazione2"/>
                                    <columnMetadata
                                    columnName="COD_TIPOLG_NOTF"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_NOTF"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="STRUTTURA_RICH"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_CREAZIONE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="TRACCIATO_FILE"
                                    dataType="2005"
                                    status="OptionalElement" typeName="CLOB"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_NOW"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_FileName-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Nome file da creare:&amp;quot;, $FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileName)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_FileName-input"
                    name="LOG_FileName"
                    tibex:xpdlId="61b94b98-993a-4579-b00e-e778ce7ba6bf"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToLOG_FileNamee"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_FileNameeToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_FileName-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Nome file da creare:&amp;quot;, $FileNameInvoke.FileNameOutput/tns1:FileName)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="FileNameInvoke-input"
                name="FileNameInvoke" operation="FileName"
                outputVariable="FileNameInvoke" partnerLink="FileName"
                portType="ns21:FileNamePortType" tibex:xpdlId="884a857a-cddd-49dc-949c-10ac960f3d24">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/FileName/" xmlns:tns1="http://www.tim.com/NOW/xsd/FileName" version="2.0"&gt;
    &lt;xsl:param name="RegolatorioSchedulerIn"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:template name="FileNameInvoke-input" match="/"&gt;
        &lt;tns3:FileNameRequest&gt;
            &lt;FileNameInput&gt;
                &lt;tns1:FileNameRequest&gt;
                    &lt;tns1:TempoNotifica&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica"/&gt;
                    &lt;/tns1:TempoNotifica&gt;
                    &lt;tns1:StrutturaRichiesta&gt;
                        &lt;xsl:value-of select="'CPS'"/&gt;
                    &lt;/tns1:StrutturaRichiesta&gt;
                    &lt;tns1:CodiceOLO&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLO"/&gt;
                    &lt;/tns1:CodiceOLO&gt;
                    &lt;tns1:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLOAGCOM"/&gt;
                    &lt;/tns1:CodiceOLOAGCOM&gt;
                    &lt;tns1:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns1:ProcessIstanceID&gt;
                    &lt;xsl:if test="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:NomeFileCPS"&gt;
                        &lt;tns1:NomeFileCPS&gt;
                            &lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:NomeFileCPS"/&gt;
                        &lt;/tns1:NomeFileCPS&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns1:FileNameRequest&gt;
            &lt;/FileNameInput&gt;
        &lt;/tns3:FileNameRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/FileName/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNameInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:FileNameRequest>&#xa;            &lt;tns1:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:TempoNotifica&quot;/>&#xa;            &lt;/tns1:TempoNotifica>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;'CPS'&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:CodiceOLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;            &lt;tns1:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns1:ProcessIstanceID>&#xa;            &lt;xsl:if test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:NomeFileCPS&quot;>&#xa;                &lt;tns1:NomeFileCPS>&#xa;                    &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:NomeFileCPS&quot;/>&#xa;                &lt;/tns1:NomeFileCPS>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:FileNameRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LOG_NotificationInformationToFileNameInvoke"/>
                    <bpws:target linkName="LOG_NessunaNotificaToFileNameInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToLOG_FileNamee"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:empty name="KO" tibex:xpdlId="a90482bd-1dd3-4639-9865-25ca57ebff82">
                <bpws:targets>
                    <bpws:target linkName="ZipFileInvokeToKO"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="KOToRepeatOnError">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$RegolatorioSchedulerIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$RegolatorioSchedulerIn.SchedulerInput/ns5:TempoNotifica = "ORARIO"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="KOToRepeatOnError1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ZipFileInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_SchedulerRegolatorioResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler orario Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns5:ZipFileResponse,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler giornaliero Response: &amp;quot;, tib:render-xml($ZipFileInvoke/ZipFileOutput/tns5:ZipFileResponse,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_SchedulerRegolatorioResponse-input"
                    name="LOG_SchedulerRegolatorioResponse"
                    tibex:xpdlId="03af40c7-d89f-4e31-8e89-0711ed6d4254"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RepeatOnErrorToLOG_SchedulerRegolatorioResponse"/>
                        <bpws:target linkName="RepeatOnError1ToLOG_SchedulerRegolatorioResponse"/>
                        <bpws:target linkName="ZipFileInvokeToLOG_SchedulerRegolatorioResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_SchedulerRegolatorioResponseToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileInvoke.ZipFileOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_SchedulerRegolatorioResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler orario Response: &amp;quot;, tib:render-xml($ZipFileInvoke.ZipFileOutput,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;REGOLATORIO Scheduler giornaliero Response: &amp;quot;, tib:render-xml($ZipFileInvoke.ZipFileOutput,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm"
                    tibex:xpdlId="19f484d2-a2fc-4bc2-b270-4e62697bd77e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_FileNameeToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ConfirmToAssign"/>
                        <bpws:source linkName="ConfirmToCallProcess"
                            tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.confirm"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Confirm"/>
                                    <value
                                    confirmEvent="RegolatorioSchedulerIn" xsi:type="generalactivities:Confirm"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="IsConfermed"
                    name="IsConfermedAssign"
                    outputVariable="IsConfermed"
                    tibex:xpdlId="9fa62549-1125-4bd4-ae01-afb48564012b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ConfirmToAssign"/>
                        <bpws:target linkName="CallProcessToIsConfermedAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="IsConfermedAssignToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="IsConfermedAssignToWhile">
                            <tibex:DesignExpression>
                                <tibex:expression expression="true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[true()]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding expression="true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="IsConfermed" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="ZipFileInvoke-input"
                name="ZipFileInvoke" operation="ZipFile"
                outputVariable="ZipFileInvoke"
                partnerLink="ZipFilePortType"
                portType="ns37:ZipFilePortType" tibex:xpdlId="95fcc956-dba8-40dd-b886-21194a33c83d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/xsd/WriteFile" xmlns:tns2="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/FileName" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="IDTipologiaFile"/&gt;&lt;xsl:param name="RegolatorioSchedulerIn"/&gt;&lt;xsl:param name="REGIDProcsoFileInvio"/&gt;&lt;xsl:param name="JDBC_ORARIO"/&gt;&lt;xsl:param name="JDBC_GIORNALIERO"/&gt;&lt;xsl:param name="_processContext"/&gt;&lt;xsl:param name="WriteFile1"/&gt;&lt;xsl:param name="CPSIDInterfacciaOrario"/&gt;&lt;xsl:param name="CPSIDInterfacciaGiornaliero"/&gt;&lt;xsl:param name="RenameFile"/&gt;&lt;xsl:param name="FileNameInvoke"/&gt;&lt;xsl:param name="CreateFile"/&gt;&lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;&lt;tns4:ZipFileRequest&gt;&lt;ZipFileInput&gt;&lt;tns5:ZipFileRequest&gt;&lt;xsl:if test="$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileName"&gt;&lt;tns5:FullName&gt;&lt;xsl:value-of select="$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileName"/&gt;&lt;/tns5:FullName&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileNameCPS"&gt;&lt;tns5:FileName&gt;&lt;xsl:value-of select="$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileNameCPS"/&gt;&lt;/tns5:FileName&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile1)"&gt;&lt;tns5:Size&gt;&lt;xsl:value-of select="xsd:int($WriteFile1/fileInfo/size)"/&gt;&lt;/tns5:Size&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($RenameFile)"&gt;&lt;tns5:Size&gt;&lt;xsl:value-of select="xsd:int($RenameFile/fileInfo/size)"/&gt;&lt;/tns5:Size&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:Size&gt;&lt;xsl:value-of select="xsd:int($CreateFile/fileInfo/size)"/&gt;&lt;/tns5:Size&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns5:CodiceOLO&gt;&lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLO"/&gt;&lt;/tns5:CodiceOLO&gt;&lt;tns5:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLOAGCOM"/&gt;&lt;/tns5:CodiceOLOAGCOM&gt;&lt;tns5:StrutturaRichiesta&gt;&lt;xsl:value-of select="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:StrutturaRichiesta"/&gt;&lt;/tns5:StrutturaRichiesta&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile1)"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns5:NumeroRecord&gt;&lt;xsl:value-of select="xsd:int(count($JDBC_ORARIO/Record))"/&gt;&lt;/tns5:NumeroRecord&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:NumeroRecord&gt;&lt;xsl:value-of select="xsd:int(count($JDBC_GIORNALIERO/Record))"/&gt;&lt;/tns5:NumeroRecord&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:NumeroRecord&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns5:NumeroRecord&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns5:IDInterfaccia&gt;&lt;xsl:value-of select="$CPSIDInterfacciaOrario"/&gt;&lt;/tns5:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:IDInterfaccia&gt;&lt;xsl:value-of select="$CPSIDInterfacciaGiornaliero"/&gt;&lt;/tns5:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns5:IDTipologiaFile&gt;&lt;xsl:value-of select="$IDTipologiaFile"/&gt;&lt;/tns5:IDTipologiaFile&gt;&lt;tns5:IDProcsoFile&gt;&lt;xsl:value-of select="$REGIDProcsoFileInvio"/&gt;&lt;/tns5:IDProcsoFile&gt;&lt;tns5:ProcessIstanceID&gt;&lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;&lt;/tns5:ProcessIstanceID&gt;&lt;tns5:FullNameCPS&gt;&lt;xsl:value-of select="'CPS'"/&gt;&lt;/tns5:FullNameCPS&gt;&lt;/tns5:ZipFileRequest&gt;&lt;/ZipFileInput&gt;&lt;/tns4:ZipFileRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;REGIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile1&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSIDInterfacciaOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSIDInterfacciaGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;RenameFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ZipFileRequest>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke.FileNameOutput/tns1:FileName&quot;>&#xa;                &lt;tns5:FullName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke.FileNameOutput/tns1:FileName&quot;/>&#xa;                &lt;/tns5:FullName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke.FileNameOutput/tns1:FileNameCPS&quot;>&#xa;                &lt;tns5:FileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke.FileNameOutput/tns1:FileNameCPS&quot;/>&#xa;                &lt;/tns5:FileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile1)&quot;>&#xa;                    &lt;tns5:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($WriteFile1/fileInfo/size)&quot;/>&#xa;                    &lt;/tns5:Size>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($RenameFile)&quot;>&#xa;                            &lt;tns5:Size>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($RenameFile/fileInfo/size)&quot;/>&#xa;                            &lt;/tns5:Size>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:Size>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($CreateFile/fileInfo/size)&quot;/>&#xa;                            &lt;/tns5:Size>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns5:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:CodiceOLO&quot;/>&#xa;            &lt;/tns5:CodiceOLO>&#xa;            &lt;tns5:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns5:CodiceOLOAGCOM>&#xa;            &lt;tns5:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns5:StrutturaRichiesta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile1)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;tns5:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_ORARIO/Record))&quot;/>&#xa;                            &lt;/tns5:NumeroRecord>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:NumeroRecord>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(count($JDBC_GIORNALIERO/Record))&quot;/>&#xa;                            &lt;/tns5:NumeroRecord>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns5:NumeroRecord>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RegolatorioSchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns5:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$CPSIDInterfacciaOrario&quot;/>&#xa;                    &lt;/tns5:IDInterfaccia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$CPSIDInterfacciaGiornaliero&quot;/>&#xa;                    &lt;/tns5:IDInterfaccia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns5:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns5:IDTipologiaFile>&#xa;            &lt;tns5:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$REGIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns5:IDProcsoFile>&#xa;            &lt;tns5:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns5:ProcessIstanceID>&#xa;            &lt;tns5:FullNameCPS>&#xa;                &lt;xsl:value-of select=&quot;'CPS'&quot;/>&#xa;            &lt;/tns5:FullNameCPS>&#xa;        &lt;/tns5:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GenericLoggerToZipFileInvoke"/>
                    <bpws:target linkName="CopyFileToZipFileInvoke"/>
                    <bpws:target linkName="CopyFile1ToZipFileInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ZipFileInvokeToKO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileInvokeToLOG_SchedulerRegolatorioResponse">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and exists($WriteFile) = false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and exists($WriteFile) = false()]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileInvokeToRepeatOnError2">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and exists($WriteFile)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and exists($WriteFile)]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source
                        linkName="ZipFileInvokeToGenericLogger2"
                        tibex:faultDetailsVar="ZipFileInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Notifiche-input"
                    name="LOG_Notifiche"
                    tibex:xpdlId="babe0977-afa8-4464-a07d-20507eaa6385"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WriteFileToLogNotifiche"/>
                        <bpws:target linkName="CreateFileToLogNotifiche"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_NotificheToEmpty4"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Notifiche-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Creato file di notifica.&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Creato file di notifica vuoto.&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;RegolatorioSchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;PathLocaleNOW_CPS&quot;/>&#xa;    &lt;xsl:param name=&quot;ArchivioCrmws&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Input-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SchedulerRegolatorioCPS&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSSchedulerPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CPSScheduler&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Avvio Scheduler Regolatorio: &amp;quot;, tib:render-xml($RegolatorioSchedulerIn/SchedulerInput/tns2:SchedulerInput),'PathLocaleNOW_CPS:',$PathLocaleNOW_CPS,'ArchivioCRMWS:',$ArchivioCrmws)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Input-input" name="LOG_Input"
                    tibex:xpdlId="a7763d93-a9a2-41b7-9c48-4db393c3445d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RegolatorioSchedulerInToLogInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBC_ORARIO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$RegolatorioSchedulerIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
