    <bpws:partnerLinks>
        <bpws:partnerLink name="FWASchedulerPortType"
            partnerLinkType="ns4:partnerLinkType1" partnerRole="use"
            sca-bpel:ignore="true"
            sca-bpel:reference="FWASchedulerPortType" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceBinding>
                <tibex:binding>
                    <bwbinding:BWBaseBinding
                        xmlns:FWASchedulerPortType="http://www.tim.com/NOW/wsdl/concrete/FWASchedulerPortType/"
                        xmlns:NotificationScheduler="http://www.tim.com/NOW/xsd/NotificationScheduler"
                        xmlns:axis2="http://xsd.tns.tibco.com/bw/models/binding/soap/axis2"
                        xmlns:bwbinding="http://tns.tibco.com/bw/model/core/bwbinding"
                        xmlns:pt="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/"
                        xmlns:sca="http://www.osoa.org/xmlns/sca/1.0"
                        xmlns:scact="http://xsd.tns.tibco.com/amf/models/sca/componentType"
                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding name="FWASchedulerPortType" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/#wsdl.interface(FWASchedulerPortType)" scaext:wsdlLocation="../../../../../Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl"/>
                            <scaext:binding
                                destination="tim.now.notification.scheduler.creazionefile"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
                                portName="FWASchedulerPortTypeSOAP"
                                portTypeQName="pt:FWASchedulerPortType"
                                portTypeWSDLLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl"
                                serviceBindingQName="FWASchedulerPortType:SOAPServiceBinding2"
                                serviceQName="FWASchedulerPortType:FWASchedulerPortType"
                                transportBindingType="JMS"
                                wsdlLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManagerConcrete/FWANotificationScheduler_concrete.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="FWAScheduler" operationName="FWAScheduler">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:FWASchedulerRequest" wsdlLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="NotificationScheduler:SchedulerInput"
                                    partName="SchedulerInput" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    jmsResource="tim.now.shared_library.jndi.JMSConnectionResource" xsi:type="axis2:JMSOutboundTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding">
                                <sca:property name="destination" scaext:simpleValue="/CodeJMS/NotificationSchedulerCodaFWA"/>
                            </scact:bindingAdjunct>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
