            <element name="jdbcQueryActivityInput">
                <complexType>
                    <sequence>
                        <element maxOccurs="1" minOccurs="1"
                            name="IDInterfacciaNPN" nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="1"
                            name="IDSistema" nillable="true" type="decimal"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="ServerTimeZone" type="string"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="timeout" type="long"/>
                        <element maxOccurs="1" minOccurs="0"
                            name="maxRows" type="long"/>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema
            targetNamespace="http://www.tibco.com/namespaces/tnt/plugins/jdbc+c53c0f4b-9911-42c2-88ed-2545ed0de19f+output"
            xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tibco.com/namespaces/tnt/plugins/jdbc+c53c0f4b-9911-42c2-88ed-2545ed0de19f+output">
            <element name="resultSet">
                <complexType>
                    <sequence>
                        <element maxOccurs="unbounded" minOccurs="0" name="Record">
                            <complexType>
                                <sequence>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="COD_OLO" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="CODFC_OLO_AGCOM" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="ID_INTRFC" type="decimal"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="LOCAL_PATH"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="REMOTE_PATH"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="NOME_HOST"
                                    nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="0"
                                    name="PORT" nillable="false" type="string"/>
                                    <element maxOccurs="1" minOccurs="1"
                                    name="UTENZA" type="string"/>
                                </sequence>
                            </complexType>
                        </element>
                    </sequence>
                </complexType>
            </element>
        </schema>
        <schema elementFormDefault="unqualified"
            targetNamespace="http://tns.tibco.com/bw/palette/internal/errorlinkhandler+352f9a46-58ba-4375-a69d-a8e60ac817c3"
