                                    </bpws:scope>
                                    </bpws:catchAll>
                                </bpws:faultHandlers>
                                <bpws:sequence name="sequence" tibex:group="while">
                                    <bpws:assign name="GroupInit1"
                                    tibex:group="groupInit" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+07091e1c-93c4-4488-9190-6e87d619e0ff" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                                    <bpws:to variable="Accumulate"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:while name="while" tibex:counterName="index1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index1&lt;=count($Mapper/ns5:NumeriTelefonici)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1<=count($Mapper/ns5:NumeriTelefonici)]]></bpws:condition>
                                    <bpws:flow name="flow8">
                                    <bpws:links>
                                    <bpws:link
                                    name="GroupStart7ToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="TokenToEmpty" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStart7ToMapper1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="EmptyToThrow" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="EmptyToMapper1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="Mapper1ToGenericLogger1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GenericLogger1ToGroupEnd6" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="AssignToToken" tibex:linkType="SUCCESS"/>
                                    </bpws:links>
                                    <bpws:assign
                                    name="GroupStart7"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="76f02983-3dca-41ba-a667-77d379d8fdb1" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStart7ToAssign">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="contains($Mapper/ns5:NumeriTelefonici[$index1]/ns5:TelefonoFissoReferente, 'kk') or contains($Mapper/ns5:NumeriTelefonici[$index1]/ns5:TelefonoMobileReferente,'kk')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[contains($Mapper/ns5:NumeriTelefonici[$index1]/ns5:TelefonoFissoReferente, 'kk') or contains($Mapper/ns5:NumeriTelefonici[$index1]/ns5:TelefonoMobileReferente,'kk')]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart7ToMapper1">
                                    <tibex:DesignExpression>

                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy tibex:reset="yes">
                                    <bpws:from variable="Token"/>
                                    <bpws:to variable="Token"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="07091e1c-93c4-4488-9190-6e87d619e0ff" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GenericLogger1ToGroupEnd6"/>
                                    </bpws:targets>
                                    <tibex:config>

                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
