                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e8112e0c-7ffa-4141-ab62-86f6b3347a63+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_ORARIO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:StrutturaRichiesta&quot;/>&#xa;            &lt;/StrutturaRichiesta>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;CodiceOLOAccorpante>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAccorpante>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
