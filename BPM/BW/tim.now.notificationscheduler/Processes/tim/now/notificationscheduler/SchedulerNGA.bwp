            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="bb9b906c-c0bd-4cf1-b9ae-496cb4550877">
                <bpws:targets>
                    <bpws:target linkName="NumeroNotificheAssign0ToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToIntestazioneNotificheAQAssign"/>
                    <bpws:source linkName="WhileToGenericLogger4"
                        tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+302e36c6-a13b-4f3b-b64d-763a6eb1e484" version="2.0"> <xsl:template name="NotificheErrate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="NotificheErrate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="if($NGASchedulerIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;) then $index &lt;= count($JDBC_ORARIO/Record) else $index &lt;= count($JDBC_GIORNALIERO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if($NGASchedulerIn.SchedulerInput/ns5:TempoNotifica = "ORARIO") then $index <= count($JDBC_ORARIO/Record) else $index <= count($JDBC_GIORNALIERO/Record)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="ParseXmlIntestazioneToGenericLogger13" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="GroupStart1ToAssign5" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="NumeroNotificheAssignToGenericLogger15" tibex:linkType="SUCCESS"/>
