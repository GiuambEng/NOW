                    name="LogNotificheAQ"
                    tibex:xpdlId="f06538cd-09b8-427b-b0c3-3a4e8cdbea69"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WriteFileAQToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToZipFileAQInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&lt;xsl:param name=&quot;WriteFileAQ&quot;/>&lt;xsl:template name=&quot;LogNotificheAQ-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;SchedulerNGA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;NGASchedulerPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;NGAScheduler&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:IDNotifica) > 0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Creato file di notifica AQ. &amp;quot;,$WriteFileAQ/fileInfo/fullName)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Creato file di notifica vuoto AQ. &amp;quot;,$WriteFileAQ/fileInfo/fullName)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:param name=&quot;TagFileVuoto&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;Namespace&quot;/>&#xa;    &lt;xsl:param name=&quot;CodaNamespace&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;Intestazione&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;IntestAQRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;IntestRenderXml&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:template name=&quot;ContenutoFile&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:ContenutoFile>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns2:IDNotifiche/tns2:IDNotifiche&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica) > 0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($ContenutoXML/tns2:ContenutoXML)>0&quot;>&#xa;                                    &lt;tns1:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_ORARIO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;,tib:concat-sequence-format($ContenutoXML/tns2:ContenutoXML/tns2:ContenutoXML, &amp;quot;&amp;#xA;&amp;quot;),&amp;quot;&amp;#xA;&amp;quot; ,$CodaNamespace)&quot;/>&#xa;                                    &lt;/tns1:ContenutoFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_ORARIO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                                    &lt;/tns1:ContenutoFile>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($ContenutoXML/tns2:ContenutoXML)>0&quot;>&#xa;                                    &lt;tns1:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_GIORNALIERO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;,tib:concat-sequence-format($ContenutoXML/tns2:ContenutoXML/tns2:ContenutoXML, &amp;quot;&amp;#xA;&amp;quot;),&amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                                    &lt;/tns1:ContenutoFile>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:ContenutoFile>&#xa;                                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($IntestRenderXml, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;>&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, tib:concat-sequence-format($JDBC_GIORNALIERO/Record[COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot; and not(ID_NOTF = $NotificheErrate)]/TRACCIATO_FILE, &amp;quot;&amp;#xA;&amp;quot;), &amp;quot;&amp;#xA;&amp;quot;, $CodaNamespace)&quot;/>&#xa;                                    &lt;/tns1:ContenutoFile>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:ContenutoFile>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, &amp;quot;&amp;#xA;&amp;quot;, $Namespace, &amp;quot;&amp;#xA;&amp;quot;, $Intestazione, substring-after(substring-after($I