                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+11f866f0-9113-4f98-a3be-9569a795afe1+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;ID_NOTF>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_ORARIO/Record[$index]/ID_NOTF)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_ORARIO/Record[$index]/ID_NOTF&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_NOTF>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_NOTF>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_GIORNALIERO/Record[$index]/ID_NOTF)&