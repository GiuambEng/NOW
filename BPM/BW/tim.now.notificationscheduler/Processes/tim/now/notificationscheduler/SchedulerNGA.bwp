                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOTF.COD_TIPOLG_NOTF, NOTF.ID_NOTF, NOTF.ID_RICH_OLO, STRUTTURA_RICH,&#xd;&#xa;NOTF.TIMSTP_CREAZIONE, NOTF.TRACCIATO_FILE, NOTF.CODFC_OLO_NOW, NOTF.CODFC_OLO_AGCOM,&#xd;&#xa;NOTF.LAVORAZIONE,NOTF.NGA_GPON&#xd;&#xa;FROM RICH_ORDN_COMUNIC_NOTF NOTF, OLO OLO&#xd;&#xa;WHERE STRUTTURA_RICH = ? AND IDTPLG_STNTF_FLGIORN = '1' AND NOTF.NGA_GPON IS NULL AND NOTF.CODFC_OLO_AGCOM = OLO.CODFC_OLO_AGCOM&#xd;&#xa;AND (OLO.CODFC_OLO_AGCOM = ? OR OLO.COD_OLO_ACCORPANTE = ?) AND TRUNC(NOTF.TIMSTP_CREAZIONE) &lt; SYSDATE - 1 ORDER BY CODFC_OLO_AGCOM ASC, ID_RICH_OLO ASC, TIMSTP_CREAZIONE ASC" xsi:type="jdbcPalette:JDBCQueryActivity">
