                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;NotificaMancanteAQ-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:FileNotificaMancanteRequest>&#xa;            &lt;tns3:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:TempoNotifica&quot;/>&#xa;            &lt;/tns3:TempoNotifica>&#xa;            &lt;tns3:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns3:StrutturaRichiesta>&#xa;            &lt;tns3:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-after-last($FileNameInvoke.FileNameOutput/tns4:FileNameAQ, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns3:FileName>&#xa;            &lt;tns3:PathFile>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-before-last($FileNameInvoke.FileNameOutput/tns4:FileNameAQ, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/tns3:PathFile>&#xa;            &lt;tns3:TipoFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;AQ&amp;quot;&quot;/>&#xa;            &lt;/tns3:TipoFile>&#xa;            &lt;tns3:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLO&quot;/>&#xa;            &lt;/tns3:CodiceOLO>&#xa;            &lt;tns3:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns3:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$NGASchedulerIn.SchedulerInput/tns2:FlagNamespaceFileNotifica&quot;>&#xa;                &lt;tns3:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:FlagNamespaceFileNotifica&quot;/>&#xa;                &lt;/tns3:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns3:ProcessIstanceID>&#xa;        &lt;/tns3:FileNotificaMancanteRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
