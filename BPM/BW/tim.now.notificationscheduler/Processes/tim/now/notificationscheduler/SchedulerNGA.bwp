                <bpws:targets>
                    <bpws:target linkName="ZipFileInvokeToRepeatOnError5"/>
                    <bpws:target linkName="Empty6ToRepeatOnError5"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnError5ToRepeatOnError3">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$NGASchedulerIn/SchedulerInput/ns5:SchedulerInput/ns5:TempoNotifica = &quot;ORARIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$NGASchedulerIn.SchedulerInput/ns5:TempoNotifica = "ORARIO"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RepeatOnError5ToRepeatOnError4">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName6"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns0:FaultDetail"
                        name="FaultDetails5" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil5" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope5">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails5" tibex:faultNameVar="FaultName6">
                                <bpws:if name="if5">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index > $MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index > $MaxRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow7">
                            <bpws:links>
