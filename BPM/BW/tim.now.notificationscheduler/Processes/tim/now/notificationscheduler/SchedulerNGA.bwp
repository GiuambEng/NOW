            <bpws:extensionActivity>
                <tibex:activityExtension name="Confirm"
                    tibex:xpdlId="e2e30b56-1137-42eb-8ec7-458a9c38eca2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
