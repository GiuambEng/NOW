            <bpws:invoke inputVariable="ZipFileAQInvoke-input"
                name="ZipFileAQInvoke" operation="ZipFile"
                outputVariable="ZipFileAQInvoke" partnerLink="ZipFile"
                portType="ns43:ZipFilePortType" tibex:xpdlId="19806ed3-8228-4c86-8537-e6f2f2addeb8">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns5="http://www.tim.com/NOW/xsd/WriteFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="NGAInterfacciaIDOrarioAQ"/&gt;
    &lt;xsl:param name="NGAInterfacciaIDGiornalieroAQ"/&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="NGAIDProcsoFileInvio"/&gt;
    &lt;xsl:param name="NumeroNotificheGeneriche"/&gt;
    &lt;xsl:param name="NGASchedulerIn"/&gt;
    &lt;xsl:param name="WriteFileAQ"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:template name="ZipFileAQInvoke-input" match="/"&gt;
        &lt;tns1:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns5:ZipFileRequest&gt;
                    &lt;tns5:FullName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFileAQ/fileInfo/fullName)"/&gt;
                    &lt;/tns5:FullName&gt;
                    &lt;tns5:FileName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFileAQ/fileInfo/fileName)"/&gt;
                    &lt;/tns5:FileName&gt;
                    &lt;tns5:Size&gt;
                        &lt;xsl:value-of select="xsd:int($WriteFileAQ/fileInfo/size)"/&gt;
                    &lt;/tns5:Size&gt;
                    &lt;tns5:CodiceOLO&gt;
                        &lt;xsl:value-of select="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLO"/&gt;
                    &lt;/tns5:CodiceOLO&gt;
                    &lt;tns5:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLOAGCOM"/&gt;
                    &lt;/tns5:CodiceOLOAGCOM&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:IDNotifica) &gt; 0"&gt;
                            &lt;tns5:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:StrutturaRichiesta"/&gt;
                            &lt;/tns5:StrutturaRichiesta&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="&amp;quot;FILE VUOTO&amp;quot;"/&gt;
                            &lt;/tns5:StrutturaRichiesta&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:IDNotifica) &gt; 0"&gt;
                            &lt;tns5:NumeroRecord&gt;
                                &lt;xsl:value-of select="xsd:int(count($NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:IDNotifica))"/&gt;
                            &lt;/tns5:NumeroRecord&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:NumeroRecord&gt;
                                &lt;xsl:value-of select="0"/&gt;
                            &lt;/tns5:NumeroRecord&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                            &lt;tns5:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$NGAInterfacciaIDOrarioAQ"/&gt;
                            &lt;/tns5:IDInterfaccia&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$NGAInterfacciaIDGiornalieroAQ"/&gt;
                            &lt;/tns5:IDInterfaccia&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns5:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns5:IDTipologiaFile&gt;
                    &lt;tns5:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$NGAIDProcsoFileInvio"/&gt;
                    &lt;/tns5:IDProcsoFile&gt;
                    &lt;tns5:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns5:ProcessIstanceID&gt;
                &lt;/tns5:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns1:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFileAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileAQInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ZipFileRequest>&#xa;            &lt;tns5:FullName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFileAQ/fileInfo/fullName)&quot;/>&#xa;            &lt;/tns5:FullName>&#xa;            &lt;tns5:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFileAQ/fileInfo/fileName)&quot;/>&#xa;            &lt;/tns5:FileName>&#xa;            &lt;tns5:Size>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($WriteFileAQ/fileInfo/size)&quot;/>&#xa;            &lt;/tns5:Size>&#xa;            &lt;tns5:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLO&quot;/>&#xa;            &lt;/tns5:CodiceOLO>&#xa;            &lt;tns5:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/t