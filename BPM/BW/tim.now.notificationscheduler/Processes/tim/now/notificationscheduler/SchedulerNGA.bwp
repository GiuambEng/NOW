                                    <tibex:inputBindings>

                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns4=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;OPERATORE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;tns3:RequestDecode_token>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$NGASchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$JDBC_ORARIO/Record[$index]/CODFC_OLO_AGCOM&quot;>&#xa;                            &lt;tns3:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_ORARIO/Record[$index]/CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns3:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$JDBC_GIORNALIERO/Record[$index]/CODFC_OLO_AGCOM&quot;>&#xa;                            &lt;tns3:CodificaOLOAGCOM>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_GIORNALIERO/Record[$index]/CODFC_OLO_AGCOM&quot;/>&#xa;                            &lt;/tns3:CodificaOLOAGCOM>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$JDBCQuery/Record[1]/CODICEORDINEOLO&quot;>&#xa;                    &lt;tns3:CodiceOrdineOLO>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                    &lt;/tns3:CodiceOrdineOLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'VALNOTF'&quot;/>&#xa;                &lt;/tns3:Funzione>&#xa;                &lt;tns3:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;concat($JDBCQuery/Record[1]/CODICEORDINEOLO,'&amp;amp;',string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns3:ChiaveRiferimento>&#xa;                &lt;tns3:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;$OPERATORE&quot;/>&#xa;                &lt;/tns3:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns4:IPAddress&quot;>&#xa;                    &lt;tns3:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns4:IPAddress&quot;/>&#xa;                    &lt;/tns3:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($Mapper/tns2:NumeriTelefonici[$index1]/tns2:TelefonoFissoReferente)>0 and contains($Mapper/tns2:NumeriTelefonici[$index1]/tns2:TelefonoFissoReferente,'kk')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns2:NumeriTelefonici[$index1]/tns2:TelefonoFissoReferente&quot;>&#xa;                            &lt;tns3:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns2:NumeriTelefonici[$index1]/tns2:TelefonoFissoReferente&quot;/>&#xa;                            &lt;/tns3:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Mapper/tns2:NumeriTelefonici[$index1]/tns2:TelefonoMobileReferente&quot;>&#xa;                            &lt;tns3:Token>&#xa;                                &lt;xsl:value-of select=&quot;$Mapper/tns2:NumeriTelefonici[$index1]/tns2:TelefonoMobileReferente&quot;/>&#xa;                            &lt;/tns3:Token>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns3:RequestDecode_token>&#xa;            &lt;tns3:ProcessIstance>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns3:ProcessIstance>&#xa;        &lt;/tns3:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="tim.now.notificationscheduler.util.Token" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                    </bpws:extensionActivity>
                                    <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Mapper1-input"
                                    name="Mapper1"
                                    outputVariable="Mapper1"
                                    tibex:xpdlId="de42909e-dcbd-4dea-8ab0-a7c60cf56313" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart7ToMapper1"/>
