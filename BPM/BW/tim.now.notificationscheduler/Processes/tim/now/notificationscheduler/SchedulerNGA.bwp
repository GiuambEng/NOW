                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:template name=&quot;IntestazioneNotifiche&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:INTESTAZIONE>&#xa;            &lt;ns0:NOME_FILE>&#xa;                &lt;xsl:value-of select=&quot;tib:substring-after-last($FileNameInvoke.FileNameOutput/tns3:FileName, &amp;quot;/&amp;quot;)&quot;/>&#xa;            &lt;/ns0:NOME_FILE>&#xa;            &lt;ns0:DATA_CREAZIONE_FILE>&#xa;                &lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;            &lt;/ns0:DATA_CREAZIONE_FILE>&#xa;            &lt;ns0:SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ns0:SISTEMA>&#xa;            &lt;ns0:CODICE_ISP>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLO&quot;/>&#xa;            &lt;/ns0:CODICE_ISP>&#xa;            &lt;ns0:NUMERO_PRATICHE>&#xa;                &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheTotali&quot;/>&#xa;            &lt;/ns0:NUMERO_PRATICHE>&#xa;            &lt;ns0:NUMERO_PRATICHE_CHIUSE_OK>&#xa;                &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheOK&quot;/>&#xa;            &lt;/ns0:NUMERO_P