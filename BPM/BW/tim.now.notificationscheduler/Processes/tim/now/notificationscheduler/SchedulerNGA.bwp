            <bpws:scope name="RepeatOnError" tibex:group="repeatOnError" tibex:xpdlId="cb72e749-e0b3-4748-834c-5e69f7033cb9">
                <bpws:targets>
                    <bpws:target linkName="KO_AQToRepeatOnError"/>
                    <bpws:target linkName="RepeatOnError1ToRepeatOnError"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="RepeatOnErrorToWriteFile"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                    <bpws:variable name="repeatOnError_success_flag"
                        sca-bpel:internal="true" type="xsd:boolean"/>
                    <bpws:variable name="FaultName1"
                        sca-bpel:internal="true" type="xsd:string"/>
                    <bpws:variable element="ns0:FaultDetail"
                        name="FaultDetails" sca-bpel:internal="true"/>
                </bpws:variables>
                <bpws:repeatUntil name="repeatUntil" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="boolean($repeatOnError_success_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:scope name="innerScope">
                        <bpws:faultHandlers>
                            <bpws:catchAll
                                tibex:faultDetailsVar="FaultDetails" tibex:faultNameVar="FaultName1">
                                <bpws:if name="if">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index > $MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index > $MaxRetry]]></bpws:condition>
                                    <bpws:rethrow name="Rethrow"/>
                                    <bpws:else>
                                    <bpws:assign name="Assign" validate="no">
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[false()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                    </bpws:copy>
                                    </bpws:assign>
                                    </bpws:else>
                                </bpws:if>
                            </bpws:catchAll>
                        </bpws:faultHandlers>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToJDBCUpdateAQ_ORARIO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBCUpdateAQ_ORARIOToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToSleep" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="SleepToJDBCUpdateAQ_ORARIO" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="f5f40fa4-2971-4d6c-922f-3bb3d91e3f53">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCUpdateAQ_ORARIO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToSleep">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index > 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index > 1]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:assign name="GroupEnd"
                                tibex:group="groupEnd"
                                tibex:xpdlId="4c5f29ab-bc24-4af0-b1b3-612a660a9faf" validate="no">
                                <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateAQ_ORARIOToGroupEnd"/>
                                </bpws:targets>
                                <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[true()]]></bpws:from>
                                    <bpws:to variable="repeatOnError_success_flag"/>
                                </bpws:copy>
                            </bpws:assign>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e968ce31-5c22-49b9-ad63-cc2ff72d9197+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NotificheErrate&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;ZipFileAQInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdateAQ_ORARIO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:variable name=&quot;NotificheErrate&quot; select=&quot;$NotificheErrate/tns2:IDNotifiche/tns2:IDNotifiche&quot;/>&#xa;            &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:IDNotifica[not(. = $NotificheErrate)]&quot;>&#xa;                &lt;Record>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length(string($ZipFileAQInvoke/ZipFileOutput/tns5:ZipFileResponse/tns5:IDFile)) > 0&quot;>&#xa;                            &lt;StatoNotifica>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;INVIATA&amp;quot;&quot;/>&#xa;                            &lt;/StatoNotifica>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;StatoNotifica>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ERRORE&amp;quot;&quot;/>&#xa;                            &lt;/StatoNotifica>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;IDNotifica>&#xa;                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                    &lt;/IDNotifica>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCUpdateAQ_ORARIO-input"
                                    name="JDBCUpdateAQ_ORARIO"
                                    outputVariable="JDBCUpdateAQ_ORARIO"
                                    tibex:xpdlId="e968ce31-5c22-49b9-ad63-cc2ff72d9197" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCUpdateAQ_ORARIO"/>
                                    <bpws:target linkName="SleepToJDBCUpdateAQ_ORARIO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCUpdateAQ_ORARIOToGroupEnd"/>
                                    </bpws:sources>
