                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;NumeroNotificheGeneriche&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NumeroNotificheGeneriche>&#xa;            &lt;tns2:NumeroNotifiche>&#xa;                &lt;tns2:NotificheTotali>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheTotali>&#xa;                &lt;tns2:NotificheOK>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheOK>&#xa;                &lt;tns2:NoticheKO>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NoticheKO>&#xa;                &lt;tns2:NotificheIntermedie>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheIntermedie>&#xa;                &lt;tns2:NotificheMigrazioni>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheMigrazioni>&#xa;            &lt;/tns2:NumeroNotifiche>&#xa;            &lt;tns2:NumeroNotificheAQ>&#xa;                &lt;tns2:NotificheTotali>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheTotali>&#xa;                &lt;tns2:NotificheOK>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheOK>&#xa;                &lt;tns2:NoticheKO>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NoticheKO>&#xa;                &lt;tns2:NotificheIntermedie>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheIntermedie>&#xa;                &lt;tns2:NotificheMigrazioni>&#xa;                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                &lt;/tns2:NotificheMigrazioni>&#xa;            &lt;/tns2:NumeroNotificheAQ>&#xa;        &lt;/tns2:NumeroNotificheGeneriche>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
