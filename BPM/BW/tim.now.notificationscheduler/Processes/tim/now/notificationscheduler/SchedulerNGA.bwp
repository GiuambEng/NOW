                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+11f866f0-9113-4f98-a3be-9569a795afe1+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke.FileNameOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdate2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;ID_NOTF>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_ORARIO/Record[$index]/ID_NOTF)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_ORARIO/Record[$index]/ID_NOTF&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_NOTF>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_NOTF>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_GIORNALIERO/Record[$index]/ID_NOTF)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_GIORNALIERO/Record[$index]/ID_NOTF&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_NOTF>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;FLAG_ERR_SECOLO>&#xa;                &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;            &lt;/FLAG_ERR_SECOLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;PROCESSO_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;'FILE_ORARIO'&quot;/>&#xa;                    &lt;/PROCESSO_NOTIFICA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PROCESSO_NOTIFICA>&#xa;                        &lt;xsl:value-of select=&quot;'FILE_GIORNALIERO'&quot;/>&#xa;                    &lt;/PROCESSO_NOTIFICA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;NOME_FILE_NOTIFICA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FileNameInvoke.FileNameOutput/tns4:FileName)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FileNameInvoke.FileNameOutput/tns4:FileName&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_FILE_NOTIFICA>&#xa;            &lt;DATA_ORA_FILE_NOTIFICA>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/DATA_ORA_FILE_NOTIFICA>&#xa;            &lt;TIMESTAMP_INS>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMESTAMP_INS>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
