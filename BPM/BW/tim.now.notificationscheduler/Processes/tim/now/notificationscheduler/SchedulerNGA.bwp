$NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;                    &lt;/tns5:IDInterfaccia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns5:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns5:IDTipologiaFile>&#xa;            &lt;tns5:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$NGAIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns5:IDProcsoFile>&#xa;            &lt;tns5:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns5:ProcessIstanceID>&#xa;        &lt;/tns5:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToZipFileAQInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ZipFileAQInvokeToWriteFile">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) = 0 and string-length(string($ZipFileAQInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) = 0 and string-length(string($ZipFileAQInvoke.ZipFileOutput/tns:IDFile)) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileAQInvokeToRepeatOnError1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) > 0 and string-length(string($ZipFileAQInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($NumeroNotificheGeneriche/ns5:NumeroNotificheAQ/ns5:IDNotifica) > 0 and string-length(string($ZipFileAQInvoke.ZipFileOutput/tns:IDFile)) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileAQInvokeToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source
                        linkName="ZipFileAQInvokeToGenericLogger18"
                        tibex:faultDetailsVar="ZipFileAQInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="ZipFileInvoke-input"
                name="ZipFileInvoke" operation="ZipFile"
                outputVariable="ZipFileInvoke" partnerLink="ZipFile"
                portType="ns43:ZipFilePortType" tibex:xpdlId="dc35fce2-292a-49d0-9598-eef4ed9ecdc6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/xsd/NotificationScheduler" xmlns:tns5="http://www.tim.com/NOW/xsd/WriteFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="NGAInterfacciaIDOrario"/&gt;
    &lt;xsl:param name="NGAInterfacciaIDGiornaliero"/&gt;
    &lt;xsl:param name="IDTipologiaFile"/&gt;
    &lt;xsl:param name="NGAIDProcsoFileInvio"/&gt;
    &lt;xsl:param name="NumeroNotificheGeneriche"/&gt;
    &lt;xsl:param name="NGASchedulerIn"/&gt;
    &lt;xsl:param name="WriteFile"/&gt;
    &lt;xsl:param name="_processContext"/&gt;
    &lt;xsl:param name="ContenutoXML"/&gt;
    &lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;
        &lt;tns1:ZipFileRequest&gt;
            &lt;ZipFileInput&gt;
                &lt;tns5:ZipFileRequest&gt;
                    &lt;tns5:FullName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fullName)"/&gt;
                    &lt;/tns5:FullName&gt;
                    &lt;tns5:FileName&gt;
                        &lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fileName)"/&gt;
                    &lt;/tns5:FileName&gt;
                    &lt;tns5:Size&gt;
                        &lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;
                    &lt;/tns5:Size&gt;
                    &lt;tns5:CodiceOLO&gt;
                        &lt;xsl:value-of select="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLO"/&gt;
                    &lt;/tns5:CodiceOLO&gt;
                    &lt;tns5:CodiceOLOAGCOM&gt;
                        &lt;xsl:value-of select="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLOAGCOM"/&gt;
                    &lt;/tns5:CodiceOLOAGCOM&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica) &gt; 0"&gt;
                            &lt;tns5:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:StrutturaRichiesta"/&gt;
                            &lt;/tns5:StrutturaRichiesta&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:StrutturaRichiesta&gt;
                                &lt;xsl:value-of select="&amp;quot;FILE VUOTO&amp;quot;"/&gt;
                            &lt;/tns5:StrutturaRichiesta&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica) &gt; 0"&gt;
                            &lt;tns5:NumeroRecord&gt;
                                &lt;xsl:value-of select="xsd:int(count($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica))"/&gt;
                            &lt;/tns5:NumeroRecord&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:NumeroRecord&gt;
                                &lt;xsl:value-of select="0"/&gt;
                            &lt;/tns5:NumeroRecord&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;
                            &lt;tns5:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$NGAInterfacciaIDOrario"/&gt;
                            &lt;/tns5:IDInterfaccia&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns5:IDInterfaccia&gt;
                                &lt;xsl:value-of select="$NGAInterfacciaIDGiornaliero"/&gt;
                            &lt;/tns5:IDInterfaccia&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns5:IDTipologiaFile&gt;
                        &lt;xsl:value-of select="$IDTipologiaFile"/&gt;
                    &lt;/tns5:IDTipologiaFile&gt;
                    &lt;tns5:IDProcsoFile&gt;
                        &lt;xsl:value-of select="$NGAIDProcsoFileInvio"/&gt;
                    &lt;/tns5:IDProcsoFile&gt;
                    &lt;tns5:ProcessIstanceID&gt;
                        &lt;xsl:value-of select="$_processContext/ProcessInstanceId"/&gt;
                    &lt;/tns5:ProcessIstanceID&gt;
                    &lt;xsl:if test="count($ContenutoXML/tns2:ContenutoXML)&gt;0"&gt;
                        &lt;tns5:Tokenizzazione&gt;
                            &lt;xsl:value-of select="'SI'"/&gt;
                        &lt;/tns5:Tokenizzazione&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns5:ZipFileRequest&gt;
            &lt;/ZipFileInput&gt;
        &lt;/tns1:ZipFileRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoXML&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ZipFileRequest>&#xa;            &lt;tns5:FullName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fullName)&quot;/>&#xa;            &lt;/tns5:FullName>&#xa;            &lt;tns5:FileName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fileName)&quot;/>&#xa;            &lt;/tns5:FileName>&#xa;            &lt;tns5:Size>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;            &lt;/tns5:Size>&#xa;            &lt;tns5:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLO&quot;/>&#xa;            &lt;/tns5:CodiceOLO>&#xa;            &lt;tns5:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns5:CodiceOLOAGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica) > 0&quot;>&#xa;                    &lt;tns5:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;$NGASchedulerIn.SchedulerInput/tns2:StrutturaRichiesta&quot;/>&#xa;                    &lt;/tns5:StrutturaRichiesta>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:StrutturaRichiesta>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FILE VUOTO&amp;quot;&quot;/>&#xa;                    &lt;/tns5:StrutturaRichiesta>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica) > 0&quot;>&#xa;                    &lt;tns5:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(count($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica))&quot;/>&#xa;                    &lt;/tns5:NumeroRecord>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:NumeroRecord>&#xa;                        &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                    &lt;/tns5:NumeroRecord>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns5:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$NGAInterfacciaIDOrario&quot;/>&#xa;                    &lt;/tns5:IDInterfaccia>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns5:IDInterfaccia>&#xa;                        &lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornaliero&quot;/>&#xa;                    &lt;/tns5:IDInterfaccia>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns5:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns5:IDTipologiaFile>&#xa;            &lt;tns5:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$NGAIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns5:IDProcsoFile>&#xa;            &lt;tns5:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns5:ProcessIstanceID>&#xa;            &lt;xsl:if test=&quot;count($ContenutoXML/tns2:ContenutoXML)>0&quot;>&#xa;                &lt;tns5:Tokenizzazione>&#xa;                    &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                &lt;/tns5:Tokenizzazione>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:ZipFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogNotificheToZipFileInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ZipFileInvokeToRepeatOnError5">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and count($NumeroNotificheGeneriche/ns5:NumeroNotifiche/ns5:IDNotifica) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and count($NumeroNotificheGeneriche/ns5:NumeroNotifiche/ns5:IDNotifica) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Invoke1ToKO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ZipFileInvokeToLOG_SchedulerNGAResponse">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length(string($ZipFileInvoke/ZipFileOutput/tns:ZipFileResponse/tns:IDFile)) > 0 and count($NumeroNotificheGeneriche/ns5:NumeroNotifiche/ns5:IDNotifica) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length(string($ZipFileInvoke.ZipFileOutput/tns:IDFile)) > 0 and count($NumeroNotificheGeneriche/ns5:NumeroNotifiche/ns5:IDNotifica) = 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source
                        linkName="ZipFileInvokeToGenericLogger19"
                        tibex:faultDetailsVar="ZipFileInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
