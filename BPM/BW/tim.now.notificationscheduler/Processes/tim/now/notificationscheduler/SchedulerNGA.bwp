CodiceOLO&quot;/>&#xa;            &lt;/tns3:CodiceOLO>&#xa;            &lt;tns3:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns3:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:FlagNamespaceFileNotifica&quot;>&#xa;                &lt;tns3:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:FlagNamespaceFileNotifica&quot;/>&#xa;                &lt;/tns3:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns3:ProcessIstanceID>&#xa;                &lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&#xa;            &lt;/tns3:ProcessIstanceID>&#xa;        &lt;/tns3:FileNotificaMancanteRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
