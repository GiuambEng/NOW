                                <bpws:link
                                    name="JDBCUpdate1ToGenericLogger11" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GenericLogger11ToGroupEnd5" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart6"
                                tibex:group="groupStart" tibex:xpdlId="3b89f01a-985c-4c1c-8c94-57d1c47c6413">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart6ToJDBC_FILE_STANDARD">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart6ToSleep5">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index > 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index > 1]]></bpws:transitionCondition>
