                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ParseXmlIntestazione&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;maskD420&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper2-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:RICHIESTA>&#xa;            &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_ACCESSO)&quot;>&#xa;                &lt;xsl:copy-of select=&quot;$ParseXmlIntestazione/ns0:DATI_ACCESSO&quot;/>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_REFERENTE)&quot;>&#xa;                &lt;ns0:DATI_REFERENTE>&#xa;                    &lt;xsl:if test=&quot;exists($ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1])&quot;>&#xa;                        &lt;ns0:REFERENTE>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:NOME_REF&quot;>&#xa;                                &lt;ns0:NOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:NOME_REF&quot;/>&#xa;                                &lt;/ns0:NOME_REF>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:COGNOME_REF&quot;>&#xa;                                &lt;ns0:COGNOME_REF>&#xa;                                    &lt;xsl:value-of select=&quot;$ParseXmlIntestazione/ns0:DATI_REFERENTE/ns0:REFERENTE[1]/ns0:COGNOME_REF&quot;/>&#xa;                                &lt;/ns0:COGNOME_REF>&#xa;              