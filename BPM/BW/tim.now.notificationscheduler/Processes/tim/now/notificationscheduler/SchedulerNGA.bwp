                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn.SchedulerInput&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroNotificheGeneriche&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_GIORNALIERO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ORARIO&quot;/>&#xa;    &lt;xsl:template name=&quot;NumeroNotificheGeneriche&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NumeroNotificheGeneriche>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns2:NumeroNotifiche>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheTotali>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheTotali&quot;/>&#xa;                                &lt;/tns2:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OK&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OD&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OR&amp;quot;)  and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheOK + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheOK>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheOK&quot;/>&#xa;                                &lt;/tns2:NotificheOK>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KO&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RA&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RR&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RS&amp;quot;)  and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NoticheKO + 1)&quot;/>&#xa;                                &lt;/tns2:NoticheKO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NoticheKO&quot;/>&#xa;                                &lt;/tns2:NoticheKO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AC&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SP&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;FS&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;CO&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KA&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SU&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NL&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NP&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SC&amp;quot; or $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SM&amp;quot;)  and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheIntermedie + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheIntermedie>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheIntermedie&quot;/>&#xa;                                &lt;/tns2:NotificheIntermedie>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheMigrazioni&quot;/>&#xa;                                &lt;/tns2:NotificheMigrazioni>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica&quot;>&#xa;                                    &lt;tns2:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns2:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;tns2:IDNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_ORARIO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                                &lt;/tns2:IDNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica&quot;>&#xa;                                    &lt;tns2:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns2:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:NumeroNotifiche>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:NumeroNotifiche>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheTotali>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheTotali&quot;/>&#xa;                                &lt;/tns2:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OK&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OD&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;OR&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheOK + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheOK>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheOK>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheOK&quot;/>&#xa;                                &lt;/tns2:NotificheOK>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KO&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RA&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RR&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;RS&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NoticheKO + 1)&quot;/>&#xa;                                &lt;/tns2:NoticheKO>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NoticheKO>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NoticheKO&quot;/>&#xa;                                &lt;/tns2:NoticheKO>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AC&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SP&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;FS&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;CO&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;KA&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SU&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NL&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;NP&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SC&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;SM&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;MIGRAZIONE&amp;quot; and $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE !=&amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheIntermedie + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheIntermedie>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheIntermedie>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheIntermedie&quot;/>&#xa;                                &lt;/tns2:NotificheIntermedie>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_GIORNALIERO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:NotificheMigrazioni&quot;/>&#xa;                                &lt;/tns2:NotificheMigrazioni>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_GIORNALIERO/Record[number($index)]/COD_TIPOLG_NOTF !=&amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica&quot;>&#xa;                                    &lt;tns2:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns2:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;tns2:IDNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_GIORNALIERO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                                &lt;/tns2:IDNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica&quot;>&#xa;                                    &lt;tns2:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns2:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:NumeroNotifiche>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn.SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns2:NumeroNotificheAQ>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheTotali>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:NotificheTotali&quot;/>&#xa;                                &lt;/tns2:NotificheTotali>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:NotificheOK>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:NotificheOK&quot;/>&#xa;                        &lt;/tns2:NotificheOK>&#xa;                        &lt;tns2:NoticheKO>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:NoticheKO&quot;/>&#xa;                        &lt;/tns2:NoticheKO>&#xa;                        &lt;tns2:NotificheIntermedie>&#xa;                            &lt;xsl:value-of select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:NotificheIntermedie&quot;/>&#xa;                        &lt;/tns2:NotificheIntermedie>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;($JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $JDBC_ORARIO/Record[number($index)]/LAVORAZIONE = &amp;quot;INTERRUZIONEMIGRAZIONE&amp;quot;) and $JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheMigrazioni>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:NotificheMigrazioni + 1)&quot;/>&#xa;                                &lt;/tns2:NotificheMigrazioni>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NotificheM