&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica&quot;>&#xa;                                    &lt;tns2:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns2:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                                &lt;tns2:IDNotifica>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_GIORNALIERO/Record[number($index)]/ID_NOTF)&quot;/>&#xa;                                &lt;/tns2:IDNotifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$NumeroNotificheGeneriche/tns2:NumeroNotifiche/tns2:IDNotifica&quot;>&#xa;                                    &lt;tns2:IDNotifica>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns2:IDNotifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns2:NumeroNotifiche>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;tns2:NumeroNotificheAQ>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$JDBC_ORARIO/Record[number($index)]/COD_TIPOLG_NOTF = &amp;quot;AQ&amp;quot;&quot;>&#xa;                                &lt;tns2:NotificheTotali>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($NumeroNotificheGeneriche/tns2:NumeroNotificheAQ/tns2:NotificheTotali + 1)&quot;/>&#xa;                                &lt;/tns2:Notific