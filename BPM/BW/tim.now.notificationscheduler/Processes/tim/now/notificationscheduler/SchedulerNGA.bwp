            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/file&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;ContenutoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;TransformAQXml&quot;/>&#xa;    &lt;xsl:param name=&quot;NGASchedulerIn&quot;/>&#xa;    &lt;xsl:param name=&quot;TestataNamespace&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFileAQ-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:WriteActivityInputTextClass>&#xa;            &lt;xsl:if test=&quot;$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileNameAQ&quot;>&#xa;                &lt;fileName>&#xa;                    &lt;xsl:value-of select=&quot;$FileNameInvoke/FileNameOutput/tns1:FileNameResponse/tns1:FileNameAQ&quot;/>&#xa;                &lt;/fileName>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NGASchedulerIn/SchedulerInput/tns2:SchedulerInput/tns2:FlagNamespaceFileNotifica = &amp;quot;N&amp;quot;&quot;>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;concat($TestataNamespace, $TransformAQXml)&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;textContent>&#xa;                        &lt;xsl:value-of select=&quot;$ContenutoFile/tns1:ContenutoFileAQ&quot;/>&#xa;                    &lt;/textContent>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:WriteActivityInputTextClass>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
