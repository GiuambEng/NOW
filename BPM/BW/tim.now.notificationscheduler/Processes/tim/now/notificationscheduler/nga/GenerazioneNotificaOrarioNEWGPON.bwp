                                <sca:property name="destination" scaext:simpleValue="/CodeJMS/NotificationSchedulerCodaNEWGPON"/>
                            </scact:bindingAdjunct>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
    </bpws:partnerLinks>
