                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="576e78f1-2d56-4f80-9391-ed24d44f919b">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    <bpws:target linkName="SendFileInvokeToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:invoke
                                inputVariable="SendFileInvoke-input"
                                name="SendFileInvoke"
                                operation="SendFile"
                                outputVariable="SendFileInvoke"
                                partnerLink="SendFile"
                                portType="ns0:SendFilePortType" tibex:xpdlId="48bca8ab-9c5c-4d78-b9db-d0247c14ec92">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http:///www.tim.com/NOW/wsdl/abstract/SendFile/" xmlns:tns1="http:///www.tim.com/NOW/xsd/SendFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="NGAIDProcsoFileInvio"/&gt;&lt;xsl:param name="JDBC_OLO"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:template name="SendFileInvoke-input" match="/"&gt;&lt;tns:SendFileRequest&gt;&lt;SendFileInput&gt;&lt;tns1:SendFileRequest&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/COD_OLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;tns1:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM"/&gt;&lt;/tns1:CodiceOLOAGCOM&gt;&lt;tns1:IDInterfaccia&gt;&lt;xsl:value-of select="xsd:int($JDBC_OLO/Record[number($index)]/ID_INTRFC)"/&gt;&lt;/tns1:IDInterfaccia&gt;&lt;tns1:StrutturaRichiesta&gt;&lt;xsl:value-of select="&amp;quot;NGA&amp;quot;"/&gt;&lt;/tns1:StrutturaRichiesta&gt;&lt;tns1:IDProcsoFile&gt;&lt;xsl:value-of select="$NGAIDProcsoFileInvio"/&gt;&lt;/tns1:IDProcsoFile&gt;&lt;tns1:DatiPutFile&gt;&lt;tns1:PathFile&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/LOCAL_PATH"/&gt;&lt;/tns1:PathFile&gt;&lt;tns1:RemotePath&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/REMOTE_PATH"/&gt;&lt;/tns1:RemotePath&gt;&lt;tns1:Host&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/NOME_HOST"/&gt;&lt;/tns1:Host&gt;&lt;tns1:Port&gt;&lt;xsl:value-of select="xsd:int($JDBC_OLO/Record[number($index)]/PORT)"/&gt;&lt;/tns1:Port&gt;&lt;tns1:User&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/UTENZA"/&gt;&lt;/tns1:User&gt;&lt;/tns1:DatiPutFile&gt;&lt;/tns1:SendFileRequest&gt;&lt;/SendFileInput&gt;&lt;/tns:SendFileRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http:///www.tim.com/NOW/wsdl/abstract/SendFile/&quot; xmlns:tns1=&quot;http:///www.tim.com/NOW/xsd/SendFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NGAIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;SendFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SendFileRequest>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/COD_OLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;            &lt;tns1:IDInterfaccia>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($JDBC_OLO/Record[number($index)]/ID_INTRFC)&quot;/>&#xa;            &lt;/tns1:IDInterfaccia>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:IDProcsoFile>&#xa;                &lt;xsl:value-of select=&quot;$NGAIDProcsoFileInvio&quot;/>&#xa;            &lt;/tns1:IDProcsoFile>&#xa;            &lt;tns1:DatiPutFile>&#xa;                &lt;tns1:PathFile>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/LOCAL_PATH&quot;/>&#xa;                &lt;/tns1:PathFile>&#xa;                &lt;tns1:RemotePath>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/REMOTE_PATH&quot;/>&#xa;                &lt;/tns1:RemotePath>&#xa;                &lt;tns1:Host>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/NOME_HOST&quot;/>&#xa;                &lt;/tns1:Host>&#xa;                &lt;tns1:Port>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JDBC_OLO/Record[number($index)]/PORT)&quot;/>&#xa;                &lt;/tns1:Port>&#xa;                &lt;tns1:User>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/UTENZA&quot;/>&#xa;                &lt;/tns1:User>&#xa;            &lt;/tns1:DatiPutFile>&#xa;        &lt;/tns1:SendFileRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source
                                    linkName="SendFileInvokeToCallProcess"
                                    tibex:faultDetailsVar="SendFileInvoke" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="SendFileInvokeToGroupEnd"/>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerInvioGiornalieroNGA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nell'invio file per l'OLO: &amp;quot;, $JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM, &amp;quot;.&amp;quot;)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Error-input"
                                    name="Error"
                                    tibex:xpdlId="02267d4d-a26d-402e-b67d-9b7f7968f26e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
