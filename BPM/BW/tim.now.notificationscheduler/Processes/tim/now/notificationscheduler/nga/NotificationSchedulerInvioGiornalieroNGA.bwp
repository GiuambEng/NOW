                <bpws:link name="JDBC_OLOToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="__Link3" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToJDBC_OLO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogInputToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
