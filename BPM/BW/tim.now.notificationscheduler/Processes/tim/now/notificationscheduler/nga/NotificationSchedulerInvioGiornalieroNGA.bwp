            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="TimerInvioGiorno"
                    tibex:xpdlId="7991af12-85fb-4ded-a1f7-dcc3a1a92fa3"
