                <bpws:sequence name="sequence" tibex:group="while" tibex:xpdlId="863ae2ce-0de6-46f5-a8ce-52d8115e3228">
                    <bpws:empty name="GroupInit" tibex:group="groupInit" tibex:xpdlId="ffd49791-93ba-4f79-a8b3-b5aba5b329e3"/>
                    <bpws:while name="while" tibex:counterName="index" tibex:xpdlId="70ee1282-4b08-4eb6-9b70-f8cb2a0b53e6">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBC_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_OLO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1" tibex:xpdlId="9c06e6dc-764a-461a-8f41-10fbd223cc4f">
                            <bpws:links>
