            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d68d97b0-a713-49d6-a678-eb774c498f8d+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&lt;xsl:param name=&quot;IDSistema&quot;/>&lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&lt;xsl:template name=&quot;JDBC_OLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDInterfacciaNGA>&lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornaliero&quot;/>&lt;/IDInterfacciaNGA>&lt;IDInterfacciaNGAAQ>&lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornalieroAQ&quot;/>&lt;/IDInterfacciaNGAAQ>&lt;IDSistema>&lt;xsl:value-of select=&quot;$IDSistema&quot;/>&lt;/IDSistema>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_OLO-input" name="JDBC_OLO"
                    outputVariable="JDBC_OLO"
                    tibex:xpdlId="d68d97b0-a713-49d6-a678-eb774c498f8d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBC_OLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_OLOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d68d97b0-a713-49d6-a678-eb774c498f8d+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&lt;xsl:param name=&quot;IDSistema&quot;/>&lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&lt;xsl:template name=&quot;JDBC_OLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDInterfacciaNGA>&lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornaliero&quot;/>&lt;/IDInterfacciaNGA>&lt;IDInterfacciaNGAAQ>&lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornalieroAQ&quot;/>&lt;/IDInterfacciaNGAAQ>&lt;IDSistema>&lt;xsl:value-of select=&quot;$IDSistema&quot;/>&lt;/IDSistema>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OLO.COD_OLO, OLO.CODFC_OLO_AGCOM, INTR.ID_INTRFC,&#xa;&#x9;&#x9;INTR.LOCAL_PATH, INTR.REMOTE_PATH, INTR.NOME_HOST, INTR.PORT, INTR.UTENZA&#xa;  FROM OLO OLO, SISTEMA_IP_INTRFC INTR&#xa;  WHERE OLO.CODFC_OLO_AGCOM = INTR.CODFC_OLO_AGCOM AND (INTR.ID_INTRFC = ? OR INTR.ID_INTRFC = ?)&#xa;  AND INTR.ID_SISTEMA = ? AND FLAG_ENABLED = 'Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDInterfacciaNGA"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDInterfacciaNGAAQ"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDSistema"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_INTRFC"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="LOCAL_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="REMOTE_PATH"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_HOST"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PORT"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="UTENZA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="387c8af0-ad31-461e-8936-2e70e0c213a5">
