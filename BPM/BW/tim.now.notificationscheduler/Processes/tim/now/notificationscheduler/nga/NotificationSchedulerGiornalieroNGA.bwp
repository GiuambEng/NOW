        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="IDInterfacciaNGA"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/Scheduler/InterfacciaAcquisizione/IDInterfacciaAQNGA" type="xsd:int"/>
        <bpws:variable name="IDSistemaOLO" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/Scheduler/IDSistema/IDSistemaOLO" type="xsd:int"/>
        <bpws:variable name="DataTimeGiornaliero"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/Scheduler/DateTime/DataTimeGiornaliero" type="xsd:dateTime"/>
        <bpws:variable name="TimerGiornaliero"
            sca-bpel:hotUpdate="false" sca-bpel:privateProperty="true"
            sca-bpel:property="yes"
            tibex:propertySource="/Process/Scheduler/Timer/TimerGiornaliero" type="xsd:int"/>
        <bpws:variable name="Timeout" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Connection/JDBC/Timeout" type="xsd:int"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="LogJDBC_OLO-input" sca-bpel:internal="true"/>
        <bpws:variable name="logger_name" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="log_level" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE" name="Error-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:ErrorLinkHandlerFaultData"
            name="_error_SchedulerNGAInvoke" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="LogInput-input" sca-bpel:internal="true"/>
        <bpws:variable name="DateTimeAvvio" type="xsd:dateTime"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="LogTimer_Fault-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns4:NGASchedulerRequest"
            name="NGAScheduler-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="TimerGiornoToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBC_OLOToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToExit" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignDateTimeToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallProcessToJDBC_OLO" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogTimer_FaultToExit" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="60" name="TimerGiorno"
                    tibex:xpdlId="f11a9c00-247f-411e-b687-fbd22b155c8e"
                    variable="TimerGiorno" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="TimerGiornoToAssign"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.timer"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="startTime" processProperty="DataTimeGiornaliero"/>
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="TimerGiornaliero"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2016-09-06T20:16:17.635+0200"
                                    intervalUnit="" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBC_OLO-input"
                    name="JDBC_OLO" outputVariable="JDBC_OLO"
                    tibex:xpdlId="5cbe7970-759d-4499-96b4-d612be08ce1c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBC_OLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_OLOToCallProcess">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5cbe7970-759d-4499-96b4-d612be08ce1c+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistemaOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDInterfacciaNGA>&#xa;                &lt;xsl:value-of select=&quot;$IDInterfacciaNGA&quot;/>&#xa;            &lt;/IDInterfacciaNGA>&#xa;            &lt;IDSistema>&#xa;                &lt;xsl:value-of select=&quot;$IDSistemaOLO&quot;/>&#xa;            &lt;/IDSistema>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OLO.COD_OLO, OLO.CODFC_OLO_AGCOM, FLG_NAMESPACE_F_NOTIF&#xa;  FROM OLO OLO, SISTEMA_IP_INTRFC INTR&#xa;  WHERE OLO.CODFC_OLO_AGCOM = INTR.CODFC_OLO_AGCOM AND INTR.ID_INTRFC = ?&#xa;  AND INTR.ID_SISTEMA = ? AND FLAG_ENABLED = 'Y'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDInterfacciaNGA"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDSistema"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLG_NAMESPACE_F_NOTIF"
                                    dataType="1"
                                    status="OptionalElement" typeName="CHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="4183d15e-8c60-411a-bb86-445428a7f2ed">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToExit"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBC_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_OLO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToNGAScheduler" tibex:linkType="SUCCESS"/>
                                <bpws:link name="NGASchedulerToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="NGASchedulerToError" tibex:linkType="ERROR"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="512044be-9505-4edc-971a-bd541effd448">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToNGAScheduler"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="f9de7726-0fe7-4002-9f62-1824032fd467">
                                <bpws:targets>
                                    <bpws:target linkName="NGASchedulerToGroupEnd"/>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Error-input"
                                    name="Error"
                                    tibex:xpdlId="fda7dfcb-b703-4f47-884b-cd7f5a3582a1"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="NGASchedulerToError"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerGiornalieroNGA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nella creazione file per l'OLO: &amp;quot;, $JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM, &amp;quot;.&amp;quot;)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="NGAScheduler-input"
                                name="NGAScheduler"
                                operation="NGAScheduler"
                                partnerLink="NGASchedulerPortType"
                                portType="ns4:NGASchedulerPortType" tibex:xpdlId="7bd7e813-97cb-4648-95fc-3537beefc861">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" version="2.0"&gt;&lt;xsl:param name="JDBC_OLO"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:template name="NGAScheduler-input" match="/"&gt;&lt;tns:NGASchedulerRequest&gt;&lt;SchedulerInput&gt;&lt;tns1:SchedulerInput&gt;&lt;tns1:TempoNotifica&gt;&lt;xsl:value-of select="&amp;quot;GIORNALIERO&amp;quot;"/&gt;&lt;/tns1:TempoNotifica&gt;&lt;tns1:StrutturaRichiesta&gt;&lt;xsl:value-of select="&amp;quot;NGA&amp;quot;"/&gt;&lt;/tns1:StrutturaRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/COD_OLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;tns1:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM"/&gt;&lt;/tns1:CodiceOLOAGCOM&gt;&lt;xsl:if test="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"&gt;&lt;tns1:FlagNamespaceFileNotifica&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"/&gt;&lt;/tns1:FlagNamespaceFileNotifica&gt;&lt;/xsl:if&gt;&lt;/tns1:SchedulerInput&gt;&lt;/SchedulerInput&gt;&lt;/tns:NGASchedulerRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;NGAScheduler-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SchedulerInput>&#xa;            &lt;tns1:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GIORNALIERO&amp;quot;&quot;/>&#xa;            &lt;/tns1:TempoNotifica>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NGA&amp;quot;&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/COD_OLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;>&#xa;                &lt;tns1:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;/>&#xa;                &lt;/tns1:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:SchedulerInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToNGAScheduler"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source
                                    linkName="NGASchedulerToError"
                                    tibex:faultDetailsVar="SchedulerNGAInvoke" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="NGASchedulerToGroupEnd"/>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="272b3c95-2dfc-4e05-b16f-faecc754b96c">
                <bpws:targets>
                    <bpws:target linkName="WhileToExit"/>
                    <bpws:target linkName="LogTimer_FaultToExit"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogJDBC_OLO-input"
                    name="LogJDBC_OLO"
                    tibex:xpdlId="ac232350-12cd-4efe-9fd6-cf08d853183f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_OLOToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogJDBC_OLO-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerGiornalieroNGA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;JDBC_OLO: &amp;quot;, tib:render-xml($JDBC_OLO, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.nga&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($JDBC_OLO)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($JDBC_OLO, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DateTimeAvvio"
                    name="AssignDateTime" outputVariable="DateTimeAvvio"
                    tibex:xpdlId="9f2d0a31-eb21-4736-98e0-093dbc2b2225" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="TimerGiornoToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignDateTimeToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="current-dateTime()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DateTimeAvvio" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="cdf6a808-3bf0-4369-bb91-8a97003b0147"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignDateTimeToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToJDBC_OLO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="hours-from-dateTime($DateTimeAvvio) = hours-from-dateTime($DataTimeGiornaliero) and minutes-from-dateTime($DateTimeAvvio) = minutes-from-dateTime($DataTimeGiornaliero)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[hours-from-dateTime($DateTimeAvvio) = hours-from-dateTime($DataTimeGiornaliero) and minutes-from-dateTime($DateTimeAvvio) = minutes-from-dateTime($DataTimeGiornaliero)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;DateTimeAvvio&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerGiornalieroNGA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Valorizzato DateTime avvio: &amp;quot;, string($DateTimeAvvio))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.nga&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(concat(&amp;quot;Avvio Scheduler Giornaliero NGA: &amp;quot;, string($DateTimeAvvio))))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;concat(&amp;quot;Avvio Scheduler Giornaliero NGA: &amp;quot;, string($DateTimeAvvio))&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogTimer_Fault-input"
                    name="LogTimer_Fault"
                    tibex:xpdlId="77e04bdc-0417-4421-9261-a0f5fcc5b06f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogTimer_FaultToExit"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;DataTimeGiornaliero&quot;/>&lt;xsl:param name=&quot;DateTimeAvvio&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogTimer_Fault-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerGiornalieroNGA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Orario non congruente per la creazione del file giornaliero: Ora Avvio = &amp;quot;, string(hours-from-dateTime($DateTimeAvvio)), &amp;quot; Ora Variabile = &amp;quot;, string(hours-from-dateTime($DataTimeGiornaliero)), &amp;quot; Minuti Avvio = &amp;quot;, string(minutes-from-dateTime($DateTimeAvvio)), &amp;quot; Minuti Variabile = &amp;quot;, string(minutes-from-dateTime($DataTimeGiornaliero)))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
