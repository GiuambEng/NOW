    <bpws:partnerLinks>
        <bpws:partnerLink name="NGASchedulerPortType"
            partnerLinkType="ns0:partnerLinkType1" partnerRole="use"
            sca-bpel:ignore="true"
            sca-bpel:reference="NGASchedulerPortType" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceBinding>
                <tibex:binding>
                    <bwbinding:BWBaseBinding
                        xmlns:NGASchedulerPortType="http://www.tim.com/NOW/wsdl/concrete/NGASchedulerPortType/"
                        xmlns:NotificationScheduler="http://www.tim.com/NOW/xsd/NotificationScheduler"
