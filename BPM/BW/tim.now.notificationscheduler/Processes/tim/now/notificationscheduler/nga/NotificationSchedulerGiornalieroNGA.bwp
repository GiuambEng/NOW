                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding name="NGASchedulerPortType" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/#wsdl.interface(NGASchedulerPortType)" scaext:wsdlLocation="../../../../../Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl"/>
                            <scaext:binding
                                destination="tim.now.notification.scheduler.creazionefile"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
                                portName="NGASchedulerPortTypeSOAP"
                                portTypeQName="pt:NGASchedulerPortType"
                                portTypeWSDLLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl"
                                serviceBindingQName="NGASchedulerPortType:NGAScheduler_SOAPService"
                                serviceQName="NGASchedulerPortType:NGASchedulerPortType"
                                transportBindingType="JMS"
                                wsdlLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManagerConcrete/NGANotificationScheduler_concrete.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="NGAScheduler" operationName="NGAScheduler">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:NGASchedulerRequest" wsdlLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="NotificationScheduler:SchedulerInput"
