                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+22b64532-df0f-4aba-a8d1-a577816205de+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistemaOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDInterfacciaXDSL>&#xa;                &lt;xsl:value-of select=&quot;$IDInterfacciaXDSL&quot;/>&#xa;            &lt;/IDInterfacciaXDSL>&#xa;            &lt;IDSistema>&#xa;                &lt;xsl:value-of select=&quot;$IDSistemaOLO&quot;/>&#xa;            &lt;/IDSistema>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OLO.COD_OLO, OLO.CODFC_OLO_AGCOM, FLG_NAMESPACE_F_NOTIF&#xa;  FROM OLO OLO, SISTEMA_IP_INTRFC INTR&#xa;  WHERE OLO.CODFC_OLO_AGCOM = INTR.CODFC_OLO_AGCOM AND INTR.ID_INTRFC = ?&#xa;  AND INTR.ID_SISTEMA = ? AND FLAG_ENABLED = 'Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDInterfacciaXDSL"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDSistema"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLG_NAMESPACE_F_NOTIF"
                                    dataType="1"
                                    status="OptionalElement" typeName="CHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="2ec9ad70-e070-4c9b-8294-76d98a9f02ee">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="__Link3"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while" tibex:xpdlId="3689ff45-8521-4259-a693-38008c0fb915">
                    <bpws:empty name="GroupInit" tibex:group="groupInit" tibex:xpdlId="f2f7f716-1f1a-48f6-ae78-861e6b09424d"/>
                    <bpws:while name="while" tibex:counterName="index" tibex:xpdlId="b71773fa-504b-445d-bbdc-4c07c81413d1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBC_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_OLO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1" tibex:xpdlId="1bf8cb24-f988-4d8d-8e67-2c03dc80759d">
                            <bpws:links>
                                <bpws:link name="InvokeToError" tibex:linkType="ERROR"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="3f13d743-d870-4bbc-9173-2b53e657b74a">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToGroupEnd"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="e24bceaf-05bc-45c2-bba9-38278e50cd5f">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    <bpws:target linkName="InvokeToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Error-input"
                                    name="Error"
                                    tibex:xpdlId="edcb3e74-9f62-4cc9-b22a-6a4a1ffdf8f7"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeToError"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioXDSL&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nella creazione file per l'OLO: &amp;quot;, $JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM, &amp;quot;.&amp;quot;)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="XDSLScheduler-input"
                                name="XDSLScheduler"
                                operation="XDSLScheduler"
                                partnerLink="XDSLSchedulerPortType"
                                portType="ns0:XDSLSchedulerPortType" tibex:xpdlId="5ea8c8f6-a7f9-4696-8300-e1f9c51d143e">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="JDBC_OLO"/&gt;&lt;xsl:template name="XDSLScheduler-input" match="/"&gt;&lt;tns:XDSLSchedulerRequest&gt;&lt;SchedulerInput&gt;&lt;tns1:SchedulerInput&gt;&lt;tns1:TempoNotifica&gt;&lt;xsl:value-of select="&amp;quot;ORARIO&amp;quot;"/&gt;&lt;/tns1:TempoNotifica&gt;&lt;tns1:StrutturaRichiesta&gt;&lt;xsl:value-of select="&amp;quot;XDSL&amp;quot;"/&gt;&lt;/tns1:StrutturaRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/COD_OLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;tns1:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM"/&gt;&lt;/tns1:CodiceOLOAGCOM&gt;&lt;xsl:if test="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"&gt;&lt;tns1:FlagNamespaceFileNotifica&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"/&gt;&lt;/tns1:FlagNamespaceFileNotifica&gt;&lt;/xsl:if&gt;&lt;/tns1:SchedulerInput&gt;&lt;/SchedulerInput&gt;&lt;/tns:XDSLSchedulerRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;XDSLScheduler-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SchedulerInput>&#xa;            &lt;tns1:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORARIO&amp;quot;&quot;/>&#xa;            &lt;/tns1:TempoNotifica>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/COD_OLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;>&#xa;                &lt;tns1:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;/>&#xa;                &lt;/tns1:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:SchedulerInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToGroupEnd"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                    <bpws:source
                                    linkName="InvokeToError"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="6f4af8cc-1c8c-44e2-b9ca-45bb388f2359">
                <bpws:targets>
                    <bpws:target linkName="__Link3"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogJDBC_OLO-input"
                    name="LogJDBC_OLO"
                    tibex:xpdlId="45529328-c47d-4e8a-b558-d705e11352f3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_OLOToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogJDBC_OLO-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioXDSL&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;JDBC_OLO: &amp;quot;, tib:render-xml($JDBC_OLO, true(),true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.xdsl&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($JDBC_OLO)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($JDBC_OLO, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
