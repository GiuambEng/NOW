                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeToError"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerGiornalieroXDSL&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nella creazione file per l'OLO: &amp;quot;, $JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM, &amp;quot;.&amp;quot;)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="XDSLScheduler-input"
                                name="XDSLScheduler"
                                operation="XDSLScheduler"
                                partnerLink="XDSLSchedulerPortType"
                                portType="ns0:XDSLSchedulerPortType" tibex:xpdlId="e2ead932-77d5-4763-b8e1-7fe2a2e157af">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/" xmlns:tns1="http://www.tim.com/NOW/xsd/NotificationScheduler" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="JDBC_OLO"/&gt;&lt;xsl:template name="XDSLScheduler-input" match="/"&gt;&lt;tns:XDSLSchedulerRequest&gt;&lt;SchedulerInput&gt;&lt;tns1:SchedulerInput&gt;&lt;tns1:TempoNotifica&gt;&lt;xsl:value-of select="&amp;quot;GIORNALIERO&amp;quot;"/&gt;&lt;/tns1:TempoNotifica&gt;&lt;tns1:StrutturaRichiesta&gt;&lt;xsl:value-of select="&amp;quot;XDSL&amp;quot;"/&gt;&lt;/tns1:StrutturaRichiesta&gt;&lt;tns1:CodiceOLO&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/COD_OLO"/&gt;&lt;/tns1:CodiceOLO&gt;&lt;tns1:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM"/&gt;&lt;/tns1:CodiceOLOAGCOM&gt;&lt;xsl:if test="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"&gt;&lt;tns1:FlagNamespaceFileNotifica&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"/&gt;&lt;/tns1:FlagNamespaceFileNotifica&gt;&lt;/xsl:if&gt;&lt;/tns1:SchedulerInput&gt;&lt;/SchedulerInput&gt;&lt;/tns:XDSLSchedulerRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;XDSLScheduler-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SchedulerInput>&#xa;            &lt;tns1:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;GIORNALIERO&amp;quot;&quot;/>&#xa;            &lt;/tns1:TempoNotifica>&#xa;            &lt;tns1:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;XDSL&amp;quot;&quot;/>&#xa;            &lt;/tns1:StrutturaRichiesta>&#xa;            &lt;tns1:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/COD_OLO&quot;/>&#xa;            &lt;/tns1:CodiceOLO>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;>&#xa;                &lt;tns1:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;/>&#xa;                &lt;/tns1:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:SchedulerInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source
                                    linkName="InvokeToError"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="3dca52f7-2cfe-45b7-b8a8-c610a7bf7bb3">
                <bpws:targets>
                    <bpws:target linkName="__Link3"/>
                    <bpws:target linkName="CallProcessToExit"/>
