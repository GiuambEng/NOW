                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while" tibex:xpdlId="e6cfa11d-f4dc-4cd2-afe4-fa5ae382cf66">
                    <bpws:empty name="GroupInit" tibex:group="groupInit" tibex:xpdlId="594b6441-b51e-4a9b-b6fe-0d82dfc62891"/>
                    <bpws:while name="while" tibex:counterName="index" tibex:xpdlId="52661d86-6cf1-4a23-a282-eb67632e6b48">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBC_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_OLO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1" tibex:xpdlId="af3d2c26-82ea-48e3-a11c-6790c3d445fe">
                            <bpws:links>
                                <bpws:link name="InvokeToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToError" tibex:linkType="ERROR"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
