    <bpws:partnerLinks>
        <bpws:partnerLink name="XDSLSchedulerPortType"
            partnerLinkType="ns4:partnerLinkType" partnerRole="use"
            sca-bpel:ignore="true"
            sca-bpel:reference="XDSLSchedulerPortType" sca-bpel:wiredByImpl="false">
            <tibex:ReferenceBinding>
                <tibex:binding>
                    <bwbinding:BWBaseBinding
                        xmlns:NotificationScheduler="http://www.tim.com/NOW/xsd/NotificationScheduler"
                        xmlns:XDSLPortType="http://www.tim.com/NOW/wdl/concrete/XDSLPortType/"
                        xmlns:axis2="http://xsd.tns.tibco.com/bw/models/binding/soap/axis2"
                        xmlns:bwbinding="http://tns.tibco.com/bw/model/core/bwbinding"
                        xmlns:pt="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/"
                        xmlns:sca="http://www.osoa.org/xmlns/sca/1.0"
                        xmlns:scact="http://xsd.tns.tibco.com/amf/models/sca/componentType"
                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding name="XDSLSchedulerPortType" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/#wsdl.interface(XDSLSchedulerPortType)" scaext:wsdlLocation="../../../../../Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl"/>
                            <scaext:binding
                                destination="tim.now.notification.scheduler.creazionefile"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
                                portName="XDSLSchedulerPortTypeSOAP"
                                portTypeQName="pt:XDSLSchedulerPortType"
                                portTypeWSDLLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl"
                                serviceBindingQName="XDSLPortType:XDSLScheduler_SOAPService"
                                serviceQName="XDSLPortType:XDSLSchedulerPortType"
                                transportBindingType="JMS"
                                wsdlLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManagerConcrete/XDSLNotificationScheduler_concrete.wsdl" xsi:type="axis2:SOAPReferenceBinding">
                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="XDSLScheduler" operationName="XDSLScheduler">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:XDSLSchedulerRequest" wsdlLocation="platform:/resource/tim.now.notificationscheduler/Service%20Descriptors/NotificationManager/NotificationScheduler.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="NotificationScheduler:SchedulerInput"
                                    partName="SchedulerInput" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    jmsResource="tim.now.shared_library.jndi.JMSConnectionResource" xsi:type="axis2:JMSOutboundTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding">
                                <sca:property name="destination" scaext:simpleValue="/CodeJMS/NotificationSchedulerCodaXDSL"/>
                            </scact:bindingAdjunct>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
