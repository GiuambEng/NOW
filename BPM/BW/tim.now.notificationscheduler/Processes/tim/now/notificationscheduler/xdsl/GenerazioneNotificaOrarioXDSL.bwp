                <bpws:scope name="scope1">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="GenericLoggerToExit1" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="GenericLogger-input"
                                name="GenericLogger"
                                tibex:xpdlId="b8a442a9-7743-4ea6-b7bf-3fb38eec41fd"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToExit1"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'GenerazioneNotificaOrarioXDSL'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'GenerazioneNotificaOrarioXDSL'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'GenerazioneNotificaOrarioXDSL'&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat($FaultDetails/ActivityName, $FaultDetails/StackTrace,$FaultDetails/ProcessStack,$FaultDetails/MsgCode,$FaultDetails/Msg)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:exit name="Exit1" tibex:xpdlId="c65752c7-6f14-4949-852d-c227db9ae676">
                            <bpws:targets>
                                <bpws:target linkName="GenericLoggerToExit1"/>
                            </bpws:targets>
                        </bpws:exit>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="CallProcessToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="__Link3" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBC_OLOToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="ScopeToConfirm" tibex:linkType="SUCCESS"/>
                <bpws:link name="ConfirmToJDBC_OLO" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBC_OLO-input"
                    name="JDBC_OLO" outputVariable="JDBC_OLO"
                    tibex:xpdlId="22b64532-df0f-4aba-a8d1-a577816205de" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ConfirmToJDBC_OLO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_OLOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+22b64532-df0f-4aba-a8d1-a577816205de+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;IDInterfacciaXDSL&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistemaOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_OLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDInterfacciaXDSL>&#xa;                &lt;xsl:value-of select=&quot;$IDInterfacciaXDSL&quot;/>&#xa;            &lt;/IDInterfacciaXDSL>&#xa;            &lt;IDSistema>&#xa;                &lt;xsl:value-of select=&quot;$IDSistemaOLO&quot;/>&#xa;            &lt;/IDSistema>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OLO.COD_OLO, OLO.CODFC_OLO_AGCOM, FLG_NAMESPACE_F_NOTIF&#xa;  FROM OLO OLO, SISTEMA_IP_INTRFC INTR&#xa;  WHERE OLO.CODFC_OLO_AGCOM = INTR.CODFC_OLO_AGCOM AND INTR.ID_INTRFC = ?&#xa;  AND INTR.ID_SISTEMA = ? AND FLAG_ENABLED = 'Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDInterfacciaXDSL"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDSistema"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLG_NAMESPACE_F_NOTIF"
                                    dataType="1"
                                    status="OptionalElement" typeName="CHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="2ec9ad70-e070-4c9b-8294-76d98a9f02ee">
                <bpws:targets>
