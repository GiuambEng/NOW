                        <tibex:inputBinding
                            expression="if (string-length(concat(xsd:string($IDFile/Record[1]/NEXTVAL), &quot;_&quot;, xsd:string($S_CONTENUTO_FILE/Record[1]/NEXTVAL))) > 32) then substring(concat(xsd:string($IDFile/Record[1]/NEXTVAL), &quot;_&quot;, xsd:string($S_CONTENUTO_FILE/Record[1]/NEXTVAL)), 1, 32) else if (string-length(concat(xsd:string($IDFile/Record[1]/NEXTVAL), &quot;_&quot;, xsd:string($S_CONTENUTO_FILE/Record[1]/NEXTVAL))) = 32) then concat(xsd:string($IDFile/Record[1]/NEXTVAL), &quot;_&quot;, xsd:string($S_CONTENUTO_FILE/Record[1]/NEXTVAL)) else tib:pad-front(concat(xsd:string($IDFile/Record[1]/NEXTVAL), &quot;_&quot;, xsd:string($S_CONTENUTO_FILE/Record[1]/NEXTVAL)), 32, &quot;0&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
