                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/Token/&quot; xmlns:tns6=&quot;http://www.example.com/namespaces/tns/1564740682912&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileIn.ZipFileInput&quot;/>&#xa;    &lt;xsl:param name=&quot;GetLocalIP&quot;/>&#xa;    &lt;xsl:param name=&quot;CHIAVE&quot;/>&#xa;    &lt;xsl:template name=&quot;Token-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:Request>&#xa;            &lt;tns5:RequestCreate_token>&#xa;                &lt;tns5:CodificaOLOAGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;                &lt;/tns5:CodificaOLOAGCOM>&#xa;                &lt;tns5:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:CodiceOLO&quot;/>&#xa;                &lt;/tns5:CodiceOrdineOLO>&#xa;                &lt;tns5:Funzione>&#xa;                    &lt;xsl:value-of select=&quot;'NOTFILEOUT'&quot;/>&#xa;                &lt;/tns5:Funzione>&#xa;                &lt;tns5:ChiaveRiferimento>&#xa;                    &lt;xsl:value-of select=&quot;string(tib:timestamp())&quot;/>&#xa;                &lt;/tns5:ChiaveRiferimento>&#xa;                &lt;tns5:Operatore>&#xa;                    &lt;xsl:value-of select=&quot;'NOW'&quot;/>&#xa;                &lt;/tns5:Operatore>&#xa;                &lt;xsl:if test=&quot;$GetLocalIP/tns6:IPAddress&quot;>&#xa;                    &lt;tns5:IPClient>&#xa;                        &lt;xsl:value-of select=&quot;$GetLocalIP/tns6:IPAddress&quot;/>&#xa;                    &lt;/tns5:IPClient>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Note>&#xa;                    &lt;xsl:value-of select=&quot;$CHIAVE&quot;/>&#xa;                &lt;/tns5:Note>&#xa;            &lt;/tns5:RequestCreate_token>&#xa;            &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:ProcessIstanceID&quot;>&#xa;                &lt;tns5:ProcessIstance>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:ProcessIstanceID&quot;/>&#xa;                &lt;/tns5:ProcessIstance>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
