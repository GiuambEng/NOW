               &lt;/xsl:if>&#xa;                &lt;tns5:Note>&#xa;                    &lt;xsl:value-of select=&quot;$CHIAVE&quot;/>&#xa;                &lt;/tns5:Note>&#xa;            &lt;/tns5:RequestCreate_token>&#xa;            &lt;xsl:if test=&quot;$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:ProcessIstanceID&quot;>&#xa;                &lt;tns5:ProcessIstance>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:ProcessIstanceID&quot;/>&#xa;                &lt;/tns5:ProcessIstance>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Token-input" name="Token"
