                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;ZipFileIn&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;LOG_Fault-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ZipFilePortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:ProcessIstanceID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:ProcessIstanceID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($FaultDetails)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Errore ZipFile: &amp;quot;, tib:render-xml($FaultDetails, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Errore Processo ZipFile.&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="LOG_Fault-input"
                                name="LOG_Fault"
                                tibex:xpdlId="5d6532e5-1c02-4ae4-a391-9c675ef0ed6f"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToReply"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileIn.ZipFileInput&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Fault-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ZipFilePortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:ProcessIstanceID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:ProcessIstanceID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FaultDetails)&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Errore ZipFile: &amp;quot;, tib:render-xml($FaultDetails, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Errore Processo ZipFile.&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="DBInsertInvokeToLoggerInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="LoggerInvokeToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="SistemaIPInterfacciaProcessToIP_INTERFACCIA" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link
                    name="SistemaIPInterfacciaProcessToLOG_LocalPathAssente" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LOG_LocalPathAssenteToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="IP_INTERFACCIAToZipFileInvoke" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallProcessToDBInsertInvoke2" tibex:linkType="SUCCESS"/>
                <bpws:link name="RenameFileToGenericLogger1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LOG_RenameFileFaultToRemoveFile1" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFileToCallProcess" tibex:linkType="ERROR"/>
                <bpws:link name="LOG_RemoveFileFaultToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="IP_INTERFACCIAToEmpty" tibex:label="NP" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RenameFileToLOG_RenameFileFault" tibex:linkType="ERROR"/>
                <bpws:link name="ZipFileInToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LOG_InputToJDBCQuery1" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToWriteFileOut" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFileToEmpty1" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQueryToGetLocalIP" tibex:linkType="SUCCESS"/>
                <bpws:link name="GetLocalIPToJDBCQuery1" tibex:linkType="SUCCESS"/>
                <bpws:link name="JDBCQuery1ToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="JDBCQuery1ToSistemaIPInterfacciaProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EmptyToDBInsertInvoke" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Empty1ToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Empty1ToDBInsertInvoke" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="AssignToToken" tibex:linkType="SUCCESS"/>
                <bpws:link name="TokenToGenericLogger" tibex:linkType="ERROR"/>
                <bpws:link name="GenericLoggerToDBInsertInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="TokenToDBInsertInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLogger1ToRemoveFile" tibex:linkType="SUCCESS"/>
                <bpws:link name="RemoveFile1ToThrow" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes" name="ZipFileIn"
                operation="ZipFile" partnerLink="ZipFilePortType"
                portType="ns19:ZipFilePortType"
                tibex:xpdlId="e26a2806-6dac-4842-ba08-0f8b5c7b2873" variable="ZipFileIn">
                <bpws:sources>
                    <bpws:source linkName="ZipFileInToCallProcess"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:receive>
            <bpws:reply name="WriteFileOut" operation="ZipFile"
                partnerLink="ZipFilePortType"
                portType="ns19:ZipFilePortType"
                tibex:xpdlId="63012711-4b63-4541-ac4d-bce7a9ad3c40" variable="WriteFileOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/WriteFile" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" version="2.0"&gt;&lt;xsl:param name="DBInsertInvoke"/&gt;&lt;xsl:param name="_error_RemoveFile"/&gt;&lt;xsl:param name="SistemaIPInterfacciaProcess"/&gt;&lt;xsl:template name="WriteFileOut-input" match="/"&gt;&lt;tns4:ZipFileResponse&gt;&lt;ZipFileOutput&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error_RemoveFile) or string-length($SistemaIPInterfacciaProcess) = 0"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error_RemoveFile)"&gt;&lt;tns1:ZipFileResponse&gt;&lt;tns1:Esito&gt;&lt;xsl:value-of select="&amp;quot;Errore eliminazione file.&amp;quot;"/&gt;&lt;/tns1:Esito&gt;&lt;/tns1:ZipFileResponse&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ZipFileResponse&gt;&lt;tns1:Esito&gt;&lt;xsl:value-of select="&amp;quot;OLO non abilitato.&amp;quot;"/&gt;&lt;/tns1:Esito&gt;&lt;/tns1:ZipFileResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ZipFileResponse&gt;&lt;tns1:Esito&gt;&lt;xsl:value-of select="&amp;quot;File notifica creato.&amp;quot;"/&gt;&lt;/tns1:Esito&gt;&lt;tns1:IDFile&gt;&lt;xsl:value-of select="xsd:int($DBInsertInvoke/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/tns1:IDFile&gt;&lt;/tns1:ZipFileResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/ZipFileOutput&gt;&lt;/tns4:ZipFileResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DBInsertInvoke.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_RemoveFile&quot;/>&#xa;    &lt;xsl:param name=&quot;SistemaIPInterfacciaProcess&quot;/>&#xa;    &lt;xsl:template name=&quot;WriteFileOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($_error_RemoveFile) or string-length($SistemaIPInterfacciaProcess) = 0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($_error_RemoveFile)&quot;>&#xa;                        &lt;tns1:ZipFileResponse>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Errore eliminazione file.&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Esito>&#xa;                        &lt;/tns1:ZipFileResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:ZipFileResponse>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OLO non abilitato.&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Esito>&#xa;                        &lt;/tns1:ZipFileResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:ZipFileResponse>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;File notifica creato.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;tns1:IDFile>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($DBInsertInvoke.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                    &lt;/tns1:IDFile>&#xa;                &lt;/tns1:ZipFileResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWriteFileOut"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:invoke inputVariable="DBInsertInvoke-input"
                name="DBInsertInvoke" operation="Insert"
                outputVariable="DBInsertInvoke" partnerLink="Logger"
                portType="ns7:ProcessLog" tibex:xpdlId="3ffa975b-afe4-47c0-98d8-9776db125d67">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/WriteFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns6="http://www.tim.com/NOW/xsd/Token/" version="2.0"&gt;
    &lt;xsl:param name="ZipFileIn"/&gt;
    &lt;xsl:param name="RenameFile"/&gt;
    &lt;xsl:param name="Oscuramento"/&gt;
    &lt;xsl:param name="IDFile"/&gt;
    &lt;xsl:param name="CHIAVE"/&gt;
    &lt;xsl:param name="S_CONTENUTO_FILE"/&gt;
    &lt;xsl:param name="Token"/&gt;
    &lt;xsl:template name="DBInsertInvoke-input" match="/"&gt;
        &lt;tns5:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:ProcFile&gt;
                        &lt;ns:ID_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:IDProcsoFile"/&gt;
                        &lt;/ns:ID_PROCSO_FILE&gt;
                    &lt;/ns:ProcFile&gt;
                    &lt;ns:FileProcessato&gt;
                        &lt;ns:COD_OLO&gt;
                            &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:CodiceOLO"/&gt;
                        &lt;/ns:COD_OLO&gt;
                        &lt;ns:CODFC_OLO_AGCOM&gt;
                            &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:CodiceOLOAGCOM"/&gt;
                        &lt;/ns:CODFC_OLO_AGCOM&gt;
                        &lt;ns:DATA_FILE&gt;
                            &lt;xsl:value-of select="string(current-date())"/&gt;
                        &lt;/ns:DATA_FILE&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullNameCPS='NPNG' and $ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Size=0"&gt;
                                &lt;ns:DESCR_STATO_FILE&gt;
                                    &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                                &lt;/ns:DESCR_STATO_FILE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns:DESCR_STATO_FILE&gt;
                                    &lt;xsl:value-of select="&amp;quot;DA INVIARE&amp;quot;"/&gt;
                                &lt;/ns:DESCR_STATO_FILE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;ns:ESITO&gt;
                            &lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;
                        &lt;/ns:ESITO&gt;
                        &lt;xsl:if test="count($Oscuramento/Record)=0 or $Oscuramento/Record[1]/FLAG_OSCURMENTO='0'"&gt;
                            &lt;ns:ID_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer($IDFile/Record[1]/NEXTVAL)"/&gt;
                            &lt;/ns:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns:ID_INTRFC&gt;
                            &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:IDInterfaccia"/&gt;
                        &lt;/ns:ID_INTRFC&gt;
                        &lt;ns:IDTPLG_FILE&gt;
                            &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:IDTipologiaFile"/&gt;
                        &lt;/ns:IDTPLG_FILE&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:StrutturaRichiesta = &amp;quot;NPR&amp;quot; or string-length($ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullNameCPS)&gt;0"&gt;
                                &lt;xsl:if test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FileName"&gt;
                                    &lt;ns:NOME_FILE&gt;
                                        &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FileName"/&gt;
                                    &lt;/ns:NOME_FILE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns:NOME_FILE&gt;
                                    &lt;xsl:value-of select="$RenameFile/fileInfo/fileName"/&gt;
                                &lt;/ns:NOME_FILE&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;ns:TIMSTP_APERTURA_FILE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TIMSTP_APERTURA_FILE&gt;
                        &lt;ns:VERSO_DEL_FILE&gt;
                            &lt;xsl:value-of select="&amp;quot;OUTPUT&amp;quot;"/&gt;
                        &lt;/ns:VERSO_DEL_FILE&gt;
                    &lt;/ns:FileProcessato&gt;
                    &lt;ns:EsecuzioneFile&gt;
                        &lt;ns:ID_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="xsd:int($ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:IDProcsoFile)"/&gt;
                        &lt;/ns:ID_PROCSO_FILE&gt;
                        &lt;ns:STATO_ESEC&gt;
                            &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;"/&gt;
                        &lt;/ns:STATO_ESEC&gt;
                        &lt;ns:TMSP_FINE_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TMSP_FINE_ELAB&gt;
                        &lt;ns:TMSP_INIZIO_ELAB&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TMSP_INIZIO_ELAB&gt;
                    &lt;/ns:EsecuzioneFile&gt;
                    &lt;ns:LogFileProcessato&gt;
                        &lt;xsl:if test="$Token/tns6:ResponseCreate_token/tns6:Token"&gt;
                            &lt;ns:COD_PROCSO&gt;
                                &lt;xsl:value-of select="$Token/tns6:ResponseCreate_token/tns6:Token"/&gt;
                            &lt;/ns:COD_PROCSO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="count($S_CONTENUTO_FILE/Record)&gt;0"&gt;
                            &lt;ns:ID_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer($S_CONTENUTO_FILE/Record[1]/NEXTVAL)"/&gt;
                            &lt;/ns:ID_FILE&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns:LogFileProcessato&gt;
                    &lt;ns:FileProcessatoOutput&gt;
                        &lt;xsl:if test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Size"&gt;
                            &lt;ns:DIMENSIONE_FILE&gt;
                                &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Size"/&gt;
                            &lt;/ns:DIMENSIONE_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="string-length($ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Tokenizzazione)&gt;0"&gt;
                            &lt;xsl:if test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Tokenizzazione"&gt;
                                &lt;ns:ESITO_INVIO&gt;
                                    &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Tokenizzazione"/&gt;
                                &lt;/ns:ESITO_INVIO&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns:QT_RECD_TOTALI&gt;
                            &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:NumeroRecord"/&gt;
                        &lt;/ns:QT_RECD_TOTALI&gt;
                        &lt;ns:TIMSTP_CREZIONE_FILE&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/ns:TIMSTP_CREZIONE_FILE&gt;
                    &lt;/ns:FileProcessatoOutput&gt;
                    &lt;ns:ContenutoFile&gt;
                        &lt;xsl:if test="string-length($CHIAVE)&gt;0"&gt;
                            &lt;ns:ID_CONTENUTO_FILE&gt;
                                &lt;xsl:value-of select="$CHIAVE"/&gt;
                            &lt;/ns:ID_CONTENUTO_FILE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullNameCPS)&gt;0"&gt;
                                &lt;xsl:if test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullName"&gt;
                                    &lt;ns:FullName&gt;
                                        &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullName"/&gt;
                                    &lt;/ns:FullName&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:when test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:StrutturaRichiesta = &amp;quot;NPR&amp;quot;"&gt;
                                &lt;xsl:if test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullName"&gt;
                                    &lt;ns:FullName&gt;
                                        &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullName"/&gt;
                                    &lt;/ns:FullName&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;ns:FullName&gt;
                                    &lt;xsl:value-of select="$RenameFile/fileInfo/fullName"/&gt;
                                &lt;/ns:FullName&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Size"&gt;
                            &lt;ns:Size&gt;
                                &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:Size"/&gt;
                            &lt;/ns:Size&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="(count($Oscuramento/Record)=0 or $Oscuramento/Record[1]/FLAG_OSCURMENTO='0') and $Token/tns6:ResponseCreate_token/tns6:ESITO='OK' and string-length($Token/tns6:ResponseCreate_token/tns6:Token)&gt;0"&gt;
                            &lt;ns:Token&gt;
                                &lt;xsl:value-of select="'Token'"/&gt;
                            &lt;/ns:Token&gt;
                        &lt;/xsl:if&gt;
                    &lt;/ns:ContenutoFile&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns5:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/Token/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileIn.ZipFileInput&quot;/>&#xa;    &lt;xsl:param name=&quot;RenameFile&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;IDFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CHIAVE&quot;/>&#xa;    &lt;xsl:param name=&quot;S_CONTENUTO_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;Token&quot;/>&#xa;    &lt;xsl:template name=&quot;DBInsertInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:IDProcsoFile&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;ns:COD_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:CodiceOLO&quot;/>&#xa;                &lt;/ns:COD_OLO>&#xa;                &lt;ns:CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;                &lt;/ns:CODFC_OLO_AGCOM>&#xa;                &lt;ns:DATA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;string(current-date())&quot;/>&#xa;                &lt;/ns:DATA_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ZipFileIn.ZipFileInput/tns1:FullNameCPS='NPNG' and $ZipFileIn.ZipFileInput/tns1:Size=0&quot;>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ESITO>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                &lt;/ns:ESITO>&#xa;                &lt;xsl:if test=&quot;count($Oscuramento/Record)=0 or $Oscuramento/Record[1]/FLAG_OSCURMENTO='0'&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($IDFile/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_INTRFC>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:IDInterfaccia&quot;/>&#xa;                &lt;/ns:ID_INTRFC>&#xa;                &lt;ns:IDTPLG_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:IDTipologiaFile&quot;/>&#xa;                &lt;/ns:IDTPLG_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$ZipFileIn.ZipFileInput/tns1:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $ZipFileIn.ZipFileInput/tns1:StrutturaRichiesta = &amp;quot;NPR&amp;quot; or string-length($ZipFileIn.ZipFileInput/tns1:FullNameCPS)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:FileName&quot;>&#xa;                            &lt;ns:NOME_FILE>&#xa;                                &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:FileName&quot;/>&#xa;                            &lt;/ns:NOME_FILE>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:NOME_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/fileName&quot;/>&#xa;                        &lt;/ns:NOME_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_APERTURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_APERTURA_FILE>&#xa;                &lt;ns:VERSO_DEL_FILE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;                &lt;/ns:VERSO_DEL_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($ZipFileIn.ZipFileInput/tns1:IDProcsoFile)&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;                &lt;ns:STATO_ESEC>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;&quot;/>&#xa;                &lt;/ns:STATO_ESEC>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;ns:TMSP_INIZIO_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_INIZIO_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$Token/tns6:ResponseCreate_token/tns6:Token&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$Token/tns6:ResponseCreate_token/tns6:Token&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($S_CONTENUTO_FILE/Record)>0&quot;>&#xa;                    &lt;ns:ID_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($S_CONTENUTO_FILE/Record[1]/NEXTVAL)&quot;/>&#xa;                    &lt;/ns:ID_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:LogFileProcessato>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:Size&quot;>&#xa;                    &lt;ns:DIMENSIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:Size&quot;/>&#xa;                    &lt;/ns:DIMENSIONE_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;string-length($ZipFileIn.ZipFileInput/tns1:Tokenizzazione)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:Tokenizzazione&quot;>&#xa;                        &lt;ns:ESITO_INVIO>&#xa;                            &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:Tokenizzazione&quot;/>&#xa;                        &lt;/ns:ESITO_INVIO>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:QT_RECD_TOTALI>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:NumeroRecord&quot;/>&#xa;                &lt;/ns:QT_RECD_TOTALI>&#xa;                &lt;ns:TIMSTP_CREZIONE_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CREZIONE_FILE>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;            &lt;ns:ContenutoFile>&#xa;                &lt;xsl:if test=&quot;string-length($CHIAVE)>0&quot;>&#xa;                    &lt;ns:ID_CONTENUTO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$CHIAVE&quot;/>&#xa;                    &lt;/ns:ID_CONTENUTO_FILE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($ZipFileIn.ZipFileInput/tns1:FullNameCPS)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:FullName&quot;>&#xa;                            &lt;ns:FullName>&#xa;                                &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:FullName&quot;/>&#xa;                            &lt;/ns:FullName>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$ZipFileIn.ZipFileInput/tns1:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $ZipFileIn.ZipFileInput/tns1:StrutturaRichiesta = &amp;quot;NPR&amp;quot;&quot;>&#xa;                        &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:FullName&quot;>&#xa;                            &lt;ns:FullName>&#xa;                                &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:FullName&quot;/>&#xa;                            &lt;/ns:FullName>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:FullName>&#xa;                            &lt;xsl:value-of select=&quot;$RenameFile/fileInfo/fullName&quot;/>&#xa;                        &lt;/ns:FullName>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:Size&quot;>&#xa;                    &lt;ns:Size>&#xa;                        &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:Size&quot;/>&#xa;                    &lt;/ns:Size>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;(count($Oscuramento/Record)=0 or $Oscuramento/Record[1]/FLAG_OSCURMENTO='0') and $Token/tns6:ResponseCreate_token/tns6:ESITO='OK' and string-length($Token/tns6:ResponseCreate_token/tns6:Token)>0&quot;>&#xa;                    &lt;ns:Token>&#xa;                        &lt;xsl:value-of select=&quot;'Token'&quot;/>&#xa;                    &lt;/ns:Token>&#xa;                &lt;/xsl:if>&#xa;            &lt;/ns:ContenutoFile>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="EmptyToDBInsertInvoke"/>
                    <bpws:target linkName="Empty1ToDBInsertInvoke"/>
                    <bpws:target linkName="GenericLoggerToDBInsertInvoke"/>
                    <bpws:target linkName="TokenToDBInsertInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DBInsertInvokeToLoggerInvoke"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:invoke inputVariable="LoggerInvoke-input"
                name="LoggerInvoke" operation="Insert"
                outputVariable="LoggerInvoke" partnerLink="Logger"
                portType="ns7:ProcessLog" tibex:xpdlId="17b93ad1-539c-4a98-b208-23a549f28cbd">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/WriteFile" version="2.0"&gt;
    &lt;xsl:param name="DBInsertInvoke"/&gt;
    &lt;xsl:param name="ZipFileIn"/&gt;
    &lt;xsl:template name="LoggerInvoke-input" match="/"&gt;
        &lt;tns5:InputMessage&gt;
            &lt;part1&gt;
                &lt;ns:Input&gt;
                    &lt;ns:TipologiaProcesso&gt;
                        &lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;
                    &lt;/ns:TipologiaProcesso&gt;
                    &lt;ns:TipologiaOperazione&gt;
                        &lt;xsl:value-of select="&amp;quot;LOG&amp;quot;"/&gt;
                    &lt;/ns:TipologiaOperazione&gt;
                    &lt;ns:ProcFile&gt;
                        &lt;ns:ID_PROCSO_FILE&gt;
                            &lt;xsl:value-of select="$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:IDProcsoFile"/&gt;
                        &lt;/ns:ID_PROCSO_FILE&gt;
                    &lt;/ns:ProcFile&gt;
                    &lt;ns:LogFileProcessato&gt;
                        &lt;xsl:if test="$DBInsertInvoke/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE"&gt;
                            &lt;ns:COD_PROCSO&gt;
                                &lt;xsl:value-of select="$DBInsertInvoke/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE"/&gt;
                            &lt;/ns:COD_PROCSO&gt;
                        &lt;/xsl:if&gt;
                        &lt;ns:ID_ESEC_PROCSO&gt;
                            &lt;xsl:value-of select="xsd:integer($DBInsertInvoke/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;
                        &lt;/ns:ID_ESEC_PROCSO&gt;
                        &lt;ns:ID_FILE&gt;
                            &lt;xsl:value-of select="xsd:integer($DBInsertInvoke/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;
                        &lt;/ns:ID_FILE&gt;
                        &lt;ns:LOG_LEVEL&gt;
                            &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                        &lt;/ns:LOG_LEVEL&gt;
                        &lt;ns:LOG_MESSAGE&gt;
                            &lt;xsl:value-of select="&amp;quot;CREATO FILE OUTPUT DA INVIARE&amp;quot;"/&gt;
                        &lt;/ns:LOG_MESSAGE&gt;
                        &lt;ns:TIMSTP_INSMTO&gt;
                            &lt;xsl:value-of select="string(current-dateTime())"/&gt;
                        &lt;/ns:TIMSTP_INSMTO&gt;
                    &lt;/ns:LogFileProcessato&gt;
                &lt;/ns:Input&gt;
            &lt;/part1&gt;
        &lt;/tns5:InputMessage&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileIn.ZipFileInput&quot;/>&#xa;    &lt;xsl:param name=&quot;DBInsertInvoke.part1&quot;/>&#xa;    &lt;xsl:template name=&quot;LoggerInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:IDProcsoFile&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$DBInsertInvoke.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$DBInsertInvoke.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($DBInsertInvoke.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($DBInsertInvoke.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:LOG_LEVEL>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                &lt;/ns:LOG_LEVEL>&#xa;                &lt;ns:LOG_MESSAGE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CREATO FILE OUTPUT DA INVIARE&amp;quot;&quot;/>&#xa;                &lt;/ns:LOG_MESSAGE>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;string(current-dateTime())&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="DBInsertInvokeToLoggerInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LoggerInvokeToCallProcess"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;ZipFileIn&quot;/>&lt;xsl:template name=&quot;LOG_LocalPathAssente-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;ZipFilePortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:ProcessIstanceID&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:ProcessIstanceID&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;L'OLO &amp;quot;, $ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:CodiceOLOAGCOM, &amp;quot; non è configurato per ricevere file di notifica.&amp;quot;)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_LocalPathAssente-input"
                    name="LOG_LocalPathAssente"
                    tibex:xpdlId="6205b1aa-7b9e-436e-bbe9-5c6efc3d9b2a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SistemaIPInterfacciaProcessToLOG_LocalPathAssente"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_LocalPathAssenteToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileIn.ZipFileInput&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_LocalPathAssente-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ZipFilePortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ZipFile&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$ZipFileIn.ZipFileInput/tns1:ProcessIstanceID&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$ZipFileIn.ZipFileInput/tns1:ProcessIstanceID&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;L'OLO &amp;quot;, $ZipFileIn.ZipFileInput/tns1:CodiceOLOAGCOM, &amp;quot; non è configurato per ricevere file di notifica.&amp;quot;)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="IP_INTERFACCIA" tibex:xpdlId="821170e3-d245-46e6-a3a6-97fcc3029548">
                <bpws:targets>
                    <bpws:target linkName="SistemaIPInterfacciaProcessToIP_INTERFACCIA"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="IP_INTERFACCIAToZipFileInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="IP_INTERFACCIAToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ZipFileIn/ZipFileInput/tns:ZipFileRequest/tns:StrutturaRichiesta = &quot;NPN&quot; or $ZipFileIn/ZipFileInput/tns:ZipFileRequest/tns:StrutturaRichiesta = &quot;NPR&quot; or string-length($ZipFileIn/ZipFileInput/tns:ZipFileRequest/tns:FullNameCPS)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$ZipFileIn.ZipFileInput/tns:StrutturaRichiesta = "NPN" or $ZipFileIn.ZipFileInput/tns:StrutturaRichiesta = "NPR" or string-length($ZipFileIn.ZipFileInput/tns:FullNameCPS)>0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns5=&quot;http://www.example.com/namespaces/tns/1466508362966&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ZipFileIn&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ZipFileInput>&#xa;            &lt;tns5:ToBeZippedFilePathAndName>&#xa;                &lt;xsl:value-of select=&quot;tib:trim($ZipFileIn/ZipFileInput/tns1:ZipFileRequest/tns1:FullName)&quot;/>&#xa;            &lt;/tns5:ToBeZippedFilePathAndName>&#xa;        &lt;/tns5:ZipFileInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ZipFileInvoke-input"
                    name="ZipFileInvoke" outputVariable="ZipFileInvoke"
