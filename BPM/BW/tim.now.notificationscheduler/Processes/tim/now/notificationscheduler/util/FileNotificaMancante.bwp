                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns0=&quot;http://xsd.telecomitalia.it/crm/xdsl/nga&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_FILE_PROCSTO&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameCallProcess&quot;/>&#xa;    &lt;xsl:template name=&quot;IntestazioneNGA&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:INTESTAZIONE>&#xa;            &lt;ns0:NOME_FILE>&#xa;                &lt;xsl:value-of select=&quot;$FileNameCallProcess/tns:NewString&quot;/>&#xa;            &lt;/ns0:NOME_FILE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                    &lt;ns0:DATA_CREAZIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(tib:add-to-dateTime($JDBC_FILE_PROCSTO/Record[1]/TIMSTP_APERTURA_FILE, 0, 0, 0, $index, 0, 0), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                    &lt;/ns0:DATA_CREAZIONE_FILE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ns0:DATA_CREAZIONE_FILE>&#xa;                        &lt;xsl:value-of select=&quot;format-dateTime(tib:add-to-dateTime($JDBC_FILE_PROCSTO/Record[1]/TIMSTP_APERTURA_FILE, 0, 0, $index, 0, 0, 0), &amp;quot;[D01]/[M01]/[Y0001] [H01]:[m01]&amp;quot;)&quot;/>&#xa;                    &lt;/ns0:DATA_CREAZIONE_FILE>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ns0:SISTEMA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/ns0:SISTEMA>&#xa;            &lt;ns0:CODICE_ISP>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:CodiceOLO&quot;/>&#xa;            &lt;/ns0:CODICE_ISP>&#xa;            &lt;ns0:NUMERO_PRATICHE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;            &lt;/ns0:NUMERO_PRATICHE>&#xa;            &lt;ns0:NUMERO_PRATICHE_CHIUSE_OK>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;            &lt;/ns0:NUMERO_PRATICHE_CHIUSE_OK>&#xa;            &lt;ns0:NUMERO_PRATICHE_CHIUSE_KO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;            &lt;/ns0:NUMERO_PRATICHE_CHIUSE_KO>&#xa;            &lt;ns0:NUMERO_NOTIFICHE_INTERMEDIE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;            &lt;/ns0:NUMERO_NOTIFICHE_INTERMEDIE>&#xa;            &lt;ns0:NUMERO_NOTIFICHE_MIGRAZIONI>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;0&amp;quot;&quot;/>&#xa;            &lt;/ns0:NUMERO_NOTIFICHE_MIGRAZIONI>&#xa;        &lt;/ns0:INTESTAZIONE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="IntestazioneNGA"
                                    name="NGAAssign"
                                    outputVariable="IntestazioneNGA"
                                    tibex:xpdlId="5fbc76a3-8d0f-43a9-b9e0-94b13939a189" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
