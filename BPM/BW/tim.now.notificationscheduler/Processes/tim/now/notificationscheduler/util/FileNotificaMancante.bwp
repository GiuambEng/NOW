                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/xsd/WriteFile" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ZipFile/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/FileNotificaMancante" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="WriteFile"/&gt;&lt;xsl:param name="CreateFile"/&gt;&lt;xsl:param name="REGInterfacciaIDOrario"/&gt;&lt;xsl:param name="REGInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="REG_MIGInterfacciaIDOrario"/&gt;&lt;xsl:param name="REG_MIGInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="NGAInterfacciaIDOrario"/&gt;&lt;xsl:param name="NGAInterfacciaIDOrarioAQ"/&gt;&lt;xsl:param name="NGAInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="NGAInterfacciaIDGiornalieroAQ"/&gt;&lt;xsl:param name="XDSLInterfacciaIDOrario"/&gt;&lt;xsl:param name="XDSLInterfacciaIDOrarioAQ"/&gt;&lt;xsl:param name="XDSLInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="XDSLInterfacciaIDGiornalieroAQ"/&gt;&lt;xsl:param name="IDTipologiaFile"/&gt;&lt;xsl:param name="REGIDProcsoFileInvio"/&gt;&lt;xsl:param name="REG_MIGIDProcsoFileInvio"/&gt;&lt;xsl:param name="NGAIDProcsoFileInvio"/&gt;&lt;xsl:param name="XDSLIDProcsoFileInvio"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="Property"/&gt;&lt;xsl:param name="Property1"/&gt;&lt;xsl:param name="IDProcsoFileInvioGPON"/&gt;&lt;xsl:template name="ZipFileInvoke-input" match="/"&gt;&lt;tns4:ZipFileRequest&gt;&lt;ZipFileInput&gt;&lt;tns2:ZipFileRequest&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile)"&gt;&lt;tns2:FullName&gt;&lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fullName)"/&gt;&lt;/tns2:FullName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FullName&gt;&lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fullName)"/&gt;&lt;/tns2:FullName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile)"&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="tib:trim($WriteFile/fileInfo/fileName)"/&gt;&lt;/tns2:FileName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="tib:trim($CreateFile/fileInfo/fileName)"/&gt;&lt;/tns2:FileName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($WriteFile)"&gt;&lt;tns2:Size&gt;&lt;xsl:value-of select="xsd:int($WriteFile/fileInfo/size)"/&gt;&lt;/tns2:Size&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Size&gt;&lt;xsl:value-of select="xsd:int($CreateFile/fileInfo/size)"/&gt;&lt;/tns2:Size&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns2:CodiceOLO&gt;&lt;xsl:value-of select="$Start/tns1:CodiceOLO"/&gt;&lt;/tns2:CodiceOLO&gt;&lt;tns2:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$Start/tns1:CodiceOLOAGCOM"/&gt;&lt;/tns2:CodiceOLOAGCOM&gt;&lt;tns2:StrutturaRichiesta&gt;&lt;xsl:value-of select="$Start/tns1:StrutturaRichiesta"/&gt;&lt;/tns2:StrutturaRichiesta&gt;&lt;tns2:NumeroRecord&gt;&lt;xsl:value-of select="0"/&gt;&lt;/tns2:NumeroRecord&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$REG_MIGInterfacciaIDOrario"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$REG_MIGInterfacciaIDGiornaliero"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$REGInterfacciaIDOrario"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$REGInterfacciaIDGiornaliero"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns1:StrutturaRichiesta = &amp;quot;NGA&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TipoFile = &amp;quot;AQ&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$NGAInterfacciaIDOrarioAQ"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$NGAInterfacciaIDGiornalieroAQ"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$NGAInterfacciaIDOrario"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$NGAInterfacciaIDGiornaliero"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:StrutturaRichiesta = &amp;quot;GPON&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$Property"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$Property1"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns1:TipoFile = &amp;quot;AQ&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$XDSLInterfacciaIDOrarioAQ"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$XDSLInterfacciaIDGiornalieroAQ"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;"&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$XDSLInterfacciaIDOrario"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDInterfaccia&gt;&lt;xsl:value-of select="$XDSLInterfacciaIDGiornaliero"/&gt;&lt;/tns2:IDInterfaccia&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns2:IDTipologiaFile&gt;&lt;xsl:value-of select="$IDTipologiaFile"/&gt;&lt;/tns2:IDTipologiaFile&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot;"&gt;&lt;tns2:IDProcsoFile&gt;&lt;xsl:value-of select="$REG_MIGIDProcsoFileInvio"/&gt;&lt;/tns2:IDProcsoFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDProcsoFile&gt;&lt;xsl:value-of select="$REGIDProcsoFileInvio"/&gt;&lt;/tns2:IDProcsoFile&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$Start/tns1:StrutturaRichiesta = &amp;quot;NGA&amp;quot;"&gt;&lt;tns2:IDProcsoFile&gt;&lt;xsl:value-of select="$NGAIDProcsoFileInvio"/&gt;&lt;/tns2:IDProcsoFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$Start/tns1:StrutturaRichiesta = &amp;quot;GPON&amp;quot;"&gt;&lt;tns2:IDProcsoFile&gt;&lt;xsl:value-of select="$IDProcsoFileInvioGPON"/&gt;&lt;/tns2:IDProcsoFile&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:IDProcsoFile&gt;&lt;xsl:value-of select="$XDSLIDProcsoFileInvio"/&gt;&lt;/tns2:IDProcsoFile&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$Start/tns1:ProcessIstanceID"&gt;&lt;tns2:ProcessIstanceID&gt;&lt;xsl:value-of select="$Start/tns1:ProcessIstanceID"/&gt;&lt;/tns2:ProcessIstanceID&gt;&lt;/xsl:if&gt;&lt;/tns2:ZipFileRequest&gt;&lt;/ZipFileInput&gt;&lt;/tns4:ZipFileRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/WriteFile&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ZipFile/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;WriteFile&quot;/>&#xa;    &lt;xsl:param name=&quot;CreateFile&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;IDTipologiaFile&quot;/>&#xa;    &lt;xsl:param name=&quot;REGIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLIDProcsoFileInvio&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Property&quot;/>&#xa;    &lt;xsl:param name=&quot;Property1&quot;/>&#xa;    &lt;xsl:param name=&quot;IDProcsoFileInvioGPON&quot;/>&#xa;    &lt;xsl:template name=&quot;ZipFileInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ZipFileRequest>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns2:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns2:FullName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:FullName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fullName)&quot;/>&#xa;                    &lt;/tns2:FullName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns2:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($WriteFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns2:FileName>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:FileName>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim($CreateFile/fileInfo/fileName)&quot;/>&#xa;                    &lt;/tns2:FileName>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($WriteFile)&quot;>&#xa;                    &lt;tns2:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($WriteFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns2:Size>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns2:Size>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($CreateFile/fileInfo/size)&quot;/>&#xa;                    &lt;/tns2:Size>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CodiceOLO>&#xa;            &lt;tns2:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns2:CodiceOLOAGCOM>&#xa;            &lt;tns2:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:StrutturaRichiesta&quot;/>&#xa;            &lt;/tns2:StrutturaRichiesta>&#xa;            &lt;tns2:NumeroRecord>&#xa;                &lt;xsl:value-of select=&quot;0&quot;/>&#xa;            &lt;/tns2:NumeroRecord>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns1:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$REG_MIGInterfacciaIDOrario&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$REG_MIGInterfacciaIDGiornaliero&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$REGInterfacciaIDOrario&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$REGInterfacciaIDGiornaliero&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns1:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:TipoFile = &amp;quot;AQ&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$NGAInterfacciaIDOrarioAQ&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$NGAInterfacciaIDOrario&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornaliero&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:StrutturaRichiesta = &amp;quot;GPON&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$Property&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$Property1&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:TipoFile = &amp;quot;AQ&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$Start/tns1:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrario&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:IDInterfaccia>&#xa;                                        &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornaliero&quot;/>&#xa;                                    &lt;/tns2:IDInterfaccia>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns2:IDTipologiaFile>&#xa;                &lt;xsl:value-of select=&quot;$IDTipologiaFile&quot;/>&#xa;            &lt;/tns2:IDTipologiaFile>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns1:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                            &lt;tns2:IDProcsoFile>&#xa;                                &lt;xsl:value-of select=&quot;$REG_MIGIDProcsoFileInvio&quot;/>&#xa;                            &lt;/tns2:IDProcsoFile>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns2:IDProcsoFile>&#xa;                                &lt;xsl:value-of select=&quot;$REGIDProcsoFileInvio&quot;/>&#xa;                            &lt;/tns2:IDProcsoFile>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns1:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;tns2:IDProcsoFile>&#xa;                        &lt;xsl:value-of select=&quot;$NGAIDProcsoFileInvio&quot;/>&#xa;                    &lt;/tns2:IDProcsoFile>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns1:StrutturaRichiesta = &amp;quot;GPON&amp;quot;&quot;>&#xa;                            &lt;tns2:IDProcsoFile>&#xa;                                &lt;xsl:value-of select=&quot;$IDProcsoFileInvioGPON&quot;/>&#xa;                            &lt;/tns2:IDProcsoF