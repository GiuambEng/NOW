                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBC_INTRFC&quot;/>&lt;xsl:param name=&quot;JDBC_FILE_PROCSTO&quot;/>&lt;xsl:template name=&quot;FileNameCallProcess-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $Start/tns2:StrutturaRichiesta = 'CPS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&lt;tns:InputString>&lt;tns:OldString>&lt;xsl:value-of select=&quot;$JDBC_INTRFC/Record[1]/NAMING_CONVENTION&quot;/>&lt;/tns:OldString>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;OLO&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;GGMMAAAA&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;AAAAMMGG&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;DDMMYYYY&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;YYYYMMDD&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;DDMMAAAA&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;AAAAMMDD&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;GGMMYYYY&amp;quot;&quot;/>&lt;/tns:OldChar>&lt;tns:OldChar>&lt;xsl:value-of select=&quot;&amp;q