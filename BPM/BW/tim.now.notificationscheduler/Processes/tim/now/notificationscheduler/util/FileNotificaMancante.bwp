            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/FileNotificaMancante&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Duration&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;JDBC_FILE_PROCSTO&quot;/>&lt;xsl:template name=&quot;NumeroFile&quot; match=&quot;/&quot;>&lt;tns:NumeroFile>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBC_FILE_PROCSTO/Record) = false()&quot;>&lt;tns:NumeroFile>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:NumeroFile>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&lt;tns:NumeroFile>&lt;xsl:value-of select=&quot;((days-from-duration($Duration/tns:Duration) * 24) + (hours-from-duration($Duration/tns:Duration))) - 1&quot;/>&lt;/tns:NumeroFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;days-from-duration($Duration/tns:Duration) = 0&quot;>&lt;tns:NumeroFile>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:NumeroFile>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:NumeroFile>&lt;xsl:value-of select=&quot;(days-from-duration($Duration/tns:Duration)) - 1&quot;/>&lt;/tns:NumeroFile>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:NumeroFile>&lt;/xsl:template>&lt;/xsl:stylesheet>"
