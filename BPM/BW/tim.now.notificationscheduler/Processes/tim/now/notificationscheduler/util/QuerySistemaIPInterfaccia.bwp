                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="937b15fa-988b-4d22-a319-fd8f0c502fbe" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
