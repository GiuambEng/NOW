&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http:///www.tim.com/NOW/wsdl/abstract/SendFile/" xmlns:tns1="http:///www.tim.com/NOW/xsd/SendFile" version="2.0"&gt;&lt;xsl:template name="SendFileOut-input" match="/"&gt;&lt;tns:SendFileResponse&gt;&lt;SendFileOutput&gt;&lt;tns1:SendFileResponse&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/tns1:SendFileResponse&gt;&lt;/SendFileOutput&gt;&lt;/tns:SendFileResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http:///www.tim.com/NOW/wsdl/abstract/SendFile/&quot; xmlns:tns1=&quot;http:///www.tim.com/NOW/xsd/SendFile&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;SendFileOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:SendFileResponse>&#xa;            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;        &lt;/tns1:SendFileResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
