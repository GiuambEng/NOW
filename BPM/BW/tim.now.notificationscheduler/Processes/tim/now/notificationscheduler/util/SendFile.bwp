                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http:///www.tim.com/NOW/xsd/SendFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New" version="2.0"&gt;&lt;xsl:param name="SendFileIn"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="JDBC_FILE"/&gt;&lt;xsl:param name="_error"/&gt;&lt;xsl:param name="_error_LeggiFile"/&gt;&lt;xsl:param name="PutFileInvoke"/&gt;&lt;xsl:template name="DBUpdateInvoke-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$SendFileIn/SendFileInput/tns1:SendFileRequest/tns1:IDProcsoFile"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/ns:ProcFile&gt;&lt;ns:FileProcessato&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error_LeggiFile)"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;ERRORE APERTURA FILE&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;"&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;NON INVIATO&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:DESCR_STATO_FILE&gt;&lt;xsl:value-of select="&amp;quot;INVIATO&amp;quot;"/&gt;&lt;/ns:DESCR_STATO_FILE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error_LeggiFile) or exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;"&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ESITO&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/ns:ESITO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($JDBC_FILE/Record[number($index)]/ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="xsd:integer($JDBC_FILE/Record[number($index)]/ID_FILE)"/&gt;&lt;/ns:ID_FILE&gt;&lt;ns:TIMSTP_CHIUSURA_FILE&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_CHIUSURA_FILE&gt;&lt;/ns:FileProcessato&gt;&lt;ns:EsecuzioneFile&gt;&lt;ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:value-of select="xsd:integer($JDBC_FILE/Record[number($index)]/ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error_LeggiFile) or exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;"&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneFile&gt;&lt;ns:FileProcessatoOutput&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($_error_LeggiFile) or exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;"&gt;&lt;ns:ESITO_INVIO&gt;&lt;xsl:value-of select="&amp;quot;FILE NON INVIATO&amp;quot;"/&gt;&lt;/ns:ESITO_INVIO&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:ESITO_INVIO&gt;&lt;xsl:value-of select="&amp;quot;FILE INVIATO CON SUCCESSO&amp;quot;"/&gt;&lt;/ns:ESITO_INVIO&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;xsl:value-of select="xsd:integer($JDBC_FILE/Record[number($index)]/ID_FILE)"/&gt;&lt;/ns:ID_FILE_PROCSTO_OUTPUT&gt;&lt;ns:TIMSTP_INVIO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INVIO&gt;&lt;/ns:FileProcessatoOutput&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http:///www.tim.com/NOW/xsd/SendFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendFileIn.SendFileInput&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_FILE&quot;/>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:param name=&quot;_error_LeggiFile&quot;/>&#xa;    &lt;xsl:param name=&quot;PutFileInvoke&quot;/>&#xa;    &lt;xsl:template name=&quot;DBUpdateInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$SendFileIn.SendFileInput/tns1:IDProcsoFile&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:FileProcessato>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($_error_LeggiFile)&quot;>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ERRORE APERTURA FILE&amp;quot;&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;&quot;>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NON INVIATO&amp;quot;&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:DESCR_STATO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INVIATO&amp;quot;&quot;/>&#xa;                        &lt;/ns:DESCR_STATO_FILE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($_error_LeggiFile) or exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;&quot;>&#xa;                        &lt;ns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/ns:ESITO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ESITO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/ns:ESITO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBC_FILE/Record[number($index)]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBC_FILE/Record[number($index)]/ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;ns:TIMSTP_CHIUSURA_FILE>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_CHIUSURA_FILE>&#xa;            &lt;/ns:FileProcessato>&#xa;            &lt;ns:EsecuzioneFile>&#xa;                &lt;ns:ID_ESEC_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBC_FILE/Record[number($index)]/ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($_error_LeggiFile) or exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;&quot;>&#xa;                        &lt;ns:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;&quot;/>&#xa;                        &lt;/ns:STATO_ESEC>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:STATO_ESEC>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;PROCESSO ESEGUITO CON SUCCESSO&amp;quot;&quot;/>&#xa;                        &lt;/ns:STATO_ESEC>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TMSP_FINE_ELAB>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TMSP_FINE_ELAB>&#xa;            &lt;/ns:EsecuzioneFile>&#xa;            &lt;ns:FileProcessatoOutput>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($_error_LeggiFile) or exists($_error) or $PutFileInvoke/tns2:Status = &amp;quot;KO&amp;quot;&quot;>&#xa;                        &lt;ns:ESITO_INVIO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FILE NON INVIATO&amp;quot;&quot;/>&#xa;                        &lt;/ns:ESITO_INVIO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:ESITO_INVIO>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FILE INVIATO CON SUCCESSO&amp;quot;&quot;/>&#xa;                        &lt;/ns:ESITO_INVIO>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($JDBC_FILE/Record[number($index)]/ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE_PROCSTO_OUTPUT>&#xa;                &lt;ns:TIMSTP_INVIO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INVIO>&#xa;            &lt;/ns:FileProcessatoOutput>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
