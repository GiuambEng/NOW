                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/ProcessLog" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http:///www.tim.com/NOW/xsd/SendFile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New" version="2.0"&gt;&lt;xsl:param name="SendFileIn"/&gt;&lt;xsl:param name="DBUpdateInvoke"/&gt;&lt;xsl:param name="SendFileTappoNPInvoke"/&gt;&lt;xsl:template name="LoggerNPInvoke-input" match="/"&gt;&lt;tns:InputMessage&gt;&lt;part1&gt;&lt;ns:Input&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="&amp;quot;FILE&amp;quot;"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="&amp;quot;LOG&amp;quot;"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:ProcFile&gt;&lt;ns:ID_PROCSO_FILE&gt;&lt;xsl:value-of select="$SendFileIn/SendFileInput/tns1:SendFileRequest/tns1:IDProcsoFile"/&gt;&lt;/ns:ID_PROCSO_FILE&gt;&lt;/ns:ProcFile&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$DBUpdateInvoke/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$DBUpdateInvoke/part1/ns:Output/ns:Esito/ns:COD_PROCSO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer($DBUpdateInvoke/part1/ns:Output/ns:Esito/ns:ID_ESEC_PROCSO_FILE)"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:ID_FILE&gt;&lt;xsl:value-of select="xsd:integer($DBUpdateInvoke/part1/ns:Output/ns:Esito/ns:ID_FILE)"/&gt;&lt;/ns:ID_FILE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$SendFileTappoNPInvoke/output/tns1:SendFileResponse = &amp;quot;KO&amp;quot;"&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$SendFileTappoNPInvoke/output/tns1:SendFileResponse = &amp;quot;KO&amp;quot;"&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;FINE LAVORAZIONE FILE OUTPUT PER INVIO FALLITO&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;FINE LAVORAZIONE FILE OUTPUT PER INVIO AVVENUTO CON SUCCESSO&amp;quot;"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/ns:Input&gt;&lt;/part1&gt;&lt;/tns:InputMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ProcessLog&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http:///www.tim.com/NOW/xsd/SendFile&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/SFTP_PutJavaCode_New&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DBUpdateInvoke.part1&quot;/>&#xa;    &lt;xsl:param name=&quot;SendFileTappoNPInvoke.output&quot;/>&#xa;    &lt;xsl:param name=&quot;SendFileIn.SendFileInput&quot;/>&#xa;    &lt;xsl:template name=&quot;LoggerNPInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns:Input>&#xa;            &lt;ns:TipologiaProcesso>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FILE&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaProcesso>&#xa;            &lt;ns:TipologiaOperazione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;LOG&amp;quot;&quot;/>&#xa;            &lt;/ns:TipologiaOperazione>&#xa;            &lt;ns:ProcFile>&#xa;                &lt;ns:ID_PROCSO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$SendFileIn.SendFileInput/tns1:IDProcsoFile&quot;/>&#xa;                &lt;/ns:ID_PROCSO_FILE>&#xa;            &lt;/ns:ProcFile>&#xa;            &lt;ns:LogFileProcessato>&#xa;                &lt;xsl:if test=&quot;$DBUpdateInvoke.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;>&#xa;                    &lt;ns:COD_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;$DBUpdateInvoke.part1/ns:Esito/ns:COD_PROCSO_FILE&quot;/>&#xa;                    &lt;/ns:COD_PROCSO>&#xa;                &lt;/xsl:if>&#xa;                &lt;ns:ID_ESEC_PROCSO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($DBUpdateInvoke.part1/ns:Esito/ns:ID_ESEC_PROCSO_FILE)&quot;/>&#xa;                &lt;/ns:ID_ESEC_PROCSO>&#xa;                &lt;ns:ID_FILE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:integer($DBUpdateInvoke.part1/ns:Esito/ns:ID_FILE)&quot;/>&#xa;                &lt;/ns:ID_FILE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SendFileTappoNPInvoke.output = &amp;quot;KO&amp;quot;&quot;>&#xa;                        &lt;ns:LOG_LEVEL>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                        &lt;/ns:LOG_LEVEL>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:LOG_LEVEL>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                        &lt;/ns:LOG_LEVEL>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$SendFileTappoNPInvoke.output = &amp;quot;KO&amp;quot;&quot;>&#xa;                        &lt;ns:LOG_MESSAGE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE OUTPUT PER INVIO FALLITO&amp;quot;&quot;/>&#xa;                        &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ns:LOG_MESSAGE>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;FINE LAVORAZIONE FILE OUTPUT PER INVIO AVVENUTO CON SUCCESSO&amp;quot;&quot;/>&#xa;                        &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ns:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/ns:TIMSTP_INSMTO>&#xa;            &lt;/ns:LogFileProcessato>&#xa;        &lt;/ns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
