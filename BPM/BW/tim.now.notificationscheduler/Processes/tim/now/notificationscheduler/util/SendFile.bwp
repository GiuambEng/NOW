                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_FILE-input" name="JDBC_FILE"
                    outputVariable="JDBC_FILE"
                    tibex:xpdlId="abdbd0b3-ef23-4623-8f38-23092960e8c1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SendFileInToSendFileOut"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_FILEToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+abdbd0b3-ef23-4623-8f38-23092960e8c1+input&quot; xmlns:tns1=&quot;http:///www.tim.com/NOW/xsd/SendFile&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SendFileIn.SendFileInput&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_FILE-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$SendFileIn.SendFileInput/tns1:CodiceOLO&quot;/>&#xa;            &lt;/CodiceOLO>&#xa;            &lt;CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$SendFileIn.SendFileInput/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodiceOLOAGCOM>&#xa;            &lt;IDInterfaccia>&#xa;                &lt;xsl:value-of select=&quot;$SendFileIn.SendFileInput/tns1:IDInterfaccia&quot;/>&#xa;            &lt;/IDInterfaccia>&#xa;            &lt;VersoDelFile>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;OUTPUT&amp;quot;&quot;/>&#xa;            &lt;/VersoDelFile>&#xa;            &lt;DescrizioneStatoFileDaInviare>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;DA INVIARE&amp;quot;&quot;/>&#xa;            &lt;/DescrizioneStatoFileDaInviare>&#xa;            &lt;DescrizioneStatoFileNonInviato>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NON INVIATO&amp;quot;&quot;/>&#xa;            &lt;/DescrizioneStatoFileNonInviato>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
