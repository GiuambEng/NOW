                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT LOCAL_PATH, ID_INTRFC&#xa;FROM SISTEMA_IP_INTRFC&#xa;WHERE CODFC_OLO_AGCOM = ? AND (ID_INTRFC = ? OR ID_INTRFC = ?) AND ID_SISTEMA = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
