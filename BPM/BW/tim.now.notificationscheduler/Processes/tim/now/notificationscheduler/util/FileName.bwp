                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+6f51dff1-04fe-4187-bf2a-03f25c0b948e+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn.FileNameInput&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPRInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;REG_MIGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;GPONInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;GPONInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;FWAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NPN103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPR103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_INTERFACCIA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$FWAInterfacciaIDOrario&quot;/>&#xa;                    &lt;/ID_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                    &lt;ID_INTRFC>&#xa;                        &lt;xsl:value-of select=&quot;$NPNGInterfacciaIDGiornaliero&quot;/>&#xa;                    &lt;/ID_INTRFC>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;GPON&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$GPONInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$GPONInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$CPSInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$CPSInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;ID_INTRFC>&#xa;                                        &lt;xsl:value-of select=&quot;$REG_MIGInterfacciaIDOrario&quot;/>&#xa;                                    &lt;/ID_INTRFC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_INTRFC>&#xa;                                        &lt;xsl:value-of select=&quot;$REG_MIGInterfacciaIDGiornaliero&quot;/>&#xa;                                    &lt;/ID_INTRFC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                    &lt;ID_INTRFC>&#xa;                                        &lt;xsl:value-of select=&quot;$REGInterfacciaIDOrario&quot;/>&#xa;                                    &lt;/ID_INTRFC>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;ID_INTRFC>&#xa;                                        &lt;xsl:value-of select=&quot;$REGInterfacciaIDGiornaliero&quot;/>&#xa;                                    &lt;/ID_INTRFC>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPN103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPNInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPR103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPRInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;GPON&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;ID_INTRFC_AQ xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDOrarioAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NAMING_CONVENTION, ID_INTRFC&#xa;  FROM INTRFC&#xa;  WHERE ID_INTRFC IN (?, ?)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_INTRFC"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_INTRFC_AQ"/>
                                    <columnMetadata
                                    columnName="NAMING_CONVENTION"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_INTRFC"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_INTERFACCIA&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;Progressivo&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNameCallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                &lt;tns1:InputString>&#xa;                    &lt;tns1:OldString>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[1]/NAMING_CONVENTION&quot;/>&#xa;                    &lt;/tns1:OldString>&#xa;                    &lt;tns1:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMDD&amp;quot;&quot;/>&#xa;                    &lt;/tns1:OldChar>&#xa;                    &lt;tns1:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OLO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:OldChar>&#xa;                    &lt;tns1:NewChar>&#xa;                        &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns1:NewChar>&#xa;                    &lt;xsl:if test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;>&#xa;                        &lt;tns1:NewChar>&#xa;                            &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;/>&#xa;                        &lt;/tns1:NewChar>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:InputString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                &lt;tns1:InputString>&#xa;                    &lt;tns1:OldString>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[1]/NAMING_CONVENTION&quot;/>&#xa;                    &lt;/tns1:OldString>&#xa;                    &lt;tns1:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMDD&amp;quot;&quot;/>&#xa;                    &lt;/tns1:OldChar>&#xa;                    &lt;tns1:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OAO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:OldChar>&#xa;                    &lt;tns1:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;HH&amp;quot;&quot;/>&#xa;                    &lt;/tns1:OldChar>&#xa;                    &lt;tns1:NewChar>&#xa;                        &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                    &lt;/tns1:NewChar>&#xa;                    &lt;xsl:if test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;>&#xa;                        &lt;tns1:NewChar>&#xa;                            &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;/>&#xa;                        &lt;/tns1:NewChar>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:NewChar>&#xa;                        &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns1:NewChar>&#xa;                &lt;/tns1:InputString>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot;&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                                &lt;tns1:InputString>&#xa;                                    &lt;tns1:OldString>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[1]/NAMING_CONVENTION&quot;/>&#xa;                                    &lt;/tns1:OldString>&#xa;                                    &lt;tns1:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;OLO&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:OldChar>&#xa;                                    &lt;tns1:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;GGMMAAAA&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:OldChar>&#xa;                                    &lt;tns1:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;AAAAMMGG&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:OldChar>&#xa;                                    &lt;tns1:OldChar>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;DDMMYYYY&amp;quot;&quot;/>&#xa; 