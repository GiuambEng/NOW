lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                        &lt;/tns1:InputString>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:InputString>&#xa;                            &lt;tns1:OldString>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[ID_INTRFC = $XDSLInterfacciaIDGiornalieroAQ]/NAMING_CONVENTION&quot;/>&#xa;                            &lt;/tns1:OldString>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ISP&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;GGMMAAAA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AAAAMMGG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DDMMYYYY&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMDD&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;HH&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;$FileNameOperationIn.FileNameInput/tns2:CodiceOLO&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;RG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                        &lt;/tns1:InputString>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="JavaUtil.ReplaceMoreString" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1777224e-e8fc-42ff-b6cc-3b13852f55bc+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NPNInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPRInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;NPN103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPR103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_PROGRESSIVO_NP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPN103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPNInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPR103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPRInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/DATA_FILE>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_PROGRESSIVO_NP-input"
                    name="JDBC_PROGRESSIVO_NP"
                    outputVariable="JDBC_PROGRESSIVO_NP"
                    tibex:xpdlId="1777224e-e8fc-42ff-b6cc-3b13852f55bc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBC_PROGRESSIVO_NP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToFileNameCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1777224e-e8fc-42ff-b6cc-3b13852f55bc+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn.FileNameInput&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPRInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPN103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPR103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_PROGRESSIVO_NP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPN103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPNInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPR103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPRInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DATA_FILE>&#xa;                &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;            &lt;/DATA_FILE>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FileNameOperationIn.FileNameInput/tns2:CodiceOLOAGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FileNameOperationIn.FileNameInput/tns2:CodiceOLOAGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOME_FILE&#xa;FROM FILE_PROCSTO&#xa;WHERE ID_INTRFC = ? AND DATA_FILE = ? AND CODFC_OLO_AGCOM = ?&#xa;ORDER BY TIMSTP_APERTURA_FILE DESC, NOME_FILE DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_INTRFC"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_FILE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <columnMetadata
                                    columnName="NOME_FILE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Progressivo"
                    name="ProgressivoAssign"
                    outputVariable="Progressivo"
                    tibex:xpdlId="5639c404-6f51-4c9e-9a6d-e1dd831b0926" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToFileNameCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToFileNameCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(exists($JDBC_PROGRESSIVO_NP/Record) = false()) then &quot;00000&quot; else tib:pad-front(string(xsd:int(substring-before(tib:substring-after-last($JDBC_PROGRESSIVO_NP/Record[1]/NOME_FILE, &quot;_&quot;), &quot;.xml&quot;)) + 1), 5, &quot;0&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Progressivo" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileName&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileNamePortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;FileName&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:ProcessIstanceID&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:ProcessIstanceID&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;FileName input: &amp;quot;, tib:render-xml($FileNameOperationIn/FileNameInput/tns2:FileNameRequest, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_Input-input" name="LOG_Input"
                    tibex:xpdlId="cc97b3dc-5dcf-4e57-96d6-6c4ef7a926e9"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="FileNameOperationInToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToJDBC_INTERFACCIA"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
