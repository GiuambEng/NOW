ar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;RG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                        &lt;/tns1:InputString>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;tns1:InputString>&#xa;                            &lt;tns1:OldString>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[ID_INTRFC = $XDSLInterfacciaIDOrarioAQ]/NAMING_CONVENTION&quot;/>&#xa;                            &lt;/tns1:OldString>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ISP&amp;quot;&quot;/