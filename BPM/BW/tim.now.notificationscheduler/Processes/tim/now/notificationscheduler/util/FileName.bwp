            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b24a57c1-cc4f-4119-bf56-d047efb8ff0b+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPRInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistemaFENP&quot;/>&#xa;    &lt;xsl:param name=&quot;IDSistemaOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;GPONInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;GPONInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;FWAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NPN103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPR103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_SISTEMA_IP_INTRFC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$FWAInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC xsi:nil=&quot;true&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPNGInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;GPON&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$GPONInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$GPONInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$CPSInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$CPSInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$REGInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$REGInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPN103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPNInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:FlagNP_103='SI'&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPR103InterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$NPRInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrario&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornaliero&quot;/>&#xa;                            &lt;/ID_INTRFC>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;GPON&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;FWA&amp;quot;&quot;>&#xa;                    &lt;ID_INTRFC_AQ xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDOrarioAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;ID_INTRFC_AQ>&#xa;                                &lt;xsl:value-of select=&quot;$XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;                            &lt;/ID_INTRFC_AQ>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot;&quot;>&#xa;                    &lt;ID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;$IDSistemaFENP&quot;/>&#xa;                    &lt;/ID_SISTEMA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_SISTEMA>&#xa;                        &lt;xsl:value-of select=&quot;$IDSistemaOLO&quot;/>&#xa;                    &lt;/ID_SISTEMA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
