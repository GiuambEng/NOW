te(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;xsl:if test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;>&#xa;                                &lt;tns1:NewChar>&#xa;                                    &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLOAGCOM&quot;/>&#xa;                                &lt;/tns1:NewChar>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;'RG'&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                        &lt;/tns1:InputString>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;tns1:InputString>&#xa;                            &lt;tns1:OldString>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[ID_INTRFC = $XDSLInterfacciaIDOrario]/NAMING_CONVENTION&quot;/>&#xa;                            &lt;/tns1:OldString>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ISP&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;GGMMAAAA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AAAAMMGG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DDMMYYYY&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMDD&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DDMMAAAA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AAAAMMDD&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;GGMMYYYY&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMGG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;HH&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLO&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-time(current-time(), &amp;quot;[H01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                        &lt;/tns1:InputString>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:InputString>&#xa;                            &lt;tns1:OldString>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[ID_INTRFC = $XDSLInterfacciaIDGiornaliero]/NAMING_CONVENTION&quot;/>&#xa;                            &lt;/tns1:OldString>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ISP&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;GGMMAAAA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AAAAMMGG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DDMMYYYY&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMDD&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;DDMMAAAA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;AAAAMMDD&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;GGMMYYYY&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMGG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;HH&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:CodiceOLO&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[D01][M01][Y0001]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                            &lt;tns1:NewChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;RG&amp;quot;&quot;/>&#xa;                            &lt;/tns1:NewChar>&#xa;                        &lt;/tns1:InputString>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="FileNameCallProcess-input"
                    name="FileNameCallProcess"
                    outputVariable="FileNameCallProcess"
                    tibex:xpdlId="7ae80286-a828-47a4-843a-e1e6c8d201fd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToFileNameCallProcess"/>
                        <bpws:target linkName="AssignToFileNameCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="FileNameCallProcessToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="FileNameCallProcessToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$FileNameOperationIn/FileNameInput/tns:FileNameRequest/tns:StrutturaRichiesta = &quot;REGOLATORIO&quot; or $FileNameOperationIn/FileNameInput/tns:FileNameRequest/tns:StrutturaRichiesta = &quot;NPN&quot; or $FileNameOperationIn/FileNameInput/tns:FileNameRequest/tns:StrutturaRichiesta = &quot;NPR&quot; or $FileNameOperationIn/FileNameInput/tns:FileNameRequest/tns:StrutturaRichiesta = &quot;GPON&quot; or $FileNameOperationIn/FileNameInput/tns:FileNameRequest/tns:StrutturaRichiesta = &quot;NPNG&quot; or $FileNameOperationIn/FileNameInput/tns:FileNameRequest/tns:StrutturaRichiesta = &quot;FWA&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$FileNameOperationIn.FileNameInput/tns:StrutturaRichiesta = "REGOLATORIO" or $FileNameOperationIn.FileNameInput/tns:StrutturaRichiesta = "NPN" or $FileNameOperationIn.FileNameInput/tns:StrutturaRichiesta = "NPR" or $FileNameOperationIn.FileNameInput/tns:StrutturaRichiesta = "GPON" or $FileNameOperationIn.FileNameInput/tns:StrutturaRichiesta = "NPNG" or $FileNameOperationIn.FileNameInput/tns:StrutturaRichiesta = "FWA"]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn.FileNameInput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_INTERFACCIA&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;Progressivo&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNameCallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                &lt;tns1:InputString>&#xa;                    &lt;tns1:OldString>&#xa;                        &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[1]/NAMING_CONVENTION&quot;/>&#xa;                    &lt;/tns1:OldString>&#xa;                    &lt;tns1:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;YYYYMMDD&amp;quot;&quot;/>&#xa;                    &lt;/tns1:OldChar>&#xa;                    &lt;tns1:OldChar>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OLO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:OldChar>&#xa;                    &lt;tns1:NewChar>&#xa;                        &lt;xsl:value-of select=&quot;format-date(current-date(), &amp;quot;[Y0001][M01][D01]&amp;quot;)&quot;/>&#xa;                    &lt;/tns1:NewChar>&#xa;                    &lt;xsl:if test=&quot;$FileNameOperationIn.FileNameInput/tns2:CodiceOLOAGCOM&quot;>&#xa;                        &lt;tns1