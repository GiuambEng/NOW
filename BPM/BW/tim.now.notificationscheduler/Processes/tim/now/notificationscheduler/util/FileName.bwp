            <bpws:reply name="FileNameOperationOut" operation="FileName"
                partnerLink="FileNamePortType"
                portType="ns2:FileNamePortType"
                tibex:xpdlId="059e56e7-4a70-439c-b6fc-f7dad41eb1ca" variable="FileNameOperationOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/FileName/" xmlns:tns1="http://www.tim.com/NOW/xsd/ReplaceAllString/" xmlns:tns2="http://www.tim.com/NOW/xsd/FileName" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="FileNameCallProcess"/&gt;&lt;xsl:param name="FileNameOperationIn"/&gt;&lt;xsl:param name="JDBC_SISTEMA_IP_INTRFC"/&gt;&lt;xsl:param name="REGInterfacciaIDOrario"/&gt;&lt;xsl:param name="REGInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="FileNameAQCallProcess"/&gt;&lt;xsl:param name="NPNInterfacciaIDOrario"/&gt;&lt;xsl:param name="NPRInterfacciaIDOrario"/&gt;&lt;xsl:param name="NGAInterfacciaIDOrario"/&gt;&lt;xsl:param name="NGAInterfacciaIDOrarioAQ"/&gt;&lt;xsl:param name="NGAInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="NGAInterfacciaIDGiornalieroAQ"/&gt;&lt;xsl:param name="XDSLInterfacciaIDOrario"/&gt;&lt;xsl:param name="XDSLInterfacciaIDOrarioAQ"/&gt;&lt;xsl:param name="XDSLInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="XDSLInterfacciaIDGiornalieroAQ"/&gt;&lt;xsl:param name="CPSInterfacciaIDOrario"/&gt;&lt;xsl:param name="CPSInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="GPONInterfacciaIDOrario"/&gt;&lt;xsl:param name="GPONInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="FWAInterfacciaIDOrario"/&gt;&lt;xsl:param name="NPNGInterfacciaIDGiornaliero"/&gt;&lt;xsl:param name="NPN103InterfacciaIDOrario"/&gt;&lt;xsl:param name="NPR103InterfacciaIDOrario"/&gt;&lt;xsl:template name="FileNameOperationOut-input" match="/"&gt;&lt;tns:FileNameResponse&gt;&lt;FileNameOutput&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot;"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:FlagNP_103='SI'"&gt;&lt;tns2:FileNameResponse&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NPN103InterfacciaIDOrario or ID_INTRFC = $NPR103InterfacciaIDOrario]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;/tns2:FileNameResponse&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FileNameResponse&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NPNInterfacciaIDOrario or ID_INTRFC = $NPRInterfacciaIDOrario]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;/tns2:FileNameResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FileNameResponse&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot;"&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $CPSInterfacciaIDOrario or ID_INTRFC = $CPSInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;"&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NPNGInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $REGInterfacciaIDOrario or ID_INTRFC = $REGInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot; or $FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;"&gt;&lt;tns2:FileNameCPS&gt;&lt;xsl:value-of select="$FileNameCallProcess/tns1:NewString"/&gt;&lt;/tns2:FileNameCPS&gt;&lt;/xsl:if&gt;&lt;/tns2:FileNameResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;FWA&amp;quot;"&gt;&lt;tns2:FileNameResponse&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $FWAInterfacciaIDOrario]/LOCAL_PATH, &amp;quot;/tmp/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;/tns2:FileNameResponse&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;GPON&amp;quot;"&gt;&lt;tns2:FileNameResponse&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $GPONInterfacciaIDOrario or ID_INTRFC = $GPONInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/tmp/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;/tns2:FileNameResponse&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$FileNameOperationIn/FileNameInput/tns2:FileNameRequest/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;"&gt;&lt;tns2:FileNameResponse&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NGAInterfacciaIDOrario or ID_INTRFC = $NGAInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/tmp/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;tns2:FileNameAQ&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NGAInterfacciaIDOrarioAQ or ID_INTRFC = $NGAInterfacciaIDGiornalieroAQ]/LOCAL_PATH, &amp;quot;/tmp/&amp;quot;, tib:trim($FileNameAQCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileNameAQ&gt;&lt;/tns2:FileNameResponse&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:FileNameResponse&gt;&lt;tns2:FileName&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $XDSLInterfacciaIDOrario or ID_INTRFC = $XDSLInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/tmp/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileName&gt;&lt;tns2:FileNameAQ&gt;&lt;xsl:value-of select="concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $XDSLInterfacciaIDOrarioAQ or ID_INTRFC = $XDSLInterfacciaIDGiornalieroAQ]/LOCAL_PATH, &amp;quot;/tmp/&amp;quot;, tib:trim($FileNameAQCallProcess/tns1:NewString))"/&gt;&lt;/tns2:FileNameAQ&gt;&lt;/tns2:FileNameResponse&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/FileNameOutput&gt;&lt;/tns:FileNameResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/FileName/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn.FileNameInput&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameCallProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_SISTEMA_IP_INTRFC&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;REGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;FileNameAQCallProcess&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPRInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;CPSInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;GPONInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;GPONInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;FWAInterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPNGInterfacciaIDGiornaliero&quot;/>&#xa;    &lt;xsl:param name=&quot;NPN103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:param name=&quot;NPR103InterfacciaIDOrario&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNameOperationOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPN&amp;quot; or $FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPR&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:FlagNP_103='SI'&quot;>&#xa;                                &lt;tns2:FileNameResponse>&#xa;                                    &lt;tns2:FileName>&#xa;                                        &lt;xsl:value-of select=&quot;concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NPN103InterfacciaIDOrario or ID_INTRFC = $NPR103InterfacciaIDOrario]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))&quot;/>&#xa;                                    &lt;/tns2:FileName>&#xa;                                &lt;/tns2:FileNameResponse>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:FileNameResponse>&#xa;                                    &lt;tns2:FileName>&#xa;                                        &lt;xsl:value-of select=&quot;concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NPNInterfacciaIDOrario or ID_INTRFC = $NPRInterfacciaIDOrario]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))&quot;/>&#xa;                                    &lt;/tns2:FileName>&#xa;                                &lt;/tns2:FileNameResponse>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:FileNameResponse>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;CPS&amp;quot;&quot;>&#xa;                                    &lt;tns2:FileName>&#xa;                                        &lt;xsl:value-of select=&quot;concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $CPSInterfacciaIDOrario or ID_INTRFC = $CPSInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))&quot;/>&#xa;                                    &lt;/tns2:FileName>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NPNG&amp;quot;&quot;>&#xa;                                    &lt;tns2:FileName>&#xa;                                        &lt;xsl:value-of select=&quot;concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $NPNGInterfacciaIDGiornaliero]/LOCAL_PATH, &amp;quot;/&amp;quot;, tib:trim($FileNameCallProcess/tns1:NewString))&quot;/>&#xa;                                    &lt;/tns2:FileName>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns2:FileName>&#xa;                                        &lt;xsl:value-of select=&quot;concat($JDBC_SISTEMA_IP_INTRFC/Record[ID_INTRFC = $REGInterfacciaIDOrario or ID_INTRFC = $REGI