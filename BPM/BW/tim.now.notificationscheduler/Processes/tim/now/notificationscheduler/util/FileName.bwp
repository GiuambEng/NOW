                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/FileName&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FileNameOperationIn.FileNameInput&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_INTERFACCIA&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;NGAInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDOrarioAQ&quot;/>&#xa;    &lt;xsl:param name=&quot;XDSLInterfacciaIDGiornalieroAQ&quot;/>&#xa;    &lt;xsl:template name=&quot;FileNameAQCallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$FileNameOperationIn.FileNameInput/tns2:TempoNotifica = &amp;quot;ORARIO&amp;quot;&quot;>&#xa;                        &lt;tns1:InputString>&#xa;                            &lt;tns1:OldString>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_INTERFACCIA/Record[ID_INTRFC = $NGAInterfacciaIDOrarioAQ]/NAMING_CONVENTION&quot;/>&#xa;                            &lt;/tns1:OldString>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;ISP&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;GGMMAAAA&amp;quot;&quot;/>&#xa;                            &lt;/tns1:OldChar>&#xa;                            &lt;tns1:OldChar>&#xa;                                &lt;xsl:value-of select=&quot;