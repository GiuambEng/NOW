                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_INTRFC_AQ"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_SISTEMA"/>
                                    <columnMetadata
