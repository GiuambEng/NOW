                                bindingType="moduleProperty"
                                eAttributeName="timeInterval" processProperty="TimerOrario"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Timer"/>
                                    <value
                                    endTime="2016-09-06T20:16:17.635+0200"
                                    intervalUnit="Second" xsi:type="generalactivities:Timer"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="JDBC_OLO-input"
                    name="JDBC_OLO" outputVariable="JDBC_OLO"
                    tibex:xpdlId="c5acc9e4-162b-48b0-bf9a-3701c397a822" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="__Link"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_OLOToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c5acc9e4-162b-48b0-bf9a-3701c397a822+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IDSistemaOLO&quot;/>&lt;xsl:param name=&quot;IdInterfacciaFBS&quot;/>&lt;xsl:template name=&quot;JDBC_OLO-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDInterfacciaNGA>&lt;xsl:value-of select=&quot;$IdInterfacciaFBS&quot;/>&lt;/IDInterfacciaNGA>&lt;IDSistema>&lt;xsl:value-of select=&quot;$IDSistemaOLO&quot;/>&lt;/IDSistema>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="Timeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT OLO.COD_OLO, OLO.CODFC_OLO_AGCOM, FLG_NAMESPACE_F_NOTIF&#xa;  FROM OLO OLO, SISTEMA_IP_INTRFC INTR&#xa;  WHERE OLO.CODFC_OLO_AGCOM = INTR.CODFC_OLO_AGCOM AND INTR.ID_INTRFC = ?&#xa;  AND INTR.ID_SISTEMA = ? AND FLAG_ENABLED = 'Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDInterfacciaNGA"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDSistema"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLG_NAMESPACE_F_NOTIF"
                                    dataType="1"
                                    status="OptionalElement" typeName="CHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="cfe01245-865c-4121-bc79-32978c08c20f">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="__Link4"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while" tibex:xpdlId="7dc35ebb-9b59-43d5-8ab7-9a48bb86ba4b">
                    <bpws:empty name="GroupInit" tibex:group="groupInit" tibex:xpdlId="2ef64cde-0871-40dc-9322-42f615c0b952"/>
                    <bpws:while name="while" tibex:counterName="index" tibex:xpdlId="ff5f91f1-af39-42cb-adc2-655d59569552">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($JDBC_OLO/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($JDBC_OLO/Record)]]></bpws:condition>
                        <bpws:flow name="flow1" tibex:xpdlId="242b5b65-0695-4a90-868e-6807c21f5f08">
                            <bpws:links>
                                <bpws:link name="InvokeToError" tibex:linkType="ERROR"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="12b3141b-ea93-432a-83f1-2ce287caa088">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToInvoke"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="c0d8ca1d-d30a-4839-804e-5d8769c8e28d">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                    <bpws:target linkName="InvokeToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="Error-input"
                                    name="Error"
                                    tibex:xpdlId="a22e41eb-47c3-48a7-91f8-d0af5b3e1f39"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="InvokeToError"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;Error-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioFBS&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioFBS&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioFBS&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns1:BusinessID>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Errore nella creazione file per l'OLO: &amp;quot;, $JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM, &amp;quot;.&amp;quot;)&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke inputVariable="Invoke-input"
                                name="Invoke" operation="FBSScheduler"
                                partnerLink="FBSSchedulerPortType"
                                portType="ns0:FBSSchedulerPortType" tibex:xpdlId="b6f5c635-02cc-406e-a6d9-7cdbcff9f2e3">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/" xmlns:tns3="http://www.tim.com/NOW/xsd/NotificationScheduler" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="JDBC_OLO"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns2:FBSSchedulerRequest&gt;&lt;SchedulerInput&gt;&lt;tns3:SchedulerInput&gt;&lt;tns3:TempoNotifica&gt;&lt;xsl:value-of select="&amp;quot;ORARIO&amp;quot;"/&gt;&lt;/tns3:TempoNotifica&gt;&lt;tns3:StrutturaRichiesta&gt;&lt;xsl:value-of select="&amp;quot;FIBERSTREAM&amp;quot;"/&gt;&lt;/tns3:StrutturaRichiesta&gt;&lt;tns3:CodiceOLO&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/COD_OLO"/&gt;&lt;/tns3:CodiceOLO&gt;&lt;tns3:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM"/&gt;&lt;/tns3:CodiceOLOAGCOM&gt;&lt;xsl:if test="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"&gt;&lt;tns3:FlagNamespaceFileNotifica&gt;&lt;xsl:value-of select="$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF"/&gt;&lt;/tns3:FlagNamespaceFileNotifica&gt;&lt;/xsl:if&gt;&lt;/tns3:SchedulerInput&gt;&lt;/SchedulerInput&gt;&lt;/tns2:FBSSchedulerRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/NotificationScheduler/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/NotificationScheduler&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:SchedulerInput>&#xa;            &lt;tns3:TempoNotifica>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;ORARIO&amp;quot;&quot;/>&#xa;            &lt;/tns3:TempoNotifica>&#xa;            &lt;tns3:StrutturaRichiesta>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;FIBERSTREAM&amp;quot;&quot;/>&#xa;            &lt;/tns3:StrutturaRichiesta>&#xa;            &lt;tns3:CodiceOLO>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/COD_OLO&quot;/>&#xa;            &lt;/tns3:CodiceOLO>&#xa;            &lt;tns3:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/CODFC_OLO_AGCOM&quot;/>&#xa;            &lt;/tns3:CodiceOLOAGCOM>&#xa;            &lt;xsl:if test=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;>&#xa;                &lt;tns3:FlagNamespaceFileNotifica>&#xa;                    &lt;xsl:value-of select=&quot;$JDBC_OLO/Record[number($index)]/FLG_NAMESPACE_F_NOTIF&quot;/>&#xa;                &lt;/tns3:FlagNamespaceFileNotifica>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:SchedulerInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                    <bpws:source
                                    linkName="InvokeToError"
                                    tibex:faultDetailsVar="_error" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="1a69593c-ed7d-46a1-b402-47cfb3ed6b2b">
                <bpws:targets>
                    <bpws:target linkName="__Link4"/>
                </bpws:targets>
            </bpws:exit>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogJDBC_OLO-input"
                    name="LogJDBC_OLO"
                    tibex:xpdlId="8ba1b9ab-22b1-4cc1-8886-26bf17b8e252"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_OLOToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBC_OLO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:template name=&quot;LogJDBC_OLO-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.notificationscheduler.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioFBS&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioFBS&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;NotificationSchedulerOrarioFBS&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$_processContext/ProcessInstanceId&quot;/>&lt;/tns1:BusinessID>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;JDBC_OLO: &amp;quot;, tib:render-xml($JDBC_OLO, true(),true()))&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
