<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/GestPacchettiSingleRich" 
		   targetNamespace="http://www.tim.com/NOW/xsd/GestPacchettiSingleRich"
		   elementFormDefault="qualified" attributeFormDefault="unqualified" >

<element name="GestPacchettiSingleRich">
   	<complexType>
   		<sequence>
   			<element maxOccurs="unbounded" minOccurs="0" name="GestPacchettiSingleRich_Type">
    			<complexType>
    				<sequence>
    					<element maxOccurs="1" minOccurs="0" type="string"  name="IdCorrelazione" />
    					<element maxOccurs="1" minOccurs="0" type="string"  name="DataCreazione" />
    					<element maxOccurs="unbounded" minOccurs="0" name="RichiestaOlo_Stato" >
    						<complexType>
    							<sequence>
    								<element type="string" name="IdRichiestaOlo" />
    								<element type="string" name="Stato" />
    							</sequence>
    						</complexType>
    					</element>
    				</sequence>
    			</complexType>
    		</element>
    	</sequence>
    </complexType>
</element>

<element name="SetParameterNameValue">
   	<complexType>
   		<sequence>
			<element name="parameterMap">
				<complexType>
					<sequence>
						<element maxOccurs="unbounded" minOccurs="0" name="parameter">
							<complexType>
			    				<sequence>
			    					<element type="string" name="name" />
			    					<element type="string" name="value" />
			    				</sequence>
			    			</complexType>
						</element>
					</sequence>
				</complexType>
			</element>
    	</sequence>
    </complexType>
</element>
<element name="CallBPMRequest">
   	<complexType>
   		<sequence>
    		<element type="string" name="IdRichiestaOlo" minOccurs="0"/>
    		<element type="string" name="FlagScartato" minOccurs="0"/>
    	</sequence>
    </complexType>
</element>
<element name="FlagSblocco">
   	<complexType>
   		<sequence>
    		<element type="string" name="FlagSblocco" minOccurs="0"/>
    	</sequence>
    </complexType>
</element>
</schema>