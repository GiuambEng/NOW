                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select ID_RICH_OLO,TRANSACTION_ID,TRANSACTION_DATE,NUMERO_LINEA,TIPO_SRVZ,COD_OLO_NUMERICO,&#xa;CODFC_OLO_AGCOM,DES,ID_ESEC_PROCSO_NO_FILE&#xa;from STAG_RAC_PORTABILITA_NOF_OUT&#xa;WHERE ID_STATO_ELAB_STAG='12'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
