                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TRANSACTION_ID"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TRANSACTION_DATE"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="NUMERO_LINEA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO_SRVZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO_NUMERICO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnName="DES"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="ID_ESEC_PROCSO_NO_FILE"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogGetRequestKo-input"
                    name="LogGetRequestKo"
                    tibex:xpdlId="4be960c3-be9f-47a0-9524-5a44e07b88ee"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetRequestKoToLogGetRequestKo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogGetRequestKoToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;GetRequestKo&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogGetRequestKo-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.SingleNode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NowToRacScheduler&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;GerRequestKo Result: &amp;quot;,xsd:string(count($GetRequestKo/Record)),' record trovati')&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.Integration.NowToRac&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RacSendOloFromNow&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;NowToRacScheduler_STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload/>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a7f0ba5a-90fc-4149-872a-dd85aee1b54e">
                <bpws:targets>
                    <bpws:target linkName="LogGetRequestKoToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToExit"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="number($index)&lt;=count($GetRequestKo/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[number($index)<=count($GetRequestKo/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToLogRecordProcessato" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogRecordProcessatoToInvoke" tibex:linkType="SUCCESS"/>
                                <bpws:link name="InvokeToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="91f3775d-a44d-4861-a1a0-693a3bed7288">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToLogRecordProcessato"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="c9c1fb76-0a3a-4ba0-8db0-40fb481be16f">
                                <bpws:targets>
                                    <bpws:target linkName="InvokeToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogRecordProcessato-input"
                                    name="LogRecordProcessato"
                                    tibex:xpdlId="efd350f3-5486-4db6-aa77-a1bee5ee8077"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToLogRecordProcessato"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogRecordProcessatoToInvoke"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;GetRequestKo&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogRecordProcessato-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.SingleNode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;NowToRacScheduler&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Record processato: &amp;quot; ,tib:render-xml($GetRequestKo/Record[number($index)], true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.Integration.NowToRac&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;RacSendOloFromNow&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;NowToRacScheduler_STARTED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload/>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="InvokeSharedNowToRac-input"
                                name="InvokeSharedNowToRac"
                                operation="InvokeRac"
                                outputVariable="InvokeSharedNowToRac"
                                partnerLink="SharedNowToRac"
                                portType="ns5:SharedNowToRacPortType" tibex:xpdlId="8321fcb0-a7fd-4093-a6fd-201beba77bc4">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/SharedNowToRac/" xmlns:RAC="http://wsracweb/type-definitions/RACSendOLOFromNOW" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/NowToRacService" version="2.0"&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:param name="GetRequestKo"/&gt;&lt;xsl:template name="InvokeSharedNowToRac-input" match="/"&gt;&lt;tns:InvokeRacRequest&gt;&lt;parameters&gt;&lt;tns1:NowToRacRequest&gt;&lt;tns1:TransactionInfo&gt;&lt;tns1:Transaction_id&gt;&lt;xsl:value-of select="$GetRequestKo/Record[1]/TRANSACTION_ID"/&gt;&lt;/tns1:Transaction_id&gt;&lt;tns1:Transaction_date&gt;&lt;xsl:value-of select="$GetRequestKo/Record[1]/TRANSACTION_DATE"/&gt;&lt;/tns1:Transaction_date&gt;&lt;/tns1:TransactionInfo&gt;&lt;tns1:NOWRequest&gt;&lt;tns1:NUMERO_LINEA&gt;&lt;xsl:value-of select="$GetRequestKo/Record[number($index)]/NUMERO_LINEA"/&gt;&lt;/tns1:NUMERO_LINEA&gt;&lt;tns1:SERVIZIO&gt;&lt;xsl:value-of select="$GetRequestKo/Record[number($index)]/TIPO_SRVZ"/&gt;&lt;/tns1:SERVIZIO&gt;&lt;tns1:SIGLA_OLO&gt;&lt;xsl:value-of select="$GetRequestKo/Record[number($index)]/CODFC_OLO_AGCOM"/&gt;&lt;/tns1:SIGLA_OLO&gt;&lt;tns1:DATA_ESPLETAMENTO&gt;&lt;xsl:value-of select="xsd:date($GetRequestKo/Record[number($index)]/DES)"/&gt;&lt;/tns1:DATA_ESPLETAMENTO&gt;&lt;/tns1:NOWRequest&gt;&lt;tns1:IdRichiestaOLO&gt;&lt;xsl:value-of select="$GetRequestKo/Record[number($index)]/ID_RICH_OLO"/&gt;&lt;/tns1:IdRichiestaOLO&gt;&lt;tns1:FlagScheduler&gt;&lt;xsl:value-of select="true()"/&gt;&lt;/tns1:FlagScheduler&gt;&lt;tns1:IDEsecProcsoNoFile&gt;&lt;xsl:value-of select="xsd:integer($GetRequestKo/Record[number($index)]/ID_ESEC_PROCSO_NO_FILE)"/&gt;&lt;/tns1:IDEsecProcsoNoFile&gt;&lt;/tns1:NowToRacRequest&gt;&lt;/parameters&gt;&lt;/tns:InvokeRacRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/SharedNowToRac/&quot; xmlns:RAC=&quot;http://wsracweb/type-definitions/RACSendOLOFromNOW&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NowToRacService&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;GetRequestKo&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeSharedNowToRac-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NowToRacRequest>&#xa;            &lt;tns1:TransactionInfo>&#xa;                &lt;tns1:Transaction_id>&#xa;                    &lt;xsl:value-of select=&quot;$GetRequestKo/Record[1]/TRANSACTION_ID&quot;/>&#xa;                &lt;/tns1:Transaction_id>&#xa;                &lt;tns1:Transaction_date>&#xa;                    &lt;xsl:value-of select=&quot;$GetRequestKo/Record[1]/TRANSACTION_DATE&quot;/>&#xa;                &lt;/tns1:Transaction_date>&#xa;            &lt;/tns1:TransactionInfo>&#xa;            &lt;tns1:NOWRequest>&#xa;                &lt;tns1:NUMERO_LINEA>&#xa;                    &lt;xsl:value-of select=&quot;$GetRequestKo/Record[number($index)]/NUMERO_LINEA&quot;/>&#xa;                &lt;/tns1:NUMERO_LINEA>&#xa;                &lt;tns1:SERVIZIO>&#xa;                    &lt;xsl:value-of select=&quot;$GetRequestKo/Record[number($index)]/TIPO_SRVZ&quot;/>&#xa;                &lt;/tns1:SERVIZIO>&#xa;                &lt;tns1:SIGLA_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$GetRequestKo/Record[number($index)]/CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/tns1:SIGLA_OLO>&#xa;                &lt;tns1:DATA_ESPLETAMENTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:date($GetRequestKo/Record[number($index)]/DES)&quot;/>&#xa;                &lt;/tns1:DATA_ESPLETAMENTO>&#xa;            &lt;/tns1:NOWRequest>&#xa;            &lt;tns1:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$GetRequestKo/Record[number($index)]/ID_RICH_OLO&quot;/>&#xa;            &lt;/tns1:IdRichiestaOLO>&#xa;            &lt;tns1:FlagScheduler>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns1:FlagScheduler>&#xa;            &lt;tns1:IDEsecProcsoNoFile>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($GetRequestKo/Record[number($index)]/ID_ESEC_PROCSO_NO_FILE)&quot;/>&#xa;            &lt;/tns1:IDEsecProcsoNoFile>&#xa;        &lt;/tns1:NowToRacRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="LogRecordProcessatoToInvoke"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeToGroupEnd"/>
                                </bpws:sources>
                            </bpws:invoke>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:exit name="Exit" tibex:xpdlId="208d8652-52c1-4aa8-8801-bb7afc87c390">
                <bpws:targets>
                    <bpws:target linkName="WhileToExit"/>
                </bpws:targets>
            </bpws:exit>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
