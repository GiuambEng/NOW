                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="LOG_FaultToConfirmOnError" tibex:linkType="SUCCESS"/>
                            <bpws:link name="ConfirmOnErrorToExit" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
