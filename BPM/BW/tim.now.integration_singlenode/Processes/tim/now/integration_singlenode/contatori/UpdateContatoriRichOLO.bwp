            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallProcessLog-input"
                    name="CallProcessLog"
                    tibex:xpdlId="ad59c07c-e4bd-440d-80c7-c941f0897894"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToCallProcessLog"/>
                        <bpws:target linkName="Assign_StatoRichiestaCHIUSO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessLogToLOG_Output">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessLogToWhile1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="xsd:int($Select_FileProcstoInput/Record[1]/QT_RECD_OK) + xsd:int($Select_FileProcstoInput/Record[1]/QT_RECD_KO) + 1 = $Record_Totali and $Select_FileProcstoInput/Record[1]/DESCR_STATO_FILE='CHIUSO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[xsd:int($Select_FileProcstoInput/Record[1]/QT_RECD_OK) + xsd:int($Select_FileProcstoInput/Record[1]/QT_RECD_KO) + 1 = $Record_Totali and $Select_FileProcstoInput/Record[1]/DESCR_STATO_FILE='CHIUSO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Logger_Name&quot;/>&lt;xsl:param name=&quot;Log_Level&quot;/>&lt;xsl:param name=&quot;Select_FileProcstoInput&quot;/>&lt;xsl:param name=&quot;MapperContatoriRichOLORequest&quot;/>&lt;xsl:template name=&quot;CallProcessLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;UpdateContatoriRichOLO&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoRichiesteOLO&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoContatori&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MapperContatoriRichOLORequest/tns1:Id_Rich_Olo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Update: &amp;quot;, string($Select_FileProcstoInput/Record[1]/QT_RECD_OK), &amp;quot; RECORD_KO: &amp;quot;, string($Select_FileProcstoInput/Record[1]/QT_RECD_KO), &amp;quot; RECORD_TOTALI: &amp;quot;, string($Select_FileProcstoInput/Record[1]/QT_RECD_NOW), &amp;quot; Stato della richiesta: &amp;quot;, $MapperContatoriRichOLORequest/tns1:Stato_Case_Richiesta)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Log_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Select_FileProcstoInput-input"
                    name="Select_FileProcstoInput"
                    outputVariable="Select_FileProcstoInput"
                    tibex:xpdlId="499ed14f-b844-4442-aa9f-0df6fd6b9bdd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_InputToSelect_FileProcstoInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Select_FileProcstoInputToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Select_FileProcstoInputToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Select_FileProcstoInput/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($Select_FileProcstoInput/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+499ed14f-b844-4442-aa9f-0df6fd6b9bdd+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperContatoriRichOLORequest&quot;/>&lt;xsl:template name=&quot;Select_FileProcstoInput-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;idFileProcstoInput>&lt;xsl:value-of select=&quot;$MapperContatoriRichOLORequest/tns1:Id_File_Procsto_Input&quot;/>&lt;/idFileProcstoInput>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NVL(fpi.QT_RECD_KO, 0) as QT_RECD_KO, NVL(fpi.QT_RECD_OK, 0) as QT_RECD_OK, &#xd;&#xa;&#x9;NVL(fpi.QT_RECD_NOW, 0) as QT_RECD_NOW, NVL(fp.DESCR_STATO_FILE, 0) as DESCR_STATO_FILE&#xd;&#xa; FROM FILE_PROCSTO_INPUT fpi , FILE_PROCSTO fp&#xd;&#xa; WHERE fpi.ID_FILE_PROCSTO_INPUT = ? AND fp.ID_FILE=fpi.ID_FILE_PROCSTO_INPUT" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="idFileProcstoInput"/>
                                    <columnMetadata
                                    columnName="QT_RECD_KO"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_OK"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="QT_RECD_NOW"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_STATO_FILE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Result-input"
                    name="LOG_Result"
                    tibex:xpdlId="09a229bc-4609-4df1-8f35-ecfc942c9a30"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Select_FileProcstoInputToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_ResultToAssign_QtRecdTot">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_ResultToLOG_Result_No_Rich_NoRichNOW">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Select_FileProcstoInput/Record[1]/QT_RECD_NOW=0 and $Select_FileProcstoInput/Record[1]/DESCR_STATO_FILE='CHIUSO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Select_FileProcstoInput/Record[1]/QT_RECD_NOW=0 and $Select_FileProcstoInput/Record[1]/DESCR_STATO_FILE='CHIUSO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Logger_Name&quot;/>&lt;xsl:param name=&quot;Log_Level&quot;/>&lt;xsl:param name=&quot;Select_FileProcstoInput&quot;/>&lt;xsl:param name=&quot;MapperContatoriRichOLORequest&quot;/>&lt;xsl:template name=&quot;LOG_Result-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;UpdateContatoriRichOLO&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoRichiesteOLO&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoContatori&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MapperContatoriRichOLORequest/tns1:Id_Rich_Olo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Risultati per FILE_PROCSTO_INPUT. RECORD_OK: &amp;quot;, string($Select_FileProcstoInput/Record[1]/QT_RECD_OK), &amp;quot; RECORD_KO: &amp;quot;, string($Select_FileProcstoInput/Record[1]/QT_RECD_KO), &amp;quot; RECORD_TOTALI: &amp;quot;, string($Select_FileProcstoInput/Record[1]/QT_RECD_NOW), &amp;quot; Stato della richiesta: &amp;quot;, $MapperContatoriRichOLORequest/tns1:Stato_Case_Richiesta)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Log_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LOG_Input-input"
                    name="LOG_Input"
                    tibex:xpdlId="231663a5-5e93-4363-b5aa-24b60699f1c3"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToLOG_Input"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_InputToSelect_FileProcstoInput"/>
                    </bpws:sources>
