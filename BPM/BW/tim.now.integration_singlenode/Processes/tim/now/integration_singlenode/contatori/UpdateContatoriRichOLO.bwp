            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="cf0e8d59-94b6-49f9-b3e3-7a8e216ff6e0">
                <bpws:targets>
                    <bpws:target linkName="CallProcessLogToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToCallProcessLog1"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$UpdFileProcsto=false() and $index&lt;$MaxRetry" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$UpdFileProcsto=false() and $index<$MaxRetry]]></bpws:condition>
                        <bpws:flow name="flow6">
                            <bpws:links>
                                <bpws:link
                                    name="Upd_File_ProcstoToLogError_Upd_File_Procsto" tibex:linkType="ERROR"/>
                                <bpws:link
                                    name="LogError_Upd_File_ProcstoToSleep1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart2ToUpd_File_Procsto" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Sleep1ToGroupEnd2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Upd_File_ProcstoToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToGroupEnd2" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart2"
                                tibex:group="groupStart" tibex:xpdlId="82fb289b-bf3c-42b3-a28f-5704ad53320d">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToUpd_File_Procsto"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd2"
                                tibex:group="groupEnd" tibex:xpdlId="56449f48-61aa-4442-85ce-69d22109997c">
                                <bpws:targets>
                                    <bpws:target linkName="Sleep1ToGroupEnd2"/>
                                    <bpws:target linkName="Assign1ToGroupEnd2"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Upd_File_Procsto-input"
                                    name="Upd_File_Procsto"
                                    outputVariable="Upd_File_Procsto"
                                    tibex:xpdlId="20ac6664-72cf-4904-a587-2dcc27b76bcb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToUpd_File_Procsto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source
                                    linkName="Upd_File_ProcstoToLogError_Upd_File_Procsto"
                                    tibex:faultDetailsVar="Upd_File_Procsto" tibex:faultNameVar="FaultName">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="Upd_File_ProcstoToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+20ac6664-72cf-4904-a587-2dcc27b76bcb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;MapperContatoriRichOLORequest&quot;/>&lt;xsl:template name=&quot;Upd_File_Procsto-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;ID_File>&lt;xsl:value-of select=&quot;$MapperContatoriRichOLORequest/tns1:Id_File_Procsto_Input&quot;/>&lt;/ID_File>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE FILE_PROCSTO&#xa;  SET DESCR_STATO_FILE = 'ELABORATO' WHERE ID_FILE = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_File"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogError_Upd_File_Procsto-input"
                                    name="LogError_Upd_File_Procsto"
                                    tibex:xpdlId="c4157c97-c378-42cd-af59-5c0223846f42"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Upd_File_ProcstoToLogError_Upd_File_Procsto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogError_Upd_File_ProcstoToSleep1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Logger_Name&quot;/>&lt;xsl:param name=&quot;Log_Level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;MapperContatoriRichOLORequest&quot;/>&lt;xsl:template name=&quot;LogError_Upd_File_Procsto-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;UpdateContatoriRichOLO&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoRichiesteOLO&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoContatori&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MapperContatoriRichOLORequest/tns1:Id_Rich_Olo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Update su FILE_PROCSTO non eseguito. Tentativo di retry num: &amp;quot;,string($index ))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Log_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
