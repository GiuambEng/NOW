                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Assign_StatoRichiestaCHIUSO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$MapperContatoriRichOLORequest/tns:Stato_Case_Richiesta='CHIUSO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$MapperContatoriRichOLORequest/tns:Stato_Case_Richiesta='CHIUSO']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Select_FileProcstoInput&quot;/>&lt;xsl:param name=&quot;MapperContatoriRichOLORequest&quot;/>&lt;xsl:template name=&quot;Update_data&quot; match=&quot;/&quot;>&lt;tns:UpdateFILE_PROCSTO_INPUT_Root>&lt;tns:Update_FILE_PROCSTO_INPUT>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MapperContatoriRichOLORequest/tns:Stato_Case_Richiesta) = &amp;quot;SCARTATO&amp;quot;&quot;>&lt;tns:QT_RECD_KO>&lt;xsl:value-of select=&quot;$Select_FileProcstoInput/Record[1]/QT_RECD_KO+1&quot;/>&lt;/tns:QT_RECD_KO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:QT_RECD_KO>&lt;xsl:value-of select=&quot;$Select_FileProcstoInput/Record[1]/QT_RECD_KO&quot;/>&lt;/tns:QT_RECD_KO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($MapperContatoriRichOLORequest/tns:Stato_Case_Richiesta) = &amp;quot;ACQUISITO&amp;quot;&quot;>&lt;tns:QT_RECD_OK>&lt;xsl:value-of select=&quot;$Select_FileProcstoInput/Record[1]/QT_RECD_OK+1&quot;/>&lt;/tns:QT_RECD_OK>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:QT_RECD_OK>&lt;xsl:value-of select=&quot;$Select_FileProcstoInput/Record[1]/QT_RECD_OK&quot;/>&lt;/tns:QT_RECD_OK>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Update_FILE_PROCSTO_INPUT>&lt;/tns:UpdateFILE_PROCSTO_INPUT_Root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Update_data" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LOG_Result_No_Rich_NOW-input"
                    name="LOG_Result_No_Rich_NOW"
                    tibex:xpdlId="449f3dcd-e73d-4445-bd7a-013a7e4faebf"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_ResultToLOG_Result_No_Rich_NoRichNOW"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_Result_No_Rich_NOWToLOG_Output"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/AggiornamentoContatoriRichOLO&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Logger_Name&quot;/>&lt;xsl:param name=&quot;Log_Level&quot;/>&lt;xsl:param name=&quot;Select_FileProcstoInput&quot;/>&lt;xsl:param name=&quot;MapperContatoriRichOLORequest&quot;/>&lt;xsl:template name=&quot;LOG_Result_No_Rich_NOW-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;UpdateContatoriRichOLO&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoRichiesteOLO&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;AggiornamentoContatori&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$MapperContatoriRichOLORequest/tns1:Id_Rich_Olo&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Richieste NOW non presenti. RECORD NOW:&amp;quot;, string($Select_FileProcstoInput/Record[1]/QT_RECD_NOW), &amp;quot; Stato del FILE: &amp;quot;, string($Select_FileProcstoInput/Record[1]/DESCR_STATO_FILE))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Log_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="CallProcessLog1-input"
                    name="CallProcessLog1"
