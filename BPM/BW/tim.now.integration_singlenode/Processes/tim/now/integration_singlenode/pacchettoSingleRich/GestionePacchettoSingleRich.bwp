cchettiSingleRich_Type[number($index)]/tns:IdCorrelazione and string(DATACREAZIONE) = $GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:DataCreazione])&quot;>&lt;tns:FlagSblocco>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FlagSblocco>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FlagSblocco>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/tns:FlagSblocco>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FlagSblocco>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FlagSblocco>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;count($PactoSingleRich/Record[ID_CORLZ = $GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:IdCorrelazione and string(DATACREAZIONE) = $GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:DataCreazione and STATO_RICH = (&amp;quot;SCARTATO&amp;quot;, &amp;quot;ATTESA_SBLOCCO_AMMIS&amp;quot;, &amp;quot;ATTESA_SBLOCCO_FORMA&amp;quot;, &amp;quot;ATTESA_SBLOCCO_CODIC&amp;quot;, &amp;quot;ATTESA_SBLOCCO_TECNI&amp;quot;, &amp;quot;ATTESA_SBLOCCO_EVASI&amp;quot;, &amp;quot;ATTESA_SBLOCCO_TIRET&amp;quot;, &amp;quot;ANNULLATO&amp;quot;,&amp;quot;ATTESA_SBLOCCO_ORD&amp;quot;,&amp;quot;ATTESA_SBLOCCO_CAUT&amp;quot;)]) &amp;lt; count($PactoSingleRich/Record[ID_CORLZ = $GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:IdCorrelazione and string(DATACREAZIONE) = $GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:DataCreazione])&quot;>&lt;tns:FlagSblocco>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns:FlagSblocco>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FlagSblocco>&lt;xsl:value-of select=&quot;'S'&quot;/>&lt;/tns:FlagSblocco>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:FlagSblocco>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
