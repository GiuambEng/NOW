                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_CORLZ, ID_RICH_OLO, STATO_RICH, trunc(CREATED) as DataCreazione &#xd;&#xa;&#x9;FROM PACTO_SINGLE_RICH &#xd;&#xa;&#x9;WHERE STATO_RICH NOT IN ('ACQUISITO','ACQUISITOKO')&#xd;&#xa;&#x9;&#x9;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="ID_CORLZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATO_RICH"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATACREAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogPactoSingleRich-input"
                    name="LogPactoSingleRich"
                    tibex:xpdlId="fabefca9-27bd-478a-abad-b07fdf0de47d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PactoSingleRichToLogPactoSingleRich"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogPactoSingleRichToLogEnd_NoRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($PactoSingleRich/Record) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($PactoSingleRich/Record) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogPactoSingleRichToAssignRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;PactoSingleRich&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPactoSingleRich-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GestionePacchettoSingleRich&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($PactoSingleRich/Record) > 0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Risultati query su PactoSingleRich: &amp;quot;, tib:render-xml($PactoSingleRich, true(), true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record recuperato dalla tabella PactoSingleRich.&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
