                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GestPacchettiSingleRich&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;PactoSingleRich&quot;/>&lt;xsl:template name=&quot;GestionePacchetto&quot; match=&quot;/&quot;>&lt;tns:GestPacchettiSingleRich>&lt;xsl:for-each-group select=&quot;$PactoSingleRich/Record/ID_CORLZ&quot; group-by=&quot;concat(.,string(../DATACREAZIONE))&quot;>&lt;tns:GestPacchettiSingleRich_Type>&lt;xsl:variable name=&quot;varIdCorrelazione&quot; select=&quot;.&quot;/>&lt;xsl:variable name=&quot;varDataCreazione&quot; select=&quot;../DATACREAZIONE&quot;/>&lt;tns:IdCorrelazione>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:IdCorrelazione>&lt;xsl:if test=&quot;../DATACREAZIONE&quot;>&lt;tns:DataCreazione>&lt;xsl:value-of select=&quot;../DATACREAZIONE&quot;/>&lt;/tns:DataCreazione>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$PactoSingleRich/Record[ID_CORLZ = $varIdCorrelazione and DATACREAZIONE=$varDataCreazione]&quot;>&lt;tns:RichiestaOlo_Stato>&lt;tns:IdRichiestaOlo>&lt;xsl:value-of select=&quot;ID_RICH_OLO&quot;/>&lt;/tns:IdRichiestaOlo>&lt;tns:Stato>&lt;xsl:value-of select=&quot;STATO_RICH&quot;/>&lt;/tns:Stato>&lt;/tns:RichiestaOlo_Stato>&lt;/xsl:for-each>&lt;/tns:GestPacchettiSingleRich_Type>&lt;/xsl:for-each-group>&lt;/tns:GestPacchettiSingleRich>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
