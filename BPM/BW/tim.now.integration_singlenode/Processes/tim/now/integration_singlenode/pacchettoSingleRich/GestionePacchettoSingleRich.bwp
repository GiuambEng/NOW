                                    <tibex:expression
                                    expression="$index1 &lt;= count($GestionePacchetto/ns4:GestPacchettiSingleRich_Type[number($index)]/ns4:RichiestaOlo_Stato)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1 <= count($GestionePacchetto/ns4:GestPacchettiSingleRich_Type[number($index)]/ns4:RichiestaOlo_Stato)]]></bpws:condition>
                                    <bpws:flow name="flow3">
