                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3c8ff26e-4670-4c03-927a-347b4544a594+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GestPacchettiSingleRich&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GestionePacchetto&quot;/>&#xa;    &lt;xsl:param name=&quot;index1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdatePactoSingleRich-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcUpdateActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:RichiestaOlo_Stato[number($index1) and tns:Stato = &amp;quot;SCARTATO&amp;quot;]) > 0&quot;>&#xa;                    &lt;StatoRich>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ACQUISITOKO&amp;quot;&quot;/>&#xa;                    &lt;/StatoRich>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;StatoRich>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INLAVORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/StatoRich>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;LastUpdate>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/LastUpdate>&#xa;            &lt;IdRichiestaOlo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:RichiestaOlo_Stato[number($index1)]/tns:IdRichiestaOlo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GestionePacchetto/tns:GestPacchettiSingleRich_Type[number($index)]/tns:RichiestaOlo_Stato[number($index1)]/tns:IdRichiestaOlo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IdRichiestaOlo>&#xa;        &lt;/tns2:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
