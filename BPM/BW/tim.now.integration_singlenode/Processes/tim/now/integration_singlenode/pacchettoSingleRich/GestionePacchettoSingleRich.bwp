                                    <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogWhileInterno-input"
                                    name="LogWhileInterno"
                                    tibex:xpdlId="c998ba67-0604-4225-83d5-246568993a17"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToCallProcess"/>
