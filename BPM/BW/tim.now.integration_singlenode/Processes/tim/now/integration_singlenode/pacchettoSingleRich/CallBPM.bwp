            <bpws:invoke inputVariable="Invoke-input" name="Invoke"
                operation="createProcessInstance"
                outputVariable="Invoke" partnerLink="processManagement"
                portType="ns2:processManagement" tibex:xpdlId="c85f183b-f55b-4a12-88dd-70f5fe946a3a">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/bx/2009/management/process" xmlns:pm="http://www.tibco.com/bx/2009/management/processManagerType" xmlns:tns1="http://www.tim.com/NOW/xsd/GestPacchettiSingleRich" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="Invoke-input" match="/"&gt;&lt;tns:createProcessInstanceRequest&gt;&lt;params&gt;&lt;pm:createProcessInstanceInput&gt;&lt;pm:processQName&gt;&lt;pm:moduleName&gt;&lt;xsl:value-of select="&amp;quot;/tim.NOW.bpm.BusinessService/Process Packages/tim.NOW.bpm.pageFlow.sendSignals.xpdl&amp;quot;"/&gt;&lt;/pm:moduleName&gt;&lt;pm:processName&gt;&lt;xsl:value-of select="&amp;quot;SendSignalSyncPacchetti&amp;quot;"/&gt;&lt;/pm:processName&gt;&lt;/pm:processQName&gt;&lt;pm:operationName&gt;&lt;xsl:value-of select="&amp;quot;StartSyncPacchetto&amp;quot;"/&gt;&lt;/pm:operationName&gt;&lt;pm:options/&gt;&lt;pm:parameterMap&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="&amp;quot;IDRichiestaOLO&amp;quot;"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($Start/tns1:IdRichiestaOlo)"&gt;&lt;xsl:value-of select="$Start/tns1:IdRichiestaOlo"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;pm:parameter&gt;&lt;pm:name&gt;&lt;xsl:value-of select="&amp;quot;FlagScartato&amp;quot;"/&gt;&lt;/pm:name&gt;&lt;pm:value&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($Start/tns1:FlagScartato)"&gt;&lt;xsl:value-of select="$Start/tns1:FlagScartato"/&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:attribute name="xsi:nil"&gt;true&lt;/xsl:attribute&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/pm:value&gt;&lt;/pm:parameter&gt;&lt;/pm:parameterMap&gt;&lt;/pm:createProcessInstanceInput&gt;&lt;/params&gt;&lt;/tns:createProcessInstanceRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/bx/2009/management/process&quot; xmlns:pm=&quot;http://www.tibco.com/bx/2009/management/processManagerType&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GestPacchettiSingleRich&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Invoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;pm:createProcessInstanceInput>&#xa;            &lt;pm:processQName>&#xa;                &lt;pm:moduleName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;/tim.NOW.bpm.BusinessService/Process Packages/tim.NOW.bpm.pageFlow.sendSignals.xpdl&amp;quot;&quot;/>&#xa;                &lt;/pm:moduleName>&#xa;                &lt;pm:processName>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;SendSignalSyncPacchetti&amp;quot;&quot;/>&#xa;                &lt;/pm:processName>&#xa;            &lt;/pm:processQName>&#xa;            &lt;pm:operationName>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;StartSyncPacchetto&amp;quot;&quot;/>&#xa;            &lt;/pm:operationName>&#xa;            &lt;pm:options/>&#xa;            &lt;pm:parameterMap>&#xa;                &lt;pm:parameter>&#xa;                    &lt;pm:name>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDRichiestaOLO&amp;quot;&quot;/>&#xa;                    &lt;/pm:name>&#xa;                    &lt;pm:value>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:IdRichiestaOlo)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOlo&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/pm:value>&#xa;                &lt;/pm:parameter>&#xa;                &lt;pm:parameter>&#xa;                    &lt;pm:name>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FlagScartato&amp;quot;&quot;/>&#xa;                    &lt;/pm:name>&#xa;                    &lt;pm:value>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:FlagScartato)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:FlagScartato&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/pm:value>&#xa;                &lt;/pm:parameter>&#xa;            &lt;/pm:parameterMap>&#xa;        &lt;/pm:createProcessInstanceInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="StartToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToEnd"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
