                                scaext:policySetLocations="BWSoapHttpReferenceBinding"
                                serviceBindingQName="pt:ProcessManagerBinding"
                                serviceQName="pt:ProcessManagerService"
                                transportBindingType="HTTP"
                                wsdlLocation="platform:/resource/tim.now.integration_singlenode/Service%20Descriptors/BPM_API/processManagement.wsdl" xsi:type="axis2:SOAPReferenceBinding">
