                        xmlns:scaext="http://xsd.tns.tibco.com/amf/models/sca/extensions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                        <referenceBinding name="processManagement" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://www.tibco.com/bx/2009/management/process#wsdl.interface(processManagement)" scaext:wsdlLocation="../../../../../Service%20Descriptors/BPM_API/processManagement.wsdl"/>
                            <scaext:binding
                                locationURI="http://localhost:8080/bxEngine/node/processManagement/"
                                modelVersion="1.2.0"
                                name="SOAPReferenceBinding"
