                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/InvioNotificaInfoGpon&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DataAppuntamento&quot;/>&lt;xsl:template name=&quot;ListaOrdini&quot; match=&quot;/&quot;>&lt;tns4:ListaOrdini>&lt;xsl:for-each select=&quot;$DataAppuntamento/Record[NOMECOMPONENTE='DTUAPPUNTAMENTO']&quot;>&lt;tns4:ListaOrdini_Type>&lt;tns4:IdRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns4:IdRichiestaOlo>&lt;tns4:DataAppuntamento>&lt;xsl:value-of select=&quot;concat(substring(VALOREATTRIBUTO, 9, 2),'/',substring(VALOREATTRIBUTO, 6, 2),'/',substring(VALOREATTRIBUTO, 1, 4))&quot;/>&lt;/tns4:DataAppuntamento>&lt;/tns4:ListaOrdini_Type>&lt;/xsl:for-each>&lt;xsl:for-each select=&quot;$DataAppuntamento/Record[NOMECOMPONENTE='APPUNTAMENTOGESTIONEAUTONOMA']&quot;>&lt;xsl:variable name=&quot;var&quot; select=&quot;IDRICHIESTAOLO&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;count($DataAppuntamento/Record[IDRICHIESTAOLO=$var])>1&quot;/>&lt;xsl:otherwise>&lt;tns4:ListaOrdini_Type>&lt;tns4:IdRichiestaOlo>&lt;xsl:value-of select=&quot;IDRICHIESTAOLO&quot;/>&lt;/tns4:IdRichiestaOlo>&lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&lt;tns4:DataAppuntamento>&lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&lt;/tns4:DataAppuntamento>&lt;/xsl:if>&lt;/tns4:ListaOrdini_Type>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/tns4:ListaOrdini>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="ListaOrdini" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogListaOrdini-input"
                    name="LogListaOrdini"
                    tibex:xpdlId="62c31a11-829c-498a-85be-1830f42285ee"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ListaOrdiniToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToIterate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;ListaOrdini&quot;/>&lt;xsl:template name=&quot;LogListaOrdini-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;InvioNotificaInfoGpon&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;InvioNotificaInfoGpon&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('ListaOrdini: ',tib:render-xml($ListaOrdini))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
