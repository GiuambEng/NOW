                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="DataAppuntamento-input"
                    name="DataAppuntamento"
                    outputVariable="DataAppuntamento"
                    tibex:xpdlId="fea799cd-d75a-435a-a159-9ba950d82f0d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="DataAppuntamentoToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fea799cd-d75a-435a-a159-9ba950d82f0d+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT dett.BDS_ID, rich.STATORICHIESTAOLO, rich.OFFERTA, dett.NOMECOMPONENTE, rich.IDRICHIESTAOLO, attrd.NOMEATTRIBUTO, attrd.VALOREATTRIBUTO&#xa;FROM APPUSER.BDS_1_CASEDATA_RICHIESTA rich &#xa;JOIN APPUSER.BDS_1_CASEDATA_ORDINE ordine ON rich.IDRICHIESTAOLO = ordine.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE dett ON ordine.IDRICHIESTAOLO = dett.IDRICHIESTAOLO&#xa;JOIN APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN attrd ON dett.IDRICHIESTAOLO = attrd.IDRICHIESTAOLO&#xa;WHERE rich.OFFERTA='UBBSEMIGPON' AND rich.STATORICHIESTAOLO in ('INDELIVERY','SOSPESOAPPUNTAMENTO') AND rich.GESTIONEAUTONOMA='OS'AND (rich.EXGESTIONEAUTONOMA &lt;>'S' or rich.EXGESTIONEAUTONOMA is null)&#xa;AND dett.NOMECOMPONENTE in ('APPUNTAMENTOGESTIONEAUTONOMA','DTUAPPUNTAMENTO') AND attrd.NOMEATTRIBUTO='DATAAPPUNTAMENTO' AND dett.BDS_ID = attrd.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;ORDER BY dett.BDS_ID" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="BDS_ID"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogDataAppuntamento-input"
                    name="LogDataAppuntamento"
                    tibex:xpdlId="182441b1-0e3f-44b4-b580-f5083d2e67ab"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DataAppuntamentoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogDataAppuntamentoToAssign"/>
