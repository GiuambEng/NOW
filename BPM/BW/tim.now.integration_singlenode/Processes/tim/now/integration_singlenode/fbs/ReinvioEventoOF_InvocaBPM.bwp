                                <sca:property name="endpointURI" scaext:simpleValue="/Connections/HTTP/BPMAPI/URI"/>
                            </scact:bindingAdjunct>
                        </referenceBinding>
                    </bwbinding:BWBaseBinding>
                </tibex:binding>
            </tibex:ReferenceBinding>
        </bpws:partnerLink>
    </bpws:partnerLinks>
