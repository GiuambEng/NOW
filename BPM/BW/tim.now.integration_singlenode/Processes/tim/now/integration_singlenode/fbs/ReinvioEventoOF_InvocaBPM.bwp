                                    partElementName="processManagerType:replaceUserRequest"
                                    partName="replaceUserRequestDoc" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    messageDirection="OUTPUT"
                                    messageQName="pt:replaceUserResponse" wsdlLocation="platform:/resource/tim.now.integration_singlenode/Service%20Descriptors/BPM_API/processManagement.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    namespace="http://www.tibco.com/bx/2009/management/process"
                                    partElementName="processManagerType:replaceUserResponse"
                                    partName="replaceUserResponseDoc" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    action="illegalArgumentFault"
                                    messageDirection="FAULT"
                                    messageQName="pt:illegalArgumentFault" wsdlLocation="platform:/resource/tim.now.integration_singlenode/Service%20Descriptors/BPM_API/processManagement.wsdl">
                                    <messagePartConfigurations
                                    partElementName="processManagerType:illegalArgumentFault"
                                    partName="fault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    action="illegalStateFault"
                                    messageDirection="FAULT"
                                    messageQName="pt:illegalStateFault" wsdlLocation="platform:/resource/tim.now.integration_singlenode/Service%20Descriptors/BPM_API/processManagement.wsdl">
                                    <messagePartConfigurations
                                    partElementName="processManagerType:illegalStateFault"
                                    partName="fault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    action="operationFailedFault"
                                    messageDirection="FAULT"
                                    messageQName="pt:operationFailedFault" wsdlLocation="platform:/resource/tim.now.integration_singlenode/Service%20Descriptors/BPM_API/processManagement.wsdl">
                                    <messagePartConfigurations
                                    partElementName="processManagerType:operationFailedFault"
                                    partName="fault" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <context>
                                    <inputMapping/>
                                    <outputMapping direction="OUTPUT"/>
                                    <faultMappings direction="FAULT" faultName="illegalArgumentFault"/>
                                    <faultMappings direction="FAULT" faultName="illegalStateFault"/>
                                    <faultMappings direction="FAULT" faultName="operationFailedFault"/>
                                    </context>
                                </operationConfiguration>
                                <outboundConfiguration
                                    httpClient="tim.now.integration_singlenode.HttpResources.BPMapi_HttpClient" xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
