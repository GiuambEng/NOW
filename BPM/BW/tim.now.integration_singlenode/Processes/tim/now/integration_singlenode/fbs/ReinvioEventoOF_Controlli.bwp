                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Richiesta-input"
                                    name="Richiesta"
                                    outputVariable="Richiesta"
                                    tibex:xpdlId="1d7a4275-d3e2-4012-b403-be8676a2c0d0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
