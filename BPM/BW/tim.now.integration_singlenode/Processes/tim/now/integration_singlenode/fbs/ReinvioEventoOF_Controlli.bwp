                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1d7a4275-d3e2-4012-b403-be8676a2c0d0+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$currentElement/IDRICHIESTAOLO&quot;/>&lt;/IDRICHIESTAOLO>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT LAVORAZIONE, STATORICHIESTANOW, STATORICHIESTAOF, CODICEORDINEOLOTARGET,&#xa;  CODIFICAOLOAGCOM, CODICEORDINETITARGET, FLAGRIENTRIDEL82&#xa;  FROM APPUSER.BDS_1_CASEDATA_RICHIESTA&#xa;  WHERE IDRICHIESTAOLO = ?&#xa;    AND LAVORAZIONE IN ('ATTIVAZIONE', 'CESSAZIONE', 'ANNULLAMENTO', 'INTERRUZIONESOSPENSIONE',&#xa;  'RIMODULAZIONEDAD', 'MIGRAZIONE', 'RIMODULAZIONEDACDARECIPIENT')&#xa;    AND OFFERTA = 'FIBERSTREAM' AND FLGABILITAZGUIMANUALOF = 'SI'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="STATORICHIESTAOF"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="4"
                                    columnName="CODICEORDINEOLOTARGET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="5"
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="6"
                                    columnName="CODICEORDINETITARGET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="7"
                                    columnName="FLAGRIENTRIDEL82"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogRichiesta-input"
                                    name="LogRichiesta"
                                    tibex:xpdlId="eaffcafc-2da1-423c-9c54-2653150772e8"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="RichiestaToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogRichiestaToEmpty_RichOK">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Richiesta/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Richiesta/Record)>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogRichiestaToUpdateKO_RichKO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;LogRichiesta-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioEventoOF_Controlli&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ReinvioEventoOF_Controlli&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Per la richiesta ',$currentElement/IDRICHIESTAOLO, 'sono stati recuperati i seguenti dati: ',tib:render-xml($Richiesta))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="Esito"
                                    name="Esito"
                                    outputVariable="Esito"
                                    tibex:xpdlId="678a79c3-4d4a-4d71-9020-b8aab72899c0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToEsito"/>
                                    <bpws:target linkName="LogRichiestaTargetToEsito"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="EsitoToJDBCUpdate_KO">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Esito='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Esito='KO']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EsitoToJDBCUpdate_OK">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (($Richiesta/Record[1]/LAVORAZIONE='ATTIVAZIONE' and ($Richiesta/Record[1]/STATORICHIESTAOF='INVIORICHIESTAOFNONRIUSCITO' or $Richiesta/Record[1]/STATORICHIESTAOF='ACQUISITOKO')) &#xd;&#xa;or ($Richiesta/Record[1]/LAVORAZIONE='CESSAZIONE' and ($Richiesta/Record[1]/STATORICHIESTAOF='INVIORICHIESTAOFNONRIUSCITO' or $Richiesta/Record[1]/STATORICHIESTAOF='CESSATOKO')) &#xd;&#xa;or ($Richiesta/Record[1]/LAVORAZIONE='INTERRUZIONESOSPENSIONE' and $IdRichiestaTarget/ns11:IdRichiestaTarget_Type/ns11:StatoRichiestaOF='SOSPESOOF') &#xd;&#xa;or ($Richiesta/Record[1]/LAVORAZIONE='RIMODULAZIONEDAD' and $IdRichiestaTarget/ns11:IdRichiestaTarget_Type/ns11:StatoRichiestaOF=('SOSPESOOF','ACQUISITOOK','ACCETTATOOK')) &#xd;&#xa;or ($Richiesta/Record[1]/LAVORAZIONE='ANNULLAMENTO' and $IdRichiestaTarget/ns11:IdRichiestaTarget_Type/ns11:StatoRichiestaOF=('ACQUISITOOK','ACCETTATOOK','SOSPESOOF')) &#xd;&#xa;or ($Richiesta/Record[1]/LAVORAZIONE='MIGRAZIONE' and $Richiesta/Record[1]/FLAGRIENTRIDEL82='SI' and ($Richiesta/Record[1]/STATORICHIESTAOF='INVIORICHIESTAOFNONRIUSCITO' or $Richiesta/Record[1]/STATORICHIESTAOF='ACQUISITOKO')) &#xd;&#xa;or ($Richiesta/Record[1]/LAVORAZIONE='RIMODULAZIONEDACDARECIPIENT' and $IdRichiestaTarget/ns11:IdRichiestaTarget_Type/ns11:FlgRientriDel82='SI' and $IdRichiestaTarget/ns11:IdRichiestaTarget_Type/ns11:StatoRichiestaOF=('ACQUISITOOK','ACCETTATOOK','SOSPESOOF')) &#xd;&#xa;)&#xd;&#xa;then 'OK' else 'KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
