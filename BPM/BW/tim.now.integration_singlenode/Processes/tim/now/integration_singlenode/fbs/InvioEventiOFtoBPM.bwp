                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="  update EVENTI_OF_TO_BPM_SEMAFORO&#xa;  set  FLAG_INVIO='N', TIMESTAMP_UPD=SYSDATE&#xa;  WHERE ID_RICH_OLO=?" xsi:type="jdbcPalette:JDBCUpdateActivity">

