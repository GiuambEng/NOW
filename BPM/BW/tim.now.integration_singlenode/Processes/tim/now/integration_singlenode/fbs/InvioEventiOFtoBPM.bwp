                                <bpws:variable
                                    element="ns2:Iterate_Current_Element_Record"
                                    name="currentElement" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="GroupStartToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="LogInToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CheckSemaforoToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogSemaforoToJDBCQuery1_SemaforoOK"
                                    tibex:label="Semaforo OK" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="LogSemaforoToGenericLogger" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                    <bpws:link
                                    name="RecuperaEventoToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="LogEventoToInvoke" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="CreateProcessInstanceToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="UpdateEventoToJDBCUpdate" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="UpdateSemaforoToGenericLogger" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="LogSemaforoKOToLogOut" tibex:linkType="SUCCESS"/>
                                    <bpws:link name="LogOutToGroupEnd" tibex:linkType="SUCCESS"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="4312abec-268a-4289-83f7-3876abd4870b" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToGenericLogger"/>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($JDBCQuery/Record)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentElement"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:empty name="GroupEnd"
                                    tibex:group="groupEnd" tibex:xpdlId="6e598078-2fec-413d-93c6-d40c453f3196">
                                    <bpws:targets>
                                    <bpws:target linkName="LogOutToGroupEnd"/>
                                    </bpws:targets>
                                </bpws:empty>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogIn-input"
                                    name="LogIn"
                                    tibex:xpdlId="a87e19ff-0a1e-4bd9-9a5d-c46b1200df79"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogInToJDBCQuery1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;LogIn-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;InvioEventiOFtoBPM&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;InvioEventiOFtoBPM&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Inizio ciclo per idrichiesta: ',$currentElement/ID_RICH_OLO)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="CheckSemaforo-input"
                                    name="CheckSemaforo"
                                    outputVariable="CheckSemaforo"
                                    tibex:xpdlId="8c7890f3-b749-4051-9102-105148233130" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogInToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckSemaforoToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8c7890f3-b749-4051-9102-105148233130+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;CheckSemaforo-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;ID_RICH_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($currentElement/ID_RICH_OLO)&quot;>&lt;xsl:value-of select=&quot;$currentElement/ID_RICH_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_RICH_OLO>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="GenericJDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_INVIO, TIMESTAMP_UPD&#xa;  FROM EVENTI_OF_TO_BPM_SEMAFORO&#xa;  WHERE ID_RICH_OLO=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="FLAG_INVIO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>

                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="TIMESTAMP_UPD"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="LogSemaforo-input"
                                    name="LogSemaforo"
                                    tibex:xpdlId="fcde43ca-b9c0-4f17-91ba-c0ccc81664e7"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckSemaforoToGenericLogger"/>
