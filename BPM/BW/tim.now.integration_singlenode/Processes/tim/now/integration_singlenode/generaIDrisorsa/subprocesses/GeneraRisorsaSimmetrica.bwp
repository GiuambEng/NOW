                    name="JDBCUpdateTDArco"
                    outputVariable="JDBCUpdateTDArco"
                    tibex:xpdlId="76fabe68-e919-4934-8ab7-9d5fac0544b7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignIDRisorsaSimmetricoToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateTDArcoToJDBCQuery_CHECKSOGLIA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($JDBCQueryTDArco/Record) &lt; $ValoreSoglia" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($JDBCQueryTDArco/Record) < $ValoreSoglia]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="JDBCUpdateTDArcoToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+76fabe68-e919-4934-8ab7-9d5fac0544b7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryTDArco&quot;/>&lt;xsl:template name=&quot;JDBCUpdateTDArco-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;TD_CURRENT>&lt;xsl:value-of select=&quot;$JDBCQueryTDArco/Record[1]/TD_CURRENT + 1&quot;/>&lt;/TD_CURRENT>&lt;CODICE_ARCO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQueryTDArco/Record[1]/CODICE_ARCO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQueryTDArco/Record[1]/CODICE_ARCO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_ARCO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
