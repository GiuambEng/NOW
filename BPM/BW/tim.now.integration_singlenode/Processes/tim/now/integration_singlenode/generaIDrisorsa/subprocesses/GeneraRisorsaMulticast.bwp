                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateIDResource&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelSeqFEEDERSUCCESSIVO&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;IDRisorsa&quot;/>&lt;xsl:template name=&quot;IDRisorsa&quot; match=&quot;/&quot;>&lt;tns:IDRisorsaOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;$index=1&quot;>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;concat($Start/tns:CodiceOLO,$Start/tns:CodiceCLLI,tib:pad-front(string(xsd:long($SelSeqFEEDERSUCCESSIVO/Record[1]/NEXTVAL)), 4, &amp;quot;0&amp;quot;),'F')&quot;/>&lt;/tns:IDRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;$IDRisorsa/tns:IDRisorsa&quot;/>&lt;/tns:IDRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$IDRisorsa/tns:FeederSuccessivoOutput&quot;/>&lt;xsl:if test=&quot;$index!=1&quot;>&lt;tns:FeederSuccessivoOutput>&lt;xsl:if test=&quot;$Start/tns:FeederSuccessivoInput[xsd:int($index)-1]/tns:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$Start/tns:FeederSuccessivoInput[xsd:int($index)-1]/tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:FeederSuccessivoInput[xsd:int($index)-1]/tns:ClliFeederSuccessivo&quot;>&lt;tns:ClliFeederSuccessivo>&lt;xsl:value-of select=&quot;$Start/tns:FeederSuccessivoInput[xsd:int($index)-1]/tns:ClliFeederSuccessivo&quot;/>&lt;/tns:ClliFeederSuccessivo>&lt;/xsl:if>&lt;tns:IDRisorsaFeeder>&lt;xsl:value-of select=&quot;concat($Start/tns:CodiceOLO,$Start/tns:FeederSuccessivoInput[xsd:int($index)-1]/tns:ClliFeederSuccessivo,tib:pad-front(string(xsd:long($SelSeqFEEDERSUCCESSIVO/Record[1]/NEXTVAL)), 4, &amp;quot;0&amp;quot;),'F')&quot;/>&lt;/tns:IDRisorsaFeeder>&lt;/tns:FeederSuccessivoOutput>&lt;/xsl:if>&lt;/tns:IDRisorsaOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
