                                    sqlStatement="UPDATE ANAGRAFICA_VLAN_VP_CODE SET NUMERO_PROGRESSIVO=?, TIMESTAMP_AGG=SYSDATE WHERE CODICE_ADR=? AND CODICE_OAO=?" xsi:type="jdbcPalette:JDBCUpdateActivity">
