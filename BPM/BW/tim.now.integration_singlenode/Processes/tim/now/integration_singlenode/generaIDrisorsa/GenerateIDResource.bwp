                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateIDResource&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenerateIDResourceIn&quot;/>&lt;xsl:param name=&quot;CODICE_ADR&quot;/>&lt;xsl:param name=&quot;AnagVlanVp&quot;/>&lt;xsl:param name=&quot;PAR_CFGZ&quot;/>&lt;xsl:template name=&quot;IDRisorsa&quot; match=&quot;/&quot;>&lt;tns:IDRisorsaOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;count($AnagVlanVp/Record) > 0&quot;>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;concat($GenerateIDResourceIn/tns:CodiceOLO,tib:pad-front($CODICE_ADR/Record[1]/CODICE_ADR, 4, &amp;quot;0&amp;quot;),tib:pad-front(xsd:string(xsd:int($AnagVlanVp/Record[1]/NUMERO_PROGRESSIVO) +1), 9, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:IDRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;concat($GenerateIDResourceIn/tns:CodiceOLO,tib:pad-front($CODICE_ADR/Record[1]/CODICE_ADR, 4, &amp;quot;0&amp;quot;),tib:pad-front($PAR_CFGZ/Record[1]/NUMERO_PROGRESSIVO, 9, &amp;quot;0&amp;quot;))&quot;/>&lt;/tns:IDRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:IDRisorsaOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
