                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ConcatenaCodNum" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ConcatenaCodNum"
                    name="ConteggioDispC"
                    outputVariable="ConcatenaCodNum"
                    tibex:xpdlId="b2c017c3-d90d-48fa-ae40-6e4a0f6ad8d1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToConteggioDispC"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToAggArcoDatiRecuperabili1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat($GenerateIDResourceIn/ns4:PrefissoDistrettuale,($SelectTipoRecuperoC/Record[1]/NUMRZNE_FITTIZIA))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ConcatenaCodNum" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DistrettoReale"
                    name="CalcDistrettoReale"
                    outputVariable="DistrettoReale"
                    tibex:xpdlId="da962a2f-9904-4bfc-9f77-a20a1432b6e4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToCalcDistrettoReale"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLOG_Input">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CalcDistrettoRealeToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$GenerateIDResourceIn/ns4:Lavorazione = 'ATTIVAZIONE' and $GenerateIDResourceIn/ns4:SottoLavorazione = 'CAMBIOTECNOLOGIA' and &#xd;&#xa;$GenerateIDResourceIn/ns4:Servizio = ('VULAFTTCAB', 'BITSTREAMNGAFTTCAB', 'EASYIPNGAFTTCAB') and exists($GenerateIDResourceIn/ns4:IdRisorsaDati) and string-length($GenerateIDResourceIn/ns4:IdRisorsaDati) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$GenerateIDResourceIn/ns4:Lavorazione = 'ATTIVAZIONE' and $GenerateIDResourceIn/ns4:SottoLavorazione = 'CAMBIOTECNOLOGIA' and 
$GenerateIDResourceIn/ns4:Servizio = ('VULAFTTCAB', 'BITSTREAMNGAFTTCAB', 'EASYIPNGAFTTCAB') and exists($GenerateIDResourceIn/ns4:IdRisorsaDati) and string-length($GenerateIDResourceIn/ns4:IdRisorsaDati) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="concat('0', string(xsd:int($GenerateIDResourceIn/ns4:PrefissoDistrettuale)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DistrettoReale" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Naked_Condiviso" tibex:xpdlId="37aa2556-3207-4b79-ac0c-27c5f7bd0744">
                <bpws:targets>
                    <bpws:target linkName="LOG_InputToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToSelectArcoDatiDisple_RamoEliminato">
                        <tibex:DesignExpression>
                            <tibex:expression expression="1=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[1=0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Naked_CondivisoToAssignIDResourceCondiviso">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($GenerateIDResourceIn/ns4:NumerazioneCondivisa) > 0 or ($GenerateIDResourceIn/ns4:Lavorazione = 'ATTIVAZIONE' and $GenerateIDResourceIn/ns4:SottoLavorazione = 'CAMBIOTECNOLOGIA' and $GenerateIDResourceIn/ns4:Servizio = ('VULAFTTCAB', 'BITSTREAMNGAFTTCAB', 'EASYIPNGAFTTCAB') and exists($GenerateIDResourceIn/ns4:IdRisorsaDati) and string-length($GenerateIDResourceIn/ns4:IdRisorsaDati) > 0 and $DonatingSimmetrico='N')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($GenerateIDResourceIn/ns4:NumerazioneCondivisa) > 0 or ($GenerateIDResourceIn/ns4:Lavorazione = 'ATTIVAZIONE' and $GenerateIDResourceIn/ns4:SottoLavorazione = 'CAMBIOTECNOLOGIA' and $GenerateIDResourceIn/ns4:Servizio = ('VULAFTTCAB', 'BITSTREAMNGAFTTCAB', 'EASYIPNGAFTTCAB') and exists($GenerateIDResourceIn/ns4:IdRisorsaDati) and string-length($GenerateIDResourceIn/ns4:IdRisorsaDati) > 0 and $DonatingSimmetrico='N')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Naked_Naked">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="IDRisorsa"
                    name="AssignIDResourceCondiviso"
                    outputVariable="IDRisorsa"
                    tibex:xpdlId="297ed5bc-cc9a-48c6-ac05-927ebaa8e357" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToAssignIDResourceCondiviso"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignIDResourceCondivisoToReplytoJMSMessage1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateIDResource&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GenerateIDResourceIn&quot;/>&lt;xsl:param name=&quot;DistrettoReale&quot;/>&lt;xsl:param name=&quot;OffertaDonating&quot;/>&lt;xsl:template name=&quot;IDRisorsa&quot; match=&quot;/&quot;>&lt;tns:IDRisorsaOutput>&lt;xsl:choose>&lt;xsl:when test=&quot;$GenerateIDResourceIn/tns:Lavorazione='ATTIVAZIONE' and $GenerateIDResourceIn/tns:SottoLavorazione='CAMBIOTECNOLOGIA'&quot;>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;concat(substring-before($GenerateIDResourceIn/tns:IdRisorsaDati, 'W'), 'W', tib:pad-front(string((xsd:int(substring-after($GenerateIDResourceIn/tns:IdRisorsaDati, 'W'))+2)), 2,'0'))&quot;/>&lt;/tns:IDRisorsa>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;concat(tib:pad(concat($DistrettoReale,$GenerateIDResourceIn/tns:NumerazioneCondivisa),13),'W00')&quot;/>&lt;/tns:IDRisorsa>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OffertaDonating/Record[1]/NUMEROFITTIZIO&quot;>&lt;tns:PrimoNumeroDisponibile>&lt;xsl:value-of select=&quot;$OffertaDonating/Record[1]/NUMEROFITTIZIO&quot;/>&lt;/tns:PrimoNumeroDisponibile>&lt;/xsl:if>&lt;/tns:IDRisorsaOutput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="IDRisorsa" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LOG_RecuperoC_OK-input"
                    name="LOG_RecuperoC_OK"
                    tibex:xpdlId="035a22cd-2188-4d79-8e2b-25db9161dabd"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectTipoRecuperoCToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToConteggioDispC"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateIDResource&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;GenerateIDResourceIn&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectTipoRecuperoC&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_RecuperoC_OK-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenerateIDResource&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IDRisorsaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenerateIDResource&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenerateIDResourceIn/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Recupero Numerazione con Tipologia Recupero = 'C'  OK&amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($SelectTipoRecuperoC/Record[1], true(), true())&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LOG_RecuperoC_KO-input"
                    name="LOG_RecuperoC_KO"
                    tibex:xpdlId="f3361af6-b84e-4cb6-adab-6c063bc6a9b9"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectTipoRecuperoCToCallProcess1"/>
                        <bpws:target linkName="JDBCCallProcedureToLOG_RecuperoC_KO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_RecuperoC_KOToReplytoJMSMessage1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateIDResource&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;GenerateIDResourceIn&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCCallProcedureGET_IDRISORSA&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_RecuperoC_KO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.integration_singlenode.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenerateIDResource&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;IDRisorsaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GenerateIDResource&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$GenerateIDResourceIn/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Output procedura GET_IDRISORSA:&amp;quot;, tib:render-xml($JDBCCallProcedureGET_IDRISORSA/outputSet/RESULTSET/APPUSER.TOUTS_GET_IDRISORSA[1], true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Error&amp;quot;&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="DistrettoReale"
                    name="Assign" outputVariable="DistrettoReale"
                    tibex:xpdlId="c85f293e-3f8e-4a20-9868-0e0220283459" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Naked_CondivisoToAssignIDResourceCondiviso"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToAssignIDResourceCondiviso"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(string-length($GenerateIDResourceIn/ns4:PrefissoDistrettuale)=3) then $GenerateIDResourceIn/ns4:PrefissoDistrettuale &#xd;&#xa;else &#xd;&#xa;&#xd;&#xa;if(string-length($GenerateIDResourceIn/ns4:PrefissoDistrettuale) =2) then concat('0' ,$GenerateIDResourceIn/ns4:PrefissoDistrettuale) &#xd;&#xa;else substring($GenerateIDResourceIn/ns4:PrefissoDistrettuale, 2)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DistrettoReale" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GenerateIDResourceIn-input"
                    name="GenerateIDResourceIn"
                    outputVariable="GenerateIDResourceIn"
                    tibex:xpdlId="5407c41f-5a86-4fe8-935e-c061613b7fe9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JMSReceiveMessageNEWSToGenerateIDResourceIn"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCalcDistrettoReale">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MapperToLOG_InputRegolatorio">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($GenerateIDResourceIn/ns4:StrutturaRichiesta) = &quot;REGOLATORIO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($GenerateIDResourceIn/ns4:StrutturaRichiesta) = "REGOLATORIO"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GenerateIDResourceInToLog_StrutturaFWA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($GenerateIDResourceIn/ns4:StrutturaRichiesta) = &quot;FWA&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($GenerateIDResourceIn/ns4:StrutturaRichiesta) = "FWA"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GenerateIDResourceInToGenRisirsaMulticast_MULTICAST">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$GenerateIDResourceIn/ns4:Servizio=('VLANNGAMULTICAST','FEEDER','SEDEOLT','CANALE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$GenerateIDResourceIn/ns4:Servizio=('VLANNGAMULTICAST','FEEDER','SEDEOLT','CANALE')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GenerateIDResourceInToLog_OpenFiber">
