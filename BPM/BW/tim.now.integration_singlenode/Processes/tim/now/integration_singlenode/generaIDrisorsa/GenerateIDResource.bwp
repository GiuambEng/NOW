                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_ADR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_OAO"/>
