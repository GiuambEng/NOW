                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdProgVpToAssignIdRisorsaVP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b784feb5-5bbb-4299-8165-f468a160be35+input&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenerateIDResource&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GenerateIDResourceIn&quot;/>&#xa;    &lt;xsl:param name=&quot;CODICE_ADR&quot;/>&#xa;    &lt;xsl:param name=&quot;AnagVlanVp&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdProgVp-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;NUMERO_PROGRESSIVO>&#xa;                &lt;xsl:value-of select=&quot;xsd:string(xsd:int($AnagVlanVp/Record[1]/NUMERO_PROGRESSIVO) +1)&quot;/>&#xa;            &lt;/NUMERO_PROGRESSIVO>&#xa;            &lt;CODICE_ADR>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CODICE_ADR/Record[1]/CODICE_ADR)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CODICE_ADR/Record[1]/CODICE_ADR&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_ADR>&#xa;            &lt;CODICE_OAO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GenerateIDResourceIn/tns:CodiceOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$GenerateIDResourceIn/tns:CodiceOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_OAO>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
