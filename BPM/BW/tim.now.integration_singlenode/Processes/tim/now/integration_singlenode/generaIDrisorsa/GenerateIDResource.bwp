                    <bpws:sources>
                        <bpws:source linkName="SelectArcoDatiDispleToLOG_ControlloArcoDatiDisple">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SelectArcoDatiDisple/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
