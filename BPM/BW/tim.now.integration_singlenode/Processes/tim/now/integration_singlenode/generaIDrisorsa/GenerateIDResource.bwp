                                    sqlStatement="SELECT VALORE_STRINGA AS NUMERO_PROGRESSIVO&#xa;FROM PARAMETRI_CFGZ_NOW&#xa;WHERE CHIAVE='PROGRESSIVO_VP'" xsi:type="jdbcPalette:JDBCQueryActivity">
