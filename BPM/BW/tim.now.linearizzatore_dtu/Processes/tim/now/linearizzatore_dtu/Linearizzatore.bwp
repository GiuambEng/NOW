                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jms&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodaInInput&quot;/>&lt;xsl:param name=&quot;JMSTimeOut&quot;/>&lt;xsl:template name=&quot;GetJMSQueueMessage-input&quot; match=&quot;/&quot;>&lt;tns:GetJMSActivityInput>&lt;destinationQueue>&lt;xsl:value-of select=&quot;$CodaInInput&quot;/>&lt;/destinationQueue>&lt;timeout>&lt;xsl:value-of select=&quot;$JMSTimeOut&quot;/>&lt;/timeout>&lt;/tns:GetJMSActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
