        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable element="ns24:CW_BUS_MESSAGE"
            name="LogStart-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns32:ActivityInputType"
            name="GetVLanOloInfo-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns33:jdbcGeneralActivityOutput"
            name="GetVLanOloInfo" sca-bpel:internal="true"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns24:CW_BUS_MESSAGE"
            name="LogAbstractRequest-input" sca-bpel:internal="true"/>
        <bpws:variable name="SCodeOrCodVlan" type="xsd:string"/>
        <bpws:variable element="ns24:CW_BUS_MESSAGE"
            name="LogGetVLanOloInfo-input" sca-bpel:internal="true"/>
        <bpws:variable name="TimeoutJDBC" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/TimerJDBC/TimeoutJDBC" type="xsd:int"/>
        <bpws:variable element="ns0:VerificaEsistenzaVLANResponse" name="VerEsistResponse"/>
        <bpws:variable element="ns24:CW_BUS_MESSAGE"
            name="LogAssignResponse-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns36:ActivityInputType"
            name="GetVlanOloInfo2-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns33:jdbcGeneralActivityOutput"
            name="GetVlanOloInfo2" sca-bpel:internal="true"/>
        <bpws:variable element="ns24:CW_BUS_MESSAGE"
            name="LogGetVlanOloInfo2-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogStartToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="GetVLanOloInfoToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignAbstactRequestToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignCodesToGetVLanOloInfo" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogGetVLanOloInfoToAssignResponse" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="AssignResponseToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogGetVLanOloInfoToSQLDirect" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="GetVlanOloInfo2ToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToAssignResponse" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="926541c9-d8bb-4a30-a942-d31636db1939"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="fa22a29b-8ff4-4e4c-bb9a-8fe83184ff01" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerEsistResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;AbstactUservlan&quot;/>&#xa;    &lt;xsl:param name=&quot;GetVlanOloInfo2&quot;/>&#xa;    &lt;xsl:param name=&quot;GetVLanOloInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaEsistenzaVLANResponse>&#xa;            &lt;xsl:copy-of select=&quot;$VerEsistResponse/tns:VLAN&quot;/>&#xa;            &lt;tns:Codice>&#xa;                &lt;xsl:value-of select=&quot;$VerEsistResponse/tns:Codice&quot;/>&#xa;            &lt;/tns:Codice>&#xa;            &lt;tns:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;$VerEsistResponse/tns:Descrizione&quot;/>&#xa;            &lt;/tns:Descrizione>&#xa;            &lt;xsl:copy-of select=&quot;$VerEsistResponse/tns:UservlanVC&quot;/>&#xa;            &lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOLOAGCOM=('WIN','INF')&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($GetVLanOloInfo/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($GetVLanOloInfo/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetVLanOloInfo/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetVLanOloInfo/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                            &lt;tns:CodificaAgcom>&#xa;                                &lt;xsl:value-of select=&quot;$GetVLanOloInfo/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                            &lt;/tns:CodificaAgcom>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($GetVlanOloInfo2/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&#xa;                        &lt;xsl:if test=&quot;not((string($GetVlanOloInfo2/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetVlanOloInfo2/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetVlanOloInfo2/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value)&quot;>&#xa;                            &lt;tns:CodificaAgcom>&#xa;                                &lt;xsl:value-of select=&quot;$GetVlanOloInfo2/unknownResultset[1]/row[1]/column[name='CODFC_OLO_AGCOM']/value&quot;/>&#xa;                            &lt;/tns:CodificaAgcom>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:VerificaEsistenzaVLANResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogStart-input"
                    name="LogStart"
                    tibex:xpdlId="4d8c0470-257f-4c93-ba64-ef9e01ace23e"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogStartToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStart-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLANStep2'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Start process VerificaEsistenzaVLANStep2 - input&amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GetVLanOloInfo-input"
                    name="GetVLanOloInfo"
                    outputVariable="GetVLanOloInfo"
                    tibex:xpdlId="4d06e5dc-b458-4832-9f1a-a98e88fdb480" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignCodesToGetVLanOloInfo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetVLanOloInfoToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4d06e5dc-b458-4832-9f1a-a98e88fdb480+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SCodeOrCodVlan&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;GetVLanOloInfo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;statement>&#xa;                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT COD_VLAN,CODFC_OLO_AGCOM &amp;#xD;&amp;#xA;FROM OLO_VLAN WHERE &amp;#xD;&amp;#xA;COD_VLAN IN ('&amp;quot;,$SCodeOrCodVlan,&amp;quot;') AND CODFC_OLO_AGCOM = '&amp;quot;,$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOLOAGCOM,&amp;quot;'&amp;quot;)&quot;/>&#xa;            &lt;/statement>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="AbstactUservlan"
                    name="AssignAbstactRequest"
                    outputVariable="AbstactUservlan"
                    tibex:xpdlId="b6272de0-458c-43eb-9c50-9861f2211f7f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogStartToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignAbstactRequestToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;AbstactUservlan&quot; match=&quot;/&quot;>&lt;tns:Step1Request>&lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOrdineOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;tns:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOLOAGCOM&quot;/>&lt;/tns:CodiceOLOAGCOM>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:Offerta&quot;/>&lt;/tns:Offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:VerificaEsistenzaVLANRequest/tns:NGA-VULA)&quot;>&lt;xsl:for-each select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:NGA-VULA/tns:UserVlan&quot;>&lt;tns:AbstractUservVlan>&lt;tns:IdDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IdDettaglioOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodeVlanSingleTag&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:SVlanCode&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodiciVLAN)&quot;>&lt;xsl:if test=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;>&lt;tns:CVLAN_ID>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;/>&lt;/tns:CVLAN_ID>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:AbstractUservVlan>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:GBE/tns:VC&quot;>&lt;tns:AbstractUservVlan>&lt;tns:IdDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IdDettaglioOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodeVlanSingleTag&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:SVlanCode&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodiciVLAN)&quot;>&lt;xsl:if test=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;>&lt;tns:CVLAN_ID>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;/>&lt;/tns:CVLAN_ID>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:AbstractUservVlan>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Step1Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="AbstactUservlan" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SCodeOrCodVlan"
                    name="AssignCodes" outputVariable="SCodeOrCodVlan"
                    tibex:xpdlId="a569edfb-ccd0-430e-a80e-46f9f42ab56a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignCodesToGetVLanOloInfo"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="tib:concat-sequence-format($AbstactUservlan/ns0:AbstractUservVlan/ns0:CodVlanSingleTagOrSvulanCode,&quot;','&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="SCodeOrCodVlan" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogAbstractRequest-input"
                    name="LogAbstractRequest"
                    tibex:xpdlId="845d43d1-a823-447d-8bbc-a427b346e1ba"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignAbstactRequestToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;AbstactUservlan&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAbstractRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLANStep2'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Assign AbstractRequest result &amp;quot;, tib:render-xml($AbstactUservlan, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogGetVLanOloInfo-input"
                    name="LogGetVLanOloInfo"
                    tibex:xpdlId="66398d65-f0e8-41f6-8c87-0c5923bbbf5c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetVLanOloInfoToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogGetVLanOloInfoToAssignResponse">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogGetVLanOloInfoToSQLDirect">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetVLanOloInfo/unknownResultset/row)=0 and $Start/ns0:VerificaEsistenzaVLANRequest/ns0:CodiceOLOAGCOM=('WIN','INF')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($GetVLanOloInfo/unknownResultset/row)=0 and $Start/ns0:VerificaEsistenzaVLANRequest/ns0:CodiceOLOAGCOM=('WIN','INF')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;GetVLanOloInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;LogGetVLanOloInfo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLANStep2'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;GetVlanOloInfo result: &amp;quot;, tib:render-xml($GetVLanOloInfo, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerEsistResponse"
                    name="AssignResponse"
                    outputVariable="VerEsistResponse"
                    tibex:xpdlId="d9a7d264-1764-4c1b-9622-8a2b697ab4cc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogGetVLanOloInfoToAssignResponse"/>
                        <bpws:target linkName="GenericLoggerToAssignResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignResponseToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AbstactUservlan&quot;/>&lt;xsl:param name=&quot;GetVLanOloInfo&quot;/>&lt;xsl:param name=&quot;GetVlanOloInfo2&quot;/>&lt;xsl:template name=&quot;VerEsistResponse&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:otherwise>&lt;tns:VerificaEsistenzaVLANResponse>&lt;xsl:for-each select=&quot;$Start/tns:VerificaEsistenzaVLANResponse/tns:VLAN&quot;>&lt;tns:VLAN>&lt;xsl:if test=&quot;tns:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TIPO_BANDA&quot;>&lt;tns:TIPO_BANDA>&lt;xsl:value-of select=&quot;tns:TIPO_BANDA&quot;/>&lt;/tns:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TIPO_COS&quot;>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;tns:TIPO_COS&quot;/>&lt;/tns:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:FLAG_ENCAPSULATION&quot;>&lt;tns:FLAG_ENCAPSULATION>&lt;xsl:value-of select=&quot;tns:FLAG_ENCAPSULATION&quot;/>&lt;/tns:FLAG_ENCAPSULATION>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;tns:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TIPOLOGIA&quot;>&lt;tns:TIPOLOGIA>&lt;xsl:value-of select=&quot;tns:TIPOLOGIA&quot;/>&lt;/tns:TIPOLOGIA>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CVLAN_ID_DUPLICATO&quot;>&lt;tns:CVLAN_ID_DUPLICATO>&lt;xsl:value-of select=&quot;tns:CVLAN_ID_DUPLICATO&quot;/>&lt;/tns:CVLAN_ID_DUPLICATO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CODICE_KIT&quot;>&lt;tns:CODICE_KIT>&lt;xsl:value-of select=&quot;tns:CODICE_KIT&quot;/>&lt;/tns:CODICE_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DSLAM_TYPE&quot;>&lt;tns:DSLAM_TYPE>&lt;xsl:value-of select=&quot;tns:DSLAM_TYPE&quot;/>&lt;/tns:DSLAM_TYPE>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BMD&quot;>&lt;tns:BMD>&lt;xsl:value-of select=&quot;tns:BMD&quot;/>&lt;/tns:BMD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TIPO_TRASPORTO&quot;>&lt;tns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;tns:TIPO_TRASPORTO&quot;/>&lt;/tns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CodiceOperatoreRete&quot;>&lt;tns:CodiceOperatoreRete>&lt;xsl:value-of select=&quot;tns:CodiceOperatoreRete&quot;/>&lt;/tns:CodiceOperatoreRete>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BMC_LIGHT&quot;>&lt;tns:BMC_LIGHT>&lt;xsl:value-of select=&quot;tns:BMC_LIGHT&quot;/>&lt;/tns:BMC_LIGHT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:INTERMEDIATE_AGENT&quot;>&lt;tns:INTERMEDIATE_AGENT>&lt;xsl:value-of select=&quot;tns:INTERMEDIATE_AGENT&quot;/>&lt;/tns:INTERMEDIATE_AGENT>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TIPOLOGIA_CLUSTER_VLAN&quot;>&lt;tns:TIPOLOGIA_CLUSTER_VLAN>&lt;xsl:value-of select=&quot;tns:TIPOLOGIA_CLUSTER_VLAN&quot;/>&lt;/tns:TIPOLOGIA_CLUSTER_VLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:TIPOLOGIA_CLUSTER_VLAN_OLD&quot;>&lt;tns:TIPOLOGIA_CLUSTER_VLAN_OLD>&lt;xsl:value-of select=&quot;tns:TIPOLOGIA_CLUSTER_VLAN_OLD&quot;/>&lt;/tns:TIPOLOGIA_CLUSTER_VLAN_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:FLAG_FTTH_ONLY&quot;>&lt;tns:FLAG_FTTH_ONLY>&lt;xsl:value-of select=&quot;tns:FLAG_FTTH_ONLY&quot;/>&lt;/tns:FLAG_FTTH_ONLY>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:CARATTERISTICAVLAN&quot;>&lt;tns:CARATTERISTICAVLAN>&lt;xsl:value-of select=&quot;tns:CARATTERISTICAVLAN&quot;/>&lt;/tns:CARATTERISTICAVLAN>&lt;/xsl:if>&lt;/tns:VLAN>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOLOAGCOM=('WIN','INF')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($GetVLanOloInfo/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode)) or count($GetVlanOloInfo2/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:VerificaEsistenzaVLANResponse/tns:VLAN[string-length(./tns:CODICE_KIT)>0])&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GetVLanOloInfo/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:VerificaEsistenzaVLANResponse/tns:VLAN[string-length(./tns:CODICE_KIT)>0])&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOLOAGCOM=('WIN','INF')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($GetVLanOloInfo/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode)) or count($GetVlanOloInfo2/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:VerificaEsistenzaVLANResponse/tns:VLAN[string-length(./tns:CODICE_KIT)>0])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$AbstactUservlan/tns:AbstractUservVlan[1]/tns:IsSingleTag=true()&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Esiste almeno un CODICE_KIT valorizzato e gli UservVlan sono SingleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Esiste almeno un CODICE_KIT valorizzato e gli UserVlan sono DoubleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK - tutti i CODICI KIT sono null&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$AbstactUservlan/tns:AbstractUservVlan[1]/tns:IsSingleTag=true()&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Non tutti gli UserVlan in input sono stati trovati sulla tabella VLAN OLO e gli UserVlan sono SingleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Non tutti gli UserVlan in input sono stati trovati sulla tabella VLAN OLO e gli UserVlan sono DoubleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GetVLanOloInfo/unknownResultset/row)=count(distinct-values($AbstactUservlan/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:VerificaEsistenzaVLANResponse/tns:VLAN[string-length(./tns:CODICE_KIT)>0])&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$AbstactUservlan/tns:AbstractUservVlan[1]/tns:IsSingleTag=true()&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Esiste almeno un CODICE_KIT valorizzato e gli UservVlan sono SingleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Esiste almeno un CODICE_KIT valorizzato e gli UserVlan sono DoubleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK - tutti i CODICI KIT sono null&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$AbstactUservlan/tns:AbstractUservVlan[1]/tns:IsSingleTag=true()&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Non tutti gli UserVlan in input sono stati trovati sulla tabella VLAN OLO e gli UserVlan sono SingleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Non tutti gli UserVlan in input sono stati trovati sulla tabella VLAN OLO e gli UserVlan sono DoubleTag&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaEsistenzaVLANResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VerEsistResponse" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogAssignResponse-input"
                    name="LogAssignResponse"
                    tibex:xpdlId="f454f58f-052c-4ab6-bd16-919502799a50"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignResponseToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;VerEsistResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAssignResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLANStep2'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;End process VerificaEsistenzaVLANStep2 - AssignResponse result: &amp;quot;, tib:render-xml($VerEsistResponse, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GetVlanOloInfo2-input"
                    name="GetVlanOloInfo2"
                    outputVariable="GetVlanOloInfo2"
                    tibex:xpdlId="ddd3c3d8-2551-41a7-90ef-79fc50883574" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogGetVLanOloInfoToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetVlanOloInfo2ToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ddd3c3d8-2551-41a7-90ef-79fc50883574+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SCodeOrCodVlan&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;GetVlanOloInfo2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:CodiceOLOAGCOM='INF'&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT COD_VLAN,CODFC_OLO_AGCOM &amp;#xD;&amp;#xA;FROM OLO_VLAN WHERE &amp;#xD;&amp;#xA;COD_VLAN IN ('&amp;quot;,$SCodeOrCodVlan,&amp;quot;') AND CODFC_OLO_AGCOM = 'WIN'&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT COD_VLAN,CODFC_OLO_AGCOM &amp;#xD;&amp;#xA;FROM OLO_VLAN WHERE &amp;#xD;&amp;#xA;COD_VLAN IN ('&amp;quot;,$SCodeOrCodVlan,&amp;quot;') AND CODFC_OLO_AGCOM = 'INF'&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogGetVlanOloInfo2-input"
                    name="LogGetVlanOloInfo2"
                    tibex:xpdlId="581d4bda-7b6d-439f-93cd-49dcbccbe09a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetVlanOloInfo2ToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToAssignResponse"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;GetVlanOloInfo2&quot;/>&#xa;    &lt;xsl:template name=&quot;LogGetVlanOloInfo2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLANStep2'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:VerificaEsistenzaVLANRequest/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;GetVlanOloInfo2 result: &amp;quot;, tib:render-xml($GetVlanOloInfo2, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
