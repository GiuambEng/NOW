                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperaCausaleEsitoMultiplo-input&quot; match=&quot;/&quot;>&lt;em:EsitiMultipliRequest>&lt;em:IdRichiesta>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/em:IdRichiesta>&lt;em:CodiceControllo>&lt;xsl:value-of select=&quot;'CTRL_PROF_FWA_OBB_PROG'&quot;/>&lt;/em:CodiceControllo>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;$Response/tns:Descrizione&quot;/>&lt;/em:EsitoControllo>&lt;em:Offerta>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/em:Offerta>&lt;em:Lavorazione>&lt;xsl:value-of select=&quot;$Start/tns:Lavorazione&quot;/>&lt;/em:Lavorazione>&lt;em:IsPacchetto>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/em:IsPacchetto>&lt;/em:EsitiMultipliRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
