                    <bpws:targets>
                        <bpws:target linkName="LogProgettoToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ResponseToEnd_true">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Response/tns:Codice=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Response/tns:Codice=true()]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ResponseToRecuperaCausaleEsitoMultiplo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Contratto&quot;/>&lt;xsl:param name=&quot;Profilo&quot;/>&lt;xsl:param name=&quot;Progetto&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:VerificaCongruenzaProfiloTipologiaContrattoFWA_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Contratto/Record)=0 or count($Profilo/Record)=0&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Progetto/Record)>0 and (not(exists($Start/tns:CodiceProgetto)) or string-length($Start/tns:CodiceProgetto)=0)&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Contratto/Record)=0 or count($Profilo/Record)=0&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Progetto/Record)>0 and (not(exists($Start/tns:CodiceProgetto)) or string-length($Start/tns:CodiceProgetto)=0)&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCongruenzaProfiloTipologiaContrattoFWA_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
