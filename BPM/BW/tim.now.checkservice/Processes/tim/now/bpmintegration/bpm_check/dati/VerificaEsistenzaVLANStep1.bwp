                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c7b7df2b-9644-4005-b6ca-b376068c0d84+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;TIPOLG>&lt;xsl:value-of select=&quot;'GBE'&quot;/>&lt;/TIPOLG>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns1:GBE/tns1:VC[number($index)]/tns1:CodeVlanSingleTag)>0&quot;>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GBE/tns1:VC[number($index)]/tns1:CodeVlanSingleTag)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GBE/tns1:VC[number($index)]/tns1:CodeVlanSingleTag&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
