o>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:IdMadrCrmws=$Query/Record[1]/ID_MACROAREA_CRMWS&quot;>&#xa;                            &lt;tns:Trasporto>&#xa;                                &lt;xsl:value-of select=&quot;'L2'&quot;/>&#xa;                            &lt;/tns:Trasporto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Trasporto>&#xa;                                &lt;xsl:value-of select=&quot;'LD'&quot;/>&#xa;                            &lt;/tns:Trasporto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:Calcolo_Trasporto_Vlan_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
