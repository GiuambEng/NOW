                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="tim.now.shared_library-TimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP FROM OSCURAMENTO_AGESP &#xa;WHERE COD_AGESP IN ('R1I-25-0151')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COD_AGESP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="b90d0844-9566-47ec-b44a-69a02583529c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToLogOscuramento"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscuramentoToEmpty_Oscurato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='Y' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='Y' )]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&lt;tns3:CW_BUS_MESSAGE>&lt;tns3:GenericLogger>&lt;tns3:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns3:Application>&lt;tns3:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificarolloutMigrazioneFTTHDel82&amp;quot;&quot;/>&lt;/tns3:Process>&lt;tns3:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilità&amp;quot;&quot;/>&lt;/tns3:Service>&lt;tns3:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificarolloutMigrazioneFTTHDel82&amp;quot;&quot;/>&lt;/tns3:Operation>&lt;tns3:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns3:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Record recuperato per oscuramento&amp;quot;, tib:render-xml($Oscuramento, true(), true()))&quot;/>&lt;/tns3:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:Message>&lt;xsl:value-of select=&quot;'Record non recuperato per oscuramento'&quot;/>&lt;/tns3:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns3:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns3:LoggerName>&lt;tns3:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns3:LogLevel>&lt;tns3:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns3:LogJMS>&lt;/tns3:GenericLogger>&lt;/tns3:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="559c520b-6b5a-401f-a347-4a97ee9f6057">
                <bpws:targets>
                    <bpws:target linkName="LogOscuramentoToEmpty_Oscurato"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToJDBCQueryCodIStat">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($Start/ns0:codiceIstatComune)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:codiceIstatComune)>0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
