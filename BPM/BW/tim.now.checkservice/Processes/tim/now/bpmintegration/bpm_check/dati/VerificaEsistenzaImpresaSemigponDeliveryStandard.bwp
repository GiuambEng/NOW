                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GestAutPA&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&lt;tns:VerificaEsistenzaImpresaSemigponDeliveryStandard_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaEsistenzaImpresaSemigponDeliveryStandard_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GestAutPA/Record)>0&quot;>&lt;tns:VerificaEsistenzaImpresaSemigponDeliveryStandard_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaEsistenzaImpresaSemigponDeliveryStandard_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaEsistenzaImpresaSemigponDeliveryStandard_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaEsistenzaImpresaSemigponDeliveryStandard_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
