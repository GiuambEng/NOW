;quot;]/value = &amp;quot;STANDARD&amp;quot;) and ($SelectVP2/unknownResultset[1]/row[1]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;STANDARD&amp;quot; or $SelectVP2/unknownResultset[1]/row[2]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;STANDARD&amp;quot;) and ((($SelectVP1/unknownResultset[1]/row[1]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot; or $SelectVP1/unknownResultset[1]/row[2]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot;) and ($SelectVP2/unknownResultset[1]/row[1]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value = &amp;quot;10&amp;quot; or $SelectVP2/unknownResultset[1]/row[2]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value = &amp;quot;10&amp;quot;) or (($SelectVP1/unknownResultset[1]/row[1]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value = &amp;quot;10&amp;quot; or $SelectVP1/unknownResultset[1]/row[2]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value = &amp;quot;10&amp;quot;) and ($SelectVP2/unknownResultset[1]/row[1]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot; or $SelectVP2/unknownResultset[1]/row[2]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot;))))&quot;>&lt;tns:VerificaVPFLATAttestazioneResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK2&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVPFLATAttestazioneResponse>&lt;/xsl:when>&lt;xsl:when test=&quot;(($SelectVP1/unknownResultset[1]/row[1]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot; or $SelectVP1/unknownResultset[1]/row[2]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot;) and ($SelectVP1/unknownResultset[1]/row[1]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;STANDARD&amp;quot; or $SelectVP1/unknownResultset[1]/row[2]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;STANDARD&amp;quot;) and ($SelectVP2/unknownResultset[1]/row[1]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;SPECIAL&amp;quot; or $SelectVP2/unknownResultset[1]/row[2]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;SPECIAL&amp;quot;)) or (($SelectVP1/unknownResultset[1]/row[1]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;SPECIAL&amp;quot; or $SelectVP1/unknownResultset[1]/row[2]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;SPECIAL&amp;quot;) and ($SelectVP2/unknownResultset[1]/row[1]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot; or $SelectVP2/unknownResultset[1]/row[2]/column[name = &amp;quot;PERCENTUALE&amp;quot;]/value != &amp;quot;10&amp;quot;) and ($SelectVP2/unknownResultset[1]/row[1]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;STANDARD&amp;quot; or $SelectVP2/unknownResultset[1]/row[2]/column[name = &amp;quot;TIPOLG_OFFERTA_VP&amp;quot;]/value = &amp;quot;STANDARD&amp;quot;))&quot;>&lt;tns:VerificaVPFLATAttestazioneResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK3&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVPFLATAttestazioneResponse>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaVPFLATAttestazioneResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVPFLATAttestazioneResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
