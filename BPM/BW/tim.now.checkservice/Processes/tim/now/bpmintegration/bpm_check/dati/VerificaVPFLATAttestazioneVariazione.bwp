            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="eb45c0f4-7e0f-48df-ae9a-ebf51fc0c6b1">
                <bpws:targets>
                    <bpws:target linkName="VerificaVPFLATAttestazioneVariazioneToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToAssignVP1"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+3fcc2120-8318-473b-8181-8ea367b24df6" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;= count($VerificaVPFLATAttestazioneVariazione/input/tns:VerificaVPFLATAttestazioneRequest/tns:VC_VerificaVPFLATAttestazione_Cons)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<= count($VerificaVPFLATAttestazioneVariazione.input/tns:VC_VerificaVPFLATAttestazione_Cons)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToMapper" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToAccumulate" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="5f3f5682-e3e0-4e79-a8bb-96eaffbd4b91">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($VerificaVPFLATAttestazioneVariazione/input/tns:VerificaVPFLATAttestazioneRequest/tns:VC_VerificaVPFLATAttestazione[number($index)]/tns:IdVC!=$VerificaVPFLATAttestazioneVariazione/input/tns:VerificaVPFLATAttestazioneRequest/tns:VC_VerificaVPFLATAttestazione_Cons[number(number($index))]/tns:IdVC ) or $VerificaVPFLATAttestazioneVariazione/input/tns:VerificaVPFLATAttestazioneRequest/tns:VC_VerificaVPFLATAttestazione_Cons[number($index)]/tns:Azione ='A'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[($VerificaVPFLATAttestazioneVariazione.input/tns:VC_VerificaVPFLATAttestazione[number($index)]/tns:IdVC!=$VerificaVPFLATAttestazioneVariazione.input/tns:VC_VerificaVPFLATAttestazione_Cons[number(number($index))]/tns:IdVC ) or $VerificaVPFLATAttestazioneVariazione.input/tns:VC_VerificaVPFLATAttestazione_Cons[number($index)]/tns:Azione ='A']]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToAccumulate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="3fcc2120-8318-473b-8181-8ea367b24df6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd"/>
                                    <bpws:target linkName="GroupStartToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaVPFLATAttestazioneVariazione&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:VerificaVPFLATAttestazioneRequest>&lt;tns:VC_VerificaVPFLATAttestazione>&lt;tns:IdVC>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:IdVC>&lt;/tns:VC_VerificaVPFLATAttestazione>&lt;xsl:copy-of select=&quot;$VerificaVPFLATAttestazioneVariazione/input/tns:VerificaVPFLATAttestazioneRequest/tns:VC_VerificaVPFLATAttestazione_Cons&quot;/>&lt;/tns:VerificaVPFLATAttestazioneRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="a49e017e-ec9a-424b-ba8b-d42cbbb37287" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGroupEnd"/>
                                    </bpws:sources>
