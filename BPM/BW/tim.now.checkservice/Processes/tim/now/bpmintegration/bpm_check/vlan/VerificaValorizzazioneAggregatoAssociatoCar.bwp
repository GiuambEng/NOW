            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="1a8d4b03-f08d-4986-ac07-2ec84a713f48" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOscuramentoToEnd_Oscurato"/>
                        <bpws:target linkName="GenericLoggerToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;Query&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_Valorizzazione_Aggregato_Associato_Car_Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;(not(exists($Start/tns1:FamigliaVlan)) or $Start/tns1:FamigliaVlan!='2') and (not(exists($Start/tns1:BmcLight)) or string-length($Start/tns1:BmcLight)=0) and $Query/Record[1]/NOME_AGGREGATO='Aggregato NGA BMC Light'&quot;>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:Verifica_Valorizzazione_Aggregato_Associato_Car_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="83a9f374-0443-44c3-a951-5f0119cf64c0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaValorizzazioneAggregatoAssociatoCar'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:IdRichiestaOlo&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Input VerificaValorizzazioneAggregatoAssociatoCar: ',tib:render-xml($Start))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="5324716d-ad25-4736-980a-b6c903cf4d3d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OscuramentoToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5324716d-ad25-4736-980a-b6c903cf4d3d+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT FLAG_OSCURMENTO from OSCURAMENTO_AGESP WHERE COD_AGESP='R1I-20-0150' AND FLAG_OSCURMENTO='1'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata
                                    columnName="FLAG_OSCURMENTO"
                                    dataType="1" typeName="CHAR"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="9aa8a5fe-4e37-4baa-936a-5aba8e062219"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscuramentoToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToEnd_Oscurato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($Oscuramento/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaValorizzazioneAggregatoAssociatoCar'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:IdRichiestaOlo&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;'L agesp R1I-20-0150 risulta oscurato'&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;'L agesp R1I-20-0150 non risulta oscurato'&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Query-input"
                    name="Query" outputVariable="Query"
                    tibex:xpdlId="1cbc9dd4-5e2d-4dba-9624-2c20467a60db" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOscuramentoToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1cbc9dd4-5e2d-4dba-9624-2c20467a60db+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Query-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IdKitAreaCar>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdKitAreaCar)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdKitAreaCar&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IdKitAreaCar>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NOME_AGGREGATO &#xa;FROM ANAGRAFICA_KIT_VLAN_ADR_CAR&#xa;WHERE ID_KIT_AREA_CAR=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IdKitAreaCar"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="NOME_AGGREGATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQuery-input"
                    name="LogQuery"
                    tibex:xpdlId="7b7e1629-172e-4ab4-a21b-09d1a8b70740"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Query&quot;/>&#xa;    &lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaValorizzazioneAggregatoAssociatoCar'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:IdRichiestaOlo&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Output Query: ',tib:render-xml($Query))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
