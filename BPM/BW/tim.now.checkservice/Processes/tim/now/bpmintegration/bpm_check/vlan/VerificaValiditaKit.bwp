                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_KIT, FAMIGLIA_KIT&#xa;FROM ANAGRAFICA_KIT_VLAN&#xa;WHERE CODICE_KIT=? AND UPPER(STATO) IN ('ACTIVE','TEMPORARY') AND CODIFICA_OLO_AGCOM=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_KIT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICA_OLO_AGCOM"/>
                                    <columnMetadata
                                    columnName="CODICE_KIT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FAMIGLIA_KIT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
