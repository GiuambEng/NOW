    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LogInputToAssign" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Parametri_CfgzToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogParametriToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="DataMinimaToInvoke" tibex:linkType="SUCCESS"/>
                <bpws:link name="DataMassimaToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToAssign" tibex:linkType="SUCCESS"/>
