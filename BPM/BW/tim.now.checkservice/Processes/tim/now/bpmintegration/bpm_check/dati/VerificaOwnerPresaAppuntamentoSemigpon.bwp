                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="e57a0551-a54d-4068-9378-a6710b8669f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOutputToEnd"/>
                        <bpws:target linkName="RecuperaCausaleEsitoMultiploToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:param name=&quot;RecuperaCausaleEsitoMultiplo&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$Esito/tns:Codice&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$Esito/tns:Descrizione&quot;/>&lt;/tns:Descrizione>&lt;xsl:if test=&quot;exists($RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale)&quot;>&lt;xsl:if test=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;>&lt;tns:IdAnagraficaCausale>&lt;xsl:value-of select=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;/>&lt;/tns:IdAnagraficaCausale>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="15e2fd35-3724-463f-9822-9ef178229517"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($Start/ns0:OwnerPresaAppuntamento)=0 or string-length($Start/ns0:DataAppuntamento)=0 or string-length($Start/ns0:FasciaOraria)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($Start/ns0:OwnerPresaAppuntamento)=0 or string-length($Start/ns0:DataAppuntamento)=0 or string-length($Start/ns0:FasciaOraria)=0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;'VerificaOwnerPresaAppuntamentoSemigpon'&quot;/>&lt;/tns1:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns1:BusinessID>&lt;/xsl:if>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat('Input VerificaOwnerPresaAppuntamentoSemigpon: ',tib:render-xml($Start))&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Parametri_Cfgz-input"
                    name="Parametri_Cfgz"
                    outputVariable="Parametri_Cfgz"
                    tibex:xpdlId="30c91b6d-ffea-419e-9fc8-0d401fdfb052" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Parametri_CfgzToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+30c91b6d-ffea-419e-9fc8-0d401fdfb052+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select chiave, valore_numerico&#xa;from parametri_cfgz_now&#xa;where chiave in ('DROminima_SemiGponGA_OS','DROmax_SemiGponGA_OS')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="CHIAVE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="VALORE_NUMERICO"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DataMinima&quot;/>&lt;xsl:param name=&quot;DataMassima&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns:OwnerPresaAppuntamento)=0 or string-length($Start/tns:DataAppuntamento)=0 or string-length($Start/tns:FasciaOraria)=0&quot;>&lt;tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;tib:compare-date(tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $Start/tns:DataAppuntamento), $DataMinima/parameters/tns2:Response/tns2:outputDate)=-1 or tib:compare-date($DataMassima/parameters/tns2:Response/tns2:outputDate,tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $Start/tns:DataAppuntamento))=-1&quot;>&lt;tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
