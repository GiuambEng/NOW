                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DataMassima.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DataMinima.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($Start/tns:OwnerPresaAppuntamento)=0 or string-length($Start/tns:DataAppuntamento)=0 or string-length($Start/tns:FasciaOraria)=0&quot;>&#xa;                &lt;tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;'KO_01'&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;tib:compare-date(tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $Start/tns:DataAppuntamento), $DataMinima.parameters/tns2:outputDate)=-1 or tib:compare-date($DataMassima.parameters/tns2:outputDate,tib:parse-date(&amp;quot;dd/MM/yyyy&amp;quot;, $Start/tns:DataAppuntamento))=-1&quot;>&#xa;                &lt;tns:VerificaOwnerPresaAppuntamentoSemigpon_Response>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;        