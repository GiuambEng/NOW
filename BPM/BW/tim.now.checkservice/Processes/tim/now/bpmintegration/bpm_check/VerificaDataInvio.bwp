                    inputVariable="LOG_Lavorazione-input"
                    name="LOG_Lavorazione"
                    tibex:xpdlId="4b2842be-5f71-41c9-aea5-a17805db6d80"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NO_NPToLOG_Lavorazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_LavorazioneToVerificaDataInvioResponseANN-ATT">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione) =&quot;ANNULLAMENTO&quot; and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento =&quot;ATTIVAZIONE&quot; and (upper-case($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) !=&quot;SOSPESO&quot; or not(exists($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) or string-length($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) =0))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Verifica_Data_InvioIn.parameters/tns:Lavorazione) ="ANNULLAMENTO" and $Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento ="ATTIVAZIONE" and (upper-case($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) !="SOSPESO" or not(exists($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) or string-length($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) =0))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_LavorazioneToVerificaDataInvioResponseRDAC">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione = &quot;RIMODULAZIONEDAD&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Verifica_Data_InvioIn.parameters/tns:Lavorazione = "RIMODULAZIONEDAD"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_LavorazioneToVerificaDataInvioResponseANN-CESS">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione) =&quot;ANNULLAMENTO&quot; and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento =&quot;CESSAZIONE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Verifica_Data_InvioIn.parameters/tns:Lavorazione) ="ANNULLAMENTO" and $Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento ="CESSAZIONE"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_LavorazioneToVerificaDataInvioResponseFALSE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_LavorazioneToAssignOK_Sospeso">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione) =&quot;ANNULLAMENTO&quot; and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento =&quot;ATTIVAZIONE&quot; and (upper-case($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) =&quot;SOSPESO&quot; ) or (($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione) =&quot;INTERRUZIONEMIGRAZIONE&quot; and ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento =&quot;MIGRAZIONE&quot;  or ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento =&quot;ATTIVAZIONE&quot; and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:LNA_LA ='LA')) and (upper-case($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) =&quot;SOSPESO&quot; or not(exists($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) or string-length($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) =0)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Verifica_Data_InvioIn.parameters/tns:Lavorazione) ="ANNULLAMENTO" and $Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento ="ATTIVAZIONE" and (upper-case($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) ="SOSPESO" ) or (($Verifica_Data_InvioIn.parameters/tns:Lavorazione) ="INTERRUZIONEMIGRAZIONE" and ($Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento ="MIGRAZIONE"  or ($Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento ="ATTIVAZIONE" and $Verifica_Data_InvioIn.parameters/tns:LNA_LA ='LA')) and (upper-case($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) ="SOSPESO" or not(exists($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) or string-length($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) =0)))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_LavorazioneToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione) =&quot;INTERRUZIONEMIGRAZIONE&quot; and ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento =&quot;MIGRAZIONE&quot;  or ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento =&quot;ATTIVAZIONE&quot; and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:LNA_LA ='LA')) and (upper-case($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) !=&quot;SOSPESO&quot; or not(exists($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) or string-length($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:StatoRichiestaOLO) =0))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Verifica_Data_InvioIn.parameters/tns:Lavorazione) ="INTERRUZIONEMIGRAZIONE" and ($Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento ="MIGRAZIONE"  or ($Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento ="ATTIVAZIONE" and $Verifica_Data_InvioIn.parameters/tns:LNA_LA ='LA')) and (upper-case($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) !="SOSPESO" or not(exists($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) or string-length($Verifica_Data_InvioIn.parameters/tns:StatoRichiestaOLO) =0))]]></bpws:transitionCondition>
