            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryAnagrafica-input"
                    name="JDBCQueryAnagrafica"
                    outputVariable="JDBCQueryAnagrafica"
                    tibex:xpdlId="a75feffd-9002-4343-a1f1-e7afa6c9c416" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryAnagraficaToLogQueryAnagrafica"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a75feffd-9002-4343-a1f1-e7afa6c9c416+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;codiceVlan>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:ServiceVLAN)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:ServiceVLAN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codiceVlan>&lt;codOLOAgcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:CodOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:CodOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codOLOAgcom>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*) as conteggio&#xd;&#xa;FROM anagrafica_vlan_open_fiber&#xd;&#xa;WHERE codicevlan=? AND codificaoaoagcom=? AND SYSDATE &lt; datafivalidita AND SYSDATE > datainvalidita " xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codiceVlan"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="codOLOAgcom"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CONTEGGIO"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
