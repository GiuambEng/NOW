                portType="ns1:BPM_CheckPortType"
                tibex:xpdlId="a3410967-d886-4397-86a0-8692bf7cf8c5" variable="RecuperaControlliOutput-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" version="2.0"&gt;
    &lt;xsl:param name="RecuperaControlliResponse"/&gt;
    &lt;xsl:template name="RecuperaControlliOut-input" match="/"&gt;
        &lt;tns1:RecuperaControlliResponse&gt;
            &lt;parameters&gt;
                &lt;tns1:RecuperaControlliResponse&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($RecuperaControlliResponse/tns:Lista_Controlli)"&gt;
                            &lt;xsl:copy-of select="$RecuperaControlliResponse/tns:Lista_Controlli"/&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:copy-of select="$RecuperaControlliResponse/tns:Esito"/&gt;
                &lt;/tns1:RecuperaControlliResponse&gt;
            &lt;/parameters&gt;
        &lt;/tns1:RecuperaControlliResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaControlliResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaControlliOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RecuperaControlliResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RecuperaControlliResponse/tns:Lista_Controlli)&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$RecuperaControlliResponse/tns:Lista_Controlli&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$RecuperaControlliResponse/tns:Esito&quot;/>&#xa;        &lt;/tns1:RecuperaControlliResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AssignToEnd"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4a6f7d0a-fb78-4ab9-a0cc-bbbd5aab550b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaControlliIn&quot;/>&lt;xsl:template name=&quot;SelectMatriceControlli-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Lavorazione = &amp;quot;PORTIN&amp;quot;&quot;>&lt;TIPOLG_LAVRZ>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&lt;/TIPOLG_LAVRZ>&lt;/xsl:when>&lt;xsl:when test=&quot;$RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Scenario = &amp;quot;PACCHETTO&amp;quot;&quot;>&lt;TIPOLG_LAVRZ>&lt;xsl:value-of select=&quot;'ALL'&quot;/>&lt;/TIPOLG_LAVRZ>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TIPOLG_LAVRZ>&lt;xsl:value-of select=&quot;$RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Lavorazione&quot;/>&lt;/TIPOLG_LAVRZ>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Scenario) > 0&quot;>&lt;DESCR_SCENARIO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Scenario)&quot;>&lt;xsl:value-of select=&quot;$RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Scenario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DESCR_SCENARIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DESCR_SCENARIO xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Servizio)&quot;>&lt;xsl:value-of select=&quot;$RecuperaControlliIn/parameters/tns2:RecuperaControlli/tns1:Servizio&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_OFFERTA_ESTERNA>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectMatriceControlli-input"
                    name="SelectMatriceControlli"
                    outputVariable="SelectMatriceControlli"
                    tibex:xpdlId="4a6f7d0a-fb78-4ab9-a0cc-bbbd5aab550b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToEnd"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectMattriceControlliToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4a6f7d0a-fb78-4ab9-a0cc-bbbd5aab550b+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaControlliIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectMatriceControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$RecuperaControlliIn.parameters/tns1:Lavorazione = &amp;quot;PORTIN&amp;quot;&quot;>&#xa;                    &lt;TIPOLG_LAVRZ>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ATTIVAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/TIPOLG_LAVRZ>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$RecuperaControlliIn.parameters/tns1:Scenario = &amp;quot;PACCHETTO&amp;quot;&quot;>&#xa;                    &lt;TIPOLG_LAVRZ>&#xa;                        &lt;xsl:value-of select=&quot;'ALL'&quot;/>&#xa;                    &lt;/TIPOLG_LAVRZ>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TIPOLG_LAVRZ>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaControlliIn.parameters/tns1:Lavorazione&quot;/>&#xa;                    &lt;/TIPOLG_LAVRZ>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($RecuperaControlliIn.parameters/tns1:Scenario) > 0&quot;>&#xa;                    &lt;DESCR_SCENARIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($RecuperaControlliIn.parameters/tns1:Scenario)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$RecuperaControlliIn.parameters/tns1:Scenario&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DESCR_SCENARIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DESCR_SCENARIO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($RecuperaControlliIn.parameters/tns1:Servizio)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$RecuperaControlliIn.parameters/tns1:Servizio&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty1"
                                    sqlStatement="SELECT CF.COD_CTRL, AC.DESCR_CAUS_INTERNO, AC.ID_ANAG_CAUS, AC.COD_CAUS_INTERNO&#xa;  FROM CAUS_CTRL_SRVZ_LAVRZ CCSL &#xa;       INNER JOIN ANAG_CTRLI_FORMALI CF&#xa;          ON CCSL.ID_ANAG_CTRLI_FORMALI = CF.ID_ANAG_CTRLI_FORMALI&#xa;       INNER JOIN TIPOLG_LAVRZ TL&#xa;          ON CCSL.IDTPLG_LAVRZ = TL.IDTPLG_LAVRZ&#xa;       INNER JOIN OFFERTA O&#xa;          ON CCSL.ID_OFFERTA = O.ID_OFFERTA&#xa;       INNER JOIN ANAG_CAUS AC&#xa;          ON CCSL.ID_ANAG_CAUS = AC.ID_ANAG_CAUS&#xa;       INNER JOIN TRASCODFC_OFFERTA TF&#xa;          ON O.ID_OFFERTA = TF.ID_OFFERTA&#xa;       LEFT JOIN TIPOLG_SCENARIO SC&#xa;         ON CCSL.ID_SCENARIO = SC.ID_SCENARIO&#xa; WHERE TL.TIPOLG_LAVRZ = ?&#xa;   AND (&#xa;         CCSL.ID_SCENARIO IS NULL OR SC.SCENARIO_BPM = ? &#xa;       ) &#xa;   AND (&#xa;         ( &#xa;           TF.NOME_OFFERTA_ESTERNA = ? AND TF.PROVENIENZA ='BPM'&#xa;         ) &#xa;         OR O.NOME_OFFERTA_CATLG = 'ALL'&#xa;       )&#xa;  AND CCSL.FLAG_ABLTZ = 'Y'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_SCENARIO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="COD_CTRL"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_CAUS_INTERNO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectMatriceControlli&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaControlliResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SelectMatriceControlli/Record)&quot;>&#xa;                &lt;tns:Recupero_Controlli_Response>&#xa;                    &lt;xsl:for-each select=&quot;$SelectMatriceControlli/Record&quot;>&#xa;                        &lt;tns:Lista_Controlli>&#xa;                            &lt;tns:Codice_Controllo>&#xa;                                &lt;xsl:value-of select=&quot;COD_CTRL&quot;/>&#xa;                            &lt;/tns:Codice_Controllo>&#xa;                            &lt;tns:Id_Causale>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_ANAG_CAUS)&quot;/>&#xa;                            &lt;/tns:Id_Causale>&#xa;                            &lt;tns:Cod_Causale>&#xa;                                &lt;xsl:value-of select=&quot;COD_CAUS_INTERNO&quot;/>&#xa;                            &lt;/tns:Cod_Causale>&#xa;                            &lt;tns:Mesaggio_Scarto>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_CAUS_INTERNO&quot;/>&#xa;                            &lt;/tns:Mesaggio_Scarto>&#xa;                        &lt;/tns:Lista_Controlli>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Recupero_Controlli_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Recupero_Controlli_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Recupero_Controlli_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RecuperaControlliResponse"
                    name="RecuperaControlliResponseAssign"
                    outputVariable="RecuperaControlliResponse"
                    tibex:xpdlId="6f7534a5-cd3b-45a0-aa13-e9fa25d95d1a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToRecuperaControlliResponseAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectMatriceControlli&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaControlliResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SelectMatriceControlli/Record)&quot;>&#xa;                &lt;tns:Recupero_Controlli_Response>&#xa;                    &lt;xsl:for-each select=&quot;$SelectMatriceControlli/Record&quot;>&#xa;                        &lt;tns:Lista_Controlli>&#xa;                            &lt;tns:Codice_Controllo>&#xa;                                &lt;xsl:value-of select=&quot;COD_CTRL&quot;/>&#xa;                            &lt;/tns:Codice_Controllo>&#xa;                            &lt;tns:Id_Causale>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(ID_ANAG_CAUS)&quot;/>&#xa;                            &lt;/tns:Id_Causale>&#xa;                            &lt;tns:Cod_Causale>&#xa;                                &lt;xsl:value-of select=&quot;COD_CAUS_INTERNO&quot;/>&#xa;                            &lt;/tns:Cod_Causale>&#xa;                            &lt;tns:Mesaggio_Scarto>&#xa;                                &lt;xsl:value-of select=&quot;DESCR_CAUS_INTERNO&quot;/>&#xa;                            &lt;/tns:Mesaggio_Scarto>&#xa;                        &lt;/tns:Lista_Controlli>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Recupero_Controlli_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Recupero_Controlli_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Recupero_Controlli_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
