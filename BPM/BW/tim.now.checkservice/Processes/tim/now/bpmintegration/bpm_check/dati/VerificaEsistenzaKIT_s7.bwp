                    <bpws:sources>
                        <bpws:source linkName="LOG_OutputCheckDati_ESITOOK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_OutputCheckDati_ESITOKO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$EsistKIT/tns:Codice =false() or (exists($VerificaEsistenzaKIT/input/tns:VerificaEsistenzaKITRequest/tns:Flag_GUI) and $VerificaEsistenzaKIT/input/tns:VerificaEsistenzaKITRequest/tns:Flag_GUI =true())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$EsistKIT/tns:Codice =false() or (exists($VerificaEsistenzaKIT.input/tns:Flag_GUI) and $VerificaEsistenzaKIT.input/tns:Flag_GUI =true())]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
