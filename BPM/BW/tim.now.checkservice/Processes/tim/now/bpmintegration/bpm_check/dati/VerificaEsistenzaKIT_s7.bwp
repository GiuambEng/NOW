                                <tibex:activityExtension
                                    inputVariable="EsistKIT"
                                    name="Assign1"
                                    outputVariable="EsistKIT"
                                    tibex:xpdlId="f592ee74-e855-440a-b591-ae92445453c3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToGroupEnd"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd"/>
                                    </bpws:sources>
