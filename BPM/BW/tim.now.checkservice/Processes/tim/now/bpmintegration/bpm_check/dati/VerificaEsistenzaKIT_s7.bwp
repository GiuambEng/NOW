                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+40b2033d-1d73-44ec-a446-860122ae52de+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaEsistenzaKIT&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;Select_CodKIT-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CodfcOloAgcom>&lt;xsl:value-of select=&quot;$VerificaEsistenzaKIT/input/tns1:VerificaEsistenzaKITRequest/tns1:CodiceOLOAGCOM&quot;/>&lt;/CodfcOloAgcom>&lt;CodKIT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaKIT/input/tns1:VerificaEsistenzaKITRequest/tns1:VC_VerificaEsistenzaKIT[number($index)]/tns1:TDCode)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaKIT/input/tns1:VerificaEsistenzaKITRequest/tns1:VC_VerificaEsistenzaKIT[number($index)]/tns1:TDCode&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CodKIT>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Select_CodKIT-input"
                                    name="Select_CodKIT"
                                    outputVariable="Select_CodKIT"
                                    tibex:xpdlId="40b2033d-1d73-44ec-a446-860122ae52de" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LOG_SelectKITToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+40b2033d-1d73-44ec-a446-860122ae52de+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaKIT.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;Select_CodKIT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;CodfcOloAgcom>&#xa;                &lt;xsl:value-of select=&quot;$VerificaEsistenzaKIT.input/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CodfcOloAgcom>&#xa;            &lt;CodKIT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaEsistenzaKIT.input/tns1:VC_VerificaEsistenzaKIT[number($index)]/tns1:TDCode)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaEsistenzaKIT.input/tns1:VC_VerificaEsistenzaKIT[number($index)]/tns1:TDCode&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CodKIT>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATO, CODFC_OLO_AGCOM, COD_KIT,CLLI,COD_AREA_RACCOLTA,ID_PRIME_CONTRACTOR&#xa; FROM ANAG_KIT &#xa; WHERE CODFC_OLO_AGCOM = ? AND UPPER(STATO) &lt;> 'INACTIVE' AND COD_KIT = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodfcOloAgcom"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodKIT"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_KIT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CLLI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_AREA_RACCOLTA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_PRIME_CONTRACTOR"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Select_CodKIT&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelectMacroArea&quot;/>&lt;xsl:param name=&quot;VerificaEsistenzaKIT&quot;/>&lt;xsl:template name=&quot;MapperAccumulateCodKIT-input&quot; match=&quot;/&quot;>&lt;tns:CodKIT>&lt;xsl:if test=&quot;$VerificaEsistenzaKIT/input/tns:VerificaEsistenzaKITRequest/tns:VC_VerificaEsistenzaKIT[number($index)]/tns:IDDettaglioOrdine&quot;>&lt;tns:ID_DETTAGLIO_ORDINE>&lt;xsl:value-of select=&quot;$VerificaEsistenzaKIT/input/tns:VerificaEsistenzaKITRequest/tns:VC_VerificaEsistenzaKIT[number($index)]/tns:IDDettaglioOrdine&quot;/>&lt;/tns:ID_DETTAGLIO_ORDINE>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/STATO&quot;>&lt;tns:STATO>&lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/STATO&quot;/>&lt;/tns:STATO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:CODFC_OLO_AGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/COD_KIT&quot;>&lt;tns:COD_KIT>&lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/COD_KIT&quot;/>&lt;/tns:COD_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/COD_AREA_RACCOLTA&quot;>&lt;tns:COD_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/COD_AREA_RACCOLTA&quot;/>&lt;/tns:COD_AREA_RACCOLTA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$SelectMacroArea/Record[1]/MACRO_AREA = $Select_CodKIT/Record[1]/COD_AREA_RACCOLTA&quot;>&lt;tns:TRASPORTO>&lt;xsl:value-of select=&quot;&amp;quot;ASSENTE&amp;quot;&quot;/>&lt;/tns:TRASPORTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:TRASPORTO>&lt;xsl:value-of select=&quot;&amp;quot;PRESENTE&amp;quot;&quot;/>&lt;/tns:TRASPORTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/ID_PRIME_CONTRACTOR&quot;>&lt;tns:ID_PRIME_CONTRACTOR>&lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/ID_PRIME_CONTRACTOR&quot;/>&lt;/tns:ID_PRIME_CONTRACTOR>&lt;/xsl:if>&lt;/tns:CodKIT>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
