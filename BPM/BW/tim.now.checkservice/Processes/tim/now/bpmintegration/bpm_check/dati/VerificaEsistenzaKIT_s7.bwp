                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($VerificaEsistenzaKIT/input/tns:VerificaEsistenzaKITRequest/tns:VC_VerificaEsistenzaKIT) and $EsistKIT/tns:Codice =true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($VerificaEsistenzaKIT.input/tns:VC_VerificaEsistenzaKIT) and $EsistKIT/tns:Codice =true()]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
