                                    outputVariable="MapperAccumulateCodKIT"
                                    tibex:xpdlId="a02899e0-4a45-4bcd-8f14-b977fb781c0c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
