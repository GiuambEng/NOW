: &amp;quot;, $VerificaEsistenzaKIT/input/tns1:VerificaEsistenzaKITRequest/tns1:CodiceOLOAGCOM, &amp;quot;TD Code: &amp;quot;, $VerificaEsistenzaKIT/input/tns1:VerificaEsistenzaKITRequest/tns1:VC_VerificaEsistenzaKIT[number($index)]/tns1:TDCode)&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
