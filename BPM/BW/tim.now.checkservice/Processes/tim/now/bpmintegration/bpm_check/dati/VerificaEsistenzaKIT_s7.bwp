                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaKIT.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Select_CodKIT&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectMacroArea&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperAccumulateCodKIT-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CodKIT>&#xa;            &lt;xsl:if test=&quot;$VerificaEsistenzaKIT.input/tns:VC_VerificaEsistenzaKIT[number($index)]/tns:IDDettaglioOrdine&quot;>&#xa;                &lt;tns:ID_DETTAGLIO_ORDINE>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaEsistenzaKIT.input/tns:VC_VerificaEsistenzaKIT[number($index)]/tns:IDDettaglioOrdine&quot;/>&#xa;                &lt;/tns:ID_DETTAGLIO_ORDINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/STATO&quot;>&#xa;                &lt;tns:STATO>&#xa;                    &lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/STATO&quot;/>&#xa;                &lt;/tns:STATO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                &lt;tns:CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/tns:CODFC_OLO_AGCOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/COD_KIT&quot;>&#xa;                &lt;tns:COD_KIT>&#xa;                    &lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/COD_KIT&quot;/>&#xa;                &lt;/tns:COD_KIT>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/COD_AREA_RACCOLTA&quot;>&#xa;                &lt;tns:COD_AREA_RACCOLTA>&#xa;                    &lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/COD_AREA_RACCOLTA&quot;/>&#xa;                &lt;/tns:COD_AREA_RACCOLTA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$SelectMacroArea/Record[1]/MACRO_AREA = $Select_CodKIT/Record[1]/COD_AREA_RACCOLTA&quot;>&#xa;                    &lt;tns:TRASPORTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ASSENTE&amp;quot;&quot;/>&#xa;                    &lt;/tns:TRASPORTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:TRASPORTO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;PRESENTE&amp;quot;&quot;/>&#xa;                    &lt;/tns:TRASPORTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$Select_CodKIT/Record[1]/ID_PRIME_CONTRACTOR&quot;>&#xa;                &lt;tns:ID_PRIME_CONTRACTOR>&#xa;                    &lt;xsl:value-of select=&quot;$Select_CodKIT/Record[1]/ID_PRIME_CONTRACTOR&quot;/>&#xa;                &lt;/tns:ID_PRIME_CONTRACTOR>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:CodKIT>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
