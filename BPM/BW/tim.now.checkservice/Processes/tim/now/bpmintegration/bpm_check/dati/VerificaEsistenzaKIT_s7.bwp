            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="3243557f-50a6-47b3-b22b-56e9f24f4f30">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToEmpty"/>
                </bpws:sources>
                <bpws:variables>
