                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ControlloIDULLCOFault>&#xa;            &lt;CodeFault>&#xa;                &lt;xsl:value-of select=&quot;'999'&quot;/>&#xa;            &lt;/CodeFault>&#xa;            &lt;DescriptionFault>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO su DatiVerificaControlli&amp;quot;&quot;/>&#xa;            &lt;/DescriptionFault>&#xa;        &lt;/tns2:ControlloIDULLCOFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
