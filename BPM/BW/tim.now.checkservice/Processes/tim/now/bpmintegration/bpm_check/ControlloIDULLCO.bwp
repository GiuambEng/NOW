                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d7e8d696-0ddf-4ec3-ba09-4c22ceca4e49+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloIDULLCO.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0001900'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0001900']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0001900']/FLAG_OSCURMENTO='Y' )&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat('SELECT IDULLCO, CLLI, DATAFI_VALID, CODFC_OLO_AGCOM  FROM CLC_IDULLCO WHERE IDULLCO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO.parameters/tns1:IDULLCO,&amp;quot;'&amp;quot;,' AND CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO.parameters/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO.parameters/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' ))')&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat('SELECT IDULLCO, CLLI, DATAFI_VALID, CODFC_OLO_AGCOM  FROM CLC_IDULLCO WHERE IDULLCO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO.parameters/tns1:IDULLCO,&amp;quot;'&amp;quot;,' AND CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO.parameters/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO.parameters/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' ) OR CODFC_OLO_AGCOM IN (SELECT codfc_olo_agcom_condivisore FROM olo_colocazione WHERE codfc_olo_agcom_riferimento IN (SELECT CODFC_OLO_AGCOM  FROM OLO WHERE COD_OLO = ',&amp;quot;'&amp;quot;,$ControlloIDULLCO.parameters/tns1:Codice_OLO,&amp;quot;'&amp;quot;,') and data_inizio &amp;lt; SYSDATE and data_fine > SYSDATE))')&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    timeout="10" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
