            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d7e8d696-0ddf-4ec3-ba09-4c22ceca4e49+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloIDULLCO&quot;/>&#xa;    &lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='T1PRJ0001900'])>0 and  ($Oscuramento/Record[COD_AGESP='T1PRJ0001900']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='T1PRJ0001900']/FLAG_OSCURMENTO='Y' )&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat('SELECT IDULLCO, CLLI, DATAFI_VALID, CODFC_OLO_AGCOM  FROM CLC_IDULLCO WHERE IDULLCO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO/parameters/tns2:ControlloIDULLCO/tns1:IDULLCO,&amp;quot;'&amp;quot;,' AND CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO/parameters/tns2:ControlloIDULLCO/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO/parameters/tns2:ControlloIDULLCO/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' ))')&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat('SELECT IDULLCO, CLLI, DATAFI_VALID, CODFC_OLO_AGCOM  FROM CLC_IDULLCO WHERE IDULLCO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO/parameters/tns2:ControlloIDULLCO/tns1:IDULLCO,&amp;quot;'&amp;quot;,' AND CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO/parameters/tns2:ControlloIDULLCO/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDULLCO/parameters/tns2:ControlloIDULLCO/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' ) OR CODFC_OLO_AGCOM IN (SELECT codfc_olo_agcom_condivisore FROM olo_colocazione WHERE codfc_olo_agcom_riferimento IN (SELECT CODFC_OLO_AGCOM  FROM OLO WHERE COD_OLO = ',&amp;quot;'&amp;quot;,$ControlloIDULLCO/parameters/tns2:ControlloIDULLCO/tns1:Codice_OLO,&amp;quot;'&amp;quot;,') and data_inizio &amp;lt; SYSDATE and data_fine > SYSDATE))')&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SQLDirect-input" name="SQLDirect"
                    outputVariable="SQLDirect"
                    tibex:xpdlId="d7e8d696-0ddf-4ec3-ba09-4c22ceca4e49" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToDatiVerificaControlliInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SQLDirect/unknownResultset/row) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($SQLDirect/unknownResultset/row) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SQLDirectToControlloIDULLCOResponseAssign">
                            <tibex:DesignExpression>
