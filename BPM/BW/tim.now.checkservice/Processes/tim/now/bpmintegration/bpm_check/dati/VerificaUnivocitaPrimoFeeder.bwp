            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscur-input"
                    name="LogOscur"
                    tibex:xpdlId="af9d0a17-17a2-4f1d-b096-99940ad3a088"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToLogOscur"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscurToResponse_OSCURATO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($Oscuramento/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscurToQueryIDContrattoOffertaCtlg">
                            <tibex:DesignExpression>
