            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryOrdine-input" name="QueryOrdine"
                    outputVariable="QueryOrdine"
                    tibex:xpdlId="990c30da-63b5-4f50-9212-3b5852be5f44" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogOscurToQueryIDContrattoOffertaCtlg"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryIDContrattoOffertaCtlgToLogQueryCATALG_OFF_COM_COINV"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+990c30da-63b5-4f50-9212-3b5852be5f44+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;QueryOrdine-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NOMEMACROAREA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:NomeMacroArea)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:NomeMacroArea&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOMEMACROAREA>&lt;FLAGPRIMOFEEDER>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/FLAGPRIMOFEEDER>&lt;CODIFICAOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodificaOloAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodificaOloAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLOAGCOM>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  R.IDRICHIESTAOLO&#xa;  FROM APPUSER.BDS_1_CASEDATA_RICHIESTA       R,&#xa;       APPUSER.BDS_1_CASEDATA_ORDINE          O,&#xa;       APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE DETTAGLIOORDINE,&#xa;       APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE,&#xa;       APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE2&#xa; WHERE R.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;   AND O.BDS_ID = DETTAGLIOORDINE.ORDINE_DETTAGLIOORDINE_BDSID&#xa;   AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;   AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE2.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;   AND R.STATORICHIESTANOW NOT IN ('SCARTATO','SCARTATOB2B','ESPLETAMENTOTECNICOKO','ANNULLATO','ANNULLATOB2B','CHIUSO','CHIUSOB2B','FATTURAZIONEKO','ESPLETAMENTOTECNICO','ESPLETAMENTOTECNICOB2B','INVIATOAFATTURAZIONE')&#xa;   AND O.OFFERTA ='FEEDER'&#xa;   AND R.LAVORAZIONE = 'ATTIVAZIONE'&#xa;   AND DETTAGLIOORDINE.NOMECOMPONENTE = 'ACCESSOFEEDER'&#xa;   AND ATTRIBUTOORDINE.NOMEATTRIBUTO = 'NOMEMACROAREA'&#xa;   AND ATTRIBUTOORDINE2.NOMEATTRIBUTO = 'FLAGPRIMOFEEDER'&#xa;   AND ATTRIBUTOORDINE.VALOREATTRIBUTO = ? --NOMEMACROAREA&#xa;   AND ATTRIBUTOORDINE2.VALOREATTRIBUTO = ? --FLAGPRIMOFEEDER&#xa;   AND R.CODIFICAOLOAGCOM = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOMEMACROAREA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAGPRIMOFEEDER"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQueryOrdine-input"
                    name="LogQueryOrdine"
                    tibex:xpdlId="9a1e92d9-f805-4966-ac5f-e69ad4ed7530"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryIDContrattoOffertaCtlgToLogQueryCATALG_OFF_COM_COINV"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogQueryOrdineToKO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($QueryOrdine/Record[IDRICHIESTAOLO!=$Start/ns0:IDRichiestaOLO])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($QueryOrdine/Record[IDRICHIESTAOLO!=$Start/ns0:IDRichiestaOLO])>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogQueryOrdineToCopy_1_OK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;QueryOrdine&quot;/>&lt;xsl:template name=&quot;LogQueryOrdine-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaUnivocitaPrimoFeeder&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaUnivocitaPrimoFeeder&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output QueryOrdine: &amp;quot;, tib:render-xml($QueryOrdine, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
