                <tibex:activityExtension inputVariable="Response"
                    name="OK" outputVariable="Response"
                    tibex:xpdlId="765931b0-abee-4a81-883f-9b81d323e06b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
