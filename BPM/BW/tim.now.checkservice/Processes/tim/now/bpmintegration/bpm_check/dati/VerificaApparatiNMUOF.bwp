                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:VerificaApparatiNMUOF_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$Esito/tns:Codice&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$Esito/tns:Descrizione&quot;/>&lt;/tns:Descrizione>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Oscuramento/Record[COD_AGESP='R8K-25-0004'])>0 and  ($Oscuramento/Record[COD_AGESP='R8K-25-0004']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R8K-25-0004']/FLAG_OSCURMENTO='Y' )&quot;>&lt;tns:Apparato/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;$Accumulate/tns:Apparato&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaApparatiNMUOF_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
