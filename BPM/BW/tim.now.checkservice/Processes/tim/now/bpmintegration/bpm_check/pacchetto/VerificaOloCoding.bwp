                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StartVerificaOloCoding&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;SelectNUMEROTELEFONICO&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SelectIDRISORSA&quot;/>&lt;xsl:param name=&quot;SelectRADICALE&quot;/>&lt;xsl:param name=&quot;RecuperoIDRisorsa&quot;/>&lt;xsl:template name=&quot;LogRicercaAsset-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaOloCoding&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaOloCoding&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$StartVerificaOloCoding/input/tns1:VerificaOloCoding_Request/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$StartVerificaOloCoding/input/tns1:VerificaOloCoding_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($SelectNUMEROTELEFONICO/Record) and string-length($SelectNUMEROTELEFONICO/Record[1]/CODIFICAOLOAGCOM)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Per Richiesta: &amp;quot;, $RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO, &amp;quot;OLOAGCOMDonating Trovato: &amp;quot;, $SelectNUMEROTELEFONICO/Record[1]/CODIFICAOLOAGCOM)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($SelectIDRISORSA/Record) and string-length($SelectIDRISORSA/Record[1]/CODIFICAOLOAGCOM)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Per Richiesta: &amp;quot;, $RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO, &amp;quot;OLOAGCOMDonating Trovato: &amp;quot;, $SelectIDRISORSA/Record[1]/CODIFICAOLOAGCOM)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($SelectRADICALE/Record) and string-length($SelectRADICALE/Record[1]/CODIFICAOLOAGCOM)>0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Per Richiesta: &amp;quot;, $RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO, &amp;quot;OLOAGCOMDonating Trovato: &amp;quot;, $SelectRADICALE/Record[1]/CODIFICAOLOAGCOM)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Nessun Asset trovato per IDRICHIESTAOLO: &amp;quot;,$RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogRicercaAsset-input"
                                    name="LogRicercaAsset"
                                    tibex:xpdlId="1f829338-63ef-4118-85db-eaf17a002c48"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogRicercaAssetToCODIFICAOLOAGCOM"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StartVerificaOloCoding.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectNUMEROTELEFONICO&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDRISORSA&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRADICALE&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperoIDRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;LogRicercaAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaOloCoding&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaOloCoding&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$StartVerificaOloCoding.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$StartVerificaOloCoding.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectNUMEROTELEFONICO/Record) and string-length($SelectNUMEROTELEFONICO/Record[1]/CODIFICAOLOAGCOM)>0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Per Richiesta: &amp;quot;, $RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO, &amp;quot;OLOAGCOMDonating Trovato: &amp;quot;, $SelectNUMEROTELEFONICO/Record[1]/CODIFICAOLOAGCOM)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SelectIDRISORSA/Record) and string-length($SelectIDRISORSA/Record[1]/CODIFICAOLOAGCOM)>0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Per Richiesta: &amp;quot;, $RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO, &amp;quot;OLOAGCOMDonating Trovato: &amp;quot;, $SelectIDRISORSA/Record[1]/CODIFICAOLOAGCOM)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($SelectRADICALE/Record) and string-length($SelectRADICALE/Record[1]/CODIFICAOLOAGCOM)>0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Per Richiesta: &amp;quot;, $RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO, &amp;quot;OLOAGCOMDonating Trovato: &amp;quot;, $SelectRADICALE/Record[1]/CODIFICAOLOAGCOM)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Nessun Asset trovato per IDRICHIESTAOLO: &amp;quot;,$RecuperoIDRisorsa/Record[$index]/IDRICHIESTAOLO)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="59d644e5-5451-43e5-9d4c-b338f6720218">
                                <bpws:targets>
                                    <bpws:target linkName="SelectNUMEROTELEFONICOToGenericLogger"/>
                                    <bpws:target linkName="SelectIDRISORSAToEmpty"/>
                                    <bpws:target linkName="SelectRADICALEToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToGenericLogger"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if(string-length($OLOAccorpante/Record[1]/COD_OLO_ACCORPANTE)>0) then $OLOAccorpante/Record[1]/COD_OLO_ACCORPANTE else $OLOAGCOM"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="PrimoOLO"
                                    name="PrimoOLO"
                                    outputVariable="PrimoOLO"
                                    tibex:xpdlId="3066e65c-b62d-4303-805b-6b1bfd5aacc0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OLOAccorpanteToPrimoOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="PrimoOLOToCheckOloCoding">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="PrimoOLOToLogOloCoding">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$index = 1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$index = 1]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if(string-length($OLOAccorpante/Record[1]/COD_OLO_ACCORPANTE)>0) then $OLOAccorpante/Record[1]/COD_OLO_ACCORPANTE else $OLOAGCOM" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="PrimoOLO" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;isUguale&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaOloCoding_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$isUguale=true()&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaOloCoding_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Esito" name="AssignEsito"
                    outputVariable="Esito"
                    tibex:xpdlId="d33144c5-6cf3-4355-8f0c-22fc8338f360" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToAssignEsito"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignEsitoToEndVerificaOloCoding"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;isUguale&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaOloCoding_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$isUguale=true()&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaOloCoding_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
