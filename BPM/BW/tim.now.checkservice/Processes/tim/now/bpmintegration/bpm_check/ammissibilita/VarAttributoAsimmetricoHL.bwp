                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_Var_Attributo_Caratt_Fault>&#xa;            &lt;tns1:Fault>&#xa;                &lt;tns1:Codice_Errore>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ERROR&amp;quot;&quot;/>&#xa;                &lt;/tns1:Codice_Errore>&#xa;                &lt;tns1:Messaggio_Errore>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Offerta non ammessa&amp;quot;&quot;/>&#xa;                &lt;/tns1:Messaggio_Errore>&#xa;            &lt;/tns1:Fault>&#xa;        &lt;/tns1:Verifica_Var_Attributo_Caratt_Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty6ToReply"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
