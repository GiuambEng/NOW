essage>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="IdAdr"
                    name="IdAdrVar" outputVariable="IdAdr"
                    tibex:xpdlId="4d7b69a0-3fe4-4b25-8f28-188641d7b61b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogModelloKitVarToAssign"/>
                        <bpws:target linkName="LogIdAdrCrmwsVar1ToAssign"/>
                        <bpws:target linkName="LogIdAdrCrmwsVar0ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="IdAdrVarToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (($Start/ns0:SuperMacroArea='0' or string-length($Start/ns0:SuperMacroArea)=0 or not(exists($Start/ns0:SuperMacroArea))) and $Start/ns0:CC_LIB=('CC','LIB')) then $Start/ns0:IdMadrCrmwsComm&#xd;&#xa;else if (($Start/ns0:SuperMacroArea='0' or string-length($Start/ns0:SuperMacroArea)=0 or not(exists($Start/ns0:SuperMacroArea))) and $Start/ns0:SottoLavorazione='VARIAZIONECAR' and upper-case($ModelloKitVar/Record[1]/MODELLO_KIT)='ADR') then $Start/ns0:IdAdrCrmws&#xd;&#xa;else if (($Start/ns0:SuperMacroArea='0' or string-length($Start/ns0:SuperMacroArea)=0 or not(exists($Start/ns0:SuperMacroArea))) and $Start/ns0:SottoLavorazione='VARIAZIONECAR' and upper-case($ModelloKitVar/Record[1]/MODELLO_KIT)='MADR') then $Start/ns0:IdMadrCrmws&#xd;&#xa;else if (($Start/ns0:SuperMacroArea='0' or string-length($Start/ns0:SuperMacroArea)=0 or not(exists($Start/ns0:SuperMacroArea))) and $Start/ns0:SottoLavorazione='VARIAZIONETDKIT' and upper-case($ModelloKitVar/Record[1]/MODELLO_KIT)='ADR') then $Start/ns0:IdAdrCrmws&#xd;&#xa;else if (($Start/ns0:SuperMacroArea='0' or string-length($Start/ns0:SuperMacroArea)=0 or not(exists($Start/ns0:SuperMacroArea))) and $Start/ns0:SottoLavorazione='VARIAZIONETDKIT' and upper-case($ModelloKitVar/Record[1]/MODELLO_KIT)='MADR') then $Start/ns0:IdMadrCrmws&#xd;&#xa;else if ($Start/ns0:SuperMacroArea='1') then $IdAdrCrmwsVar1o2o3/Record[DESCRIZIONE_AREA='SUPERMACROAREA']/ID_ADR_CRMWS &#xd;&#xa;else if ($Start/ns0:SuperMacroArea='2') then $IdAdrCrmwsVar1o2o3/Record[DESCRIZIONE_AREA='SUPERMACROAREA_CC']/ID_ADR_CRMWS&#xd;&#xa;else if ($Start/ns0:SuperMacroArea='3') then $IdAdrCrmwsVar1o2o3/Record[DESCRIZIONE_AREA='SUPERMACROAREA_LIB']/ID_ADR_CRMWS &#xd;&#xa;else ''" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="IdAdr" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogIdAdrVar-input"
                    name="LogIdAdrVar"
                    tibex:xpdlId="26acf534-bad1-4e53-8a58-fa09e93a8958"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IdAdrVarToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogIdAdrVarToQueryVar"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdAdr&quot;/>&#xa;    &lt;xsl:template name=&quot;LogIdAdrVar-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'DeterminaIdentificativoAnagraficaKitAdrCar'&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaOlo&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Calcolato IdAdrCrmwsVar: &amp;quot;, $IdAdr)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
