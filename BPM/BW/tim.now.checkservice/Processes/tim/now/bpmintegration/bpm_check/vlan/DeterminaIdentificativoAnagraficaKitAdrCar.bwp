                    <bpws:sources>
                        <bpws:source linkName="QueryVlan2o3ToLogQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c483795e-5ac0-4363-aca4-8b855b3a9dfb+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IdAdr&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryVlan2o3-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;CODICE_KIT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CodiceTdKit)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceTdKit&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_KIT>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:FamigliaVlan='2'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA' and exists($Start/tns:BmcLight) and $Start/tns:BmcLight='SI'&quot;>&#xa;                            &lt;NOME_AGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'Aggregato NGA BMC Light'&quot;/>&#xa;                            &lt;/NOME_AGGREGATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA' and (not(exists($Start/tns:BmcLight)) or string-length($Start/tns:BmcLight)=0)&quot;>&#xa;                            &lt;NOME_AGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'Aggregato NGA BMC'&quot;/>&#xa;                            &lt;/NOME_AGGREGATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Offerta='VLAN' and (not(exists($Start/tns:BmcLight)) or string-length($Start/tns:BmcLight)=0)&quot;>&#xa;                            &lt;NOME_AGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'Aggregato GBE BMC'&quot;/>&#xa;                            &lt;/NOME_AGGREGATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;NOME_AGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/NOME_AGGREGATO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:FamigliaVlan='3'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA'&quot;>&#xa;                            &lt;NOME_AGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'Aggregato NGA BMD'&quot;/>&#xa;                            &lt;/NOME_AGGREGATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$Start/tns:Offerta='VLAN'&quot;>&#xa;                            &lt;NOME_AGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;'Aggregato GBE BMD'&quot;/>&#xa;                            &lt;/NOME_AGGREGATO>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;NOME_AGGREGATO>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/NOME_AGGREGATO>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NOME_AGGREGATO>&#xa;                        &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                    &lt;/NOME_AGGREGATO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;CODICE_CAR>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:IdentificativoCar)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdentificativoCar&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_CAR>&#xa;            &lt;ID_ADR_CRMWS>&#xa;                &lt;xsl:value-of select=&quot;$IdAdr&quot;/>&#xa;            &lt;/ID_ADR_CRMWS>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
