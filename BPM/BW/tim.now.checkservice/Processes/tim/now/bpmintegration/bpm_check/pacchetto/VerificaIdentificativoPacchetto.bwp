    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/ControllidiPacchetto/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable
            element="ns0:VerificaIdentificativoPacchetto_Request"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable
            element="ns0:VerificaIdentificativoPacchetto_Response"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="logger_name" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="log_level" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="timeoutJDBC" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/TimerJDBC/TimeoutJDBC" type="xsd:int"/>
        <bpws:variable element="ns1:jdbcQueryActivityInput"
            name="SelectPactoRich-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:resultSet" name="SelectPactoRich" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogInput-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogPactoRich-input" sca-bpel:internal="true"/>
        <bpws:variable
            element="ns0:VerificaIdentificativoPacchetto_Response" name="Esito"/>
        <bpws:variable name="isUguale" type="xsd:boolean">
            <bpws:from>
                <bpws:literal>true</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogCheckIDCorr-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:jdbcQueryActivityInput"
            name="IDCorrAltroPacto-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:resultSet" name="IDCorrAltroPacto" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogIDCorrAltroPacto-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns6:jdbcQueryActivityInput"
            name="CodfOloAgcom-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns7:resultSet" name="CodfOloAgcom" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:CW_BUS_MESSAGE"
            name="LogCodfOloAgcom-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLogInput" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="SelectPactoRichToLogPactoRich" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogPactoRichToEsitoKO_NoRecord"
                    tibex:label="No Record" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="EsitoKOToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogPactoRichToWhile_Record0"
                    tibex:label="Record>0" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="WhileToEmpty" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToIDCorrAltroPacto" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="IDCorrAltroPactoToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogIDCorrAltroPactoToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToAssign_KO" tibex:label="KO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CodfOloAgcomToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="GenericLoggerToEsito" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="04861f1c-95e9-4602-b949-8ebffeb5d8e9"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLogInput"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="6bb3c5c3-f3a8-4cd0-8a31-79410ee33d0e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EsitoKOToEnd"/>
                        <bpws:target linkName="AssignToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:VerificaIdentificativoPacchetto_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$Esito/tns:Esito/tns:Codice&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$Esito/tns:Esito/tns:Descrizione&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaIdentificativoPacchetto_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="SelectPactoRich-input"
                    name="SelectPactoRich"
                    outputVariable="SelectPactoRich"
                    tibex:xpdlId="479383d6-02b1-4ada-98ea-e7dc67726d81" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectPactoRichToLogPactoRich"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+479383d6-02b1-4ada-98ea-e7dc67726d81+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectPactoRich-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDPACTONOW>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:idPacchettoNow&quot;/>&#xa;            &lt;/IDPACTONOW>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="timeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT pacto.STATO, rich.IDCORRELAZIONE, rich.CODIFICAOLOAGCOM, trunc(rich.CREATED) as DATACREAZIONE&#xd;&#xa;FROM BDS_1_CASEDATA_RICHIESTA rich join PACTO_RICH pacto on pacto.ID_PACTO_NOW = rich.CODICEPACCHETTONOW&#xd;&#xa;WHERE pacto.ID_PACTO_NOW = ? AND pacto.STATO = 'INLAVORAZIONE'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDPACTONOW"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDCORRELAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATACREAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="b12ea24e-974d-4bf5-a3f0-6746be4b8955"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input VerificaIdentificativoPacchetto: &amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogPactoRich-input"
                    name="LogPactoRich"
                    tibex:xpdlId="c2ba72b4-e953-4861-a5fa-f717b0380cfe"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectPactoRichToLogPactoRich"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogPactoRichToEsitoKO_NoRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogPactoRichToWhile_Record0">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SelectPactoRich/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SelectPactoRich/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPactoRich&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPactoRich-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectPactoRich/Record) > 0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record estratti: &amp;quot;, tib:render-xml($SelectPactoRich, true(), true()))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record recuperato.&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkPacchetto&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaAppartenenzaPacchetto'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica_Appartenenza_Pacchetto_SUB_PROCESSED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;                &lt;tns2:Playload>&#xa;                    &lt;tns2:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start)))&quot;/>&#xa;                    &lt;/tns2:Binary>&#xa;                    &lt;tns2:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&#xa;                    &lt;/tns2:XMLString>&#xa;                &lt;/tns2:Playload>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Esito"
                    name="EsitoKO" outputVariable="Esito"
                    tibex:xpdlId="8384b1e3-c914-452a-ac6e-87f6dea2b2b8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogPactoRichToEsitoKO_NoRecord"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="EsitoKOToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaIdentificativoPacchetto_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Nessun record trovato per IDPACTONOW'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaIdentificativoPacchetto_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="c4196830-02b6-41c7-b743-10995ec42ae4">
                <bpws:targets>
                    <bpws:target linkName="LogPactoRichToWhile_Record0"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEmpty"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($SelectPactoRich/Record) and $isUguale=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($SelectPactoRich/Record) and $isUguale=true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CheckIDCorrToLogCheckIDCorr" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogCheckIDCorrToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="92fd10a0-ddf1-4422-ae7b-d41311d27fae">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="f5544c2e-3e92-486d-838b-d80396169cc5">
                                <bpws:targets>
                                    <bpws:target linkName="LogCheckIDCorrToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="isUguale"
                                    name="CheckIDCorr"
                                    outputVariable="isUguale"
                                    tibex:xpdlId="7655718a-6ebb-41c6-a914-afc9fdbc600d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckIDCorrToLogCheckIDCorr"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($SelectPactoRich/Record[1]/IDCORRELAZIONE=$SelectPactoRich/Record[number($index)]/IDCORRELAZIONE and $SelectPactoRich/Record[1]/CODIFICAOLOAGCOM=$SelectPactoRich/Record[number($index)]/CODIFICAOLOAGCOM and $SelectPactoRich/Record[1]/DATACREAZIONE=$SelectPactoRich/Record[number($index)]/DATACREAZIONE) then true() else false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="isUguale" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogCheckIDCorr-input"
                                    name="LogCheckIDCorr"
                                    tibex:xpdlId="0fa87200-d3d0-4b47-9907-86a220506e8c"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckIDCorrToLogCheckIDCorr"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogCheckIDCorrToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCheckIDCorr-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Confronto primo record con record indice: &amp;quot;, string($index))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="IDCorrAltroPacto-input"
                    name="IDCorrAltroPacto"
                    outputVariable="IDCorrAltroPacto"
                    tibex:xpdlId="5269d1ed-09a3-4138-b2ee-2f0c8a024565" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToIDCorrAltroPacto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="IDCorrAltroPactoToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5269d1ed-09a3-4138-b2ee-2f0c8a024565+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;IDCorrAltroPacto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;IDCORRELAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:IDCorrelazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDCorrelazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDCORRELAZIONE>&#xa;            &lt;IDPACTONOW>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns:idPacchettoNow&quot;/>&#xa;            &lt;/IDPACTONOW>&#xa;            &lt;CODIFICAOLOAGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:codificaOLOAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codificaOLOAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODIFICAOLOAGCOM>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="timeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_CORLZ, ID_PACTO_NOW&#xd;&#xa;FROM PACTO_RICH&#xd;&#xa;WHERE ID_CORLZ = ? AND ID_PACTO_NOW != ? AND CODFC_OLO_AGCOM = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDCORRELAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDPACTONOW"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <columnMetadata
                                    columnName="ID_CORLZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_PACTO_NOW"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="37e5830c-44fc-468d-a93b-7aae314f9a31">
                <bpws:targets>
                    <bpws:target linkName="WhileToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToIDCorrAltroPacto">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$isUguale=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$isUguale=true()]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToAssign_KO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogIDCorrAltroPacto-input"
                    name="LogIDCorrAltroPacto"
                    tibex:xpdlId="08c1ab3b-3fdc-4bc0-8a87-c19c9f17cd59"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="IDCorrAltroPactoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogIDCorrAltroPactoToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;IDCorrAltroPacto&quot;/>&#xa;    &lt;xsl:template name=&quot;LogIDCorrAltroPacto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($IDCorrAltroPacto/Record) > 0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Record estratti: &amp;quot;, tib:render-xml($IDCorrAltroPacto, true(), true()))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record recuperato.&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkPacchetto&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaAppartenenzaPacchetto'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica_Appartenenza_Pacchetto_SUB_PROCESSED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;                &lt;tns2:Playload>&#xa;                    &lt;tns2:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start)))&quot;/>&#xa;                    &lt;/tns2:Binary>&#xa;                    &lt;tns2:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&#xa;                    &lt;/tns2:XMLString>&#xa;                &lt;/tns2:Playload>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Esito"
                    name="Esito" outputVariable="Esito"
                    tibex:xpdlId="36afa69f-ac64-475a-9474-458b9ee7315d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToAssign_KO"/>
                        <bpws:target linkName="GenericLoggerToEsito"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;isUguale&quot;/>&lt;xsl:param name=&quot;SelectPactoRich&quot;/>&lt;xsl:param name=&quot;IDCorrAltroPacto&quot;/>&lt;xsl:param name=&quot;CodfOloAgcom&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaIdentificativoPacchetto_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$isUguale=false()&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'IDCorrelazione del pacchetto non univoco nella stessa giornata e per stesso OLO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;count($IDCorrAltroPacto/Record)>0&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Trovato stesso IDCorrelazione in altro pacchetto con stesso OLO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($CodfOloAgcom/Record[CODFC_OLO_AGCOM=substring($SelectPactoRich/Record[1]/IDCORRELAZIONE,1,3)])) or substring($SelectPactoRich/Record[1]/IDCORRELAZIONE,4,2)!=substring(string(current-date()),3,2) or string(number(substring($SelectPactoRich/Record[1]/IDCORRELAZIONE,6,5))) = 'NaN'&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'IDCorrelazione non formattato correttamente nel pacchetto'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($SelectPactoRich/Record[1]/IDCORRELAZIONE)>10&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'IDCorrelazione presenta lunghezza maggiore di 10'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaIdentificativoPacchetto_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CodfOloAgcom-input"
                    name="CodfOloAgcom" outputVariable="CodfOloAgcom"
                    tibex:xpdlId="aa1bb7da-a5d5-47a8-a478-9688377276de" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogIDCorrAltroPactoToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CodfOloAgcomToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+aa1bb7da-a5d5-47a8-a478-9688377276de+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CodfOloAgcom-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:codiceOLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:codiceOLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_OLO>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="timeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select CODFC_OLO_AGCOM from OLO where COD_OLO=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCodfOloAgcom-input"
                    name="LogCodfOloAgcom"
                    tibex:xpdlId="083fbab2-772e-495e-b833-22ba65793b7a"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CodfOloAgcomToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToEsito"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;CodfOloAgcom&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCodfOloAgcom-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIdentificativoPacchetto&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Codifiche OloAgcom estratte: &amp;quot;, tib:render-xml($CodfOloAgcom, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkPacchetto&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaAppartenenzaPacchetto'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica_Appartenenza_Pacchetto_SUB_PROCESSED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;                &lt;tns2:Playload>&#xa;                    &lt;tns2:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start)))&quot;/>&#xa;                    &lt;/tns2:Binary>&#xa;                    &lt;tns2:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&#xa;                    &lt;/tns2:XMLString>&#xa;                &lt;/tns2:Playload>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
