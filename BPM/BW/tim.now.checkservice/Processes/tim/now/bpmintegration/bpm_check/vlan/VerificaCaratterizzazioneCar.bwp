                                    sqlStatement="SELECT TIPOLOGIA_COMUNE, FLAG_FTTH_ONLY&#xa;FROM ANAGRAFICA_KIT_VLAN_ADR_CAR &#xa;WHERE CODICE_CAR=? AND ID_TIPOLOGIA_COS=? AND CODICE_KIT=? AND TIPOLOGIA_COMUNE=?" xsi:type="jdbcPalette:JDBCQueryActivity">
