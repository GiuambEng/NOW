    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="e847bba2-65e4-469a-9e45-0f6984367e53">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links/>
                        <bpws:rethrow name="Rethrow" tibex:xpdlId="a1ba68e5-9aaf-4424-8032-8fd96ed8c19b"/>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="OscuramentoToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOscuramentoToEmpty" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="QueryToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOscuramentoToEnd_Oscurato"
                    tibex:label="Oscurato" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogQueryToAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="ResponseToGenericLogger" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogResponseToAssign"
                    tibex:label="false" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="RecuperaCausaleEsitoMultiploToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="EmptyToQuery_Attivazione"
