            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f258de4d-6d45-4155-b102-75cbe0a88873+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SelectPactRich-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDPACTONOW>&lt;xsl:value-of select=&quot;$Start/tns1:idPacchettoNow&quot;/>&lt;/IDPACTONOW>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectPactRich-input"
                    name="SelectPactRich"
                    outputVariable="SelectPactRich"
                    tibex:xpdlId="f258de4d-6d45-4155-b102-75cbe0a88873" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
