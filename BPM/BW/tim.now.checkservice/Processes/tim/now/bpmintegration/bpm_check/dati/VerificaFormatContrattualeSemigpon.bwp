                    name="GestAutPASystem"
                    outputVariable="GestAutPASystem"
                    tibex:xpdlId="ccc1d0b2-ad29-4ee5-aa6d-80006bf5e344" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
