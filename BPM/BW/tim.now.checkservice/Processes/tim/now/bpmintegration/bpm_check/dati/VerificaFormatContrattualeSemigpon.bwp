                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GestAutPASystem&quot;/>&lt;xsl:param name=&quot;GestAutPASub&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:GestioneAutonoma = &amp;quot;OS&amp;quot; and not($GestAutPASystem/Record[1]/DESCR_TIPOLOGIA_IMPRESA = (&amp;quot;OPSYS&amp;quot;,&amp;quot;OPSYSC3&amp;quot;))&quot;>&lt;tns:VerificaFormatContrattualeSemigpon_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaFormatContrattualeSemigpon_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:GestioneAutonoma = &amp;quot;OS&amp;quot; and $GestAutPASystem/Record[1]/DESCR_TIPOLOGIA_IMPRESA = &amp;quot;OPSYSC3&amp;quot; and (string-length($Start/tns:SubAppalto) = 0 or not($GestAutPASub/Record[1]/DESCR_TIPOLOGIA_IMPRESA = &amp;quot;SUB&amp;quot;))&quot;>&lt;tns:VerificaFormatContrattualeSemigpon_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaFormatContrattualeSemigpon_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:GestioneAutonoma = &amp;quot;OS&amp;quot; and $GestAutPASystem/Record[1]/DESCR_TIPOLOGIA_IMPRESA = &amp;quot;OPSYS&amp;quot; and string-length($Start/tns:SubAppalto) > 0 and not($GestAutPASub/Record[1]/DESCR_TIPOLOGIA_IMPRESA = &amp;quot;SUB&amp;quot;)&quot;>&lt;tns:VerificaFormatContrattualeSemigpon_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value