                                tibex:xpdlId="ee9c4390-5455-4766-adf4-77f1c41bef63" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="NmuFittizioNOToAssign1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Assign1ToLogQueryVerifica"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NmuFittizioNO&quot;/>&lt;xsl:template name=&quot;NumeroFittizioNO&quot; match=&quot;/&quot;>&lt;tns6:NumeroFittizioNO>&lt;xsl:for-each select=&quot;$NmuFittizioNO/unknownResultset/row&quot;>&lt;tns6:NumeroFittizioNO>&lt;xsl:if test=&quot;not((string(column[name='COD_NMU']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='COD_NMU']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='COD_NMU']/value)&quot;>&lt;tns6:CodiceNmu>&lt;xsl:value-of select=&quot;column[name='COD_NMU']/value&quot;/>&lt;/tns6:CodiceNmu>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(column[name='NMU_FITTIZIO']/value)&quot;>&lt;xsl:if test=&quot;not((string(column[name='NMU_FITTIZIO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name='NMU_FITTIZIO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name='NMU_FITTIZIO']/value)&quot;>&lt;tns6:NumeroFittizio>&lt;xsl:value-of select=&quot;column[name='NMU_FITTIZIO']/value&quot;/>&lt;/tns6:NumeroFittizio>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns6:NumeroFittizio>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns6:NumeroFittizio>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns6:NumeroFittizioNO>&lt;/xsl:for-each>&lt;/tns6:NumeroFittizioNO>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
