                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:param name=&quot;RecuperaCausaleEsitoMultiplo&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$Esito/tns:Codice&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$Esito/tns:Descrizione&quot;/>&lt;/tns:Descrizione>&lt;xsl:if test=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;>&lt;tns:IdAnagraficaCausale>&lt;xsl:value-of select=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;/>&lt;/tns:IdAnagraficaCausale>&lt;/xsl:if>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="419cc4f8-c0a7-439b-be71-6e3c603ce410">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToRecuperaCausaleEsitoMultiplo"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:while name="while" tibex:counterName="index">
                    <tibex:DesignExpression>
                        <tibex:expression
                            expression="$index&lt;=count($Start/ns0:SerizioAggiuntivo) and $Esito/ns0:Codice=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:DesignExpression>
                    <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Start/ns0:SerizioAggiuntivo) and $Esito/ns0:Codice=true()]]></bpws:condition>
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="CallProcessToAssign1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link name="Assign1ToGroupEnd" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="GroupStartToLogQueryVerifica" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            <bpws:link name="GroupStartToSQLDirect" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link
                                name="SQLDirectToLogQueryVerifica" tibex:linkType="SUCCESS"/>
                            <bpws:link name="GroupStartToSQLDirect1" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="NmuFittizioNOToAssign1" tibex:linkType="SUCCESS"/>
                            <bpws:link name="Assign1ToLogQueryVerifica" tibex:linkType="SUCCESS"/>
                            <bpws:link
                                name="LogQueryVerificaToEsitoOscuramento" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="EsitoOscuramentoToGroupEnd" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:empty name="GroupStart"
                            tibex:group="groupStart" tibex:xpdlId="47c2974b-967d-424b-aa3d-6a9a8b8fe551">
                            <bpws:sources>
                                <bpws:source linkName="GroupStartToLogQueryVerifica">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="GroupStartToSQLDirect">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($Start/ns0:SerizioAggiuntivo[$index]/ns0:NomeServizio=('TLC1','TLC2')) or ($Start/ns0:SerizioAggiuntivo[$index]/ns0:NomeServizio='TLC4' and exists($Start/ns0:SerizioAggiuntivo[$index]/ns0:Apparato[ns0:AzioneApparato=('1','0')]))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:SerizioAggiuntivo[$index]/ns0:NomeServizio=('TLC1','TLC2')) or ($Start/ns0:SerizioAggiuntivo[$index]/ns0:NomeServizio='TLC4' and exists($Start/ns0:SerizioAggiuntivo[$index]/ns0:Apparato[ns0:AzioneApparato=('1','0')]))]]></bpws:transitionCondition>
                                </bpws:source>
                                <bpws:source linkName="GroupStartToSQLDirect1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="($Start/ns0:SerizioAggiuntivo[$index]/ns0:NomeServizio='TLC4' and exists($Start/ns0:SerizioAggiuntivo[$index]/ns0:Apparato[ns0:AzioneApparato='2']))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($Start/ns0:SerizioAggiuntivo[$index]/ns0:NomeServizio='TLC4' and exists($Start/ns0:SerizioAggiuntivo[$index]/ns0:Apparato[ns0:AzioneApparato='2']))]]></bpws:transitionCondition>
                                </bpws:source>
                            </bpws:sources>
                        </bpws:empty>
                        <bpws:empty name="GroupEnd"
                            tibex:group="groupEnd" tibex:xpdlId="5ee7d59b-5f17-4cf3-83d7-d5fe1ccc1dd3">
                            <bpws:targets>
                                <bpws:target linkName="Assign1ToGroupEnd"/>
                                <bpws:target linkName="EsitoOscuramentoToGroupEnd"/>
                            </bpws:targets>
                        </bpws:empty>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                inputVariable="LogQueryVerifica-input"
                                name="LogQueryVerifica"
                                tibex:xpdlId="cfb12b4f-ceec-43c9-be13-d254ed1a6790"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToLogQueryVerifica"/>
                                    <bpws:target linkName="SQLDirectToLogQueryVerifica"/>
                                    <bpws:target linkName="Assign1ToLogQueryVerifica"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="CallProcessToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogQueryVerificaToEsitoOscuramento">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($Oscuramento/Record[COD_AGESP='R8K-25-0004'])>0 and  ($Oscuramento/Record[COD_AGESP='R8K-25-0004']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R8K-25-0004']/FLAG_OSCURMENTO='Y' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record[COD_AGESP='R8K-25-0004'])>0 and  ($Oscuramento/Record[COD_AGESP='R8K-25-0004']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R8K-25-0004']/FLAG_OSCURMENTO='Y' )]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;NmuFittizioNO&quot;/>&lt;xsl:param name=&quot;NmuFittizioSI&quot;/>&lt;xsl:template name=&quot;LogQueryVerifica-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;'CheckServiceDati'&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;'VerificaCompatibilitàAggiuntiviApparati'&quot;/>&lt;/tns2:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Output NmuFittizioSI: ',tib:render-xml($NmuFittizioSI))&quot;/>&lt;/tns2:Message>&lt;tns2:Payload>&lt;xsl:value-of select=&quot;concat('Output NmuFittizioNO ',tib:render-xml($NmuFittizioNO))&quot;/>&lt;/tns2:Payload>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="Esito" name="Esito"
                                outputVariable="Esito"
                                tibex:xpdlId="5330ac81-89b8-4cde-8541-8ccf6d4ffcd9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToAssign1"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;NmuFittizioSI&quot;/>&lt;xsl:param name=&quot;NumeroFittizioNO&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio=('TLC5','TLC2')&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE'&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio=('TLC1','TLC4') and count ($Start/tns:SerizioAggiuntivo[$index]/tns:Apparato)=0&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE'&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio=('TLC1') and exists($Start/tns:SerizioAggiuntivo[$index]/tns:Apparato[tns:AzioneApparato='0'])&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE'&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio=('TLC1')  and exists($Start/tns:SerizioAggiuntivo[$index]/tns:Apparato[tns:AzioneApparato='1']) and exists($NmuFittizioSI/unknownResultset[1]/row/column[name='NMU_FITTIZIO' and value='SI'])&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE'&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio='TLC4' and exists($NmuFittizioSI/unknownResultset[1]/row/column[name='NMU_FITTIZIO' and value='SI'])&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE'&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio='TLC4' and (exists($NumeroFittizioNO/tns6:NumeroFittizioNO[tns6:NumeroFittizio='NO']) or exists($NumeroFittizioNO/tns6:NumeroFittizioNO[string-length(tns6:NumeroFittizio)=0]))&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE'&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio='TLC6' and not($Start/tns:CaratterizzazioneArea='AN')&quot;>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE'&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCompatibilitàAggiuntiviApparati_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="NmuFittizioSI-input"
                                name="NmuFittizioSI"
                                outputVariable="NmuFittizioSI"
                                tibex:xpdlId="4291fef2-25b2-4cf2-9319-435c6a9100c6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToSQLDirect"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="SQLDirectToLogQueryVerifica"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4291fef2-25b2-4cf2-9319-435c6a9100c6+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;NmuFittizioSI-input&quot; match=&quot;/&quot;>&lt;tns4:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:SerizioAggiuntivo[$index]/tns:NomeServizio=('TLC1','TLC2')&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_NMU, NMU_FITTIZIO FROM ANAGRAFICA_CODICI_NMU WHERE COD_NMU IN ('&amp;quot;,tib:concat-sequence-format($Start/tns:SerizioAggiuntivo[$index]/tns:Apparato/tns:CodiceApparato, &amp;quot;','&amp;quot;),&amp;quot;')&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_NMU, NMU_FITTIZIO FROM ANAGRAFICA_CODICI_NMU WHERE COD_NMU IN ('&amp;quot;,tib:concat-sequence-format($Start/tns:SerizioAggiuntivo[$index]/tns:Apparato[tns:AzioneApparato=('0','1')]/tns:CodiceApparato, &amp;quot;','&amp;quot;),&amp;quot;')&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns4:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
