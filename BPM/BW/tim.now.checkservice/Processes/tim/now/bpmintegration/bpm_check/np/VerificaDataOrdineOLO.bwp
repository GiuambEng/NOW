            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;VerificaDataOrdineOLOIn&quot;/>&lt;xsl:param name=&quot;JDBC_FileName&quot;/>&lt;xsl:template name=&quot;LOG_DateCompare-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaDataOrdineOLO&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaDataOrdineOLO&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:StrutturaRichiesta = (&amp;quot;REGOLATORIO&amp;quot;,&amp;quot;NPNG&amp;quot;)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Data in input: &amp;quot;, string($VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:DataInvioRichiesta), &amp;quot; - Data da comparare: &amp;quot;, string(tib:parse-date(&amp;quot;yyyyMMdd&amp;quot;, substring($JDBC_FileName/Record[1]/NOME_FILE, 4, 8))))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:StrutturaRichiesta = &amp;quot;NGA&amp;quot; or $VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:StrutturaRichiesta = &amp;quot;XDSL&amp;quot;&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Data in input: &amp;quot;, string($VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:DataInvioRichiesta), &amp;quot; - Data da comparare: &amp;quot;, string(tib:parse-date(&amp;quot;ddMMyyyy&amp;quot;, tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, &amp;quot;_&amp;quot;), &amp;quot;_&amp;quot;))))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Data in input: &amp;quot;, string($VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:DataInvioRichiesta), &amp;quot; - Data da comparare: &amp;quot;, string(tib:parse-date(&amp;quot;yyyyMMdd&amp;quot;, tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, &amp;quot;_&amp;quot;), &amp;quot;_&amp;quot;))))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkNp'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaDataOrdineOLO&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&lt;/tns:Source>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:EventType>&lt;xsl:value-of select=&quot;'VerificaDataOrdineOLO_SUB-PROCESS'&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat('VerificaDataOrdineOLO_',$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:IDRichiestaOLO )&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_DateCompare-input"
                    name="LOG_DateCompare"
                    tibex:xpdlId="479895d7-8938-4c01-aa9a-7ce9ca661bba"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckDateRecordOKToLOG_DateCompare"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_DateCompareToLOG_FileName">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_DateCompareToCheckDateFlag">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaDataOrdineOLOIn/input/tns:Verifica_Data_Ordine_OLO_Request/tns:StrutturaRichiesta = (&quot;REGOLATORIO&quot;,&quot;NPNG&quot;)and tib:compare-date($VerificaDataOrdineOLOIn/input/tns:Verifica_Data_Ordine_OLO_Request/tns:DataInvioRichiesta, tib:parse-date(&quot;yyyyMMdd&quot;, substring($JDBC_FileName/Record[1]/NOME_FILE, 4, 8))) = 0 or ($VerificaDataOrdineOLOIn/input/tns:Verifica_Data_Ordine_OLO_Request/tns:StrutturaRichiesta = &quot;NGA&quot; or $VerificaDataOrdineOLOIn/input/tns:Verifica_Data_Ordine_OLO_Request/tns:StrutturaRichiesta = &quot;XDSL&quot;) and tib:compare-date($VerificaDataOrdineOLOIn/input/tns:Verifica_Data_Ordine_OLO_Request/tns:DataInvioRichiesta, tib:parse-date(&quot;ddMMyyyy&quot;, tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, &quot;_&quot;), &quot;_&quot;)))=0 or ($VerificaDataOrdineOLOIn/input/tns:Verifica_Data_Ordine_OLO_Request/tns:StrutturaRichiesta = &quot;NPG&quot;) and tib:compare-date($VerificaDataOrdineOLOIn/input/tns:Verifica_Data_Ordine_OLO_Request/tns:DataInvioRichiesta, tib:parse-date(&quot;yyyyMMdd&quot;, tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, &quot;_&quot;), &quot;_&quot;)))=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaDataOrdineOLOIn.input/tns:StrutturaRichiesta = ("REGOLATORIO","NPNG")and tib:compare-date($VerificaDataOrdineOLOIn.input/tns:DataInvioRichiesta, tib:parse-date("yyyyMMdd", substring($JDBC_FileName/Record[1]/NOME_FILE, 4, 8))) = 0 or ($VerificaDataOrdineOLOIn.input/tns:StrutturaRichiesta = "NGA" or $VerificaDataOrdineOLOIn.input/tns:StrutturaRichiesta = "XDSL") and tib:compare-date($VerificaDataOrdineOLOIn.input/tns:DataInvioRichiesta, tib:parse-date("ddMMyyyy", tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, "_"), "_")))=0 or ($VerificaDataOrdineOLOIn.input/tns:StrutturaRichiesta = "NPG") and tib:compare-date($VerificaDataOrdineOLOIn.input/tns:DataInvioRichiesta, tib:parse-date("yyyyMMdd", tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, "_"), "_")))=0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaDataOrdineOLOIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_FileName&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_DateCompare-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataOrdineOLO&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataOrdineOLO&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaDataOrdineOLOIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$VerificaDataOrdineOLOIn.input/tns1:StrutturaRichiesta = (&amp;quot;REGOLATORIO&amp;quot;,&amp;quot;NPNG&amp;quot;)&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Data in input: &amp;quot;, string($VerificaDataOrdineOLOIn.input/tns1:DataInvioRichiesta), &amp;quot; - Data da comparare: &amp;quot;, string(tib:parse-date(&amp;quot;yyyyMMdd&amp;quot;, substring($JDBC_FileName/Record[1]/NOME_FILE, 4, 8))))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$VerificaDataOrdineOLOIn.input/tns1:StrutturaRichiesta = &amp;quot;NGA&amp;quot; or $VerificaDataOrdineOLOIn.input/tns1:StrutturaRichiesta = &amp;quot;XDSL&amp;quot;&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Data in input: &amp;quot;, string($VerificaDataOrdineOLOIn.input/tns1:DataInvioRichiesta), &amp;quot; - Data da comparare: &amp;quot;, string(tib:parse-date(&amp;quot;ddMMyyyy&amp;quot;, tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, &amp;quot;_&amp;quot;), &amp;quot;_&amp;quot;))))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Data in input: &amp;quot;, string($VerificaDataOrdineOLOIn.input/tns1:DataInvioRichiesta), &amp;quot; - Data da comparare: &amp;quot;, string(tib:parse-date(&amp;quot;yyyyMMdd&amp;quot;, tib:substring-after-last(tib:substring-before-last($JDBC_FileName/Record[1]/NOME_FILE, &amp;quot;_&amp;quot;), &amp;quot;_&amp;quot;))))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkNp'&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataOrdineOLO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;tns:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaDataOrdineOLOIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:BusinessID>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaDataOrdineOLO_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaDataOrdineOLO_',$VerificaDataOrdineOLOIn.input/tns1:IDRichiestaOLO )&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
