&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiNP/" version="2.0"&gt;&lt;xsl:param name="VerificaDataOrdineOLOIn"/&gt;&lt;xsl:template name="GetNextWorkingDateInvoke-input" match="/"&gt;&lt;ns:calcNextDateByDurationRequest&gt;&lt;parameters&gt;&lt;tns:Request&gt;&lt;tns:inputDate&gt;&lt;xsl:value-of select="$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:DataInvioRichiesta"/&gt;&lt;/tns:inputDate&gt;&lt;tns:inputDuration&gt;&lt;xsl:value-of select="&amp;quot;PT9H&amp;quot;"/&gt;&lt;/tns:inputDuration&gt;&lt;/tns:Request&gt;&lt;/parameters&gt;&lt;/ns:calcNextDateByDurationRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
