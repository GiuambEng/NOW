ource>&lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&lt;/tns:Source>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:EventType>&lt;xsl:value-of select=&quot;'VerificaDataOrdineOLO_SUB-PROCESS'&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat('VerificaDataOrdineOLO_',$VerificaDataOrdineOLOIn/input/tns1:Verifica_Data_Ordine_OLO_Request/tns1:IDRichiestaOLO )&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
