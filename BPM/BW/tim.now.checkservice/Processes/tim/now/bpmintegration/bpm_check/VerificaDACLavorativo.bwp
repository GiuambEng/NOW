                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="VerificaDACLavorativoResponse"/&gt;&lt;xsl:param name="CallRecuperaEsitiMultipli"/&gt;&lt;xsl:template name="VerificaDACLavorativoOutput-input" match="/"&gt;&lt;tns:VerificaDACLavorativoResponse&gt;&lt;parameters&gt;&lt;tns:VerificaDACLavorativoResponse&gt;&lt;Esito&gt;&lt;Codice&gt;&lt;xsl:value-of select="$VerificaDACLavorativoResponse/Esito/Codice"/&gt;&lt;/Codice&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$VerificaDACLavorativoResponse/Esito/Codice =false()"&gt;&lt;Descrizione&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/Descrizione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;Descrizione&gt;&lt;xsl:value-of select="&amp;quot;OK&amp;quot;"/&gt;&lt;/Descrizione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/Esito&gt;&lt;xsl:if test="exists($CallRecuperaEsitiMultipli/em:IdAnagraficaCausale)"&gt;&lt;IdCausale&gt;&lt;xsl:value-of select="xsd:int($CallRecuperaEsitiMultipli/em:IdAnagraficaCausale)"/&gt;&lt;/IdCausale&gt;&lt;/xsl:if&gt;&lt;/tns:VerificaDACLavorativoResponse&gt;&lt;/parameters&gt;&lt;/tns:VerificaDACLavorativoResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaDACLavorativoResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;CallRecuperaEsitiMultipli&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaDACLavorativoOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaDACLavorativoResponse>&#xa;            &lt;Esito>&#xa;                &lt;Codice>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaDACLavorativoResponse/Esito/Codice&quot;/>&#xa;                &lt;/Codice>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$VerificaDACLavorativoResponse/Esito/Codice =false()&quot;>&#xa;                        &lt;Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/Descrizione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/Descrizione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Esito>&#xa;            &lt;xsl:if test=&quot;exists($CallRecuperaEsitiMultipli/em:IdAnagraficaCausale)&quot;>&#xa;                &lt;IdCausale>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($CallRecuperaEsitiMultipli/em:IdAnagraficaCausale)&quot;/>&#xa;                &lt;/IdCausale>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:VerificaDACLavorativoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
