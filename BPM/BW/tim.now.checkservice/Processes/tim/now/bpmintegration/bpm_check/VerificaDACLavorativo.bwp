                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaDACLavorativoIn/parameters/ns1:VerificaDACLavorativoRequest/Lavorazione='ATTIVAZIONE' and $VerificaDACLavorativoIn/parameters/ns1:VerificaDACLavorativoRequest/Offerta=('ULLLINEANONATTIVA','ULLDATILINEANONATTIVA','SLULINEANONATTIVA','VULLLINEANONATTIVA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VerificaDACLavorativoIn.parameters/Lavorazione='ATTIVAZIONE' and $VerificaDACLavorativoIn.parameters/Offerta=('ULLLINEANONATTIVA','ULLDATILINEANONATTIVA','SLULINEANONATTIVA','VULLLINEANONATTIVA')]]></bpws:transitionCondition>
