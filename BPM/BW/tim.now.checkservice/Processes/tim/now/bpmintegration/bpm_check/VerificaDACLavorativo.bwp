                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaDACLavorativoResponseAssignToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaDACLavorativoResponse/Esito/Codice =false() and (string-length($VerificaDACLavorativoIn/parameters/ns1:VerificaDACLavorativoRequest/Flag_GUI) = 0 or $VerificaDACLavorativoIn/parameters/ns1:VerificaDACLavorativoRequest/Flag_GUI = &quot;N&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaDACLavorativoResponse/Esito/Codice =false() and (string-length($VerificaDACLavorativoIn.parameters/Flag_GUI) = 0 or $VerificaDACLavorativoIn.parameters/Flag_GUI = "N")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;calcNextDateByDuration.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaDACLavorativoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Eito&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaDACLavorativoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaDACLavorativoResponse>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$calcNextDateByDuration.parameters/tns1:outputDate = $VerificaDACLavorativoIn.parameters/DAC&quot;>&#xa;                    &lt;Esito>&#xa;                        &lt;Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/Codice>&#xa;                        &lt;Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/Descrizione>&#xa;                    &lt;/Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;Esito>&#xa;                        &lt;Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/Codice>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Eito =&amp;quot;FALSE&amp;quot;&quot;>&#xa;                                &lt;Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&#xa;                                &lt;/Descrizione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;($VerificaDACLavorativoIn.parameters/StrutturaRichiesta =&amp;quot;XDSL&amp;quot;  or  $VerificaDACLavorativoIn.parameters/StrutturaRichiesta =&amp;quot;NGA&amp;quot;)&quot;>&#xa;                                &lt;Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&#xa;                                &lt;/Descrizione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$VerificaDACLavorativoIn.parameters/StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&#xa;                                &lt;Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO_03&amp;quot;&quot;/>&#xa;                                &lt;/Descrizione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;$VerificaDACLavorativoIn.parameters/Offerta ='NP'&quot;>&#xa;                                &lt;Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO_04&amp;quot;&quot;/>&#xa;                                &lt;/Descrizione>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&#xa;                                &lt;/Descrizione>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/Esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:VerificaDACLavorativoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
