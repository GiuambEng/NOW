    &lt;xsl:param name="VerificaDACLavorativoIn"/&gt;
    &lt;xsl:template name="calcNextDateByDuration-input" match="/"&gt;
        &lt;tns:calcNextDateByDurationRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:Request&gt;
                    &lt;tns1:inputDate&gt;
                        &lt;xsl:value-of select="$VerificaDACLavorativoIn/parameters/tns2:VerificaDACLavorativoRequest/DAC"/&gt;
