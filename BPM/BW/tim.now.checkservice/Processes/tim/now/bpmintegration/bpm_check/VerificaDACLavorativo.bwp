            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaDACLavorativoIn&quot;/>&lt;xsl:param name=&quot;calcNextDateByDuration&quot;/>&lt;xsl:param name=&quot;Eito&quot;/>&lt;xsl:template name=&quot;VerificaDACLavorativoResponse&quot; match=&quot;/&quot;>&lt;tns:VerificaDACLavorativoResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;$calcNextDateByDuration/parameters/tns1:Response/tns1:outputDate = $VerificaDACLavorativoIn/parameters/tns:VerificaDACLavorativoRequest/DAC&quot;>&lt;Esito>&lt;Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/Codice>&lt;Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/Descrizione>&lt;/Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Esito>&lt;Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Eito =&amp;quot;FALSE&amp;quot;&quot;>&lt;Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&lt;/Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;($VerificaDACLavorativoIn/parameters/tns:VerificaDACLavorativoRequest/StrutturaRichiesta =&amp;quot;XDSL&amp;quot;  or  $VerificaDACLavorativoIn/parameters/tns:VerificaDACLavorativoRequest/StrutturaRichiesta =&amp;quot;NGA&amp;quot;)&quot;>&lt;Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&lt;/Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaDACLavorativoIn/parameters/tns:VerificaDACLavorativoRequest/StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot;&quot;>&lt;Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_03&amp;quot;&quot;/>&lt;/Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaDACLavorativoIn/parameters/tns:VerificaDACLavorativoRequest/Offerta ='NP'&quot;>&lt;Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_04&amp;quot;&quot;/>&lt;/Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&lt;/Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaDACLavorativoResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VerificaDACLavorativoResponse"
                    name="VerificaDACLavorativoResponseAssign"
