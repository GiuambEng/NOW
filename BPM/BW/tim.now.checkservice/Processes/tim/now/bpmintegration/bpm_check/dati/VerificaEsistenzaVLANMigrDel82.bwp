                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaEsistenzaVLANMigrDel82_Response&quot;/>&lt;xsl:param name=&quot;RecuperaCausaleEsitoMultiplo&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Offerta='SEMIVULAFTTH' and count($Oscuramento/Record[COD_AGESP='R1I-25-0151'])>0 and  ($Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='1' or $Oscuramento/Record[COD_AGESP='R1I-25-0151']/FLAG_OSCURMENTO='Y' )&quot;>&lt;tns1:VerificaEsistenzaVLANMigrDel82_Response>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:VerificaEsistenzaVLANMigrDel82_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANMigrDel82_Response/tns1:Codice=true()&quot;>&lt;xsl:copy-of select=&quot;$VerificaEsistenzaVLANMigrDel82_Response&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:VerificaEsistenzaVLANMigrDel82_Response>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANMigrDel82_Response/tns1:Codice&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANMigrDel82_Response/tns1:Descrizione&quot;/>&lt;/tns1:Descrizione>&lt;xsl:if test=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;>&lt;tns1:idAnagraficaCausale>&lt;xsl:value-of select=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;/>&lt;/tns1:idAnagraficaCausale>&lt;/xsl:if>&lt;xsl:copy-of select=&quot;$VerificaEsistenzaVLANMigrDel82_Response/tns1:vlan&quot;/>&lt;/tns1:VerificaEsistenzaVLANMigrDel82_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
