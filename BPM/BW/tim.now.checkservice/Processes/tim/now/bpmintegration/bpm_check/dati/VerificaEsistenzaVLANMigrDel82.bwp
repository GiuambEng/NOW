                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;GetInfoAnagVlan&quot;/>&lt;xsl:param name=&quot;tipologia&quot;/>&lt;xsl:param name=&quot;GetVLanOloInfo&quot;/>&lt;xsl:param name=&quot;GetInfoAnagVlan2&quot;/>&lt;xsl:template name=&quot;VerificaEsistenzaVLANMigrDel82_Response&quot; match=&quot;/&quot;>&lt;tns1:VerificaEsistenzaVLANMigrDel82_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;count($GetInfoAnagVlan/unknownResultset/row)=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan)) or count($GetInfoAnagVlan2/unknownResultset/row)=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE']) or exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE'])&quot;>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$tipologia]) or exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$tipologia])&quot;>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GetVLanOloInfo/unknownResultset/row)!=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan))&quot;>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;count($GetInfoAnagVlan/unknownResultset/row)=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan)) or count($GetInfoAnagVlan2/unknownResultset/row)=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan))&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE']) or exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE'])&quot;>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns1:Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$tipologia]) or exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$tipologia])&quot;>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO_03'&quot;/>&lt;/tns1:Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GetVLanOloInfo/unknownResultset/row)!=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan))&quot;>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO_04'&quot;/>&lt;/tns1:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns1:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;not( exists($GetInfoAnagVlan/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE'])) and not(exists($GetInfoAnagVlan/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$tipologia])) and count($GetInfoAnagVlan/unknownResultset/row)=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan)) and count($GetVLanOloInfo/unknownResultset/row)=count(distinct-values($Start/tns1:vlan/tns1:ServiceVlan))&quot;>&lt;xsl:for-each select=&quot;$Start/tns1:vlan&quot;>&lt;xsl:variable name=&quot;currentServiceVlan&quot; select=&quot;tns1:ServiceVlan&quot;/>&lt;tns1:vlan>&lt;tns1:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns1:IDDettaglioOrdine&quot;/>&lt;/tns1:IDDettaglioOrdine>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value)&quot;>&lt;tns1:TIPO_BANDA>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value&quot;/>&lt;/tns1:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value)&quot;>&lt;tns1:TIPO_COS>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value&quot;/>&lt;/tns1:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value)&quot;>&lt;tns1:FLAG_ENCAPSULATION>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value&quot;/>&lt;/tns1:FLAG_ENCAPSULATION>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='CLLI']/value)&quot;>&lt;tns1:CLLI>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='CLLI']/value&quot;/>&lt;/tns1:CLLI>&lt;/xsl:if>&lt;tns1:TIPOLOGIA>&lt;xsl:value-of select=&quot;$tipologia&quot;/>&lt;/tns1:TIPOLOGIA>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentServiceVlan and ./column/name='COD_VLAN']/column[./name='