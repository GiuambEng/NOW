            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogGetInfoAnagVlan-input"
                    name="LogGetInfoAnagVlan"
                    tibex:xpdlId="b23758f0-0c72-4954-a49d-0bdfe0f41700"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GetInfoAnagVlanToLogGetInfoAnagVlan"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogGetInfoAnagVlanToGetVLanOloInfo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($GetInfoAnagVlan/unknownResultset/row)=count(distinct-values($Start/ns0:vlan/ns0:ServiceVlan))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($GetInfoAnagVlan/unknownResultset/row)=count(distinct-values($Start/ns0:vlan/ns0:ServiceVlan))]]></bpws:transitionCondition>
                        </bpws:source>
