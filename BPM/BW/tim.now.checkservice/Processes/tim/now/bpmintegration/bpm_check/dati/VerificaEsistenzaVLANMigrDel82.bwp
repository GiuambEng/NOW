                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+050ad5ea-2e3a-426e-949a-a35ef332cc04+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;servicevlan&quot;/>&lt;xsl:template name=&quot;GetInfoAnagVlan2-input&quot; match=&quot;/&quot;>&lt;tns4:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_VLAN,STATO,TIPOLG,TIPO_BANDA,TIPO_COS,FLAG_ENCAPSULATION,CLLI,ID_TPLG_OPERATORE,COD_KIT,DSLAM_TYPE,TIPO_TRASPORTO,BMC_LIGHT,INTERMEDIATE_AGENT,TIPOLOGIACLUSTERVLAN,TIPOLOGIACLUSTERVLANOLD,CARATTERISTICAVLAN,FLAGFTTHONLY&amp;#xD;&amp;#xA;FROM ANAG_VLAN  &amp;#xD;&amp;#xA;WHERE  FLAG_VLAN_TRANSLATION ='Y' AND ID_VLAN_OLO IN ('&amp;quot;,$servicevlan,&amp;quot;')&amp;quot;)&quot;/>&lt;/statement>&lt;/tns4:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
