                    name="Assign"
                    outputVariable="VerificaabilitazionecontrattoMulticastMigrDel82_Response1"
                    tibex:xpdlId="18d2ff86-c408-44d3-9e08-53d2b8997be7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
