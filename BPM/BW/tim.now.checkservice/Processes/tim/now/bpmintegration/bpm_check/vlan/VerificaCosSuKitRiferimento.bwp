                        </bpws:source>
                        <bpws:source linkName="LogQueryToJDBCQuery_X123">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:SuperMacroArea=('1','2','3')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
