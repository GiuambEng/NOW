                        <bpws:source linkName="QueryCodTiplgCosToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9830df78-45ed-477f-b373-03cb0c5f1a27+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryNGA&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryGBE&quot;/>&lt;xsl:param name=&quot;QueryAnagAdr&quot;/>&lt;xsl:param name=&quot;QueryAnagAdr123&quot;/>&lt;xsl:param name=&quot;QueryAssMadrFis&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;QueryCodTiplgCos-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:SuperMacroArea='1'&quot;>&lt;ID_ADR_CRMWS_1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA']/ID_ADR_CRMWS)&quot;>&lt;xsl:value-of select=&quot;$QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA']/ID_ADR_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_1>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SuperMacroArea='2'&quot;>&lt;ID_ADR_CRMWS_1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_CC']/ID_ADR_CRMWS)&quot;>&lt;xsl:value-of select=&quot;$QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_CC']/ID_ADR_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_1>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:SuperMacroArea='3'&quot;>&lt;ID_ADR_CRMWS_1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_LIB']/ID_ADR_CRMWS)&quot;>&lt;xsl:value-of select=&quot;$QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_LIB']/ID_ADR_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_1>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:CC_LIB) and string-length($Start/tns:CC_LIB)>0 and $Start/tns:CC_LIB='CC' and ($Start/tns:SuperMacroArea='0' or string-length($Start/tns:SuperMacroArea)=0 or not(exists($Start/tns:SuperMacroArea)))&quot;>&lt;ID_ADR_CRMWS_1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryAssMadrFis/Record[1]/ROW_ID_ADR_CC)&quot;>&lt;xsl:value-of select=&quot;$QueryAssMadrFis/Record[1]/ROW_ID_ADR_CC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_1>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:CC_LIB) and string-length($Start/tns:CC_LIB)>0 and $Start/tns:CC_LIB='LIB' and ($Start/tns:SuperMacroArea='0' or string-length($Start/tns:SuperMacroArea)=0 or not(exists($Start/tns:SuperMacroArea)))&quot;>&lt;ID_ADR_CRMWS_1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryAssMadrFis/Record[1]/ROW_ID_ADR_LIB)&quot;>&lt;xsl:value-of select=&quot;$QueryAssMadrFis/Record[1]/ROW_ID_ADR_LIB&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ADR_CRMWS_1>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryAnagAdr/Record[1]/ID_MACROAREA)&quot;>&lt;xsl:value-of select=&quot;$QueryAnagAdr/Record[1]/ID_MACROAREA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_1>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLAN'&quot;>&lt;ID_ADR_CRMWS_2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryGBE/Record[1]/ID_ADR_CRMWS)&quot;>&lt;xsl:value-of select=&quot;$QueryGBE/Record[1]/ID_ADR_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_ADR_CRMWS_2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryNGA/Record[1]/ID_ADR_CRMWS)&quot;>&lt;xsl:value-of select=&quot;$QueryNGA/Record[1]/ID_ADR_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_ADR_CRMWS_2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODICE_KIT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:CodiceTdKit)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:CodiceTdKit&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_KIT>&lt;CODICE_CAR>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:IdentificativoCar)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:IdentificativoCar&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICE_CAR>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLAN' and $Start/tns:FamigliaVLAN='1'&quot;>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;'%Aggregato GBE%'&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA' and $Start/tns:FamigliaVLAN='1'&quot;>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;'%Aggregato NGA%'&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLAN' and $Start/tns:FamigliaVLAN='2'&quot;>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;'%Aggregato GBE BMC%'&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA' and $Start/tns:FamigliaVLAN='2' and count($Oscuramento/Record[COD_AGESP='VERIFICA_NGA_BMC '])>0&quot;>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;'%Aggregato NGA BMC%'&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA' and $Start/tns:FamigliaVLAN='2' and count($Oscuramento/Record[COD_AGESP='VERIFICA_NGA_BMC '])=0&quot;>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;'%%'&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLAN' and $Start/tns:FamigliaVLAN='3'&quot;>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;'%Aggregato GBE BMD%'&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA' and $Start/tns:FamigliaVLAN='3'&quot;>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;'%Aggregato NGA BMD%'&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NOME_AGGREGATO>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/NOME_AGGREGATO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_TIPOLOGIA_COS&#xa;FROM TIPOLOGIA_COS&#xa;WHERE ID_TIPOLOGIA_COS IN (SELECT ID_TIPOLOGIA_COS&#xa;FROM ANAGRAFICA_KIT_VLAN_ADR_CAR&#xa;WHERE ID_ADR_CRMWS IN (?,?) AND CODICE_KIT=? AND CODICE_CAR=? AND NOME_AGGREGATO LIKE ?)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ADR_CRMWS_1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ADR_CRMWS_2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_KIT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_CAR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_AGGREGATO"/>
                                    <columnMetadata
                                    columnName="CODICE_TIPOLOGIA_COS"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCodTiplgCos-input"
                    name="LogCodTiplgCos"
                    tibex:xpdlId="80f37469-6039-493c-a228-f9244f5c25e0"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="QueryCodTiplgCosToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCodTiplgCosToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryCodTiplgCos&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCodTiplgCos-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaCosSuKitRiferimento'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaOlo&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Recuperati seguenti codici tipologia cos: ',tib:render-xml($QueryCodTiplgCos))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="1f4bb252-6391-409f-8973-f6ea4f4f3569">
                <bpws:targets>
                    <bpws:target linkName="LogCodTiplgCosToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= $counter and $Esito = false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= $counter and $Esito = false()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="EsitoToCopy_1_LogAssMadrFis" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Copy_1_LogAssMadrFisToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="f6a5fd38-f4c3-4453-9706-d038563ef9bb">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="342482e3-fb7c-4261-962c-377dedd11317">
                                <bpws:targets>
                                    <bpws:target linkName="Copy_1_LogAssMadrFisToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Esito" name="Esito"
                                    outputVariable="Esito"
                                    tibex:xpdlId="34a08840-4560-438c-bf8a-1de883c78e67" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="EsitoToCopy_1_LogAssMadrFis"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if ($Start/ns0:FamigliaVLAN='1') then (if (exists($QueryCodTiplgCos/Record[CODICE_TIPOLOGIA_COS=$Start/ns0:IdentificaticoCos[number($index)]])) then true() else false()) &#xd;&#xa;else if ($Start/ns0:FamigliaVLAN='2') then (if (exists($QueryCodTiplgCos/Record[CODICE_TIPOLOGIA_COS='BMC'])) then true() else false()) &#xd;&#xa;else &#xd;&#xa;(if (exists($QueryCodTiplgCos/Record[CODICE_TIPOLOGIA_COS='BMD'])) then true() else false())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogEsito-input"
                                    name="LogEsito"
                                    tibex:xpdlId="fc70f94e-7212-4dde-a790-acac73c6a76e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EsitoToCopy_1_LogAssMadrFis"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Copy_1_LogAssMadrFisToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Esito&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;counter&quot;/>&#xa;    &lt;xsl:template name=&quot;LogEsito-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaCosSuKitRiferimento'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaOlo&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('LogCounter: ',xsd:string($counter),' - LogEsito per index :',xsd:string($index),&amp;quot; - &amp;quot;,xsd:string($Esito))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryAnagAdr-input"
                    name="QueryAnagAdr" outputVariable="QueryAnagAdr"
                    tibex:xpdlId="dc4efc98-a464-48df-bc33-14c39b3f97a2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQueryToJDBCQuery1_X0"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="QueryAnagAdrToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
