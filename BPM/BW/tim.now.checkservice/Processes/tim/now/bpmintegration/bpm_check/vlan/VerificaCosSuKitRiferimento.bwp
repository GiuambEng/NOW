                                    sqlStatement="SELECT FLAG_OSCURMENTO,COD_AGESP from OSCURAMENTO_AGESP WHERE COD_AGESP IN ('R1I-20-0150', 'VERIFICA_NGA_BMC' ) AND FLAG_OSCURMENTO='1'" xsi:type="jdbcPalette:JDBCQueryActivity">
