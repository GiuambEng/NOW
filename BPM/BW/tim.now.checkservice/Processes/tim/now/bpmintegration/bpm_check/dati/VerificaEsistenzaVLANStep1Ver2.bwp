                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLivel&quot;/>&#xa;    &lt;xsl:param name=&quot;Step1Request&quot;/>&#xa;    &lt;xsl:template name=&quot;LogAssignAbstractRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaEsistenzaVLANStep1Ver2&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLAN'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Assign abstractRequest result: &amp;quot;, tib:render-xml($Step1Request, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLivel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="CheckRespInter" tibex:xpdlId="eb5b0a87-b3fe-4264-8d25-00d7435f693b">
                <bpws:targets>
                    <bpws:target linkName="LogAssignRespIntermediaToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckRespInterToLogAssignResponse">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Step1Response/tns:Descrizione!='KO - Occorrenza/e non trovate su ANAG_VLAN ricercando per COD_VLAN'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Step1Response/tns:Descrizione!='KO - Occorrenza/e non trovate su ANAG_VLAN ricercando per COD_VLAN']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckRespInterToSQLDirect">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GetInfoAnagVlan2-input"
                    name="GetInfoAnagVlan2"
                    outputVariable="GetInfoAnagVlan2"
                    tibex:xpdlId="069661e6-9b97-43d3-8e8e-d8db82bf620a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckRespInterToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GetInfoAnagVlan2ToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+069661e6-9b97-43d3-8e8e-d8db82bf620a+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SCodeOrCodVlan&quot;/>&lt;xsl:template name=&quot;GetInfoAnagVlan2-input&quot; match=&quot;/&quot;>&lt;tns1:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_VLAN,STATO,TIPOLG,TIPO_BANDA,TIPO_COS,FLAG_ENCAPSULATION,CLLI,ID_TPLG_OPERATORE,COD_KIT,DSLAM_TYPE,TIPO_TRASPORTO,BMC_LIGHT,INTERMEDIATE_AGENT,TIPOLOGIACLUSTERVLAN,TIPOLOGIACLUSTERVLANOLD,CARATTERISTICAVLAN,FLAGFTTHONLY&amp;#xD;&amp;#xA;FROM ANAG_VLAN  &amp;#xD;&amp;#xA;WHERE  FLAG_VLAN_TRANSLATION ='Y' AND ID_VLAN_OLO IN ('&amp;quot;,$SCodeOrCodVlan,&amp;quot;')&amp;quot;)&quot;/>&lt;/statement>&lt;/tns1:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Step1Response"
                    name="AssignResponse" outputVariable="Step1Response"
                    tibex:xpdlId="7cf55a60-9470-4411-8fab-6b6228aa69b0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToAssignResponse"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignResponseToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Step1Request&quot;/>&lt;xsl:param name=&quot;Tipologia&quot;/>&lt;xsl:param name=&quot;GetInfoAnagVlan2&quot;/>&lt;xsl:template name=&quot;Step1Response&quot; match=&quot;/&quot;>&lt;tns:VerificaEsistenzaVLANResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;not( exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE'])) and not(exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$Tipologia])) and count($GetInfoAnagVlan2/unknownResultset/row)=count(distinct-values($Step1Request/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;xsl:for-each select=&quot;$Step1Request/tns:AbstractUservVlan&quot;>&lt;xsl:variable name=&quot;currentSvulanCodeOrCodeVlanSingleTag&quot; select=&quot;tns:CodVlanSingleTagOrSvulanCode&quot;/>&lt;tns:VLAN>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IdDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value)&quot;>&lt;tns:TIPO_BANDA>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value&quot;/>&lt;/tns:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value)&quot;>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value&quot;/>&lt;/tns:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value)&quot;>&lt;tns:FLAG_ENCAPSULATION>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value&quot;/>&lt;/tns:FLAG_ENCAPSULATION>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value)&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;tns:TIPOLOGIA>&lt;xsl:value-of select=&quot;$Tipologia&quot;/>&lt;/tns:TIPOLOGIA>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value)&quot;>&lt;tns:CODICE_KIT>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value&quot;/>&lt;/tns:CODICE_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='DSLAM_TYPE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='DSLAM_TYPE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='DSLAM_TYPE']/value)&quot;>&lt;tns:DSLAM_TYPE>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='DSLAM_TYPE']/value&quot;/>&lt;/tns:DSLAM_TYPE>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMD']/value)&quot;>&lt;tns:BMD>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMD']/value&quot;/>&lt;/tns:BMD>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_TRASPORTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_TRASPORTO']/value)&quot;>&lt;tns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_TRASPORTO']/value&quot;/>&lt;/tns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='ID_TPLG_OPERATORE']/value) and string-length(string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='ID_TPLG_OPERATORE']/value)) > 0&quot;>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='ID_TPLG_OPERATORE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='ID_TPLG_OPERATORE']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='ID_TPLG_OPERATORE']/value)&quot;>&lt;tns:CodiceOperatoreRete>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='ID_TPLG_OPERATORE']/value&quot;/>&lt;/tns:CodiceOperatoreRete>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMC_LIGHT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMC_LIGHT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMC_LIGHT']/value)&quot;>&lt;tns:BMC_LIGHT>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='BMC_LIGHT']/value&quot;/>&lt;/tns:BMC_LIGHT>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='INTERMEDIATE_AGENT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='INTERMEDIATE_AGENT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='INTERMEDIATE_AGENT']/value)&quot;>&lt;tns:INTERMEDIATE_AGENT>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='INTERMEDIATE_AGENT']/value&quot;/>&lt;/tns:INTERMEDIATE_AGENT>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLAN']/value)&quot;>&lt;tns:TIPOLOGIA_CLUSTER_VLAN>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLAN']/value&quot;/>&lt;/tns:TIPOLOGIA_CLUSTER_VLAN>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLANOLD']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLANOLD']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLANOLD']/value)&quot;>&lt;tns:TIPOLOGIA_CLUSTER_VLAN_OLD>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPOLOGIACLUSTERVLANOLD']/value&quot;/>&lt;/tns:TIPOLOGIA_CLUSTER_VLAN_OLD>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAGFTTHONLY']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAGFTTHONLY']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAGFTTHONLY']/value)&quot;>&lt;tns:FLAG_FTTH_ONLY>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAGFTTHONLY']/value&quot;/>&lt;/tns:FLAG_FTTH_ONLY>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CARATTERISTICAVLAN']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CARATTERISTICAVLAN']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CARATTERISTICAVLAN']/value)&quot;>&lt;tns:CARATTERISTICAVLAN>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan2/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CARATTERISTICAVLAN']/value&quot;/>&lt;/tns:CARATTERISTICAVLAN>&lt;/xsl:if>&lt;/tns:VLAN>&lt;/xsl:for-each>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE'])&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$Tipologia])&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GetInfoAnagVlan2/unknownResultset/row)&amp;lt;count(distinct-values($Step1Request/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE'])&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO - Esiste almeno una UservVlan in stato INACTIVE su ANAG_VLAN'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($GetInfoAnagVlan2/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$Tipologia])&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO - Esiste almeno una UservVlan che ha TIPOLG su ANAG_VLAN differente dall'offerta in input&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;count($GetInfoAnagVlan2/unknownResultset/row)&amp;lt;count(distinct-values($Step1Request/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO - Occorrenza/e non trovate su ANAG_VLAN ricercando per ID_VLAN_OLO'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaEsistenzaVLANResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
