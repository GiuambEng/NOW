                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Step1Request&quot; match=&quot;/&quot;>&lt;tns:Step1Request>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns:IdRichiestaOLO>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns:IdRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;tns:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;$Start/tns:CodiceOLOAGCOM&quot;/>&lt;/tns:CodiceOLOAGCOM>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/tns:Offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:NGA-VULA)&quot;>&lt;xsl:for-each select=&quot;$Start/tns:NGA-VULA/tns:UserVlan&quot;>&lt;tns:AbstractUservVlan>&lt;tns:IdDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IdDettaglioOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodeVlanSingleTag&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:SVlanCode&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodiciVLAN)&quot;>&lt;xsl:if test=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;>&lt;tns:CVLAN_ID>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;/>&lt;/tns:CVLAN_ID>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:AbstractUservVlan>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$Start/tns:GBE/tns:VC&quot;>&lt;tns:AbstractUservVlan>&lt;tns:IdDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IdDettaglioOrdine>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IsSingleTag>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:IsSingleTag>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodeVlanSingleTag)&quot;>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodeVlanSingleTag&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CodVlanSingleTagOrSvulanCode>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:SVlanCode&quot;/>&lt;/tns:CodVlanSingleTagOrSvulanCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists(tns:CodiciVLAN)&quot;>&lt;xsl:if test=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;>&lt;tns:CVLAN_ID>&lt;xsl:value-of select=&quot;tns:CodiciVLAN/tns:CVLAN_ID&quot;/>&lt;/tns:CVLAN_ID>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;/tns:AbstractUservVlan>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Step1Request>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Step1Request" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Tipologia"
                    name="AssignTipologia" outputVariable="Tipologia"
                    tibex:xpdlId="b6596674-751b-44f4-b913-d47a331d1e22" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToAssignTipologia"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignTipologiaToAssign11"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(contains($Step1Request/tns:Offerta,'GBE')) then 'GBE' else if(contains($Step1Request/tns:Offerta,'VULA') or $Step1Request/tns:Offerta='FULLGPONPLUS') then 'VULA' else 'NGA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Tipologia" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SCodeOrCodVlan"
                    name="AssignCodes" outputVariable="SCodeOrCodVlan"
                    tibex:xpdlId="02e02cb4-e17a-4e1d-8a2d-266577d14ebb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignTipologiaToAssign11"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignCodesToSQLDirect"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="tib:concat-sequence-format($Step1Request/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode,&quot;','&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="SCodeOrCodVlan" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="GetInfoAnagVlan-input"
                    name="GetInfoAnagVlan"
                    outputVariable="GetInfoAnagVlan"
                    tibex:xpdlId="60dca652-b3ad-4572-bcd2-eb5f697c9c63" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignCodesToSQLDirect"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+60dca652-b3ad-4572-bcd2-eb5f697c9c63+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SCodeOrCodVlan&quot;/>&lt;xsl:template name=&quot;GetInfoAnagVlan-input&quot; match=&quot;/&quot;>&lt;tns2:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_VLAN,STATO,TIPOLG,TIPO_BANDA,TIPO_COS,FLAG_ENCAPSULATION,CLLI,ID_TPLG_OPERATORE,COD_KIT,DSLAM_TYPE,TIPO_TRASPORTO,BMC_LIGHT,INTERMEDIATE_AGENT,TIPOLOGIACLUSTERVLAN,TIPOLOGIACLUSTERVLANOLD,CARATTERISTICAVLAN,FLAGFTTHONLY&amp;#xD;&amp;#xA;FROM ANAG_VLAN  &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;COD_VLAN IN ('&amp;quot;,$SCodeOrCodVlan,&amp;quot;')&amp;quot;)&quot;/>&lt;/statement>&lt;/tns2:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeOut"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogGetInfoAnagVlan-input"
                    name="LogGetInfoAnagVlan"
                    tibex:xpdlId="45c70ce1-6db0-4809-b8d7-e27888a61f07"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SQLDirectToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogGetInfoAnagVlanToAssign11"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerLivel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;GetInfoAnagVlan&quot;/>&#xa;    &lt;xsl:template name=&quot;LogGetInfoAnagVlan-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaEsistenzaVLANStep1Ver2&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLAN'&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;GetInfoAnagVlan result:&amp;quot;, tib:render-xml($GetInfoAnagVlan, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerLivel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Step1Response"
                    name="AssignRespIntermedia"
                    outputVariable="Step1Response"
                    tibex:xpdlId="0b17c6c6-49ff-4397-b569-de9f82513c59" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogGetInfoAnagVlanToAssign11"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignResponse_1ToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Step1Request&quot;/>&lt;xsl:param name=&quot;Tipologia&quot;/>&lt;xsl:param name=&quot;GetInfoAnagVlan&quot;/>&lt;xsl:template name=&quot;Step1Response&quot; match=&quot;/&quot;>&lt;tns:VerificaEsistenzaVLANResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;not( exists($GetInfoAnagVlan/unknownResultset/row/column[./name='STATO' and upper-case(string(./value))='INACTIVE'])) and not(exists($GetInfoAnagVlan/unknownResultset/row/column[./name='TIPOLG' and upper-case(string(./value))!=$Tipologia])) and count($GetInfoAnagVlan/unknownResultset/row)=count(distinct-values($Step1Request/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;xsl:for-each select=&quot;$Step1Request/tns:AbstractUservVlan&quot;>&lt;xsl:variable name=&quot;currentSvulanCodeOrCodeVlanSingleTag&quot; select=&quot;tns:CodVlanSingleTagOrSvulanCode&quot;/>&lt;tns:VLAN>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IdDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value)&quot;>&lt;tns:TIPO_BANDA>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_BANDA']/value&quot;/>&lt;/tns:TIPO_BANDA>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value)&quot;>&lt;tns:TIPO_COS>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='TIPO_COS']/value&quot;/>&lt;/tns:TIPO_COS>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value)&quot;>&lt;tns:FLAG_ENCAPSULATION>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='FLAG_ENCAPSULATION']/value&quot;/>&lt;/tns:FLAG_ENCAPSULATION>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value)&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='CLLI']/value&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;tns:TIPOLOGIA>&lt;xsl:value-of select=&quot;$Tipologia&quot;/>&lt;/tns:TIPOLOGIA>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value)&quot;>&lt;tns:CODICE_KIT>&lt;xsl:value-of select=&quot;$GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='COD_KIT']/value&quot;/>&lt;/tns:CODICE_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./name='DSLAM_TYPE']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($GetInfoAnagVlan/unknownResultset/row[./column/value=$currentSvulanCodeOrCodeVlanSingleTag and ./column/name='COD_VLAN']/column[./n