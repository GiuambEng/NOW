InfoAnagVlan/unknownResultset/row)&amp;lt;count(distinct-values($Step1Request/tns:AbstractUservVlan/tns:CodVlanSingleTagOrSvulanCode))&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO - Occorrenza/e non trovate su ANAG_VLAN ricercando per COD_VLAN'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaEsistenzaVLANResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
