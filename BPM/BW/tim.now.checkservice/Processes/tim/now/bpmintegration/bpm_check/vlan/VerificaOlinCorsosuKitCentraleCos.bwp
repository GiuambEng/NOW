                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToLogOrdiniIDENTIFICATIVOCOS"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+150ffbf2-fe83-4859-ba7c-c8dec61461ef+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryOlInCorso-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Offerta,&amp;quot;NGA&amp;quot;)&quot;>&lt;NOMECOMPONENTE>&lt;xsl:value-of select=&quot;'RACCOLTAVLANNGA'&quot;/>&lt;/NOMECOMPONENTE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NOMECOMPONENTE>&lt;xsl:value-of select=&quot;'RACCOLTAVLANGBE'&quot;/>&lt;/NOMECOMPONENTE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODICETDKIT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceTdKit)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceTdKit&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICETDKIT>&lt;CODICECLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceClli)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceClli&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICECLLI>&lt;IDENTIFICATIVOCOS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdentificativoCos)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdentificativoCos&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDENTIFICATIVOCOS>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT  R.IDRICHIESTAOLO&#xa;  FROM APPUSER.BDS_1_CASEDATA_RICHIESTA       R,&#xa;       APPUSER.BDS_1_CASEDATA_ORDINE          O,&#xa;       APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE DETTAGLIOORDINE,&#xa;       APPUSER.BDS_1_CASEDATA_DETTAGLIOORDINE DETTAGLIOORDINE2,&#xa;       APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE,&#xa;       APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE2,&#xa;       APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLRDN ATTRIBUTOORDINE3&#xa; WHERE R.IDRICHIESTAOLO = O.IDRICHIESTAOLO&#xa;   AND O.BDS_ID = DETTAGLIOORDINE.ORDINE_DETTAGLIOORDINE_BDSID&#xa;   AND O.BDS_ID = DETTAGLIOORDINE2.ORDINE_DETTAGLIOORDINE_BDSID&#xa;   AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;   AND DETTAGLIOORDINE.BDS_ID = ATTRIBUTOORDINE2.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;   AND DETTAGLIOORDINE2.BDS_ID = ATTRIBUTOORDINE3.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID&#xa;   AND R.STATORICHIESTANOW NOT IN ('SCARTATO','SCARTATOB2B','ESPLETAMENTOTECNICOKO','ANNULLATO','ANNULLATOB2B','CHIUSO','CHIUSOB2B','FATTURAZIONEKO','ESPLETAMENTOTECNICO','ESPLETAMENTOTECNICOB2B','INVIATOAFATTURAZIONE')&#xa;   AND O.OFFERTA IN ('VLAN','VLANNGA')&#xa;   AND DETTAGLIOORDINE.NOMECOMPONENTE = ?&#xa;   AND ATTRIBUTOORDINE.NOMEATTRIBUTO = 'CODICETDKIT'&#xa;   AND ATTRIBUTOORDINE2.NOMEATTRIBUTO = 'CODICECLLI'&#xa;   AND DETTAGLIOORDINE2.NOMECOMPONENTE = 'TIPOCOS'&#xa;   AND ATTRIBUTOORDINE3.NOMEATTRIBUTO = 'IDENTIFICATIVOCOS'&#xa;   AND ATTRIBUTOORDINE.VALOREATTRIBUTO = ? --CODICETDKIT&#xa;   AND ATTRIBUTOORDINE2.VALOREATTRIBUTO = ? --CODICECLLI&#xa;   AND ATTRIBUTOORDINE3.VALOREATTRIBUTO = ? --IDENTIFICATIVOCOS" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOMECOMPONENTE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICETDKIT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICECLLI"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDENTIFICATIVOCOS"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
