                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+150ffbf2-fe83-4859-ba7c-c8dec61461ef+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQueryOlInCorso-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($Start/tns1:Offerta,&amp;quot;NGA&amp;quot;)&quot;>&lt;NOMECOMPONENTE>&lt;xsl:value-of select=&quot;'RACCOLTAVLANNGA'&quot;/>&lt;/NOMECOMPONENTE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NOMECOMPONENTE>&lt;xsl:value-of select=&quot;'RACCOLTAVLANGBE'&quot;/>&lt;/NOMECOMPONENTE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;CODICETDKIT>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceTdKit)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceTdKit&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICETDKIT>&lt;CODICECLLI>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceClli)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceClli&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODICECLLI>&lt;IDENTIFICATIVOCOS>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdentificativoCos)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdentificativoCos&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDENTIFICATIVOCOS>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
