                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificacompatibilitàPNRRMigrDel82&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:VerificacompatibilitàPNRRMigrDel82_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$VerificacompatibilitàPNRRMigrDel82/tns:Esito/tns:Codice&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$VerificacompatibilitàPNRRMigrDel82/tns:Esito/tns:Descrizione&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificacompatibilitàPNRRMigrDel82_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
