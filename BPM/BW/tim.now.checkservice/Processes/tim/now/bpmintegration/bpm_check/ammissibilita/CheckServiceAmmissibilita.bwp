                                    tibex:xpdlId="e45c2e48-ea9d-44ff-b2a5-a3070f16fa45" variable="ReplyFault-input">
                                    <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/" xmlns:tns="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="FaultDetails"/&gt;
    &lt;xsl:template name="ReplyFault-input" match="/"&gt;
        &lt;tns1:VerificaCompatibilitaLavorazioneFault&gt;
            &lt;fault&gt;
                &lt;tns:Verifica_Compatibilita_Lavorazione_Fault&gt;
                    &lt;tns:Fault&gt;
                        &lt;tns:Codice_Errore&gt;
                            &lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;
                        &lt;/tns:Codice_Errore&gt;
                        &lt;tns:Messaggio_Errore&gt;
                            &lt;xsl:value-of select="tib:render-xml($FaultDetails)"/&gt;
                        &lt;/tns:Messaggio_Errore&gt;
                    &lt;/tns:Fault&gt;
                &lt;/tns:Verifica_Compatibilita_Lavorazione_Fault&gt;
            &lt;/fault&gt;
        &lt;/tns1:VerificaCompatibilitaLavorazioneFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                    <tibex:inputBindings>
