                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$Lock_UnlockRisorsa/parameters/tns:Lock_UnlockRisorsaRequest/tns:CODIFICA_OLO_AGICOM"&gt;
                        &lt;tns4:CODIFICA_OLO_AGICOM&gt;
