:SubAppalto&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($GestAutPA/Record[COD_IMPRESA=$Start/tns:SystemUnico])"&gt;&lt;xsl:if test="$GestAutPA/Record[COD_IMPRESA=$Start/tns:SystemUnico]/DESCR_TIPOLOGIA_IMPRESA"&gt;&lt;tns6:DescrizioneTipologiaImpresa&gt;&lt;xsl:value-of select="$GestAutPA/Record[COD_IMPRESA=$Start/tns:SystemUnico]/DESCR_TIPOLOGIA_IMPRESA"/&gt;&lt;/tns6:DescrizioneTipologiaImpresa&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$GestAutPA/Record[DESCR_TIPOLOGIA_IMPRESA='OPSYSC3']/DESCR_TIPOLOGIA_IMPRESA"&gt;&lt;tns6:DescrizioneTipologiaImpresa&gt;&lt;xsl:value-of select="$GestAutPA/Record[DESCR_TIPOLOGIA_IMPRESA='OPSYSC3']/DESCR_TIPOLOGIA_IMPRESA"/&gt;&lt;/tns6:DescrizioneTipologiaImpresa&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns6:LavorazioneRichiesta&gt;&lt;/tns6:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns5:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
