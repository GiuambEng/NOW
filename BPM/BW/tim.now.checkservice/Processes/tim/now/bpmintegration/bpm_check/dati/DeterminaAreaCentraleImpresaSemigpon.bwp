of select=&quot;$GestAutPA/Record[COD_IMPRESA=$Start/tns:SystemUnico]/COD_IMPRESA&quot;/>&#xa;                            &lt;/tns6:ImpresaAreaDiCentrale>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$GestAutPA/Record[DESCR_TIPOLOGIA_IMPRESA='OPSYSC3']/COD_IMPRESA&quot;>&#xa;                            &lt;tns6:ImpresaAreaDiCentrale>&#xa;                                &lt;xsl:value-of select=&quot;$GestAutPA/Record[DESCR_TIPOLOGIA_IMPRESA='OPSYSC3']/COD_IMPRESA&quot;/>&#xa;                            &lt;/tns6:ImpresaAreaDiCentrale>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;exists($GestAutPA2/Record)&quot;>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:SubAppalto&quot;>&#xa;                        &lt;tns6:SubAppalto>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:SubAppalto&quot;/>&#xa;                        &lt;/tns6:SubAppalto>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GestAutPA/Record[COD_IMPRESA=$Start/tns:SystemUnico])&quot;>&#xa;                        &lt;xsl:if test=&quot;$GestAutPA/Record[COD_IMPRESA=$Start/tns:SystemUnico]/DESCR_TIPOLOGIA_IMPRESA&quot;>&#xa;                            &lt;tns6:DescrizioneTipologiaImpresa>&#xa;                                &lt;xsl:value-of select=&quot;$GestAutPA/Record[COD_IMPRESA=$Start/tns:SystemUnico]/DESCR_TIPOLOGIA_IMPRESA&quot;/>&#xa;                            &lt;/tns6:DescrizioneTipologiaImpresa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$GestAutPA/Record[DESCR_TIPOLOGIA_IMPRESA='OPSYSC3']/DESCR_TIPOLOGIA_IMPRESA&quot;>&#xa;                            &lt;tns6:DescrizioneTipologiaImpresa>&#xa;                                &lt;xsl:value-of select=&quot;$GestAutPA/Record[DESCR_TIPOLOGIA_IMPRESA='OPSYSC3']/DESCR_TIPOLOGIA_IMPRESA&quot;/>&#xa;                            &lt;/tns6:DescrizioneTipologiaImpresa>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns6:LavorazioneRichiesta>&#xa;        &lt;/tns6:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
