                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+10b49755-77d7-41f8-a452-c25a9d273322+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;AnagraficaGpon&quot;/>&lt;xsl:template name=&quot;GestAutPA2-input&quot; match=&quot;/&quot;>&lt;tns4:jdbcQueryActivityInput>&lt;codficaoloagcom>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:CodOLOAgcom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:CodOLOAgcom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/codficaoloagcom>&lt;cod_area_di_centr>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($AnagraficaGpon/Record[1]/CODICE_AREA_CENTRALE)&quot;>&lt;xsl:value-of select=&quot;$AnagraficaGpon/Record[1]/CODICE_AREA_CENTRALE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/cod_area_di_centr>&lt;cod_impresa>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:SubAppalto)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:SubAppalto&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/cod_impresa>&lt;/tns4:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
