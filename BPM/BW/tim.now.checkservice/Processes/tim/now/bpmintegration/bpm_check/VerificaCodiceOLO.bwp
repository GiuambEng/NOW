ON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR') and (starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;GPON&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM)) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;NEWGPON&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM)))&quot;>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:Verifica_Codice_OLO_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;not($VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:Offerta=('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')) and starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;nga_&amp;quot;, $SelectNomeOLO/Record[1]/COD_OLO))&quot;>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:Verifica_Codice_OLO_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;xsl:if test=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns1:CodiceOlodaFile>&lt;xsl:value-of select=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns1:CodiceOlodaFile>&lt;/xsl:if>&lt;/tns1:Verifica_Codice_OLO_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;adsl_&amp;quot;, $SelectNomeOLO/Record[1]/COD_OLO))&quot;>&lt;tns1:Verifica_Codice_OLO_Response>