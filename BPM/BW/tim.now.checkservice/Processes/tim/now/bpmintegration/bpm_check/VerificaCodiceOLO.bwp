                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaCodiceOLOIn&quot;/>&lt;xsl:param name=&quot;SelectNomeFile&quot;/>&lt;xsl:param name=&quot;SelectNomeOLO&quot;/>&lt;xsl:template name=&quot;VerificaCodiceOLOResponse&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists($SelectNomeFile/Record)) or not(exists($SelectNomeOLO/Record))&quot;>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;xsl:if test=&quot;string-length($SelectNomeFile/Record[1]/CODFC_OLO_AGCOM)&quot;>&lt;xsl:if test=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns1:CodiceOlodaFile>&lt;xsl:value-of select=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns1:CodiceOlodaFile>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns1:Verifica_Codice_OLO_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($SelectNomeFile/Record[1]/NOME_FILE, 'MIGRAZIONE_ULL_SLU')&quot;>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:Verifica_Codice_OLO_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:Offerta='CPS' and $VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:Lavorazione='PRENOTIFICADISATTIVAZIONECPS' and $VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:CodiceOLOAGCOM='TLC' and starts-with($SelectNomeFile/Record[1]/NOME_FILE, 'WIN')&quot;>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:Verifica_Codice_OLO_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:StrutturaRichiesta = &amp;quot;REGOLATORIO&amp;quot; or $VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:StrutturaRichiesta = &amp;quot;FIBERSTREAM&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($SelectNomeFile/Record[1]/NOME_FILE, $VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:CodiceOLOAGCOM) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;N_&amp;quot;, $VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:CodiceOLOAGCOM)) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;R_&amp;quot;, $VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:CodiceOLOAGCOM))  or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;FBS_&amp;quot;, $VerificaCodiceOLOIn/parameters/tns2:VerificaCodiceOLO/tns1:CodiceOLOAGCOM))&quot;>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/tns1:Verifica_Codice_OLO_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Verifica_Codice_OLO_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;xsl:if test=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns1:CodiceOlodaFile>&lt;xsl:value-of select=&quot;$SelectNomeFile/Record[1]/CODF