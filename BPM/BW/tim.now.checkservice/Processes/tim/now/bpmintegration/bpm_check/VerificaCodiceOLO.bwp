rificaCodiceOLOIn.parameters/tns1:CodiceOLOAGCOM)) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;R_&amp;quot;, $VerificaCodiceOLOIn.parameters/tns1:CodiceOLOAGCOM))  or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;FBS_&amp;quot;, $VerificaCodiceOLOIn.parameters/tns1:CodiceOLOAGCOM))&quot;>&#xa;                        &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;tns1:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns1:Codice>&#xa;                                &lt;tns1:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns1:Descrizione>&#xa;                            &lt;/tns1:Esito>&#xa;                        &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;tns1:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns1:Codice>&#xa;                                &lt;tns1:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns1:Descrizione>&#xa;                            &lt;/tns1:Esito>&#xa;                            &lt;xsl:if test=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                                &lt;tns1:CodiceOlodaFile>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                &lt;/tns1:CodiceOlodaFile>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$VerificaCodiceOLOIn.parameters/tns1:StrutturaRichiesta = &amp;quot;NPG&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;R_NP_&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM)) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;N_NP_&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM)) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;T3_R_NP_&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM)) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;T3_N_NP_&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM))&quot;>&#xa;                                &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                    &lt;xsl:if test=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                                        &lt;tns1:CodiceOlodaFile>&#xa;                                            &lt;xsl:value-of select=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                        &lt;/tns1:CodiceOlodaFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$VerificaCodiceOLOIn.parameters/tns1:StrutturaRichiesta = &amp;quot;NGA&amp;quot;&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$VerificaCodiceOLOIn.parameters/tns1:Offerta=('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR') and (starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;GPON&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM)) or starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;NEWGPON&amp;quot;, $SelectNomeOLO/Record[1]/CODFC_OLO_AGCOM)))&quot;>&#xa;                                &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;not($VerificaCodiceOLOIn.parameters/tns1:Offerta=('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR')) and starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;nga_&amp;quot;, $SelectNomeOLO/Record[1]/COD_OLO))&quot;>&#xa;                                &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                    &lt;xsl:if test=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                                        &lt;tns1:CodiceOlodaFile>&#xa;                                            &lt;xsl:value-of select=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                        &lt;/tns1:CodiceOlodaFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;starts-with($SelectNomeFile/Record[1]/NOME_FILE, concat(&amp;quot;adsl_&amp;quot;, $SelectNomeOLO/Record[1]/COD_OLO))&quot;>&#xa;                                &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:Verifica_Codice_OLO_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                    &lt;xsl:if test=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                                        &lt;tns1:CodiceOlodaFile>&#xa;                                            &lt;xsl:value-of select=&quot;$SelectNomeFile/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                                        &lt;/tns1:CodiceOlodaFile>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns1:Verifica_Codice_OLO_Response>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
