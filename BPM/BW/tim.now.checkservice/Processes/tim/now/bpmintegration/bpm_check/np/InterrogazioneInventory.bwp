            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns1=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke&quot;/>&lt;xsl:param name=&quot;DistrettoRipetitivo&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;InterrogazioneInventoryIn&quot;/>&lt;xsl:template name=&quot;OutputEsito&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:header/tns1:esito = (&amp;quot;01&amp;quot;,&amp;quot;02&amp;quot;,&amp;quot;03&amp;quot;,&amp;quot;04&amp;quot;) or ($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:FlagCautelare = &amp;quot;Y&amp;quot; and starts-with($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:tipologiaScenario, &amp;quot;NPSUWLR&amp;quot;) and (not(exists($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero)) or string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero) = 0 or not(exists($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio)) or string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio) = 0))&quot;>&lt;tns:Interrogazione_Inventory_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:Interrogazione_Inventory_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:header/tns1:esito = &amp;quot;00&amp;quot;)&quot;>&lt;tns:Interrogazione_Inventory_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;tns:CRMWSResponse>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:donating) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:donating&quot;>&lt;tns:Donating>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:donating&quot;/>&lt;/tns:Donating>&lt;/xsl:if>&lt;/xsl:if>&lt;tns:Flag_Attivo>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:flag_Attivo&quot;/>&lt;/tns:Flag_Attivo>&lt;xsl:if test=&quot;exists($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea) and exists($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP) and exists($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flg_num_servizio)&quot;>&lt;tns:Tipo_Linea>&lt;xsl:if test=&quot;exists($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi)  and string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:qta_aggiuntivi) > 0&quot;>&lt;tns:Aggiuntivi>&lt;tns:Linee>&lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:linee&quot;>&lt;xsl:variable name=&quot;DN&quot; select=&quot;tns1:DN&quot;/>&lt;tns:Item>&lt;tns:DN>&lt;xsl:value-of select=&quot;tns1:DN&quot;/>&lt;/tns:DN>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$DistrettoRipetitivo/tns2:DistrettoRipetitivo[tns2:DN = $DN]/tns2:Distretto&quot;/>&lt;/tns:Distretto>&lt;tns:Stato>&lt;xsl:value-of select=&quot;tns1:stato&quot;/>&lt;/tns:Stato>&lt;/tns:Item>&lt;/xsl:for-each>&lt;/tns:Linee>&lt;tns:Qta_Aggiuntivi>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:qta_aggiuntivi&quot;/>&lt;/tns:Qta_Aggiuntivi>&lt;/tns:Aggiuntivi>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;>&lt;tns:Caposerie>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;/>&lt;/tns:Caposerie>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;>&lt;tns:Codice_RO>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;/>&lt;/tns:Codice_RO>&lt;/xsl:if>&lt;/xsl:if>&lt;tns:Flag_TP>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP&quot;/>&lt;/tns:Flag_TP>&lt;tns:Flg_Num_Servizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flg_num_servizio&quot;/>&lt;/tns:Flg_Num_Servizio>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO&quot;>&lt;tns:Banda_Servizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO&quot;/>&lt;/tns:Banda_Servizio>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA&quot;>&lt;tns:Tipo_Portabilita>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA&quot;/>&lt;/tns:Tipo_Portabilita>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale&quot;>&lt;tns:Principale>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale&quot;/>&lt;/tns:Principale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Principale>&lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:NumeroTelefonicoNP&quot;/>&lt;/tns:Principale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Distretto != &amp;quot;00&amp;quot;&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/tns:Distretto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns:Distretto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee&quot;>&lt;tns:Qta_linee>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee&quot;/>&lt;/tns:Qta_linee>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale&quot;>&lt;tns:Radicale>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale&quot;/>&lt;/tns:Radicale>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero&quot;>&lt;tns:Tipo_Numero>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero&quot;/>&lt;/tns:Tipo_Numero>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio&quot;>&lt;tns:Tipo_Servizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio&quot;/>&lt;/tns:Tipo_Servizio>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma&quot;>&lt;tns:Piattaforma>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma&quot;/>&lt;/tns:Piattaforma>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:Tipo_Linea>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:STS/tns1:Codice_STS[1]) > 0&quot;>&lt;tns:STS>&lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:STS/tns1:Codice_STS&quot;>&lt;tns:Codice_STS>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:Codice_STS>&lt;/xsl:for-each>&lt;/tns:STS>&lt;/xsl:if>&lt;/tns:CRMWSResponse>&lt;tns:DatiUnica>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;>&lt;tns3:Caposerie>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;/>&lt;/tns3:Caposerie>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO) > 0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;>&lt;tns3:CodiceRO>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;/>&lt;/tns3:CodiceRO>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP&quot;>&lt;tns3:FlagTP>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP&quot;/>&lt;/tns3:FlagTP>&lt;/xsl:if>&lt;/tns:DatiUnica>&lt;tns:Num_Aggti_Attivi>&lt;xsl:value-of select=&quot;xsd:int(count($UnicacGetDatiInventoryInvoke/Output/tns1:RESPONSE/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:linee[upper-case(tns1:stato)=&amp;quot;ATTIVO&amp;quot; or upper-case(tns1:stato)=&amp;quot;ACTIVE&amp;quot;]))&quot;/>&lt;/tns:Num_Aggti_Attivi>&lt;/tns:Interrogazione_Inventory_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Interrogazione_Inventory_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:Interrogazione_Inventory_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OutputEsito" name="OutputEsitoAssign"
                    outputVariable="OutputEsito"
                    tibex:xpdlId="07f777d6-90f4-459b-9958-be527d921e43" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ReturnNormalFlowToOutputEsitoAssign"/>
                        <bpws:target linkName="CallProcessToOutputEsitoAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToInterrogazioneInventoryOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns1=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InterrogazioneInventoryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;DistrettoRipetitivo&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputEsito&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:header/tns1:esito = (&amp;quot;01&amp;quot;,&amp;quot;02&amp;quot;,&amp;quot;03&amp;quot;,&amp;quot;04&amp;quot;) or ($InterrogazioneInventoryIn.input/tns:FlagCautelare = &amp;quot;Y&amp;quot; and starts-with($InterrogazioneInventoryIn.input/tns:tipologiaScenario, &amp;quot;NPSUWLR&amp;quot;) and (not(exists($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero)) or string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero) = 0 or not(exists($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio)) or string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio) = 0))&quot;>&#xa;                &lt;tns:Interrogazione_Inventory_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Interrogazione_Inventory_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:header/tns1:esito = &amp;quot;00&amp;quot;)&quot;>&#xa;                &lt;tns:Interrogazione_Inventory_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                    &lt;tns:CRMWSResponse>&#xa;                        &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:donating) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:donating&quot;>&#xa;                                &lt;tns:Donating>&#xa;                                    &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:donating&quot;/>&#xa;                                &lt;/tns:Donating>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:Flag_Attivo>&#xa;                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:flag_Attivo&quot;/>&#xa;                        &lt;/tns:Flag_Attivo>&#xa;                        &lt;xsl:if test=&quot;exists($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea) and exists($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP) and exists($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flg_num_servizio)&quot;>&#xa;                            &lt;tns:Tipo_Linea>&#xa;                                &lt;xsl:if test=&quot;exists($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi)  and string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:qta_aggiuntivi) > 0&quot;>&#xa;                                    &lt;tns:Aggiuntivi>&#xa;                                        &lt;tns:Linee>&#xa;                                            &lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:linee&quot;>&#xa;                                                &lt;xsl:variable name=&quot;DN&quot; select=&quot;tns1:DN&quot;/>&#xa;                                                &lt;tns:Item>&#xa;                                                    &lt;tns:DN>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:DN&quot;/>&#xa;                                                    &lt;/tns:DN>&#xa;                                                    &lt;tns:Distretto>&#xa;                                                        &lt;xsl:value-of select=&quot;$DistrettoRipetitivo/tns2:DistrettoRipetitivo[tns2:DN = $DN]/tns2:Distretto&quot;/>&#xa;                                                    &lt;/tns:Distretto>&#xa;                                                    &lt;tns:Stato>&#xa;                                                        &lt;xsl:value-of select=&quot;tns1:stato&quot;/>&#xa;                                                    &lt;/tns:Stato>&#xa;                                                &lt;/tns:Item>&#xa;                                            &lt;/xsl:for-each>&#xa;                                        &lt;/tns:Linee>&#xa;                                        &lt;tns:Qta_Aggiuntivi>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:qta_aggiuntivi&quot;/>&#xa;                                        &lt;/tns:Qta_Aggiuntivi>&#xa;                                    &lt;/tns:Aggiuntivi>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;>&#xa;                                        &lt;tns:Caposerie>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;/>&#xa;                                        &lt;/tns:Caposerie>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;>&#xa;                                        &lt;tns:Codice_RO>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;/>&#xa;                                        &lt;/tns:Codice_RO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns:Flag_TP>&#xa;                                    &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP&quot;/>&#xa;                                &lt;/tns:Flag_TP>&#xa;                                &lt;tns:Flg_Num_Servizio>&#xa;                                    &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flg_num_servizio&quot;/>&#xa;                                &lt;/tns:Flg_Num_Servizio>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO&quot;>&#xa;                                        &lt;tns:Banda_Servizio>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO&quot;/>&#xa;                                        &lt;/tns:Banda_Servizio>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA&quot;>&#xa;                                        &lt;tns:Tipo_Portabilita>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA&quot;/>&#xa;                                        &lt;/tns:Tipo_Portabilita>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale) > 0&quot;>&#xa;                                        &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale&quot;>&#xa;                                            &lt;tns:Principale>&#xa;                                                &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale&quot;/>&#xa;                                            &lt;/tns:Principale>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:Principale>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns:NumeroTelefonicoNP&quot;/>&#xa;                                        &lt;/tns:Principale>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;$Distretto != &amp;quot;00&amp;quot;&quot;>&#xa;                                        &lt;tns:Distretto>&#xa;                                            &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;                                        &lt;/tns:Distretto>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:Distretto>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns:Distretto>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee&quot;>&#xa;                                        &lt;tns:Qta_linee>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee&quot;/>&#xa;                                        &lt;/tns:Qta_linee>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale&quot;>&#xa;                                        &lt;tns:Radicale>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale&quot;/>&#xa;                                        &lt;/tns:Radicale>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero&quot;>&#xa;                                        &lt;tns:Tipo_Numero>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero&quot;/>&#xa;                                        &lt;/tns:Tipo_Numero>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio&quot;>&#xa;                                        &lt;tns:Tipo_Servizio>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio&quot;/>&#xa;                                        &lt;/tns:Tipo_Servizio>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma&quot;>&#xa;                                        &lt;tns:Piattaforma>&#xa;                                            &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma&quot;/>&#xa;                                        &lt;/tns:Piattaforma>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:Tipo_Linea>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:STS/tns1:Codice_STS[1]) > 0&quot;>&#xa;                            &lt;tns:STS>&#xa;                                &lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:STS/tns1:Codice_STS&quot;>&#xa;                                    &lt;tns:Codice_STS>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns:Codice_STS>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/tns:STS>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:CRMWSResponse>&#xa;                    &lt;tns:DatiUnica>&#xa;                        &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;>&#xa;                                &lt;tns3:Caposerie>&#xa;                                    &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie&quot;/>&#xa;                                &lt;/tns3:Caposerie>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;>&#xa;                                &lt;tns3:CodiceRO>&#xa;                                    &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO&quot;/>&#xa;                                &lt;/tns3:CodiceRO>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP&quot;>&#xa;                            &lt;tns3:FlagTP>&#xa;                                &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP&quot;/>&#xa;                            &lt;/tns3:FlagTP>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:DatiUnica>&#xa;                    &lt;tns:Num_Aggti_Attivi>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int(count($UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:linee[upper-case(tns1:stato)=&amp;quot;ATTIVO&amp;quot; or upper-case(tns1:stato)=&amp;quot;ACTIVE&amp;quot;]))&quot;/>&#xa;                    &lt;/tns:Num_Aggti_Attivi>&#xa;                &lt;/tns:Interrogazione_Inventory_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Interrogazione_Inventory_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Interrogazione_Inventory_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="OutputEsito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke
                inputVariable="DatiVerificaControlliInvoke-input"
                name="DatiVerificaControlliInvoke"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlliInvoke"
                partnerLink="DatiVerificaControlli"
                portType="ns9:DatiVerificaControlliPortType" tibex:xpdlId="2018cb60-5eb1-4a6e-bfec-0426231121be">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns2="http://www.tim.com/NOW/xsd/ControlliAmmessiNP/" xmlns:tns3="http://www.tim.now/xsd/UnicacGetDatiInventory" xmlns:tns5="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns1="http://www.tim.com/NOW/xsd/BPM_CheckUtil" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;
    &lt;xsl:param name="InterrogazioneInventoryIn"/&gt;
    &lt;xsl:param name="UnicacGetDatiInventoryInvoke"/&gt;
    &lt;xsl:param name="Distretto"/&gt;
    &lt;xsl:param name="DistrettoRipetitivo"/&gt;
    &lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;
        &lt;tns:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns5:DatiVerificaControlliInput&gt;
                    &lt;tns5:Operatore&gt;
                        &lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;
                    &lt;/tns5:Operatore&gt;
                    &lt;tns5:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$InterrogazioneInventoryIn/input/tns2:Interrogazione_Inventory_Request/tns2:IDRichiestaOLO"/&gt;
                    &lt;/tns5:IDRichiestaOLO&gt;
                    &lt;xsl:if test="$InterrogazioneInventoryIn/input/tns2:Interrogazione_Inventory_Request/tns2:tipologiaScenario"&gt;
                        &lt;tns5:TipologiaScenario&gt;
                            &lt;xsl:value-of select="$InterrogazioneInventoryIn/input/tns2:Interrogazione_Inventory_Request/tns2:tipologiaScenario"/&gt;
                        &lt;/tns5:TipologiaScenario&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns5:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns5:Azione&gt;
                    &lt;xsl:for-each select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:aggiuntivi/tns3:linee"&gt;
                        &lt;xsl:variable name="DN" select="tns3:DN"/&gt;
                        &lt;tns5:AggiuntiviUnica&gt;
                            &lt;xsl:if test="$DistrettoRipetitivo/tns1:DistrettoRipetitivo[tns1:DN = $DN]/tns1:Distretto"&gt;
                                &lt;tns5:Distretto&gt;
                                    &lt;xsl:value-of select="$DistrettoRipetitivo/tns1:DistrettoRipetitivo[tns1:DN = $DN]/tns1:Distretto"/&gt;
                                &lt;/tns5:Distretto&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:NumeroTelefonico&gt;
                                &lt;xsl:value-of select="tns3:DN"/&gt;
                            &lt;/tns5:NumeroTelefonico&gt;
                            &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale"&gt;
                                &lt;tns5:NumeroTelefonicoPrincipale&gt;
                                    &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale"/&gt;
                                &lt;/tns5:NumeroTelefonicoPrincipale&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:Stato&gt;
                                &lt;xsl:value-of select="tns3:stato"/&gt;
                            &lt;/tns5:Stato&gt;
                        &lt;/tns5:AggiuntiviUnica&gt;
                    &lt;/xsl:for-each&gt;
                    &lt;tns5:DatiUnica&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:caposerie"&gt;
                            &lt;tns5:Caposerie&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:caposerie"/&gt;
                            &lt;/tns5:Caposerie&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:donating"&gt;
                            &lt;tns5:CodiceOperatoreDonating&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:donating"/&gt;
                            &lt;/tns5:CodiceOperatoreDonating&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:codice_RO"&gt;
                            &lt;tns5:CodiceRO&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:codice_RO"/&gt;
                            &lt;/tns5:CodiceRO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="$Distretto != &amp;quot;00&amp;quot;"&gt;
                                &lt;tns5:Distretto&gt;
                                    &lt;xsl:value-of select="$Distretto"/&gt;
                                &lt;/tns5:Distretto&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:flag_Attivo"&gt;
                            &lt;tns5:FlagAttivo&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:flag_Attivo"/&gt;
                            &lt;/tns5:FlagAttivo&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flg_num_servizio"&gt;
                            &lt;tns5:FlagNumerazioneServizio&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flg_num_servizio"/&gt;
                            &lt;/tns5:FlagNumerazioneServizio&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flag_TP"&gt;
                            &lt;tns5:FlagTP&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flag_TP"/&gt;
                            &lt;/tns5:FlagTP&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale"&gt;
                            &lt;tns5:NumeroTelefonicoPrincipale&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale"/&gt;
                            &lt;/tns5:NumeroTelefonicoPrincipale&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:radicale"&gt;
                            &lt;tns5:Radicale&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:radicale"/&gt;
                            &lt;/tns5:Radicale&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_numero"&gt;
                            &lt;tns5:TipoNumero&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_numero"/&gt;
                            &lt;/tns5:TipoNumero&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_servizio"&gt;
                            &lt;tns5:TipoServizio&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_servizio"/&gt;
                            &lt;/tns5:TipoServizio&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:aggiuntivi/tns3:qta_aggiuntivi"&gt;
                            &lt;tns5:TotaleAggiuntivi&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:aggiuntivi/tns3:qta_aggiuntivi"/&gt;
                            &lt;/tns5:TotaleAggiuntivi&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:qta_linee"&gt;
                            &lt;tns5:TotaleLinee&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:qta_linee"/&gt;
                            &lt;/tns5:TotaleLinee&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:piattaforma"&gt;
                            &lt;tns5:CodicePiattaforma&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:piattaforma"/&gt;
                            &lt;/tns5:CodicePiattaforma&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:TIPO_PORTABILITA"&gt;
                            &lt;tns5:TipoPortabilita&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:TIPO_PORTABILITA"/&gt;
                            &lt;/tns5:TipoPortabilita&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:BANDA_SERVIZIO"&gt;
                            &lt;tns5:BandaServizio&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:BANDA_SERVIZIO"/&gt;
                            &lt;/tns5:BandaServizio&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="not((string($UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS)"&gt;
                            &lt;tns5:CarrierUnica&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS"/&gt;
                            &lt;/tns5:CarrierUnica&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns5:DatiUnica&gt;
                    &lt;tns5:STSUnica&gt;
                        &lt;xsl:for-each select="$UnicacGetDatiInventoryInvoke/Output/tns3:RESPONSE/tns3:ReperimentoServizioReturn/tns3:body/tns3:STS/tns3:Codice_STS"&gt;
                            &lt;tns5:CodiceSTS&gt;
                                &lt;xsl:value-of select="."/&gt;
                            &lt;/tns5:CodiceSTS&gt;
                        &lt;/xsl:for-each&gt;
                    &lt;/tns5:STSUnica&gt;
                &lt;/tns5:DatiVerificaControlliInput&gt;
            &lt;/parameters&gt;
        &lt;/tns:DatiVerificaControlliRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns3=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InterrogazioneInventoryIn.input&quot;/>&lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke.Output&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;DistrettoRipetitivo&quot;/>&lt;xsl:template name=&quot;DatiVerificaControlliInvoke-input&quot; match=&quot;/&quot;>&lt;tns5:DatiVerificaControlliInput>&lt;tns5:Operatore>&lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&lt;/tns5:Operatore>&lt;tns5:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns2:IDRichiestaOLO&quot;/>&lt;/tns5:IDRichiestaOLO>&lt;xsl:if test=&quot;$InterrogazioneInventoryIn.input/tns2:tipologiaScenario&quot;>&lt;tns5:TipologiaScenario>&lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns2:tipologiaScenario&quot;/>&lt;/tns5:TipologiaScenario>&lt;/xsl:if>&lt;tns5:Azione>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/tns5:Azione>&lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:aggiuntivi/tns3:linee&quot;>&lt;xsl:variable name=&quot;DN&quot; select=&quot;tns3:DN&quot;/>&lt;tns5:AggiuntiviUnica>&lt;xsl:if test=&quot;$DistrettoRipetitivo/tns1:DistrettoRipetitivo[tns1:DN = $DN]/tns1:Distretto&quot;>&lt;tns5:Distretto>&lt;xsl:value-of select=&quot;$DistrettoRipetitivo/tns1:DistrettoRipetitivo[tns1:DN = $DN]/tns1:Distretto&quot;/>&lt;/tns5:Distretto>&lt;/xsl:if>&lt;tns5:NumeroTelefonico>&lt;xsl:value-of select=&quot;tns3:DN&quot;/>&lt;/tns5:NumeroTelefonico>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale&quot;>&lt;tns5:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale&quot;/>&lt;/tns5:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;tns5:Stato>&lt;xsl:value-of select=&quot;tns3:stato&quot;/>&lt;/tns5:Stato>&lt;/tns5:AggiuntiviUnica>&lt;/xsl:for-each>&lt;tns5:DatiUnica>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:caposerie&quot;>&lt;tns5:Caposerie>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:caposerie&quot;/>&lt;/tns5:Caposerie>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:donating&quot;>&lt;tns5:CodiceOperatoreDonating>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:donating&quot;/>&lt;/tns5:CodiceOperatoreDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:codice_RO&quot;>&lt;tns5:CodiceRO>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:codice_RO&quot;/>&lt;/tns5:CodiceRO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Distretto != &amp;quot;00&amp;quot;&quot;>&lt;tns5:Distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/tns5:Distretto>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:flag_Attivo&quot;>&lt;tns5:FlagAttivo>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:flag_Attivo&quot;/>&lt;/tns5:FlagAttivo>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flg_num_servizio&quot;>&lt;tns5:FlagNumerazioneServizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flg_num_servizio&quot;/>&lt;/tns5:FlagNumerazioneServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flag_TP&quot;>&lt;tns5:FlagTP>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:flag_TP&quot;/>&lt;/tns5:FlagTP>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale&quot;>&lt;tns5:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:principale&quot;/>&lt;/tns5:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:radicale&quot;>&lt;tns5:Radicale>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:radicale&quot;/>&lt;/tns5:Radicale>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_numero&quot;>&lt;tns5:TipoNumero>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_numero&quot;/>&lt;/tns5:TipoNumero>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_servizio&quot;>&lt;tns5:TipoServizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:tipo_servizio&quot;/>&lt;/tns5:TipoServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:aggiuntivi/tns3:qta_aggiuntivi&quot;>&lt;tns5:TotaleAggiuntivi>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:aggiuntivi/tns3:qta_aggiuntivi&quot;/>&lt;/tns5:TotaleAggiuntivi>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:qta_linee&quot;>&lt;tns5:TotaleLinee>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:qta_linee&quot;/>&lt;/tns5:TotaleLinee>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:piattaforma&quot;>&lt;tns5:CodicePiattaforma>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:piattaforma&quot;/>&lt;/tns5:CodicePiattaforma>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:TIPO_PORTABILITA&quot;>&lt;tns5:TipoPortabilita>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:TIPO_PORTABILITA&quot;/>&lt;/tns5:TipoPortabilita>&lt;/xsl:if>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:BANDA_SERVIZIO&quot;>&lt;tns5:BandaServizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:tipo_linea/tns3:BANDA_SERVIZIO&quot;/>&lt;/tns5:BandaServizio>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS)&quot;>&lt;tns5:CarrierUnica>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:CODOLO_CPS&quot;/>&lt;/tns5:CarrierUnica>&lt;/xsl:if>&lt;/tns5:DatiUnica>&lt;tns5:STSUnica>&lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns3:ReperimentoServizioReturn/tns3:body/tns3:STS/tns3:Codice_STS&quot;>&lt;tns5:CodiceSTS>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns5:CodiceSTS>&lt;/xsl:for-each>&lt;/tns5:STSUnica>&lt;/tns5:DatiVerificaControlliInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
