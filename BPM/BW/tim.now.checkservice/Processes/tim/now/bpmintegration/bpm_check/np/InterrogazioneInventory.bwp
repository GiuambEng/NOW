                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns1=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke.Output&quot;/>&#xa;    &lt;xsl:template name=&quot;DistrettoRipetitivo&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Aggiuntivi>&#xa;            &lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns1:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:linee&quot;>&#xa;                &lt;tns:DistrettoRipetitivo>&#xa;                    &lt;tns:DN>&#xa;                        &lt;xsl:value-of select=&quot;tns1:DN&quot;/>&#xa;                    &lt;/tns:DN>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring(tns1:DN, 2, 1) = &amp;quot;6&amp;quot; or substring(tns1:DN, 2, 1) = &amp;quot;2&amp;quot;&quot;>&#xa;                            &lt;tns:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;substring(tns1:DN, 1, 2)&quot;/>&#xa;                            &lt;/tns:Distretto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;substring(tns1:DN, 3, 1) = &amp;quot;0&amp;quot; or substring(tns1:DN, 3, 1) = &amp;quot;1&amp;quot; or substring(tns1:DN, 3, 1) = &amp;quot;5&amp;quot; or substring(tns1:DN, 3, 1) = &amp;quot;9&amp;quot;&quot;>&#xa;                            &lt;tns:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;substring(tns1:DN, 1, 3)&quot;/>&#xa;                            &lt;/tns:Distretto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;substring(tns1:DN, 1, 4)&quot;/>&#xa;                            &lt;/tns:Distretto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:DistrettoRipetitivo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:Aggiuntivi>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
