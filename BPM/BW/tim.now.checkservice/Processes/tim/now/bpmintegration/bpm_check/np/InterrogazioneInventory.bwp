                name="UnicacGetDatiInventoryInvoke"
                operation="UnicacGetDatiInventory"
                outputVariable="UnicacGetDatiInventoryInvoke"
                partnerLink="UnicacGetDatiInventory"
                portType="ns2:UnicacGetDatiInventoryPortType" tibex:xpdlId="cc9aeaaa-3660-4713-962d-56e1726ef922">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tibco.com/UnicacGetDatiInventory/" xmlns:tns2="http://www.tim.now/xsd/UnicacGetDatiInventory" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiNP/" version="2.0"&gt;&lt;xsl:param name="InterrogazioneInventoryIn"/&gt;&lt;xsl:param name="Distretto"/&gt;&lt;xsl:template name="UnicacGetDatiInventoryInvoke-input" match="/"&gt;&lt;tns1:UnicacGetDatiInventoryRequest&gt;&lt;Input&gt;&lt;tns2:REQUEST&gt;&lt;tns2:IdRichiestaOLO&gt;&lt;xsl:value-of select="$InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:IDRichiestaOLO"/&gt;&lt;/tns2:IdRichiestaOLO&gt;&lt;tns2:DN&gt;&lt;xsl:value-of select="$InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:NumeroTelefonicoNP"/&gt;&lt;/tns2:DN&gt;&lt;tns2:distretto&gt;&lt;xsl:value-of select="$Distretto"/&gt;&lt;/tns2:distretto&gt;&lt;xsl:if test="$InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:Id_Task"&gt;&lt;tns2:Id_Task&gt;&lt;xsl:value-of select="$InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:Id_Task"/&gt;&lt;/tns2:Id_Task&gt;&lt;/xsl:if&gt;&lt;/tns2:REQUEST&gt;&lt;/Input&gt;&lt;/tns1:UnicacGetDatiInventoryRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/UnicacGetDatiInventory/&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InterrogazioneInventoryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:template name=&quot;UnicacGetDatiInventoryInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:REQUEST>&#xa;            &lt;tns2:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns2:IdRichiestaOLO>&#xa;            &lt;tns2:DN>&#xa;                &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns:NumeroTelefonicoNP&quot;/>&#xa;            &lt;/tns2:DN>&#xa;            &lt;tns2:distretto>&#xa;                &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;            &lt;/tns2:distretto>&#xa;            &lt;xsl:if test=&quot;$InterrogazioneInventoryIn.input/tns:Id_Task&quot;>&#xa;                &lt;tns2:Id_Task>&#xa;                    &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns:Id_Task&quot;/>&#xa;                &lt;/tns2:Id_Task>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
