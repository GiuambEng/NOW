                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InterrogazioneInventoryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelIdLavrzHD&quot;/>&#xa;    &lt;xsl:template name=&quot;LogIdLavrzHD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InterrogazioneInventory&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InterrogazioneInventory&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelIdLavrzHD/Record) > 0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Query su ToolRichStopNGo: &amp;quot;, tib:render-xml($SelIdLavrzHD, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record recuperato.&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="ReturnNormalFlow" tibex:xpdlId="1bce7815-35b8-4891-a636-ce2eb5cd236a">
                <bpws:targets>
                    <bpws:target linkName="LogUnicacGetDatiInventoryToReturnNormalFlow"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ReturnNormalFlowToOutputEsitoAssign">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$UnicacGetDatiInventoryInvoke/Output/tns:RESPONSE/tns:ReperimentoServizioReturn/tns:header/tns:esito != &quot;00&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$UnicacGetDatiInventoryInvoke.Output/tns:ReperimentoServizioReturn/tns:header/tns:esito != "00"]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="ReturnNormalFlowToDistrettoRipetitivoAssign">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InterrogazioneInventoryIn&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke&quot;/>&lt;xsl:template name=&quot;LogEsitoSTOPNGO-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;InterrogazioneInventory&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;InterrogazioneInventory&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn/input/tns1:Interrogazione_Inventory_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns2:RESPONSE/tns2:ReperimentoServizioReturn/tns2:header/tns2:esito != '00' &quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO diretto da UNICA - Impostata LAVORAZIONEMANUALE su STOPNGO&amp;quot;&quot;/>&lt;/tns:MsgCode>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($InterrogazioneInventoryIn/input/tns1:Interrogazione_Inventory_Request/tns1:tipologiaScenario, &amp;quot;NPSUWLR&amp;quot;) and (not(exists($UnicacGetDatiInventoryInvoke/Output/tns2:RESPONSE/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_numero)) or string-length($UnicacGetDatiInventoryInvoke/Output/tns2:RESPONSE/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_numero) = 0 or not(exists($UnicacGetDatiInventoryInvoke/Output/tns2:RESPONSE/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_servizio)) or string-length($UnicacGetDatiInventoryInvoke/Output/tns2:RESPONSE/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_servizio) = 0)&quot;>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;concat(&amp;quot;OK da UNICA -&amp;quot;, $InterrogazioneInventoryIn/input/tns1:Interrogazione_Inventory_Request/tns1:tipologiaScenario,&amp;quot;- manca TIPOSERVIZIO o TIPONUMERO - LAVORAZIONEMANUALE su STOPNGO &amp;quot;)&quot;/>&lt;/tns:MsgCode>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MsgCode>&lt;xsl:value-of select=&quot;&amp;quot;OK da UNICA - LAVORATO SU STOPNGO&amp;quot;&quot;/>&lt;/tns:MsgCode>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogEsitoSTOPNGO-input"
                    name="LogEsitoSTOPNGO"
                    tibex:xpdlId="94c2c155-8d0a-4778-8e40-8da46e52d354"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdPPSlavrzHDToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogEsitoSTOPNGOToInterrogazioneInventoryOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InterrogazioneInventoryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogEsitoSTOPNGO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InterrogazioneInventory&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;InterrogazioneInventory&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns2:ReperimentoServizioReturn/tns2:header/tns2:esito != '00' &quot;>&#xa;                        &lt;tns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO diretto da UNICA - Impostata LAVORAZIONEMANUALE su STOPNGO&amp;quot;&quot;/>&#xa;                        &lt;/tns:MsgCode>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;starts-with($InterrogazioneInventoryIn.input/tns1:tipologiaScenario, &amp;quot;NPSUWLR&amp;quot;) and (not(exists($UnicacGetDatiInventoryInvoke.Output/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_numero)) or string-length($UnicacGetDatiInventoryInvoke.Output/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_numero) = 0 or not(exists($UnicacGetDatiInventoryInvoke.Output/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_servizio)) or string-length($UnicacGetDatiInventoryInvoke.Output/tns2:ReperimentoServizioReturn/tns2:body/tns2:tipo_linea/tns2:tipo_servizio) = 0)&quot;>&#xa;                        &lt;tns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;OK da UNICA -&amp;quot;, $InterrogazioneInventoryIn.input/tns1:tipologiaScenario,&amp;quot;- manca TIPOSERVIZIO o TIPONUMERO - LAVORAZIONEMANUALE su STOPNGO &amp;quot;)&quot;/>&#xa;                        &lt;/tns:MsgCode>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:MsgCode>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK da UNICA - LAVORATO SU STOPNGO&amp;quot;&quot;/>&#xa;                        &lt;/tns:MsgCode>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns4=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;OutputEsito&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke&quot;/>&#xa;    &lt;xsl:param name=&quot;InterrogazioneInventoryIn&quot;/>&#xa;    &lt;xsl:param name=&quot;DistrettoRipetitivo&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputEsito&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Interrogazione_Inventory_Response>&#xa;            &lt;!--Questa palette è stata aggiunta con Bug #34049. Prima era la response finale... ora è stata anticipata la logica, poiché prima della response finale viene fatta un'ulteriore logica sugli esiti (che prima era presente sul BPM)-->&#xa;            &lt;xsl:copy-of select=&quot;$OutputEsito/tns1:Esito&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$OutputEsito/tns1:CRMWSResponse&quot;/>&#xa;            &lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:linee&quot;>&#xa;                &lt;xsl:if test=&quot;$FlagEnrichment=true() and ((upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN' or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN BMO' or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN BMU' or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN PRA')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;((upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'CAPOSERIE' or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'LINEA PBX' )&amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;(upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN BRA'  or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN PRA' ))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;((upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'RADICALE' or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'SPE' or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'SPU')  and upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN BRA' or upper-case($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN PRA')&amp;#xD;&amp;#xA;)&quot;>&#xa;                    &lt;tns1:AggiuntiviUnica>&#xa;                        &lt;xsl:variable name=&quot;DN&quot; select=&quot;tns4:DN&quot;/>&#xa;                        &lt;xsl:if test=&quot;string-length($DistrettoRipetitivo/tns3:DistrettoRipetitivo[tns3:DN = $DN]/tns3:Distretto)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$DistrettoRipetitivo/tns3:DistrettoRipetitivo[tns3:DN = $DN]/tns3:Distretto&quot;>&#xa;                                &lt;tns2:Distretto>&#xa;                                    &lt;xsl:value-of select=&quot;$DistrettoRipetitivo/tns3:DistrettoRipetitivo[tns3:DN = $DN]/tns3:Distretto&quot;/>&#xa;                                &lt;/tns2:Distretto>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:NumeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;tns4:DN&quot;/>&#xa;                        &lt;/tns2:NumeroTelefonico>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length(../../tns4:principale) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;../../tns4:principale&quot;>&#xa;                                    &lt;tns2:NumeroTelefonicoPrincipale>&#xa;                                        &lt;xsl:value-of select=&quot;../../tns4:principale&quot;/>&#xa;                                    &lt;/tns2:NumeroTelefonicoPrincipale>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NumeroTelefonicoPrincipale>&#xa;                                    &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn/input/tns1:Interrogazione_Inventory_Request/tns1:NumeroTelefonicoNP&quot;/>&#xa;                                &lt;/tns2:NumeroTelefonicoPrincipale>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;tns2:Stato>&#xa;                            &lt;xsl:value-of select=&quot;upper-case(tns4:stato)&quot;/>&#xa;                        &lt;/tns2:Stato>&#xa;                    &lt;/tns1:AggiuntiviUnica>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;tns1:DatiUnica>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:caposerie)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:caposerie&quot;>&#xa;                                    &lt;tns2:Caposerie>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:caposerie&quot;/>&#xa;                                    &lt;/tns2:Caposerie>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:donating)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:donating&quot;>&#xa;                                    &lt;tns2:CodiceOperatoreDonating>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:donating&quot;/>&#xa;                                    &lt;/tns2:CodiceOperatoreDonating>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:codice_RO)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:codice_RO&quot;>&#xa;                                    &lt;tns2:CodiceRO>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:codice_RO&quot;/>&#xa;                                    &lt;/tns2:CodiceRO>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$Distretto != &amp;quot;00&amp;quot;&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;string-length($Distretto)>0&quot;>&#xa;                                        &lt;tns2:Distretto>&#xa;                                            &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;                                        &lt;/tns2:Distretto>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns2:Distretto>&#xa;                                            &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                                        &lt;/tns2:Distretto>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:flag_Attivo)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:flag_Attivo&quot;>&#xa;                                    &lt;tns2:FlagAttivo>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:flag_Attivo&quot;/>&#xa;                                    &lt;/tns2:FlagAttivo>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flg_num_servizio)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flg_num_servizio&quot;>&#xa;                                    &lt;tns2:FlagNumerazioneServizio>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flg_num_servizio&quot;/>&#xa;                                    &lt;/tns2:FlagNumerazioneServizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flag_TP)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flag_TP&quot;>&#xa;                                    &lt;tns2:FlagTP>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flag_TP&quot;/>&#xa;                                    &lt;/tns2:FlagTP>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:principale)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:principale&quot;>&#xa;                                    &lt;tns2:NumeroTelefonicoPrincipale>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:principale&quot;/>&#xa;                                    &lt;/tns2:NumeroTelefonicoPrincipale>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns2:NumeroTelefonicoPrincipale>&#xa;                                    &lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn/input/tns1:Interrogazione_Inventory_Request/tns1:NumeroTelefonicoNP&quot;/>&#xa;                                &lt;/tns2:NumeroTelefonicoPrincipale>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:radicale)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:radicale&quot;>&#xa;                                    &lt;tns2:Radicale>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:radicale&quot;/>&#xa;                                    &lt;/tns2:Radicale>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_numero)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_numero&quot;>&#xa;                                    &lt;tns2:TipoNumero>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_numero&quot;/>&#xa;                                    &lt;/tns2:TipoNumero>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio&quot;>&#xa;                                    &lt;tns2:TipoServizio>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio&quot;/>&#xa;                                    &lt;/tns2:TipoServizio>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:qta_aggiuntivi)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:qta_aggiuntivi&quot;>&#xa;                                    &lt;tns2:TotaleAggiuntivi>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:qta_aggiuntivi&quot;/>&#xa;                                    &lt;/tns2:TotaleAggiuntivi>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:qta_linee)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:qta_linee&quot;>&#xa;                                    &lt;tns2:TotaleLinee>&#xa;                                        &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:qta_linee&quot;/>&#xa;                                    &lt;/tns2:TotaleLinee>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;not((string($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS)&quot;>&#xa;                                &lt;tns2:CarrierUnica>&#xa;                                    &lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS&quot;/>&#xa;                                &lt;/tns2:CarrierUnica>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns1:DatiUnica>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;tns1:STSUnica>&#xa;                        &lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke/Output/tns4:RESPONSE/tns4:ReperimentoServizioReturn/tns4:body/tns4:STS/tns4:Codice_STS&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(.)>0&quot;>&#xa;                                    &lt;tns2:CodiceSTS>&#xa;                                        &lt;xsl:value-of select=&quot;.&quot;/>&#xa;                                    &lt;/tns2:CodiceSTS>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/tns1:STSUnica>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$OutputEsito/tns1:Num_Aggti_Attivi&quot;>&#xa;                &lt;tns1:Num_Aggti_Attivi>&#xa;                    &lt;xsl:value-of select=&quot;$OutputEsito/tns1:Num_Aggti_Attivi&quot;/>&#xa;                &lt;/tns1:Num_Aggti_Attivi>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Interrogazione_Inventory_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OutputEsito" name="ResponseOld"
                    outputVariable="OutputEsito"
                    tibex:xpdlId="aeb6c15a-85d6-44a8-b471-32a299bd4579" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToInterrogazioneInventoryOut"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="PrimaReponseToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns4=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InterrogazioneInventoryIn.input&quot;/>&lt;xsl:param name=&quot;UnicacGetDatiInventoryInvoke.Output&quot;/>&lt;xsl:param name=&quot;OutputEsito&quot;/>&lt;xsl:param name=&quot;FlagEnrichment&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;DistrettoRipetitivo&quot;/>&lt;xsl:template name=&quot;OutputEsito&quot; match=&quot;/&quot;>&lt;tns1:Interrogazione_Inventory_Response>&#xa;                                    &lt;!--Questa palette è stata aggiunta con Bug #34049. Prima era la response finale... ora è stata anticipata la logica, poiché prima della response finale viene fatta un'ulteriore logica sugli esiti (che prima era presente sul BPM)-->&lt;xsl:copy-of select=&quot;$OutputEsito/tns1:Esito&quot;/>&lt;xsl:copy-of select=&quot;$OutputEsito/tns1:CRMWSResponse&quot;/>&lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:linee&quot;>&lt;xsl:if test=&quot;$FlagEnrichment=true() and ((upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN' or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN BMO' or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN BMU' or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'ISDN PRA')&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;((upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'CAPOSERIE' or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'LINEA PBX' )&amp;#xD;&amp;#xA;and &amp;#xD;&amp;#xA;(upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN BRA'  or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN PRA' ))&amp;#xD;&amp;#xA;or&amp;#xD;&amp;#xA;((upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'RADICALE' or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'SPE' or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio) = 'SPU')  and upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN BRA' or upper-case($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:BANDA_SERVIZIO) = 'ISDN PRA')&amp;#xD;&amp;#xA;)&quot;>&lt;tns1:AggiuntiviUnica>&lt;xsl:variable name=&quot;DN&quot; select=&quot;tns4:DN&quot;/>&lt;xsl:if test=&quot;string-length($DistrettoRipetitivo/tns3:DistrettoRipetitivo[tns3:DN = $DN]/tns3:Distretto)>0&quot;>&lt;xsl:if test=&quot;$DistrettoRipetitivo/tns3:DistrettoRipetitivo[tns3:DN = $DN]/tns3:Distretto&quot;>&lt;tns2:Distretto>&lt;xsl:value-of select=&quot;$DistrettoRipetitivo/tns3:DistrettoRipetitivo[tns3:DN = $DN]/tns3:Distretto&quot;/>&lt;/tns2:Distretto>&lt;/xsl:if>&lt;/xsl:if>&lt;tns2:NumeroTelefonico>&lt;xsl:value-of select=&quot;tns4:DN&quot;/>&lt;/tns2:NumeroTelefonico>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(../../tns4:principale) > 0&quot;>&lt;xsl:if test=&quot;../../tns4:principale&quot;>&lt;tns2:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;../../tns4:principale&quot;/>&lt;/tns2:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns1:NumeroTelefonicoNP&quot;/>&lt;/tns2:NumeroTelefonicoPrincipale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:Stato>&lt;xsl:value-of select=&quot;upper-case(tns4:stato)&quot;/>&lt;/tns2:Stato>&lt;/tns1:AggiuntiviUnica>&lt;/xsl:if>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&lt;tns1:DatiUnica>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:caposerie)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:caposerie&quot;>&lt;tns2:Caposerie>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:caposerie&quot;/>&lt;/tns2:Caposerie>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:donating)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:donating&quot;>&lt;tns2:CodiceOperatoreDonating>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:donating&quot;/>&lt;/tns2:CodiceOperatoreDonating>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:codice_RO)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:codice_RO&quot;>&lt;tns2:CodiceRO>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:codice_RO&quot;/>&lt;/tns2:CodiceRO>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Distretto != &amp;quot;00&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Distretto)>0&quot;>&lt;tns2:Distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/tns2:Distretto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Distretto>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns2:Distretto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:flag_Attivo)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:flag_Attivo&quot;>&lt;tns2:FlagAttivo>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:flag_Attivo&quot;/>&lt;/tns2:FlagAttivo>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flg_num_servizio)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flg_num_servizio&quot;>&lt;tns2:FlagNumerazioneServizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flg_num_servizio&quot;/>&lt;/tns2:FlagNumerazioneServizio>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flag_TP)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flag_TP&quot;>&lt;tns2:FlagTP>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:flag_TP&quot;/>&lt;/tns2:FlagTP>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:principale)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:principale&quot;>&lt;tns2:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:principale&quot;/>&lt;/tns2:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$InterrogazioneInventoryIn.input/tns1:NumeroTelefonicoNP&quot;/>&lt;/tns2:NumeroTelefonicoPrincipale>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:radicale)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:radicale&quot;>&lt;tns2:Radicale>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:radicale&quot;/>&lt;/tns2:Radicale>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_numero)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_numero&quot;>&lt;tns2:TipoNumero>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_numero&quot;/>&lt;/tns2:TipoNumero>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio&quot;>&lt;tns2:TipoServizio>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:tipo_servizio&quot;/>&lt;/tns2:TipoServizio>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:qta_aggiuntivi)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:qta_aggiuntivi&quot;>&lt;tns2:TotaleAggiuntivi>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:aggiuntivi/tns4:qta_aggiuntivi&quot;/>&lt;/tns2:TotaleAggiuntivi>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:qta_linee)>0&quot;>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:qta_linee&quot;>&lt;tns2:TotaleLinee>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:tipo_linea/tns4:qta_linee&quot;/>&lt;/tns2:TotaleLinee>&lt;/xsl:if>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;string-length($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS)>0&quot;>&lt;xsl:if test=&quot;not((string($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS)&quot;>&lt;tns2:CarrierUnica>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:CODOLO_CPS&quot;/>&lt;/tns2:CarrierUnica>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns1:DatiUnica>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&lt;tns1:STSUnica>&lt;xsl:for-each select=&quot;$UnicacGetDatiInventoryInvoke.Output/tns4:ReperimentoServizioReturn/tns4:body/tns4:STS/tns4:Codice_STS&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(.)>0&quot;>&lt;tns2:CodiceSTS>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns2:CodiceSTS>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/tns1:STSUnica>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;$OutputEsito/tns1:Num_Aggti_Attivi&quot;>&lt;tns1:Num_Aggti_Attivi>&lt;xsl:value-of select=&quot;$OutputEsito/tns1:Num_Aggti_Attivi&quot;/>&lt;/tns1:Num_Aggti_Attivi>&lt;/xsl:if>&lt;/tns1:Interrogazione_Inventory_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="OutputEsito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OutputEsito&quot;/>&lt;xsl:param name=&quot;InterrogazioneInventoryIn&quot;/>&lt;xsl:template name=&quot;OutputEsito&quot; match=&quot;/&quot;>&lt;tns:Interrogazione_Inventory_Response>&#xa;                    &lt;!--Questa Palette è stata aggiunta con task &quot;Bug #34049&quot;. La logica finale degli esiti presenti in questa Assign prima era sul BPM, è stata portata su BW per aggiornare contestualmente la tabella STOP N GO in caso di FlagCautelare = Y. -->&lt;xsl:variable name=&quot;AggiuntivoWLR&quot; select=&quot;if($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:aggiuntivoWLR = 'Y' and ($OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'GENERICA' or $OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Servizio = 'LINEA PBX' or count($OutputEsito/tns:AggiuntiviUnica)>0)) then 'Y' else 'N'&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;$OutputEsito/tns:Esito/tns:Codice = false()&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:FlagDelibera103)>0 and $InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:FlagDelibera103=&amp;quot;Y&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'AGGIUNTIVO'&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$AggiuntivoWLR = 'N'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'AGGIUNTIVO'&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = ('GNR RADICALE', 'RADICALE ACCORPATO' , 'GNR LINEE') and $InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:tipoLineaOLO = ('1','2')&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:tipoLineaOLO) = 0 or ($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:tipoLineaOLO = ('0','3'))&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'GENERICA' and $OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Servizio = 'LINEA PBX' and (string-length($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:tipoLineaOLO) = 0 or ($InterrogazioneInventoryIn/input/tns:Interrogazione_Inventory_Request/tns:tipoLineaOLO = ('0','3')))&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$OutputEsito/tns:CRMWSResponse&quot;/>&lt;xsl:copy-of select=&quot;$OutputEsito/tns:AggiuntiviUnica&quot;/>&lt;xsl:copy-of select=&quot;$OutputEsito/tns:DatiUnica&quot;/>&lt;xsl:copy-of select=&quot;$OutputEsito/tns:STSUnica&quot;/>&lt;xsl:if test=&quot;$OutputEsito/tns:Num_Aggti_Attivi&quot;>&lt;tns:Num_Aggti_Attivi>&lt;xsl:value-of select=&quot;$OutputEsito/tns:Num_Aggti_Attivi&quot;/>&lt;/tns:Num_Aggti_Attivi>&lt;/xsl:if>&lt;/tns:Interrogazione_Inventory_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OutputEsito" name="OutputEsitoFinale"
                    outputVariable="OutputEsito"
                    tibex:xpdlId="b5ec4ffc-9e24-477f-86d9-f53f79cc9718" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="PrimaReponseToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogEsitoUnica">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$InterrogazioneInventoryIn/input/ns3:Interrogazione_Inventory_Request/ns3:FlagCautelare = &quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$InterrogazioneInventoryIn.input/ns3:FlagCautelare = "Y"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToInterrogazioneInventoryOut1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InterrogazioneInventoryIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;OutputEsito&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputEsito&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Interrogazione_Inventory_Response>&#xa;            &lt;!--Questa Palette è stata aggiunta con task &quot;Bug #34049&quot;. La logica finale degli esiti presenti in questa Assign prima era sul BPM, è stata portata su BW per aggiornare contestualmente la tabella STOP N GO in caso di FlagCautelare = Y. -->&#xa;            &lt;xsl:variable name=&quot;AggiuntivoWLR&quot; select=&quot;if($InterrogazioneInventoryIn.input/tns:aggiuntivoWLR = 'Y' and ($OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'GENERICA' or $OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Servizio = 'LINEA PBX' or count($OutputEsito/tns:AggiuntiviUnica)>0)) then 'Y' else 'N'&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$OutputEsito/tns:Esito/tns:Codice = false()&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($InterrogazioneInventoryIn.input/tns:FlagDelibera103)>0 and $InterrogazioneInventoryIn.input/tns:FlagDelibera103=&amp;quot;Y&amp;quot;&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'AGGIUNTIVO'&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$AggiuntivoWLR = 'N'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'AGGIUNTIVO'&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = ('GNR RADICALE', 'RADICALE ACCORPATO' , 'GNR LINEE') and $InterrogazioneInventoryIn.input/tns:tipoLineaOLO = ('1','2')&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;string-length($InterrogazioneInventoryIn.input/tns:tipoLineaOLO) = 0 or ($InterrogazioneInventoryIn.input/tns:tipoLineaOLO = ('0','3'))&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Numero = 'GENERICA' and $OutputEsito/tns:CRMWSResponse/tns:Tipo_Linea/tns:Tipo_Servizio = 'LINEA PBX' and (string-length($InterrogazioneInventoryIn.input/tns:tipoLineaOLO) = 0 or ($InterrogazioneInventoryIn.input/tns:tipoLineaOLO = ('0','3')))&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:copy-of select=&quot;$OutputEsito/tns:CRMWSResponse&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$OutputEsito/tns:AggiuntiviUnica&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$OutputEsito/tns:DatiUnica&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$OutputEsito/tns:STSUnica&quot;/>&#xa;            &lt;xsl:if test=&quot;$OutputEsito/tns:Num_Aggti_Attivi&quot;>&#xa;                &lt;tns:Num_Aggti_Attivi>&#xa;                    &lt;xsl:value-of select=&quot;$OutputEsito/tns:Num_Aggti_Attivi&quot;/>&#xa;                &lt;/tns:Num_Aggti_Attivi>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Interrogazione_Inventory_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="OutputEsito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
