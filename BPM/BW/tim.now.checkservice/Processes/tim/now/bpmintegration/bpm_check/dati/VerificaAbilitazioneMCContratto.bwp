                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryBouquet&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns2:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:LavorazioneRichiesta>&#xa;                &lt;xsl:if test=&quot;$JDBCQueryBouquet/Record[1]/VALORE_ATTRIBUTO&quot;>&#xa;                    &lt;tns1:NomeBouquet>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCQueryBouquet/Record[1]/VALORE_ATTRIBUTO&quot;/>&#xa;                    &lt;/tns1:NomeBouquet>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;>&#xa;                    &lt;tns1:IdentificativoContratto>&#xa;                        &lt;xsl:value-of select=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;/>&#xa;                    &lt;/tns1:IdentificativoContratto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:LavorazioneRichiesta>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="ResponseToDatiVerificaControlli"/>
                    <bpws:target linkName="AssignToDatiVerificaControlli"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DatiVerificaControlliToLogResponse"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQueryBouquet-input"
                    name="JDBCQueryBouquet"
                    outputVariable="JDBCQueryBouquet"
                    tibex:xpdlId="b094a69e-6019-4193-badf-4ad4188172be" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQueryBouquet"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryBouquetToCopy_1_LogQueryContratto"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b094a69e-6019-4193-badf-4ad4188172be+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryContratto&quot;/>&lt;xsl:param name=&quot;QueryContrattoGUI&quot;/>&lt;xsl:template name=&quot;JDBCQueryBouquet-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryContrattoGUI/Record)&quot;>&lt;IDCONTRATTO>&lt;xsl:value-of select=&quot;xsd:int($QueryContrattoGUI/Record[1]/ID_CONTRATTO)&quot;/>&lt;/IDCONTRATTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;IDCONTRATTO>&lt;xsl:value-of select=&quot;xsd:int($QueryContratto/Record[1]/ID_CONTRATTO)&quot;/>&lt;/IDCONTRATTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select VALORE_ATTRIBUTO&#xa;from CONTRATTO_ATTRIBUTO_MULTICAST&#xa;where ID_TIPOLOG_CONTR_ATTR_MULTI = (select ID_TIPOLOG_CONTR_ATTR_MULTI from TIPOLOG_CONTR_ATTR_MULTI where NOME_TIPOLOG_CONTR_ATTR_MULTI='BOUQUET' and SYSDATE BETWEEN DATA_INIZIO_VAL and DATA_FINE_VAL)&#xa;and ID_CONTRATTO = ?"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="IDCONTRATTO"/>
                                    <columnMetadata
                                    columnName="VALORE_ATTRIBUTO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="Response2" outputVariable="Response"
                    tibex:xpdlId="f6595ef1-ea1e-4f59-8f00-7a4312de3f1c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogQueryBouquetToResponse2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToDatiVerificaControlli">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Response/ns0:Descrizione='OK' and $Start/ns0:IDRichiestaOLO != &quot;GUI&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Response/ns0:Descrizione='OK' and $Start/ns0:IDRichiestaOLO != "GUI"]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Response2ToLogResponse">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;QueryContratto&quot;/>&lt;xsl:param name=&quot;JDBCQueryBouquet&quot;/>&lt;xsl:param name=&quot;QueryContrattoGUI&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:VerificaAbilitazioneMCContratto_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($QueryContrattoGUI/Record)&quot;>&lt;xsl:if test=&quot;$QueryContrattoGUI/Record[1]/ID_CONTRATTO&quot;>&lt;tns:IDContratto>&lt;xsl:value-of select=&quot;$QueryContrattoGUI/Record[1]/ID_CONTRATTO&quot;/>&lt;/tns:IDContratto>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;>&lt;tns:IDContratto>&lt;xsl:value-of select=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;/>&lt;/tns:IDContratto>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JDBCQueryBouquet/Record[1]/VALORE_ATTRIBUTO&quot;>&lt;tns:NomeBouquet>&lt;xsl:value-of select=&quot;$JDBCQueryBouquet/Record[1]/VALORE_ATTRIBUTO&quot;/>&lt;/tns:NomeBouquet>&lt;/xsl:if>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaAbilitazioneMCContratto_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogQueryBouquet-input"
                    name="LogQueryBouquet"
                    tibex:xpdlId="fc4eaaec-1fac-4186-ac27-fd57b2f0cce2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryBouquetToCopy_1_LogQueryContratto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogQueryBouquetToResponse2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;JDBCQueryBouquet&quot;/>&lt;xsl:template name=&quot;LogQueryBouquet-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAbilitazioneMCContratto&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAbilitazioneMCContratto&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output QueryBouquet: &amp;quot;, tib:render-xml($JDBCQueryBouquet, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="a751b751-4620-49e4-ac94-d39872cadbf4">
                <bpws:targets>
                    <bpws:target linkName="LogQueryContrattoToEmpty"/>
                    <bpws:target linkName="GenericLoggerToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToJDBCQueryBouquet">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="(string-length(xsd:string($QueryContratto/Record[1]/ID_CONTRATTO))>0 or string-length(xsd:string($QueryContrattoGUI/Record[1]/ID_CONTRATTO))>0) and $Start/ns0:Offerta='FEEDER' and $Start/ns0:Sottolavorazione='PRIMOFEEDER'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(string-length(xsd:string($QueryContratto/Record[1]/ID_CONTRATTO))>0 or string-length(xsd:string($QueryContrattoGUI/Record[1]/ID_CONTRATTO))>0) and $Start/ns0:Offerta='FEEDER' and $Start/ns0:Sottolavorazione='PRIMOFEEDER']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToResponse">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="Empty1" tibex:xpdlId="0a87aaf1-29d8-443e-b015-82fbedcc5e5b">
                <bpws:targets>
                    <bpws:target linkName="LogOscurToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToQueryContratto">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToJDBCQuery">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/ns0:IDRichiestaOLO='GUI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/ns0:IDRichiestaOLO='GUI']]></bpws:transitionCondition>
