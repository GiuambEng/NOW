                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7fbfc259-04b0-43af-9066-c1212b6cbe41+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index1&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ContrattoOffertaCatlg-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceOloSubContractor[number($index1)])&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOloSubContractor[number($index1)]&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="ContrattoOffertaCatlg-input"
                                    name="ContrattoOffertaCatlg"
                                    outputVariable="ContrattoOffertaCatlg"
                                    tibex:xpdlId="7fbfc259-04b0-43af-9066-c1212b6cbe41" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
