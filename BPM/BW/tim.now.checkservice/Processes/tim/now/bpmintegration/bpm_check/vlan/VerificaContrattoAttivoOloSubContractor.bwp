                <bpws:variables>
                    <bpws:variable name="index1"
                        sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index1 &lt;= count($Start/ns0:CodiceOloSubContractor) and $Esito = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index1 <= count($Start/ns0:CodiceOloSubContractor) and $Esito = true()]]></bpws:condition>
                        <bpws:flow name="flow2">
