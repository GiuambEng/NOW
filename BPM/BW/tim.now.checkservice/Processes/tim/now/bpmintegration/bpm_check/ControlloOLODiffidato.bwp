            <bpws:invoke
                inputVariable="DatiVerificaControlliInvoke-input"
                name="DatiVerificaControlliInvoke"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlliInvoke"
                partnerLink="DatiVerificaControlli"
                portType="ns5:DatiVerificaControlliPortType" tibex:xpdlId="836b1556-f85d-4215-83a1-a9596d8df2f5">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns2="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" version="2.0"&gt;&lt;xsl:param name="ControlloOLOdiffidatoIn"/&gt;&lt;xsl:param name="SelectOLOdiffidato"/&gt;&lt;xsl:param name="SelectOLOdiffidatoFull"/&gt;&lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;&lt;tns:DatiVerificaControlliRequest&gt;&lt;parameters&gt;&lt;tns1:DatiVerificaControlliInput&gt;&lt;tns1:Operatore&gt;&lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;&lt;/tns1:Operatore&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$ControlloOLOdiffidatoIn/parameters/tns3:ControlloOLOdiffidato/tns2:IDRichiesta"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:DatiAccesso&gt;&lt;xsl:if test="$SelectOLOdiffidato/Record[1]/FLAG_DIFFIDATO"&gt;&lt;tns1:FlagOLODiffidato&gt;&lt;xsl:value-of select="$SelectOLOdiffidato/Record[1]/FLAG_DIFFIDATO"/&gt;&lt;/tns1:FlagOLODiffidato&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($SelectOLOdiffidatoFull/Record)"&gt;&lt;xsl:if test="$SelectOLOdiffidatoFull/Record[1]/FLAG_DIFFIDATO"&gt;&lt;tns1:FlagOLODiffidatoFull&gt;&lt;xsl:value-of select="$SelectOLOdiffidatoFull/Record[1]/FLAG_DIFFIDATO"/&gt;&lt;/tns1:FlagOLODiffidatoFull&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;/tns1:DatiAccesso&gt;&lt;/tns1:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
