                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloOLODiffidatoResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOLOdiffidato&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOLOdiffidatoFull&quot;/>&#xa;    &lt;xsl:template name=&quot;ControlloOLOdiffidatoOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ControlloOLOdiffidatoResponse>&#xa;            &lt;xsl:copy-of select=&quot;$ControlloOLODiffidatoResponse/tns1:Esito&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;tns1:DatiAccesso>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;string-length($SelectOLOdiffidato/Record[1]/FLAG_DIFFIDATO)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$SelectOLOdiffidato/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                    &lt;tns2:FlagOLODiffidato>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectOLOdiffidato/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                    &lt;/tns2:FlagOLODiffidato>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectOLOdiffidatoFull/Record) and string-length($SelectOLOdiffidatoFull/Record[1]/FLAG_DIFFIDATO)>0&quot;>&#xa;                                &lt;xsl:if test=&quot;$SelectOLOdiffidatoFull/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                    &lt;tns2:FlagOLODiffidatoFull>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectOLOdiffidatoFull/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                    &lt;/tns2:FlagOLODiffidatoFull>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:DatiAccesso>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ControlloOLOdiffidatoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
