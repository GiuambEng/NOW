                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d50670d1-43a7-4bd3-9b4f-7bb145169a84+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloOLOdiffidatoIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectOLOdiffidatoFull-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$ControlloOLOdiffidatoIn.parameters/tns1:Servizio = 'SEMIVULAFTTH'&quot;>&#xa;                    &lt;NOME_OFFERTA_ESTERNA>&#xa;                        &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                    &lt;/NOME_OFFERTA_ESTERNA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$ControlloOLOdiffidatoIn.parameters/tns1:Servizio = 'SEMIBITSTREAMNGAFTTH'&quot;>&#xa;                    &lt;NOME_OFFERTA_ESTERNA>&#xa;                        &lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&#xa;                    &lt;/NOME_OFFERTA_ESTERNA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NOME_OFFERTA_ESTERNA>&#xa;                        &lt;xsl:value-of select=&quot;'EASYIPNGAFTTH'&quot;/>&#xa;                    &lt;/NOME_OFFERTA_ESTERNA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn.parameters/tns1:Codice_OLO&quot;/>&#xa;            &lt;/COD_OLO>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ControlloOLOdiffidatoIn.parameters/tns1:DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn.parameters/tns1:DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ControlloOLOdiffidatoIn.parameters/tns1:DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn.parameters/tns1:DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ControlloOLOdiffidatoIn.parameters/tns1:DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn.parameters/tns1:DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ControlloOLOdiffidatoIn.parameters/tns1:DRO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn.parameters/tns1:DRO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DATAINZ_VALID>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.COD_OLO, C.ID_CONTRATTO, C.FLAG_DIFFIDATO, COC.DATAINZ_ASSOCZ_VALID, COC.DATAFI_ASSOCZ_VALID, C.DATAINZ_VALID, C.DATAFI_VALID &#xd;&#xa;FROM TRASCODFC_OFFERTA TRO, OFFERTA O, CONTRATTO C, CONTRATTO_OFFERTA_CATLG COC, TIPOLG_STATO_CONTRATTO CONTR&#xd;&#xa;WHERE TRO.NOME_OFFERTA_ESTERNA = ? AND TRO.PROVENIENZA = 'BPM'&#xd;&#xa;AND TRO.ID_OFFERTA = O.ID_OFFERTA AND TRO.ID_OFFERTA = COC.ID_OFFERTA&#xd;&#xa;AND COC.ID_CONTRATTO = C.ID_CONTRATTO &#xd;&#xa;AND C.COD_OLO = ?&#xd;&#xa;AND (COC.DATAFI_ASSOCZ_VALID > ? OR COC.DATAFI_ASSOCZ_VALID = NULL) &#xd;&#xa;AND COC.DATAINZ_ASSOCZ_VALID &lt; ? AND C.DATAFI_VALID > ? AND C.DATAINZ_VALID &lt; ? &#xd;&#xa;AND C.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = 'Active'&#xd;&#xa;ORDER BY C.FLAG_NPD desc, C.TIMSTP_INSMTO desc" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINZ_ASSOCZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckSemi" tibex:xpdlId="823d9323-06b9-4947-aeea-948dacda15e6">
                <bpws:targets>
                    <bpws:target linkName="ControlloOLODiffidatoResponseAssignToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckSemiToSelectOLOdiffidatoFull">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$ControlloOLOdiffidatoIn/parameters/ns1:ControlloOLOdiffidato/ns4:Lavorazione = ('ATTIVAZIONE', 'MIGRAZIONE', 'VARIAZIONE') and $ControlloOLOdiffidatoIn/parameters/ns1:ControlloOLOdiffidato/ns4:Servizio = ('SEMIVULAFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIEASYIPNGAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$ControlloOLOdiffidatoIn.parameters/ns4:Lavorazione = ('ATTIVAZIONE', 'MIGRAZIONE', 'VARIAZIONE') and $ControlloOLOdiffidatoIn.parameters/ns4:Servizio = ('SEMIVULAFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIEASYIPNGAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckSemiToDatiVerificaControlliInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;ControlloOLOdiffidatoIn&quot;/>&lt;xsl:param name=&quot;SelectOLOdiffidatoFull&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$ControlloOLOdiffidatoIn/parameters/tns4:ControlloOLOdiffidato/tns2:IDRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn/parameters/tns4:ControlloOLOdiffidato/tns2:IDRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Query SelectOLODiffidatoFull: &amp;quot;, tib:render-xml($SelectOLOdiffidatoFull, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_check&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$ControlloOLOdiffidatoIn/parameters/tns4:ControlloOLOdiffidato/tns2:IDRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn/parameters/tns4:ControlloOLOdiffidato/tns2:IDRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato_SUB-PROCESS&amp;quot;&quot;/>&lt;/tns:EventType>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogSelectOLODiffidatoFull-input"
                    name="LogSelectOLODiffidatoFull"
                    tibex:xpdlId="afcd93f6-8e19-4d24-83bc-ddb2481c5cc2"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectOLOdiffidatoFullToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogSelectOLODiffidatoFullToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloOLOdiffidatoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectOLOdiffidatoFull&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$ControlloOLOdiffidatoIn.parameters/tns2:IDRichiesta&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn.parameters/tns2:IDRichiesta&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Query SelectOLODiffidatoFull: &amp;quot;, tib:render-xml($SelectOLOdiffidatoFull, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_check&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato&amp;quot;&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;xsl:if test=&quot;$ControlloOLOdiffidatoIn.parameters/tns2:IDRichiesta&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$ControlloOLOdiffidatoIn.parameters/tns2:IDRichiesta&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ControlloOLODiffidato_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ControlloOLODiffidatoResponse"
                    name="ControlloOLODiffidatoFULLResponseAssign"
                    outputVariable="ControlloOLODiffidatoResponse"
                    tibex:xpdlId="4bf949ee-d6c5-417b-b46c-5d8970bbe2a3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogSelectOLODiffidatoFullToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ControlloOLODiffidatoFULLResponseAssignToControlloOLOdiffidatoOutput_RECORDFULLNO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SelectOLOdiffidatoFull/Record)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SelectOLOdiffidatoFull/Record)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="ControlloOLODiffidatoFULLResponseAssignToDatiVerificaControlliInvoke_RECORDFULLSI">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectOLOdiffidatoFull&quot;/>&lt;xsl:template name=&quot;ControlloOLODiffidatoResponse&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectOLOdiffidatoFull/Record)=0&quot;>&lt;tns:Controllo_OLO_diffidato_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:Controllo_OLO_diffidato_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectOLOdiffidatoFull/Record[1]/FLAG_DIFFIDATO=&amp;quot;Y&amp;quot;&quot;>&lt;tns:Controllo_OLO_diffidato_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:Controllo_OLO_diffidato_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Controllo_OLO_diffidato_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:Controllo_OLO_diffidato_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="ControlloOLODiffidatoResponse" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
