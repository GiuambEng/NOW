odice_OLO,&amp;quot;'&amp;quot;,' OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO =',&amp;quot;'&amp;quot;,$ControlloIDSLUCO/parameters/tns2:ControlloIDSLUCO/tns1:Codice_OLO,&amp;quot;'&amp;quot;,' ) OR CODFC_OLO_AGCOM IN (SELECT codfc_olo_agcom_condivisore FROM olo_colocazione WHERE codfc_olo_agcom_riferimento IN (SELECT CODFC_OLO_AGCOM  FROM OLO WHERE COD_OLO = ',&amp;quot;'&amp;quot;,$ControlloIDSLUCO/parameters/tns2:ControlloIDSLUCO/tns1:Codice_OLO,&amp;quot;'&amp;quot;,') and data_inizio &amp;lt; SYSDATE and data_fine > SYSDATE)) AND SYSDATE &amp;lt;= DATAFI_VALID AND SYSDATE >= DATAINZ_VALID')&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SQLDirect-input" name="SQLDirect"
