&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ControlloIDSLUCO_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns6:EventType>&#xa;                    &lt;/tns6:Identifier>&#xa;                    &lt;tns6:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns6:track_position>&#xa;                    &lt;tns6:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns6:Timestamp>&#xa;                &lt;/tns6:Envelope>&#xa;            &lt;/tns6:ActiveLoggerServices>&#xa;        &lt;/tns6:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
