                                    sqlStatement="SELECT DESCRIZIONE_AREA FROM ANAGRAFICA_ADR WHERE ID_ADR_CRMWS IN (SELECT ID_ADR_CRMWS FROM ANAGRAFICA_KIT_VLAN_ADR_CAR WHERE ID_KIT_AREA_CAR=?)" xsi:type="jdbcPalette:JDBCQueryActivity">
