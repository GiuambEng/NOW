                portType="ns4:EsitiMultipliPortType" tibex:xpdlId="62a5c6da-7af6-4df7-9947-9a59c7d1850d">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/EsitiMultipli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/" xmlns:tns2="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" xmlns:tns3="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns4="http://www.tim.com/NOW/xsd/Lock_Risorsa/" version="2.0"&gt;&lt;xsl:param name="VerificaOLInCorsoRisorseDonatingIn"/&gt;&lt;xsl:param name="LockConsistenzaDati"/&gt;&lt;xsl:template name="StoricizzaOL_2-input" match="/"&gt;&lt;tns:StoricizzaOLinCorsoRequest&gt;&lt;Input&gt;&lt;tns1:StoricizzaOLinCorsoRequest&gt;&lt;IdRisorsaBloccata&gt;&lt;xsl:value-of select="$VerificaOLInCorsoRisorseDonatingIn/input/tns2:Verifica_OL_In_Corso_Risorse_Donating_Request/tns2:ConsistenzaDati/tns3:IDRisorsa"/&gt;&lt;/IdRisorsaBloccata&gt;&lt;IdOlBloccante&gt;&lt;xsl:value-of select="$LockConsistenzaDati/Output/tns4:Output/tns4:Esito/tns4:Descrizione"/&gt;&lt;/IdOlBloccante&gt;
                                            &lt;!--Nella DESCRIZIONE di Lock è presente l'idOrdine NOW o CRMWS. da aggiornare con cambio interfaccia su output LockUnlock.--&gt;&lt;xsl:choose&gt;&lt;xsl:when test="starts-with($LockConsistenzaDati/Output/tns4:Output/tns4:Esito/tns4:Descrizione, &amp;quot;pvm&amp;quot;)"&gt;&lt;SistemaCoinvolto&gt;&lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;&lt;/SistemaCoinvolto&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;SistemaCoinvolto&gt;&lt;xsl:value-of select="&amp;quot;CRMWS&amp;quot;"/&gt;&lt;/SistemaCoinvolto&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$VerificaOLInCorsoRisorseDonatingIn/input/tns2:Verifica_OL_In_Corso_Risorse_Donating_Request/tns2:ConsistenzaDati/tns3:IDAsset"&gt;&lt;IdAsset&gt;&lt;xsl:value-of select="$VerificaOLInCorsoRisorseDonatingIn/input/tns2:Verifica_OL_In_Corso_Risorse_Donating_Request/tns2:ConsistenzaDati/tns3:IDAsset"/&gt;&lt;/IdAsset&gt;&lt;/xsl:if&gt;&lt;/tns1:StoricizzaOLinCorsoRequest&gt;&lt;/Input&gt;&lt;/tns:StoricizzaOLinCorsoRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/EsitiMultipli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LockConsistenzaDati.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaOLInCorsoRisorseDonatingIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;StoricizzaOL_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StoricizzaOLinCorsoRequest>&#xa;            &lt;IdRisorsaBloccata>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns2:ConsistenzaDati/tns3:IDRisorsa&quot;/>&#xa;            &lt;/IdRisorsaBloccata>&#xa;            &lt;IdOlBloccante>&#xa;                &lt;xsl:value-of select=&quot;$LockConsistenzaDati.Output/tns4:Esito/tns4:Descrizione&quot;/>&#xa;            &lt;/IdOlBloccante>&#xa;            &lt;!--Nella DESCRIZIONE di Lock è presente l'idOrdine NOW o CRMWS. da aggiornare con cambio interfaccia su output LockUnlock.-->&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with($LockConsistenzaDati.Output/tns4:Esito/tns4:Descrizione, &amp;quot;pvm&amp;quot;)&quot;>&#xa;                    &lt;SistemaCoinvolto>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;                    &lt;/SistemaCoinvolto>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;SistemaCoinvolto>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CRMWS&amp;quot;&quot;/>&#xa;                    &lt;/SistemaCoinvolto>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns2:ConsistenzaDati/tns3:IDAsset&quot;>&#xa;                &lt;IdAsset>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns2:ConsistenzaDati/tns3:IDAsset&quot;/>&#xa;                &lt;/IdAsset>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:StoricizzaOLinCorsoRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
