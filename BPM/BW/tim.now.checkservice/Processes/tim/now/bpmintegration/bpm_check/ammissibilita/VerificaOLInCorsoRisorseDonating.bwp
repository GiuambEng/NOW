            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaOLInCorsoRisorseDonatingIn&quot;/>&lt;xsl:param name=&quot;UnlockConsistenzaFonia&quot;/>&lt;xsl:template name=&quot;VerificaOLInCorsoRisorseDonatingResponse&quot; match=&quot;/&quot;>&lt;tns:Verifica_OL_In_Corso_Risorse_Donating_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;(not(exists($VerificaOLInCorsoRisorseDonatingIn/input/tns:Verifica_OL_In_Corso_Risorse_Donating_Request/tns:ConsistenzaFonia/tns1:IDRisorsa)) and not(exists($VerificaOLInCorsoRisorseDonatingIn/input/tns:Verifica_OL_In_Corso_Risorse_Donating_Request/tns:ConsistenzaDati/tns1:IDRisorsa))) or exists($UnlockConsistenzaFonia/Output/tns2:Output)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Verifica_OL_In_Corso_Risorse_Donating_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
