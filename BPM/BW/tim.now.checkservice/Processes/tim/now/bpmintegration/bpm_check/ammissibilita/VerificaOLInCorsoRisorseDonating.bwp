"$VerificaOLInCorsoRisorseDonatingIn/input/tns3:Verifica_OL_In_Corso_Risorse_Donating_Request/tns3:CodiceOrdineOLO"/&gt;&lt;/tns:CodiceOrdineOLO&gt;&lt;xsl:if test="$VerificaOLInCorsoRisorseDonatingIn/input/tns3:Verifica_OL_In_Corso_Risorse_Donating_Request/tns3:ConsistenzaFonia/tns2:IDAsset"&gt;&lt;tns:IdAsset&gt;&lt;xsl:value-of select="$VerificaOLInCorsoRisorseDonatingIn/input/tns3:Verifica_OL_In_Corso_Risorse_Donating_Request/tns3:ConsistenzaFonia/tns2:IDAsset"/&gt;&lt;/tns:IdAsset&gt;&lt;/xsl:if&gt;&lt;/tns:Input&gt;&lt;/Input&gt;&lt;/tns1:Lock_UnlockRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaOLInCorsoRisorseDonatingIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;UnlockConsistenzaFonia-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Input>&#xa;            &lt;tns:ID_Risorsa>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:ConsistenzaFonia/tns2:IDRisorsa&quot;/>&#xa;            &lt;/tns:ID_Risorsa>&#xa;            &lt;tns:Azione>&#xa;                &lt;xsl:value-of select=&quot;'UNLOCK'&quot;/>&#xa;            &lt;/tns:Azione>&#xa;            &lt;xsl:if test=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:ConsistenzaFonia/tns2:CodificaOLOAGCOMDonating&quot;>&#xa;                &lt;tns:CODIFICA_OLO_AGICOM>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:ConsistenzaFonia/tns2:CodificaOLOAGCOMDonating&quot;/>&#xa;                &lt;/tns:CODIFICA_OLO_AGICOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:SERVIZIO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:ConsistenzaFonia/tns2:Offerta&quot;/>&#xa;            &lt;/tns:SERVIZIO>&#xa;            &lt;tns:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns:ID_RICH_OLO>&#xa;            &lt;xsl:if test=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:Lavorazione&quot;>&#xa;                &lt;tns:Lavorazione>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:Lavorazione&quot;/>&#xa;                &lt;/tns:Lavorazione>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:CodiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:CodiceOrdineOLO&quot;/>&#xa;            &lt;/tns:CodiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:ConsistenzaFonia/tns2:IDAsset&quot;>&#xa;                &lt;tns:IdAsset>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaOLInCorsoRisorseDonatingIn.input/tns3:ConsistenzaFonia/tns2:IDAsset&quot;/>&#xa;                &lt;/tns:IdAsset>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
