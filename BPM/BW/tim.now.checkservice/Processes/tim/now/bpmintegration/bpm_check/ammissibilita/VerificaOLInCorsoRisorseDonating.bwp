                <bpws:sources>
                    <bpws:source linkName="LockOKToLockInvoke_ExistConsDatiAndAzioneD">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:ConsistenzaDati/tns2:IDRisorsa)>0 &#xd;&#xa;and &#xd;&#xa;($VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:ConsistenzaDati/tns2:Azione='D' &#xd;&#xa;or&#xd;&#xa;($VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:ConsistenzaDati/tns2:Azione='T' and &#xd;&#xa;$VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:Lavorazione='MIGRAZIONE' and contains($VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:ConsistenzaDati/tns2:Offerta,'BITSTREAMATMSIMMETRICO'))&#xd;&#xa;or ($VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:ConsistenzaDati/tns2:Azione='T' and &#xd;&#xa;$VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:Lavorazione='ATTIVAZIONE' and $VerificaOLInCorsoRisorseDonatingIn/input/tns1:Verifica_OL_In_Corso_Risorse_Donating_Request/tns1:SottoLavorazione='CAMBIOTECNOLOGIA'))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($VerificaOLInCorsoRisorseDonatingIn.input/tns1:ConsistenzaDati/tns2:IDRisorsa)>0 
and 
($VerificaOLInCorsoRisorseDonatingIn.input/tns1:ConsistenzaDati/tns2:Azione='D' 
or
($VerificaOLInCorsoRisorseDonatingIn.input/tns1:ConsistenzaDati/tns2:Azione='T' and 
$VerificaOLInCorsoRisorseDonatingIn.input/tns1:Lavorazione='MIGRAZIONE' and contains($VerificaOLInCorsoRisorseDonatingIn.input/tns1:ConsistenzaDati/tns2:Offerta,'BITSTREAMATMSIMMETRICO'))
or ($VerificaOLInCorsoRisorseDonatingIn.input/tns1:ConsistenzaDati/tns2:Azione='T' and 
$VerificaOLInCorsoRisorseDonatingIn.input/tns1:Lavorazione='ATTIVAZIONE' and $VerificaOLInCorsoRisorseDonatingIn.input/tns1:SottoLavorazione='CAMBIOTECNOLOGIA'))]]></bpws:transitionCondition>
                    </bpws:source>
