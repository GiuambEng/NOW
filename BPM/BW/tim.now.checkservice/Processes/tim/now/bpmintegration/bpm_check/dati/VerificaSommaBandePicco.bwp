                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SELECTIDOFFERTABP&quot;/>&lt;xsl:param name=&quot;Logger_Name&quot;/>&lt;xsl:param name=&quot;Logger_Level&quot;/>&lt;xsl:param name=&quot;VerificaSommaBandePicco&quot;/>&lt;xsl:template name=&quot;LogIdOfferta-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.bpm_check.dati'&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaSommaBandePicco&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'VerificaSommaBandePicco'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaSommaBandePicco/input/tns1:VerificaSommaBandePiccoRequest/tns1:IdRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaSommaBandePicco/input/tns1:VerificaSommaBandePiccoRequest/tns1:IdRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SELECTIDOFFERTABP/Record) > 0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Recuperato IdOfferta: &amp;quot;, string($SELECTIDOFFERTABP/Record[1]/ID_OFFERTA))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;OFFERTA NON TROVATA&amp;quot;&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Logger_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
