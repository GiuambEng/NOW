            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="a692a798-5116-45f2-8edc-79912d760152">
                <bpws:targets>
                    <bpws:target linkName="LogProfiliCommercialiToWhile_OK"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToRISULTATO"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($VerificaSommaBandePicco/input/ns9:VerificaSommaBandePiccoRequest/ns9:UserVlan)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($VerificaSommaBandePicco.input/ns9:UserVlan)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Assign1ToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="39777751-7def-44fe-9e28-06272b0b2eb9">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="6048e00a-24d5-4635-899d-6432dd4a7a39">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="(xsd:decimal(&#xd;&#xa;if(contains($VerificaSommaBandePicco/input/ns9:VerificaSommaBandePiccoRequest/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP, &quot;,&quot;)) &#xd;&#xa;then concat(substring-before($VerificaSommaBandePicco/input/ns9:VerificaSommaBandePiccoRequest/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP, &quot;,&quot;), &quot;.&quot;, substring-after($VerificaSommaBandePicco/input/ns9:VerificaSommaBandePiccoRequest/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP, &quot;,&quot;)) &#xd;&#xa;else $VerificaSommaBandePicco/input/ns9:VerificaSommaBandePiccoRequest/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP &#xd;&#xa;)) + $SommaUP"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="SommaUP"
                                    name="SommaUP"
                                    outputVariable="SommaUP"
                                    tibex:xpdlId="350e8b3b-1577-4762-94ba-301f155901db" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="(xsd:decimal(&#xd;&#xa;if(contains($VerificaSommaBandePicco.input/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP, &quot;,&quot;)) &#xd;&#xa;then concat(substring-before($VerificaSommaBandePicco.input/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP, &quot;,&quot;), &quot;.&quot;, substring-after($VerificaSommaBandePicco.input/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP, &quot;,&quot;)) &#xd;&#xa;else $VerificaSommaBandePicco.input/ns9:UserVlan[number($index)]/ns9:Banda_Picco_UP &#xd;&#xa;)) + $SommaUP" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="SommaUP" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
