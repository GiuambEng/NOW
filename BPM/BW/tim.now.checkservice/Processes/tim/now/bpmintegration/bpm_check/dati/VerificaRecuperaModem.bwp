                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODICEPROGETTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
