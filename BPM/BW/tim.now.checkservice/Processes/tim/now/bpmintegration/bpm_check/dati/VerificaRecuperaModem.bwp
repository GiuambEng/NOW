                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ric.CODIFICAOLOAGCOM, ric.CODICEPROGETTO&#xa;FROM BDS_1_CASEDATA_RICHIESTA ric, BDS_1_CASEDATA_ASSET ass&#xa;WHERE ass.IDASSET=? AND ass.IDPRIMOORDINE=ric.IDRICHIESTAOLO&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
