                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaAllineamentoConsistenzaCRMWS_&amp;quot;, $VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;                &lt;tns1:Playload>&#xa;                    &lt;tns1:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request)))&quot;/>&#xa;                    &lt;/tns1:Binary>&#xa;                    &lt;tns1:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request, true(), true())&quot;/>&#xa;                    &lt;/tns1:XMLString>&#xa;                &lt;/tns1:Playload>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
