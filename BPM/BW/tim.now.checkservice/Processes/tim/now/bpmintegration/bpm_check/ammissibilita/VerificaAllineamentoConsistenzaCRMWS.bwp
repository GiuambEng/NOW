                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($Lista/ns14:Risorsa) and $CheckEsito/ns11:Esito/ns11:Codice =true()]]></bpws:condition>
