                    name="Assign4" outputVariable="CheckEsito"
                    tibex:xpdlId="9c8d84ff-2924-49a3-be9e-6480ce843304" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToAssign4"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Assign4ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;CheckEsito&quot; match=&quot;/&quot;>&lt;tns:Verifica_Allineamento_Consistenza_CRMWS_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:Verifica_Allineamento_Consistenza_CRMWS_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="CheckEsito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;'tim.now.checkservice.application'&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:IDRichiestaOLO&quot;/>&lt;/tns1:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$Oscuramento/Record[1]/CONTEGGIO=0&quot;>&lt;tns1:Message>&lt;xsl:value-of select=&quot;&amp;quot;Disoscurato&amp;quot;&quot;/>&lt;/tns1:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Message>&lt;xsl:value-of select=&quot;&amp;quot;Oscurato&amp;quot;&quot;/>&lt;/tns1:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;tns1:ActiveLoggerServices>&lt;tns1:Envelope>&lt;tns1:Identifier>&lt;tns1:ServiceName>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.bpm.check.ammissibilita'&quot;/>&lt;/tns1:ServiceName>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&lt;/tns1:Operation>&lt;tns1:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns1:Source>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:IDRichiestaOLO&quot;/>&lt;/tns1:BusinessID>&lt;tns1:EventType>&lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;,&amp;quot;STARTED&amp;quot;)&quot;/>&lt;/tns1:EventType>&lt;tns1:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaAllineamentoConsistenzaCRMWS_&amp;quot;, $VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:IDRichiestaOLO)&quot;/>&lt;/tns1:trackID>&lt;/tns1:Identifier>&lt;tns1:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns1:track_position>&lt;tns1:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:Timestamp>&lt;/tns1:Envelope>&lt;tns1:Playload>&lt;tns1:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request)))&quot;/>&lt;/tns1:Binary>&lt;tns1:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request, true(), true())&quot;/>&lt;/tns1:XMLString>&lt;/tns1:Playload>&lt;/tns1:ActiveLoggerServices>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log_Oscuramento-input"
                    name="Log_Oscuramento"
                    tibex:xpdlId="c04bc2db-1aa4-496e-8d44-e103a735d234"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToAssign4">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Oscuramento/Record[1]/CONTEGGIO = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Oscuramento/Record[1]/CONTEGGIO = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GenericLoggerToEmpty"
                            tibex:faultDetailsVar="GenericLogger" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.checkservice.application'&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Oscuramento/Record[1]/CONTEGGIO=0&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Disoscurato&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Oscurato&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.bpm.check.ammissibilita'&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaAllineamentoConsistenzaCRMWS&amp;quot;,&amp;quot;STARTED&amp;quot;)&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaAllineamentoConsistenzaCRMWS_&amp;quot;, $VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;                &lt;tns1:Playload>&#xa;                    &lt;tns1:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaCompatibilitaLavorazioneIn.input)))&quot;/>&#xa;                    &lt;/tns1:Binary>&#xa;                    &lt;tns1:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VerificaCompatibilitaLavorazioneIn.input, true(), true())&quot;/>&#xa;                    &lt;/tns1:XMLString>&#xa;                &lt;/tns1:Playload>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
