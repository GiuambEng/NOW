                tibex:xpdlId="f40ded61-412b-4f3a-8e7d-551d5a1be325" variable="VerificaCompatibilitaLavorazioneOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/" xmlns:tns="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" version="2.0"&gt;
    &lt;xsl:param name="CheckEsito"/&gt;
    &lt;xsl:param name="VerificaCompatibilitaLavorazioneIn"/&gt;
    &lt;xsl:param name="VerificaAllineamentoConsistenzaCRMWS"/&gt;
    &lt;xsl:template name="VerificaCompatibilitaLavorazioneOut-input" match="/"&gt;
        &lt;tns2:VerificaAllineamentoConsistenzaCRMWSResponse&gt;
            &lt;output&gt;
                &lt;tns:Verifica_Allineamento_Consistenza_CRMWS_Response&gt;
                    &lt;tns:Esito&gt;
                        &lt;tns:Codice&gt;
                            &lt;xsl:value-of select="$CheckEsito/tns:Esito/tns:Codice"/&gt;
                        &lt;/tns:Codice&gt;
                        &lt;tns:Descrizione&gt;
                            &lt;xsl:value-of select="$CheckEsito/tns:Esito/tns:Descrizione"/&gt;
                        &lt;/tns:Descrizione&gt;
                    &lt;/tns:Esito&gt;
                    &lt;xsl:if test="$CheckEsito/tns:Esito/tns:Descrizione=&amp;quot;KO&amp;quot;"&gt;
                        &lt;tns:NOWResponse&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:Lavorazione = 'MIGRAZIONE' and exists($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:CodiceRisorsa2)"&gt;
                                    &lt;xsl:if test="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:CodiceRisorsa2"&gt;
                                        &lt;tns:IDRisorsa&gt;
                                            &lt;xsl:value-of select="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:CodiceRisorsa2"/&gt;
                                        &lt;/tns:IDRisorsa&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:when test="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:Lavorazione = 'MIGRAZIONE' and exists($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:CodiceRisorsa1) and not(exists($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:CodiceRisorsa2))"&gt;
                                    &lt;xsl:if test="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:CodiceRisorsa1"&gt;
                                        &lt;tns:IDRisorsa&gt;
                                            &lt;xsl:value-of select="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:CodiceRisorsa1"/&gt;
                                        &lt;/tns:IDRisorsa&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;xsl:if test="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:IDRisorsa"&gt;
                                        &lt;tns:IDRisorsa&gt;
                                            &lt;xsl:value-of select="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Allineamento_Consistenza_CRMWS_Request/tns:IDRisorsa"/&gt;
                                        &lt;/tns:IDRisorsa&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:if test="$VerificaAllineamentoConsistenzaCRMWS/Record[1]/TRANSACTION_ID"&gt;
                                &lt;tns:TransactionID&gt;
                                    &lt;xsl:value-of select="$VerificaAllineamentoConsistenzaCRMWS/Record[1]/TRANSACTION_ID"/&gt;
                                &lt;/tns:TransactionID&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns:NOWResponse&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns:Verifica_Allineamento_Consistenza_CRMWS_Response&gt;
            &lt;/output&gt;
        &lt;/tns2:VerificaAllineamentoConsistenzaCRMWSResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckEsito&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaAllineamentoConsistenzaCRMWS&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCompatibilitaLavorazioneOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Verifica_Allineamento_Consistenza_CRMWS_Response>&#xa;            &lt;tns:Esito>&#xa;                &lt;tns:Codice>&#xa;                    &lt;xsl:value-of select=&quot;$CheckEsito/tns:Esito/tns:Codice&quot;/>&#xa;                &lt;/tns:Codice>&#xa;                &lt;tns:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;$CheckEsito/tns:Esito/tns:Descrizione&quot;/>&#xa;                &lt;/tns:Descrizione>&#xa;            &lt;/tns:Esito>&#xa;            &lt;xsl:if test=&quot;$CheckEsito/tns:Esito/tns:Descrizione=&amp;quot;KO&amp;quot;&quot;>&#xa;                &lt;tns:NOWResponse>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = 'MIGRAZIONE' and exists($VerificaCompatibilitaLavorazioneIn.input/tns:CodiceRisorsa2)&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:CodiceRisorsa2&quot;>&#xa;                                &lt;tns:IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:CodiceRisorsa2&quot;/>&#xa;                                &lt;/tns:IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = 'MIGRAZIONE' and exists($VerificaCompatibilitaLavorazioneIn.input/tns:CodiceRisorsa1) and not(exists($VerificaCompatibilitaLavorazioneIn.input/tns:CodiceRisorsa2))&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:CodiceRisorsa1&quot;>&#xa;                                &lt;tns:IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:CodiceRisorsa1&quot;/>&#xa;                                &lt;/tns:IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRisorsa&quot;>&#xa;                                &lt;tns:IDRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRisorsa&quot;/>&#xa;                                &lt;/tns:IDRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;$VerificaAllineamentoConsistenzaCRMWS/Record[1]/TRANSACTION_ID&quot;>&#xa;                        &lt;tns:TransactionID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaAllineamentoConsistenzaCRMWS/Record[1]/TRANSACTION_ID&quot;/>&#xa;                        &lt;/tns:TransactionID>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:NOWResponse>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:Verifica_Allineamento_Consistenza_CRMWS_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
