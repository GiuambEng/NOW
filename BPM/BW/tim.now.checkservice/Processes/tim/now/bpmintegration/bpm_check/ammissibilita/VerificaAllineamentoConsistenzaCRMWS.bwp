onsistenzaCRMWS_&amp;quot;, $VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;                &lt;tns1:Playload>&#xa;                    &lt;tns1:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaCompatibilitaLavorazioneIn.input)))&quot;/>&#xa;                    &lt;/tns1:Binary>&#xa;                    &lt;tns1:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VerificaCompatibilitaLavorazioneIn.input, true(), true())&quot;/>&#xa;                    &lt;/tns1:XMLString>&#xa;                &lt;/tns1:Playload>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
