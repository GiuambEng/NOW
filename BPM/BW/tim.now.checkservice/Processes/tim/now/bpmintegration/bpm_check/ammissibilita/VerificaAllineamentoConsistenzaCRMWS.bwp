                                <bpws:link name="Assign1ToCallProcess2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery2ToCallProcess3" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogCheckRisorsaNumTelToEmpty1"
                                    tibex:label="RisorsaPresente" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcess3ToAssign1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
