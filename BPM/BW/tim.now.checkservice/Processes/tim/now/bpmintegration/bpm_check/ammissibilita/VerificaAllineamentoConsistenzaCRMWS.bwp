                    inputVariable="LogStartAllineamentoConsistenza-input"
                    name="LogStartAllineamentoConsistenza"
                    tibex:xpdlId="c58874f9-624f-4a6f-9736-ca38fdfa7926"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
