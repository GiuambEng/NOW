                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+490adfe4-1ab4-4e71-a026-ca573caae748+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery2-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NUMEROTELEFONICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdRisorsa)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMEROTELEFONICO>&lt;CODIFICAOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceOloAgCom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOloAgCom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLOAGCOM>&lt;COD_OLO_ACCORPANTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceOloAgCom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOloAgCom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO_ACCORPANTE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
