                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery3ToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+283c9ceb-627a-4856-9661-f59bec8bdb23+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery3-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;NUMEROTELEFONICO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdRisorsa)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdRisorsa&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NUMEROTELEFONICO>&lt;CODIFICAOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceOloAgCom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOloAgCom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLOAGCOM>&lt;COD_OLO_ACCORPANTE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:CodiceOloAgCom)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:CodiceOloAgCom&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO_ACCORPANTE>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &#xa;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&#xa;WHERE A.NUMEROTELEFONICO = ?&#xa;AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &#xa;AND (A.CODIFICAOLOAGCOM=? OR A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE=?)) &#xa;AND O.ID_OFFERTA=T.ID_OFFERTA &#xa;AND O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA &#xa;AND T.PROVENIENZA='BPM' &#xa;AND T.NOME_OFFERTA_ESTERNA=A.OFFERTA&#xa;AND F.DESCR !='REGOLATORIO'&#xa;ORDER BY LASTUPDATE DESC" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO_ACCORPANTE"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATOASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROFITTIZIO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME_OFFERTA_ESTERNA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDENTIFICATIVO_OFFERTA"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
