                    outputVariable="ResultBandePicco"
                    tibex:xpdlId="0363e1d8-9ec2-4b04-97d5-678fa6434dd0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
