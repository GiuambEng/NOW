            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1ae7dd0c-b9c1-41fd-9d3a-956cc3ad505e+input&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaEsistenzaVLANRIn&quot;/>&lt;xsl:template name=&quot;SelectBandaPiccoOfferta-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:Lavorazione='ATTIVAZIONE' or not(exists($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:Lavorazione)) or ($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:Lavorazione='MIGRAZIONE' and string-length($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:ProfiloTecnicoLinea)>0)&quot;>&lt;PROFILO_TCNC_LINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:ProfiloTecnicoLinea)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:ProfiloTecnicoLinea&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PROFILO_TCNC_LINEA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;PROFILO_TCNC_LINEA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:ProfiloTecnicoLineaCONS)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:ProfiloTecnicoLineaCONS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/PROFILO_TCNC_LINEA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:Offerta)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/NOME_OFFERTA_ESTERNA>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectBandaPiccoOfferta-input"
                    name="SelectBandaPiccoOfferta"
                    outputVariable="SelectBandaPiccoOfferta"
                    tibex:xpdlId="1ae7dd0c-b9c1-41fd-9d3a-956cc3ad505e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ControlloOffertaToJDBCQuery_OFFERTA"/>
