                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="number($index) &lt;= count($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan) and $Flag!='FALSE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[number($index) <= count($VerificaEsistenzaVLANRIn.input/tns:UserVlan) and $Flag!='FALSE']]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EmptyToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToEmpty" tibex:linkType="SUCCESSWITHCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="e5cc9a24-0c15-4e52-a445-4ad2f094832b">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(xsd:decimal(if(contains($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoDown, &quot;,&quot;)) then concat(substring-before($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoDown, &quot;,&quot;), &quot;.&quot;, substring-after($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoDown, &quot;,&quot;)) else $VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoDown)) &lt;= $ResultBandePicco/ns7:ResultBandePiccoProfilo[1]/ns7:PROFILO_COMMERCIALE_DOWN and (xsd:decimal(if(contains($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoUp, &quot;,&quot;)) then concat(substring-before($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoUp, &quot;,&quot;), &quot;.&quot;, substring-after($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoUp, &quot;,&quot;)) else $VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:BandaPiccoUp)) &lt;= $ResultBandePicco/ns7:ResultBandePiccoProfilo[1]/ns7:PROFILO_COMMERCIALE_UP and (($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Lavorazione = (&quot;ATTIVAZIONE&quot;, &quot;MIGRAZIONE&quot;) or not(exists($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Lavorazione))) or ($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Lavorazione = &quot;VARIAZIONE&quot; and $VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:SottoLavorazione = (&quot;INCREMENTODECREMENTOVC&quot;,&quot;VARIAZIONETAGGING&quot;) ))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[(xsd:decimal(if(contains($VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoDown, ",")) then concat(substring-before($VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoDown, ","), ".", substring-after($VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoDown, ",")) else $VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoDown)) <= $ResultBandePicco/ns7:ResultBandePiccoProfilo[1]/ns7:PROFILO_COMMERCIALE_DOWN and (xsd:decimal(if(contains($VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoUp, ",")) then concat(substring-before($VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoUp, ","), ".", substring-after($VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoUp, ",")) else $VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:BandaPiccoUp)) <= $ResultBandePicco/ns7:ResultBandePiccoProfilo[1]/ns7:PROFILO_COMMERCIALE_UP and (($VerificaEsistenzaVLANRIn.input/tns:Lavorazione = ("ATTIVAZIONE", "MIGRAZIONE") or not(exists($VerificaEsistenzaVLANRIn.input/tns:Lavorazione))) or ($VerificaEsistenzaVLANRIn.input/tns:Lavorazione = "VARIAZIONE" and $VerificaEsistenzaVLANRIn.input/tns:SottoLavorazione = ("INCREMENTODECREMENTOVC","VARIAZIONETAGGING") ))]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
