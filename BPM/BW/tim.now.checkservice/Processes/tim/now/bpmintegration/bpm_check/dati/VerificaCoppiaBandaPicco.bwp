                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignResultBandePiccoToLogSelectBandaPicco"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANRIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectBandaPiccoNOOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectBandaPiccoOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;ResultBandePicco&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ResultBandePicco>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaEsistenzaVLANRIn.input/tns1:Offerta)>0&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$SelectBandaPiccoOfferta/Record&quot;>&#xa;                        &lt;tns:ResultBandePiccoProfilo>&#xa;                            &lt;tns:PROFILO_COMMERCIALE_DOWN>&#xa;                                &lt;xsl:value-of select=&quot;PROFILO_COMMERCIALE_DOWN&quot;/>&#xa;                            &lt;/tns:PROFILO_COMMERCIALE_DOWN>&#xa;                            &lt;tns:PROFILO_COMMERCIALE_UP>&#xa;                                &lt;xsl:value-of select=&quot;PROFILO_COMMERCIALE_UP&quot;/>&#xa;                            &lt;/tns:PROFILO_COMMERCIALE_UP>&#xa;                        &lt;/tns:ResultBandePiccoProfilo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$SelectBandaPiccoNOOfferta/Record&quot;>&#xa;                        &lt;tns:ResultBandePiccoProfilo>&#xa;                            &lt;tns:PROFILO_COMMERCIALE_DOWN>&#xa;                                &lt;xsl:value-of select=&quot;PROFILO_COMMERCIALE_DOWN&quot;/>&#xa;                            &lt;/tns:PROFILO_COMMERCIALE_DOWN>&#xa;                            &lt;tns:PROFILO_COMMERCIALE_UP>&#xa;                                &lt;xsl:value-of select=&quot;PROFILO_COMMERCIALE_UP&quot;/>&#xa;                            &lt;/tns:PROFILO_COMMERCIALE_UP>&#xa;                        &lt;/tns:ResultBandePiccoProfilo>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ResultBandePicco>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
