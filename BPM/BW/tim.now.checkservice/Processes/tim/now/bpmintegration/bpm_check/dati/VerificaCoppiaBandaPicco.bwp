                            </bpws:empty>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaEsistenzaVLANRIn&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:template name=&quot;InputVerificaCoppiaBandaPicco-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCoppiaBandaPicco&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckDatiPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCoppiaBandaPicco&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Input: &amp;quot;, tib:render-xml($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkDati&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'VerificaCoppiaBandaPicco'&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;Verifica_Coppia_Banda_Picco_SUB_PROCESSED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Verifica_Coppia_Banda_Picco_SUB_PROCESSED&amp;quot;, $VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest/tns1:IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($VerificaEsistenzaVLANRIn/input/tns1:VerificaCoppiaBandaPiccoRequest, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="InputVerificaCoppiaBandaPicco-input"
                    name="InputVerificaCoppiaBandaPicco"
                    tibex:xpdlId="d5f3b592-cff2-4993-9e21-7fae529212da"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToInputVerificaCoppiaBandaPicco"/>
                        <bpws:target linkName="Empty3ToInputVerificaCoppiaBandaPicco"/>
                        <bpws:target linkName="SotRiconfToInputVerificaCoppiaBandaPicco"/>
                        <bpws:target linkName="Empty2ToInputVerificaCoppiaBandaPicco1"/>
                        <bpws:target linkName="Empty1ToInputVerificaCoppiaBandaPicco"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InputVerificaCoppiaBandaPiccoToControlloOfferta">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="upper-case($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Lavorazione) = ('ATTIVAZIONE', 'MIGRAZIONE') or (upper-case($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Lavorazione) = 'VARIAZIONE' and upper-case($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:SottoLavorazione) = ('INCREMENTODECREMENTOVC' , 'VARIAZIONETAGGING')) or not(exists($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Lavorazione))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[upper-case($VerificaEsistenzaVLANRIn.input/tns:Lavorazione) = ('ATTIVAZIONE', 'MIGRAZIONE') or (upper-case($VerificaEsistenzaVLANRIn.input/tns:Lavorazione) = 'VARIAZIONE' and upper-case($VerificaEsistenzaVLANRIn.input/tns:SottoLavorazione) = ('INCREMENTODECREMENTOVC' , 'VARIAZIONETAGGING')) or not(exists($VerificaEsistenzaVLANRIn.input/tns:Lavorazione))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="InputVerificaCoppiaBandaPiccoToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
