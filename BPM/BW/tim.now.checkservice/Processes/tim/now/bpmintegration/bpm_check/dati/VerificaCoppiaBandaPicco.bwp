                                tibex:group="groupEnd" tibex:xpdlId="bb5c4a5c-c397-4964-b2f8-fbc82d8b50f7">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    <bpws:target linkName="EmptyToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Lavorazione='VARIAZIONE' and ($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:SottoLavorazione='INCREMENTODECREMENTOVC' or $VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:SottoLavorazione='VARIAZIONETAGGING') and $VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:UserVlan[number($index)]/tns:AzioneUservlan!='A') then 'TRUE' else 'FALSE'"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Flag"
                                    name="JDBCQuery_Output"
                                    outputVariable="Flag"
                                    tibex:xpdlId="e17c52d1-9730-4b6e-8200-6af2d1ee0300" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($VerificaEsistenzaVLANRIn.input/tns:Lavorazione='VARIAZIONE' and ($VerificaEsistenzaVLANRIn.input/tns:SottoLavorazione='INCREMENTODECREMENTOVC' or $VerificaEsistenzaVLANRIn.input/tns:SottoLavorazione='VARIAZIONETAGGING') and $VerificaEsistenzaVLANRIn.input/tns:UserVlan[number($index)]/tns:AzioneUservlan!='A') then 'TRUE' else 'FALSE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
