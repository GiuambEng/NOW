                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($VerificaEsistenzaVLANRIn/input/tns:VerificaCoppiaBandaPiccoRequest/tns:Offerta)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
