                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns2=&quot;http://www.example.org/VariazioneVLAN_BMD&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapVLAN_Esistenti&quot;/>&#xa;    &lt;xsl:template name=&quot;GetProfiloBMD-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(starts-with(upper-case($Start/tns:Offerta), &amp;quot;VULA&amp;quot;) or starts-with(upper-case($Start/tns:Offerta), &amp;quot;SEMIVULA&amp;quot;)) and ($Start/tns:FlagNuovoModello = $MapVLAN_Esistenti/tns2:FlagNuovoModello) and $Start/tns:FlagNuovoModello ='Y'&quot;>&#xa;                &lt;tns:VerificaVLANBMDRequest>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                        &lt;tns:IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOLO&quot;>&#xa;                        &lt;tns:CodiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOLO&quot;/>&#xa;                        &lt;/tns:CodiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:CodiceOLOAGCOM&quot;>&#xa;                        &lt;tns:CodiceOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodiceOLOAGCOM&quot;/>&#xa;                        &lt;/tns:CodiceOLOAGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&#xa;                    &lt;/tns:Offerta>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Id_Risorsa&quot;>&#xa;                        &lt;tns:Id_Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Id_Risorsa&quot;/>&#xa;                        &lt;/tns:Id_Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:Ver_VLANBMD_Esistenti&quot;>&#xa;                        &lt;tns:Ver_VLANBMD>&#xa;                            &lt;xsl:if test=&quot;tns:IDDettaglioOrdine&quot;>&#xa;                                &lt;tns:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns:IDDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Profilo_BMD&quot;>&#xa;                                &lt;tns:Profilo_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Profilo_BMD&quot;/>&#xa;                                &lt;/tns:Profilo_BMD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_UP&quot;>&#xa;                                &lt;tns:Banda_Picco_UP>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_UP&quot;/>&#xa;                                &lt;/tns:Banda_Picco_UP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_DOWN&quot;>&#xa;                                &lt;tns:Banda_Picco_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_DOWN&quot;/>&#xa;                                &lt;/tns:Banda_Picco_DOWN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(../tns:ProfiloTecnicoLinea)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLinea&quot;>&#xa;                                        &lt;tns:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLinea&quot;/>&#xa;                                        &lt;/tns:ProfiloTecnicoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;>&#xa;                                        &lt;tns:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;/>&#xa;                                        &lt;/tns:ProfiloTecnicoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns:UserVlan_ID&quot;>&#xa;                                &lt;tns:UserVlan_ID>&#xa;                                    &lt;xsl:value-of select=&quot;tns:UserVlan_ID&quot;/>&#xa;                                &lt;/tns:UserVlan_ID>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;../tns:Id_Risorsa&quot;>&#xa;                                &lt;tns:ID_Risorsa>&#xa;                                    &lt;xsl:value-of select=&quot;../tns:Id_Risorsa&quot;/>&#xa;                                &lt;/tns:ID_Risorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:Ver_VLANBMD>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:Ver_VLANBMD&quot;>&#xa;                        &lt;tns:Ver_VLANBMD>&#xa;                            &lt;xsl:if test=&quot;tns:IDDettaglioOrdine&quot;>&#xa;                                &lt;tns:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns:IDDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Profilo_BMD&quot;>&#xa;                                &lt;tns:Profilo_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Profilo_BMD&quot;/>&#xa;                                &lt;/tns:Profilo_BMD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_UP&quot;>&#xa;                                &lt;tns:Banda_Picco_UP>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_UP&quot;/>&#xa;                                &lt;/tns:Banda_Picco_UP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_DOWN&quot;>&#xa;                                &lt;tns:Banda_Picco_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_DOWN&quot;/>&#xa;                                &lt;/tns:Banda_Picco_DOWN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(../tns:ProfiloTecnicoLinea)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLinea&quot;>&#xa;                                        &lt;tns:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLinea&quot;/>&#xa;                                        &lt;/tns:ProfiloTecnicoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;>&#xa;                                        &lt;tns:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;/>&#xa;                                        &lt;/tns:ProfiloTecnicoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns:UserVlan_ID&quot;>&#xa;                                &lt;tns:UserVlan_ID>&#xa;                                    &lt;xsl:value-of select=&quot;tns:UserVlan_ID&quot;/>&#xa;                                &lt;/tns:UserVlan_ID>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;../tns:Id_Risorsa&quot;>&#xa;                                &lt;tns:ID_Risorsa>&#xa;                                    &lt;xsl:value-of select=&quot;../tns:Id_Risorsa&quot;/>&#xa;                                &lt;/tns:ID_Risorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:Ver_VLANBMD>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Uservlan1Tagging&quot;>&#xa;                        &lt;tns:Uservlan1Tagging>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Uservlan1Tagging&quot;/>&#xa;                        &lt;/tns:Uservlan1Tagging>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:FlagNuovoModello&quot;>&#xa;                        &lt;tns:FlagNuovoModello>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:FlagNuovoModello&quot;/>&#xa;                        &lt;/tns:FlagNuovoModello>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Lavorazione&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Lavorazione&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Sottolavorazione&quot;>&#xa;                        &lt;tns:Sottolavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Sottolavorazione&quot;/>&#xa;                        &lt;/tns:Sottolavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Scenario&quot;>&#xa;                        &lt;tns:Scenario>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Scenario&quot;/>&#xa;                        &lt;/tns:Scenario>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:VerificaVLANBMDRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with(upper-case($Start/tns:Offerta), &amp;quot;VULA&amp;quot;) or starts-with(upper-case($Start/tns:Offerta), &amp;quot;SEMIVULA&amp;quot;)) and ($Start/tns:FlagNuovoModello = $MapVLAN_Esistenti/tns2:FlagNuovoModello) and $Start/tns:FlagNuovoModello !='Y'&quot;>&#xa;                &lt;tns:VerificaVLANBMDRequest>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                        &lt;tns:IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOLO&quot;>&#xa;                        &lt;tns:CodiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOLO&quot;/>&#xa;                        &lt;/tns:CodiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:CodiceOLOAGCOM&quot;>&#xa;                        &lt;tns:CodiceOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodiceOLOAGCOM&quot;/>&#xa;                        &lt;/tns:CodiceOLOAGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&#xa;                    &lt;/tns:Offerta>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Id_Risorsa&quot;>&#xa;                        &lt;tns:Id_Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Id_Risorsa&quot;/>&#xa;                        &lt;/tns:Id_Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:Ver_VLANBMD&quot;>&#xa;                        &lt;tns:Ver_VLANBMD>&#xa;                            &lt;xsl:if test=&quot;tns:IDDettaglioOrdine&quot;>&#xa;                                &lt;tns:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns:IDDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Profilo_BMD&quot;>&#xa;                                &lt;tns:Profilo_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Profilo_BMD&quot;/>&#xa;                                &lt;/tns:Profilo_BMD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_UP&quot;>&#xa;                                &lt;tns:Banda_Picco_UP>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_UP&quot;/>&#xa;                                &lt;/tns:Banda_Picco_UP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_DOWN&quot;>&#xa;                                &lt;tns:Banda_Picco_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_DOWN&quot;/>&#xa;                                &lt;/tns:Banda_Picco_DOWN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(../tns:ProfiloTecnicoLinea)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLinea&quot;>&#xa;                                        &lt;tns:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLinea&quot;/>&#xa;                                        &lt;/tns:ProfiloTecnicoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;>&#xa;                                        &lt;tns:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;/>&#xa;                                        &lt;/tns:ProfiloTecnicoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;tns:UserVlan_ID&quot;>&#xa;                                &lt;tns:UserVlan_ID>&#xa;                                    &lt;xsl:value-of select=&quot;tns:UserVlan_ID&quot;/>&#xa;                                &lt;/tns:UserVlan_ID>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;../tns:Id_Risorsa&quot;>&#xa;                                &lt;tns:ID_Risorsa>&#xa;                                    &lt;xsl:value-of select=&quot;../tns:Id_Risorsa&quot;/>&#xa;                                &lt;/tns:ID_Risorsa>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:Ver_VLANBMD>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Uservlan1Tagging&quot;>&#xa;                        &lt;tns:Uservlan1Tagging>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Uservlan1Tagging&quot;/>&#xa;                        &lt;/tns:Uservlan1Tagging>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:FlagNuovoModello&quot;>&#xa;                        &lt;tns:FlagNuovoModello>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:FlagNuovoModello&quot;/>&#xa;                        &lt;/tns:FlagNuovoModello>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Lavorazione&quot;>&#xa;                        &lt;tns:Lavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Lavorazione&quot;/>&#xa;                        &lt;/tns:Lavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Sottolavorazione&quot;>&#xa;                        &lt;tns:Sottolavorazione>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Sottolavorazione&quot;/>&#xa;                        &lt;/tns:Sottolavorazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Scenario&quot;>&#xa;                        &lt;tns:Scenario>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Scenario&quot;/>&#xa;                        &lt;/tns:Scenario>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:VerificaVLANBMDRequest>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with(upper-case($Start/tns:Offerta), &amp;quot;VULA&amp;quot;) or starts-with(upper-case($Start/tns:Offerta), &amp;quot;SEMIVULA&amp;quot;)) and $Start/tns:FlagNuovoModello != $MapVLAN_Esistenti/tns2:FlagNuovoModello&quot;>&#xa;                &lt;tns:VerificaVLANBMDRequest>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&#xa;                        &lt;tns:IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:IDRichiestaOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:CodiceOrdineOLO&quot;>&#xa;                        &lt;tns:CodiceOrdineOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodiceOrdineOLO&quot;/>&#xa;                        &lt;/tns:CodiceOrdineOLO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:CodiceOLOAGCOM&quot;>&#xa;                        &lt;tns:CodiceOLOAGCOM>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:CodiceOLOAGCOM&quot;/>&#xa;                        &lt;/tns:CodiceOLOAGCOM>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Offerta>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&#xa;                    &lt;/tns:Offerta>&#xa;                    &lt;xsl:if test=&quot;$Start/tns:Id_Risorsa&quot;>&#xa;                        &lt;tns:Id_Risorsa>&#xa;                            &lt;xsl:value-of select=&quot;$Start/tns:Id_Risorsa&quot;/>&#xa;                        &lt;/tns:Id_Risorsa>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:for-each select=&quot;$Start/tns:Ver_VLANBMD&quot;>&#xa;                        &lt;tns:Ver_VLANBMD>&#xa;                            &lt;xsl:if test=&quot;tns:IDDettaglioOrdine&quot;>&#xa;                                &lt;tns:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns:IDDettaglioOrdine>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Profilo_BMD&quot;>&#xa;                                &lt;tns:Profilo_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Profilo_BMD&quot;/>&#xa;                                &lt;/tns:Profilo_BMD>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_UP&quot;>&#xa;                                &lt;tns:Banda_Picco_UP>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_UP&quot;/>&#xa;                                &lt;/tns:Banda_Picco_UP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_DOWN&quot;>&#xa;                                &lt;tns:Banda_Picco_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_DOWN&quot;/>&#xa;                                &lt;/tns:Banda_Picco_DOWN>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(../tns:ProfiloTecnicoLinea)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLinea&quot;>&#xa;                                        &lt;tns:ProfiloTecnicoLinea>&#xa;                                            &lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLinea&quot;/>&#xa;                                        &lt;/tns:ProfiloTecnicoLinea>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;../tns:ProfiloTecnicoLineaEsistente&qu