                            <tibex:inputBindings>
                                <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.org/VariazioneVLAN_BMD&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;MapVLAN_Esistenti-input&quot; match=&quot;/&quot;>&lt;tns1:VLAN>&lt;xsl:variable name=&quot;CountExistVLAN&quot; select=&quot;count($Start/tns:Ver_VLANBMD_Esistenti)&quot;/>&#xa;                    &lt;!--Vengono mappate tutte le VLAN Esistenti nei complex Ver_VLAN_Esistenti. I dati verranno utilizzati anche più in basso, quando si determinerà il tipo di modello attualmente esistente.-->&lt;xsl:for-each select=&quot;$Start/tns:Ver_VLANBMD_Esistenti&quot;>&lt;tns1:VLAN_Version>&lt;tns1:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns1:IDDettaglioOrdine>&lt;xsl:if test=&quot;tns:Profilo_BMD&quot;>&lt;tns1:Profilo_BMD>&lt;xsl:value-of select=&quot;tns:Profilo_BMD&quot;/>&lt;/tns1:Profilo_BMD>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Banda_Picco_UP&quot;>&lt;tns1:Banda_Picco_UP>&lt;xsl:value-of select=&quot;tns:Banda_Picco_UP&quot;/>&lt;/tns1:Banda_Picco_UP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:Banda_Picco_DOWN&quot;>&lt;tns1:Banda_Picco_DOWN>&lt;xsl:value-of select=&quot;tns:Banda_Picco_DOWN&quot;/>&lt;/tns1:Banda_Picco_DOWN>&lt;/xsl:if>&lt;xsl:if test=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;>&lt;tns1:ProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;../tns:ProfiloTecnicoLineaEsistente&quot;/>&lt;/tns1:ProfiloTecnicoLinea>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:UserVlan_ID&quot;>&lt;tns1:UserVlan_ID>&lt;xsl:value-of select=&quot;tns:UserVlan_ID&quot;/>&lt;/tns1:UserVlan_ID>&lt;/xsl:if>&lt;/tns1:VLAN_Version>&lt;/xsl:for-each>&#xa;                                                                                                &lt;!--In base agli SVLANCODE presenti, si calcola che tipo di modello sia presente attualmente.&#xa;Se tutti gli SVLANCODE sono uguali, allora si avrà un nuovo modello, altrimenti sarà vecchio. Questo calcolo servirà in seguito, quando determinerà il calcolo del profilo BMD necessario.-->&lt;xsl:choose>&lt;xsl:when test=&quot;$CountExistVLAN=1&quot;>&lt;tns1:FlagNuovoModello>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FlagNuovoModello>&lt;/xsl:when>&lt;xsl:when test=&quot;$CountExistVLAN=2 and $Start/tns:Ver_VLANBMD_Esistenti[1]/tns:SVLANCODE = $Start/tns:Ver_VLANBMD_Esistenti[2]/tns:SVLANCODE&quot;>&lt;tns1:FlagNuovoModello>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FlagNuovoModello>&lt;/xsl:when>&lt;xsl:when test=&quot;$CountExistVLAN=3 and &amp;#xD;&amp;#xA;($Start/tns:Ver_VLANBMD_Esistenti[1]/tns:SVLANCODE = $Start/tns:Ver_VLANBMD_Esistenti[2]/tns:SVLANCODE and &amp;#xD;&amp;#xA;$Start/tns:Ver_VLANBMD_Esistenti[1]/tns:SVLANCODE = $Start/tns:Ver_VLANBMD_Esistenti[3]/tns:SVLANCODE)&quot;>&lt;tns1:FlagNuovoModello>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FlagNuovoModello>&lt;/xsl:when>&lt;xsl:when test=&quot;$CountExistVLAN=4 and &amp;#xD;&amp;#xA;($Start/tns:Ver_VLANBMD_Esistenti[1]/tns:SVLANCODE = $Start/tns:Ver_VLANBMD_Esistenti[2]/tns:SVLANCODE and &amp;#xD;&amp;#xA;$Start/tns:Ver_VLANBMD_Esistenti[1]/tns:SVLANCODE = $Start/tns:Ver_VLANBMD_Esistenti[3]/tns:SVLANCODE and&amp;#xD;&amp;#xA;$Start/tns:Ver_VLANBMD_Esistenti[1]/tns:SVLANCODE = $Start/tns:Ver_VLANBMD_Esistenti[4]/tns:SVLANCODE)&quot;>&lt;tns1:FlagNuovoModello>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FlagNuovoModello>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:FlagNuovoModello>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:FlagNuovoModello>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:VLAN>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <tibex:config>
                                <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:VariazioneVLAN_BMD="http://www.example.org/VariazioneVLAN_BMD"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="VariazioneVLAN_BMD:VLAN" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                </bwext:BWActivity>
                            </tibex:config>
                        </tibex:activityExtension>
                    </bpws:extensionActivity>
                </bpws:flow>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
