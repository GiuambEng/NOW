                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Input_LOG-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VariazioneVLAN_BMD&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VariazioneVLAN_BMD&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;VariazioneVLAN_BMD | IdRichiestaOLO: &amp;quot;, $Start/tns1:IDRichiestaOLO, &amp;quot; |Offerta: &amp;quot;, $Start/tns1:Offerta)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkDati&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'VerificaVLANBMD'&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;Verifica_VLANBMD_SUB_PROCESSED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Verifica_VLANBMD_SUB_PROCESSED_&amp;quot;, $Start/tns1:IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($Start)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($Start, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="Output_LOG-input"
                    name="Output_LOG"
                    tibex:xpdlId="83786b23-c534-4631-90b8-783ad1e5e72c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToOutput_LOG"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcess1ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VariazioneVLAN_BMD&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VariazioneVLAN_BMD&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;VariazioneVLAN_BMD | IdRichiestaOLO: &amp;quot;, $Start/tns1:IDRichiestaOLO,&amp;quot; |Offerta: &amp;quot;, $Start/tns1:Offerta)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="GetProfiloBMD-input"
                name="GetProfiloBMD" operation="VerificaVLANBMD"
                outputVariable="GetProfiloBMD"
                partnerLink="GetProfiloBMD"
                portType="ns10:BPM_CheckDatiPortType" tibex:xpdlId="db88448d-3425-4e8e-af22-5e91938882d7">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" xmlns:tns2="http://www.example.org/VariazioneVLAN_BMD" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="MapVLAN_Esistenti"/&gt;&lt;xsl:template name="GetProfiloBMD-input" match="/"&gt;&lt;tns1:VerificaVLANBMDRequest&gt;&lt;input&gt;&lt;xsl:choose&gt;&lt;xsl:when test="(starts-with(upper-case($Start/tns:Offerta), &amp;quot;VULA&amp;quot;) or starts-with(upper-case($Start/tns:Offerta), &amp;quot;SEMIVULA&amp;quot;)) and ($Start/tns:FlagNuovoModello = $MapVLAN_Esistenti/tns2:FlagNuovoModello) and $Start/tns:FlagNuovoModello ='Y'"&gt;&lt;tns:VerificaVLANBMDRequest&gt;&lt;xsl:if test="$Start/tns:IDRichiestaOLO"&gt;&lt;tns:IDRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns:IDRichiestaOLO"/&gt;&lt;/tns:IDRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:CodiceOrdineOLO"&gt;&lt;tns:CodiceOrdineOLO&gt;&lt;xsl:value-of select="$Start/tns:CodiceOrdineOLO"/&gt;&lt;/tns:CodiceOrdineOLO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:CodiceOLOAGCOM"&gt;&lt;tns:CodiceOLOAGCOM&gt;&lt;xsl:value-of select="$Start/tns:CodiceOLOAGCOM"/&gt;&lt;/tns:CodiceOLOAGCOM&gt;&lt;/xsl:if&gt;&lt;tns:Offerta&gt;&lt;xsl:value-of select="$Start/tns:Offerta"/&gt;&lt;/tns:Offerta&gt;&lt;xsl:if test="$Start/tns:Id_Risorsa"&gt;&lt;tns:Id_Risorsa&gt;&lt;xsl:value-of select="$Start/tns:Id_Risorsa"/&gt;&lt;/tns:Id_Risorsa&gt;&lt;/xsl:if&gt;&lt;xsl:for-each select="$Start/tns:Ver_VLANBMD_Esistenti"&gt;&lt;tns:Ver_VLANBMD&gt;&lt;xsl:if test="tns:IDDettaglioOrdine"&gt;&lt;tns:IDDettaglioOrdine&gt;&lt;xsl:value-of select="tns:IDDettaglioOrdine"/&gt;&lt;/tns:IDDettaglioOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:Profilo_BMD"&gt;&lt;tns:Profilo_BMD&gt;&lt;xsl:value-of select="tns:Profilo_BMD"/&gt;&lt;/tns:Profilo_BMD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:Banda_Picco_UP"&gt;&lt;tns:Banda_Picco_UP&gt;&lt;xsl:value-of select="tns:Banda_Picco_UP"/&gt;&lt;/tns:Banda_Picco_UP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:Banda_Picco_DOWN"&gt;&lt;tns:Banda_Picco_DOWN&gt;&lt;xsl:value-of select="tns:Banda_Picco_DOWN"/&gt;&lt;/tns:Banda_Picco_DOWN&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(../tns:ProfiloTecnicoLinea)&gt;0"&gt;&lt;xsl:if test="../tns:ProfiloTecnicoLinea"&gt;&lt;tns:ProfiloTecnicoLinea&gt;&lt;xsl:value-of select="../tns:ProfiloTecnicoLinea"/&gt;&lt;/tns:ProfiloTecnicoLinea&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="../tns:ProfiloTecnicoLineaEsistente"&gt;&lt;tns:ProfiloTecnicoLinea&gt;&lt;xsl:value-of select="../tns:ProfiloTecnicoLineaEsistente"/&gt;&lt;/tns:ProfiloTecnicoLinea&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="tns:UserVlan_ID"&gt;&lt;tns:UserVlan_ID&gt;&lt;xsl:value-of select="tns:UserVlan_ID"/&gt;&lt;/tns:UserVlan_ID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="../tns:Id_Risorsa"&gt;&lt;tns:ID_Risorsa&gt;&lt;xsl:value-of select="../tns:Id_Risorsa"/&gt;&lt;/tns:ID_Risorsa&gt;&lt;/xsl:if&gt;&lt;/tns:Ver_VLANBMD&gt;&lt;/xsl:for-each&gt;&lt;xsl:for-each select="$Start/tns:Ver_VLANBMD"&gt;&lt;tns:Ver_VLANBMD&gt;&lt;xsl:if test="tns:IDDettaglioOrdine"&gt;&lt;tns:IDDettaglioOrdine&gt;&lt;xsl:value-of select="tns:IDDettaglioOrdine"/&gt;&lt;/tns:IDDettaglioOrdine&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:Profilo_BMD"&gt;&lt;tns:Profilo_BMD&gt;&lt;xsl:value-of select="tns:Profilo_BMD"/&gt;&lt;/tns:Profilo_BMD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:Banda_Picco_UP"&gt;&lt;tns:Banda_Picco_UP&gt;&lt;xsl:value-of select="tns:Banda_Picco_UP"/&gt;&lt;/tns:Banda_Picco_UP&gt;&lt;/xsl:if&gt;&lt;xsl:if test="tns:Banda_Picco_DOWN"&gt;&lt;tns:Banda_Picco_DOWN&gt;&lt;xsl:value-of select="tns:Banda_Picco_DOWN"/&gt;&lt;/tns:Banda_Picco_DOWN&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="string-length(../tns:ProfiloTecnicoLinea)&gt;0"&gt;&lt;xsl:if test="../tns:ProfiloTecnicoLinea"&gt;&lt;tns:ProfiloTecnicoLinea&gt;&lt;xsl:value-of select="../tns:ProfiloTecnicoLinea"/&gt;&lt;/tns:ProfiloTecnicoLinea&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="../tns:ProfiloTecnicoLineaEsistente"&gt;&lt;tns:ProfiloTecnicoLinea&gt;&lt;xsl:value-of select="../tns:ProfiloTecnicoLineaEsistente"/&gt;&lt;/tns:ProfiloTecnicoLinea&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="tns:UserVlan_ID"&gt;&lt;tns:UserVlan_ID&gt;&lt;xsl:value-of select="tns:UserVlan_ID"/&gt;&lt;/tns:UserVlan_ID&gt;&lt;/xsl:if&gt;&lt;xsl:if test="../tns:Id_Risorsa"&gt;&lt;tns:ID_Risorsa&gt;&lt;xsl:value-of select="../tns:Id_Risorsa"/&gt;&lt;/tns:ID_Risorsa&gt;&lt;/xsl:if&gt;&lt;/tns:Ver_VLANBMD&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$Start/tns:Uservlan1Tagging"&gt;&lt;tns:Uservlan1Tagging&gt;&lt;xsl:value-of select="$Start/tns:Uservlan1Tagging"/&gt;&lt;/tns:Uservlan1Tagging&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:FlagNuovoModello"&gt;&lt;tns:FlagNuovoModello&gt;&lt;xsl:value-of select="$Start/tns:FlagNuovoModello"/&gt;&lt;/tns:FlagNuovoModello&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:Lavorazione"&gt;&lt;tns:Lavorazione&gt;&lt;xsl:value-of select="$Start/tns:Lavorazione"/&gt;&lt;/tns:Lavorazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:Sottolavorazione"&gt;&lt;tns:Sottolavorazione&gt;&lt;xsl:value-of select="$Start/tns:Sottolavorazione"/&gt;&lt;/tns:Sottolavorazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns:Scenario"&gt;&lt;tns:Scenario&gt;&lt;xsl:value-of select="$Start/tns:Scenario"/&gt;&lt;/tns:Scenario&gt;&lt;/xsl:if&gt;&lt;/tns:VerificaVLANBMDRequest&gt;&lt;/xsl:when&gt;&lt;xsl:when test="(starts-with(upper-case($Start/tns:Offerta), &amp;quot;VULA&amp;quot;) or starts-with(upper-case($Start/tns:Offerta), &amp;quot;SEMIVULA&amp;quot;)) and ($Start/tns:FlagNuovoModello = $MapVLAN_Esistenti/tns2:FlagNuovoModello) and $Start/tns:FlagNuovoModello !='Y'"&gt;&lt;tns:VerificaVLANBMDRequest&gt;&lt;xsl:if test="$Start/tn