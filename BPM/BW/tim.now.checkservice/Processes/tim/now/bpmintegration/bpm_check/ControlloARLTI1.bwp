            <bpws:empty name="Empty" tibex:xpdlId="bc372d68-f681-42d6-bc72-49e293ba6db5">
                <bpws:targets>
                    <bpws:target linkName="AssignVarificaPosizioneARLTIToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToJDBCQuery1_COLOCATO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToSelectIDSLUCO">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($Oscuramento/Record)>0 and  ($Oscuramento/Record[1]/FLAG_OSCURMENTO='1' or $Oscuramento/Record[1]/FLAG_OSCURMENTO='Y' )" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($Oscuramento/Record)>0 and  ($Oscuramento/Record[1]/FLAG_OSCURMENTO='1' or $Oscuramento/Record[1]/FLAG_OSCURMENTO='Y' )]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+af78a5a1-454e-47e0-9c54-b1f5033a8a20+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ControlloARLTI1In&quot;/>&lt;xsl:template name=&quot;JDBCQueryColocato-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;Idsluco>&lt;xsl:value-of select=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:IDSLUCO&quot;/>&lt;/Idsluco>&lt;cod_olo>&lt;xsl:value-of select=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:Codice_OLO&quot;/>&lt;/cod_olo>&lt;cod_olo1>&lt;xsl:value-of select=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:Codice_OLO&quot;/>&lt;/cod_olo1>&lt;cod_olo2>&lt;xsl:value-of select=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:Codice_OLO&quot;/>&lt;/cod_olo2>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCQueryColocato-input"
                    name="JDBCQueryColocato"
                    outputVariable="JDBCQueryColocato"
                    tibex:xpdlId="af78a5a1-454e-47e0-9c54-b1f5033a8a20" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery1_COLOCATO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery1ToLogSelectIDSLUCO"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+af78a5a1-454e-47e0-9c54-b1f5033a8a20+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloARLTI1In.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQueryColocato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;Idsluco>&#xa;                &lt;xsl:value-of select=&quot;$ControlloARLTI1In.parameters/tns1:IDSLUCO&quot;/>&#xa;            &lt;/Idsluco>&#xa;            &lt;cod_olo>&#xa;                &lt;xsl:value-of select=&quot;$ControlloARLTI1In.parameters/tns1:Codice_OLO&quot;/>&#xa;            &lt;/cod_olo>&#xa;            &lt;cod_olo1>&#xa;                &lt;xsl:value-of select=&quot;$ControlloARLTI1In.parameters/tns1:Codice_OLO&quot;/>&#xa;            &lt;/cod_olo1>&#xa;            &lt;cod_olo2>&#xa;                &lt;xsl:value-of select=&quot;$ControlloARLTI1In.parameters/tns1:Codice_OLO&quot;/>&#xa;            &lt;/cod_olo2>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT C.CODFC_OLO_AGCOM, C.COPPIA_A, C.COPPIA_DA FROM CLC_IDSLUCO C WHERE C.IDSLUCO =? AND C.CODFC_OLO_AGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = ? OR COD_OLO_ACCORPANTE IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = ?) OR CODFC_OLO_AGCOM IN (SELECT codfc_olo_agcom_condivisore FROM olo_colocazione WHERE codfc_olo_agcom_riferimento IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO = ?)))"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Idsluco"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_olo"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_olo1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="cod_olo2"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="COPPIA_A"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="COPPIA_DA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
