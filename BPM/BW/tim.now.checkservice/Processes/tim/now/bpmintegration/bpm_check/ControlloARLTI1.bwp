                &lt;/tns2:ControlloARLTI1Response&gt;
            &lt;/parameters&gt;
        &lt;/tns2:ControlloARLTI1Response&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloARLTI1Response&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyOutVarificaPosizioneARLTI-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:ControlloARLTI1Response>&#xa;            &lt;tns1:Esito>&#xa;                &lt;tns1:Codice>&#xa;                    &lt;xsl:value-of select=&quot;$ControlloARLTI1Response/tns1:Esito/tns1:Codice&quot;/>&#xa;                &lt;/tns1:Codice>&#xa;                &lt;tns1:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;$ControlloARLTI1Response/tns1:Esito/tns1:Descrizione&quot;/>&#xa;                &lt;/tns1:Descrizione>&#xa;            &lt;/tns1:Esito>&#xa;        &lt;/tns2:ControlloARLTI1Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
