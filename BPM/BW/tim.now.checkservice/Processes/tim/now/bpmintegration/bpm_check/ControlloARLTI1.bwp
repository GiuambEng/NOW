                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="e575cb60-5102-4ff4-840c-1804efb3bf65">
                <bpws:targets>
                    <bpws:target linkName="LogSelectIDSLUCOToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToAssign"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+955f8936-3549-4363-9e7f-f258747afd8f" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="if (count($SelectIDSLUCO/Record)>0) then $index &lt;= count($SelectIDSLUCO/Record) else  $index &lt;= count($JDBCQueryColocato/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[if (count($SelectIDSLUCO/Record)>0) then $index <= count($SelectIDSLUCO/Record) else  $index <= count($JDBCQueryColocato/Record)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="Mapper_EsitoToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToMapperEsito" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogMapperEsitoToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="df7ad330-d4ba-4b80-8b9b-af893c67c940">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToMapperEsito"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="955f8936-3549-4363-9e7f-f258747afd8f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogMapperEsitoToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperEsito</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;ControlloARLTI1In&quot;/>&lt;xsl:param name=&quot;SelectIDSLUCO&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;JDBCQueryColocato&quot;/>&lt;xsl:template name=&quot;MapperEsito-input&quot; match=&quot;/&quot;>&lt;tns1:Controllo_ARLTI1_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;(xsd:int($ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:Posizione_ARL_TI_1) >= xsd:int($SelectIDSLUCO/Record[number($index)]/COPPIA_DA) and xsd:int($ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:Posizione_ARL_TI_1) &amp;lt;= xsd:int($SelectIDSLUCO/Record[number($index)]/COPPIA_A)) and count($Oscuramento/Record/FLAG_OSCURMENTO)>0&quot;>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;xsd:int($ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:Posizione_ARL_TI_1) >= xsd:int($JDBCQueryColocato/Record[number($index)]/COPPIA_DA) and xsd:int($ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:Posizione_ARL_TI_1) &amp;lt;= xsd:int($JDBCQueryColocato/Record[number($index)]/COPPIA_A)&quot;>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:Controllo_ARLTI1_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapperEsito-input"
                                    name="MapperEsito"
                                    outputVariable="MapperEsito"
                                    tibex:xpdlId="1a29b115-0707-4ac5-8001-6e7c7389eb63" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
