            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ControlloARLTI1In&quot;/>&lt;xsl:param name=&quot;SelectIDSLUCO&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;JDBCQueryColocato&quot;/>&lt;xsl:template name=&quot;LogSelectIDSLUCO-input&quot; match=&quot;/&quot;>&lt;tns3:CW_BUS_MESSAGE>&lt;tns3:GenericLogger>&lt;tns3:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns3:Application>&lt;tns3:Process>&lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1&amp;quot;&quot;/>&lt;/tns3:Process>&lt;tns3:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&lt;/tns3:Service>&lt;tns3:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1&amp;quot;&quot;/>&lt;/tns3:Operation>&lt;xsl:if test=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:IDRichiesta&quot;>&lt;tns3:BusinessID>&lt;xsl:value-of select=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:IDRichiesta&quot;/>&lt;/tns3:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectIDSLUCO/Record)>0&quot;>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Controllo ARLTI1 output query, count: &amp;quot;, string(count($SelectIDSLUCO/Record)), &amp;quot;, &amp;quot;, tib:render-xml($SelectIDSLUCO, true(), true()))&quot;/>&lt;/tns3:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;count($JDBCQueryColocato/Record)>0&quot;>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Controllo ARLTI1 output query COLOCATO, count: &amp;quot;, string(count($JDBCQueryColocato/Record)), &amp;quot;, &amp;quot;, tib:render-xml($JDBCQueryColocato, true(), true()))&quot;/>&lt;/tns3:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:Message>&lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&lt;/tns3:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns3:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns3:LoggerName>&lt;tns3:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns3:LogLevel>&lt;tns3:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns3:LogJMS>&lt;/tns3:GenericLogger>&lt;tns3:ActiveLoggerServices>&lt;tns3:Envelope>&lt;tns3:Identifier>&lt;tns3:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_check&amp;quot;&quot;/>&lt;/tns3:ServiceName>&lt;tns3:Operation>&lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1&amp;quot;&quot;/>&lt;/tns3:Operation>&lt;tns3:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns3:Source>&lt;xsl:if test=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:IDRichiesta&quot;>&lt;tns3:BusinessID>&lt;xsl:value-of select=&quot;$ControlloARLTI1In/parameters/tns2:ControlloARLTI1/tns1:IDRichiesta&quot;/>&lt;/tns3:BusinessID>&lt;/xsl:if>&lt;tns3:EventType>&lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1_SUB-PROCESS&amp;quot;&quot;/>&lt;/tns3:EventType>&lt;/tns3:Identifier>&lt;tns3:track_position>&lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&lt;/tns3:track_position>&lt;tns3:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns3:Timestamp>&lt;/tns3:Envelope>&lt;/tns3:ActiveLoggerServices>&lt;/tns3:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogSelectIDSLUCO-input"
                    name="LogSelectIDSLUCO"
                    tibex:xpdlId="7ec6d68d-829d-41f1-9784-75ccc192de80"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQuery1ToLogSelectIDSLUCO"/>
                        <bpws:target linkName="SelectIDSLUCOToLogSelectIDSLUCO"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogSelectIDSLUCOToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloARLTI1In.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDSLUCO&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryColocato&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSelectIDSLUCO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$ControlloARLTI1In.parameters/tns1:IDRichiesta&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$ControlloARLTI1In.parameters/tns1:IDRichiesta&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectIDSLUCO/Record)>0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Controllo ARLTI1 output query, count: &amp;quot;, string(count($SelectIDSLUCO/Record)), &amp;quot;, &amp;quot;, tib:render-xml($SelectIDSLUCO, true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($JDBCQueryColocato/Record)>0&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Controllo ARLTI1 output query COLOCATO, count: &amp;quot;, string(count($JDBCQueryColocato/Record)), &amp;quot;, &amp;quot;, tib:render-xml($JDBCQueryColocato, true(), true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record trovato&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;            &lt;tns3:ActiveLoggerServices>&#xa;                &lt;tns3:Envelope>&#xa;                    &lt;tns3:Identifier>&#xa;                        &lt;tns3:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_check&amp;quot;&quot;/>&#xa;                        &lt;/tns3:ServiceName>&#xa;                        &lt;tns3:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Operation>&#xa;                        &lt;tns3:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns3:Source>&#xa;                        &lt;xsl:if test=&quot;$ControlloARLTI1In.parameters/tns1:IDRichiesta&quot;>&#xa;                            &lt;tns3:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$ControlloARLTI1In.parameters/tns1:IDRichiesta&quot;/>&#xa;                            &lt;/tns3:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns3:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;ControlloARLTI1_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns3:EventType>&#xa;                    &lt;/tns3:Identifier>&#xa;                    &lt;tns3:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns3:track_position>&#xa;                    &lt;tns3:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns3:Timestamp>&#xa;                &lt;/tns3:Envelope>&#xa;            &lt;/tns3:ActiveLoggerServices>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
