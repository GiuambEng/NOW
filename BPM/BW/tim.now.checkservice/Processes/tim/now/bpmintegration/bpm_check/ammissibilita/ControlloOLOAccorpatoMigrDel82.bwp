                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;OLO&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ControlloOLOAccorpatoMigrDel82_Response1&quot; match=&quot;/&quot;>&lt;tns:ControlloOLOAccorpatoMigrDel82_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:oaoSourceB2B=$Start/tns:codiceOperatoreRec or count($OLO/Record)>0&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ControlloOLOAccorpatoMigrDel82_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
