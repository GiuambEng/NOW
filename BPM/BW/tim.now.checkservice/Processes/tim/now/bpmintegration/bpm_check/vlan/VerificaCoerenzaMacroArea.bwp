                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;AnagCentraleGbe&quot;/>&#xa;    &lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_Coerenza_MacroArea_Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($AnagCentraleGbe/Record)>0&quot;>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:Verifica_Coerenza_MacroArea_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
