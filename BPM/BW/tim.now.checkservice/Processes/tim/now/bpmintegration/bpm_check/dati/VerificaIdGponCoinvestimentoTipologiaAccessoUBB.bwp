                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Query&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;xsl:variable name=&quot;var&quot; select=&quot;$Start/tns:Coinvestimento&quot;/>&lt;xsl:variable name=&quot;var2&quot; select=&quot;$Start/tns:TipologiaAccessoUBB&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Query/Record)=0&quot;>&lt;tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;tns:IDArmadio>&lt;xsl:value-of select=&quot;$Query/Record[1]/PUNTO_INTERCONNESSIONE&quot;/>&lt;/tns:IDArmadio>&lt;/tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Lavorazione='ATTIVAZIONE' and $Start/tns:Offerta='UBBSEMIGPON' and $Start/tns:GestioneAutonoma=('IS','OS')&quot;>&lt;tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;tns:IDArmadio>&lt;xsl:value-of select=&quot;$Query/Record[1]/PUNTO_INTERCONNESSIONE&quot;/>&lt;/tns:IDArmadio>&lt;/tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Query/Record[COINVESTIMENTO=$var])=0 and count($Oscuramento/Record)>0&quot;>&lt;tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;tns:IDArmadio>&lt;xsl:value-of select=&quot;$Query/Record[1]/PUNTO_INTERCONNESSIONE&quot;/>&lt;/tns:IDArmadio>&lt;/tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Query/Record[TIPO_ACCESSO=$var2])=0 and ($Start/tns:Offerta='SEMIGPON1BPNRR' or $Start/tns:Offerta='FULLGPON1BPNRR')&quot;>&lt;tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_03'&quot;/>&lt;/tns:Descrizione>&lt;tns:IDArmadio>&lt;xsl:value-of select=&quot;$Query/Record[1]/PUNTO_INTERCONNESSIONE&quot;/>&lt;/tns:IDArmadio>&lt;/tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;tns:IDArmadio>&lt;xsl:value-of select=&quot;$Query/Record[1]/PUNTO_INTERCONNESSIONE&quot;/>&lt;/tns:IDArmadio>&lt;/tns:VerificaIdGponCoinvestimentoTipologiaAccessoUBB_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Response" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
