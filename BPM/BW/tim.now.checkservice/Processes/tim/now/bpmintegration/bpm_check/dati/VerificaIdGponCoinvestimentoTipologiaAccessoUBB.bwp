            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Query-input"
                    name="Query" outputVariable="Query"
                    tibex:xpdlId="9a5ced10-19ec-4878-8df4-57153968b444" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
