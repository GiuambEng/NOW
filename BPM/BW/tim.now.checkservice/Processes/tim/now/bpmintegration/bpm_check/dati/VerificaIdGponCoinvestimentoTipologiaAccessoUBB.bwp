                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COINVESTIMENTO, TIPO_ACCESSO, PUNTO_INTERCONNESSIONE&#xa;FROM ANAGRAFICA_GPON&#xa;WHERE IDENTIFICATIVO_GPON=? AND CODIFICA_OLO_AGCOM=? AND IDGPONVALIDO='SI'&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
