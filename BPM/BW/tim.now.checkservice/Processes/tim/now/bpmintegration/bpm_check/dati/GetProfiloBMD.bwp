                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;VerVlanBMD&quot;/>&#xa;    &lt;xsl:template name=&quot;Output_LOG-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;OUTPUT GetProfiloBMD | IdRichiestaOLO: &amp;quot;, $GetProfiloBMDIn.input/tns1:IDRichiestaOLO, &amp;quot; | Offerta: &amp;quot;, $GetProfiloBMDIn.input/tns1:Offerta, &amp;quot; | Contenuto RESPONSE: &amp;quot;, tib:render-xml($VerVlanBMD))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn&quot;/>&#xa;    &lt;xsl:template name=&quot;VerVlanBMD&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and $GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello = &amp;quot;Y&amp;quot; and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:ProfiloTecnicoLinea) = 0])&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ProfiloTecnicoLinea non presente in input per offerta VULA e per falag nuovo modello pari a Y&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:Profilo_BMD) = 0]) and $GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:Profilo_BMD) = 0]) and starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta,  &amp;quot;BITSTREAMGBE&amp;quot;)&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and string-length($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello) = 0&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FlagNuovoModello non è compilato per l'offerta VULA.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_DOWN) = 0]) and $GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_DOWN non e' compilato per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_UP) = 0])  and $GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_UP non e' compilato per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_UP) = 0]) and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_DOWN) = 0])  and $GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_UP e Banda_Picco_DOWN non sono compilati per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[string-length(tns1:Profilo_BMD) = 0]) and ($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot; or $GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta = &amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;)&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;xsl:for-each select=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD&quot;>&#xa;                        &lt;tns1:Ver_VLANBMDR>&#xa;                            &lt;tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns1:IDDettaglioOrdine>&#xa;                        &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VerVlanBMD" name="AssignVerificaVLAN"
                    outputVariable="VerVlanBMD"
                    tibex:xpdlId="bb97b7c2-327b-4132-ba91-54de8856be01" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Input_LOGToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;VerVlanBMD&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and $GetProfiloBMDIn.input/tns1:FlagNuovoModello = &amp;quot;Y&amp;quot; and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:ProfiloTecnicoLinea) = 0])&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ProfiloTecnicoLinea non presente in input per offerta VULA e per falag nuovo modello pari a Y&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:Profilo_BMD) = 0]) and $GetProfiloBMDIn.input/tns1:Offerta = &amp;quot;BITSTREAMNGAFTTCAB&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:Profilo_BMD) = 0]) and starts-with($GetProfiloBMDIn.input/tns1:Offerta,  &amp;quot;BITSTREAMGBE&amp;quot;)&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and string-length($GetProfiloBMDIn.input/tns1:FlagNuovoModello) = 0&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FlagNuovoModello non è compilato per l'offerta VULA.&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_DOWN) = 0]) and $GetProfiloBMDIn.input/tns1:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_DOWN non e' compilato per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_UP) = 0])  and $GetProfiloBMDIn.input/tns1:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_UP non e' compilato per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_UP) = 0]) and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:Banda_Picco_DOWN) = 0])  and $GetProfiloBMDIn.input/tns1:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_UP e Banda_Picco_DOWN non sono compilati per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[string-length(tns1:Profilo_BMD) = 0]) and ($GetProfiloBMDIn.input/tns1:Offerta = &amp;quot;BITSTREAMNGAFTTH&amp;quot; or $GetProfiloBMDIn.input/tns1:Offerta = &amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;)&quot;>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;tns1:Ver_VLANBMDR>&#xa;                        &lt;tns1:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns1:IDDettaglioOrdine>&#xa;                    &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:VerificaVLANBMDResponse>&#xa;                    &lt;xsl:for-each select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD&quot;>&#xa;                        &lt;tns1:Ver_VLANBMDR>&#xa;                            &lt;tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns1:IDDettaglioOrdine>&#xa;                        &lt;/tns1:Ver_VLANBMDR>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns1:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns1:Codice>&#xa;                    &lt;tns1:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns1:Descrizione>&#xa;                &lt;/tns1:VerificaVLANBMDResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="VerVlanBMD" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7c7bd32c-80e0-40a0-b223-d28cfb201a54+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectIDSOTTOFAMOFFERTA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectIDSOTTOFAMOFFERTA-input"
                    name="SelectIDSOTTOFAMOFFERTA"
                    outputVariable="SelectIDSOTTOFAMOFFERTA"
                    tibex:xpdlId="7c7bd32c-80e0-40a0-b223-d28cfb201a54" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectIDSOTTOFAMOFFERTAToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SelectIDSOTTOFAMOFFERTAToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta, &quot;VULA&quot;) or starts-with($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta, &quot;SEMIVULA&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($GetProfiloBMDIn.input/ns3:Offerta, "VULA") or starts-with($GetProfiloBMDIn.input/ns3:Offerta, "SEMIVULA")]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+7c7bd32c-80e0-40a0-b223-d28cfb201a54+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectIDSOTTOFAMOFFERTA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT O.ID_SOTTOFAMIG_OFFERTA&#xa;FROM TRASCODFC_OFFERTA TRO, OFFERTA O&#xa;WHERE NOME_OFFERTA_ESTERNA = ? AND TRO.ID_OFFERTA = O.ID_OFFERTA AND TRO.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="ID_SOTTOFAMIG_OFFERTA"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LogIDSottoFamiglia-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Result SelectIDSOTTOFAMOFFERTA: &amp;quot;, tib:render-xml($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogIDSottoFamiglia-input"
                    name="LogIDSottoFamiglia"
                    tibex:xpdlId="7e07d9bf-7bf1-43cb-89bd-f06ae006be6b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectIDSOTTOFAMOFFERTAToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogIDSottoFamiglialToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogIDSottoFamiglia-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Result SelectIDSOTTOFAMOFFERTA: &amp;quot;, tib:render-xml($GetProfiloBMDIn.input, true(), true()))&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
