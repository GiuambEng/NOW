                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDProfilo&quot;/>&#xa;    &lt;xsl:param name=&quot;VerVlanBMD&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryPROFILOTCNCLINEA&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryID_PROFILO_BMD&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Query_VULA_Y&quot;/>&#xa;    &lt;xsl:template name=&quot;VerVlanBMD&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($SelectIDProfilo/Record) > 0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($SelectIDProfilo/Record[1]/FLAG_OSCURABILE)='Y'&quot;>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:ID_PROFILO_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectIDProfilo/Record[1]/ID_PROFILO_BMD)&quot;/>&#xa;                                &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_03&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:ID_PROFILO_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectIDProfilo/Record[1]/ID_PROFILO_BMD)&quot;/>&#xa;                                &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($QueryPROFILOTCNCLINEA/Record) > 0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($QueryPROFILOTCNCLINEA/Record[1]/FLAG_OSCURABILE) = 'N'&quot;>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:ID_PROFILO_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($QueryPROFILOTCNCLINEA/Record[1]/ID_PROFILO_BMD)&quot;/>&#xa;                                &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:ID_PROFILO_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($QueryPROFILOTCNCLINEA/Record[1]/ID_PROFILO_BMD)&quot;/>&#xa;                                &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_03&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($QueryID_PROFILO_BMD/Record)>0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($QueryID_PROFILO_BMD/Record[1]/FLAG_OSCURABILE) = 'N'&quot;>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:ID_PROFILO_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($QueryID_PROFILO_BMD/Record[1]/ID_PROFILO_BMD)&quot;/>&#xa;                                &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:ID_PROFILO_BMD>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($QueryID_PROFILO_BMD/Record[1]/ID_PROFILO_BMD)&quot;/>&#xa;                                &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_03&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($Query_VULA_Y/Record)>0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;upper-case($Query_VULA_Y/Record[1]/FLAG_OSCURABILE) = 'N'&quot;>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;xsl:if test=&quot;$Query_VULA_Y/Record[1]/ID_PROFILO_BMD&quot;>&#xa;                                    &lt;tns1:ID_PROFILO_BMD>&#xa;                                        &lt;xsl:value-of select=&quot;$Query_VULA_Y/Record[1]/ID_PROFILO_BMD&quot;/>&#xa;                                    &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;xsl:if test=&quot;$Query_VULA_Y/Record[1]/ID_PROFILO_BMD&quot;>&#xa;                                    &lt;tns1:ID_PROFILO_BMD>&#xa;                                        &lt;xsl:value-of select=&quot;$Query_VULA_Y/Record[1]/ID_PROFILO_BMD&quot;/>&#xa;                                    &lt;/tns1:ID_PROFILO_BMD>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_03&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;starts-with(upper-case($GetProfiloBMDIn.input/tns1:Offerta), &amp;quot;VULA&amp;quot;) or starts-with(upper-case($GetProfiloBMDIn.input/tns1:Offerta), &amp;quot;SEMIVULA&amp;quot;) or $GetProfiloBMDIn.input/tns1:Offerta=&amp;quot;FULLGPONPLUS&amp;quot;&quot;>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:VerificaVLANBMDResponse>&#xa;                            &lt;tns1:Ver_VLANBMDR>&#xa;                                &lt;tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns1:IDDettaglioOrdine>&#xa;                                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;>&#xa;                                    &lt;tns1:uservlanID>&#xa;                                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Ver_VLANBMD[number($index)]/tns1:UserVlan_ID&quot;/>&#xa;                                    &lt;/tns1:uservlanID>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:Ver_VLANBMDR>&#xa;                            &lt;xsl:if test=&quot;number($index) > 1&quot;>&#xa;                                &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns1:Ver_VLANBMDR&quot;/>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns1:Codice>&#xa;                            &lt;tns1:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Descrizione>&#xa;                        &lt;/tns1:VerificaVLANBMDResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
