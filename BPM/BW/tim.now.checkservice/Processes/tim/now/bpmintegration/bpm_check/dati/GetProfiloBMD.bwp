                                    name="QueryPROFILOTCNCLINEAToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SelectIDProfiloToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="QueryID_PROFILO_BMDToAssign1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToPiccoDOWNAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignOutToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="EmptyToQuery_VULA_Y" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="JDBCQueryToAssignOut" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="EmptyToQueryID_PROFILO_BMD" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="869b2ec3-d6c5-46c1-9d4a-3ec27aba4a20">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToPiccoDOWNAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="e96a28b9-8831-4022-8312-2594d62c0734">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (contains($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN, &quot;,&quot;)) then concat(substring-before($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN, &quot;,&quot;), &quot;.&quot;, substring-after($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN, &quot;,&quot;)) else $GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="PiccoDOWN"
                                    name="PiccoDOWNAssign"
                                    outputVariable="PiccoDOWN"
                                    tibex:xpdlId="25f19393-9460-4224-99ec-429966c23193" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToPiccoDOWNAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="PiccoDOWNAssignToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (contains($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN, &quot;,&quot;)) then concat(substring-before($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN, &quot;,&quot;), &quot;.&quot;, substring-after($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN, &quot;,&quot;)) else $GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_DOWN" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
