            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="8d97f033-331a-43ea-b3f8-af14f22a2e4b">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToOutput_LOG"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD) and $VerVlanBMD/ns3:Codice =true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($GetProfiloBMDIn.input/ns3:Ver_VLANBMD) and $VerVlanBMD/ns3:Codice =true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
