                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;GetProfiloBMDIn&quot;/>&lt;xsl:param name=&quot;QueryID_PROFILO_BMD&quot;/>&lt;xsl:param name=&quot;SelectIDProfilo&quot;/>&lt;xsl:param name=&quot;QueryPROFILOTCNCLINEA&quot;/>&lt;xsl:param name=&quot;Query_VULA_Y&quot;/>&lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&lt;tns3:CW_BUS_MESSAGE>&lt;tns3:GenericLogger>&lt;tns3:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns3:Application>&lt;tns3:Process>&lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&lt;/tns3:Process>&lt;tns3:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns3:Service>&lt;tns3:Operation>&lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&lt;/tns3:Operation>&lt;xsl:if test=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:IDRichiestaOLO&quot;>&lt;tns3:BusinessID>&lt;xsl:value-of select=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns3:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and $GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello = &amp;quot;Y&amp;quot;&quot;>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;QueryID_PROFILO_BMD result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($QueryID_PROFILO_BMD,true(),true()))&quot;/>&lt;/tns3:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and ($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello = &amp;quot;N&amp;quot; or not(exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:FlagNuovoModello)))&quot;>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;QueryPROFILOTCNLINA result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($QueryPROFILOTCNCLINEA,true(),true()))&quot;/>&lt;/tns3:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta=('VULAFTTH','SEMIVULAFTTH') and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[tns1:ProfiloTecnicoLinea = 'Z9']) and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[tns1:Banda_Picco_UP = '500']) and exists($GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Ver_VLANBMD[tns1:Banda_Picco_DOWN = '2300'])&quot;>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;QueryVULAY result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($Query_VULA_Y,true(),true()))&quot;/>&lt;/tns3:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;SelectIDProfilo result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($SelectIDProfilo,true(),true()))&quot;/>&lt;/tns3:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns3:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns3:LoggerName>&lt;tns3:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns3:LogLevel>&lt;/tns3:GenericLogger>&lt;/tns3:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogQuery-input"
                                    name="LogQuery"
                                    tibex:xpdlId="dcb52d8b-94c9-4561-8a92-882726c8dd4b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignOutToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryID_PROFILO_BMD&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIDProfilo&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryPROFILOTCNCLINEA&quot;/>&#xa;    &lt;xsl:param name=&quot;Query_VULA_Y&quot;/>&#xa;    &lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;GetProfiloBMD&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;xsl:if test=&quot;$GetProfiloBMDIn.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns3:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and $GetProfiloBMDIn.input/tns1:FlagNuovoModello = &amp;quot;Y&amp;quot;&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;QueryID_PROFILO_BMD result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($QueryID_PROFILO_BMD,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;(starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($GetProfiloBMDIn.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and ($GetProfiloBMDIn.input/tns1:FlagNuovoModello = &amp;quot;N&amp;quot; or not(exists($GetProfiloBMDIn.input/tns1:FlagNuovoModello)))&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;QueryPROFILOTCNLINA result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($QueryPROFILOTCNCLINEA,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$GetProfiloBMDIn.input/tns1:Offerta=('VULAFTTH','SEMIVULAFTTH') and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[tns1:ProfiloTecnicoLinea = 'Z9']) and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[tns1:Banda_Picco_UP = '500']) and exists($GetProfiloBMDIn.input/tns1:Ver_VLANBMD[tns1:Banda_Picco_DOWN = '2300'])&quot;>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;QueryVULAY result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($Query_VULA_Y,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns3:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;SelectIDProfilo result: &amp;quot;, &amp;#xD;&amp;#xA;tib:render-xml($SelectIDProfilo,true(),true()))&quot;/>&#xa;                        &lt;/tns3:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d1bd260a-1498-4b90-a515-eb13554abb03+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;GetProfiloBMDIn&quot;/>&lt;xsl:template name=&quot;Query_VULA_Y-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;Offerta>&lt;xsl:value-of select=&quot;$GetProfiloBMDIn/input/tns1:VerificaVLANBMDRequest/tns1:Offerta&quot;/>&lt;/Offerta>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Query_VULA_Y-input"
                                    name="Query_VULA_Y"
                                    outputVariable="Query_VULA_Y"
                                    tibex:xpdlId="d1bd260a-1498-4b90-a515-eb13554abb03" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToQuery_VULA_Y"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToAssignOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d1bd260a-1498-4b90-a515-eb13554abb03+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;GetProfiloBMDIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;Query_VULA_Y-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;Offerta>&#xa;                &lt;xsl:value-of select=&quot;$GetProfiloBMDIn.input/tns1:Offerta&quot;/>&#xa;            &lt;/Offerta>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PROFILO_BMD,FLAG_OSCURABILE&#xd;&#xa;FROM PROFILO_VLAN_BMD PVB, trascodfc_offerta TF, OFFERTA O, TIPOLG_VLAN TV&#xd;&#xa;WHERE pvb.id_sottofamig_offerta=o.id_sottofamig_offerta AND o.id_offerta=tf.id_offerta AND tv.idtplg_vlan=pvb.idtplg_vlan &#xd;&#xa;AND UPPER(O.NOME_OFFERTA_CATLG)=? AND TV.descr='VULA' AND pvb.flag_nuovo_modello='Y' &#xd;&#xa;AND pvb.profilo='Z9' AND pvb.bp2_max=1000 AND pvb.bp2=2300 AND pvb.bp5=15&#xd;&#xa;"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Offerta"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="ID_PROFILO_BMD"
                                    dataType="4" typeName="number"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="FLAG_OSCURABILE"
                                    dataType="12" typeName="varchar2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:empty name="Empty" tibex:xpdlId="02b81797-7d66-45e1-a043-1a472abc75ac">
                                <bpws:targets>
                                    <bpws:target linkName="PiccoUPAssignToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToQuery_VULA_Y">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta=('VULAFTTH','SEMIVULAFTTH') and exists($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[ns3:ProfiloTecnicoLinea = 'Z9']) and exists($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[ns3:Banda_Picco_UP = '500']) and exists($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[ns3:Banda_Picco_DOWN = '2300'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$GetProfiloBMDIn.input/ns3:Offerta=('VULAFTTH','SEMIVULAFTTH') and exists($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[ns3:ProfiloTecnicoLinea = 'Z9']) and exists($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[ns3:Banda_Picco_UP = '500']) and exists($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[ns3:Banda_Picco_DOWN = '2300'])]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToQueryID_PROFILO_BMD">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
