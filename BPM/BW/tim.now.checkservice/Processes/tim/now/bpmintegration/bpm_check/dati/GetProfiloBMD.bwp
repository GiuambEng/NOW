                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (contains($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP, &quot;,&quot;)) then concat(substring-before($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP, &quot;,&quot;), &quot;.&quot;, substring-after($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP, &quot;,&quot;)) else $GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="PiccoUP"
                                    name="PiccoUPAssign"
                                    outputVariable="PiccoUP"
                                    tibex:xpdlId="aaa0dd96-0e89-48e2-9759-ad185734c772" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="PiccoDOWNAssignToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="PiccoUPAssignToJDBCQuery1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="PiccoUPAssignToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(starts-with($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta, &quot;VULA&quot;) or starts-with($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta, &quot;SEMIVULA&quot;) or $GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta=&quot;FULLGPONPLUS&quot;) and $GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:FlagNuovoModello = &quot;Y&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(starts-with($GetProfiloBMDIn.input/ns3:Offerta, "VULA") or starts-with($GetProfiloBMDIn.input/ns3:Offerta, "SEMIVULA") or $GetProfiloBMDIn.input/ns3:Offerta="FULLGPONPLUS") and $GetProfiloBMDIn.input/ns3:FlagNuovoModello = "Y"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="PiccoUPAssignToQueryPROFILOTCNCLINEA">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="(starts-with($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta, &quot;VULA&quot;) or starts-with($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta, &quot;SEMIVULA&quot;) or $GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:Offerta=&quot;FULLGPONPLUS&quot;) and ($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:FlagNuovoModello = &quot;N&quot; or not(exists($GetProfiloBMDIn/input/ns3:VerificaVLANBMDRequest/ns3:FlagNuovoModello)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[(starts-with($GetProfiloBMDIn.input/ns3:Offerta, "VULA") or starts-with($GetProfiloBMDIn.input/ns3:Offerta, "SEMIVULA") or $GetProfiloBMDIn.input/ns3:Offerta="FULLGPONPLUS") and ($GetProfiloBMDIn.input/ns3:FlagNuovoModello = "N" or not(exists($GetProfiloBMDIn.input/ns3:FlagNuovoModello)))]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (contains($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP, &quot;,&quot;)) then concat(substring-before($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP, &quot;,&quot;), &quot;.&quot;, substring-after($GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP, &quot;,&quot;)) else $GetProfiloBMDIn.input/ns3:Ver_VLANBMD[number($index)]/ns3:Banda_Picco_UP" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
