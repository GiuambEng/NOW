                portType="ns8:DatiVerificaControlliPortType" tibex:xpdlId="b26e4f5c-f844-41aa-9daf-650af0749f27">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns6="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="QueryContrattoFull"/&gt;
    &lt;xsl:param name="QueryContratto"/&gt;
    &lt;xsl:template name="DatiVerificaControlli-input" match="/"&gt;
        &lt;tns5:DatiVerificaControlliRequest&gt;
