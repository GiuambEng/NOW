                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryContratto-input"
                    name="QueryContratto"
                    outputVariable="QueryContratto"
                    tibex:xpdlId="0711a766-1779-4aac-a6cf-36018b174b4c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0711a766-1779-4aac-a6cf-36018b174b4c+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;Offerta>&lt;xsl:value-of select=&quot;$Start/tns1:Offerta&quot;/>&lt;/Offerta>&lt;DataFiAss>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataFiAss>&lt;DataInAss>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataInAss>&lt;DataFiVal>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataFiVal>&lt;DataInVal>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataInVal>&lt;CodOloAgcom>&lt;xsl:value-of select=&quot;$Start/tns1:codificaOloAgcom&quot;/>&lt;/CodOloAgcom>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.ID_CONTRATTO, CON.FLAG_DIFFIDATO, CON.FLAG_NPD,CON.TIMSTP_INSMTO,CON.ID_TPLG_OPERATORE&#xd;&#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xd;&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xd;&#xa;AND OFFER.NOME_OFFERTA_ESTERNA = ? &#xd;&#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xd;&#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xd;&#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = 'Active'&#xd;&#xa;ORDER BY CON.FLAG_NPD desc,CON.TIMSTP_INSMTO desc" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Offerta"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataFiAss"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataInAss"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataFiVal"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataInVal"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOloAgcom"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_CONTRATTO"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="FLAG_NPD"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="ID_TPLG_OPERATORE"
                                    dataType="1111"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryContrattoFull-input"
                    name="QueryContrattoFull"
                    outputVariable="QueryContrattoFull"
                    tibex:xpdlId="f326ed25-e213-4e21-aae4-c76a7bf66981" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToJDBCQuery1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery1ToEnd">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f326ed25-e213-4e21-aae4-c76a7bf66981+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Offerta=('FULLGPONPLUS','SEMIVULAFTTH ')&quot;>&lt;Offerta>&lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&lt;/Offerta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;Offerta>&lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&lt;/Offerta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DataFiAss>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataFiAss>&lt;DataInAss>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataInAss>&lt;DataFiVal>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataFiVal>&lt;DataInVal>&lt;xsl:value-of select=&quot;$Start/tns1:DRO&quot;/>&lt;/DataInVal>&lt;CodOloAgcom>&lt;xsl:value-of select=&quot;$Start/tns1:codificaOloAgcom&quot;/>&lt;/CodOloAgcom>&lt;/tns2:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.ID_CONTRATTO, CON.FLAG_DIFFIDATO, CAT.DATAINZ_ASSOCZ_VALID, CAT.DATAFI_ASSOCZ_VALID, CON.DATAINZ_VALID, CON.DATAFI_VALID &#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xa;AND OFFER.NOME_OFFERTA_ESTERNA = ? &#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = 'Active'&#xa;ORDER BY CON.FLAG_NPD desc, CON.TIMSTP_INSMTO desc" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Offerta"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataFiAss"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataInAss"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataFiVal"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DataInVal"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CodOloAgcom"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="ID_CONTRATTO"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="DATAINZ_ASSOCZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="DATAFI_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Response"
                    name="Assign" outputVariable="Response"
                    tibex:xpdlId="90384150-e37c-46e1-abdf-14922d1d02f4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToJDBCQuery1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Start/ns0:Offerta=('FULLGPONPLUS','FULLGPONPLUSNGA','SEMIVULAFTTH ')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/ns0:Offerta=('FULLGPONPLUS','FULLGPONPLUSNGA','SEMIVULAFTTH ')]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
