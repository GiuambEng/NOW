                            &lt;/tns6:FlagOLODiffidato&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="count($QueryContrattoFull/Record) &gt; 0"&gt;
                            &lt;xsl:if test="$QueryContrattoFull/Record[1]/FLAG_DIFFIDATO"&gt;
                                &lt;tns6:FlagOLODiffidatoFull&gt;
                                    &lt;xsl:value-of select="$QueryContrattoFull/Record[1]/FLAG_DIFFIDATO"/&gt;
                                &lt;/tns6:FlagOLODiffidatoFull&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$QueryContratto/Record[1]/ID_CONTRATTO"&gt;
                            &lt;tns6:IDContratto&gt;
                                &lt;xsl:value-of select="$QueryContratto/Record[1]/ID_CONTRATTO"/&gt;
                            &lt;/tns6:IDContratto&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns6:DatiAccesso&gt;
                    &lt;tns6:DatiVerificheFormali&gt;
                        &lt;xsl:if test="$QueryContratto/Record[1]/ID_CONTRATTO"&gt;
                            &lt;tns6:IDContratto&gt;
                                &lt;xsl:value-of select="$QueryContratto/Record[1]/ID_CONTRATTO"/&gt;
                            &lt;/tns6:IDContratto&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns6:DatiVerificheFormali&gt;
                &lt;/tns6:DatiVerificaControlliInput&gt;
            &lt;/parameters&gt;
        &lt;/tns5:DatiVerificaControlliRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryContrattoFull&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryContratto&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:DatiVerificaControlliInput>&#xa;            &lt;tns6:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns6:Operatore>&#xa;            &lt;tns6:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns6:IDRichiestaOLO>&#xa;            &lt;tns6:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns6:Azione>&#xa;            &lt;tns6:DatiAccesso>&#xa;                &lt;xsl:if test=&quot;$QueryContratto/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                    &lt;tns6:FlagOLODiffidato>&#xa;                        &lt;xsl:value-of select=&quot;$QueryContratto/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                    &lt;/tns6:FlagOLODiffidato>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;count($QueryContrattoFull/Record) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$QueryContrattoFull/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                        &lt;tns6:FlagOLODiffidatoFull>&#xa;                            &lt;xsl:value-of select=&quot;$QueryContrattoFull/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                        &lt;/tns6:FlagOLODiffidatoFull>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;>&#xa;                    &lt;tns6:IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;/>&#xa;                    &lt;/tns6:IDContratto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns6:DatiAccesso>&#xa;            &lt;tns6:DatiVerificheFormali>&#xa;                &lt;xsl:if test=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;>&#xa;                    &lt;tns6:IDContratto>&#xa;                        &lt;xsl:value-of select=&quot;$QueryContratto/Record[1]/ID_CONTRATTO&quot;/>&#xa;                    &lt;/tns6:IDContratto>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns6:DatiVerificheFormali>&#xa;        &lt;/tns6:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
