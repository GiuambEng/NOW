                    <bpws:target linkName="AssignToVerifica_Data_InvioOut"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Verifica_Data_InvioIn&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInputCheckDataInvioNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvioNP&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvio&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:if test=&quot;$Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:IDRichiesta&quot;>&#xa;                    &lt;tns1:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:IDRichiesta&quot;/>&#xa;                    &lt;/tns1:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Input: &amp;quot;&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request, true(), true())&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.bpm_check&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvio&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;xsl:if test=&quot;$Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:IDRichiesta&quot;>&#xa;                            &lt;tns1:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:IDRichiesta&quot;/>&#xa;                            &lt;/tns1:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvio_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInputCheckDataInvioNP-input"
                    name="LogInputCheckDataInvioNP"
                    tibex:xpdlId="6cd42f80-ec7b-411f-9d0c-5116c1dbc3c5"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="RecuperaSottoLavToLogInputCheckDataInvioNP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputCheckDataInvioNPToGetNextWorkingDateInvoke">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione = &quot;RIMODULAZIONEDAC&quot; and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento = &quot;ATTIVAZIONE&quot; and $RecuperaSottoLav/Record[1]/TIPOLOGIASOTTOLAV = &quot;DONOROLO&quot;) or ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione = &quot;ANNULLAMENTO&quot; and string-length($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:IDRichiestaTarget) > 0 and ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:TipologiaScenario !=&quot;NPSUTIF&quot;) and ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:TipologiaScenario !=&quot;NPSUTIFCPS&quot;) and ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:TipologiaScenario !=&quot;NPSUTIFCPSSHA&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Verifica_Data_InvioIn.parameters/tns:Lavorazione = "RIMODULAZIONEDAC" and $Verifica_Data_InvioIn.parameters/tns:Lavorazione_Ordine_di_Riferimento = "ATTIVAZIONE" and $RecuperaSottoLav/Record[1]/TIPOLOGIASOTTOLAV = "DONOROLO") or ($Verifica_Data_InvioIn.parameters/tns:Lavorazione = "ANNULLAMENTO" and string-length($Verifica_Data_InvioIn.parameters/tns:IDRichiestaTarget) > 0 and ($Verifica_Data_InvioIn.parameters/tns:TipologiaScenario !="NPSUTIF") and ($Verifica_Data_InvioIn.parameters/tns:TipologiaScenario !="NPSUTIFCPS") and ($Verifica_Data_InvioIn.parameters/tns:TipologiaScenario !="NPSUTIFCPSSHA"))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Log_InputCheckDataInvioNPToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputCheckDataInvioNPToGetRichiestaTargetByID">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione = &quot;ANNULLAMENTO&quot; and string-length($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:IDRichiestaTarget) > 0 and ($Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:TipologiaScenario = (&quot;NPSUTIF&quot;,&quot;NPSUTIFCPS&quot;,&quot;NPSUTIFCPSSHA&quot;)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($Verifica_Data_InvioIn.parameters/tns:Lavorazione = "ANNULLAMENTO" and string-length($Verifica_Data_InvioIn.parameters/tns:IDRichiestaTarget) > 0 and ($Verifica_Data_InvioIn.parameters/tns:TipologiaScenario = ("NPSUTIF","NPSUTIFCPS","NPSUTIFCPSSHA")))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_Data_InvioIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInputCheckDataInvioNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvioNP&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvio&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;xsl:if test=&quot;$Verifica_Data_InvioIn.parameters/tns:IDRichiesta&quot;>&#xa;                    &lt;tns1:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Verifica_Data_InvioIn.parameters/tns:IDRichiesta&quot;/>&#xa;                    &lt;/tns1:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Input: &amp;quot;&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($Verifica_Data_InvioIn.parameters, true(), true())&quot;/>&#xa;                &lt;/tns1:Payload>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.bpm_check&amp;quot;&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvio&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;xsl:if test=&quot;$Verifica_Data_InvioIn.parameters/tns:IDRichiesta&quot;>&#xa;                            &lt;tns1:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$Verifica_Data_InvioIn.parameters/tns:IDRichiesta&quot;/>&#xa;                            &lt;/tns1:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaDataInvio_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="GetNextWorkingDateInvoke-input"
                name="GetNextWorkingDateInvoke"
                operation="calcNextDateByDuration"
