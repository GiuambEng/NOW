                portType="ns3:GetNextDatePortType" tibex:xpdlId="977d3890-c638-4944-b42e-a15a8c8ffee0">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/GetNextDateService" xmlns:tns2="http://www.tim.com/NOW/xsd/GetNextDate" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessi/" version="2.0"&gt;
    &lt;xsl:param name="Verifica_Data_InvioIn"/&gt;
    &lt;xsl:param name="DACperCheck"/&gt;
    &lt;xsl:template name="calcNextDateByDuration-input" match="/"&gt;
        &lt;tns3:calcNextDateByDurationRequest&gt;
            &lt;parameters&gt;
                &lt;tns2:Request&gt;
                    &lt;tns2:inputDate&gt;
                        &lt;xsl:value-of select="$DACperCheck"/&gt;
                    &lt;/tns2:inputDate&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione = 'RIMODULAZIONEDAC' and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Lavorazione_Ordine_di_Riferimento = 'ATTIVAZIONE' and $Verifica_Data_InvioIn/parameters/tns:Verifica_Data_Invio_Request/tns:Sottolav_Ordine_di_Riferimento = 'DONOROLO'"&gt;
                            &lt;tns2:GiorniLavorativi&gt;
                                &lt;xsl:value-of select="2"/&gt;
                            &lt;/tns2:GiorniLavorativi&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns2:GiorniLavorativi&gt;
                                &lt;xsl:value-of select="1"/&gt;
                            &lt;/tns2:GiorniLavorativi&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns2:Request&gt;
            &lt;/parameters&gt;
        &lt;/tns3:calcNextDateByDurationRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
