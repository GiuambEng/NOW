                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaSommaBandePicco.input&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaSommaBandePiccoRequest>&#xa;            &lt;tns:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaSommaBandePicco.input/tns:Offerta&quot;/>&#xa;            &lt;/tns:Offerta>&#xa;            &lt;xsl:copy-of select=&quot;$VerificaSommaBandePicco.input/tns:UserVlan&quot;/>&#xa;            &lt;xsl:for-each select=&quot;$VerificaSommaBandePicco.input/tns:UserVlan_Cons&quot;>&#xa;                &lt;xsl:variable name=&quot;UserVlanId&quot; select=&quot;tns:IdUserVlan&quot;/>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;not(exists(../tns:UserVlan[tns:IdUserVlan=$UserVlanId]))&quot;>&#xa;                        &lt;tns:UserVlan_Cons>&#xa;                            &lt;xsl:if test=&quot;$UserVlanId&quot;>&#xa;                                &lt;tns:IdUserVlan>&#xa;                                    &lt;xsl:value-of select=&quot;$UserVlanId&quot;/>&#xa;                                &lt;/tns:IdUserVlan>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Azione&quot;>&#xa;                                &lt;tns:Azione>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Azione&quot;/>&#xa;                                &lt;/tns:Azione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_UP&quot;>&#xa;                                &lt;tns:Banda_Picco_UP>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_UP&quot;/>&#xa;                                &lt;/tns:Banda_Picco_UP>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;tns:Banda_Picco_DOWN&quot;>&#xa;                                &lt;tns:Banda_Picco_DOWN>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Banda_Picco_DOWN&quot;/>&#xa;                                &lt;/tns:Banda_Picco_DOWN>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:UserVlan_Cons>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:VerificaSommaBandePiccoRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
