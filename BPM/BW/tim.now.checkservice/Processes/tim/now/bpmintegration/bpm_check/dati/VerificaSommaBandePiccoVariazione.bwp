                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectFattoreK&quot;/>&lt;xsl:param name=&quot;RecuperoProfiliComm&quot;/>&lt;xsl:param name=&quot;SommaUPCons&quot;/>&lt;xsl:param name=&quot;SommaDOWNCons&quot;/>&lt;xsl:param name=&quot;SommaUP&quot;/>&lt;xsl:param name=&quot;SommaDOWN&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($SommaUP+$SommaUPCons) &amp;lt;= (($SelectFattoreK/Record[1]/VALORE)*xsd:decimal((if(contains(string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_UP), &amp;quot;,&amp;quot;)) then concat(substring-before(string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_UP), &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after(string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_UP), &amp;quot;,&amp;quot;))&amp;#x9;else string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_UP)))) and ($SommaDOWN+$SommaDOWNCons) &amp;lt;= (($SelectFattoreK/Record[1]/VALORE)*xsd:decimal((if(contains(string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_DOWN), &amp;quot;,&amp;quot;)) then concat(substring-before(string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_DOWN), &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after(string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_DOWN), &amp;quot;,&amp;quot;)) else string($RecuperoProfiliComm/Record[1]/PROFILO_COMMERCIALE_DOWN))))&quot;>&lt;tns:VerificaSommaBandePiccoResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaSommaBandePiccoResponse>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaSommaBandePiccoResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaSommaBandePiccoResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
