                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="number($index)&lt;=count($Mapper/tns:UserVlan_Cons)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[number($index)<=count($Mapper/tns:UserVlan_Cons)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="__Link" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStart1ToCopy_1_SommaUP" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="Copy_1_SommaDOWNToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="644185df-5f0e-4293-b10f-75e85184208f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToCopy_1_SommaUP"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd1"
                                tibex:group="groupEnd" tibex:xpdlId="31e66269-58e9-412d-a593-05efe30550ff">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToGroupEnd1"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SommaUP"
                                    name="SoommaUPCons"
                                    outputVariable="SommaUP"
                                    tibex:xpdlId="ab2b524d-811b-4099-9d06-1b93c9b674d5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToCopy_1_SommaUP"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="__Link"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if(exists($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_UP)) then (xsd:decimal(&#xd;&#xa;if(contains($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_UP, &quot;,&quot;)) &#xd;&#xa;then concat(substring-before($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_UP, &quot;,&quot;), &quot;.&quot;, substring-after($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_UP, &quot;,&quot;)) &#xd;&#xa;else $Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_UP) + $SommaUPCons) else(0+ $SommaUPCons)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="SommaUP" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SommaDOWN"
                                    name="SoommaDOWNCons"
                                    outputVariable="SommaDOWN"
                                    tibex:xpdlId="75356f11-bba3-4e43-a1a8-b76ee9f07f2b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="__Link"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Copy_1_SommaDOWNToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if(exists($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_DOWN)) then (xsd:decimal(&#xd;&#xa;if(contains($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_DOWN, &quot;,&quot;)) &#xd;&#xa;then concat(substring-before($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_DOWN, &quot;,&quot;), &quot;.&quot;, substring-after($Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_DOWN, &quot;,&quot;)) &#xd;&#xa;else $Mapper/tns:UserVlan_Cons[number($index)]/tns:Banda_Picco_DOWN) + $SommaDOWNCons) else(0+$SommaDOWNCons)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="SommaDOWN" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Logger_Name&quot;/>&lt;xsl:param name=&quot;Logger_Level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SommaUPCons&quot;/>&lt;xsl:param name=&quot;SommaDOWNCons&quot;/>&lt;xsl:param name=&quot;VerificaSommaBandePicco&quot;/>&lt;xsl:template name=&quot;LogSommaCons-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.bpm_check.dati'&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaSommaBandePicco&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'VerificaSommaBandePicco'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaSommaBandePicco/input/tns1:VerificaSommaBandePiccoRequest/tns1:IdRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaSommaBandePicco/input/tns1:VerificaSommaBandePiccoRequest/tns1:IdRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Somme al cicloCons num &amp;quot;, string($index), &amp;quot;- SommaDownCons: &amp;quot;, string($SommaDOWNCons),&amp;quot;-SommaUPCons: &amp;quot;, string($SommaUPCons))    &quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$Logger_Level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogSommaCons-input"
                                    name="LogSommaCons"
                                    tibex:xpdlId="6ea46fca-80e9-4fe3-b77d-1fa4c5d10575"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Copy_1_SommaDOWNToGroupEnd1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaSommaBandePicco.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Name&quot;/>&#xa;    &lt;xsl:param name=&quot;Logger_Level&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SommaUPCons&quot;/>&#xa;    &lt;xsl:param name=&quot;SommaDOWNCons&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSommaCons-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.bpm_check.dati'&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaSommaBandePicco&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaSommaBandePicco'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaSommaBandePicco.input/tns1:IdRichiesta&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaSommaBandePicco.input/tns1:IdRichiesta&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Somme al cicloCons num &amp;quot;, string($index), &amp;quot;- SommaDownCons: &amp;quot;, string($SommaDOWNCons),&amp;quot;-SommaUPCons: &amp;quot;, string($SommaUPCons))    &quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$Logger_Level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
