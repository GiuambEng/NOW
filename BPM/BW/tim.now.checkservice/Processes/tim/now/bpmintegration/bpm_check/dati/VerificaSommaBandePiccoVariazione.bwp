                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cf6ed7e7-4e69-484f-b99f-ba138122f769+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaSommaBandePicco.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SELECTIDOFFERTABP&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperoProfiliComm-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaSommaBandePicco.input/tns1:ProfiloTecnicoLinea)>0&quot;>&#xa;                    &lt;PROFILO_TCNC_LINEA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaSommaBandePicco.input/tns1:ProfiloTecnicoLinea)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaSommaBandePicco.input/tns1:ProfiloTecnicoLinea&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/PROFILO_TCNC_LINEA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;PROFILO_TCNC_LINEA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaSommaBandePicco.input/tns1:ProfiloTecnicoCons)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaSommaBandePicco.input/tns1:ProfiloTecnicoCons&quot;/>&#xa; 