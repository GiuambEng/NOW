                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToCheck_DAC_CodOlo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="not($Select_PactRich/Record[1]/LAVORAZIONE='CESSAZIONE' and $Select_PactRich/Record[1]/OFFERTA='NP') and string-length(string($firstRecord/ns5:DAC))>0 and string-length(string($Select_PactRich/Record[number($index)]/DAC))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[not($Select_PactRich/Record[1]/LAVORAZIONE='CESSAZIONE' and $Select_PactRich/Record[1]/OFFERTA='NP') and string-length(string($firstRecord/ns5:DAC))>0 and string-length(string($Select_PactRich/Record[number($index)]/DAC))>0]]></bpws:transitionCondition>
                                    </bpws:source>
