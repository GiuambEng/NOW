                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Select_PactRich&quot;/>&lt;xsl:param name=&quot;firstRecord&quot;/>&lt;xsl:param name=&quot;VerificaAppartenenzaPacchettoIn&quot;/>&lt;xsl:template name=&quot;LOG_DAC_CodOlo-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAppartenenzaPacchetto&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAppartenenzaPacchetto&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaAppartenenzaPacchettoIn/input/tns1:VerificaAppartenenzaPacchetto_Request/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaAppartenenzaPacchettoIn/input/tns1:VerificaAppartenenzaPacchetto_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;not($Select_PactRich/Record[1]/LAVORAZIONE='CESSAZIONE' and $Select_PactRich/Record[1]/OFFERTA='NP')&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Confrontato DAC: &amp;quot;, string($firstRecord/tns1:DAC), &amp;quot; con &amp;quot;, string(xsd:date($Select_PactRich/Record[number($index)]/DAC)), &amp;quot;, e CODFC_OLO_AGCOM: &amp;quot;, $firstRecord/tns1:CodiceOrdineOlo, &amp;quot; con &amp;quot;, $Select_PactRich/Record[number($index)]/CODFC_OLO_AGCOM)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;CESSAZIONE NP: Confrontato solo CODFC_OLO_AGCOM: &amp;quot;, $firstRecord/tns1:CodiceOrdineOlo, &amp;quot; con &amp;quot;, $Select_PactRich/Record[number($index)]/CODFC_OLO_AGCOM)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
