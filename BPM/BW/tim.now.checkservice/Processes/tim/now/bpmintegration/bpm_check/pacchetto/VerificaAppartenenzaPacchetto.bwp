                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if(string-length($Select_PactRich/Record[number($index)]/COD_OLO_ACCORPANTE) > 0 &#xd;&#xa;and $firstRecord/ns5:CodificaOloAgcomDonating = $Select_PactRich/Record[number($index)]/COD_OLO_ACCORPANTE) then true() &#xd;&#xa;else if($firstRecord/ns5:CodificaOloAgcomDonating = $Select_PactRich/Record[number($index)]/CODIFICAOLOAGCOMDONATING or&#xd;&#xa;(not(string-length($firstRecord/ns5:CodificaOloAgcomDonating)>0) and not(string-length($Select_PactRich/Record[number($index)]/CODIFICAOLOAGCOMDONATING)>0))) then true() else false()"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="isUguale"
