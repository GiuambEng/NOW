                    outputVariable="RecuperaAttrCluster"
                    tibex:xpdlId="1eb040e1-3425-4df0-95a5-5735dc7a7073" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogVariazioneToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperaClusteToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1eb040e1-3425-4df0-95a5-5735dc7a7073+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaAttrCluster-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($Start/tns2:IdAssetDati)) > 0&quot;>&#xa;                    &lt;IdAsset>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns2:IdAssetDati)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns2:IdAssetDati&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IdAsset>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IdAsset>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns2:IdAssetFonia)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns2:IdAssetFonia&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IdAsset>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns8:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT att.DTTGLSST_TTRBTIDTTGLISST_BDSID, dett.NOMECOMPONENTE, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO, ass.VERSIONINGCLUSTERCOMUNE &#xa;FROM BDS_1_CASEDATA_ASSET ass, BDS_1_CASEDATA_DETTAGLIOASSET dett, BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xa;WHERE ass.BDS_ID = dett.ASSET_DETTAGLIOASSET_BDSID and&#xa;&#x9;dett.BDS_ID = att.DTTGLSST_TTRBTIDTTGLISST_BDSID and&#xa;&#x9;ass.IDASSET = ?&#xa;ORDER BY att.DTTGLSST_TTRBTIDTTGLISST_BDSID" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdAsset"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="DTTGLSST_TTRBTIDTTGLISST_BDSID"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="VERSIONINGCLUSTERCOMUNE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
