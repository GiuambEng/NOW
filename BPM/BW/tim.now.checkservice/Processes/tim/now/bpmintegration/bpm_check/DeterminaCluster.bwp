                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaCluster&quot;/>&lt;xsl:param name=&quot;RecuperaAttrCluster&quot;/>&lt;xsl:param name=&quot;RecuperaClusterMig&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperaClusterMIG_FTTH&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns2:DeterminaCluster_Response>&lt;tns2:Esito>&lt;tns2:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns2:Codice>&lt;tns2:Descrizione>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns2:Descrizione>&lt;/tns2:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns2:flagMigDel82)='SI'&quot;>&lt;xsl:if test=&quot;exists($RecuperaClusterMIG_FTTH/Record/TIPOLOGIACLUSTERCOMUNE)&quot;>&lt;xsl:if test=&quot;$RecuperaClusterMIG_FTTH/Record[1]/TIPOLOGIACLUSTERCOMUNE&quot;>&lt;tns2:TipologiaClusterComune>&lt;xsl:value-of select=&quot;$RecuperaClusterMIG_FTTH/Record[1]/TIPOLOGIACLUSTERCOMUNE&quot;/>&lt;/tns2:TipologiaClusterComune>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione=('VARIAZIONE','CESSAZIONE')&quot;>&lt;xsl:if test=&quot;$RecuperaAttrCluster/Record[starts-with(NOMECOMPONENTE, 'ACCESSO') and NOMEATTRIBUTO = 'TIPOLOGIACLUSTERCOMUNE']/VALOREATTRIBUTO&quot;>&lt;tns2:TipologiaClusterComune>&lt;xsl:value-of select=&quot;$RecuperaAttrCluster/Record[starts-with(NOMECOMPONENTE, 'ACCESSO') and NOMEATTRIBUTO = 'TIPOLOGIACLUSTERCOMUNE']/VALOREATTRIBUTO&quot;/>&lt;/tns2:TipologiaClusterComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione='MIGRAZIONE'&quot;>&lt;xsl:if test=&quot;exists($RecuperaClusterMig/Record/TIPOLOGIACLUSTERCOMUNE)&quot;>&lt;xsl:if test=&quot;$RecuperaClusterMig/Record[1]/TIPOLOGIACLUSTERCOMUNE&quot;>&lt;tns2:TipologiaClusterComune>&lt;xsl:value-of select=&quot;$RecuperaClusterMig/Record[1]/TIPOLOGIACLUSTERCOMUNE&quot;/>&lt;/tns2:TipologiaClusterComune>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;exists ($RecuperaCluster/Record/TIPOLOGIACLUSTERCOMUNE)&quot;>&lt;xsl:if test=&quot;$RecuperaCluster/Record[1]/TIPOLOGIACLUSTERCOMUNE&quot;>&lt;tns2:TipologiaClusterComune>&lt;xsl:value-of select=&quot;$RecuperaCluster/Record[1]/TIPOLOGIACLUSTERCOMUNE&quot;/>&lt;/tns2:TipologiaClusterComune>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($Start/tns2:flagMigDel82)='SI'&quot;>&lt;xsl:if test=&quot;exists($RecuperaClusterMIG_FTTH/Record/VERSIONING)&quot;>&lt;xsl:if test=&quot;$RecuperaClusterMIG_FTTH/Record[1]/VERSIONING&quot;>&lt;tns2:VersioningClusterComune>&lt;xsl:value-of select=&quot;$RecuperaClusterMIG_FTTH/Record[1]/VERSIONING&quot;/>&lt;/tns2:VersioningClusterComune>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione=('VARIAZIONE','CESSAZIONE')&quot;>&lt;xsl:if test=&quot;$RecuperaAttrCluster/Record[1]/VERSIONINGCLUSTERCOMUNE&quot;>&lt;tns2:VersioningClusterComune>&lt;xsl:value-of select=&quot;$RecuperaAttrCluster/Record[1]/VERSIONINGCLUSTERCOMUNE&quot;/>&lt;/tns2:VersioningClusterComune>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns2:Lavorazione='MIGRAZIONE'&quot;>&lt;xsl:if test=&quot;exists($RecuperaClusterMig/Record/VERSIONING)&quot;>&lt;xsl:if test=&quot;$RecuperaClusterMig/Record[1]/VERSIONING&quot;>&lt;tns2:VersioningClusterComune>&lt;xsl:value-of select=&quot;$RecuperaClusterMig/Record[1]/VERSIONING&quot;/>&lt;/tns2:VersioningClusterComune>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;exists ($RecuperaCluster/Record/VERSIONING)&quot;>&lt;xsl:if test=&quot;$RecuperaCluster/Record[1]/VERSIONING&quot;>&lt;tns2:VersioningClusterComune>&lt;xsl:value-of select=&quot;$RecuperaCluster/Record[1]/VERSIONING&quot;/>&lt;/tns2:VersioningClusterComune>&lt;/xsl:if>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns2:DeterminaCluster_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckOfferta" tibex:xpdlId="addba4d2-2b8b-42e2-9ee6-c9f1989ea3f9">
                <bpws:targets>
                    <bpws:target linkName="StartToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckOffertaToOscuramento">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckOffertaToGenericLogger">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:Offerta=('NP','FWA','CPS') or ($Start/tns:Offerta=('VP','VLAN','VLANNGA','VLANVULA') and $Start/tns:Lavorazione='CESSAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:Offerta=('NP','FWA','CPS') or ($Start/tns:Offerta=('VP','VLAN','VLANNGA','VLANVULA') and $Start/tns:Lavorazione='CESSAZIONE')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogKOInput-input"
                    name="LogKOInput"
                    tibex:xpdlId="f87cd7b6-8721-4508-a1ad-cfcee5d35f0c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckOffertaToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogKOInputToThrow"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:template name=&quot;LogKOInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'DeterminaCluster'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns2:IdRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:IdRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Servizio DeterminaCluster invocato con offerta errata'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns1:DefaultFault"
                faultVariable="Throw-input" name="Throw" tibex:xpdlId="4617c425-57df-4323-9167-d6056b916186">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;'Servizio DeterminaCluster invocato con offerta errata'&quot;/>&#xa;            &lt;/message>&#xa;        &lt;/tns8:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogKOInputToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:empty name="CheckLavorazione" tibex:xpdlId="95814365-6ab4-4dc3-babb-bd0acf8dc7c4">
                <bpws:targets>
                    <bpws:target linkName="LogOscuratoToCheckLavorazione"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckLavorazioneToRecuperaXmlOlo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:Lavorazione='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:Lavorazione='ATTIVAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckLavorazioneToGenericLogger_VariazioneCessazione">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:Lavorazione=('VARIAZIONE','CESSAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:Lavorazione=('VARIAZIONE','CESSAZIONE')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckLavorazioneToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Start/tns:Lavorazione='MIGRAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Start/tns:Lavorazione='MIGRAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckLavorazioneToIdOfferta_MIG_FTTH">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($Start/tns:flagMigDel82)='SI'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[upper-case($Start/tns:flagMigDel82)='SI']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CodiceIstatComune" name="CodiceIstat"
                    outputVariable="CodiceIstatComune"
                    tibex:xpdlId="fd884d22-5754-47ab-91f6-5e54ea274111" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CodiceIndirizzoToCodiceIstat"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CodiceIstatToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if (count($Oscuramento/Record)=0 and string-length($CodiceIndirizzo)>0) then (concat(tib:pad-front(substring-before($CodiceIndirizzo, '_'), 3, '0'),tib:pad-front(substring-before(substring-after($CodiceIndirizzo, '_'), '_'), 3, '0'))) else $Start/tns:IstatComune" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CodiceIstatComune" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogCodiceIstat-input"
                    name="LogCodiceIstat"
                    tibex:xpdlId="6eb56287-f6ee-4e3f-8fc1-38cbeaa0c8d8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CodiceIstatToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCodiceIstatToJDBCQuery"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;CodiceIstatComune&quot;/>&lt;xsl:template name=&quot;LogCodiceIstat-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'CheckService'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'DeterminaCluster'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns2:IdRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns2:IdRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Recuperato codice istat : ',$CodiceIstatComune)&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperaCluster-input"
                    name="RecuperaCluster"
                    outputVariable="RecuperaCluster"
                    tibex:xpdlId="89f96d7d-9968-446b-8aef-4520e83084f7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CodiceIstat3ToRecuperaCluster"/>
                        <bpws:target linkName="LogOffertaToRecuperaCluster"/>
                        <bpws:target linkName="AssignToRecuperaCluster"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="RecuperaClusterToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+89f96d7d-9968-446b-8aef-4520e83084f7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiceIstatComune&quot;/>&lt;xsl:param name=&quot;IdOfferta&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperaCluster-input&quot; match=&quot;/&quot;>&lt;tns5:jdbcQueryActivityInput>&lt;COD_ISTAT_COMUNE>&lt;xsl:value-of select=&quot;$CodiceIstatComune&quot;/>&lt;/COD_ISTAT_COMUNE>&lt;ID_OFFERTA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IdOfferta/Record[1]/ID_OFFERTA)&quot;>&lt;xsl:value-of select=&quot;$IdOfferta/Record[1]/ID_OFFERTA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_OFFERTA>&lt;DRO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Dro)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:Dro&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DRO>&lt;/tns5:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TIPOLOGIACLUSTERCOMUNE, DATAINIZIOLIBERALIZZAZIONE, DATAFINELIBERALIZZAZIONE, VERSIONING&#xa;FROM ANAGRAFICA_CLUSTER_COMUNE&#xa;WHERE CODICEISTATCOMUNE=? AND IDENTIFICATIVOOFFERTA=? AND TO_DATE(?,'yyyy-MM-dd') BETWEEN DATAINIZIOLIBERALIZZAZIONE AND DATAFINELIBERALIZZAZIONE" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISTAT_COMUNE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_OFFERTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="TIPOLOGIACLUSTERCOMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="DATAINIZIOLIBERALIZZAZIONE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="DATAFINELIBERALIZZAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="VERSIONING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RecuperaCodiceIndirizzo-input"
                    name="RecuperaCodiceIndirizzo"
                    outputVariable="RecuperaCodiceIndirizzo"
                    tibex:xpdlId="97d775fc-e63e-4b78-8602-3d7dd0b4a1a1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckLavorazioneToRecuperaXmlOlo"/>
                    </bpws:targets>
                    <bpws:sources>
