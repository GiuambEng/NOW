                    tibex:xpdlId="7d21d0f0-b158-4ed4-b1ad-be1b5d7a3550" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogCodiceIstatToJDBCQuery"/>
