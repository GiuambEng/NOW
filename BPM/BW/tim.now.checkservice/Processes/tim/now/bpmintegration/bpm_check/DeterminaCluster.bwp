                        <bpws:source linkName="RecuperaClusterMigToLogRecuperaCluster"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3fc6e07a-5638-4f86-9c6f-8afc9261d216+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CodiceIstatComune&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;RecuperaClusterMig-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;Codice_Istat>&lt;xsl:value-of select=&quot;$CodiceIstatComune&quot;/>&lt;/Codice_Istat>&lt;Offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Offerta>&lt;Dro>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns2:Dro)&quot;>&lt;xsl:value-of select=&quot;$Start/tns2:Dro&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Dro>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TIPOLOGIACLUSTERCOMUNE, DATAINIZIOLIBERALIZZAZIONE, DATAFINELIBERALIZZAZIONE, VERSIONING&#xa;FROM ANAGRAFICA_CLUSTER_COMUNE&#xa;WHERE CODICEISTATCOMUNE=? AND IDENTIFICATIVOOFFERTA=(SELECT ID_OFFERTA&#xa;  FROM TRASCODFC_OFFERTA WHERE NOME_OFFERTA_ESTERNA=? AND PROVENIENZA='BPM') AND TO_DATE(?,'yyyy-MM-dd') BETWEEN DATAINIZIOLIBERALIZZAZIONE AND DATAFINELIBERALIZZAZIONE" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Codice_Istat"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Offerta"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Dro"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="TIPOLOGIACLUSTERCOMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="DATAINIZIOLIBERALIZZAZIONE"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="DATAFINELIBERALIZZAZIONE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="VERSIONING"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
