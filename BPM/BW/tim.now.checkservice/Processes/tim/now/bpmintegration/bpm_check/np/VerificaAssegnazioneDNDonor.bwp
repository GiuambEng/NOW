                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="DistrettoNormalizzato" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+13e76c93-b0aa-40e7-b518-3eba853917e5+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaAssegnazioneDNDonorIn&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;DistrettoNormalizzato&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;JDBC_DN-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_DISTR>&lt;xsl:value-of select=&quot;$DistrettoNormalizzato&quot;/>&lt;/COD_DISTR>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:CodiceOLOAGCOMDonor&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;NUMERAZIONE_1>&lt;xsl:value-of select=&quot;substring-after($currentElement, $Distretto)&quot;/>&lt;/NUMERAZIONE_1>&lt;COUNT_1>&lt;xsl:value-of select=&quot;string-length(substring-after($currentElement, $Distretto))&quot;/>&lt;/COUNT_1>&lt;COUNT_2>&lt;xsl:value-of select=&quot;string-length(substring-after($currentElement, $Distretto))&quot;/>&lt;/COUNT_2>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:Data_Invio_Rich)&quot;>&lt;DATA>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:Data_Invio_Rich)&quot;>&lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:Data_Invio_Rich&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATA xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBC_DN-input"
                                    name="JDBC_DN"
                                    outputVariable="JDBC_DN"
                                    tibex:xpdlId="13e76c93-b0aa-40e7-b518-3eba853917e5" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToJDBC_DN1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToVerificaAssegnazioneDNDonorOut"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+13e76c93-b0aa-40e7-b518-3eba853917e5+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaAssegnazioneDNDonorIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;DistrettoNormalizzato&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_DN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;COD_DISTR>&#xa;                &lt;xsl:value-of select=&quot;$DistrettoNormalizzato&quot;/>&#xa;            &lt;/COD_DISTR>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn.input/tns1:CodiceOLOAGCOMDonor&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;NUMERAZIONE_1>&#xa;                &lt;xsl:value-of select=&quot;substring-after($currentElement, $Distretto)&quot;/>&#xa;            &lt;/NUMERAZIONE_1>&#xa;            &lt;COUNT_1>&#xa;                &lt;xsl:value-of select=&quot;string-length(substring-after($currentElement, $Distretto))&quot;/>&#xa;            &lt;/COUNT_1>&#xa;            &lt;COUNT_2>&#xa;                &lt;xsl:value-of select=&quot;string-length(substring-after($currentElement, $Distretto))&quot;/>&#xa;            &lt;/COUNT_2>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaAssegnazioneDNDonorIn.input/tns1:Data_Invio_Rich)&quot;>&#xa;                    &lt;DATA>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaAssegnazioneDNDonorIn.input/tns1:Data_Invio_Rich)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn.input/tns1:Data_Invio_Rich&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DATA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATA xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT COUNT(*)&#xa;FROM ARCHI_NUMRZNE_DIOGENE&#xa;WHERE COD_DISTR = ? AND CODFC_OLO_AGCOM = ? AND (? BETWEEN RPAD(ARCO_NUMRZNE_DA, ?, 0) AND&#xa;&#x9;&#x9;RPAD(ARCO_NUMRZNE_A, ?, 9)) AND (? BETWEEN DATAINZ_VALID AND DATAFI_VALID OR SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_DISTR"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERAZIONE_1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_2"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA"/>

                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaAssegnazioneDNDonorIn&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;JDBC_DN&quot;/>&lt;xsl:param name=&quot;currentElement&quot;/>&lt;xsl:template name=&quot;LOG_DN-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAssegnazioneDNDonor&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaAssegnazioneDNDonor&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBC_DN/Record[1]/COUNT != 0.0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Il numero &amp;quot;, $currentElement, &amp;quot; e assegnato all OLO &amp;quot;, $VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:CodiceOLOAGCOMDonor, &amp;quot; ed e ancora attivo alla data corrente.&amp;quot;)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Il numero &amp;quot;, $currentElement, &amp;quot; non e assegnato all OLO &amp;quot;, $VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:CodiceOLOAGCOMDonor, &amp;quot; o non e piu attivo alla data corrente.&amp;quot;)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot; 'tim.now.checkservice.bpm_checkNp'&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'VerificaAssegnazioneDNDonor'&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&lt;/tns:Source>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;tns:EventType>&lt;xsl:value-of select=&quot;'VerificaAssegnazioneDNDonor_SUB-PROCESS'&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat('VerificaAssegnazioneDNDonor_', $VerificaAssegnazioneDNDonorIn/input/tns1:Verifica_Assegnazione_DN_Donor_Request/tns1:IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LOG_DN-input"
                                    name="LOG_DN"
                                    tibex:xpdlId="7a448658-04b3-48b4-a9f5-e5b7406c1f60"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToVerificaAssegnazioneDNDonorOut"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LOG_DNToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LOG_OK">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$JDBC_DN/Record[1]/COUNT != 0.0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$JDBC_DN/Record[1]/COUNT != 0.0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaAssegnazioneDNDonorIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_DN&quot;/>&#xa;    &lt;xsl:param name=&quot;currentElement&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_DN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaAssegnazioneDNDonor&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaAssegnazioneDNDonor&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JDBC_DN/Record[1]/COUNT != 0.0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Il numero &amp;quot;, $currentElement, &amp;quot; e assegnato all OLO &amp;quot;, $VerificaAssegnazioneDNDonorIn.input/tns1:CodiceOLOAGCOMDonor, &amp;quot; ed e ancora attivo alla data corrente.&amp;quot;)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Il numero &amp;quot;, $currentElement, &amp;quot; non e assegnato all OLO &amp;quot;, $VerificaAssegnazioneDNDonorIn.input/tns1:CodiceOLOAGCOMDonor, &amp;quot; o non e piu attivo alla data corrente.&amp;quot;)&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot; 'tim.now.checkservice.bpm_checkNp'&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaAssegnazioneDNDonor'&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;tns:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaAssegnazioneDNDonorIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns:BusinessID>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaAssegnazioneDNDonor_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaAssegnazioneDNDonor_', $VerificaAssegnazioneDNDonorIn.input/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
