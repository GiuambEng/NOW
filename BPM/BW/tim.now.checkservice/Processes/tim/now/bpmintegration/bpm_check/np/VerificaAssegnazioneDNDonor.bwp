                                    <tibex:inputBinding
                                    expression="if(substring($currentElement, 2, 1) = &quot;6&quot; or substring($currentElement, 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($currentElement, 1, 2)) else if(substring($currentElement, 3, 1) = &quot;0&quot; or substring($currentElement, 3, 1) = &quot;1&quot; or substring($currentElement, 3, 1) = &quot;5&quot; or substring($currentElement, 3, 1) = &quot;9&quot;) then substring($currentElement, 1, 3) else substring($currentElement, 2, 3)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
