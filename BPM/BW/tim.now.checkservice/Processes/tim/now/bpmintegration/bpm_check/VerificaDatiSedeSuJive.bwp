                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT NC.CAP, NC.COD_NUMERO_CIVICO, NC.COD_STRADA, NC.NUMERO_CIVICO, V.COD_DISTR,&#xa;&#x9;&#x9;V.COD_VIA, CL.DESCR_COMUNE, PA.DESCR_PARTICELLA_TOPON, V.DESCR_VIA, NC.COD_TOPON,&#xa;&#x9;&#x9;V.COD_ISTAT_COMUNE, V.COD_ISTAT_PROV, PR.DESCR_PROV, PR.SIGLA_PROV, CNC.CLLI&#xa;FROM NUMERO_CIVICO NC, VIA V, COMUNE_O_LOCALITA CL, PARTICELLA PA, PROV PR, CENTRALE_NUMERO_CIVICO CNC&#xa;  WHERE  NC.COD_STRADA = V.COD_STRADA &#xa;        AND PR.COD_PROV = CL.COD_PROV &#xa;        AND V.COD_PARTICELLA_TOPON = PA.COD_PARTICELLA_TOPON&#xa;        AND NC.COD_NUMERO_CIVICO = CNC.COD_NUMERO_CIVICO&#xa;        AND V.COD_COMUNE = CL.COD_COMUNE&#xa;        AND RTRIM(PA.DESCR_PARTICELLA_TOPON) = ?&#xa;        AND RTRIM(V.DESCR_VIA) = ?&#xa;        AND RTRIM(NC.NUMERO_CIVICO) = ?&#xa;        AND RTRIM(CL.DESCR_COMUNE) = ?&#xa;        AND RTRIM(CL.COD_ISTAT_COMUNE) = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_PARTICELLA_TOPON"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_VIA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_CIVICO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCR_COMUNE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_ISTAT_COMUNE"/>
                                    <columnMetadata columnName="CAP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_NUMERO_CIVICO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="COD_STRADA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NUMERO_CIVICO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_DISTR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_VIA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR_COMUNE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_PARTICELLA_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DESCR_VIA"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_TOPON"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_ISTAT_COMUNE"
