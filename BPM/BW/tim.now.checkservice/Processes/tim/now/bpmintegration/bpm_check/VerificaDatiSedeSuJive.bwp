                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+31c17638-4b8d-410e-a553-8202276e393d+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Verifica_Dati_Sede_su_JiveIn&quot;/>&lt;xsl:template name=&quot;SelectCodiceToponomastica-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_PARTICELLA_TOPON>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Verifica_Dati_Sede_su_JiveIn/parameters/tns2:Verifica_Dati_Sede_su_Jive/tns1:Codice_Indirizzo_Toponomastica)&quot;>&lt;xsl:value-of select=&quot;$Verifica_Dati_Sede_su_JiveIn/parameters/tns2:Verifica_Dati_Sede_su_Jive/tns1:Codice_Indirizzo_Toponomastica&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_PARTICELLA_TOPON>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
