                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_Dati_Sede_su_JiveIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JiveWirelineAddressCertificationInvoke.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectCodiceToponomastica&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectIndirizzo&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaDatiSedeSuJiveResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($JiveWirelineAddressCertificationInvoke.parameters)&quot;>&#xa;                &lt;tns:Verifica_Dati_Sede_su_Jive_Response>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JiveWirelineAddressCertificationInvoke.parameters/tns2:ESITO = &amp;quot;OK&amp;quot;&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:Sede>&#xa;                        &lt;IDRichiestaOLO>&#xa;                            &lt;xsl:value-of select=&quot;$Verifica_Dati_Sede_su_JiveIn.parameters/tns:IDRichiestaNOW&quot;/>&#xa;                        &lt;/IDRichiestaOLO>&#xa;                        &lt;IDSede>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/IDSede>&#xa;                        &lt;xsl:if test=&quot;$JiveWirelineAddressCertificationInvoke.parameters/tns2:DESC_PART_TOPON&quot;>&#xa;                            &lt;particellaToponomastica>&#xa;                                &lt;xsl:value-of select=&quot;$JiveWirelineAddressCertificationInvoke.parameters/tns2:DESC_PART_TOPON&quot;/>&#xa;                            &lt;/particellaToponomastica>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$JiveWirelineAddressCertificationInvoke.parameters/tns2:DESC_VIA&quot;>&#xa;                            &lt;via>&#xa;                                &lt;xsl:value-of select=&quot;$JiveWirelineAddressCertificationInvoke.parameters/tns2:DESC_VIA&quot;/>&#xa;                            &lt;/via>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$JiveWirelineAddressCertificationInvoke.parameters/tns2:COD_VIA&quot;>&#xa;                            &lt;codiceVia>&#xa;                                &lt;xsl:value-of select=&quot;$JiveWirelineAddressCertificationInvoke.parameters/tns2:COD_VIA&quot;/>&#xa;                           