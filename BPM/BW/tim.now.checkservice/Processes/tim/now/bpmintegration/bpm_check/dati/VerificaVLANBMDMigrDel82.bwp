                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PROFILO_BMD&#xa;FROM PROFILO_TCNC_LINEA PTL, TRASCODFC_OFFERTA TRO&#xa;WHERE PTL.PROFILO_TCNC_LINEA = ? AND PTL.ID_OFFERTA = TRO.ID_OFFERTA AND &#xa;TRO.NOME_OFFERTA_ESTERNA = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

