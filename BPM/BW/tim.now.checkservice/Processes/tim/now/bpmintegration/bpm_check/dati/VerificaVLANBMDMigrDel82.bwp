                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if((string-length($Start/tns:banda[number($index)]/tns:profiloBMD)=0 and $Start/tns:Offerta=('BITSTREAMNGAFTTH','FULLGPONPLUSNGA')) or $VULA_Y_2/Record[1]/FLAG_OSCURABILE='Y' or&#xd;&#xa;(string-length($NGA/Record[1]/ID_PROFILO_BMD)=0 and string-length($VULA_N/Record[1]/ID_PROFILO_BMD)=0 and string-length($VULA_Y/Record[1]/ID_PROFILO_BMD)=0 and string-length(xsd:string($VULA_Y_2/Record[1]/ID_PROFILO_BMD))=0)) then $Flag=false() else $Flag=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
