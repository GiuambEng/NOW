                            <bpws:empty name="Empty" tibex:xpdlId="38286e4a-7fbf-4902-8410-a9c49183f773">
                                <bpws:targets>
                                    <bpws:target linkName="GroupStartToEmpty"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="EmptyToVULA_Y">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="EmptyToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Start/tns:Offerta=('VULAFTTH','SEMIVULAFTTH') and $Start/tns:profiloTecnicoLinea='Z9' and exists($Start/tns:banda[tns:bandaPiccoDown='2300' and tns:bandaPiccoUp ='500'])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Start/tns:Offerta=('VULAFTTH','SEMIVULAFTTH') and $Start/tns:profiloTecnicoLinea='Z9' and exists($Start/tns:banda[tns:bandaPiccoDown='2300' and tns:bandaPiccoUp ='500'])]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="VULA_Y_2-input"
                                    name="VULA_Y_2"
                                    outputVariable="VULA_Y_2"
                                    tibex:xpdlId="657b18d2-957a-4aed-aa63-eb60634d777d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="EmptyToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VULA_Y_2ToLogVULA_Y_2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+657b18d2-957a-4aed-aa63-eb60634d777d+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;VULA_Y_2-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;Offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Offerta)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/Offerta>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PROFILO_BMD,FLAG_OSCURABILE&#xd;&#xa;FROM PROFILO_VLAN_BMD PVB, trascodfc_offerta TF, OFFERTA O, TIPOLG_VLAN TV&#xd;&#xa;WHERE pvb.id_sottofamig_offerta=o.id_sottofamig_offerta AND o.id_offerta=tf.id_offerta AND tv.idtplg_vlan=pvb.idtplg_vlan &#xd;&#xa;AND UPPER(O.NOME_OFFERTA_CATLG)=? AND TV.descr='VULA' AND pvb.flag_nuovo_modello='Y' &#xd;&#xa;AND pvb.profilo='Z9' AND pvb.bp2_max=1000 AND pvb.bp2=2300 AND pvb.bp5=15&#xd;&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="Offerta"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="ID_PROFILO_BMD"
                                    dataType="4" typeName="number"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="FLAG_OSCURABILE"
                                    dataType="12" typeName="varchar2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogVULA_Y_2-input"
                                    name="LogVULA_Y_2"
                                    tibex:xpdlId="931b02e7-5d7f-4ec6-875b-986f98622dcb"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="VULA_Y_2ToLogVULA_Y_2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogVULA_Y_2ToFlag"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VULA_Y_2&quot;/>&lt;xsl:template name=&quot;LogVULA_Y_2-input&quot; match=&quot;/&quot;>&lt;tns4:CW_BUS_MESSAGE>&lt;tns4:GenericLogger>&lt;tns4:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns4:Application>&lt;tns4:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVLANBMDMigrDel82&amp;quot;&quot;/>&lt;/tns4:Process>&lt;tns4:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDari&amp;quot;&quot;/>&lt;/tns4:Service>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVLANBMDMigrDel82&amp;quot;&quot;/>&lt;/tns4:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns4:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns4:BusinessID>&lt;/xsl:if>&lt;tns4:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Query VULA_Y_2: &amp;quot;, tib:render-xml($VULA_Y_2/Record[1]/ID_PROFILO_BMD, true(), true()))&quot;/>&lt;/tns4:Message>&lt;tns4:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns4:LoggerName>&lt;tns4:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns4:LogLevel>&lt;tns4:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:LogJMS>&lt;/tns4:GenericLogger>&lt;/tns4:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogInput-input"
                    name="LogInput"
                    tibex:xpdlId="16523ba1-964b-45f4-9dbe-09fafdc8732c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToWhile"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns4:CW_BUS_MESSAGE>&lt;tns4:GenericLogger>&lt;tns4:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns4:Application>&lt;tns4:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVLANBMDMigrDel82&amp;quot;&quot;/>&lt;/tns4:Process>&lt;tns4:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDari&amp;quot;&quot;/>&lt;/tns4:Service>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVLANBMDMigrDel82&amp;quot;&quot;/>&lt;/tns4:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns4:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns4:BusinessID>&lt;/xsl:if>&lt;tns4:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;VerificaVLANBMDMigrDel82 Input: &amp;quot;, tib:render-xml($Start, true(), true()))&quot;/>&lt;/tns4:Message>&lt;tns4:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns4:LoggerName>&lt;tns4:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns4:LogLevel>&lt;tns4:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:LogJMS>&lt;/tns4:GenericLogger>&lt;/tns4:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
