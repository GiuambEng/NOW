                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Flag=true()]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="FlagToAccumulate">
