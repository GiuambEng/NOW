                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;VULA_Y&quot;/>&lt;xsl:template name=&quot;LogVULA_Y-input&quot; match=&quot;/&quot;>&lt;tns4:CW_BUS_MESSAGE>&lt;tns4:GenericLogger>&lt;tns4:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns4:Application>&lt;tns4:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVLANBMDMigrDel82&amp;quot;&quot;/>&lt;/tns4:Process>&lt;tns4:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDari&amp;quot;&quot;/>&lt;/tns4:Service>&lt;tns4:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVLANBMDMigrDel82&amp;quot;&quot;/>&lt;/tns4:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns4:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns4:BusinessID>&lt;/xsl:if>&lt;tns4:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Query VULA_Y: &amp;quot;, tib:render-xml($VULA_Y/Record[1]/ID_PROFILO_BMD, true(), true()))&quot;/>&lt;/tns4:Message>&lt;tns4:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns4:LoggerName>&lt;tns4:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns4:LogLevel>&lt;tns4:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns4:LogJMS>&lt;/tns4:GenericLogger>&lt;/tns4:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
