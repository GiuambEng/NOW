                                    expression="(exists($AnagAdrVlan/Record[1]/ID_MACROAREA) and string-length($AnagAdrVlan/Record[1]/ID_MACROAREA) > 0) or (exists($AnagAdrVp/Record[1]/ID_MACROAREA) and string-length($AnagAdrVp/Record[1]/ID_MACROAREA) > 0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(exists($AnagAdrVlan/Record[1]/ID_MACROAREA) and string-length($AnagAdrVlan/Record[1]/ID_MACROAREA) > 0) or (exists($AnagAdrVp/Record[1]/ID_MACROAREA) and string-length($AnagAdrVp/Record[1]/ID_MACROAREA) > 0)]]></bpws:transitionCondition>
                        </bpws:source>
