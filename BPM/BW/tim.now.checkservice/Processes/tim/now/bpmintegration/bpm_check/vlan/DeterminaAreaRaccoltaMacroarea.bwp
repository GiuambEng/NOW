                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;QueryNGA&quot;/>&lt;xsl:param name=&quot;QueryGBEKit&quot;/>&lt;xsl:param name=&quot;QueryVPKit&quot;/>&lt;xsl:param name=&quot;QueryNGAKit&quot;/>&lt;xsl:param name=&quot;QueryVP&quot;/>&lt;xsl:param name=&quot;QueryGBE&quot;/>&lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'DeterminaAreaRaccoltaMacroarea'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:IdRichiestaOlo&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IdRichiestaOlo&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='VARIAZIONE' and $Start/tns1:SottoLavorazione='VARIAZIONETDKIT' and $Start/tns1:Offerta='VLAN'&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Output QueryGBEKit: ',tib:render-xml($QueryGBEKit))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns1:Lavorazione='VARIAZIONE' and $Start/tns1:SottoLavorazione='VARIAZIONETDKIT' and $Start/tns1:Offerta=('VLANNGA','VLANVULA')&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;conca