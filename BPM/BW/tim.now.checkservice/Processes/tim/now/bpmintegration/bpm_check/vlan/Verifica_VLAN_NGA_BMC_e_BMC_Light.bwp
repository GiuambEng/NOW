            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="QueryCodTiplgCos-input"
                    name="QueryCodTiplgCos"
                    outputVariable="QueryCodTiplgCos"
                    tibex:xpdlId="d30ef5ed-179e-41f0-8344-772ba6cbb361" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToJDBCQuery3"/>
                        <bpws:target linkName="CallProcess2ToJDBCQuery3"/>
                        <bpws:target linkName="CallProcess3ToJDBCQuery3"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQuery3ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d30ef5ed-179e-41f0-8344-772ba6cbb361+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryAssMadrFis&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryAnagAdr&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryNGA&quot;/>&#xa;    &lt;xsl:param name=&quot;QueryAnagAdr123&quot;/>&#xa;    &lt;xsl:template name=&quot;QueryCodTiplgCos-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:SuperMacroArea='1'&quot;>&#xa;                    &lt;ID_ADR_CRMWS_1>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA']/ID_ADR_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA']/ID_ADR_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ADR_CRMWS_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:SuperMacroArea='2'&quot;>&#xa;                    &lt;ID_ADR_CRMWS_1>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_CC']/ID_ADR_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_CC']/ID_ADR_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ADR_CRMWS_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Start/tns:SuperMacroArea='3'&quot;>&#xa;                    &lt;ID_ADR_CRMWS_1>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_LIB']/ID_ADR_CRMWS)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$QueryAnagAdr123/Record[DESCRIZIONE_AREA='SUPERMACROAREA_LIB']/ID_ADR_CRMWS&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ADR_CRMWS_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns:CC_LIB) and string-length($Start/tns:CC_LIB)>0 and $Start/tns:CC_LIB='CC' and ($Start/tns:SuperMacroArea='0' or string-length($Start/tns:SuperMacroArea)=0 or not(exists($Start/tns:SuperMacroArea)))&quot;>&#xa;                    &lt;ID_ADR_CRMWS_1>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($QueryAssMadrFis/Record[1]/ROW_ID_ADR_CC)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$QueryAssMadrFis/Record[1]/ROW_ID_ADR_CC&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ADR_CRMWS_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns:CC_LIB) and string-length($Start/tns:CC_LIB)>0 and $Start/tns:CC_LIB='LIB' and ($Start/tns:SuperMacroArea='0' or string-length($Start/tns:SuperMacroArea)=0 or not(exists($Start/tns:SuperMacroArea)))&quot;>&#xa;                    &lt;ID_ADR_CRMWS_1>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($QueryAssMadrFis/Record[1]/ROW_ID_ADR_LIB)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$QueryAssMadrFis/Record[1]/ROW_ID_ADR_LIB&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ADR_CRMWS_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_ADR_CRMWS_1>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($QueryAnagAdr/Record[1]/ID_MACROAREA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$QueryAnagAdr/Record[1]/ID_MACROAREA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_ADR_CRMWS_1>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_ADR_CRMWS_2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($QueryNGA/Record[1]/ID_ADR_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$QueryNGA/Record[1]/ID_ADR_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_ADR_CRMWS_2>&#xa;            &lt;CODICE_KIT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CodiceTdKit)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CodiceTdKit&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_KIT>&#xa;            &lt;CODICE_CAR>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Start/tns:CAR)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:CAR&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_CAR>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Start/tns:BmcLight='SI'&quot;>&#xa;                    &lt;NOME_AGGREGATO>&#xa;                        &lt;xsl:value-of select=&quot;'Aggregato NGA BMC Light'&quot;/>&#xa;                    &lt;/NOME_AGGREGATO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NOME_AGGREGATO>&#xa;                        &lt;xsl:value-of select=&quot;'Aggregato NGA BMC'&quot;/>&#xa;                    &lt;/NOME_AGGREGATO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODICE_TIPOLOGIA_COS&#xd;&#xa;FROM TIPOLOGIA_COS&#xd;&#xa;WHERE ID_TIPOLOGIA_COS IN (SELECT ID_TIPOLOGIA_COS&#xd;&#xa;FROM ANAGRAFICA_KIT_VLAN_ADR_CAR&#xd;&#xa;WHERE ID_ADR_CRMWS IN (?,?) AND CODICE_KIT=? AND CODICE_CAR=? AND NOME_AGGREGATO LIKE ?)" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ADR_CRMWS_1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_ADR_CRMWS_2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_KIT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_CAR"/>
                                    <PreparedParameters
                                    DataType="12"
