                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_K_BANDA_PICCO,VALORE&#xa;  FROM K_BANDA_PICCO&#xa;  WHERE ID_OFFERTA =? &#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_OFFERTA"/>
                                    <columnMetadata
                                    columnName="ID_K_BANDA_PICCO"
