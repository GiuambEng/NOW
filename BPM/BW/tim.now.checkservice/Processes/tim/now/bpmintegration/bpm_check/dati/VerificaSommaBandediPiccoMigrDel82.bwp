                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns5=&quot;http://www.example.org/Bande&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Bande&quot;/>&lt;xsl:param name=&quot;PROFILO_TCNC_LINEA&quot;/>&lt;xsl:param name=&quot;K_BANDA_PICCO&quot;/>&lt;xsl:template name=&quot;SommaEsito&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Bande/tns5:Bande/tns5:BandaUP&amp;lt;=(($K_BANDA_PICCO/Record[1]/VALORE)*xsd:decimal((if(contains(string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_UP), &amp;quot;,&amp;quot;)) then concat(substring-before(string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_UP), &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after(string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_UP), &amp;quot;,&amp;quot;))&amp;#x9;else string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_UP)))) and ($Bande/tns5:Bande/tns5:BandaDown) &amp;lt;= (($K_BANDA_PICCO/Record[1]/VALORE)*xsd:decimal((if(contains(string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_DOWN), &amp;quot;,&amp;quot;)) then concat(substring-before(string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_DOWN), &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after(string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_DOWN), &amp;quot;,&amp;quot;)) else string($PROFILO_TCNC_LINEA/Record[1]/PROFILO_COMMERCIALE_DOWN))))&quot;>&lt;tns1:VerificaCoppiaBandadiPiccoMigrDel82_Response>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:VerificaCoppiaBandadiPiccoMigrDel82_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:VerificaCoppiaBandadiPiccoMigrDel82_Response>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:VerificaCoppiaBandadiPiccoMigrDel82_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
