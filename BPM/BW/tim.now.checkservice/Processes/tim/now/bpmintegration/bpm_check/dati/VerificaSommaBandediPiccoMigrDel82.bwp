                                    sqlStatement="SELECT TRO.ID_OFFERTA&#xa;  FROM TRASCODFC_OFFERTA  TRO, OFFERTA  O&#xa;  WHERE TRO.NOME_OFFERTA_ESTERNA = ? AND TRO.ID_OFFERTA = O.ID_OFFERTA AND TRO.PROVENIENZA = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
