            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogK_BANDA_PICCO-input"
                    name="LogK_BANDA_PICCO"
                    tibex:xpdlId="70ee1787-96d3-429e-a40d-e9f2930ff895"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="K_BANDA_PICCOToCopy_1_LogPROFILO_TCNC_LINEA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_LogPROFILO_TCNC_LINEAToBandaUP">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($K_BANDA_PICCO/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($K_BANDA_PICCO/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="Copy_1_LogPROFILO_TCNC_LINEAToEsitoKO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
