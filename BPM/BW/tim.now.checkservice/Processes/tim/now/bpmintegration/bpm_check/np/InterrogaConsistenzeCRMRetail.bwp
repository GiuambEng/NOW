            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="RequestCRMB-input" name="RequestCRMB"
                    outputVariable="RequestCRMB"
                    tibex:xpdlId="7963457a-0a3f-4297-99f1-0ebb249972d4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
