                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns11="http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29" xmlns:cst="http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsertStagCCC"/&gt;&lt;xsl:param name="InvokeCCC"/&gt;&lt;xsl:template name="UpdateStagCCC-input" match="/"&gt;&lt;tns2:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns:StagingRequest&gt;&lt;tns:GenericStaging&gt;&lt;tns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="'11'"/&gt;&lt;/tns:ID_STATO_ELAB_STAG&gt;&lt;tns:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut)"/&gt;&lt;/tns:CONTENUTO_RESPONSE&gt;&lt;xsl:if test="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Codice"&gt;&lt;tns:ESITO&gt;&lt;xsl:value-of select="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Codice"/&gt;&lt;/tns:ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Multinumero/cst:Principale"&gt;&lt;tns:PRINCIPALE&gt;&lt;xsl:value-of select="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Multinumero/cst:Principale"/&gt;&lt;/tns:PRINCIPALE&gt;&lt;/xsl:if&gt;&lt;tns:QT_AGGIUNTIVI&gt;&lt;xsl:value-of select="xsd:int(count($InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Multinumero/cst:Aggiuntivi/cst:Aggiuntivo))"/&gt;&lt;/tns:QT_AGGIUNTIVI&gt;&lt;tns:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TIMSTP_RISPOSTA&gt;&lt;xsl:if test="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Descrizione"&gt;&lt;tns:DESCR_ESITO&gt;&lt;xsl:value-of select="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Descrizione"/&gt;&lt;/tns:DESCR_ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione"&gt;&lt;tns:STATO_SERVIZIO_CRM&gt;&lt;xsl:value-of select="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione"/&gt;&lt;/tns:STATO_SERVIZIO_CRM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita"&gt;&lt;tns:TIPO_LINEA&gt;&lt;xsl:value-of select="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita"/&gt;&lt;/tns:TIPO_LINEA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoServizio"&gt;&lt;tns:STATO_ULTIMO_ORDINE_CRM&gt;&lt;xsl:value-of select="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoServizio"/&gt;&lt;/tns:STATO_ULTIMO_ORDINE_CRM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Lavorazione"&gt;&lt;tns:LAVORAZIONE_ORDINE_CRM&gt;&lt;xsl:value-of select="$InvokeCCC/body/ns11:getDataResponse/ns11:GetDatiLineaUnicaXSoapOut/cst:Lavorazione"/&gt;&lt;/tns:LAVORAZIONE_ORDINE_CRM&gt;&lt;/xsl:if&gt;&lt;tns:SISTEMA&gt;&lt;xsl:value-of select="'CCC'"/&gt;&lt;/tns:SISTEMA&gt;&lt;/tns:GenericStaging&gt;&lt;tns:StagingType&gt;&lt;xsl:value-of select="'STAG_NOWTOCRM_VERETAIL_NO_FILE'"/&gt;&lt;/tns:StagingType&gt;&lt;tns:LoggerIn&gt;&lt;ns1:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns1:TipologiaProcesso&gt;&lt;ns1:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns1:TipologiaOperazione&gt;&lt;ns1:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsertStagCCC/RESPONSE/tns:StagingResponse/tns:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;&lt;ns1:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStagCCC/RESPONSE/tns:StagingResponse/tns:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;&lt;/ns1:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagCCC/RESPONSE/tns:StagingResponse/tns:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE)) "/&gt;&lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="34"/&gt;&lt;/ns1:ID_PROCSO_NO_FILE&gt;&lt;ns1:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns1:STATO_ESEC&gt;&lt;ns1:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TMSP_FINE_ELAB&gt;&lt;/ns1:EsecuzioneNOFileProcessato&gt;&lt;ns1:LogFileProcessato&gt;&lt;ns1:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns1:LOG_LEVEL&gt;&lt;ns1:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;"/&gt;&lt;/ns1:LOG_MESSAGE&gt;&lt;ns1:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TIMSTP_INSMTO&gt;&lt;/ns1:LogFileProcessato&gt;&lt;/tns:LoggerIn&gt;&lt;/tns:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns2:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns11=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStagCCC.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeCCC.body&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagCCC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingRequest>&#xa;            &lt;tns:GenericStaging>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;tns:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut)&quot;/>&#xa;                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:if test=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Codice&quot;>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Codice&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Multinumero/cst:Principale&quot;>&#xa;                    &lt;tns:PRINCIPALE>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Multinumero/cst:Principale&quot;/>&#xa;                    &lt;/tns:PRINCIPALE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:QT_AGGIUNTIVI>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int(count($InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Multinumero/cst:Aggiuntivi/cst:Aggiuntivo))&quot;/>&#xa;                &lt;/tns:QT_AGGIUNTIVI>&#xa;                &lt;tns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:if test=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Descrizione&quot;>&#xa;                    &lt;tns:DESCR_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Errore/cst:Descrizione&quot;/>&#xa;                    &lt;/tns:DESCR_ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione&quot;>&#xa;                    &lt;tns:STATO_SERVIZIO_CRM>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione&quot;/>&#xa;                    &lt;/tns:STATO_SERVIZIO_CRM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita&quot;>&#xa;                    &lt;tns:TIPO_LINEA>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:TipoConnettivita&quot;/>&#xa;                    &lt;/tns:TIPO_LINEA>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoServizio&quot;>&#xa;                    &lt;tns:STATO_ULTIMO_ORDINE_CRM>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:StatoServizio&quot;/>&#xa;                    &lt;/tns:STATO_ULTIMO_ORDINE_CRM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Lavorazione&quot;>&#xa;                    &lt;tns:LAVORAZIONE_ORDINE_CRM>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCCC.body/ns11:GetDatiLineaUnicaXSoapOut/cst:Lavorazione&quot;/>&#xa;                    &lt;/tns:LAVORAZIONE_ORDINE_CRM>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:SISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;'CCC'&quot;/>&#xa;                &lt;/tns:SISTEMA>&#xa;            &lt;/tns:GenericStaging>&#xa;            &lt;tns:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_NOWTOCRM_VERETAIL_NO_FILE'&quot;/>&#xa;            &lt;/tns:StagingType>&#xa;            &lt;tns:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStagCCC.RESPONSE/tns:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStagCCC.RESPONSE/tns:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagCCC.RESPONSE/tns:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE)) &quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;34&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns:LoggerIn>&#xa;        &lt;/tns:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogInvokeCCCToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateStagCCCToGenericLogger"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogUpdStagCCC-input"
                    name="LogUpdStagCCC"
                    tibex:xpdlId="54186dc9-a56f-4660-b629-bf524821b432"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateStagCCCToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogUpdStagCCCToAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;LogName&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogUpdStagCCC-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;InterrogaConsistenzeCRMRetail&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;InterrogaConsistenzeCRMRetail&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Update in staging per CCC completato'&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LogName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:s0=&quot;http://tempuri.org/&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; xmlns:ns1=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeCCC&quot;/>&lt;xsl:param name=&quot;InvokeCRMB&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:InterrogaConsistenzeCRMRetail_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($_error/StackTrace)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($InvokeCCC/body/ns1:getDataResponse/ns1:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione)!='ATTIVO' and upper-case($InvokeCRMB/parameters/s0:GetNumerazioniResponse/s0:GetNumerazioniResult/s0:Numerazioni/s0:Numerazione[s0:Principale=$Start/tns:DN and upper-case(s0:StatoServizio)!='CESSATO'][1]/s0:StatoNumerazione)!='ATTIVO'&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;(upper-case($InvokeCRMB/parameters/s0:GetNumerazioniResponse/s0:GetNumerazioniResult/s0:Numerazioni/s0:Numerazione[s0:Principale=$Start/tns:DN and upper-case(s0:StatoServizio)!='CESSATO'][1]/s0:StatoNumerazione)='ATTIVO' and upper-case($InvokeCCC/body/ns1:getDataResponse/ns1:GetDatiLineaUnicaXSoapOut/cst:StatoNumerazione)='ATTIVO')&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case($InvokeCRMB/parameters/s0:GetNumerazioniResponse/s0:GetNumerazioniResult/s0:Numerazioni/s0:Numerazione[s0:Principale=$Start/tns:DN and upper-case(s0:StatoServizio)!='CESSATO'][1]/s0:StatoNumerazione)='ATTIVO'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InvokeCRMB/parameters/s0:GetNumerazioniResponse/s0:GetNumerazioniResult/s0:Numerazioni/s0:Numerazione[s0:CollegamentoDiServizio='S' and upper-case(s0:StatoNumerazione)='ATTIVO' and upper-case(s0:StatoServizio)!='CESSATO'])&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_03'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($InvokeCRMB/parameters/s0:GetNumerazioniResponse/s0:GetNumerazioniResult/s0:Numerazioni/s0:Numerazione[s0:CollegamentoTemporaneo='N' and upper-case(s0:StatoNumerazione)='ATTIVO' and upper-case(s0:StatoServizio)!='CESSATO'])&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_04'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($InvokeCRMB/parameters/s0:GetNumerazioniResponse/s0:GetNumerazioniResult/s0:Numerazioni/s0:Numerazione[s0:PresenzaRPV='S' and upper-case(s0:StatoNumerazione)='ATTIVO' and upper-case(s0:StatoServizio)!='CESSATO'])&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_05'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;not(exists($InvokeCRMB/parameters/s0:GetNumerazioniResponse/s0:GetNumerazioniResult/s0:Numerazioni/s0:Numerazione[s0:LineaDirezionaleEntrant