                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://tempuri.org/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsertStagCRMR"/&gt;&lt;xsl:param name="InvokeCRMR"/&gt;&lt;xsl:template name="UpdateStagCRMR-input" match="/"&gt;&lt;tns2:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns:StagingRequest&gt;&lt;tns:GenericStaging&gt;&lt;tns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="'11'"/&gt;&lt;/tns:ID_STATO_ELAB_STAG&gt;&lt;tns:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse)"/&gt;&lt;/tns:CONTENUTO_RESPONSE&gt;&lt;xsl:if test="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Codice"&gt;&lt;tns:ESITO&gt;&lt;xsl:value-of select="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Codice"/&gt;&lt;/tns:ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Multinumero/tns1:Principale"&gt;&lt;tns:PRINCIPALE&gt;&lt;xsl:value-of select="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Multinumero/tns1:Principale"/&gt;&lt;/tns:PRINCIPALE&gt;&lt;/xsl:if&gt;&lt;tns:QT_AGGIUNTIVI&gt;&lt;xsl:value-of select="xsd:int(count($InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Multinumero/tns1:Aggiuntivi/tns1:anyType))"/&gt;&lt;/tns:QT_AGGIUNTIVI&gt;&lt;tns:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TIMSTP_RISPOSTA&gt;&lt;xsl:if test="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Descrizione"&gt;&lt;tns:DESCR_ESITO&gt;&lt;xsl:value-of select="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Descrizione"/&gt;&lt;/tns:DESCR_ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoNumerazione"&gt;&lt;tns:STATO_SERVIZIO_CRM&gt;&lt;xsl:value-of select="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoNumerazione"/&gt;&lt;/tns:STATO_SERVIZIO_CRM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:TipoConnettivita"&gt;&lt;tns:TIPO_LINEA&gt;&lt;xsl:value-of select="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:TipoConnettivita"/&gt;&lt;/tns:TIPO_LINEA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoServizio"&gt;&lt;tns:STATO_ULTIMO_ORDINE_CRM&gt;&lt;xsl:value-of select="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:StatoServizio"/&gt;&lt;/tns:STATO_ULTIMO_ORDINE_CRM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione"&gt;&lt;tns:LAVORAZIONE_ORDINE_CRM&gt;&lt;xsl:value-of select="$InvokeCRMR/parameters/tns1:GetDatiLineaUnicaXResponse/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione"/&gt;&lt;/tns:LAVORAZIONE_ORDINE_CRM&gt;&lt;/xsl:if&gt;&lt;tns:SISTEMA&gt;&lt;xsl:value-of select="'CRMR'"/&gt;&lt;/tns:SISTEMA&gt;&lt;/tns:GenericStaging&gt;&lt;tns:StagingType&gt;&lt;xsl:value-of select="'STAG_NOWTOCRM_VERETAIL_NO_FILE'"/&gt;&lt;/tns:StagingType&gt;&lt;tns:LoggerIn&gt;&lt;ns1:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns1:TipologiaProcesso&gt;&lt;ns1:Tipol