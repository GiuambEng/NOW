            <bpws:invoke inputVariable="UpdateStagCRMB-input"
                name="UpdateStagCRMB" operation="InsertUpdateStaging"
                outputVariable="UpdateStagCRMB"
                partnerLink="InsertUpdateStagingPortType1"
                portType="ns5:InsertUpdateStagingPortType" tibex:xpdlId="96e03969-72ad-4f5b-8ae5-f4e1e526cc7e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://tempuri.org/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns3="http://www.tim.com/NOW/xsd/ControlliAmmessiNP/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="InsertStagCRMB"/&gt;&lt;xsl:param name="InvokeCRMB"/&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:template name="UpdateStagCRMB-input" match="/"&gt;&lt;tns2:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns:StagingRequest&gt;&lt;tns:GenericStaging&gt;&lt;tns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="'11'"/&gt;&lt;/tns:ID_STATO_ELAB_STAG&gt;&lt;tns:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="tib:render-xml($InvokeCRMB/parameters/tns1:GetNumerazioniResponse)"/&gt;&lt;/tns:CONTENUTO_RESPONSE&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Esito/tns1:Codice"&gt;&lt;tns:ESITO&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Esito/tns1:Codice"/&gt;&lt;/tns:ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Principale"&gt;&lt;tns:PRINCIPALE&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Principale"/&gt;&lt;/tns:PRINCIPALE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:CollegamentoDiServizio"&gt;&lt;tns:TIPO_SRVZ&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:CollegamentoDiServizio"/&gt;&lt;/tns:TIPO_SRVZ&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Radicale"&gt;&lt;tns:RADICALE&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Radicale"/&gt;&lt;/tns:RADICALE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Caposerie"&gt;&lt;tns:CAPOSERIE&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Caposerie"/&gt;&lt;/tns:CAPOSERIE&gt;&lt;/xsl:if&gt;&lt;tns:QTA_LINEE&gt;&lt;xsl:value-of select="xsd:int(count($InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione))"/&gt;&lt;/tns:QTA_LINEE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="count($InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione)&gt;1"&gt;&lt;tns:QT_AGGIUNTIVI&gt;&lt;xsl:value-of select="xsd:int(count($InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale!=$Start/tns3:DN]))"/&gt;&lt;/tns:QT_AGGIUNTIVI&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns:QT_AGGIUNTIVI&gt;&lt;xsl:value-of select="xsd:int(count($InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[1]/tns1:ElencoAggiuntivi/tns1:string))"/&gt;&lt;/tns:QT_AGGIUNTIVI&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns:TIMSTP_RISPOSTA&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TIMSTP_RISPOSTA&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:CollegamentoTemporaneo"&gt;&lt;tns:FLAG_NUM_SERVZ&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:CollegamentoTemporaneo"/&gt;&lt;/tns:FLAG_NUM_SERVZ&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Esito/tns1:Descrizione"&gt;&lt;tns:DESCR_ESITO&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Esito/tns1:Descrizione"/&gt;&lt;/tns:DESCR_ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:StatoNumerazione"&gt;&lt;tns:STATO_SERVIZIO_CRM&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:StatoNumerazione"/&gt;&lt;/tns:STATO_SERVIZIO_CRM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:TipoConnettivita"&gt;&lt;tns:TIPO_LINEA&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:TipoConnettivita"/&gt;&lt;/tns:TIPO_LINEA&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:StatoServizio"&gt;&lt;tns:STATO_ULTIMO_ORDINE_CRM&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:StatoServizio"/&gt;&lt;/tns:STATO_ULTIMO_ORDINE_CRM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Lavorazione"&gt;&lt;tns:LAVORAZIONE_ORDINE_CRM&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Lavorazione"/&gt;&lt;/tns:LAVORAZIONE_ORDINE_CRM&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:PresenzaRPV"&gt;&lt;tns:FLAG_PRESENZA_RPV&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:PresenzaRPV"/&gt;&lt;/tns:FLAG_PRESENZA_RPV&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$Start/tns3:DN"&gt;&lt;tns:NUMERAZIONE_FATTURANTE&gt;&lt;xsl:value-of select="$Start/tns3:DN"/&gt;&lt;/tns:NUMERAZIONE_FATTURANTE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:DNPrimario"&gt;&lt;tns:DN_PRIMARIO&gt;&lt;xsl:value-of select="$InvokeCRMB/parameters/tns1:GetNumerazioniResponse/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:DNPrimario"/&gt;&lt;/tns:DN_PRIMARIO&gt;&lt;/xsl:if&gt;&lt;tns:SISTEMA&gt;&lt;xsl:value-of select="'CRMB'"/&gt;&lt;/tns:SISTEMA&gt;&lt;/tns:GenericStaging&gt;&lt;tns:StagingType&gt;&lt;xsl:v