                portType="ns5:InsertUpdateStagingPortType" tibex:xpdlId="e56f6d2e-b3b1-43fd-91a8-903782893744">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiNP/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="RequestCRMB"/&gt;&lt;xsl:template name="InsertStagCRMB-input" match="/"&gt;&lt;tns2:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns:StagingRequest&gt;&lt;tns:GenericStaging&gt;&lt;tns:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="'11'"/&gt;&lt;/tns:ID_STATO_ELAB_STAG&gt;&lt;tns:CONTENUTO_REQUEST&gt;&lt;xsl:value-of select="tib:render-xml($RequestCRMB)"/&gt;&lt;/tns:CONTENUTO_REQUEST&gt;&lt;tns:TIMSTP_RICH&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/tns:TIMSTP_RICH&gt;&lt;xsl:if test="$Start/tns1:IDRichiestaOLO"&gt;&lt;tns:ID_RICH&gt;&lt;xsl:value-of select="$Start/tns1:IDRichiestaOLO"/&gt;&lt;/tns:ID_RICH&gt;&lt;/xsl:if&gt;&lt;tns:ID_TRANSAZIONE&gt;&lt;xsl:value-of select="concat('CRMB-', string(tib:timestamp()))"/&gt;&lt;/tns:ID_TRANSAZIONE&gt;&lt;xsl:if test="$Start/tns1:DN"&gt;&lt;tns:DN&gt;&lt;xsl:value-of select="$Start/tns1:DN"/&gt;&lt;/tns:DN&gt;&lt;/xsl:if&gt;&lt;tns:SISTEMA&gt;&lt;xsl:value-of select="'CRMB'"/&gt;&lt;/tns:SISTEMA&gt;&lt;/tns:GenericStaging&gt;&lt;tns:StagingType&gt;&lt;xsl:value-of select="'STAG_NOWTOCRM_VERETAIL_NO_FILE'"/&gt;&lt;/tns:StagingType&gt;&lt;tns:LoggerIn&gt;&lt;ns1:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns1:TipologiaProcesso&gt;&lt;ns1:TipologiaOperazione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/ns1:TipologiaOperazione&gt;&lt;ns1:EsecuzioneNOFileProcessato&gt;&lt;ns1:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="125"/&gt;&lt;/ns1:ID_PROCSO_NO_FILE&gt;&lt;ns1:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns1:STATO_ESEC&gt;&lt;ns1:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TMSP_INIZIO_ELAB&gt;&lt;/ns1:EsecuzioneNOFileProcessato&gt;&lt;ns1:LogFileProcessato&gt;&lt;ns1:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/ns1:LOG_LEVEL&gt;&lt;ns1:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns1:LOG_MESSAGE&gt;&lt;ns1:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns1:TIMSTP_INSMTO&gt;&lt;/ns1:LogFileProcessato&gt;&lt;/tns:LoggerIn&gt;&lt;/tns:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns2:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;RequestCRMB&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStagCRMB-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingRequest>&#xa;            &lt;tns:GenericStaging>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;tns:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($RequestCRMB)&quot;/>&#xa;                &lt;/tns:CONTENUTO_REQUEST>&#xa;                &lt;tns:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_RICH>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns:ID_RICH>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:ID_RICH>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:ID_TRANSAZIONE>&#xa;                    &lt;xsl:value-of select=&quot;concat('CRMB-', string(tib:timestamp()))&quot;/>&#xa;                &lt;/tns:ID_TRANSAZIONE>&#xa;                &lt;xsl:if test=&quot;$Start/tns1:DN&quot;>&#xa;                    &lt;tns:DN>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns1:DN&quot;/>&#xa;                    &lt;/tns:DN>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:SISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;'CRMB'&quot;/>&#xa;                &lt;/tns:SISTEMA>&#xa;            &lt;/tns:GenericStaging>&#xa;            &lt;tns:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_NOWTOCRM_VERETAIL_NO_FILE'&quot;/>&#xa;            &lt;/tns:StagingType>&#xa;            &lt;tns:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;125&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns:LoggerIn>&#xa;        &lt;/tns:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
