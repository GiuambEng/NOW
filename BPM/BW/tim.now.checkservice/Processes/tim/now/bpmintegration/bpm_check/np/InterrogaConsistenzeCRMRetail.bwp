ineaUnicaXResult/tns1:StatoServizio&quot;/>&#xa;                    &lt;/tns:STATO_ULTIMO_ORDINE_CRM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMR.parameters/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione&quot;>&#xa;                    &lt;tns:LAVORAZIONE_ORDINE_CRM>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMR.parameters/tns1:GetDatiLineaUnicaXResult/tns1:Lavorazione&quot;/>&#xa;                    &lt;/tns:LAVORAZIONE_ORDINE_CRM>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:SISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;'CRMR'&quot;/>&#xa;                &lt;/tns:SISTEMA>&#xa;            &lt;/tns:GenericStaging>&#xa;            &lt;tns:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_NOWTOCRM_VERETAIL_NO_FILE'&quot;/>&#xa;            &lt;/tns:StagingType>&#xa;            &lt;tns:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStagCRMR.RESPONSE/tns:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStagCRMR.RESPONSE/tns:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagCRMR.RESPONSE/tns:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE)) &quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;97&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns:LoggerIn>&#xa;        &lt;/tns:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
