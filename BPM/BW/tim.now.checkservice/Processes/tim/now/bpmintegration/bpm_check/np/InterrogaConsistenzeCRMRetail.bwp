zioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:PresenzaRPV&quot;>&#xa;                    &lt;tns:FLAG_PRESENZA_RPV>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:PresenzaRPV&quot;/>&#xa;                    &lt;/tns:FLAG_PRESENZA_RPV>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$Start/tns3:DN&quot;>&#xa;                    &lt;tns:NUMERAZIONE_FATTURANTE>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns3:DN&quot;/>&#xa;                    &lt;/tns:NUMERAZIONE_FATTURANTE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:DNPrimario&quot;>&#xa;                    &lt;tns:DN_PRIMARIO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:DNPrimario&quot;/>&#xa;                    &lt;/tns:DN_PRIMARIO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:SISTEMA>&#xa;                    &lt;xsl:value-of select=&quot;'CRMB'&quot;/>&#xa;                &lt;/tns:SISTEMA>&#xa;            &lt;/tns:GenericStaging>&#xa;            &lt;tns:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_NOWTOCRM_VERETAIL_NO_FILE'&quot;/>&#xa;            &lt;/tns:StagingType>&#xa;            &lt;tns:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStagCRMB.RESPONSE/tns:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStagCRMB.RESPONSE/tns:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagCRMB.RESPONSE/tns:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE)) &quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;125&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns:LoggerIn>&#xa;        &lt;/tns:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
