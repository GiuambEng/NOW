erazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Caposerie&quot;>&#xa;                    &lt;tns:CAPOSERIE>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:Caposerie&quot;/>&#xa;                    &lt;/tns:CAPOSERIE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:QTA_LINEE>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int(count($InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione))&quot;/>&#xa;                &lt;/tns:QTA_LINEE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione)>1&quot;>&#xa;                        &lt;tns:QT_AGGIUNTIVI>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(count($InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale!=$Start/tns3:DN]))&quot;/>&#xa;                        &lt;/tns:QT_AGGIUNTIVI>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:QT_AGGIUNTIVI>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int(count($InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[1]/tns1:ElencoAggiuntivi/tns1:string))&quot;/>&#xa;                        &lt;/tns:QT_AGGIUNTIVI>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:CollegamentoTemporaneo&quot;>&#xa;                    &lt;tns:FLAG_NUM_SERVZ>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:CollegamentoTemporaneo&quot;/>&#xa;                    &lt;/tns:FLAG_NUM_SERVZ>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Esito/tns1:Descrizione&quot;>&#xa;                    &lt;tns:DESCR_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Esito/tns1:Descrizione&quot;/>&#xa;                    &lt;/tns:DESCR_ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:StatoNumerazione&quot;>&#xa;                    &lt;tns:STATO_SERVIZIO_CRM>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1:StatoServizio)!='CESSATO'][1]/tns1:StatoNumerazione&quot;/>&#xa;                    &lt;/tns:STATO_SERVIZIO_CRM>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMB.parameters/tns1:GetNumerazioniResult/tns1:Numerazioni/tns1:Numerazione[tns1:Principale=$Start/tns3:DN and upper-case(tns1:StatoNumerazione)='ATTIVO' and upper-case(tns1