                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://tempuri.org/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeCRMR.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStagCRMR.RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStagCRMR-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:StagingRequest>&#xa;            &lt;tns:GenericStaging>&#xa;                &lt;tns:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                &lt;/tns:ID_STATO_ELAB_STAG>&#xa;                &lt;tns:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($InvokeCRMR.parameters)&quot;/>&#xa;                &lt;/tns:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMR.parameters/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Codice&quot;>&#xa;                    &lt;tns:ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMR.parameters/tns1:GetDatiLineaUnicaXResult/tns1:Errore/tns1:Codice&quot;/>&#xa;                    &lt;/tns:ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$InvokeCRMR.parameters/tns1:GetDatiLineaUnicaXResult/tns1:Multinumero/tns1:Principale&quot;>&#xa;                    &lt;tns:PRINCIPALE>&#xa;                        &lt;xsl:value-of select=&quot;$InvokeCRMR.parameters/tns1:GetDatiLineaUnicaXResult/tns1:Multinumero/tns