                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiNP/&quot; xmlns:s0=&quot;http://tempuri.org/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/CustomerConsistencyInfoQueryCustomTypes/2019-05-29&quot; xmlns:ns1=&quot;http://telecomitalia.it/SOA/CustomerConsistencyQuery/2019-05-29&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeCRMR.parameters&quot;/>&lt;xsl:param name=&quot;InvokeCRMB.parameters&quot;/>&lt;xsl:param name=&quot;InvokeCCC.body&quot;/>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:param name=&quot;Distretto&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Response&quot; match=&quot;/&quot;>&lt;tns:InterrogaConsistenzeCRMRetail_Response>&lt;xsl:copy-of select=&quot;$Response/tns:Esito&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case($InvokeCRMR.parameters/s0:GetDatiLineaUnicaXResult/s0:StatoNumerazione)='ATTIVO'&quot;>&lt;tns:DatiRetail>&lt;xsl:if test=&quot;$InvokeCRMR.parameters/s0:GetDatiLineaUnicaXResult/s0:TipoConnettivita&quot;>&lt;tns:TipoNumero>&lt;xsl:value-of select=&quot;$InvokeCRMR.parameters/s0:GetDatiLineaUnicaXResult/s0:TipoConnettivita&quot;/>&lt;/tns:TipoNumero>&lt;/xsl:if>&lt;tns:TotaleAggiuntivi>&lt;xsl:value-of select=&quot;xsd:int(count($InvokeCRMR.parameters/s0:GetDatiLineaUnicaXResult/s0:Multinumero/s0:Aggiuntivi/s0:anyType))&quot;/>&lt;/tns:TotaleAggiuntivi>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$Distretto&quot;/>&lt;/tns:Distretto>&lt;xsl:if test=&quot;$Start/tns:DN&quot;>&lt;tns:NumeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns:DN&quot;/>&lt;/tns:NumeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns:DN&quot;>&lt;tns:NumeroTelefonicoPrincipale>&lt;xsl