                <bpws:sources>
                    <bpws:source linkName="InvokeCRMBToGenericLogger"/>
                    <bpws:source linkName="InvokeCRMBToGenericLogger1"
                        tibex:faultDetailsVar="InvokeCRMB" tibex:faultNameVar="FaultName">
