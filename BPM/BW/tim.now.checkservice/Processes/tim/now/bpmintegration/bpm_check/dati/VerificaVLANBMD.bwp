                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVLANBMDIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;VerVlanBMD&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(starts-with($VerificaVLANBMDIn.input/tns:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($VerificaVLANBMDIn.input/tns:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and $VerificaVLANBMDIn.input/tns:FlagNuovoModello = &amp;quot;Y&amp;quot; and string-length($VerificaVLANBMDIn.input/tns:ProfiloTecnicoLinea)=0&quot;>&#xa;                &lt;tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;                    &lt;tns:Ver_VLANBMDR>&#xa;                        &lt;tns:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns:IDDettaglioOrdine>&#xa;                    &lt;/tns:Ver_VLANBMDR>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ProfiloTecnicoLinea non presente in input per offerta VULA e per flag nuovo modello pari a Y&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;upper-case($VerificaVLANBMDIn.input/tns:Lavorazione)='VARIAZIONE' and string-length($VerificaVLANBMDIn.input/tns:IDRichiestaOLO)=0&quot;>&#xa;                &lt;tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;                    &lt;tns:Ver_VLANBMDR>&#xa;                        &lt;tns:IDDettagli