                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke
                inputVariable="DatiVerificaControlliInvoke-input"
                name="DatiVerificaControlliInvoke"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlliInvoke"
                partnerLink="DatiVerificaControlli"
                portType="ns12:DatiVerificaControlliPortType" tibex:xpdlId="2ac69981-43e0-4b62-93f3-19d0915a8e4c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" version="2.0"&gt;
    &lt;xsl:param name="VerVlanBMD"/&gt;
    &lt;xsl:param name="VerificaVLANBMDIn"/&gt;
    &lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;
        &lt;tns3:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:DatiVerificaControlliInput&gt;
                    &lt;tns1:Operatore&gt;
                        &lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;
                    &lt;/tns1:Operatore&gt;
                    &lt;tns1:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$VerificaVLANBMDIn/input/tns:VerificaVLANBMDEsitiMultipliRequest/tns:IDRichiestaOLO"/&gt;
                    &lt;/tns1:IDRichiestaOLO&gt;
                    &lt;tns1:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns1:Azione&gt;
                    &lt;xsl:for-each select="$VerVlanBMD/tns:Ver_VLANBMDR"&gt;
                        &lt;tns1:UservlanVC&gt;
                            &lt;xsl:if test="string-length(string(tns:ID_PROFILO_BMD)) &gt; 0"&gt;
                                &lt;xsl:if test="tns:ID_PROFILO_BMD"&gt;
                                    &lt;tns1:IDProfiloBMD&gt;
                                        &lt;xsl:value-of select="tns:ID_PROFILO_BMD"/&gt;
                                    &lt;/tns1:IDProfiloBMD&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns1:UservlanVC&gt;
                    &lt;/xsl:for-each&gt;
                &lt;/tns1:DatiVerificaControlliInput&gt;
            &lt;/parameters&gt;
        &lt;/tns3:DatiVerificaControlliRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVLANBMDIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;VerVlanBMD&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlliInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaVLANBMDIn.input/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;xsl:for-each select=&quot;$VerVlanBMD/tns:Ver_VLANBMDR&quot;>&#xa;                &lt;tns1:UservlanVC>&#xa;                    &lt;xsl:if test=&quot;string-length(string(tns:ID_PROFILO_BMD)) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns:ID_PROFILO_BMD&quot;>&#xa;                            &lt;tns1:IDProfiloBMD>&#xa;                                &lt;xsl:value-of select=&quot;tns:ID_PROFILO_BMD&quot;/>&#xa;                            &lt;/tns1:IDProfiloBMD>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:UservlanVC>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogOutputVerificaVLANBMDToInvoke_ESITOOK"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DatiVerificaControlliInvokeToCallProcess"/>
                    <bpws:source
                        linkName="DatiVerificaControlliInvokeToAssign1"
                        tibex:faultDetailsVar="DatiVerificaControlliInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="VerVlanBMD"
                    name="DatiVerificaControlliResponseAssign"
                    outputVariable="VerVlanBMD"
                    tibex:xpdlId="1146abb1-393f-4ffc-8872-7481e647adbb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DatiVerificaControlliInvokeToAssign1"/>
