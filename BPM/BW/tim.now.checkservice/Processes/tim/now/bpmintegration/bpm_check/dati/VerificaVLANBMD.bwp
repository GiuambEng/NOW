                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
