                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignVerificaVlanToCallProcess"/>
                        <bpws:target linkName="AssignVerVLANToLogOutputVerificaVLANBMD"/>
                        <bpws:target linkName="AssignToLogOutputVerificaVLANBMD"/>
                        <bpws:target linkName="AssignKOToLogOutputVerificaVLANBMD"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOutputVerificaVLANBMDToRecuperaCausaleEsitoMultiplo">
                            <tibex:DesignExpression>
                                <tibex:expression
