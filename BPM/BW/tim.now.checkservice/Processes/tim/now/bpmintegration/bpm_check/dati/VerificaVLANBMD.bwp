                tibex:xpdlId="4cc88f0a-685e-4f9e-92b3-507ec3f7fc24" variable="VerificaVLANBMDOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns2="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" version="2.0"&gt;
    &lt;xsl:param name="VerVlanBMD"/&gt;
    &lt;xsl:param name="FlagEnrichment"/&gt;
    &lt;xsl:template name="VerificaVLANBMDOut-input" match="/"&gt;
        &lt;tns3:VerificaVLANBMDEsitiMultipliResponse&gt;
            &lt;output&gt;
                &lt;tns:VerificaVLANBMDEsitiMultipliResponse&gt;
                    &lt;xsl:copy-of select="$VerVlanBMD/tns:Ver_VLANBMDR"/&gt;
                    &lt;tns:Codice&gt;
                        &lt;xsl:value-of select="$VerVlanBMD/tns:Codice"/&gt;
                    &lt;/tns:Codice&gt;
                    &lt;tns:Descrizione&gt;
                        &lt;xsl:value-of select="$VerVlanBMD/tns:Descrizione"/&gt;
                    &lt;/tns:Descrizione&gt;
                    &lt;xsl:if test="$VerVlanBMD/tns:IdAnagraficaCausale"&gt;
                        &lt;tns:IdAnagraficaCausale&gt;
                            &lt;xsl:value-of select="$VerVlanBMD/tns:IdAnagraficaCausale"/&gt;
                        &lt;/tns:IdAnagraficaCausale&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$FlagEnrichment=true()"&gt;
                            &lt;xsl:for-each select="$VerVlanBMD/tns:Ver_VLANBMDR"&gt;
                                &lt;tns:UservlanVC&gt;
                                    &lt;xsl:if test="string-length(string(tns:ID_PROFILO_BMD)) &gt; 0"&gt;
                                        &lt;xsl:if test="tns:ID_PROFILO_BMD"&gt;
                                            &lt;tns2:IDProfiloBMD&gt;
                                                &lt;xsl:value-of select="tns:ID_PROFILO_BMD"/&gt;
                                            &lt;/tns2:IDProfiloBMD&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:UservlanVC&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns:VerificaVLANBMDEsitiMultipliResponse&gt;
            &lt;/output&gt;
        &lt;/tns3:VerificaVLANBMDEsitiMultipliResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerVlanBMD&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaVLANBMDOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;            &lt;xsl:copy-of select=&quot;$VerVlanBMD/tns:Ver_VLANBMDR&quot;/>&#xa;            &lt;tns:Codice>&#xa;                &lt;xsl:value-of select=&quot;$VerVlanBMD/tns:Codice&quot;/>&#xa;            &lt;/tns:Codice>&#xa;            &lt;tns:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;$VerVlanBMD/tns:Descrizione&quot;/>&#xa;            &lt;/tns:Descrizione>&#xa;            &lt;xsl:if test=&quot;$VerVlanBMD/tns:IdAnagraficaCausale&quot;>&#xa;                &lt;tns:IdAnagraficaCausale>&#xa;                    &lt;xsl:value-of select=&quot;$VerVlanBMD/tns:IdAnagraficaCausale&quot;/>&#xa;                &lt;/tns:IdAnagraficaCausale>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$VerVlanBMD/tns:Ver_VLANBMDR&quot;>&#xa;                        &lt;tns:UservlanVC>&#xa;                            &lt;xsl:if test=&quot;string-length(string(tns:ID_PROFILO_BMD)) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns:ID_PROFILO_BMD&quot;>&#xa;                                    &lt;tns2:IDProfiloBMD>&#xa;                                        &lt;xsl:value-of select=&quot;tns:ID_PROFILO_BMD&quot;/>&#xa;                                    &lt;/tns2:IDProfiloBMD>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:UservlanVC>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
