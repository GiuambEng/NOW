/tns:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($VerificaVLANBMDIn.input/tns:Ver_VLANBMD[string-length(tns:Banda_Picco_UP) = 0]) and $VerificaVLANBMDIn.input/tns:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;                    &lt;tns:Ver_VLANBMDR>&#xa;                        &lt;tns:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns:IDDettaglioOrdine>&#xa;                    &lt;/tns:Ver_VLANBMDR>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_UP non e' compilato per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;(starts-with($VerificaVLANBMDIn.input/tns:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($VerificaVLANBMDIn.input/tns:Offerta, &amp;quot;SEMIVULA&amp;quot;)) and exists($VerificaVLANBMDIn.input/tns:Ver_VLANBMD[string-length(tns:Banda_Picco_UP) = 0]) and exists($VerificaVLANBMDIn.input/tns:Ver_VLANBMD[string-length(tns:Banda_Picco_DOWN) = 0]) and $VerificaVLANBMDIn.input/tns:FlagNuovoModello = &amp;quot;N&amp;quot;&quot;>&#xa;                &lt;tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;                    &lt;tns:Ver_VLANBMDR>&#xa;                        &lt;tns:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns:IDDettaglioOrdine>&#xa;                    &lt;/tns:Ver_VLANBMDR>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Banda_Picco_UP e Banda_Picco_DOWN non sono compilati per l'offerta VULA&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;                    &lt;xsl:for-each select=&quot;$VerificaVLANBMDIn.input/tns:Ver_VLANBMD&quot;>&#xa;                        &lt;tns:Ver_VLANBMDR>&#xa;                            &lt;tns:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns:IDDettaglioOrdine>&#xa;                            &lt;xsl:if test=&quot;tns:UserVlan_ID&quot;>&#xa;                                &lt;tns:uservlanID>&#xa;                                    &lt;xsl:value-of select=&quot;tns:UserVlan_ID&quot;/>&#xa;                                &lt;/tns:uservlanID>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:Ver_VLANBMDR>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVLANBMDEsitiMultipliResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
