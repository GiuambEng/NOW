                        </bpws:source>
                        <bpws:source linkName="LOG_JDBCCallProcedureToOutputAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCCallProcedure_QUERY_COMP_RICHOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_JDBCCallProcedure-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCompatibilitaLavorazione&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCompatibilitaLavorazione&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet)&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Procedure Response: &amp;quot;, tib:render-xml($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet, true(), true()))&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;La Procedura QUERY_COMP_RICHOLO non ha prodotto record.&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaCompatibilitaLavorazione'&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaCompatibilitaLavorazione_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaCompatibilitaLavorazione_', $VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO )&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerificaCompatibilitaLavorazioneResponse"
                    name="OutputAssign1"
                    outputVariable="VerificaCompatibilitaLavorazioneResponse"
                    tibex:xpdlId="e509a556-6b11-41cc-8970-b4b9b2e64c69" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_JDBCCallProcedureToOutputAssign"/>
                        <bpws:target linkName="JDBC_ScenarioToOutputAssign1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToVerificaCompatibilitaLavorazioneOut_FALSE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="VerificaCompatibilitaLavorazioneResponseAssignToInvoke_TRUE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaCompatibilitaLavorazioneResponse/ns5:Esito/ns5:Codice = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaCompatibilitaLavorazioneResponse/ns5:Esito/ns5:Codice = true()]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCCallProcedure_QUERY_COMP_RICHOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_Scenario&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCompatibilitaLavorazioneResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/ID_SCENARIO) and (exists($JDBC_Scenario/Record/SCENARIO_BPM) and string-length($JDBC_Scenario/Record[1]/SCENARIO_BPM)>0)&quot;>&#xa;                &lt;tns:Verifica_Compatibilita_Lavorazione_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                    &lt;tns:Scenario>&#xa;                        &lt;xsl:value-of select=&quot;upper-case($JDBC_Scenario/Record[1]/SCENARIO_BPM)&quot;/>&#xa;                    &lt;/tns:Scenario>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;not((string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE)&quot;>&#xa;                                &lt;tns:CodiceTrasformazione>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE&quot;/>&#xa;                                &lt;/tns:CodiceTrasformazione>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Verifica_Compatibilita_Lavorazione_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Verifica_Compatibilita_Lavorazione_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Verifica_Compatibilita_Lavorazione_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VerificaCompatibilitaLavorazioneResponse" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:invoke
                inputVariable="DatiVerificaControlliInvoke-input"
                name="DatiVerificaControlliInvoke"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlliInvoke"
                partnerLink="DatiVerificaControlli"
                portType="ns6:DatiVerificaControlliPortType" tibex:xpdlId="2e2b2a3b-6a67-4d36-b6d6-749bfb17c14a">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns3="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" version="2.0"&gt;
    &lt;xsl:param name="VerificaCompatibilitaLavorazioneIn"/&gt;
    &lt;xsl:param name="JDBCCallProcedure_QUERY_COMP_RICHOLO"/&gt;
    &lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;
        &lt;tns1:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns3:DatiVerificaControlliInput&gt;
                    &lt;tns3:Operatore&gt;
                        &lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;
                    &lt;/tns3:Operatore&gt;
                    &lt;tns3:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:IDRichiestaOLO"/&gt;
                    &lt;/tns3:IDRichiestaOLO&gt;
                    &lt;tns3:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns3:Azione&gt;
                    &lt;tns3:ConsistenzaDati&gt;
                        &lt;xsl:if test="string-length(string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE)) &gt; 0 and (string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE) = &amp;quot;TCOND_NAKED&amp;quot; or string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE) = &amp;quot;TNAKED_COND&amp;quot; or string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE) = &amp;quot;TSHA_ULLD&amp;quot; or string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE) = &amp;quot;CBTSATMSIMM&amp;quot;)"&gt;
                            &lt;xsl:if test="not((string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE)"&gt;
                                &lt;tns3:CodiceTrasformazione&gt;
                                    &lt;xsl:value-of select="$JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE"/&gt;
                                &lt;/tns3:CodiceTrasformazione&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns3:ConsistenzaDati&gt;
                    &lt;tns3:ConsistenzaFonia&gt;
                        &lt;xsl:if test="string-length($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE) &gt; 0 and ($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE = &amp;quot;DECREMENTO_NP&amp;quot; or $JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE = &amp;quot;DECREMENTO_ULL&amp;quot; or $JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE = &amp;quot;DECREMENTO_SLU&amp;quot;)"&gt;
                            &lt;xsl:if test="not((string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE)"&gt;
                                &lt;tns3:CodiceTrasformazione&gt;
                                    &lt;xsl:value-of select="$JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/COD_TRASFORMAZIONE"/&gt;
                                &lt;/tns3:CodiceTrasformazione&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns3:ConsistenzaFonia&gt;
                    &lt;tns3:LavorazioneRichiesta&gt;
                        &lt;tns3:IdentificativoScenario&gt;
                            &lt;xsl:value-of select="string($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/ID_SCENARIO)"/&gt;
                        &lt;/tns3:IdentificativoScenario&gt;
                    &lt;/tns3:LavorazioneRichiesta&gt;
                &lt;/tns3:DatiVerificaControlliInput&gt;
            &lt;/parameters&gt;
        &lt;/tns1:DatiVerificaControlliRequest&gt;
