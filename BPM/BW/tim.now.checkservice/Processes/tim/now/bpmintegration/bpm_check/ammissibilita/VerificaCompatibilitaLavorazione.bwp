                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_TIPO_SRVZ&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperJDBCProc-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:COLONNE>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ID_SOTOFMG_OFRT_MCRO_RICH&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;(string-length($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati) > 0)  or ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and exists($JDBC_TIPO_SRVZ/Record) and $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;DATI&amp;quot; and string-length($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta) > 0) or ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='RIENTRIDEL82')&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ID_SOTFMG_OFRT_MCRO_ASST_DAT&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='RIENTRIDEL82'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and exists($JDBC_TIPO_SRVZ/Record) and $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;DATI&amp;quot; and string-length($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;(string-length($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetFonia) > 0)  or ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and exists($JDBC_TIPO_SRVZ/Record) and ($JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;FONIA&amp;quot; or $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;FONIA/DATI&amp;quot;) and string-length($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta) > 0)  and (( exists($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta) and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta!='NP') or ( (exists($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetFonia)) and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta='NP'))&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ID_SOTFMG_OFRT_MCRO_ASST_FON&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and exists($JDBC_TIPO_SRVZ/Record) and ($JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;FONIA&amp;quot; or $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;FONIA/DATI&amp;quot;) and string-length($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta) > 0 and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta!='NP' and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta!='CPS'&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetFonia&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetFonia&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDTPLG_LAVRZ&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaRichiesta) > 0 or ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='VARIAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione=('CAMBIOTIPOLOGIAWLR8','CAMBIOTIPOLOGIAWLR9','CAMBIOTIPOLOGIAWLR10'))&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDTPLG_LINEA_RICH&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='ATTIVAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='USCITADATI' and $VerificaCompatibilitaLavorazioneIn.input/tns:StrutturaLinea='GNR' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaRichiesta='ISDN' and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta=('ULLLINEAATTIVA','ULLLINEAATTIVANP','ULLDATILINEAATTIVA','ULLDATILINEAATTIVANP','SLULINEAATTIVA','SLULINEAATTIVANP')&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN GNR'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='ATTIVAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='USCITADATI' and $VerificaCompatibilitaLavorazioneIn.input/tns:StrutturaLinea='GNR'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;concat($VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaRichiesta,' GNR')&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='VARIAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='CAMBIOTIPOLOGIAWLR8'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN BRA MONO'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='VARIAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione=('CAMBIOTIPOLOGIAWLR9','CAMBIOTIPOLOGIAWLR10')&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'POTS SIMPLEX'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='ATTIVAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='CAMBIOTECNOLOGIA' and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta =  (&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;,&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;,'FULLGPONPLUS','FULLGPONPLUSNGA')) or ( $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta =&amp;quot;VULAFTTH&amp;quot; and not($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='VARIAZIONE') and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard='Y') or ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='MIGRAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='MIGRAZIONEDEL82' and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard='N')&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'FIBRA'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta =  (&amp;quot;FIBERSTREAM&amp;quot;) or $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta =  (&amp;quot;FWAITALIA1GIGASARDEGNA&amp;quot;)&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaRichiesta&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaRichiesta&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaAssetDati) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDTPLG_LINEA_ASSET_DATI&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard = &amp;quot;Y&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard = &amp;quot;Y&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione = &amp;quot;CAMBIOTECNOLOGIA&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati = &amp;quot;VULAFTTH&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta = &amp;quot;VULAFTTH&amp;quot;&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;FIBRA&amp;quot;&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard = &amp;quot;N&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard = &amp;quot;N&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;ATTIVAZIONE&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione = &amp;quot;CAMBIOTECNOLOGIA&amp;quot; and ($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati = (&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;,&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;,'FULLGPONPLUS','FULLGPONPLUSNGA')) and ($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta =  (&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;,&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;))&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;FIBRA&amp;quot;&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard = &amp;quot;N&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard = &amp;quot;N&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and ($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati = (&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;,&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;,'FULLGPONPLUS','FULLGPONPLUSNGA')) and ($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta =  (&amp;quot;SEMIVULAFTTH&amp;quot;,&amp;quot;SEMIBITSTREAMNGAFTTH&amp;quot;,&amp;quot;SEMIEASYIPNGAFTTH&amp;quot;,&amp;quot;VULAFTTH&amp;quot;,&amp;quot;BITSTREAMNGAFTTH&amp;quot;,&amp;quot;EASYIPNGAFTTH&amp;quot;))&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;FIBRA&amp;quot;&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione = &amp;quot;NORMALE&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati = (&amp;quot;FIBERSTREAM&amp;quot;) and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta =  (&amp;quot;FIBERSTREAM&amp;quot;)&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard='Y' and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard='N' and $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='MIGRAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='ATTIVAZIONE274' and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati='VULAFTTH'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'FIBRA'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard='Y' and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard='N' and $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='ATTIVAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='USCITADATI' and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati='VULAFTTCAB'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'LineaNonFonia'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard='Y' and $VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard='N' and $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='ATTIVAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='USCITADATI' and not($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaAssetDati='VULAFTTCAB')&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'FIBRA'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='MIGRAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='MIGRAZIONEDEL82'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'FIBRA'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaAssetDati&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaAssetDati&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaAssetFonia) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDTPLG_LINEA_ASSET_FONIA&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='MIGRAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='MIGRAZIONEOLO' and $VerificaCompatibilitaLavorazioneIn.input/tns:BandaServizio='ISDN PRA')&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN PRA'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='VARIAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione=('CAMBIOTIPOLOGIAWLR8','CAMBIOTIPOLOGIAWLR11','CAMBIOTIPOLOGIAWLR10')&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;concat(upper-case($VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaAssetFonia),' ',upper-case($VerificaCompatibilitaLavorazioneIn.input/tns:StrutturaLineaFonia))&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaAssetFonia&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaLineaAssetFonia&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDTPLG_SOTTO_LAVRZ&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:StrutturaRichiesta) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;STRUTTURA_RICH&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:StrutturaRichiesta&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:StrutturaRichiesta&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:FlagNPAsset) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FLAG_NP_ASSET&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagNPAsset&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagNPAsset&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:FlagRientro) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FLAG_RIENTRO&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagRientro&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagRientro&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:FlagNPRichiesta) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FLAG_NP_RICH&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagNPRichiesta&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagNPRichiesta&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:FlagPortabilita) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FLAG_PORTABILITA&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagPortabilita&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagPortabilita&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:FlagAggiuntivo) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FLAG_AGGIUNTIVO&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagAggiuntivo&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagAggiuntivo&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoRichiestaOLO) >0 and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta !=&amp;quot;ULLDATILINEANONATTIVA&amp;quot;&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DESTINAZIONE_USO_RICH_OLO&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:CodificaOloAgcomDonating='TLC' and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta='ULLLINEANONATTIVA' and $VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoRichiestaOLO='3'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN PRA'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoRichiestaOLO&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoRichiestaOLO&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoAssetDati) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DEST_USO_ASSET_DATI&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoAssetDati&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoAssetDati&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoAssetFonia) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DEST_USO_ASSET_FONIA&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione='ATTIVAZIONE' and $VerificaCompatibilitaLavorazioneIn.input/tns:TipologiaSottoLavorazione='USCITADATI' and $VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoAssetFonia!='3' and $VerificaCompatibilitaLavorazioneIn.input/tns:BandaServizio='ISDN PRA'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;'ISDN PRA'&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoAssetFonia&quot;>&#xa;                                &lt;tns:VALORE>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:DestinazioneUsoAssetFonia&quot;/>&#xa;                                &lt;/tns:VALORE>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ASSET_DATI_STANDARD&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetDatiStandard&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:AssetFoniaStandard) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ASSET_FONIA_STANDARD&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetFoniaStandard&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AssetFoniaStandard&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard) > 0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;RICH_OLO_STANDARD&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:RichiestaOLOStandard&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaDati)>0 and string-length($VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaFonia) >0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDTPLG_ACCS_DA_CESS&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaDati =&amp;quot;D&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaFonia =&amp;quot;D&amp;quot;  and ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione ='ATTIVAZIONE' or $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione ='MIGRAZIONE') and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta!='NP'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaDati =&amp;quot;D&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaFonia !=&amp;quot;D&amp;quot; and ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione ='ATTIVAZIONE' or $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione ='MIGRAZIONE') and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta!='NP'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaDati !=&amp;quot;D&amp;quot; and $VerificaCompatibilitaLavorazioneIn.input/tns:AzioneConsistenzaFonia =&amp;quot;D&amp;quot; and ($VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione ='ATTIVAZIONE' or $VerificaCompatibilitaLavorazioneIn.input/tns:Lavorazione ='MIGRAZIONE') and $VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta!='NP'&quot;>&#xa;                            &lt;tns:VALORE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&#xa;                            &lt;/tns:VALORE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn.input/tns:FlagCPS)>0&quot;>&#xa;                &lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;                    &lt;tns:CHIAVE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;FLAG_CPS&amp;quot;&quot;/>&#xa;                    &lt;/tns:CHIAVE>&#xa;                    &lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagCPS&quot;>&#xa;                        &lt;tns:VALORE>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:FlagCPS&quot;/>&#xa;                        &lt;/tns:VALORE>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:COLONNE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:ControllidiAmmissibilita="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="ControllidiAmmissibilita:COLONNE" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
