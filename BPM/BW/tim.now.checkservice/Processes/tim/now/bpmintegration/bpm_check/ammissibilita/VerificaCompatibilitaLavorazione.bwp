                    <bpws:sources>
                        <bpws:source linkName="CallProcessToVerificaCompatibilitaLavorazioneOut_Name">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="exists($JDBCCallProcedure_QUERY_COMP_RICHOLO/outputSet/ID_SCENARIO)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
