            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8ae3d559-fbd6-4fbb-b975-2d99391fe0bd+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_TIPO_SRVZ-input"
                    name="JDBC_TIPO_SRVZ"
                    outputVariable="JDBC_TIPO_SRVZ"
                    tibex:xpdlId="8ae3d559-fbd6-4fbb-b975-2d99391fe0bd" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaCompatibilitaLavorazioneInToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBC_TIPO_SRVZToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8ae3d559-fbd6-4fbb-b975-2d99391fe0bd+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:OffertaRichiesta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT TIPO_SRVZ&#xa;  FROM OFFERTA&#xa;  WHERE ID_OFFERTA =&#xa;  (SELECT ID_OFFERTA&#xa;  &#x9;FROM TRASCODFC_OFFERTA&#xa;  &#x9;WHERE NOME_OFFERTA_ESTERNA = ? AND PROVENIENZA = 'BPM')" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="TIPO_SRVZ"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_TIPO_SRVZ&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_JDBC_TIPO_SRVZ-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCompatibilitaLavorazione&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCompatibilitaLavorazione&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_TIPO_SRVZ/Record)&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;JDBC_TIPO_SRVZ Output: &amp;quot;, $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ)&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;JDBC_TIPO_SRVZ non ha prodotto record.&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaCompatibilitaLavorazione'&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaCompatibilitaLavorazione_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaCompatibilitaLavorazione_', $VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:IDRichiestaOLO )&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_JDBC_TIPO_SRVZ-input"
                    name="LOG_JDBC_TIPO_SRVZ"
                    tibex:xpdlId="38c66f5c-ce94-4f41-892c-f2e16f506e84"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBC_TIPO_SRVZToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_JDBC_TIPO_SRVZToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_TIPO_SRVZ&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_JDBC_TIPO_SRVZ-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCompatibilitaLavorazione&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCompatibilitaLavorazione&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_TIPO_SRVZ/Record)&quot;>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;JDBC_TIPO_SRVZ Output: &amp;quot;, $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ)&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;JDBC_TIPO_SRVZ non ha prodotto record.&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;            &lt;tns1:ActiveLoggerServices>&#xa;                &lt;tns1:Envelope>&#xa;                    &lt;tns1:Identifier>&#xa;                        &lt;tns1:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns1:ServiceName>&#xa;                        &lt;tns1:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaCompatibilitaLavorazione'&quot;/>&#xa;                        &lt;/tns1:Operation>&#xa;                        &lt;tns1:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns1:Source>&#xa;                        &lt;tns1:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns1:BusinessID>&#xa;                        &lt;tns1:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaCompatibilitaLavorazione_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns1:EventType>&#xa;                        &lt;tns1:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaCompatibilitaLavorazione_', $VerificaCompatibilitaLavorazioneIn.input/tns:IDRichiestaOLO )&quot;/>&#xa;                        &lt;/tns1:trackID>&#xa;                    &lt;/tns1:Identifier>&#xa;                    &lt;tns1:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns1:track_position>&#xa;                    &lt;tns1:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns1:Timestamp>&#xa;                &lt;/tns1:Envelope>&#xa;            &lt;/tns1:ActiveLoggerServices>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaCompatibilitaLavorazioneIn&quot;/>&lt;xsl:param name=&quot;JDBC_TIPO_SRVZ&quot;/>&lt;xsl:template name=&quot;MapperJDBCProc-input&quot; match=&quot;/&quot;>&lt;tns:COLONNE>&lt;xsl:if test=&quot;string-length($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta) > 0&quot;>&lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&lt;tns:CHIAVE>&lt;xsl:value-of select=&quot;&amp;quot;ID_SOTOFMG_OFRT_MCRO_RICH&amp;quot;&quot;/>&lt;/tns:CHIAVE>&lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta&quot;/>&lt;/tns:VALORE>&lt;/xsl:if>&lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&lt;/xsl:if>&lt;xsl:if test=&quot;(string-length($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaAssetDati) > 0)  or ($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and exists($JDBC_TIPO_SRVZ/Record) and $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;DATI&amp;quot; and string-length($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta) > 0) or ($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and $VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:TipologiaSottoLavorazione='RIENTRIDEL82')&quot;>&lt;tns:APPUSER.TCOMP_RICHOLO_QUERY>&lt;tns:CHIAVE>&lt;xsl:value-of select=&quot;&amp;quot;ID_SOTFMG_OFRT_MCRO_ASST_DAT&amp;quot;&quot;/>&lt;/tns:CHIAVE>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:Lavorazione = &amp;quot;MIGRAZIONE&amp;quot; and $VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:TipologiaSottoLavorazione='RIENTRIDEL82'&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;'FIBERSTREAM'&quot;/>&lt;/tns:VALORE>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:Lavorazione = &amp;quot;CESSAZIONE&amp;quot; and exists($JDBC_TIPO_SRVZ/Record) and $JDBC_TIPO_SRVZ/Record[1]/TIPO_SRVZ = &amp;quot;DATI&amp;quot; and string-length($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta) > 0&quot;>&lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaRichiesta&quot;/>&lt;/tns:VALORE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaAssetDati&quot;>&lt;tns:VALORE>&lt;xsl:value-of select=&quot;$VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaAssetDati&quot;/>&lt;/tns:VALORE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:APPUSER.TCOMP_RICHOLO_QUERY>&lt;/xsl:if>&lt;xsl:if test=&quot;(string-length($VerificaCompatibilitaLavorazioneIn/input/tns:Verifica_Compatibilita_Lavorazione_Request/tns:OffertaAssetFonia) > 0)  or ($VerificaCompatibilitaLavorazioneIn/input/tns:Ver