                                tibex:group="groupEnd" tibex:xpdlId="e2ca8f14-39fb-4c12-9e87-709cddecff25">
                                <bpws:targets>
                                    <bpws:target linkName="DatiVerificaControlliToGroupEnd"/>
                                    <bpws:target linkName="EmptyToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCQueryVerifica-input"
                                    name="JDBCQueryVerifica"
                                    outputVariable="JDBCQueryVerifica"
                                    tibex:xpdlId="98619427-4613-4b55-a5ab-3c19e6d01515" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+98619427-4613-4b55-a5ab-3c19e6d01515+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;nomeServizio>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Servizio[number($index)]/tns:NomeServizio)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:Servizio[number($index)]/tns:NomeServizio&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/nomeServizio>&lt;DRO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:DRO)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:DRO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DRO>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
