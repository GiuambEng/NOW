                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT id_anag_serv_agg, ambito&#xa;FROM anagrafica_serv_agguntivi_of&#xa;WHERE nome_servizio_agg=? AND TO_DATE(?, 'YYYY-MM-DD') BETWEEN datainvalidita AND datafivalidita" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="nomeServizio"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DRO"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="ID_ANAG_SERV_AGG"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="AMBITO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
