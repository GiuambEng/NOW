            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="9486cc30-e89e-41b7-ae06-b9ae2851d3a6">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
