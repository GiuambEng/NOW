                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esito&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCQueryVerifica&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaServizioAggiuntivoOF_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryVerifica/Record[1]/ID_ANAG_SERV_AGG)=0 or count($JDBCQueryVerifica/Record)=0 or ( starts-with($Start/tns:Servizio[number($index)]/tns:NomeServizio,'TLC') and $JDBCQueryVerifica/Record/AMBITO='DTU' and $Start/tns:Servizio[number($index)]/tns:Vincolo!='1') or ($Start/tns:Servizio[number($index)]/tns:NomeServizio='DA DEFINIRE')&quot;>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($JDBCQueryVerifica/Record[1]/ID_ANAG_SERV_AGG)=0 or count($JDBCQueryVerifica/Record)=0 or ( starts-with($Start/tns:Servizio[number($index)]/tns:NomeServizio,'TLC') and $JDBCQueryVerifica/Record/AMBITO='DTU' and $Start/tns:Servizio[number($index)]/tns:Vincolo!='1') or ($Start/tns:Servizio[number($index)]/tns:NomeServizio='DA DEFINIRE')&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:copy-of select=&quot;$Esito/tns:Servizio&quot;/>&lt;tns:Servizio>&lt;tns:NomeServizio>&lt;xsl:value-of select=&quot;$Start/tns:Servizio[number($index)]/tns:NomeServizio&quot;/>&lt;/tns:NomeServizio>&lt;xsl:if test=&quot;$Start/tns:Servizio[number($index)]/tns:Vincolo&quot;>&lt;tns:Vincolo>&lt;xsl:value-of select=&quot;$Start/tns:Servizio[number($index)]/tns:Vincolo&quot;/>&lt;/tns:Vincolo>&lt;/xsl:if>&lt;tns:Ambito>&lt;xsl:value-of select=&quot;$JDBCQueryVerifica/Record[1]/AMBITO&quot;/>&lt;/tns:Ambito>&lt;/tns:Servizio>&lt;/tns:VerificaServizioAggiuntivoOF_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
