                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($VerificaEsistenzaVLANRIn.input/ns6:Lavorazione) > 0 and $VerificaEsistenzaVLANRIn.input/ns6:Lavorazione = 'VARIAZIONE' and count($VerificaEsistenzaVLANRIn.input/ns6:VC_CompatibilitaProfiloTecnicoLineaProfiloVC/ns6:VCI) > 0 and count($VerificaEsistenzaVLANRIn.input/ns6:VC_CompatibilitaProfiloTecnicoLineaProfiloVC/ns6:VPI) > 0 and string-length(string($VerificaEsistenzaVLANRIn.input/ns6:IdAsset)) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
