            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+32b6ed07-99dd-42f9-a43d-55b589dac6c3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaEsistenzaVLANRIn&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT DISTINCT att2.DTTGLSST_TTRBTIDTTGLISST_BDSID FROM  BDS_1_CASEDATA_ATTRIBTDTTGLSST att2 WHERE att2.IDASSET = '&amp;quot;, string($VerificaEsistenzaVLANRIn/input/tns1:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest/tns1:IdAsset) ,&amp;quot;' and ( ( att2.NOMEATTRIBUTO = 'VPI' and att2.VALOREATTRIBUTO IN ( '&amp;quot;, tib:concat-sequence-format($VerificaEsistenzaVLANRIn/input/tns1:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest/tns1:VC_CompatibilitaProfiloTecnicoLineaProfiloVC/tns1:VPI, &amp;quot;','&amp;quot;), &amp;quot;') ) or ( att2.NOMEATTRIBUTO = 'VCI' and att2.VALOREATTRIBUTO IN ( '&amp;quot;, tib:concat-sequence-format($VerificaEsistenzaVLANRIn/input/tns1:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest/tns1:VC_CompatibilitaProfiloTecnicoLineaProfiloVC/tns1:VCI, &amp;quot;','&amp;quot;), &amp;quot;') ) ) &amp;quot;)&quot;/>&lt;/statement>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
