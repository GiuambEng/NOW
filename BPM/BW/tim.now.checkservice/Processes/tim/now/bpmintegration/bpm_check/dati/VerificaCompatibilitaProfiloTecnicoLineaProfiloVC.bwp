uot;/>&lt;/tns:PCRDown>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:PCRUp&quot;>&lt;tns:PCRUp>&lt;xsl:value-of select=&quot;tns:PCRUp&quot;/>&lt;/tns:PCRUp>&lt;/xsl:if>&lt;/tns:ProfiloVC>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/xsl:if>&lt;xsl:if test=&quot;count($Recupera_IdTipoProfilo/unknownResultset/row) > 0&quot;>&lt;xsl:for-each select=&quot;$Recupera_IdTipoProfilo/unknownResultset/row&quot;>&lt;tns:ProfiloVC>&lt;xsl:if test=&quot;column[name = 'NOMEATTRIBUTO']/value = 'IDPROFILOVC'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;contains(string(column[name = 'VALOREATTRIBUTO']/value), &amp;quot;.&amp;quot;)&quot;>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;substring-before(string(column[name = 'VALOREATTRIBUTO']/value), &amp;quot;.&amp;quot;) &quot;/>&lt;/tns:IdProfiloVC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string(column[name = 'VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string(column[name = 'VALOREATTRIBUTO']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists(column[name = 'VALOREATTRIBUTO']/value)&quot;>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;column[name = 'VALOREATTRIBUTO']/value&quot;/>&lt;/tns:IdProfiloVC>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;/tns:ProfiloVC>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns:Compatib_ProfiliVC>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
