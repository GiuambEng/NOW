                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PCR_UP1"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PCR_DOWN"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PCR_DOWN1"/>

                                    <PreparedParameters
                                    DataType="2"
