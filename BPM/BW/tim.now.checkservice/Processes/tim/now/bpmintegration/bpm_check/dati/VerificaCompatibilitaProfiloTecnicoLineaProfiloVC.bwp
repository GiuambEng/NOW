)) then concat(substring-before($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:PCRDown, &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:PCRDown, &amp;quot;,&amp;quot;)) else $CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:PCRDown)&quot;/>&lt;/PCR_DOWN1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;PCR_DOWN1 xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp) > 0&quot;>&lt;MCR_UP>&lt;xsl:value-of select=&quot;xsd:decimal(if (contains($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp, &amp;quot;,&amp;quot;)) then concat(substring-before($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp, &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp, &amp;quot;,&amp;quot;)) else $CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp)&quot;/>&lt;/MCR_UP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_UP xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp) > 0&quot;>&lt;MCR_UP1>&lt;xsl:value-of select=&quot;xsd:decimal(if (contains($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp, &amp;quot;,&amp;quot;)) then concat(substring-before($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp, &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp, &amp;quot;,&amp;quot;)) else $CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRUp)&quot;/>&lt;/MCR_UP1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_UP1 xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown) > 0&quot;>&lt;MCR_DOWN>&lt;xsl:value-of select=&quot;xsd:decimal(if (contains($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown, &amp;quot;,&amp;quot;)) then concat(substring-before($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown, &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown, &amp;quot;,&amp;quot;)) else $CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown)&quot;/>&lt;/MCR_DOWN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_DOWN xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown) > 0&quot;>&lt;MCR_DOWN1>&lt;xsl:value-of select=&quot;xsd:decimal(if (contains($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown, &amp;quot;,&amp;quot;)) then concat(substring-before($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown, &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown, &amp;quot;,&amp;quot;)) else $CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:MCRDown)&quot;/>&lt;/MCR_DOWN1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;MCR_DOWN1 xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:SCRUp) > 0&quot;>&lt;SCR_UP>&lt;xsl:value-of select=&quot;xsd:decimal(if (contains($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:SCRUp, &amp;quot;,&amp;quot;)) then concat(substring-before($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:SCRUp, &amp;quot;,&amp;quot;), &amp;quot;.&amp;quot;, substring-after($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:SCRUp, &amp;quot;,&amp;quot;)) else $CompatibilitaProfiliVC/tns1:Pro