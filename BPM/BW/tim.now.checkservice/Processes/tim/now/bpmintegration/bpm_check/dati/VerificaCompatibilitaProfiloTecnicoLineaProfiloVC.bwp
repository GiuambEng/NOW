                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PRFL_VC &#xa;FROM PROFILO_VC &#xa;WHERE TIPOLG_PROFILO = ? AND ID_OFFERTA = ?&#xa;&#x9;AND PCR_UP = ? AND PCR_DOWN = ?&#xa;&#x9;AND FLAG_VENDIBILITA IN(? ,?) " xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_PROFILO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_OFFERTA"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PCR_UP"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PCR_DOWN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_VENDIBILITA1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_VENDIBILITA2"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_VC"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="SelectAssociativa-input"
                                    name="SelectAssociativa"
                                    outputVariable="SelectAssociativa"
                                    tibex:xpdlId="2841a527-c767-4db9-b4ba-7ee65dfb4168" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToSelectAssociativa"/>
                                    <bpws:target linkName="Log_IdTipoProfiloToSelectAssociativa"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectAssociativaToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2841a527-c767-4db9-b4ba-7ee65dfb4168+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;IDPRFLTCNCLN&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Sel_IdPrfl_CBR&quot;/>&lt;xsl:param name=&quot;Sel_IdPrfl_VC&quot;/>&lt;xsl:param name=&quot;CompatibilitaProfiliVC&quot;/>&lt;xsl:template name=&quot;SelectAssociativa-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:IdProfiloVC) > 0&quot;>&lt;ID_PRFL_VC>&lt;xsl:value-of select=&quot;xsd:int($CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:IdProfiloVC)&quot;/>&lt;/ID_PRFL_VC>&lt;/xsl:when>&lt;xsl:when test=&quot;$CompatibilitaProfiliVC/tns1:ProfiloVC[number($index)]/tns1:TipoProfiloVC = 'CBR'&quot;>&lt;ID_PRFL_VC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Sel_IdPrfl_CBR/Record[1]/ID_PRFL_VC)&quot;>&lt;xsl:value-of select=&quot;$Sel_IdPrfl_CBR/Record[1]/ID_PRFL_VC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PRFL_VC>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_PRFL_VC>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Sel_IdPrfl_VC/Record[1]/ID_PRFL_VC)&quot;>&lt;xsl:value-of select=&quot;$Sel_IdPrfl_VC/Record[1]/ID_PRFL_VC&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PRFL_VC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;ID_PRFL_TCNC_LN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($IDPRFLTCNCLN/Record[1]/ID_PRFL_TCNC_LN)&quot;>&lt;xsl:value-of select=&quot;$IDPRFLTCNCLN/Record[1]/ID_PRFL_TCNC_LN&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/ID_PRFL_TCNC_LN>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PRFL_VC_LINEA, ID_PRFL_TCNC_LN, ID_PRFL_VC&#xa;  FROM PRFL_VC_PRFL_TCNC_LN&#xa;  where ID_PRFL_VC =? and ID_PRFL_TCNC_LN =?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_PRFL_VC"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_PRFL_TCNC_LN"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_VC_LINEA"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_TCNC_LN"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_PRFL_VC"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Sel_IdPrfl_VC&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Sel_IdPrfl_CBR&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaProfiloVC&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAssociativa1&quot;/>&#xa;    &lt;xsl:param name=&quot;CompatibilitaProfiliVC&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroRecordAssociativa&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAssociativa&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANRIn&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaProfiloVC&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:TipoProfiloVC = 'CBR'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$NumeroRecordAssociativa= 1&quot;>&#xa;                        &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                            &lt;tns:ProfiloVC>&#xa;                                &lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;(count($Sel_IdPrfl_VC/Record) > 1 or count($Sel_IdPrfl_CBR/Record) > 1) and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRUp) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRUp) = 0 and starts-with($VerificaEsistenzaVLANRIn/input/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest/tns:Offerta, &amp;quot;BITSTREAMATMSI&amp;quot;)&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value)&quot;>&#xa;                                            &lt;tns:IdProfiloVC>&#xa;                                                &lt;xsl:value-of select=&quot;$SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value&quot;/>&#xa;                                            &lt;/tns:IdProfiloVC>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:IdProfiloVC>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int($SelectAssociativa/Record[1]/ID_PRFL_VC)&quot;/>&#xa;                                        &lt;/tns:IdProfiloVC>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns:ProfiloVC>&#xa;                            &lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&#xa;                            &lt;tns:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns:Codice>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($Sel_IdPrfl_CBR/Record) = 1 and $NumeroRecordAssociativa = 1&quot;>&#xa;                        &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                            &lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&#xa;                            &lt;tns:ProfiloVC>&#xa;                                &lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;exists($Sel_IdPrfl_CBR/Record[1]/ID_PRFL_VC)&quot;>&#xa;                                    &lt;tns:IdProfiloVC>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($Sel_IdPrfl_CBR/Record[1]/ID_PRFL_VC)&quot;/>&#xa;                                    &lt;/tns:IdProfiloVC>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns:ProfiloVC>&#xa;                            &lt;tns:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns:Codice>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                            &lt;tns:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns:Codice>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$NumeroRecordAssociativa= 1&quot;>&#xa;                        &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                            &lt;tns:ProfiloVC>&#xa;                                &lt;xsl:variable name=&quot;PCR_UP3&quot; select=&quot;$Sel_IdPrfl_VC/Record[ID_PRFL_VC = $SelectAssociativa/Record[1]/ID_PRFL_VC]/PCR_UP&quot;/>&#xa;                                &lt;xsl:variable name=&quot;PCR_UP2&quot; select=&quot;$Sel_IdPrfl_VC/Record[xsd:int(ID_PRFL_VC) = $SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value]/PCR_UP&quot;/>&#xa;                                &lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;(count($Sel_IdPrfl_VC/Record) > 1 or count($Sel_IdPrfl_CBR/Record) > 1) and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRUp) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRUp) = 0 and starts-with($VerificaEsistenzaVLANRIn/input/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest/tns:Offerta, &amp;quot;BITSTREAMATMSI&amp;quot;)&quot;>&#xa;                                        &lt;xsl:if test=&quot;not((string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value)&quot;>&#xa;                                            &lt;tns:IdProfiloVC>&#xa;                                                &lt;xsl:value-of select=&quot;$SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value&quot;/>&#xa;                                            &lt;/tns:IdProfiloVC>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns:IdProfiloVC>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int($SelectAssociativa/Record[1]/ID_PRFL_VC)&quot;/>&#xa;                                        &lt;/tns:IdProfiloVC>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;(count($Sel_IdPrfl_VC/Record) > 1 or count($Sel_IdPrfl_CBR/Record) > 1) and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRUp) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRUp) = 0 and starts-with($VerificaEsistenzaVLANRIn/input/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest/tns:Offerta, &amp;quot;BITSTREAMATMSI&amp;quot;)&quot;>&#xa;                                        &lt;xsl:if test=&quot;exists($Sel_IdPrfl_VC/Record[xsd:int(ID_PRFL_VC) = $SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value]/PCR_UP)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;floor($PCR_UP2)=$PCR_UP2&quot;>&#xa;                                                    &lt;tns:PCRUp>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($PCR_UP2)&quot;/>&#xa;                                                    &lt;/tns:PCRUp>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;$PCR_UP2&quot;>&#xa;                                                        &lt;tns:PCRUp>&#xa;                                                            &lt;xsl:value-of select=&quot;$PCR_UP2&quot;/>&#xa;                                                        &lt;/tns:PCRUp>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;xsl:if test=&quot;exists($Sel_IdPrfl_VC/Record[ID_PRFL_VC = $SelectAssociativa/Record[1]/ID_PRFL_VC]/PCR_UP)&quot;>&#xa;                                            &lt;xsl:choose>&#xa;                                                &lt;xsl:when test=&quot;floor($PCR_UP3)=$PCR_UP3&quot;>&#xa;                                                    &lt;tns:PCRUp>&#xa;                                                        &lt;xsl:value-of select=&quot;xsd:int($PCR_UP3)&quot;/>&#xa;                                                    &lt;/tns:PCRUp>&#xa;                                                &lt;/xsl:when>&#xa;                                                &lt;xsl:otherwise>&#xa;                                                    &lt;xsl:if test=&quot;$PCR_UP3&quot;>&#xa;                                                        &lt;tns:PCRUp>&#xa;                                                            &lt;xsl:value-of select=&quot;$PCR_UP3&quot;/>&#xa;                                                        &lt;/tns:PCRUp>&#xa;                                                    &lt;/xsl:if>&#xa;                                                &lt;/xsl:otherwise>&#xa;                                            &lt;/xsl:choose>&#xa;                                        &lt;/xsl:if>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns:ProfiloVC>&#xa;                            &lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&#xa;                            &lt;tns:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns:Codice>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($Sel_IdPrfl_VC/Record) = 1 and $NumeroRecordAssociativa = 1&quot;>&#xa;                        &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                            &lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&#xa;                            &lt;tns:ProfiloVC>&#xa;                                &lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&#xa;                                        &lt;tns:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglioOrdine>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;exists($Sel_IdPrfl_VC/Record[1]/ID_PRFL_VC)&quot;>&#xa;                                    &lt;tns:IdProfiloVC>&#xa;                                        &lt;xsl:value-of select=&quot;xsd:int($Sel_IdPrfl_VC/Record[1]/ID_PRFL_VC)&quot;/>&#xa;                                    &lt;/tns:IdProfiloVC>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($Sel_IdPrfl_VC/Record[1]/PCR_UP)&quot;>&#xa;                                        &lt;tns:PCRUp>&#xa;                                            &lt;xsl:value-of select=&quot;xsd:int($Sel_IdPrfl_VC/Record[1]/PCR_UP)&quot;/>&#xa;                                        &lt;/tns:PCRUp>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise/>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/tns:ProfiloVC>&#xa;                            &lt;tns:Codice>&#xa;                                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                            &lt;/tns:Codice>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                            &lt;tns:Codice>&#xa;                                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                            &lt;/tns:Codice>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
