                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_PRFL_VC,PCR_UP&#xa;FROM PROFILO_VC &#xa;WHERE TIPOLG_PROFILO = ? AND ID_OFFERTA = ? AND (PCR_UP = ? OR ? IS NULL ) AND (PCR_DOWN = ? OR ? IS NULL) &#xa;AND (MCR_UP = ? OR ? IS NULL ) AND (MCR_DOWN = ? OR ? IS NULL) AND  (SCR_UP =? OR ? IS NULL )AND (SCR_DOWN =? OR ? IS NULL) AND FLAG_VENDIBILITA IN(?, ?)&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
