                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaEsistenzaVLANRIn.input&quot;/>&lt;xsl:param name=&quot;Sel_IdPrfl_VC&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Sel_IdPrfl_CBR&quot;/>&lt;xsl:param name=&quot;VerificaProfiloVC&quot;/>&lt;xsl:param name=&quot;SelectAssociativa1&quot;/>&lt;xsl:param name=&quot;CompatibilitaProfiliVC&quot;/>&lt;xsl:param name=&quot;NumeroRecordAssociativa&quot;/>&lt;xsl:param name=&quot;SelectAssociativa&quot;/>&lt;xsl:template name=&quot;VerificaProfiloVC&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:TipoProfiloVC = 'CBR'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$NumeroRecordAssociativa= 1&quot;>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;tns:ProfiloVC>&lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(count($Sel_IdPrfl_VC/Record) > 1 or count($Sel_IdPrfl_CBR/Record) > 1) and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRUp) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRUp) = 0 and starts-with($VerificaEsistenzaVLANRIn.input/tns:Offerta, &amp;quot;BITSTREAMATMSI&amp;quot;)&quot;>&lt;xsl:if test=&quot;not((string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value)&quot;>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;$SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value&quot;/>&lt;/tns:IdProfiloVC>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;xsd:int($SelectAssociativa/Record[1]/ID_PRFL_VC)&quot;/>&lt;/tns:IdProfiloVC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ProfiloVC>&lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Sel_IdPrfl_CBR/Record) = 1 and $NumeroRecordAssociativa = 1&quot;>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&lt;tns:ProfiloVC>&lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Sel_IdPrfl_CBR/Record[1]/ID_PRFL_VC)&quot;>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;xsd:int($Sel_IdPrfl_CBR/Record[1]/ID_PRFL_VC)&quot;/>&lt;/tns:IdProfiloVC>&lt;/xsl:if>&lt;/tns:ProfiloVC>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;$NumeroRecordAssociativa= 1&quot;>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;tns:ProfiloVC>&lt;xsl:variable name=&quot;PCR_UP3&quot; select=&quot;$Sel_IdPrfl_VC/Record[ID_PRFL_VC = $SelectAssociativa/Record[1]/ID_PRFL_VC]/PCR_UP&quot;/>&lt;xsl:variable name=&quot;PCR_UP2&quot; select=&quot;$Sel_IdPrfl_VC/Record[xsd:int(ID_PRFL_VC) = $SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value]/PCR_UP&quot;/>&lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(count($Sel_IdPrfl_VC/Record) > 1 or count($Sel_IdPrfl_CBR/Record) > 1) and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRUp) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRUp) = 0 and starts-with($VerificaEsistenzaVLANRIn.input/tns:Offerta, &amp;quot;BITSTREAMATMSI&amp;quot;)&quot;>&lt;xsl:if test=&quot;not((string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value)&quot;>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;$SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value&quot;/>&lt;/tns:IdProfiloVC>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:IdProfiloVC>&lt;xsl:value-of select=&quot;xsd:int($SelectAssociativa/Record[1]/ID_PRFL_VC)&quot;/>&lt;/tns:IdProfiloVC>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;(count($Sel_IdPrfl_VC/Record) > 1 or count($Sel_IdPrfl_CBR/Record) > 1) and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:SCRUp) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRDown) = 0 and string-length($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:PCRUp) = 0 and starts-with($VerificaEsistenzaVLANRIn.input/tns:Offerta, &amp;quot;BITSTREAMATMSI&amp;quot;)&quot;>&lt;xsl:if test=&quot;exists($Sel_IdPrfl_VC/Record[xsd:int(ID_PRFL_VC) = $SelectAssociativa1/unknownResultset[1]/row[1]/column[name = &amp;quot;ID_PRFL_VC&amp;quot;]/value]/PCR_UP)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;floor($PCR_UP2)=$PCR_UP2&quot;>&lt;tns:PCRUp>&lt;xsl:value-of select=&quot;xsd:int($PCR_UP2)&quot;/>&lt;/tns:PCRUp>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$PCR_UP2&quot;>&lt;tns:PCRUp>&lt;xsl:value-of select=&quot;$PCR_UP2&quot;/>&lt;/tns:PCRUp>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;exists($Sel_IdPrfl_VC/Record[ID_PRFL_VC = $SelectAssociativa/Record[1]/ID_PRFL_VC]/PCR_UP)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;floor($PCR_UP3)=$PCR_UP3&quot;>&lt;tns:PCRUp>&lt;xsl:value-of select=&quot;xsd:int($PCR_UP3)&quot;/>&lt;/tns:PCRUp>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$PCR_UP3&quot;>&lt;tns:PCRUp>&lt;xsl:value-of select=&quot;$PCR_UP3&quot;/>&lt;/tns:PCRUp>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ProfiloVC>&lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Sel_IdPrfl_VC/Record) = 1 and $NumeroRecordAssociativa = 1&quot;>&lt;tns:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCResponse>&lt;xsl:copy-of select=&quot;$VerificaProfiloVC/tns:ProfiloVC&quot;/>&lt;tns:ProfiloVC>&lt;xsl:if test=&quot;string-length(string($CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine)) > 0&quot;>&lt;xsl:if test=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$CompatibilitaProfiliVC/tns:ProfiloVC[number($index)]/tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;exists($Sel_IdPrfl_VC/Record[1]/ID_PRFL_VC)&quot;>&lt;tns:I