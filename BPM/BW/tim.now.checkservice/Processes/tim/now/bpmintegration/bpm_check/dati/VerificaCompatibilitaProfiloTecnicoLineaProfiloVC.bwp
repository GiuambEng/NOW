            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+669eef4c-3fd1-4a3f-9fff-6e6af2344b97+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;RecuperaIDdettAttrib&quot;/>&lt;xsl:param name=&quot;VerificaEsistenzaVLANRIn&quot;/>&lt;xsl:template name=&quot;SQLDirect-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT att.DTTGLSST_TTRBTIDTTGLISST_BDSID, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO FROM BDS_1_CASEDATA_ASSET ass, BDS_1_CASEDATA_DETTAGLIOASSET dett, BDS_1_CASEDATA_ATTRIBTDTTGLSST att WHERE ass.BDS_ID = dett.ASSET_DETTAGLIOASSET_BDSID and dett.BDS_ID = att.DTTGLSST_TTRBTIDTTGLISST_BDSID and ass.IDASSET = '&amp;quot;, string($VerificaEsistenzaVLANRIn/input/tns1:VerificaCompatibilitaProfiloTecnicoLineaProfiloVCRequest/tns1:IdAsset) ,&amp;quot;' and dett.NOMECOMPONENTE = 'ATMVC' and att.NOMEATTRIBUTO = 'IDPROFILOVC' and att.DTTGLSST_TTRBTIDTTGLISST_BDSID NOT IN ('&amp;quot;, tib:concat-sequence-format($RecuperaIDdettAttrib/unknownResultset[1]/row/column[1]/value, &amp;quot;','&amp;quot;) ,&amp;quot;' ) ORDER BY att.DTTGLSST_TTRBTIDTTGLISST_BDSID &amp;quot;)&quot;/>&lt;/statement>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
