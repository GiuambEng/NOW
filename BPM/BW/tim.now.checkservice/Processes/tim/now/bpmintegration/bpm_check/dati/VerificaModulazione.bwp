                    <bpws:sources>
                        <bpws:source linkName="AssignToAssignNuovaOfferta"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaModulazioneIn.input&quot;/>&#xa;    &lt;xsl:template name=&quot;TrascodificaCaratteristica&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaModulazioneRequest>&#xa;            &lt;tns:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaModulazioneIn.input/tns:Offerta&quot;/>&#xa;            &lt;/tns:Offerta>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$VerificaModulazioneIn.input/tns:Caratteristica='0' &quot;>&#xa;                    &lt;tns:Caratteristica>&#xa;                        &lt;xsl:value-of select=&quot;'FLAT'&quot;/>&#xa;                    &lt;/tns:Caratteristica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VerificaModulazioneIn.input/tns:Caratteristica='1' &quot;>&#xa;                    &lt;tns:Caratteristica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;LITE&amp;quot;&quot;/>&#xa;                    &lt;/tns:Caratteristica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VerificaModulazioneIn.input/tns:Caratteristica='2' &quot;>&#xa;                    &lt;tns:Caratteristica>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;HL&amp;quot;&quot;/>&#xa;                    &lt;/tns:Caratteristica>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$VerificaModulazioneIn.input/tns:Caratteristica&quot;>&#xa;                        &lt;tns:Caratteristica>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaModulazioneIn.input/tns:Caratteristica&quot;/>&#xa;                        &lt;/tns:Caratteristica>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns:ProfiloTecnicoLinea>&#xa;                &lt;xsl:value-of select=&quot;$VerificaModulazioneIn.input/tns:ProfiloTecnicoLinea&quot;/>&#xa;            &lt;/tns:ProfiloTecnicoLinea>&#xa;            &lt;tns:Modulazione>&#xa;                &lt;xsl:value-of select=&quot;$VerificaModulazioneIn.input/tns:Modulazione&quot;/>&#xa;            &lt;/tns:Modulazione>&#xa;        &lt;/tns:VerificaModulazioneRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
