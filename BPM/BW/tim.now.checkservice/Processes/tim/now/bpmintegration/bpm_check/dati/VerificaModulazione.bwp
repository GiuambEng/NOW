            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaModulazioneIn&quot;/>&lt;xsl:template name=&quot;TrascodificaCaratteristica&quot; match=&quot;/&quot;>&lt;tns:VerificaModulazioneRequest>&lt;tns:Offerta>&lt;xsl:value-of select=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Offerta&quot;/>&lt;/tns:Offerta>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Caratteristica='0' &quot;>&lt;tns:Caratteristica>&lt;xsl:value-of select=&quot;'FLAT'&quot;/>&lt;/tns:Caratteristica>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Caratteristica='1' &quot;>&lt;tns:Caratteristica>&lt;xsl:value-of select=&quot;&amp;quot;LITE&amp;quot;&quot;/>&lt;/tns:Caratteristica>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Caratteristica='2' &quot;>&lt;tns:Caratteristica>&lt;xsl:value-of select=&quot;&amp;quot;HL&amp;quot;&quot;/>&lt;/tns:Caratteristica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Caratteristica&quot;>&lt;tns:Caratteristica>&lt;xsl:value-of select=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Caratteristica&quot;/>&lt;/tns:Caratteristica>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:ProfiloTecnicoLinea>&lt;xsl:value-of select=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:ProfiloTecnicoLinea&quot;/>&lt;/tns:ProfiloTecnicoLinea>&lt;tns:Modulazione>&lt;xsl:value-of select=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Modulazione&quot;/>&lt;/tns:Modulazione>&lt;/tns:VerificaModulazioneRequest>&lt;/xsl