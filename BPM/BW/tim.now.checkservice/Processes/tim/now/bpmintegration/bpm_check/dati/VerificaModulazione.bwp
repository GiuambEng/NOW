            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceAllString/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaModulazioneIn&quot;/>&lt;xsl:template name=&quot;ReplaceMoreString-input&quot; match=&quot;/&quot;>&lt;tns1:InputString>&lt;tns1:OldString>&lt;xsl:value-of select=&quot;$VerificaModulazioneIn/input/tns:VerificaModulazioneRequest/tns:Offerta&quot;/>&lt;/tns1:OldString>&lt;tns1:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;LITE&amp;quot;&quot;/>&lt;/tns1:OldChar>&lt;tns1:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;FLAT&amp;quot;&quot;/>&lt;/tns1:OldChar>&lt;tns1:OldChar>&lt;xsl:value-of select=&quot;&amp;quot;HL&amp;quot;&quot;/>&lt;/tns1:OldChar>&lt;tns1:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:NewChar>&lt;tns1:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:NewChar>&lt;tns1:NewChar>&lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&lt;/tns1:NewChar>&lt;/tns1:InputString>&lt;/xsl:template>&lt;/xsl:stylesheet>"
