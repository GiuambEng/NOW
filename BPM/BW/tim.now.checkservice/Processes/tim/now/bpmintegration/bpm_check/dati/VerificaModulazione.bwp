                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" version="2.0"&gt;&lt;xsl:param name="verModulazione"/&gt;&lt;xsl:template name="VerificaModulazioneOut-input" match="/"&gt;&lt;tns:VerificaModulazioneResponse&gt;&lt;output&gt;&lt;xsl:copy-of select="$verModulazione"/&gt;&lt;/output&gt;&lt;/tns:VerificaModulazioneResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
