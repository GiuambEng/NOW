    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.tim.com/NOW/xsd/GenericLogger"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:VerificaCoppiaBandaPiccoResponse"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="jdbcProperty" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            sca-bpel:sharedResourceType="{http://xsd.tns.tibco.com/amf/models/sharedresource/jdbc}JdbcDataSource" type="xsd:string">
            <bpws:from>
                <bpws:literal>JDBC.JDBCConnectionResource</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="NewUserNumber" type="xsd:double">
            <bpws:from>
                <bpws:literal>0</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns0:VerificaCoppiaBandaPiccoRequest"
            name="Start" sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable name="Flag" type="xsd:string">
            <bpws:from>
                <bpws:literal>TRUE</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="WhileLimited" type="xsd:integer">
            <bpws:from>
                <bpws:literal>0</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns3:jdbcQueryActivityInput"
            name="SelectBandaPicco-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:resultSet" name="SelectBandaPicco" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="InvokeDB-input" sca-bpel:internal="true"/>
        <bpws:variable name="LoggerName" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="LoggerLevel" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="DBResponse-input" sca-bpel:internal="true"/>
        <bpws:variable name="TimeoutJDBC" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/TimerJDBC/TimeoutJDBC" type="xsd:int"/>
        <bpws:variable element="ns0:VerificaCoppiaBandaPiccoRequest"
            name="Mapper-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:VerificaCoppiaBandaPiccoRequest"
            name="Mapper" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="LogCasoFalse-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="CallProcessLOgg-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns5:CW_BUS_MESSAGE"
            name="CallProcessLogUserVlan-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToAssignWhileLimited" tibex:linkType="SUCCESS"/>
                <bpws:link name="While1ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignWhileLimitedToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="SelectBandaPiccoToDBResponse" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToSelectBandaPicco" tibex:linkType="SUCCESS"/>
                <bpws:link name="DBResponseToNewUserNumber" tibex:linkType="SUCCESS"/>
                <bpws:link name="NewUserNumberToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="WhileToWhile1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="WhileToEnd" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToWhile" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToWhile1" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="629a8132-6a01-4f83-b531-4cbdc1427776"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToAssignWhileLimited"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="089311ba-3c66-4f03-9058-d2d8e5869677" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="While1ToEnd"/>
                        <bpws:target linkName="CallProcessToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Flag&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$Flag=&amp;quot;FALSE&amp;quot;&quot;>&lt;tns:VerificaCoppiaBandaPiccoResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCoppiaBandaPiccoResponse>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCoppiaBandaPiccoResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCoppiaBandaPiccoResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="NewUserNumber"
                    name="NewUserNumber" outputVariable="NewUserNumber"
                    tibex:xpdlId="ffaf6ded-5e71-4167-bc78-b99d5c69face" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DBResponseToNewUserNumber"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="NewUserNumberToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(string-length($Start/ns0:UserVlan[1]/ns0:BandaPiccoDown)=0 and string-length($Start/ns0:UserVlan[1]/ns0:BandaPiccoUp)=0) then 0 else count($Start/ns0:UserVlan)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="NewUserNumber" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="2356afd3-47e8-4fe8-b91b-f0e807904903">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:empty name="GroupInit1" tibex:group="groupInit"/>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="number($index) &lt;= count($Start/ns0:UserVlan) and $Flag!='FALSE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[number($index) <= count($Start/ns0:UserVlan) and $Flag!='FALSE']]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStart1ToAssign1" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="GroupStart1ToEmpty1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="Empty1ToGroupEnd1" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="e6b54a09-aaee-4666-845c-90a7f56f3783">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStart1ToEmpty1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="((xsd:decimal(if (contains($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown, &quot;,&quot;)) then concat(substring-before($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown, &quot;,&quot;), &quot;.&quot;, substring-after($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown, &quot;,&quot;)) else $Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown)) &lt;= $SelectBandaPicco/Record[1]/PROFILO_COMMERCIALE_DOWN &#xd;&#xa;and &#xd;&#xa;(xsd:decimal(if (contains($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp, &quot;,&quot;)) then concat(substring-before($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp, &quot;,&quot;), &quot;.&quot;, substring-after($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp, &quot;,&quot;)) else $Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp)) &lt;= $SelectBandaPicco/Record[1]/PROFILO_COMMERCIALE_UP)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[((xsd:decimal(if (contains($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown, ",")) then concat(substring-before($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown, ","), ".", substring-after($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown, ",")) else $Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoDown)) <= $SelectBandaPicco/Record[1]/PROFILO_COMMERCIALE_DOWN 
and 
(xsd:decimal(if (contains($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp, ",")) then concat(substring-before($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp, ","), ".", substring-after($Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp, ",")) else $Start/ns0:UserVlan[number($index)]/ns0:BandaPiccoUp)) <= $SelectBandaPicco/Record[1]/PROFILO_COMMERCIALE_UP)]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd1"
                                tibex:group="groupEnd" tibex:xpdlId="8d7e0933-5f14-4f12-a151-9897aa8d6d07">
                                <bpws:targets>
                                    <bpws:target linkName="Assign1ToGroupEnd1"/>
                                    <bpws:target linkName="Empty1ToGroupEnd1"/>
