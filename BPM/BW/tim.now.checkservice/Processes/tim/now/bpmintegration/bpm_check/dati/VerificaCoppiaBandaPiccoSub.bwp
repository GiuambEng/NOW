                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;SelectBandaPicco&quot;/>&lt;xsl:template name=&quot;DBResponse-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCoppiaBandaPiccoSub&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckDatiPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaCoppiaBandaPicco&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;DBResponse: &amp;quot;,tib:render-xml($SelectBandaPicco,true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper-input"
                    name="Mapper" outputVariable="Mapper"
                    tibex:xpdlId="44656bd2-404d-49b6-91b4-ce824dfb11e7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NewUserNumberToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:VerificaCoppiaBandaPiccoRequest>&lt;xsl:variable name=&quot;Untagged&quot; select=&quot;count($Start/tns:UserVlanCONS)=1 and not(string-length($Start/tns:UserVlanCONS[1]/tns:UservlanId)>0) and count($Start/tns:UserVlan)=1 and not(string-length($Start/tns:UserVlan[1]/tns:UservlanId)>0)&quot;/>&lt;xsl:for-each select=&quot;$Start/tns:UserVlanCONS&quot;>&lt;xsl:variable name=&quot;UserVlanID&quot; select=&quot;tns:UservlanId&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists(../tns:UserVlan[./tns:UservlanId=$UserVlanID])) and not($Untagged)&quot;>&lt;tns:UserVlanCONS>&lt;xsl:if test=&quot;tns:UservlanId&quot;>&lt;tns:UservlanId>&lt;xsl:value-of select=&quot;tns:UservlanId&quot;/>&lt;/tns:UservlanId>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BandaPiccoDown&quot;>&lt;tns:BandaPiccoDown>&lt;xsl:value-of select=&quot;tns:BandaPiccoDown&quot;/>&lt;/tns:BandaPiccoDown>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:BandaPiccoUp&quot;>&lt;tns:BandaPiccoUp>&lt;xsl:value-of select=&quot;tns:BandaPiccoUp&quot;/>&lt;/tns:BandaPiccoUp>&lt;/xsl:if>&lt;/tns:UserVlanCONS>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;/tns:VerificaCoppiaBandaPiccoRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:ControlliAmmessiDati="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
