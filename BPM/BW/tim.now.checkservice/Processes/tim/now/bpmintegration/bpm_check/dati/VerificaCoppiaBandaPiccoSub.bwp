                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if ($Start/ns0:Lavorazione='VARIAZIONE' and $Start/ns0:SottoLavorazione='RICONFIGURAZIONEVC' and string-length($Start/ns0:ProfiloTecnicoLinea)=0 and number($index)>$NewUserNumber) then 'TRUE' else 'FALSE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
