                                    inputVariable="VP"
                                    name="AssignVerificaInactive"
                                    outputVariable="VP"
                                    tibex:xpdlId="1d10e53e-b6ed-4d1d-9f07-fb4f67cfb704" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
