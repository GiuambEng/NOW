rasporto>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:DatiOut/tns1:Tipo_Trasporto&quot;/>&#xa;                                        &lt;/tns:Tipo_Trasporto>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:VP_Verifica>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns:VP_Verifica>&#xa;                                    &lt;tns:IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:INFO_VP_KIT/tns1:IdDetOrdine&quot;/>&#xa;                                    &lt;/tns:IDDettaglioOrdine>&#xa;                                    &lt;tns:ModalitaFatturazione>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA = $idRisorsa]/tns1:MOD_FATT&quot;/>&#xa;                                    &lt;/tns:ModalitaFatturazione>&#xa;                                    &lt;tns:Tipo>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA = $idRisorsa]/tns1:TIPO&quot;/>&#xa;                                    &lt;/tns:Tipo>&#xa;                                    &lt;tns:BandaMCR>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA = $idRisorsa]/tns1:BANDA_MCR&quot;/>&#xa;                                    &lt;/tns:BandaMCR>&#xa;                                    &lt;tns:BandaPCR>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA = $idRisorsa]/tns1:BANDA_PCR&quot;/>&#xa;                                    &lt;/tns:BandaPCR>&#xa;                                    &lt;tns:VP_Disponibili>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                    &lt;/tns:VP_Disponibili>&#xa;                                    &lt;tns:VPCode>&#xa;                                        &lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&#xa;                                    &lt;/tns:VPCode>&#xa;                                    &lt;xsl:if test=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA = $idRisorsa]/tns1:TIPO_TRASPORTO&quot;>&#xa;                                        &lt;tns:Tipo_Trasporto>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA = $idRisorsa]/tns1:TIPO_TRASPORTO&quot;/>&#xa;                                        &lt;/tns:Tipo_Trasporto>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/tns:VP_Verifica>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:for-each>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($AccumulateMappingVPKIT/tns1:MapperVPKIT[1]/tns1:DatiOut/tns1:CLLI)>0&quot;>&#xa;                            &lt;xsl:if test=&quot;$AccumulateMappingVPKIT/tns1:MapperVPKIT[1]/tns1:DatiOut/tns1:CLLI&quot;>&#xa;                                &lt;tns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;$AccumulateMappingVPKIT/tns1:MapperVPKIT[1]/tns1:DatiOut/tns1:CLLI&quot;/>&#xa;                                &lt;/tns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[1]/tns1:CLLI&quot;>&#xa;                                &lt;tns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[1]/tns1:CLLI&quot;/>&#xa;                                &lt;/tns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVPResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VerificaVPResponse>&#xa;                    &lt;tns:VP_Verifica>&#xa;                        &lt;tns:IDDettaglioOrdine>&#xa;                            &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                        &lt;/tns:IDDettaglioOrdine>&#xa;                        &lt;tns:ModalitaFatturazione>&#xa;                            &lt;xsl:value-of select=&quot;'Non presente'&quot;/>&#xa;                        &lt;/tns:ModalitaFatturazione>&#xa;                        &lt;tns:Tipo>&#xa;                            &lt;xsl:value-of select=&quot;'Non presente'&quot;/>&#xa;                        &lt;/tns:Tipo>&#xa;                        &lt;tns:BandaMCR>&#xa;                            &lt;xsl:value-of select=&quot;'Non presente'&quot;/>&#xa;                        &lt;/tns:BandaMCR>&#xa;                        &lt;tns:BandaPCR>&#xa;                            &lt;xsl:value-of select=&quot;'Non presente'&quot;/>&#xa;                        &lt;/tns:BandaPCR>&#xa;                        &lt;tns:VP_Disponibili>&#xa;                            &lt;xsl:value-of select=&quot;'Non presente'&quot;/>&#xa;                        &lt;/tns:VP_Disponibili>&#xa;                        &lt;tns:VPCode>&#xa;                            &lt;xsl:value-of select=&quot;'Non presente'&quot;/>&#xa;                        &lt;/tns:VPCode>&#xa;                        &lt;tns:Tipo_Trasporto>&#xa;                            &lt;xsl:value-of select=&quot;'Non presente'&quot;/>&#xa;                        &lt;/tns:Tipo_Trasporto>&#xa;                    &lt;/tns:VP_Verifica>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVPResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="VP" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VP&quot;/>&lt;xsl:param name=&quot;VerificaVP&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:template name=&quot;LogOutputVP-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output: &amp;quot;, tib:render-xml($VP, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;tns:ActiveLoggerServices>&lt;tns:Envelope>&lt;tns:Identifier>&lt;tns:ServiceName>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkDati&amp;quot;&quot;/>&lt;/tns:ServiceName>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'VerificaVP'&quot;/>&lt;/tns:Operation>&lt;tns:Source>&lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&lt;/tns:Source>&lt;xsl:if test=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:EventType>&lt;xsl:value-of select=&quot;&amp;quot;Verifica_VP_SUB_PROCESSED&amp;quot;&quot;/>&lt;/tns:EventType>&lt;tns:trackID>&lt;xsl:value-of select=&quot;concat(&amp;quot;Verifica_VP_SUB_PROCESSED_&amp;quot;, $VerificaVP/input/tns1:VerificaVPRequest/tns1:IDRichiestaOLO)&quot;/>&lt;/tns:trackID>&lt;/tns:Identifier>&lt;tns:track_position>&lt;xsl:value-of select=&quot;'IN'&quot;/>&lt;/tns:track_position>&lt;tns:Timestamp>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns:Timestamp>&lt;/tns:Envelope>&lt;tns:Playload>&lt;tns:Binary>&lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaVP/input/tns1:VerificaVPRequest)))&quot;/>&lt;/tns:Binary>&lt;tns:XMLString>&lt;xsl:value-of select=&quot;tib:render-xml($VerificaVP/input/tns1:VerificaVPRequest, true(), true())&quot;/>&lt;/tns:XMLString>&lt;/tns:Playload>&lt;/tns:ActiveLoggerServices>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogOutputVP-input" name="LogOutputVP"
                    tibex:xpdlId="79149d74-f818-4fe7-b65f-16fa7beed010"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignOutVerificaVpKit1ToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOutputVPToInvoke_ESITOOK">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOutputVPToReplayVerificaVP_ESITOKO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VP/tns:Codice = false() or (exists($VerificaVP/input/tns:VerificaVPRequest/tns:Flag_GUI) and $VerificaVP/input/tns:VerificaVPRequest/tns:Flag_GUI = true())" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VP/tns:Codice = false() or (exists($VerificaVP.input/tns:Flag_GUI) and $VerificaVP.input/tns:Flag_GUI = true())]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;VP&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutputVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Output: &amp;quot;, tib:render-xml($VP, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkDati&amp;quot;&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaVP'&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns:Source>&#xa;                        &lt;xsl:if test=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;>&#xa;                            &lt;tns:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica_VP_SUB_PROCESSED&amp;quot;&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Verifica_VP_SUB_PROCESSED_&amp;quot;, $VerificaVP.input/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload>&#xa;                    &lt;tns:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaVP.input)))&quot;/>&#xa;                    &lt;/tns:Binary>&#xa;                    &lt;tns:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VerificaVP.input, true(), true())&quot;/>&#xa;                    &lt;/tns:XMLString>&#xa;                &lt;/tns:Playload>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke
                inputVariable="DatiVerificaControlliInvoke-input"
                name="DatiVerificaControlliInvoke"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlliInvoke"
                partnerLink="DatiVerificaControlli"
                portType="ns8:DatiVerificaControlliPortType" tibex:xpdlId="fee86a92-7a76-4658-9552-6a7a931db46e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns2="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" version="2.0"&gt;&lt;xsl:param name="VerificaVP"/&gt;&lt;xsl:param name="VP"/&gt;&lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;&lt;tns:DatiVerificaControlliRequest&gt;&lt;parameters&gt;&lt;tns1:DatiVerificaControlliInput&gt;&lt;tns1:Operatore&gt;&lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;&lt;/tns1:Operatore&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$VerificaVP/input/tns2:VerificaVPRequest/tns2:IDRichiestaOLO"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;xsl:for-each select="$VP/tns2:VP_Verifica"&gt;&lt;tns1:UservlanVC&gt;&lt;xsl:if test="string-length(tns2:BandaMCR) &gt; 0"&gt;&lt;tns1:BandaMCR&gt;&lt;xsl:value-of select="tns2:BandaMCR"/&gt;&lt;/tns1:BandaMCR&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns2:BandaPCR) &gt; 0"&gt;&lt;tns1:BandaPCR&gt;&lt;xsl:value-of select="tns2:BandaPCR"/&gt;&lt;/tns1:BandaPCR&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(../tns2:CLLI) &gt; 0"&gt;&lt;xsl:if test="../tns2:CLLI"&gt;&lt;tns1:CLLI&gt;&lt;xsl:value-of select="../tns2:CLLI"/&gt;&lt;/tns1:CLLI&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns2:ModalitaFatturazione) &gt; 0"&gt;&lt;tns1:ModalitaFatturazione&gt;&lt;xsl:value-of select="tns2:ModalitaFatturazione"/&gt;&lt;/tns1:ModalitaFatturazione&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns2:Tipo) &gt; 0"&gt;&lt;tns1:Tipo&gt;&lt;xsl:value-of select="tns2:Tipo"/&gt;&lt;/tns1:Tipo&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns2:Tipo_Trasporto) &gt; 0"&gt;&lt;xsl:if test="tns2:Tipo_Trasporto"&gt;&lt;tns1:TipoTrasporto&gt;&lt;xsl:value-of select="tns2:Tipo_Trasporto"/&gt;&lt;/tns1:TipoTrasporto&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns2:VP_Disponibili) &gt; 0"&gt;&lt;tns1:VCDisponibili&gt;&lt;xsl:value-of select="tns2:VP_Disponibili"/&gt;&lt;/tns1:VCDisponibili&gt;&lt;/xsl:if&gt;&lt;/tns1:UservlanVC&gt;&lt;/xsl:for-each&gt;&lt;/tns1:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;VP&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlliInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns2:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;xsl:for-each select=&quot;$VP/tns2:VP_Verifica&quot;>&#xa;                &lt;tns1:UservlanVC>&#xa;                    &lt;xsl:if test=&quot;string-length(tns2:BandaMCR) > 0&quot;>&#xa;                        &lt;tns1:BandaMCR>&#xa;                            &lt;xsl:value-of select=&quot;tns2:BandaMCR&quot;/>&#xa;                        &lt;/tns1:BandaMCR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns2:BandaPCR) > 0&quot;>&#xa;                        &lt;tns1:BandaPCR>&#xa;                            &lt;xsl:value-of select=&quot;tns2:BandaPCR&quot;/>&#xa;                        &lt;/tns1:BandaPCR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(../tns2:CLLI) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;../tns2:CLLI&quot;>&#xa;                            &lt;tns1:CLLI>&#xa;                                &lt;xsl:value-of select=&quot;../tns2:CLLI&quot;/>&#xa;                            &lt;/tns1:CLLI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns2:ModalitaFatturazione) > 0&quot;>&#xa;                        &lt;tns1:ModalitaFatturazione>&#xa;                            &lt;xsl:value-of select=&quot;tns2:ModalitaFatturazione&quot;/>&#xa;                        &lt;/tns1:ModalitaFatturazione>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns2:Tipo) > 0&quot;>&#xa;                        &lt;tns1:Tipo>&#xa;                            &lt;xsl:value-of select=&quot;tns2:Tipo&quot;/>&#xa;                        &lt;/tns1:Tipo>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns2:Tipo_Trasporto) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns2:Tipo_Trasporto&quot;>&#xa;                            &lt;tns1:TipoTrasporto>&#xa;                                &lt;xsl:value-of select=&quot;tns2:Tipo_Trasporto&quot;/>&#xa;                            &lt;/tns1:TipoTrasporto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns2:VP_Disponibili) > 0&quot;>&#xa;                        &lt;tns1:VCDisponibili>&#xa;                            &lt;xsl:value-of select=&quot;tns2:VP_Disponibili&quot;/>&#xa;                        &lt;/tns1:VCDisponibili>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:UservlanVC>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogOutputVPToInvoke_ESITOOK"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="DatiVerificaControlliInvokeToCallProcess"/>
                    <bpws:source
                        linkName="DatiVerificaControlliInvokeToAssign"
                        tibex:faultDetailsVar="DatiVerificaControlliInvoke" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DatiVerificaControlliInvoke&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;VerificaVP&quot;/>&lt;xsl:template name=&quot;LOG_DatiVerificaControlliInvoke-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Risposta di DatiVerificaControlli: &amp;quot;, tib:render-xml($DatiVerificaControlliInvoke/parameters/tns3:DatiVerificaControlliOutput, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_DatiVerificaControlliInvoke-input"
                    name="LOG_DatiVerificaControlliInvoke"
                    tibex:xpdlId="d3e3a4d5-2db6-4b89-9035-de2daacc402d"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="DatiVerificaControlliInvokeToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LOG_DatiVerificaControlliInvokeToAssign1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliInvoke.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_DatiVerificaControlliInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceNP_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Risposta di DatiVerificaControlli: &amp;quot;, tib:render-xml($DatiVerificaControlliInvoke.parameters, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="VP"
                    name="DatiVerificaControlliResponseAssign"
