                portType="ns3:NOWtoCRMWS_CheckVPKITPortType" tibex:xpdlId="296a179c-c857-4786-8caf-5cb101c1999f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/NOWtoCRMWS_CheckVPKIT/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/" version="2.0"&gt;&lt;xsl:param name="VerificaVP"/&gt;&lt;xsl:param name="AccumulateMappingVPKIT"/&gt;&lt;xsl:template name="VerificaVpKit-input" match="/"&gt;&lt;tns1:NOWtoCRMWS_CheckVPKITRequest&gt;&lt;REQUEST&gt;&lt;tns2:NOWtoCRMWS_CheckVPKITRequest&gt;&lt;tns2:CODICE_OLO&gt;&lt;xsl:value-of select="$VerificaVP/input/tns:VerificaVPRequest/tns:CodiceOLO"/&gt;&lt;/tns2:CODICE_OLO&gt;&lt;tns2:CODICE_OLO_AGCOM&gt;&lt;xsl:value-of select="$VerificaVP/input/tns:VerificaVPRequest/tns:CodiceOLOAGCOM"/&gt;&lt;/tns2:CODICE_OLO_AGCOM&gt;&lt;xsl:for-each select="$AccumulateMappingVPKIT/tns2:MapperVPKIT"&gt;&lt;xsl:copy-of select="tns2:INFO_VP_KIT"/&gt;&lt;/xsl:for-each&gt;&lt;xsl:if test="$VerificaVP/input/tns:VerificaVPRequest/tns:IDRichiestaOLO"&gt;&lt;tns2:ID_RICH_OLO&gt;&lt;xsl:value-of select="$VerificaVP/input/tns:VerificaVPRequest/tns:IDRichiestaOLO"/&gt;&lt;/tns2:ID_RICH_OLO&gt;&lt;/xsl:if&gt;&lt;/tns2:NOWtoCRMWS_CheckVPKITRequest&gt;&lt;/REQUEST&gt;&lt;/tns1:NOWtoCRMWS_CheckVPKITRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;AccumulateMappingVPKIT&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaVpKit-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:NOWtoCRMWS_CheckVPKITRequest>&#xa;            &lt;tns2:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CODICE_OLO>&#xa;            &lt;tns2:CODICE_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns2:CODICE_OLO_AGCOM>&#xa;            &lt;xsl:for-each select=&quot;$AccumulateMappingVPKIT/tns2:MapperVPKIT&quot;>&#xa;                &lt;xsl:copy-of select=&quot;tns2:INFO_VP_KIT&quot;/>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;>&#xa;                &lt;tns2:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:ID_RICH_OLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:NOWtoCRMWS_CheckVPKITRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
