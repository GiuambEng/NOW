            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaVpKit&quot;/>&lt;xsl:param name=&quot;AccumulateMappingVPKIT&quot;/>&lt;xsl:template name=&quot;VP&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:CODICE_CAUSALE = &amp;quot;00&amp;quot;&quot;>&lt;tns:VerificaVPResponse>&lt;xsl:for-each select=&quot;$AccumulateMappingVPKIT/tns1:MapperVPKIT&quot;>&lt;xsl:variable name=&quot;idRisorsa&quot; select=&quot;tns1:INFO_VP_KIT/tns1:ID_RISORSA&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;tns1:INFO_VP_KIT/tns1:FLAG_PRESENZA_NOW = &amp;quot;Y&amp;quot;&quot;>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns1:INFO_VP_KIT/tns1:IdDetOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;tns1:DatiOut/tns1:ModalitaFatturazione&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;tns1:DatiOut/tns1:Tipo&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;tns1:DatiOut/tns1:BandaMCR&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;tns1:DatiOut/tns1:BandaPCR&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&lt;/tns:VPCode>&lt;xsl:if test=&quot;tns1:DatiOut/tns1:Tipo_Trasporto&quot;>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;tns1:DatiOut/tns1:Tipo_Trasporto&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/xsl:if>&lt;/tns:VP_Verifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns1:INFO_VP_KIT/tns1:IdDetOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:MOD_FATT&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:TIPO&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:BANDA_MCR&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:BANDA_PCR&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$idRisorsa&quot;/>&lt;/tns:VPCode>&lt;xsl:if test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:TIPO_TRASPORTO&quot;>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:TIPO_TRASPORTO&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/xsl:if>&lt;/tns:VP_Verifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($AccumulateMappingVPKIT/tns1:MapperVPKIT[1]/tns1:DatiOut/tns1:CLLI)>0&quot;>&lt;xsl:if test=&quot;$AccumulateMappingVPKIT/tns1:MapperVPKIT[1]/tns1:DatiOut/tns1:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$AccumulateMappingVPKIT/tns1:MapperVPKIT[1]/tns1:DatiOut/tns1:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/