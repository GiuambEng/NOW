                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LoginpVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input: &amp;quot;, tib:render-xml($VerificaVP.input, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="count($VerificaVP/input/tns:VerificaVPRequest/tns:VC_VerificaVP/tns:VPCode)"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="SommaVP" name="AssignSommaVP"
                    outputVariable="SommaVP"
                    tibex:xpdlId="a0fd3a87-79c6-4500-bbde-e9144be3c8f2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LoginpVPToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignSommaVPToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="count($VerificaVP.input/tns:VC_VerificaVP/tns:VPCode)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="SommaVP" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="80070081-23b4-47a1-b374-b65a46293de1">
                <bpws:targets>
                    <bpws:target linkName="While1ToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToInvoke"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+708c5677-9cab-4bf7-8c0d-60264ecbe0b9" version="2.0"> <xsl:template name="AccumulateMappingVPKIT" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateMappingVPKIT"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($VerificaVP/input/tns:VerificaVPRequest/tns:VC_VerificaVP)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($VerificaVP.input/tns:VC_VerificaVP)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SelectANAGVPToMapperVPKIT" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperVPKITToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="e9666d9c-ea5b-4d1a-8f07-180aa1b988ff">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="AccumulateMappingVPKIT"
                                    outputVariable="AccumulateMappingVPKIT"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="708c5677-9cab-4bf7-8c0d-60264ecbe0b9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperVPKITToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperVPKIT</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3455eedf-de74-46ea-aceb-cdf95b0bded6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;VerificaVP&quot;/>&lt;xsl:template name=&quot;SelectANAGVP-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:CodiceOLOAGCOM&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;COD_VP>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:VPCode)&quot;>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:VPCode&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VP>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectANAGVP-input"
                                    name="SelectANAGVP"
                                    outputVariable="SelectANAGVP"
                                    tibex:xpdlId="3455eedf-de74-46ea-aceb-cdf95b0bded6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectANAGVPToMapperVPKIT"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+3455eedf-de74-46ea-aceb-cdf95b0bded6+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectANAGVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_VP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:VPCode)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:VPCode&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_VP>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATO, MODALITA_FATTURAZIONE, TIPO, BANDA_MCR, BANDA_PCR, COD_VP, CODFC_OLO_AGCOM, TIPO_TRASPORTO, CLLI &#xa;FROM ANAG_VP &#xa;WHERE CODFC_OLO_AGCOM = ?  AND UPPER(STATO) = 'ACTIVE' AND COD_VP = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_VP"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="MODALITA_FATTURAZIONE"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="BANDA_MCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="BANDA_PCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_VP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIPO_TRASPORTO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CLLI"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;SommaVP&quot;/>&lt;xsl:param name=&quot;VerificaVP&quot;/>&lt;xsl:param name=&quot;SelectANAGVP&quot;/>&lt;xsl:template name=&quot;MapperVPKIT-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectANAGVP/Record) > 0&quot;>&lt;tns:MapperVPKIT>&lt;tns:INFO_VP_KIT>&lt;xsl:if test=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;>&lt;tns:IdDetOrdine>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;/>&lt;/tns:IdDetOrdine>&lt;/xsl:if>&lt;tns:NUM_VC>&lt;xsl:value-of select=&quot;xsd:int($SommaVP)&quot;/>&lt;/tns:NUM_VC>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:VPCode&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:TIPO_CONSEGNA>&lt;xsl:value-of select=&quot;&amp;quot;BandaCondivisa&amp;quot;&quot;/>&lt;/tns:TIPO_CONSEGNA>&lt;tns:FLAG_PRESENZA_NOW>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FLAG_PRESENZA_NOW>&lt;/tns:INFO_VP_KIT>&lt;tns:DatiOut>&lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/MODALITA_FATTURAZIONE&quot;>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/MODALITA_FATTURAZIONE&quot;/>&lt;/tns:ModalitaFatturazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/TIPO&quot;>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/TIPO&quot;/>&lt;/tns:Tipo>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/BANDA_MCR&quot;>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/BANDA_MCR&quot;/>&lt;/tns:BandaMCR>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/BANDA_PCR&quot;>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/BANDA_PCR&quot;/>&lt;/tns:BandaPCR>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/TIPO_TRASPORTO&quot;>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/TIPO_TRASPORTO&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;/tns:DatiOut>&lt;/tns:MapperVPKIT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:MapperVPKIT>&lt;tns:INFO_VP_KIT>&lt;xsl:if test=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;>&lt;tns:IdDetOrdine>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;/>&lt;/tns:IdDetOrdine>&lt;/xsl:if>&lt;tns:NUM_VC>&lt;xsl:value-of select=&quot;xsd:int($SommaVP)&quot;/>&lt;/tns:NUM_VC>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns1:VerificaVPRequest/tns1:VC_VerificaVP[number($index)]/tns1:VPCode&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:TIPO_CONSEGNA>&lt;xsl:value-of select=&quot;&amp;quot;BandaCondivisa&amp;quot;&quot;/>&lt;/tns:TIPO_CONSEGNA>&lt;tns:FLAG_PRESENZA_NOW>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FLAG_PRESENZA_NOW>&lt;/tns:INFO_VP_KIT>&lt;/tns:MapperVPKIT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="MapperVPKIT-input"
                                    name="MapperVPKIT"
                                    outputVariable="MapperVPKIT"
                                    tibex:xpdlId="e7e8aa6b-bb2a-4992-afc3-9feb3cf132ee" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectANAGVPToMapperVPKIT"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperVPKITToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SommaVP&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectANAGVP&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperVPKIT-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($SelectANAGVP/Record) > 0&quot;>&#xa;                &lt;tns:MapperVPKIT>&#xa;                    &lt;tns:INFO_VP_KIT>&#xa;                        &lt;xsl:if test=&quot;$VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;>&#xa;                            &lt;tns:IdDetOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns:IdDetOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:NUM_VC>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SommaVP)&quot;/>&#xa;                        &lt;/tns:NUM_VC>&#xa;                        &lt;tns:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:VPCode&quot;/>&#xa;                        &lt;/tns:ID_RISORSA>&#xa;                        &lt;tns:TIPO_CONSEGNA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BandaCondivisa&amp;quot;&quot;/>&#xa;                        &lt;/tns:TIPO_CONSEGNA>&#xa;                        &lt;tns:FLAG_PRESENZA_NOW>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                        &lt;/tns:FLAG_PRESENZA_NOW>&#xa;                    &lt;/tns:INFO_VP_KIT>&#xa;                    &lt;tns:DatiOut>&#xa;                        &lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/MODALITA_FATTURAZIONE&quot;>&#xa;                            &lt;tns:ModalitaFatturazione>&#xa;                                &lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/MODALITA_FATTURAZIONE&quot;/>&#xa;                            &lt;/tns:ModalitaFatturazione>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/TIPO&quot;>&#xa;                            &lt;tns:Tipo>&#xa;                                &lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/TIPO&quot;/>&#xa;                            &lt;/tns:Tipo>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/BANDA_MCR&quot;>&#xa;                            &lt;tns:BandaMCR>&#xa;                                &lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/BANDA_MCR&quot;/>&#xa;                            &lt;/tns:BandaMCR>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/BANDA_PCR&quot;>&#xa;                            &lt;tns:BandaPCR>&#xa;                                &lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/BANDA_PCR&quot;/>&#xa;                            &lt;/tns:BandaPCR>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/TIPO_TRASPORTO&quot;>&#xa;                            &lt;tns:Tipo_Trasporto>&#xa;                                &lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/TIPO_TRASPORTO&quot;/>&#xa;                            &lt;/tns:Tipo_Trasporto>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$SelectANAGVP/Record[1]/CLLI&quot;>&#xa;                            &lt;tns:CLLI>&#xa;                                &lt;xsl:value-of select=&quot;$SelectANAGVP/Record[1]/CLLI&quot;/>&#xa;                            &lt;/tns:CLLI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:DatiOut>&#xa;                &lt;/tns:MapperVPKIT>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:MapperVPKIT>&#xa;                    &lt;tns:INFO_VP_KIT>&#xa;                        &lt;xsl:if test=&quot;$VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;>&#xa;                            &lt;tns:IdDetOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns:IdDetOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns:NUM_VC>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SommaVP)&quot;/>&#xa;                        &lt;/tns:NUM_VC>&#xa;                        &lt;tns:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaVP.input/tns1:VC_VerificaVP[number($index)]/tns1:VPCode&quot;/>&#xa;                        &lt;/tns:ID_RISORSA>&#xa;                        &lt;tns:TIPO_CONSEGNA>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;BandaCondivisa&amp;quot;&quot;/>&#xa;                        &lt;/tns:TIPO_CONSEGNA>&#xa;                        &lt;tns:FLAG_PRESENZA_NOW>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                        &lt;/tns:FLAG_PRESENZA_NOW>&#xa;                    &lt;/tns:INFO_VP_KIT>&#xa;                &lt;/tns:MapperVPKIT>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
