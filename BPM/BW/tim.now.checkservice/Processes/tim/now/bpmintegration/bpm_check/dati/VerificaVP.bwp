t=&quot;string-length(tns1:Tipo_Trasporto) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:Tipo_Trasporto&quot;>&#xa;                                    &lt;tns2:TipoTrasporto>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:Tipo_Trasporto&quot;/>&#xa;                                    &lt;/tns2:TipoTrasporto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:VP_Disponibili) > 0&quot;>&#xa;                                &lt;tns2:VCDisponibili>&#xa;                                    &lt;xsl:value-of select=&quot;tns1:VP_Disponibili&quot;/>&#xa;                                &lt;/tns2:VCDisponibili>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:UservlanVC>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:VerificaVPResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
