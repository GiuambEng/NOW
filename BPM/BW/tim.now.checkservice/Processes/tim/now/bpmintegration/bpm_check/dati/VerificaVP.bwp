                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" version="2.0"&gt;&lt;xsl:param name="VP"/&gt;&lt;xsl:template name="Reply-input" match="/"&gt;&lt;tns1:VerificaVPResponse&gt;&lt;output&gt;&lt;tns:VerificaVPResponse&gt;&lt;xsl:copy-of select="$VP/tns:VP_Verifica"/&gt;&lt;xsl:if test="$VP/tns:CLLI"&gt;&lt;tns:CLLI&gt;&lt;xsl:value-of select="$VP/tns:CLLI"/&gt;&lt;/tns:CLLI&gt;&lt;/xsl:if&gt;&lt;tns:Codice&gt;&lt;xsl:value-of select="$VP/tns:Codice"/&gt;&lt;/tns:Codice&gt;&lt;tns:Descrizione&gt;&lt;xsl:value-of select="$VP/tns:Descrizione"/&gt;&lt;/tns:Descrizione&gt;&lt;/tns:VerificaVPResponse&gt;&lt;/output&gt;&lt;/tns1:VerificaVPResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
