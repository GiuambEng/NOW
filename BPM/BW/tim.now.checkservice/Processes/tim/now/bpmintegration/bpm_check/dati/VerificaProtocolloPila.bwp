                                tibex:group="groupStart" tibex:xpdlId="5a593b41-8f0d-4420-937f-175723224e9a">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="f83cd47c-ecde-498a-bda0-6c815533bbbf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
