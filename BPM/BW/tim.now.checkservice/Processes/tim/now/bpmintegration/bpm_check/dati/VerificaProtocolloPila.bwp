                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+97e37fe9-ef11-4de4-a7a4-1985f101b97f+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaProtocolloPila&quot;/>&lt;xsl:template name=&quot;GetProtocolloPila-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDASSET>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:IDAsset)&quot;>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:IDAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDASSET>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
