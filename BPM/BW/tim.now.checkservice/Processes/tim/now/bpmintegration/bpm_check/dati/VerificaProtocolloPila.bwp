>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Verifica_Protocollo_Pila_SUB_PROCESSED_&amp;quot;, $VerificaProtocolloPila.input/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;                &lt;tns:Playload>&#xa;                    &lt;tns:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaProtocolloPila.input)))&quot;/>&#xa;                    &lt;/tns:Binary>&#xa;                    &lt;tns:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VerificaProtocolloPila.input, true(), true())&quot;/>&#xa;                    &lt;/tns:XMLString>&#xa;                &lt;/tns:Playload>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
