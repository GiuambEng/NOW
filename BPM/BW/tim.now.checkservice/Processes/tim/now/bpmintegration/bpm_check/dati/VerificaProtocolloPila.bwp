ect=&quot;$VerificaProtocolloPila.input/tns:IDRisorsa&quot;/>&#xa;                &lt;/tns:IDRisorsa>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaProtocolloPila.input/tns:Offerta&quot;>&#xa;                &lt;tns:Offerta>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaProtocolloPila.input/tns:Offerta&quot;/>&#xa;                &lt;/tns:Offerta>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$VerificaProtocolloPila.input/tns:IDAsset&quot;>&#xa;                &lt;tns:IDAsset>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaProtocolloPila.input/tns:IDAsset&quot;/>&#xa;                &lt;/tns:IDAsset>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:for-each select=&quot;$VerificaProtocolloPila.input/tns:VC_VerificaProtocolloPila&quot;>&#xa;                &lt;tns:VC_VerificaProtocolloPila>&#xa;                    &lt;xsl:if test=&quot;tns:SVlanCode&quot;>&#xa;                        &lt;tns:SVlanCode>&#xa;                            &lt;xsl:value-of select=&quot;tns:SVlanCode&quot;/>&#xa;                        &lt;/tns:SVlanCode>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:CodeVlanSingleTag&quot;>&#xa;                        &lt;tns:CodeVlanSingleTag>&#xa;                            &lt;xsl:value-of select=&quot;tns:CodeVlanSingleTag&quot;/>&#xa;                        &lt;/tns:CodeVlanSingleTag>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($GetProtocolloPila/Record/VALOREATTRIBUTO)&quot;>&#xa;                            &lt;xsl:if test=&quot;$GetProtocolloPila/Record[1]/VALOREATTRIBUTO&quot;>&#xa;                                &lt;tns:ProtocolloPila>&#xa;                                    &lt;xsl:value-of select=&quot;$GetProtocolloPila/Record[1]/VALOREATTRIBUTO&quot;/>&#xa;                                &lt;/tns:ProtocolloPila>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:ProtocolloPila>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;IPoE&amp;quot;&quot;/>&#xa;                            &lt;/tns:ProtocolloPila>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;tns:TipologiaCos&quot;>&#xa;                        &lt;tns:TipologiaCos>&#xa;                            &lt;xsl:value-of select=&quot;tns:TipologiaCos&quot;/>&#xa;                        &lt;/tns:TipologiaCos>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:TipoBanda&quot;>&#xa;                        &lt;tns:TipoBanda>&#xa;                            &lt;xsl:value-of select=&quot;tns:TipoBanda&quot;/>&#xa;                        &lt;/tns:TipoBanda>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:TipologiaEncapsulation&quot;>&#xa;                        &lt;tns:TipologiaEncapsulation>&#xa;                            &lt;xsl:value-of select=&quot;tns:TipologiaEncapsulation&quot;/>&#xa;                        &lt;/tns:TipologiaEncapsulation>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:BMD&quot;>&#xa;                        &lt;tns:BMD>&#xa;                            &lt;xsl:value-of select=&quot;tns:BMD&quot;/>&#xa;                        &lt;/tns:BMD>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                    &lt;/tns:IDDettaglioOrdine>&#xa;                    &lt;xsl:if test=&quot;tns:VPI&quot;>&#xa;                        &lt;tns:VPI>&#xa;                            &lt;xsl:value-of select=&quot;tns:VPI&quot;/>&#xa;                        &lt;/tns:VPI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns:VCI&quot;>&#xa;                        &lt;tns:VCI>&#xa;                            &lt;xsl:value-of select=&quot;tns:VCI&quot;/>&#xa;                        &lt;/tns:VCI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:VC_VerificaProtocolloPila>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:VerificaProtocolloPilaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
