                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerProtoco&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperInput&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaProtocolloPilaO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaProtocolloPilaResponse>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;$VerProtoco/tns1:Codice&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;tns1:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;$VerProtoco/tns1:Descrizione&quot;/>&#xa;            &lt;/tns1:Descrizione>&#xa;            &lt;xsl:copy-of select=&quot;$VerProtoco/tns1:ProtocolloPila&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MapperInput/tns3:VC_VerificaProtocolloPila&quot;>&#xa;                        &lt;tns1:UservlanVC>&#xa;                            &lt;xsl:if test=&quot;string-length(tns3:ProtocolloPila) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns3:ProtocolloPila&quot;>&#xa;                                    &lt;tns2:ProtocolloPilaDefault>&#xa;                                        &lt;xsl:value-of select=&quot;tns3:ProtocolloPila&quot;/>&#xa;                                    &lt;/tns2:ProtocolloPilaDefault>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;    