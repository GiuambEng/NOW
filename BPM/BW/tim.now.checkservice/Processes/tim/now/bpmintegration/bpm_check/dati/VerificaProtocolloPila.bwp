                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select VALOREATTRIBUTO &#xa;from BDS_1_CASEDATA_ATTRIBTDTTGLSST&#xa;where NOMEATTRIBUTO = 'PROTOCOLLOPILA' and IDASSET = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

