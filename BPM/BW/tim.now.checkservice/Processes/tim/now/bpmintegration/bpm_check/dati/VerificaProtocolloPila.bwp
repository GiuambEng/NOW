            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+98c1a951-bc39-4335-8b4c-ebadd4b41eb9+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaProtocolloPila&quot;/>&lt;xsl:template name=&quot;JDBC_ProtocolloPila-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDASSET>&lt;xsl:value-of select=&quot;xsd:integer($VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:IDAsset)&quot;/>&lt;/IDASSET>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:CodiceOLOAGCOM) > 0&quot;>&lt;CODIFICAOLOAGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:CodiceOLOAGCOM)&quot;>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:CodiceOLOAGCOM&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODIFICAOLOAGCOM>&lt;/xsl:when>&lt;xsl:otherwise>&lt;CODIFICAOLOAGCOM xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;NOMEATTRIBUTO>&lt;xsl:value-of select=&quot;&amp;quot;PROTOCOLLOPILA&amp;quot;&quot;/>&lt;/NOMEATTRIBUTO>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBC_ProtocolloPila-input"
                    name="JDBC_ProtocolloPila"
                    outputVariable="JDBC_ProtocolloPila"
                    tibex:xpdlId="98c1a951-bc39-4335-8b4c-ebadd4b41eb9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputVerificaProtocolloPilaToJDBC_VARIAZIONEASIMMETRICOFLAT"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToMapperInput"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+98c1a951-bc39-4335-8b4c-ebadd4b41eb9+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaProtocolloPila.input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBC_ProtocolloPila-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDASSET>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($VerificaProtocolloPila.input/tns1:IDAsset)&quot;/>&#xa;            &lt;/IDASSET>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaProtocolloPila.input/tns1:CodiceOLOAGCOM) > 0&quot;>&#xa;                    &lt;CODIFICAOLOAGCOM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaProtocolloPila.input/tns1:CodiceOLOAGCOM)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaProtocolloPila.input/tns1:CodiceOLOAGCOM&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODIFICAOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODIFICAOLOAGCOM xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;NOMEATTRIBUTO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;PROTOCOLLOPILA&amp;quot;&quot;/>&#xa;            &lt;/NOMEATTRIBUTO>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="JDBCTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ATT.NOMEATTRIBUTO, ATT.VALOREATTRIBUTO&#xa;FROM BDS_1_CASEDATA_ASSET ASS, BDS_1_CASEDATA_DETTAGLIOASSET DETT, BDS_1_CASEDATA_ATTRIBTDTTGLSST ATT&#xa;WHERE ASS.IDASSET = ? AND ASS.CODIFICAOLOAGCOM = ? AND ASS.BDS_ID = DETT.ASSET_DETTAGLIOASSET_BDSID AND&#xa;DETT.BDS_ID = ATT.DTTGLSST_TTRBTIDTTGLISST_BDSID AND ATT.NOMEATTRIBUTO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDASSET"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOMEATTRIBUTO"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
