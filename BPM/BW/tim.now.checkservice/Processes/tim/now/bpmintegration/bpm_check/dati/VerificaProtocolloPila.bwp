                        </bpws:source>
                        <bpws:source linkName="LogInputVerificaProtocolloPilaToWhile1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaProtocolloPila/input/ns9:VerificaProtocolloPilaRequest/ns9:Lavorazione = &quot;VARIAZIONE&quot; and $VerificaProtocolloPila/input/ns9:VerificaProtocolloPilaRequest/ns9:Offerta != 'BITSTREAMGBEASIMMETRICOFLAT'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$VerificaProtocolloPila.input/ns9:Lavorazione = "VARIAZIONE" and $VerificaProtocolloPila.input/ns9:Offerta != 'BITSTREAMGBEASIMMETRICOFLAT']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaProtocolloPila.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInputVerificaProtocolloPila-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaProtocolloPila&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaProtocolloPila&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaProtocolloPila.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaProtocolloPila.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input: &amp;quot;, tib:render-xml($VerificaProtocolloPila.input, true(), true()))&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaProtocolloPila&quot;/>&lt;xsl:param name=&quot;Accumulate&quot;/>&lt;xsl:param name=&quot;JDBC_ProtocolloPila&quot;/>&lt;xsl:template name=&quot;MapperInput-input&quot; match=&quot;/&quot;>&lt;tns:ProtocolloPilaRequest>&lt;xsl:for-each select=&quot;$VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:VC_VerificaProtocolloPila&quot;>&lt;tns:VC_VerificaProtocolloPila>&lt;xsl:if test=&quot;tns1:SVlanCode&quot;>&lt;tns:SVlanCode>&lt;xsl:value-of select=&quot;tns1:SVlanCode&quot;/>&lt;/tns:SVlanCode>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:CodeVlanSingleTag&quot;>&lt;tns:CodeVlanSingleTag>&lt;xsl:value-of select=&quot;tns1:CodeVlanSingleTag&quot;/>&lt;/tns:CodeVlanSingleTag>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;../tns1:Lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;../tns1:Offerta = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;upper-case(tns1:TipologiaEncapsulation) = &amp;quot;N&amp;quot;&quot;>&lt;tns:ProtocolloPila>&lt;xsl:value-of select=&quot;&amp;quot;PPP&amp;quot;&quot;/>&lt;/tns:ProtocolloPila>&lt;/xsl:when>&lt;xsl:when test=&quot;upper-case(tns1:TipologiaEncapsulation) = &amp;quot;Y&amp;quot;  and $JDBC_ProtocolloPila/Record[1]/VALOREATTRIBUTO = &amp;quot;IPoA&amp;quot;&quot;>&lt;tns:ProtocolloPila>&lt;xsl:value-of select=&quot;&amp;quot;IPoA&amp;quot;&quot;/>&lt;/tns:ProtocolloPila>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ProtocolloPila>&lt;xsl:value-of select=&quot;&amp;quot;IPoE&amp;quot;&quot;/>&lt;/tns:ProtocolloPila>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Accumulate/tns1:VerificaProtocolloPilaRequest[1]/tns1:VC_VerificaProtocolloPila[1]/tns1:ProtocolloPila&quot;>&lt;tns:ProtocolloPila>&lt;xsl:value-of select=&quot;$Accumulate/tns1:VerificaProtocolloPilaRequest[1]/tns1:VC_VerificaProtocolloPila[1]/tns1:ProtocolloPila&quot;/>&lt;/tns:ProtocolloPila>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:ProtocolloPila)>0&quot;>&lt;xsl:if test=&quot;tns1:ProtocolloPila&quot;>&lt;tns:ProtocolloPila>&lt;xsl:value-of select=&quot;tns1:ProtocolloPila&quot;/>&lt;/tns:ProtocolloPila>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(tns1:CodeVlanSingleTag) > 0&quot;>&lt;tns:ProtocolloPila>&lt;xsl:value-of select=&quot;&amp;quot;PPP&amp;quot;&quot;/>&lt;/tns:ProtocolloPila>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:ProtocolloPila>&lt;xsl:value-of select=&quot;&amp;quot;IPoE&amp;quot;&quot;/>&lt;/tns:ProtocolloPila>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:TipologiaCos>&lt;xsl:value-of select=&quot;tns1:TipoBanda&quot;/>&lt;/tns:TipologiaCos>&lt;tns:TipologiaEncapsulation>&lt;xsl:value-of select=&quot;tns1:TipologiaEncapsulation&quot;/>&lt;/tns:TipologiaEncapsulation>&lt;tns:BMD>&lt;xsl:value-of select=&quot;tns1:BMD&quot;/>&lt;/tns:BMD>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns1:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;xsl:if test=&quot;tns1:VPI&quot;>&lt;tns:VPI>&lt;xsl:value-of select=&quot;tns1:VPI&quot;/>&lt;/tns:VPI>&lt;/xsl:if>&lt;xsl:if test=&quot;tns1:VCI&quot;>&lt;tns:VCI>&lt;xsl:value-of select=&quot;tns1:VCI&quot;/>&lt;/tns:VCI>&lt;/xsl:if>&lt;/tns:VC_VerificaProtocolloPila>&lt;/xsl:for-each>&lt;/tns:ProtocolloPilaRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperInput-input" name="MapperInput"
                    outputVariable="MapperInput"
                    tibex:xpdlId="dd7136bb-8a5f-46d8-8949-e2fd6df8bdaa" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInputVerificaProtocolloPilaToMapper"/>
                        <bpws:target linkName="JDBCQueryToMapperInput"/>
                        <bpws:target linkName="While1ToMapperInput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperInputToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaProtocolloPila.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_ProtocolloPila&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ProtocolloPilaRequest>&#xa;            &lt;xsl:for-each select=&quot;$VerificaProtocolloPila.input/tns1:VC_VerificaProtocolloPila&quot;>&#xa;                &lt;tns:VC_VerificaProtocolloPila>&#xa;                    &lt;xsl:if test=&quot;tns1:SVlanCode&quot;>&#xa;                        &lt;tns:SVlanCode>&#xa;                            &lt;xsl:value-of select=&quot;tns1:SVlanCode&quot;/>&#xa;                        &lt;/tns:SVlanCode>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:CodeVlanSingleTag&quot;>&#xa;                        &lt;tns:CodeVlanSingleTag>&#xa;                            &lt;xsl:value-of select=&quot;tns1:CodeVlanSingleTag&quot;/>&#xa;                        &lt;/tns:CodeVlanSingleTag>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;../tns1:Lavorazione = &amp;quot;VARIAZIONE&amp;quot;&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;../tns1:Offerta = &amp;quot;BITSTREAMGBEASIMMETRICOFLAT&amp;quot;&quot;>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;upper-case(tns1:TipologiaEncapsulation) = &amp;quot;N&amp;quot;&quot;>&#xa;                                            &lt;tns:ProtocolloPila>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;PPP&amp;quot;&quot;/>&#xa;                                            &lt;/tns:ProtocolloPila>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:when test=&quot;upper-case(tns1:TipologiaEncapsulation) = &amp;quot;Y&amp;quot;  and $JDBC_ProtocolloPila/Record[1]/VALOREATTRIBUTO = &amp;quot;IPoA&amp;quot;&quot;>&#xa;                                            &lt;tns:ProtocolloPila>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;IPoA&amp;quot;&quot;/>&#xa;                                            &lt;/tns:ProtocolloPila>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ProtocolloPila>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;IPoE&amp;quot;&quot;/>&#xa;                                            &lt;/tns:ProtocolloPila>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;$Accumulate/tns1:VerificaProtocolloPilaRequest[1]/tns1:VC_VerificaProtocolloPila[1]/tns1:ProtocolloPila&quot;>&#xa;                                        &lt;tns:ProtocolloPila>&#xa;                                            &lt;xsl:value-of select=&quot;$Accumulate/tns1:VerificaProtocolloPilaRequest[1]/tns1:VC_VerificaProtocolloPila[1]/tns1:ProtocolloPila&quot;/>&#xa;                                        &lt;/tns:ProtocolloPila>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length(tns1:ProtocolloPila)>0&quot;>&#xa;                                    &lt;xsl:if test=&quot;tns1:ProtocolloPila&quot;>&#xa;                                        &lt;tns:ProtocolloPila>&#xa;                                            &lt;xsl:value-of select=&quot;tns1:ProtocolloPila&quot;/>&#xa;                                        &lt;/tns:ProtocolloPila>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:choose>&#xa;                                        &lt;xsl:when test=&quot;string-length(tns1:CodeVlanSingleTag) > 0&quot;>&#xa;                                            &lt;tns:ProtocolloPila>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;PPP&amp;quot;&quot;/>&#xa;                                            &lt;/tns:ProtocolloPila>&#xa;                                        &lt;/xsl:when>&#xa;                                        &lt;xsl:otherwise>&#xa;                                            &lt;tns:ProtocolloPila>&#xa;                                                &lt;xsl:value-of select=&quot;&amp;quot;IPoE&amp;quot;&quot;/>&#xa;                                            &lt;/tns:ProtocolloPila>&#xa;                                        &lt;/xsl:otherwise>&#xa;                                    &lt;/xsl:choose>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:TipologiaCos>&#xa;                        &lt;xsl:value-of select=&quot;tns1:TipoBanda&quot;/>&#xa;                    &lt;/tns:TipologiaCos>&#xa;                    &lt;tns:TipologiaEncapsulation>&#xa;                        &lt;xsl:value-of select=&quot;tns1:TipologiaEncapsulation&quot;/>&#xa;                    &lt;/tns:TipologiaEncapsulation>&#xa;                    &lt;tns:BMD>&#xa;                        &lt;xsl:value-of select=&quot;tns1:BMD&quot;/>&#xa;                    &lt;/tns:BMD>&#xa;                    &lt;tns:IDDettaglioOrdine>&#xa;                        &lt;xsl:value-of select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                    &lt;/tns:IDDettaglioOrdine>&#xa;                    &lt;xsl:if test=&quot;tns1:VPI&quot;>&#xa;                        &lt;tns:VPI>&#xa;                            &lt;xsl:value-of select=&quot;tns1:VPI&quot;/>&#xa;                        &lt;/tns:VPI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:VCI&quot;>&#xa;                        &lt;tns:VCI>&#xa;                            &lt;xsl:value-of select=&quot;tns1:VCI&quot;/>&#xa;                        &lt;/tns:VCI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns:VC_VerificaProtocolloPila>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:ProtocolloPilaRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:BPM_CheckUtil="http://www.tim.com/NOW/xsd/BPM_CheckUtil"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="BPM_CheckUtil:ProtocolloPilaRequest" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="0e46e04b-a410-4c8c-a91a-d0565b202a91">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToLogVerificaProtocolloPilaOut"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($MapperInput/ns3:VC_VerificaProtocolloPila) and $VerProtoco/ns9:Codice = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($MapperInput/ns3:VC_VerificaProtocolloPila) and $VerProtoco/ns9:Codice = true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToJDBCQuery_MULTICOS"
                                    tibex:label="MULTICOS" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="GroupStartToJDBCQuery1_MONOCOS"
                                    tibex:label="MONOCOS" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="SelectPROTOCOLLOGBEToLogMonocosMulticos" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQuery1ToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogMonocosMulticosToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="VerProtocoResponseAssignToAccumulateOutput" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="64e33327-ebb8-43b0-8818-543be2264887">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery_MULTICOS">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToJDBCQuery1_MONOCOS">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="upper-case($MapperInput/ns3:VC_VerificaProtocolloPila[number($index)]/ns3:TipologiaCos) = &quot;MONOCOS&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[upper-case($MapperInput/ns3:VC_VerificaProtocolloPila[number($index)]/ns3:TipologiaCos) = "MONOCOS"]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="eca49256-a252-4a2d-a1ea-4d04af11303e">
                                <bpws:targets>
                                    <bpws:target linkName="VerProtocoResponseAssignToAccumulateOutput"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaProtocolloPila&quot;/>&lt;xsl:param name=&quot;SelectPROTOCOLLOGBE&quot;/>&lt;xsl:param name=&quot;SelectPROTOCOLLOGBEMonocos&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:template name=&quot;LogMonocosMulticos-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.bpm_check.dati'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaProtocolloPila&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaProtocolloPila&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns1:VerificaProtocolloPilaRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($SelectPROTOCOLLOGBEMonocos/Record[1]/PROTOCOLLO_GBE) >0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Monocos: &amp;quot;, $SelectPROTOCOLLOGBEMonocos/Record[1]/PROTOCOLLO_GBE)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Multicos: &amp;quot;, $SelectPROTOCOLLOGBE/Record[1]/PROTOCOLLO_GBE)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:ch