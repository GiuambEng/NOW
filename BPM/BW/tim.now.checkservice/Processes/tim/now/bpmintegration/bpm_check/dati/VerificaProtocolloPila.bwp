                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaProtocolloPila.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPROTOCOLLOGBE&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperInput&quot;/>&#xa;    &lt;xsl:param name=&quot;VerProtoco&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectPROTOCOLLOGBEMonocos&quot;/>&#xa;    &lt;xsl:template name=&quot;VerProtoco&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VerificaProtocolloPila.input/tns:Lavorazione=&amp;quot;VARIAZIONE&amp;quot; and $VerificaProtocolloPila.input/tns:Offerta=&amp;quot;BITSTREAMGBESIMMETRICOFLAT&amp;quot;&quot;>&#xa;                &lt;tns:VerificaProtocolloPilaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                    &lt;xsl:copy-of select=&quot;$VerProtoco/tns:ProtocolloPila&quot;/>&#xa;                    &lt;tns:ProtocolloPila>&#xa;                        &lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;>&#xa;                            &lt;tns:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns:IDDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;>&#xa;                            &lt;tns:ProtocolloPilaDefault>&#xa;                                &lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;/>&#xa;                            &lt;/tns:ProtocolloPilaDefault>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:ProtocolloPila>&#xa;                &lt;/tns:VerificaProtocolloPilaResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($SelectPROTOCOLLOGBE/Record[1]/PROTOCOLLO_GBE) > 0 and (exists($SelectPROTOCOLLOGBE/Record[PROTOCOLLO_GBE = $MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila])) or ($MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila = &amp;quot;PPP&amp;quot; and exists($SelectPROTOCOLLOGBE/Record[PROTOCOLLO_GBE = &amp;quot;PPPoE&amp;quot; or PROTOCOLLO_GBE = &amp;quot;PPPoA&amp;quot;]))&quot;>&#xa;                &lt;tns:VerificaProtocolloPilaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                    &lt;xsl:copy-of select=&quot;$VerProtoco/tns:ProtocolloPila&quot;/>&#xa;                    &lt;tns:ProtocolloPila>&#xa;                        &lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;>&#xa;                            &lt;tns:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns:IDDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;>&#xa;                            &lt;tns:ProtocolloPilaDefault>&#xa;                                &lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;/>&#xa;                            &lt;/tns:ProtocolloPilaDefault>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:ProtocolloPila>&#xa;                &lt;/tns:VerificaProtocolloPilaResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($SelectPROTOCOLLOGBEMonocos/Record[1]/PROTOCOLLO_GBE) >0 and (exists($SelectPROTOCOLLOGBEMonocos/Record[PROTOCOLLO_GBE = $MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila])) or ($MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila = &amp;quot;PPP&amp;quot; and exists($SelectPROTOCOLLOGBEMonocos/Record[PROTOCOLLO_GBE = &amp;quot;PPPoE&amp;quot; or PROTOCOLLO_GBE = &amp;quot;PPPoA&amp;quot;]))&quot;>&#xa;                &lt;tns:VerificaProtocolloPilaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                    &lt;xsl:copy-of select=&quot;$VerProtoco/tns:ProtocolloPila&quot;/>&#xa;                    &lt;tns:ProtocolloPila>&#xa;                        &lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;>&#xa;                            &lt;tns:IDDettaglioOrdine>&#xa;                                &lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;/>&#xa;                            &lt;/tns:IDDettaglioOrdine>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;>&#xa;                            &lt;tns:ProtocolloPilaDefault>&#xa;                                &lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;/>&#xa;                            &lt;/tns:ProtocolloPilaDefault>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns:ProtocolloPila>&#xa;                &lt;/tns:VerificaProtocolloPilaResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VerificaProtocolloPilaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaProtocolloPilaResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
