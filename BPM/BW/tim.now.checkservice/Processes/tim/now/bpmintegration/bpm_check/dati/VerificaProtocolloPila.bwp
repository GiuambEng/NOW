                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaProtocolloPila.input&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperInput&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlliInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaProtocolloPila.input/tns2:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;xsl:for-each select=&quot;$MapperInput/tns3:VC_VerificaProtocolloPila&quot;>&#xa;                &lt;tns1:UservlanVC>&#xa;                    &lt;xsl:if test=&quot;string-length(tns3:ProtocolloPila) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns3:ProtocolloPila&quot;>&#xa;                            &lt;tns1:ProtocolloPilaDefault>&#xa;                                &lt;xsl:value-of select=&quot;tns3:ProtocolloPila&quot;/>&#xa;                            &lt;/tns1:ProtocolloPilaDefault>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns3:VCI) > 0&quot;>&#xa;                        &lt;xsl:if tes