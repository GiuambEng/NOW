ngth($SelectPROTOCOLLOGBE/Record[1]/PROTOCOLLO_GBE) > 0 and (exists($SelectPROTOCOLLOGBE/Record[PROTOCOLLO_GBE = $MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila])) or ($MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila = &amp;quot;PPP&amp;quot; and exists($SelectPROTOCOLLOGBE/Record[PROTOCOLLO_GBE = &amp;quot;PPPoE&amp;quot; or PROTOCOLLO_GBE = &amp;quot;PPPoA&amp;quot;]))&quot;>&lt;tns:VerificaProtocolloPilaResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;xsl:copy-of select=&quot;$VerProtoco/tns:ProtocolloPila&quot;/>&lt;tns:ProtocolloPila>&lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;>&lt;tns:ProtocolloPilaDefault>&lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;/>&lt;/tns:ProtocolloPilaDefault>&lt;/xsl:if>&lt;/tns:ProtocolloPila>&lt;/tns:VerificaProtocolloPilaResponse>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($SelectPROTOCOLLOGBEMonocos/Record[1]/PROTOCOLLO_GBE) >0 and (exists($SelectPROTOCOLLOGBEMonocos/Record[PROTOCOLLO_GBE = $MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila])) or ($MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila = &amp;quot;PPP&amp;quot; and exists($SelectPROTOCOLLOGBEMonocos/Record[PROTOCOLLO_GBE = &amp;quot;PPPoE&amp;quot; or PROTOCOLLO_GBE = &amp;quot;PPPoA&amp;quot;]))&quot;>&lt;tns:VerificaProtocolloPilaResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;xsl:copy-of select=&quot;$VerProtoco/tns:ProtocolloPila&quot;/>&lt;tns:ProtocolloPila>&lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;/xsl:if>&lt;xsl:if test=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;>&lt;tns:ProtocolloPilaDefault>&lt;xsl:value-of select=&quot;$MapperInput/tns2:VC_VerificaProtocolloPila[number($index)]/tns2:ProtocolloPila&quot;/>&lt;/tns:ProtocolloPilaDefault>&lt;/xsl:if>&lt;/tns:ProtocolloPila>&lt;/tns:VerificaProtocolloPilaResponse>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaProtocolloPilaResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaProtocolloPilaResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
