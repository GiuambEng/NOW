                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaProtocolloPila&quot;/>&lt;xsl:param name=&quot;GetProtocolloPila&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:VerificaProtocolloPilaRequest>&lt;xsl:if test=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:IDRichiestaOLO&quot;>&lt;tns:IDRichiestaOLO>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:IDRichiestaOLO&quot;/>&lt;/tns:IDRichiestaOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:CodiceOrdineOLO&quot;>&lt;tns:CodiceOrdineOLO>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:CodiceOrdineOLO&quot;/>&lt;/tns:CodiceOrdineOLO>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:CodiceOLOAGCOM&quot;>&lt;tns:CodiceOLOAGCOM>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:CodiceOLOAGCOM&quot;/>&lt;/tns:CodiceOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:Lavorazione&quot;>&lt;tns:Lavorazione>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:Lavorazione&quot;/>&lt;/tns:Lavorazione>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:IDRisorsa&quot;>&lt;tns:IDRisorsa>&lt;xsl:value-of select=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaRequest/tns:IDRisorsa&quot;/>&lt;/tns:IDRisorsa>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaProtocolloPila/input/tns:VerificaProtocolloPilaReq