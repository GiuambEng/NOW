                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/GetNextDateService&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GetNextDate&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/DeterminaCasoComplesso/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaDACSLAIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;IsComplex&quot;/>&#xa;    &lt;xsl:template name=&quot;calcNextDateByDuration2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:Request>&#xa;            &lt;tns3:inputDate>&#xa;                &lt;xsl:value-of select=&quot;$VerificaDACSLAIn.parameters/tns:DRO&quot;/>&#xa;            &lt;/tns3:inputDate>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$IsComplex = true()&quot;>&#xa;                    &lt;tns3:GiorniLavorativi>&#xa;                        &lt;xsl:value-of select=&quot;13&quot;/>&#xa;                    &lt;/tns3:GiorniLavorativi>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns3:GiorniLavorativi>&#xa;                        &lt;xsl:value-of select=&quot;8&quot;/>&#xa;                    &lt;/tns3:GiorniLavorativi>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
