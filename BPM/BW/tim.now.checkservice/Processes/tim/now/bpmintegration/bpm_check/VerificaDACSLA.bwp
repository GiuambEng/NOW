                        <bpws:source linkName="LogOutputQueryDACSLAToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Lavorazione = &quot;ATTIVAZIONE&quot; and $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Servizio =&quot;NP&quot; )and ((string-length($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario)>0 and $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario != &quot;NPSUNP&quot; and  $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario != &quot;NPSUSLUNP&quot; and $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario != &quot;NPSUULLNP&quot; and $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario != &quot;NPSUULLDNP&quot;) or string-length($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario)=0) and string-length($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:FlagDelibera103)=0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($VerificaDACSLAIn.parameters/tns:Lavorazione = "ATTIVAZIONE" and $VerificaDACSLAIn.parameters/tns:Servizio ="NP" )and ((string-length($VerificaDACSLAIn.parameters/tns:Scenario)>0 and $VerificaDACSLAIn.parameters/tns:Scenario != "NPSUNP" and  $VerificaDACSLAIn.parameters/tns:Scenario != "NPSUSLUNP" and $VerificaDACSLAIn.parameters/tns:Scenario != "NPSUULLNP" and $VerificaDACSLAIn.parameters/tns:Scenario != "NPSUULLDNP") or string-length($VerificaDACSLAIn.parameters/tns:Scenario)=0) and string-length($VerificaDACSLAIn.parameters/tns:FlagDelibera103)=0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOutputQueryDACSLAToInvoke_NPSUNPoMigIntraOLO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:MigrazioneIntraOlo=&quot;SI&quot; and (starts-with(upper-case($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Servizio),&quot;SLU&quot;) or starts-with(upper-case($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Servizio),&quot;ULL&quot;) and not(starts-with(upper-case($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Servizio),&quot;ULLDATI&quot;))) ) or ($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Lavorazione = &quot;ATTIVAZIONE&quot; and $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Servizio =&quot;NP&quot; and (string-length($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario)>0 and ($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario = &quot;NPSUNP&quot; or  $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario = &quot;NPSUSLUNP&quot; or $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario = &quot;NPSUULLNP&quot; or $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Scenario = &quot;NPSUULLDNP&quot;)) and string-length($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:FlagDelibera103)=0)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[($VerificaDACSLAIn.parameters/tns:MigrazioneIntraOlo="SI" and (starts-with(upper-case($VerificaDACSLAIn.parameters/tns:Servizio),"SLU") or starts-with(upper-case($VerificaDACSLAIn.parameters/tns:Servizio),"ULL") and not(starts-with(upper-case($VerificaDACSLAIn.parameters/tns:Servizio),"ULLDATI"))) ) or ($VerificaDACSLAIn.parameters/tns:Lavorazione = "ATTIVAZIONE" and $VerificaDACSLAIn.parameters/tns:Servizio ="NP" and (string-length($VerificaDACSLAIn.parameters/tns:Scenario)>0 and ($VerificaDACSLAIn.parameters/tns:Scenario = "NPSUNP" or  $VerificaDACSLAIn.parameters/tns:Scenario = "NPSUSLUNP" or $VerificaDACSLAIn.parameters/tns:Scenario = "NPSUULLNP" or $VerificaDACSLAIn.parameters/tns:Scenario = "NPSUULLDNP")) and string-length($VerificaDACSLAIn.parameters/tns:FlagDelibera103)=0)]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogInputToAssignComplex1_NPDel103">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Lavorazione = 'ATTIVAZIONE' and $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:Servizio = 'NP' and string-length($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:FlagDelibera103)>0 and $VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:FlagDelibera103 = 'Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
