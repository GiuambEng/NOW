            <bpws:empty name="CheckSottoLav" tibex:xpdlId="b06dd781-3b12-4d21-a123-89eec428f2c4">
                <bpws:targets>
                    <bpws:target linkName="LogOutputQueryDACSLAToCheckSottoLav"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckSottoLavToSelectDACSLASottoLav_SISottoLav">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:SottoLavorazione) and string-length($VerificaDACSLAIn/parameters/ns1:VerificaDACSLA/tns:SottoLavorazione) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($VerificaDACSLAIn.parameters/tns:SottoLavorazione) and string-length($VerificaDACSLAIn.parameters/tns:SottoLavorazione) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckSottoLavToSelectDACSLA_NOSottoLav">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f3c8de90-db34-487a-a4d6-b877deb13d0a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaDACSLAIn&quot;/>&lt;xsl:template name=&quot;SelectDACSLASottoLav-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;tipolgLavrz1>&lt;xsl:value-of select=&quot;$VerificaDACSLAIn/parameters/tns2:VerificaDACSLA/tns1:Lavorazione&quot;/>&lt;/tipolgLavrz1>&lt;sottoLavrz>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaDACSLAIn/parameters/tns2:VerificaDACSLA/tns1:SottoLavorazione)&quot;>&lt;xsl:value-of select=&quot;$VerificaDACSLAIn/parameters/tns2:VerificaDACSLA/tns1:SottoLavorazione&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/sottoLavrz>&lt;tipolgLavrz2>&lt;xsl:value-of select=&quot;$VerificaDACSLAIn/parameters/tns2:VerificaDACSLA/tns1:Lavorazione&quot;/>&lt;/tipolgLavrz2>&lt;offerta>&lt;xsl:value-of select=&quot;$VerificaDACSLAIn/parameters/tns2:VerificaDACSLA/tns1:Servizio&quot;/>&lt;/offerta>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectDACSLASottoLav-input"
                    name="SelectDACSLASottoLav"
                    outputVariable="SelectDACSLASottoLav"
                    tibex:xpdlId="f3c8de90-db34-487a-a4d6-b877deb13d0a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckSottoLavToSelectDACSLASottoLav_SISottoLav"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectDACSLASottoLavToLogSLA"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+f3c8de90-db34-487a-a4d6-b877deb13d0a+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaDACSLAIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectDACSLASottoLav-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;tipolgLavrz1>&#xa;                &lt;xsl:value-of select=&quot;$VerificaDACSLAIn.parameters/tns1:Lavorazione&quot;/>&#xa;            &lt;/tipolgLavrz1>&#xa;            &lt;sottoLavrz>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaDACSLAIn.parameters/tns1:SottoLavorazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaDACSLAIn.parameters/tns1:SottoLavorazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/sottoLavrz>&#xa;            &lt;tipolgLavrz2>&#xa;                &lt;xsl:value-of select=&quot;$VerificaDACSLAIn.parameters/tns1:Lavorazione&quot;/>&#xa;            &lt;/tipolgLavrz2>&#xa;            &lt;offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaDACSLAIn.parameters/tns1:Servizio&quot;/>&#xa;            &lt;/offerta>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SLA&#xa;FROM SLA_ORDN S, TRASCODFC_OFFERTA TF&#xa;WHERE S.idtplg_lavrz = (SELECT TL2.idtplg_lavrz FROM tipolg_lavrz TL2 WHERE TL2.tipolg_lavrz = ?)&#xa;  AND S.idtplg_sotto_lavrz =(&#xa;            SELECT SL2.idtplg_sotto_lavrz FROM tipolg_sotto_lavrz SL2 WHERE SL2.descr = ? AND SL2.idtplg_lavrz =(&#xa;                SELECT TL3.idtplg_lavrz FROM tipolg_lavrz TL3 WHERE TL3.tipolg_lavrz = ?))&#xa;  AND S.id_offerta = TF.id_offerta AND TF.nome_offerta_esterna = ? AND TF.provenienza = 'BPM'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipolgLavrz1"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="sottoLavrz"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="tipolgLavrz2"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="offerta"/>
                                    <columnMetadata columnName="SLA"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="SLA"
                    name="AssignSLA" outputVariable="SLA"
                    tibex:xpdlId="22727a74-7f67-4a15-912b-0070071ead84" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogSLAToAssignSLA_ifRecordExists"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignSLAToVerificaDACSLAResponseAssign">
                            <tibex:DesignExpression>
                                <tibex:expression expression="$SLA = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$SLA = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="AssignSLATocalcNextDateByDuration1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if(count($SelectDACSLA/Record) > 0) then xsd:int($SelectDACSLA/Record[1]/SLA) else xsd:int($SelectDACSLASottoLav/Record[1]/SLA)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="SLA" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;SelectDACSLA&quot;/>&lt;xsl:param name=&quot;VerificaDACSLAIn&quot;/>&lt;xsl:param name=&quot;SelectDACSLASottoLav&quot;/>&lt;xsl:template name=&quot;LogSLA-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaDACSLA&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaDACSLA&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaDACSLAIn/parameters/tns2:VerificaDACSLA/tns1:IDRichiesta&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaDACSLAIn/parameters/tns2:VerificaDACSLA/tns1:IDRichiesta&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($SelectDACSLA/Record) > 0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Risultati Query: ', tib:render-xml($SelectDACSLA, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectDACSLASottoLav/Record) > 0&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat('Risultati Query: ', tib:render-xml($SelectDACSLASottoLav, true(), true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;'Nessun record recuperato.'&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogSLA-input" name="LogSLA"
                    tibex:xpdlId="bdfc1d76-b35f-4217-9c05-8558ff085c5b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectDACSLASottoLavToLogSLA"/>
                        <bpws:target linkName="SelectDACSLAToLogSLA"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogSLAToAssignSLA_ifRecordExists">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SelectDACSLA/Record) > 0 or count($SelectDACSLASottoLav/Record) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SelectDACSLA/Record) > 0 or count($SelectDACSLASottoLav/Record) > 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogSLAToAssignDACSLA_NoRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaDACSLAIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectDACSLA&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectDACSLASottoLav&quot;/>&#xa;    &lt;xsl:template name=&quot;LogSLA-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDACSLA&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaDACSLA&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaDACSLAIn.parameters/tns1:IDRichiesta&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaDACSLAIn.parameters/tns1:IDRichiesta&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectDACSLA/Record) > 0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultati Query: ', tib:render-xml($SelectDACSLA, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($SelectDACSLASottoLav/Record) > 0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultati Query: ', tib:render-xml($SelectDACSLASottoLav, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;'Nessun record recuperato.'&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="a5c7b738-6591-4a7c-af4c-3bfc43cbcac4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaDACSLAInToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="OscuramentoToLogInput_Oscurato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Oscuramento/Record[1]/FLAG_OSCURMENTO='1'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$Oscuramento/Record[1]/FLAG_OSCURMENTO='1']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="OscuramentoToGenericLogger_Nooscurato">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?> &lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+a5c7b738-6591-4a7c-af4c-3bfc43cbcac4+input&quot; version=&quot;2.0&quot;> &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;> &lt;tns:jdbcQueryActivityInput/> &lt;/xsl:template> &lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
