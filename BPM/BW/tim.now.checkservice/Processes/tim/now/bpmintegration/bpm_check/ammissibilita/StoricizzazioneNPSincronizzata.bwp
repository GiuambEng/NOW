                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Lista DN flag numerazioni aggiuntive dopo DIOGENE: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ListaDN,true(),true())&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="WhileCaso2" tibex:group="while" tibex:xpdlId="6fd0ba9f-9dba-42d0-9ffe-b70c3fd1a395">
                <bpws:targets>
                    <bpws:target linkName="LogListaAggToWhileCaso2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileCaso2ToListaDNAtt274"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+d22da2bc-b43b-4932-b035-69526c7440c4" version="2.0"> <xsl:template name="AccumulateCaso2" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="AccumulateCaso2"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="WhileCaso2" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($ListaDN/ns17:DN_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($ListaDN/ns17:DN_flag)]]></bpws:condition>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStart1ToDistrettoATT274" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="DistrettoATT274ToLogDistr" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogDistrToDIOGENE" tibex:linkType="SUCCESS"/>
                                <bpws:link name="DIOGENEToLogDIOG" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogDNflagToAccumulateCaso2" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogDIOGToMapperCaso2DNflag" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="MapperCaso2DNflagToLogDNflag" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="92697332-a99a-49e3-9303-7c23f4a630dc">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToDistrettoATT274"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="AccumulateCaso2"
                                    outputVariable="AccumulateCaso2"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="d22da2bc-b43b-4932-b035-69526c7440c4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogDNflagToAccumulateCaso2"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperCaso2DNflag</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogDNflag-input"
                                    name="LogDNflag"
                                    tibex:xpdlId="3b778374-2cc8-41f7-8684-a01b7ca0752b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperCaso2DNflagToLogDNflag"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogDNflagToAccumulateCaso2"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperCaso2DNflag&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDNflag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DN flag dopo DIOGENE: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($MapperCaso2DNflag, true(),true())&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogDIOG-input"
                                    name="LogDIOG"
                                    tibex:xpdlId="e896035b-07b6-460c-a3f1-e1752c2d2ee2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DIOGENEToLogDIOG"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogDIOGToMapperCaso2DNflag"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;DIOGENE&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Arco di numerazione DIOGENE determinato  per numero &amp;quot;, $ListaDN/tns:DN_flag[number($index)]/tns:DN,&amp;quot; : &amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;$DIOGENE/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns3:Payload>&#xa;                        &lt;xsl:value-of select=&quot;$DIOGENE/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns3:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="DIOGENE-input"
                                    name="DIOGENE"
                                    outputVariable="DIOGENE"
                                    tibex:xpdlId="00cf27dd-68ea-4b36-87f5-ebcd8e8e9020" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogDistrToDIOGENE"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DIOGENEToLogDIOG"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:ns0=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+00cf27dd-68ea-4b36-87f5-ebcd8e8e9020+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;ns0:jdbcQueryActivityInput>&#xa;            &lt;COD_DISTRETTO>&#xa;                &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;            &lt;/COD_DISTRETTO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:value-of select=&quot;substring($ListaDN/tns:DN_flag[number($index)]/tns:DN, 3)&quot;/>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:value-of select=&quot;substring-after($ListaDN/tns:DN_flag[number($index)]/tns:DN, $Distretto)&quot;/>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;COUNT_1>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring($ListaDN/tns:DN_flag[number($index)]/tns:DN,3))&quot;/>&#xa;                    &lt;/COUNT_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COUNT_1>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring-after($ListaDN/tns:DN_flag[number($index)]/tns:DN, $Distretto))&quot;/>&#xa;                    &lt;/COUNT_1>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;COUNT_2>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring($ListaDN/tns:DN_flag[number($index)]/tns:DN, 3))&quot;/>&#xa;                    &lt;/COUNT_2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COUNT_2>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring-after($ListaDN/tns:DN_flag[number($index)]/tns:DN, $Distretto))&quot;/>&#xa;                    &lt;/COUNT_2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:Data_Invio_Rich)&quot;>&#xa;                    &lt;DATA_INVIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:Data_Invio_Rich)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:Data_Invio_Rich&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DATA_INVIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATA_INVIO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/ns0:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODFC_OLO_AGCOM&#xa;  FROM ARCHI_NUMRZNE_DIOGENE&#xa;  WHERE COD_DISTR = ? AND ? BETWEEN RPAD(ARCO_NUMRZNE_DA, ?, 0) AND RPAD(ARCO_NUMRZNE_A, ?, 9) AND (? BETWEEN DATAINZ_VALID AND DATAFI_VALID OR SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_DISTRETTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_2"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_INVIO"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogDistr-input"
                                    name="LogDistr"
                                    tibex:xpdlId="5eb6132a-e3ac-4c0c-8d15-11cf6b2bc0af"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DistrettoATT274ToLogDistr"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogDistrToDIOGENE"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Distretto determinato per numero &amp;quot;, $ListaDN/tns:DN_flag[number($index)]/tns:DN,&amp;quot; : &amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Distretto"
                                    name="DistrettoATT274"
                                    outputVariable="Distretto"
                                    tibex:xpdlId="3283d75c-5cc8-4262-88e1-fd46a6d22424" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToDistrettoATT274"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DistrettoATT274ToLogDistr"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if(substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 2, 1) = &quot;6&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 1, 2)) else if(substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;0&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;1&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;5&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;9&quot;) then substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 1, 3) else substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 2, 3)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Distretto" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="MapperCaso2DNflag-input"
                                    name="MapperCaso2DNflag"
                                    outputVariable="MapperCaso2DNflag"
                                    tibex:xpdlId="152605e7-d285-4ec2-817c-ab8e3b9fa984" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogDIOGToMapperCaso2DNflag"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperCaso2DNflagToLogDNflag"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;DIOGENE&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperCaso2DNflag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DN_flag>&#xa;            &lt;tns:DN>&#xa;                &lt;xsl:value-of select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:DN&quot;/>&#xa;            &lt;/tns:DN>&#xa;            &lt;xsl:if test=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:FlagAggiuntivo&quot;>&#xa;                &lt;tns:FlagAggiuntivo>&#xa;                    &lt;xsl:value-of select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:FlagAggiuntivo&quot;/>&#xa;                &lt;/tns:FlagAggiuntivo>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$DIOGENE/Record[1]/CODFC_OLO_AGCOM!=&amp;quot;TLC&amp;quot;&quot;>&#xa;                    &lt;tns:CasoNP>&#xa;                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                    &lt;/tns:CasoNP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:CasoNP>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/tns:CasoNP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$DIOGENE/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                &lt;tns:DonorDIOGENE>&#xa;                    &lt;xsl:value-of select=&quot;$DIOGENE/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/tns:DonorDIOGENE>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:DN_flag>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:NP_sincronizzata="http://www.tim.com/NOW/xsd/NP_sincronizzata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NP_sincronizzata:DN_flag" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Direzionalita-input"
                    name="Direzionalita" outputVariable="Direzionalita"
                    tibex:xpdlId="4ef51279-2be9-4323-8417-d6fa1b62933d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogListaNPToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToAggiuntiviWLR"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4ef51279-2be9-4323-8417-d6fa1b62933d+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Direzionalita-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IdAsset>&#xa;                &lt;xsl:value-of select=&quot;xsd:integer($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:ConsistenzaFonia/tns1:IDAsset)&quot;/>&#xa;            &lt;/IdAsset>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="&#x9;SELECT att.DTTGLSST_TTRBTIDTTGLISST_BDSID, dett.NOMECOMPONENTE, att.NOMEATTRIBUTO, att.VALOREATTRIBUTO, att.CREATED&#xa;&#x9;FROM BDS_1_CASEDATA_ASSET ass, BDS_1_CASEDATA_DETTAGLIOASSET dett, BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xa;&#x9;WHERE ass.BDS_ID = dett.ASSET_DETTAGLIOASSET_BDSID &#xa;&#x9;&#x9;AND&#x9;dett.BDS_ID = att.DTTGLSST_TTRBTIDTTGLISST_BDSID &#xa;&#x9;&#x9;AND ass.IDASSET = ?&#xa;    AND dett.nomecomponente='AGGIUNTIVO'&#xa;    AND att.NOMEATTRIBUTO in ('NUMEROTELEFONICO','DIREZIONALITA')&#xa;&#x9;ORDER BY att.DTTGLSST_TTRBTIDTTGLISST_BDSID&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdAsset"/>
                                    <columnMetadata
                                    columnName="DTTGLSST_TTRBTIDTTGLISST_BDSID"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMECOMPONENTE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CREATED"
                                    dataType="93"
                                    status="OptionalElement" typeName="TIMESTAMP"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
