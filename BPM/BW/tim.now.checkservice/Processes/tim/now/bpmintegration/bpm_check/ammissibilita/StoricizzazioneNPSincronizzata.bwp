lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:IDAsset&quot;>&#xa;                        &lt;tns1:IDAsset>&#xa;                            &lt;xsl:value-of select=&quot;tns1:IDAsset&quot;/>&#xa;                        &lt;/tns1:IDAsset>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:InvioaDTU&quot;>&#xa;                        &lt;tns1:InvioaDTU>&#xa;                            &lt;xsl:value-of select=&quot;tns1:InvioaDTU&quot;/>&#xa;                        &lt;/tns1:InvioaDTU>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:NumeroTelefonico[1]&quot;>&#xa;                        &lt;tns1:NumeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;tns1:NumeroTelefonico[1]&quot;/>&#xa;                        &lt;/tns1:NumeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:NumeroTelefonicoPrincipale&quot;>&#xa;                        &lt;tns1:NumeroTelefonicoPrincipale>&#xa;                            &lt;xsl:value-of select=&quot;tns1:NumeroTelefonicoPrincipale&quot;/>&#xa;                        &lt;/tns1:NumeroTelefonicoPrincipale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:OLORetailer&quot;>&#xa;                        &lt;tns1:OLORetailer>&#xa;                            &lt;xsl:value-of select=&quot;tns1:OLORetailer&quot;/>&#xa;                        &lt;/tns1:OLORetailer>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:RoutingNumber&quot;>&#xa;                        &lt;tns1:RoutingNumber>&#xa;                            &lt;xsl:value-of select=&quot;tns1:RoutingNumber&quot;/>&#xa;                        &lt;/tns1:RoutingNumber>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TipoLinea&quot;>&#xa;                        &lt;tns1:TipoLinea>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TipoLinea&quot;/>&#xa;                        &lt;/tns1:TipoLinea>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TipoLineaNP&quot;>&#xa;                        &lt;tns1:TipoLineaNP>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TipoLineaNP&quot;/>&#xa;                        &lt;/tns1:TipoLineaNP>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:CodicePiattaforma&quot;>&#xa;                        &lt;tns1:CodicePiattaforma>&#xa;                            &lt;xsl:value-of select=&quot;tns1:CodicePiattaforma&quot;/>&#xa;                        &lt;/tns1:CodicePiattaforma>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TipoNumero&quot;>&#xa;                        &lt;tns1:TipoNumero>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TipoNumero&quot;/>&#xa;                        &lt;/tns1:TipoNumero>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:TipoServizio&quot;>&#xa;                        &lt;tns1:TipoServizio>&#xa;                            &lt;xsl:value-of select=&quot;tns1:TipoServizio&quot;/>&#xa;                        &lt;/tns1:TipoServizio>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:PortabilitaSuccessiva&quot;>&#xa;                        &lt;tns1:PortabilitaSuccessiva>&#xa;                            &lt;xsl:value-of select=&quot;tns1:PortabilitaSuccessiva&quot;/>&#xa;                        &lt;/tns1:PortabilitaSuccessiva>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:NumberPortability>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:for-each select=&quot;$MapperDatiVerificaControlli/tns2:Aggiuntivo&quot;>&#xa;                &lt;tns1:Aggiuntivo>&#xa;                    &lt;xsl:if test=&quot;tns1:AggiuntivoWLR&quot;>&#xa;                        &lt;tns1:AggiuntivoWLR>&#xa;                            &lt;xsl:value-of select=&quot;tns1:AggiuntivoWLR&quot;/>&#xa;                        &lt;/tns1:AggiuntivoWLR>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:Direzionalita&quot;>&#xa;                        &lt;tns1:Direzionalita>&#xa;                            &lt;xsl:value-of select=&quot;tns1:Direzionalita&quot;/>&#xa;                        &lt;/tns1:Direzionalita>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:NumeroTelefonico&quot;>&#xa;                        &lt;tns1:NumeroTelefonico>&#xa;                            &lt;xsl:value-of select=&quot;tns1:NumeroTelefonico&quot;/>&#xa;                        &lt;/tns1:NumeroTelefonico>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:NumeroTelefonicoPrincipale&quot;>&#xa;                        &lt;tns1:NumeroTelefonicoPrincipale>&#xa;                            &lt;xsl:value-of select=&quot;tns1:NumeroTelefonicoPrincipale&quot;/>&#xa;                        &lt;/tns1:NumeroTelefonicoPrincipale>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns1:Stato&quot;>&#xa;                        &lt;tns1:Stato>&#xa;                            &lt;xsl:value-of select=&quot;tns1:Stato&quot;/>&#xa;                        &lt;/tns1:Stato>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:Aggiuntivo>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
