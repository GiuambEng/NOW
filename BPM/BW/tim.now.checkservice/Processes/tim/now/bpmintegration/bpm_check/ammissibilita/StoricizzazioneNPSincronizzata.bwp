                    <bpws:targets>
                        <bpws:target linkName="Empty2ToMapperDatiVerificaControlli"/>
                        <bpws:target linkName="CodicePiattaformaToListaNP"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToMapperDatiVerificaControlli"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ListaDN&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectDatiVerificaControlli&quot;/>&lt;xsl:param name=&quot;CodicePiattaforma&quot;/>&lt;xsl:template name=&quot;ListaNP-input&quot; match=&quot;/&quot;>&lt;tns:Lista_NP>&lt;xsl:for-each select=&quot;$ListaDN/tns:DN_flag&quot;>&lt;xsl:variable name=&quot;CurrentDN&quot; select=&quot;tns:DN&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;tns:CasoNP=1&quot;>&lt;tns:NumberPortability>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;WLR&amp;quot;)&quot;>&lt;xsl:if test=&quot;tns:FlagAggiuntivo&quot;>&lt;tns1:AggiuntivoWLR>&lt;xsl:value-of select=&quot;tns:FlagAggiuntivo&quot;/>&lt;/tns1:AggiuntivoWLR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:AggiuntivoWLR>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:AggiuntivoWLR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:AttributoAsset[1]/tns:CodificaOLOAGCOM&quot;>&lt;tns1:CodiceOperatoreDonating>&lt;xsl:value-of select=&quot;tns:AttributoAsset[1]/tns:CodificaOLOAGCOM&quot;/>&lt;/tns1:CodiceOperatoreDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;CODICEOPERATOREDONOR&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:CodiceOperatoreDonor>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;CODICEOPERATOREDONOR&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:CodiceOperatoreDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;>&lt;tns1:CodiceOperatoreRecipient>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;/>&lt;/tns1:CodiceOperatoreRecipient>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;CODICEORDINETI&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:CodiceOrdineTI>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;CODICEORDINETI&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:CodiceOrdineTI>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;VULL&amp;quot;) or starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;WLR&amp;quot;)) and $Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&lt;tns1:InvioaDTU>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:InvioaDTU>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:InvioaDTU>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns1:InvioaDTU>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;NUMEROTELEFONICO&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:NumeroTelefonico>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;NUMEROTELEFONICO&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:NumeroTelefonico>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;NUMEROTELEFONICOPRINCIPALE&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;OLORETAILER&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:OLORetailer>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;OLORETAILER&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:OLORetailer>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;>&lt;tns1:RoutingNumber>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;/>&lt;/tns1:RoutingNumber>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;ROUTINGNUMBER&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:RoutingNumber>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;ROUTINGNUMBER&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:RoutingNumber>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;TIPOLINEANP&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:TipoLineaNP>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;TIPOLINEANP&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:TipoLineaNP>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;CODICEPIATTAFORMA&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:CodicePiattaforma>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;CODICEPIATTAFORMA&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:CodicePiattaforma>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;TIPONUMERO&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:TipoNumero>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;TIPONUMERO&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:TipoNumero>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;TIPOSERVIZIO&amp;quot;][1]/tns:ValoreAttributo&quot;>&lt;tns1:TipoServizio>&lt;xsl:value-of select=&quot;tns:AttributoAsset[tns:NomeAttributo=&amp;quot;TIPOSERVIZIO&amp;quot;][1]/tns:ValoreAttributo&quot;/>&lt;/tns1:TipoServizio>&lt;/xsl:if>&lt;tns1:PortabilitaSuccessiva>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns1:PortabilitaSuccessiva>&lt;/tns:NumberPortability>&lt;/xsl:when>&lt;xsl:when test=&quot;tns:CasoNP=2&quot;>&lt;tns:NumberPortability>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;WLR&amp;quot;)&quot;>&lt;xsl:if test=&quot;tns:FlagAggiuntivo&quot;>&lt;tns1:AggiuntivoWLR>&lt;xsl:value-of select=&quot;tns:FlagAggiuntivo&quot;/>&lt;/tns1:AggiuntivoWLR>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:AggiuntivoWLR>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:AggiuntivoWLR>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:CodiceOperatoreDonating>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/tns1:CodiceOperatoreDonating>&lt;tns1:CodiceOperatoreDonor>&lt;xsl:value-of select=&quot;&amp;quot;TLC&amp;quot;&quot;/>&lt;/tns1:CodiceOperatoreDonor>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;>&lt;tns1:CodiceOperatoreRecipient>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;/>&lt;/tns1:CodiceOperatoreRecipient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;VULL&amp;quot;) or starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;WLR&amp;quot;)) and $Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Lavorazione=&amp;quot;MIGRAZIONE&amp;quot; or exists($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:AggiuntivoISDNinventory[.=$CurrentDN])&quot;>&lt;tns1:InvioaDTU>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:InvioaDTU>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:InvioaDTU>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns1:InvioaDTU>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:NumeroTelefonico>&lt;xsl:value-of select=&quot;tns:DN&quot;/>&lt;/tns1:NumeroTelefonico>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DN)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DN&quot;>&lt;tns1:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DN&quot;/>&lt;/tns1:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DNAggiuntive[1]&quot;>&lt;tns1:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DNAggiuntive[1]&quot;/>&lt;/tns1:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;>&lt;tns1:RoutingNumber>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;/>&lt;/tns1:RoutingNumber>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;($SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='GNR RADICALE' or $SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='RADICALE ACCORPATO')&quot;>&lt;tns1:TipoLineaNP>&lt;xsl:value-of select=&quot;&amp;quot;1&amp;quot;&quot;/>&lt;/tns1:TipoLineaNP>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='GNR LINEE'&quot;>&lt;tns1:TipoLineaNP>&lt;xsl:value-of select=&quot;&amp;quot;2&amp;quot;&quot;/>&lt;/tns1:TipoLineaNP>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='GENERICA' and ( $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN' or $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN BMO' or  $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN BMU' or $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN PRA')&quot;>&lt;tns1:TipoLineaNP>&lt;xsl:value-of select=&quot;&amp;quot;3&amp;quot;&quot;/>&lt;/tns1:TipoLineaNP>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($CodicePiattaforma/Record[1]/VALOREATTRIBUTO) and string-length($CodicePiattaforma/Record[1]/VALOREATTRIBUTO)>0&quot;>&lt;xsl:if test=&quot;$CodicePiattaforma/Record[1]/VALOREATTRIBUTO&quot;>&lt;tns1:CodicePiattaforma>&lt;xsl:value-of select=&quot;$CodicePiattaforma/Record[1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:CodicePiattaforma>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE&quot;>&lt;tns1:TipoNumero>&lt;xsl:value-of select=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE&quot;/>&lt;/tns1:TipoNumero>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE&quot;>&lt;tns1:TipoServizio>&lt;xsl:value-of select=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE&quot;/>&lt;/tns1:TipoServizio>&lt;/xsl:if>&lt;tns1:PortabilitaSuccessiva>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:PortabilitaSuccessiva>&lt;/tns:NumberPortability>&lt;/xsl:when>&lt;xsl:when test=&quot;tns:CasoNP=3&quot;>&lt;tns:NumberPortability>&lt;xsl:if test=&quot;tns:DonorDIOGENE&quot;>&lt;tns1:CodiceOperatoreDonating>&lt;xsl:value-of select=&quot;tns:DonorDIOGENE&quot;/>&lt;/tns1:CodiceOperatoreDonating>&lt;/xsl:if>&lt;xsl:if test=&quot;tns:DonorDIOGENE&quot;>&lt;tns1:CodiceOperatoreDonor>&lt;xsl:value-of select=&quot;tns:DonorDIOGENE&quot;/>&lt;/tns1:CodiceOperatoreDonor>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;>&lt;tns1:CodiceOperatoreRecipient>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;/>&lt;/tns1:CodiceOperatoreRecipient>&lt;/xsl:if>&lt;tns1:InvioaDTU>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:InvioaDTU>&lt;tns1:NumeroTelefonico>&lt;xsl:value-of select=&quot;tns:DN&quot;/>&lt;/tns1:NumeroTelefonico>&lt;xsl:if test=&quot;starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;ULL&amp;quot;) or starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;SLU&amp;quot;)&quot;>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DNAggiuntive[1]&quot;>&lt;tns1:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DNAggiuntive[1]&quot;/>&lt;/tns1:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;>&lt;tns1:RoutingNumber>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;/>&lt;/tns1:RoutingNumber>&lt;/xsl:if>&lt;/tns:NumberPortability>&lt;/xsl:when>&lt;/xsl:choose>&lt;/xsl:for-each>&#xa;                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    &lt;!--SM_9168 - Creata nuova componente da CodiceRisorsa1 o CodiceRisorsa2-->&lt;xsl:if test=&quot;(starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:ConsistenzaFonia/tns1:Offerta,&amp;quot;ULL&amp;quot;) or starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:ConsistenzaFonia/tns1:Offerta,&amp;quot;SLU&amp;quot;)) and $Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Lavorazione='MIGRAZIONE' and $Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient!='TLC' and $Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:ConsistenzaFonia/tns1:CodificaOLOAGCOMDonating='TLC' and $Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Sottolavorazione=('MIGRAZIONEOLO','ATTIVAZIONE274')&quot;>&lt;xsl:if test=&quot;($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Sottolavorazione='MIGRAZIONEOLO' and not(contains(tib:concat-sequence-format($ListaDN/tns:DN_flag/tns:DN, ';'),$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodiceRisorsa2))) or ($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Sottolavorazione='ATTIVAZIONE274' and not(contains(tib:concat-sequence-format($ListaDN/tns:DN_flag/tns:DN, ';'),$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodiceRisorsa1)))&quot;>&lt;tns:NumberPortability>&lt;tns1:AggiuntivoWLR>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:AggiuntivoWLR>&lt;tns1:CodiceOperatoreDonating>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns1:CodiceOperatoreDonating>&lt;tns1:CodiceOperatoreDonor>&lt;xsl:value-of select=&quot;'TLC'&quot;/>&lt;/tns1:CodiceOperatoreDonor>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;>&lt;tns1:CodiceOperatoreRecipient>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodificaOloAgcomRecepient&quot;/>&lt;/tns1:CodiceOperatoreRecipient>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;(starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;VULL&amp;quot;) or starts-with($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Offerta,&amp;quot;WLR&amp;quot;)) and $Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Lavorazione=&amp;quot;MIGRAZIONE&amp;quot;&quot;>&lt;tns1:InvioaDTU>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:InvioaDTU>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:InvioaDTU>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:InvioaDTU>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:Sottolavorazione='MIGRAZIONEOLO'&quot;>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodiceRisorsa2&quot;>&lt;tns1:NumeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodiceRisorsa2&quot;/>&lt;/tns1:NumeroTelefonico>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodiceRisorsa1&quot;>&lt;tns1:NumeroTelefonico>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:CodiceRisorsa1&quot;/>&lt;/tns1:NumeroTelefonico>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DN)>0&quot;>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DN&quot;>&lt;tns1:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DN&quot;/>&lt;/tns1:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DNAggiuntive[1]&quot;>&lt;tns1:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:DNAggiuntive[1]&quot;/>&lt;/tns1:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;>&lt;tns1:RoutingNumber>&lt;xsl:value-of select=&quot;$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:RoutingNumber&quot;/>&lt;/tns1:RoutingNumber>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;($SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='GNR RADICALE' or $SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='RADICALE ACCORPATO')&quot;>&lt;tns1:TipoLineaNP>&lt;xsl:value-of select=&quot;'1'&quot;/>&lt;/tns1:TipoLineaNP>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='GNR LINEE'&quot;>&lt;tns1:TipoLineaNP>&lt;xsl:value-of select=&quot;'2'&quot;/>&lt;/tns1:TipoLineaNP>&lt;/xsl:when>&lt;xsl:when test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE ='GENERICA' and ( $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN' or $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN BMO' or  $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN BMU' or $SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE ='ISDN PRA')&quot;>&lt;tns1:TipoLineaNP>&lt;xsl:value-of select=&quot;'3'&quot;/>&lt;/tns1:TipoLineaNP>&lt;/xsl:when>&lt;/xsl:choose>&lt;xsl:if test=&quot;exists($CodicePiattaforma/Record[1]/VALOREATTRIBUTO) and string-length($CodicePiattaforma/Record[1]/VALOREATTRIBUTO)>0&quot;>&lt;xsl:if test=&quot;$CodicePiattaforma/Record[1]/VALOREATTRIBUTO&quot;>&lt;tns1:CodicePiattaforma>&lt;xsl:value-of select=&quot;$CodicePiattaforma/Record[1]/VALOREATTRIBUTO&quot;/>&lt;/tns1:CodicePiattaforma>&lt;/xsl:if>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE&quot;>&lt;tns1:TipoNumero>&lt;xsl:value-of select=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPONUMERO'][1]/VALORE&quot;/>&lt;/tns1:TipoNumero>&lt;/xsl:if>&lt;xsl:if test=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE&quot;>&lt;tns1:TipoServizio>&lt;xsl:value-of select=&quot;$SelectDatiVerificaControlli/Record[NOME='TIPOSERVIZIO'][1]/VALORE&quot;/>&lt;/tns1:TipoServizio>&lt;/xsl:if>&lt;tns1:PortabilitaSuccessiva>&lt;xsl:value-of select=&quot;'N'&quot;/>&lt;/tns1:PortabilitaSuccessiva>&lt;/tns:NumberPortability>&lt;/xsl:if>&lt;/xsl:if>&lt;/tns:Lista_NP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:NP_sincronizzata="http://www.tim.com/NOW/xsd/NP_sincronizzata"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NP_sincronizzata:Lista_NP" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogListaNP-input"
                    name="LogListaNP"
                    tibex:xpdlId="5dcc14a1-aee0-46ca-b111-57ee9b538eb6"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToMapperDatiVerificaControlli"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToMapperDatiVerificaControlli">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogListaNPToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Offerta,&quot;WLR&quot;) and count($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:DNAggiuntive)>1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Offerta,"WLR") and count($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:DNAggiuntive)>1]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaNP&quot;/>&#xa;    &lt;xsl:template name=&quot;LogListaNP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Lista NP da creare: &amp;quot;&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($ListaNP,true(),true())&quot;/>&#xa;                &lt;/tns2:Payload>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="AggiuntiviWLR-input"
                    name="AggiuntiviWLR" outputVariable="AggiuntiviWLR"
                    tibex:xpdlId="76967587-7129-4829-b6bd-e4e4199c56e6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToMapperDatiVerificaControlli"/>
                        <bpws:target linkName="JDBCQueryToAggiuntiviWLR"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToMapperDatiVerificaControlli1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Direzionalita&quot;/>&lt;xsl:template name=&quot;AggiuntiviWLR-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:Offerta,&amp;quot;WLR&amp;quot;) and count($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive)>1&quot;>&lt;tns:Lista_aggiuntivi>&lt;xsl:for-each select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[position()!=1]&quot;>&lt;xsl:variable name=&quot;var&quot; select=&quot;.&quot;/>&lt;tns:Aggiuntivo>&lt;tns2:AggiuntivoWLR>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns2:AggiuntivoWLR>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with(../tns1:ConsistenzaFonia/tns2:Offerta,&amp;quot;WLR&amp;quot;) and string-length($Direzionalita/Record[DTTGLSST_TTRBTIDTTGLISST_BDSID = $Direzionalita/Record[NOMEATTRIBUTO = &amp;quot;NUMEROTELEFONICO&amp;quot; and VALOREATTRIBUTO = $var]/DTTGLSST_TTRBTIDTTGLISST_BDSID and NOMEATTRIBUTO = &amp;quot;DIREZIONALITA&amp;quot;]/VALOREATTRIBUTO)>0&quot;>&lt;xsl:if test=&quot;$Direzionalita/Record[DTTGLSST_TTRBTIDTTGLISST_BDSID = $Direzionalita/Record[NOMEATTRIBUTO = &amp;quot;NUMEROTELEFONICO&amp;quot; and VALOREATTRIBUTO = $var]/DTTGLSST_TTRBTIDTTGLISST_BDSID and NOMEATTRIBUTO = &amp;quot;DIREZIONALITA&amp;quot;]/VALOREATTRIBUTO&quot;>&lt;tns2:Direzionalita>&lt;xsl:value-of select=&quot;$Direzionalita/Record[DTTGLSST_TTRBTIDTTGLISST_BDSID = $Direzionalita/Record[NOMEATTRIBUTO = &amp;quot;NUMEROTELEFONICO&amp;quot; and VALOREATTRIBUTO = $var]/DTTGLSST_TTRBTIDTTGLISST_BDSID and NOMEATTRIBUTO = &amp;quot;DIREZIONALITA&amp;quot;]/VALOREATTRIBUTO&quot;/>&lt;/tns2:Direzionalita>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Direzionalita>&lt;xsl:value-of select=&quot;&amp;quot;BIDIREZIONALE&amp;quot;&quot;/>&lt;/tns2:Direzionalita>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:NumeroTelefonico>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns2:NumeroTelefonico>&lt;xsl:if test=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1]&quot;>&lt;tns2:NumeroTelefonicoPrincipale>&lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1]&quot;/>&lt;/tns2:NumeroTelefonicoPrincipale>&lt;/xsl:if>&lt;tns2:Stato>&lt;xsl:value-of select=&quot;&amp;quot;ATTIVO&amp;quot;&quot;/>&lt;/tns2:Stato>&lt;/tns:Aggiuntivo>&lt;/xsl:for-each>&lt;/tns:Lista_aggiuntivi>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Lista_aggiuntivi/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:NP_sincronizzata="http://www.tim.com/NOW/xsd/NP_sincronizzata"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NP_sincronizzata:Lista_aggiuntivi" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
