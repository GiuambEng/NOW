            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="a09be46d-6766-4a9f-bf9c-7cfba0ce87dc"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets/>
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="DatiVerificaControlli-input"
                name="DatiVerificaControlli"
                operation="DatiVerificaControlli"
                outputVariable="DatiVerificaControlli"
                partnerLink="DatiVerificaControlli"
                portType="ns4:DatiVerificaControlliPortType" tibex:xpdlId="692b6716-513e-4905-a996-7bddf445d8b6">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns2="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" version="2.0"&gt;
    &lt;xsl:param name="Start"/&gt;
    &lt;xsl:param name="MapperDatiVerificaControlli"/&gt;
    &lt;xsl:template name="DatiVerificaControlli-input" match="/"&gt;
        &lt;tns3:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns1:DatiVerificaControlliInput&gt;
                    &lt;tns1:Operatore&gt;
                        &lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;
                    &lt;/tns1:Operatore&gt;
                    &lt;tns1:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:IDRichiestaOLO"/&gt;
                    &lt;/tns1:IDRichiestaOLO&gt;
                    &lt;tns1:Azione&gt;
                        &lt;xsl:value-of select="'INSERT'"/&gt;
                    &lt;/tns1:Azione&gt;
                    &lt;xsl:for-each select="$MapperDatiVerificaControlli/tns2:NumberPortability"&gt;
                        &lt;tns1:NumberPortability&gt;
                            &lt;xsl:if test="tns1:AggiuntivoWLR"&gt;
                                &lt;tns1:AggiuntivoWLR&gt;
                                    &lt;xsl:value-of select="tns1:AggiuntivoWLR"/&gt;
                                &lt;/tns1:AggiuntivoWLR&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:CodiceOperatoreDonating"&gt;
                                &lt;tns1:CodiceOperatoreDonating&gt;
                                    &lt;xsl:value-of select="tns1:CodiceOperatoreDonating"/&gt;
                                &lt;/tns1:CodiceOperatoreDonating&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:CodiceOperatoreDonor"&gt;
                                &lt;tns1:CodiceOperatoreDonor&gt;
                                    &lt;xsl:value-of select="tns1:CodiceOperatoreDonor"/&gt;
                                &lt;/tns1:CodiceOperatoreDonor&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:CodiceOperatoreRecipient"&gt;
                                &lt;tns1:CodiceOperatoreRecipient&gt;
                                    &lt;xsl:value-of select="tns1:CodiceOperatoreRecipient"/&gt;
                                &lt;/tns1:CodiceOperatoreRecipient&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:CodiceOrdineTI"&gt;
                                &lt;tns1:CodiceOrdineTI&gt;
                                    &lt;xsl:value-of select="tns1:CodiceOrdineTI"/&gt;
                                &lt;/tns1:CodiceOrdineTI&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:CodificaOLOAGCOMDonating"&gt;
                                &lt;tns1:CodificaOLOAGCOMDonating&gt;
                                    &lt;xsl:value-of select="tns1:CodificaOLOAGCOMDonating"/&gt;
                                &lt;/tns1:CodificaOLOAGCOMDonating&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:CodificaOLOAGCOMDonor"&gt;
                                &lt;tns1:CodificaOLOAGCOMDonor&gt;
                                    &lt;xsl:value-of select="tns1:CodificaOLOAGCOMDonor"/&gt;
                                &lt;/tns1:CodificaOLOAGCOMDonor&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:CodificaOLOAGCOMRecipient"&gt;
                                &lt;tns1:CodificaOLOAGCOMRecipient&gt;
                                    &lt;xsl:value-of select="tns1:CodificaOLOAGCOMRecipient"/&gt;
                                &lt;/tns1:CodificaOLOAGCOMRecipient&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:IDAsset"&gt;
                                &lt;tns1:IDAsset&gt;
                                    &lt;xsl:value-of select="tns1:IDAsset"/&gt;
                                &lt;/tns1:IDAsset&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns1:InvioaDTU"&gt;
