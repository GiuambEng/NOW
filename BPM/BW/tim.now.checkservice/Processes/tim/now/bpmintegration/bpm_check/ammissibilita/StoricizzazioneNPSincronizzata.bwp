            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogStartStoricizzazione-input"
                    name="LogStartStoricizzazione"
                    tibex:xpdlId="ef373143-be15-4db2-9296-5c3714c96e77"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToCheckNPDonorTelecom">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartStoricizzazioneToEmpty1_WLRVULL-WLRVULL">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,&quot;WLR&quot;) or starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,&quot;VULL&quot;)) and (starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Offerta,&quot;WLR&quot;) or starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Offerta,&quot;VULL&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,"WLR") or starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,"VULL")) and (starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Offerta,"WLR") or starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Offerta,"VULL"))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogStartStoricizzazioneToEmpty2_DONATINGTIFONIA">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="((starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,&quot;ULL&quot;) or starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,&quot;SLU&quot;)) and $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Azione=&quot;D&quot; and $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:CodificaOLOAGCOMDonating=&quot;TLC&quot; and exists($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaDati) and $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaDati/tns:Azione=&quot;D&quot;) or $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Sottolavorazione ='ATTIVAZIONE274'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[((starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,"ULL") or starts-with($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,"SLU")) and $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Azione="D" and $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:CodificaOLOAGCOMDonating="TLC" and exists($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaDati) and $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaDati/tns:Azione="D") or $Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:Sottolavorazione ='ATTIVAZIONE274']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
