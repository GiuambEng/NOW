                                expression="exists($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia) and&#xd;&#xa;(substring($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,1,3)=&quot;WLR&quot; or substring($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,1,4)=&quot;VULL&quot;) and string-length($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:IDAsset)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia) and
(substring($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,1,3)="WLR" or substring($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:Offerta,1,4)="VULL") and string-length($Start/ns0:Verifica_NP_Sincronizzata_Request/ns0:ConsistenzaFonia/tns:IDAsset)>0]]></bpws:transitionCondition>
                    </bpws:source>
