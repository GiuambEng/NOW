                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ListaDN&quot; match=&quot;/&quot;>&lt;xsl:choose>&#xa;                &lt;!--&quot;RU_663: per il casoNP=2, annullata la scelta per flag=1 inserendo in AND un false e forzata la scelta per flag=0 inserendo in OR un true.&quot;-->&lt;xsl:when test=&quot;false() and $Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:FlagNumerazioneAggiuntive=&amp;quot;1&amp;quot;&quot;>&lt;tns:Lista_DN>&lt;xsl:if test=&quot;not(contains(tib:concat-sequence-format($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntiveFase2, &amp;quot;;&amp;quot;),$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaDati/tns2:NumeroTelefonico))&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaDati/tns2:NumeroTelefonico&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/tns:DN_flag>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntiveFase2&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&#xa;                                                                                &lt;!--&quot;FLAG DA VERIFICARE CON ING&quot;-->&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/tns:DN_flag>&lt;/xsl:for-each>&lt;/tns:Lista_DN>&lt;/xsl:when>&#xa;                                                                                        &lt;!--&quot;SM_8130: ANNULLA OR aggiunto per la RU_663. Inserito il 2 false per aggiungere tutte le numerazioni presenti.&quot;-->&lt;xsl:when test=&quot;false() and $Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:FlagNumerazioneAggiuntive=&amp;quot;0&amp;quot;&quot;>&lt;tns:Lista_DN>&lt;xsl:if test=&quot;not(contains(tib:concat-sequence-format($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive, &amp;quot;;&amp;quot;),$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaDati/tns2:NumeroTelefonico))&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaDati/tns2:NumeroTelefonico&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/tns:DN_flag>&lt;/xsl:if>&lt;xsl:if test=&quot;string-length($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1])>0&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1]&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/tns:DN_flag>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[position()!=1]&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/tns:DN_flag>&lt;/xsl:for-each>&lt;/tns:Lista_DN>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Lista_DN>&lt;xsl:if test=&quot;string-length($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1])>0&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1]&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/tns:DN_flag>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[position()!=1]&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/tns:DN_flag>&lt;/xsl:for-each>&lt;/tns:Lista_DN>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="ListaDN" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ListaDN"
                    name="ListaDN_generica" outputVariable="ListaDN"
                    tibex:xpdlId="54fc88f4-7a82-478e-8ba5-241d0e840350" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToCheckNPDonorTelecom"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ListaDN_genericaToWhile"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ListaDN&quot; match=&quot;/&quot;>&lt;tns:Lista_DN>&lt;xsl:for-each select=&quot;$Start/tns:Lista_DN/tns:DN_flag&quot;>&lt;xsl:copy-of select=&quot;.&quot;/>&lt;/xsl:for-each>&lt;xsl:if test=&quot;string-length($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1])>0 and &amp;#xD;&amp;#xA;not(exists($Start/tns:Lista_DN/tns:DN_flag[tns:DN=$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1]]))&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[1]&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;/tns:DN_flag>&lt;/xsl:if>&lt;xsl:for-each select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[position()!=1]&quot;>&lt;xsl:variable name=&quot;CurrentDN&quot; select=&quot;.&quot;/>&lt;xsl:if test=&quot;not(exists(../../tns:Lista_DN/tns:DN_flag[tns:DN=$CurrentDN]))&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;.&quot;/>&lt;/tns:DN>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;/tns:DN_flag>&lt;/xsl:if>&lt;/xsl:for-each>&lt;/tns:Lista_DN>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="ListaDN" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="baf19e27-614c-4aeb-8d71-bf2edd8fd2b7">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToAssign"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+9a3e4179-38e6-4fd5-9f3b-063025955f4a" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($ListaDN/ns17:DN_flag)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($ListaDN/ns17:DN_flag)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStartToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="DistrettoToCheckNPDonorOLO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CheckNPDonorOLOToCheckNPDonorTelecom" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToMapperCasoNP_DONOROLO"
                                    tibex:label="DONOR OLO" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="CheckNPDonorTelecomToMapper" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperCasoNPToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToCheckNPDonorOLO" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToCheckNPDonorTelecom1_DONORTLC"
                                    tibex:label="DONOR TLC" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="CallProcessToMapperCasoNP1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToCheckNPDonorTelecom_DIOGENEPRESENTE"
                                    tibex:label="DIOGENE PRESENTE" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStartToMapperCasoNP_ASSETPRESENTE"
                                    tibex:label="ASSET PRESENTE" tibex:linkType="SUCCESSWITHCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="6d9f6977-b04a-4f92-987d-26139efe1f00">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToCheckNPDonorTelecom_DIOGENEPRESENTE">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($ListaDN/ns17:DN_flag[number($index)]/ns17:DonorDIOGENE)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($ListaDN/ns17:DN_flag[number($index)]/ns17:DonorDIOGENE)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToMapperCasoNP_ASSETPRESENTE">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($ListaDN/ns17:DN_flag[number($index)]/ns17:AttributoAsset)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($ListaDN/ns17:DN_flag[number($index)]/ns17:AttributoAsset)]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="9a3e4179-38e6-4fd5-9f3b-063025955f4a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>MapperCasoNP</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Distretto"
                                    name="Distretto"
                                    outputVariable="Distretto"
                                    tibex:xpdlId="b7a2e256-fc4e-4f35-8886-e22f699a1b90" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="DistrettoToCheckNPDonorOLO"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if(substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 2, 1) = &quot;6&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 1, 2)) else if(substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;0&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;1&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;5&quot; or substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 3, 1) = &quot;9&quot;) then substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 1, 3) else substring($ListaDN/ns17:DN_flag[number($index)]/ns17:DN, 2, 3)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Distretto" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CheckNPDonorOLO-input"
                                    name="CheckNPDonorOLO"
                                    outputVariable="CheckNPDonorOLO"
                                    tibex:xpdlId="cd63f13f-a402-46b2-b6c6-c48c0a31a9e8" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToCheckNPDonorOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckNPDonorOLOToCheckNPDonorTelecom">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cd63f13f-a402-46b2-b6c6-c48c0a31a9e8+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckNPDonorOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;COD_DISTRETTO>&#xa;                &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;            &lt;/COD_DISTRETTO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:value-of select=&quot;substring($ListaDN/tns:DN_flag[number($index)]/tns:DN, 3)&quot;/>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:value-of select=&quot;substring-after($ListaDN/tns:DN_flag[number($index)]/tns:DN, $Distretto)&quot;/>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;COUNT_1>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring($ListaDN/tns:DN_flag[number($index)]/tns:DN,3))&quot;/>&#xa;                    &lt;/COUNT_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COUNT_1>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring-after($ListaDN/tns:DN_flag[number($index)]/tns:DN, $Distretto))&quot;/>&#xa;                    &lt;/COUNT_1>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;COUNT_2>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring($ListaDN/tns:DN_flag[number($index)]/tns:DN, 3))&quot;/>&#xa;                    &lt;/COUNT_2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COUNT_2>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring-after($ListaDN/tns:DN_flag[number($index)]/tns:DN, $Distretto))&quot;/>&#xa;                    &lt;/COUNT_2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:Data_Invio_Rich)&quot;>&#xa;                    &lt;DATA_INVIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:Data_Invio_Rich)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:Data_Invio_Rich&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DATA_INVIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATA_INVIO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODFC_OLO_AGCOM&#xa;  FROM ARCHI_NUMRZNE_DIOGENE&#xa;  WHERE COD_DISTR = ? AND ? BETWEEN RPAD(ARCO_NUMRZNE_DA, ?, 0) AND RPAD(ARCO_NUMRZNE_A, ?, 9) AND (? BETWEEN DATAINZ_VALID AND DATAFI_VALID OR SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_DISTRETTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_2"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_INVIO"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CheckNPDonorTelecom-input"
                                    name="CheckNPDonorTelecom"
                                    outputVariable="CheckNPDonorTelecom"
                                    tibex:xpdlId="60b35c0f-b17c-4678-acec-2617b9b3988a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToCheckNPDonorTelecom1_DONORTLC"/>
                                    <bpws:target linkName="GroupStartToCheckNPDonorTelecom_DIOGENEPRESENTE"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckNPDonorTelecomToMapper"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+60b35c0f-b17c-4678-acec-2617b9b3988a+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckNPDonorTelecom-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;DN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($ListaDN/tns:DN_flag[number($index)]/tns:DN)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:DN&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DN>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT dett.IDASSET,dett.IDRISORSA,dett.IDDETTAGLIOASSET,att.NOMEATTRIBUTO,att.VALOREATTRIBUTO,ass.CODIFICAOLOAGCOM,ass.NUMEROTELEFONICO &#xd;&#xa;FROM BDS_1_CASEDATA_ASSET ass LEFT OUTER JOIN BDS_1_CASEDATA_DETTAGLIOASSET dett ON ass.BDS_ID=dett.ASSET_DETTAGLIOASSET_BDSID &#xd;&#xa;LEFT OUTER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST att ON dett.BDS_ID=att.DTTGLSST_TTRBTIDTTGLISST_BDSID&#xd;&#xa;WHERE &#xd;&#xa;ass.STATOASSET IN ('ATTIVO','INLAVORAZIONE')AND ass.OFFERTA ='NP' &#xd;&#xa;AND &#xd;&#xa;ass.IDRISORSA=? and&#xd;&#xa;dett.NOMECOMPONENTE='NUMBERPORTABILITY'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDDETTAGLIOASSET"
                                    dataType="-5"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="NOMEATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="MapperCasoNP-input"
                                    name="MapperCasoNP"
                                    outputVariable="MapperCasoNP"
                                    tibex:xpdlId="47c473c5-4c9e-49a6-b44d-cefa104af72a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToMapperCasoNP_DONOROLO"/>
                                    <bpws:target linkName="CallProcessToMapperCasoNP1"/>
                                    <bpws:target linkName="GroupStartToMapperCasoNP_ASSETPRESENTE"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="MapperCasoNPToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ListaDN&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;CheckNPDonorOLO&quot;/>&lt;xsl:param name=&quot;CheckNPDonorTelecom&quot;/>&lt;xsl:template name=&quot;MapperCasoNP-input&quot; match=&quot;/&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:DN&quot;/>&lt;/tns:DN>&lt;xsl:if test=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:FlagAggiuntivo&quot;>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:FlagAggiuntivo&quot;/>&lt;/tns:FlagAggiuntivo>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ListaDN/tns:DN_flag[number($index)]/tns:CasoNP)&quot;>&lt;xsl:if test=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:CasoNP&quot;>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:CasoNP&quot;/>&lt;/tns:CasoNP>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:when test=&quot;$CheckNPDonorOLO/Record[1]/CODFC_OLO_AGCOM!=&amp;quot;TLC&amp;quot;&quot;>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;3&quot;/>&lt;/tns:CasoNP>&lt;/xsl:when>&lt;xsl:when test=&quot;count($CheckNPDonorTelecom/Record)>0&quot;>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:CasoNP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ListaDN/tns:DN_flag[number($index)]/tns:DonorDIOGENE)>0&quot;>&lt;xsl:if test=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:DonorDIOGENE&quot;>&lt;tns:DonorDIOGENE>&lt;xsl:value-of select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:DonorDIOGENE&quot;/>&lt;/tns:DonorDIOGENE>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$CheckNPDonorOLO/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:DonorDIOGENE>&lt;xsl:value-of select=&quot;$CheckNPDonorOLO/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:DonorDIOGENE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:for-each select=&quot;$ListaDN/tns:DN_flag[number($index)]/tns:AttributoAsset&quot;>&lt;xsl:copy-of select=&quot;.&quot;/>&lt;/xsl:for-each>&lt;xsl:if test=&quot;not(exists($ListaDN/tns:DN_flag[number($index)]/tns:AttributoAsset))&quot;>&lt;xsl:for-each select=&quot;$CheckNPDonorTelecom/Record&quot;>&lt;tns:AttributoAsset>&lt;xsl:if test=&quot;IDASSET&quot;>&lt;tns:IdAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:IdAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:if>&lt;tns:IdDettaglioAsset>&lt;xsl:value-of select=&quot;xsd:int(IDDETTAGLIOASSET)&quot;/>&lt;/tns:IdDettaglioAsset>&lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&lt;tns:NomeAttributo>&lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&lt;/tns:NomeAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&lt;tns:ValoreAttributo>&lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&lt;/tns:ValoreAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:NumeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:NumeroTelefonico>&lt;/xsl:if>&lt;/tns:AttributoAsset>&lt;/xsl:for-each>&lt;/xsl:if>&lt;/tns:DN_flag>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:NP_sincronizzata="http://www.tim.com/NOW/xsd/NP_sincronizzata"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="NP_sincronizzata:DN_flag" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogDistretto-input"
                                    name="LogDistretto"
                                    tibex:xpdlId="b31e1415-3d07-4f9f-b41d-0ab23a9b948b"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="DistrettoToCheckNPDonorOLO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToCheckNPDonorOLO"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;ListaDN&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDistretto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:CW_BUS_MESSAGE>&#xa;            &lt;tns3:GenericLogger>&#xa;                &lt;tns3:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns3:Application>&#xa;                &lt;tns3:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns3:Process>&#xa;                &lt;tns3:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns3:Service>&#xa;                &lt;tns3:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns3:Operation>&#xa;                &lt;tns3:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns3:BusinessID>&#xa;                &lt;tns3:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Distretto determinato per numero &amp;quot;, $ListaDN/tns:DN_flag[number($index)]/tns:DN,&amp;quot; : &amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;tns3:Payload>&#xa;                    &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;                &lt;/tns3:Payload>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogDIOGENE-input"
                                    name="LogDIOGENE"
                                    tibex:xpdlId="8198ff50-fa1f-4208-9ba5-d72472fffa49"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckNPDonorOLOToCheckNPDonorTelecom"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToCheckNPDonorTelecom1_DONORTLC">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CheckNPDonorOLO/Record[1]/CODFC_OLO_AGCOM=&quot;TLC&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CheckNPDonorOLO/Record[1]/CODFC_OLO_AGCOM="TLC"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallProcessToMapperCasoNP_DONOROLO">
