o  per numero &amp;quot;, $ListaDN/tns:DN_flag[number($index)]/tns:DN,&amp;quot; : &amp;quot;)&quot;/>&#xa;                &lt;/tns3:Message>&#xa;                &lt;xsl:if test=&quot;$CheckNPDonorOLO/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                    &lt;tns3:Payload>&#xa;                        &lt;xsl:value-of select=&quot;$CheckNPDonorOLO/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                    &lt;/tns3:Payload>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns3:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns3:LoggerName>&#xa;                &lt;tns3:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns3:LogLevel>&#xa;                &lt;tns3:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns3:LogJMS>&#xa;            &lt;/tns3:GenericLogger>&#xa;        &lt;/tns3:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
