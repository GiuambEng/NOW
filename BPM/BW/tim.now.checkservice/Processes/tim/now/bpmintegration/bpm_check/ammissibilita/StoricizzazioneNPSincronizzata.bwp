            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="CodicePiattaforma-input"
                    name="CodicePiattaforma"
                    outputVariable="CodicePiattaforma"
                    tibex:xpdlId="98f4dbea-e2e5-4ac4-a465-525023642627" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty2ToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CodicePiattaformaToListaNP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+98f4dbea-e2e5-4ac4-a465-525023642627+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IdAsset>&#xa;                &lt;xsl:value-of select=&quot;xsd:int(xsd:decimal($Start/tns2:Verifica_NP_Sincronizzata_Request/tns2:ConsistenzaFonia/tns1:IDAsset))&quot;/>&#xa;            &lt;/IdAsset>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT att.VALOREATTRIBUTO &#xa;FROM BDS_1_CASEDATA_ASSET ass JOIN BDS_1_CASEDATA_DETTAGLIOASSET dett ON ass.BDS_ID=dett.ASSET_DETTAGLIOASSET_BDSID &#xa;JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST att ON dett.BDS_ID=att.DTTGLSST_TTRBTIDTTGLISST_BDSID&#xa;WHERE &#xa;ass.STATOASSET IN ('ATTIVO','INLAVORAZIONE') AND ass.idasset = ?&#xa;and&#xa;dett.NOMECOMPONENTE like 'ACCESSO%'&#xa;AND att.NOMEATTRIBUTO='CODICEPIATTAFORMA'" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IdAsset"/>
                                    <columnMetadata
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ListaDN"
                    name="ListaDNAtt274" outputVariable="ListaDN"
                    tibex:xpdlId="f60eda4a-65f0-4f25-b3f8-9186ae61511c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
