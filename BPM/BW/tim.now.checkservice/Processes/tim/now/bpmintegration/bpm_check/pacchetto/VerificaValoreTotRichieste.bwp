                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;LogCheck-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaValoreTotRichieste&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaValoreTotRichieste&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Confronto primo record con record indice: &amp;quot;, string($index))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogCheck-input"
                                    name="LogCheck"
                                    tibex:xpdlId="6d39f825-a475-43eb-8eef-f4cef805ae3e"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogCheckToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;LogCheck-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;VerificaValoreTotRichieste&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServicePacchetto_PortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;VerificaValoreTotRichieste&amp;quot;&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Start/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Confronto primo record con record indice: &amp;quot;, string($index))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;isUguale&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectPactoRich&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaValoreTotRichieste_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$isUguale=false()&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Richieste del pacchetto hanno diversa dataCreazione o diverso IDCorrelazione o diverso valore totRichieste'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectPactoRich/Record)!=$Start/tns:totRichiestePacchetto&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Numero di richieste riscontrate diverso dal valore totRichiestePacchetto'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaValoreTotRichieste_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Esito" name="Assign"
                    outputVariable="Esito"
                    tibex:xpdlId="41d66fa0-0822-46f8-b11d-713d7aa93f24" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControllidiPacchetto/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;isUguale&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;SelectPactoRich&quot;/>&lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&lt;tns:VerificaValoreTotRichieste_Response>&lt;xsl:choose>&lt;xsl:when test=&quot;$isUguale=false()&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Richieste del pacchetto hanno diversa dataCreazione o diverso IDCorrelazione o diverso valore totRichieste'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectPactoRich/Record)!=$Start/tns:totRichiestePacchetto&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Numero di richieste riscontrate diverso dal valore totRichiestePacchetto'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaValoreTotRichieste_Response>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Esito" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
