    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLoglnput" tibex:linkType="SUCCESS"/>
                <bpws:link name="LoglnputToJDBCQuery" tibex:linkType="SUCCESS"/>
                <bpws:link name="SelectPactoRichToLogPactoRich" tibex:linkType="SUCCESS"/>
