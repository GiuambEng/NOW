                                    <bpws:source linkName="GroupStartToCheck"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="d4e22e9c-8928-40af-8cd8-86299fbdd92e">
                                <bpws:targets>
                                    <bpws:target linkName="LogCheckToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if($SelectPactoRich/Record[1]/DATACREAZIONE=$SelectPactoRich/Record[number($index)]/DATACREAZIONE and $SelectPactoRich/Record[1]/IDCORRELAZIONE=$SelectPactoRich/Record[number($index)]/IDCORRELAZIONE and $SelectPactoRich/Record[1]/TOTALERICHIESTEPACCHETTO=$SelectPactoRich/Record[number($index)]/TOTALERICHIESTEPACCHETTO) then true() else false()"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="isUguale"
                                    name="Check"
                                    outputVariable="isUguale"
                                    tibex:xpdlId="4e510e5c-0498-4c08-9619-5e14d98dc990" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCheck"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($SelectPactoRich/Record[1]/DATACREAZIONE=$SelectPactoRich/Record[number($index)]/DATACREAZIONE and $SelectPactoRich/Record[1]/IDCORRELAZIONE=$SelectPactoRich/Record[number($index)]/IDCORRELAZIONE and $SelectPactoRich/Record[1]/TOTALERICHIESTEPACCHETTO=$SelectPactoRich/Record[number($index)]/TOTALERICHIESTEPACCHETTO) then true() else false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
