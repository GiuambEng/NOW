        <bpws:variable element="ns3:resultSet" name="SelectPactoRich" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:CW_BUS_MESSAGE"
            name="LogPactoRich-input" sca-bpel:internal="true"/>
