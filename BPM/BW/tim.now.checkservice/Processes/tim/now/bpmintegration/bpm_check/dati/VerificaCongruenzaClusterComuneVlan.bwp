                                    expression="exists($Oscuramento/Record[COD_AGESP='R1I-19-0416']) and not($Start/ns0:Offerta='VLANNGA' and $Start/ns0:Lavorazione='VARIAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[exists($Oscuramento/Record[COD_AGESP='R1I-19-0416']) and not($Start/ns0:Offerta='VLANNGA' and $Start/ns0:Lavorazione='VARIAZIONE')]]></bpws:transitionCondition>
