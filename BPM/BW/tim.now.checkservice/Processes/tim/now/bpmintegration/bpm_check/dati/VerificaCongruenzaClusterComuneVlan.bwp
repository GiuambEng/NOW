            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="TplgComuneAsset-input"
                    name="TplgComuneAsset"
                    outputVariable="TplgComuneAsset"
                    tibex:xpdlId="08a1c526-3d0a-4178-995b-7f9b5933fa4f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
