                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count(ass.idasset) as NUMERORECORD&#xa;from BDS_1_CASEDATA_DETTAGLIOASSET dett, BDS_1_CASEDATA_ATTRIBTDTTGLSST att , BDS_1_CASEDATA_ASSET ass&#xa;where att.DTTGLSST_TTRBTIDTTGLISST_BDSID=dett.BDS_ID and dett.asset_dettaglioasset_bdsid=ass.bds_id&#xa;and ass.OFFERTA NOT IN ('BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')&#xa;and ass.STATOASSET='ATTIVO' &#xa;and dett.NOMECOMPONENTE='USERVLAN' and att.NOMEATTRIBUTO='SVLANCODE' and att.VALOREATTRIBUTO=?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SVLANCODE"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="NUMERORECORD"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
