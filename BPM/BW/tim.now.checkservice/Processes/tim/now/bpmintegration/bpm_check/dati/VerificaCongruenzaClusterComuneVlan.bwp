                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+c2332fee-874b-453d-849e-fe962b25010f+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ISTAT-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDAsset>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns1:IdAsset)&quot;>&lt;xsl:value-of select=&quot;$Start/tns1:IdAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDAsset>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT S.CODICEISTATCOMUNE AS ISTATSEDE, ASS.CODICEISTATCOMUNE AS ISTATASSET&#xa;FROM BDS_1_CASEDATA_SEDE S&#xa;RIGHT JOIN BDS_1_CASEDATA_ASSET ASS ON S.IDRICHIESTAOLO=ASS.IDRICHIESTAOLO AND S.TIPOLOGIASEDE='SEDECLIENTECERT'&#xa;WHERE ASS.IDASSET=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDAsset"/>
                                    <columnMetadata
                                    columnName="ISTATSEDE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="ISTATASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
