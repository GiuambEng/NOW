            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="ISTAT-input"
                    name="ISTAT" outputVariable="ISTAT"
                    tibex:xpdlId="c2332fee-874b-453d-849e-fe962b25010f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogDatiVerificaCtrlToAssign_RU1022"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ISTATToCopy_1_LogDatiVerificaCtrl"/>
