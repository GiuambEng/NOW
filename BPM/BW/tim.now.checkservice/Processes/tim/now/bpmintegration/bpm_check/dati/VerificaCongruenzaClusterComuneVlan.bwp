                                    expression="not(exists($Oscuramento/Record[COD_AGESP='R1I-20-0150'])) and $Start/ns0:Offerta='VLANNGA' and $Start/ns0:Lavorazione='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
