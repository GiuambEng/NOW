                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count(rich.IDRICHIESTAOLO) as NUMERORECORD&#xa;from BDS_1_CASEDATA_DETTAGLIOORDINE dett, BDS_1_CASEDATA_ATTRIBTDTTGLRDN att , BDS_1_CASEDATA_ORDINE ord, BDS_1_CASEDATA_RICHIESTA rich&#xa;where att.DTTGLRDN_TTRBTDTTGLIRDIN_BDSID=dett.BDS_ID and dett.ORDINE_DETTAGLIOORDINE_BDSID=ord.BDS_ID and ord.IDRICHIESTAOLO=rich.IDRICHIESTAOLO&#xa;and rich.STATORICHIESTANOW NOT IN ('ESPLETAMENTOTECNICO','ESPLETAMENTOTECNICOKO','CHIUSO','ANNULLATO','SCARTATO','INVIATOAFATTURAZIONE','FATTURAZIONEKO','ACQUISITOKOD82','ACCETTATOKOD82','ESPLETATOKOD82','ESPLETATOD82','ANNULLATOD82')&#xa;and ord.OFFERTACATALOGO NOT IN ('VLAN','VLANNGA','VLANVULA','VP')&#xa;and dett.NOMECOMPONENTE='USERVLAN' and att.NOMEATTRIBUTO='SVLANCODE' and att.VALOREATTRIBUTO=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SVLANCODE"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="NUMERORECORD"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
