                <tibex:extActivity inputVariable="LogISTAT-input"
                    name="LogISTAT"
                    tibex:xpdlId="eeb685d1-0deb-4734-aedd-fe14b2c17272"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
