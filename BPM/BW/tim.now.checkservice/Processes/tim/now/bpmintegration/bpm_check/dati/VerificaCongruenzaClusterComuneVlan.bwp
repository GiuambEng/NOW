                    <bpws:sources>
                        <bpws:source linkName="ResponseVarVlanToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:param name=&quot;FtthOnlyAsset&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;TplgComuneAsset&quot;/>&lt;xsl:param name=&quot;TplgComuneOrdine&quot;/>&lt;xsl:template name=&quot;Variable&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Oscuramento/Record[COD_AGESP='R1I-20-0150'])&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($Start/tns:FtthOnlyConsistenza)) or string-length($Start/tns:FtthOnlyConsistenza)=0 or $Start/tns:FtthOnlyConsistenza='N') and $Start/tns:FtthOnly='Y' and $FtthOnlyAsset/Record[1]/NUMERORECORD>0&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipologiaClusterVlanConsistenza=('CC','LIB') and (not(exists($Start/tns:TipologiaClusterVlan)) or string-length($Start/tns:TipologiaClusterVlan)=0)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($TplgComuneAsset/Record[VALOREATTRIBUTO=('CC','LIB')])&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_03'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:TipologiaClusterVlanConsistenza=('CC','LIB') and $TplgComuneOrdine/Record[1]/NUMERORECORD>0&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_04'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($Start/tns:TipologiaClusterVlanConsistenza)) or string-length($Start/tns:TipologiaClusterVlanConsistenza)=0 or $Start/tns:TipologiaClusterVlanConsistenza='CC') and $Start/tns:TipologiaClusterVlan='LIB'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($TplgComuneAsset/Record[VALOREATTRIBUTO!='LIB'])&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_03'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$TplgComuneOrdine/Record[1]/NUMERORECORD>0&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_04'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;(not(exists($Start/tns:TipologiaClusterVlanConsistenza)) or string-length($Start/tns:TipologiaClusterVlanConsistenza)=0 or $Start/tns:TipologiaClusterVlanConsistenza='LIB') and $Start/tns:TipologiaClusterVlan='CC'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($TplgComuneAsset/Record)>0 and string-length($TplgComuneAsset/Record[1]/VALOREATTRIBUTO)=0&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_03'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;$TplgComuneOrdine/Record[1]/NUMERORECORD>0 and (not(exists($Start/tns:TipologiaClusterVlanConsistenza)) or string-length($Start/tns:TipologiaClusterVlanConsistenza)=0)&quot;>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_04'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaCongruenzaClusterComuneVlan_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
