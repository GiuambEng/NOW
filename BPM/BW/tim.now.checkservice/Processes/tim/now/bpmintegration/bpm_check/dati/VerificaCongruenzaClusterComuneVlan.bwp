                    <bpws:sources>
                        <bpws:source linkName="LogNumRecordToJDBCQuery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(not(exists($Start/ns0:FtthOnlyConsistenza)) or string-length($Start/ns0:FtthOnlyConsistenza)=0 or $Start/ns0:FtthOnlyConsistenza='N') and $Start/ns0:FtthOnly='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
