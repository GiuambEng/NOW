            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Variable"
                    name="ResponseVarVlan" outputVariable="Variable"
                    tibex:xpdlId="0fc45b7c-4020-4c81-a304-f4cc8ba4e53f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogNumRecordToAssign"/>
                        <bpws:target linkName="LogFtthOnlyAssetToAssign"/>
                        <bpws:target linkName="LogOscuramentoToAssign"/>
