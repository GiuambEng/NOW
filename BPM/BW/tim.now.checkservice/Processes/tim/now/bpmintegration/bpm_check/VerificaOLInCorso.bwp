                            <tibex:expression
                                expression="$Verifica_OL_in_CorsoIn/parameters/ns1:Verifica_OL_in_Corso/ns3:Lavorazione ='CESSAZIONE' or ($Verifica_OL_in_CorsoIn/parameters/ns1:Verifica_OL_in_Corso/ns3:Lavorazione ='VARIAZIONE' and $Verifica_OL_in_CorsoIn/parameters/ns1:Verifica_OL_in_Corso/ns3:SottoLavorazione = 'DECREMENTONP')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Verifica_OL_in_CorsoIn.parameters/ns3:Lavorazione ='CESSAZIONE' or ($Verifica_OL_in_CorsoIn.parameters/ns3:Lavorazione ='VARIAZIONE' and $Verifica_OL_in_CorsoIn.parameters/ns3:SottoLavorazione = 'DECREMENTONP')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
