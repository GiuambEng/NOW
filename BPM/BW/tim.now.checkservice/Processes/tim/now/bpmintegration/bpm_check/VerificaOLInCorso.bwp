                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;GetOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;Lock_RisorsaInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:ID_Risorsa>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:IdRisorsa&quot;/>&#xa;            &lt;/tns2:ID_Risorsa>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;'LOCK'&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CODICE_OLO>&#xa;            &lt;tns2:CODIFICA_OLO_AGICOM>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:CodificaOLOAGCOM&quot;/>&#xa;            &lt;/tns2:CODIFICA_OLO_AGICOM>&#xa;            &lt;tns2:SERVIZIO>&#xa;                &lt;xsl:value-of select=&quot;$GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;            &lt;/tns2:SERVIZIO>&#xa;            &lt;tns2:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns2:ID_RICH_OLO>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:Lavorazione&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            