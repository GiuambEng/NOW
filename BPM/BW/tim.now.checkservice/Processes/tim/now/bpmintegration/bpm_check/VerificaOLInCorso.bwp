                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Lock_RisorsaInvoke.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;GetOfferta&quot;/>&#xa;    &lt;xsl:template name=&quot;Call_EsitoMultiplo1-input&quot; match=&quot;/&quot;>&#xa;        &lt;em:EsitiMultipliRequest>&#xa;            &lt;em:IdRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/em:IdRichiesta>&#xa;            &lt;em:CodiceControllo>&#xa;                &lt;xsl:value-of select=&quot;'CTRL OL IN CORSO'&quot;/>&#xa;            &lt;/em:CodiceControllo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;starts-with(upper-case($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA), 'BITSTREAM') or starts-with(upper-case($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA), 'EASYIP') or starts-with(upper-case($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA), 'VULA') or starts-with(upper-case($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA), 'FIBERSTREAM') or starts-with(upper-case($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA), 'SEMI')&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Lock_RisorsaInvoke.Output/tns2:Esito/tns2:Codice = '02'&quot;>&#xa;                            &lt;em:EsitoControllo>&#xa;                                &lt;xsl:value-of select=&quot;'KO_03'&quot;/>&#xa;                            &lt;/em:EsitoControllo>&#xa;          