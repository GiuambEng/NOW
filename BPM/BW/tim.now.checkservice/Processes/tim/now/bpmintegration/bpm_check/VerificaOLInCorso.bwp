                        <bpws:transitionCondition><![CDATA[upper-case($Verifica_OL_in_CorsoIn.parameters/ns3:Lavorazione)='CESSAZIONE' and (starts-with($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA, 'WLR') or starts-with($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA, 'ULL') or starts-with($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA, 'SLU') or starts-with($GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA, 'VULL')) and string-length($Verifica_OL_in_CorsoIn.parameters/ns3:IdRisorsaCorrelata)>0]]></bpws:transitionCondition>
