                    &lt;/IdRisorsaBloccata&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$LockCorrelato/Output/tns2:Output/tns2:Esito/tns2:Codice !='10' and $LockCorrelato/Output/tns2:Output/tns2:Esito/tns2:Codice !='99'"&gt;
                            &lt;IdOlBloccante&gt;
                                &lt;xsl:value-of select="$LockCorrelato/Output/tns2:Output/tns2:Esito/tns2:Descrizione"/&gt;
                            &lt;/IdOlBloccante&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;IdOlBloccante&gt;
                                &lt;xsl:value-of select="$LockRisorsaCorrelata/Output/tns2:Output/tns2:Esito/tns2:Descrizione"/&gt;
                            &lt;/IdOlBloccante&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;!--Nella DESCRIZIONE di Lock è presente l'idOrdine NOW o CRMWS. da aggiornare con cambio interfaccia su output LockUnlock.--&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="starts-with($LockRisorsaCorrelata/Output/tns2:Output/tns2:Esito/tns2:Descrizione, &amp;quot;pvm&amp;quot;) or starts-with($LockCorrelato/Output/tns2:Output/tns2:Esito/tns2:Descrizione, &amp;quot;pvm&amp;quot;)"&gt;
