                    &lt;/tns2:CODICE_OLO&gt;
                    &lt;tns2:CODIFICA_OLO_AGICOM&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:CodificaOLOAGCOM"/&gt;
                    &lt;/tns2:CODIFICA_OLO_AGICOM&gt;
