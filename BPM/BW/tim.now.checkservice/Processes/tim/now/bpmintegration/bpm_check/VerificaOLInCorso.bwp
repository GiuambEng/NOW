    &lt;xsl:param name="LockRisorsaCorrelata"/&gt;
    &lt;xsl:template name="StoricizzaOL_2-input" match="/"&gt;
        &lt;tns5:StoricizzaOLinCorsoRequest&gt;
            &lt;Input&gt;
