            <bpws:invoke inputVariable="LockCorrelato-input"
                name="LockCorrelato" operation="Lock_Unlock"
                outputVariable="LockCorrelato"
                partnerLink="Lock_Risorsa" portType="ns2:LockPortType" tibex:xpdlId="45909bdf-a145-4629-be28-4d4d81936196">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/" xmlns:tns2="http://www.tim.com/NOW/xsd/Lock_Risorsa/" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" version="2.0"&gt;
    &lt;xsl:param name="Verifica_OL_in_CorsoIn"/&gt;
    &lt;xsl:param name="GetOfferta"/&gt;
    &lt;xsl:param name="GetNPCorrelata"/&gt;
    &lt;xsl:template name="LockCorrelato-input" match="/"&gt;
        &lt;tns4:Lock_UnlockRequest&gt;
            &lt;Input&gt;
                &lt;tns2:Input&gt;
                    &lt;tns2:ID_Risorsa&gt;
                        &lt;xsl:value-of select="$GetNPCorrelata/Record[1]/IDRISORSA"/&gt;
                    &lt;/tns2:ID_Risorsa&gt;
                    &lt;tns2:Azione&gt;
                        &lt;xsl:value-of select="'LOCK'"/&gt;
                    &lt;/tns2:Azione&gt;
                    &lt;tns2:CODICE_OLO&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:CodiceOLO"/&gt;
                    &lt;/tns2:CODICE_OLO&gt;
                    &lt;xsl:if test="$GetNPCorrelata/Record[1]/CODIFICAOLOAGCOM"&gt;
                        &lt;tns2:CODIFICA_OLO_AGICOM&gt;
                            &lt;xsl:value-of select="$GetNPCorrelata/Record[1]/CODIFICAOLOAGCOM"/&gt;
                        &lt;/tns2:CODIFICA_OLO_AGICOM&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns2:SERVIZIO&gt;
                        &lt;xsl:value-of select="$GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA"/&gt;
                    &lt;/tns2:SERVIZIO&gt;
                    &lt;tns2:ID_RICH_OLO&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:IDRichiestaOLO"/&gt;
                    &lt;/tns2:ID_RICH_OLO&gt;
                    &lt;tns2:Lavorazione&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:Lavorazione"/&gt;
                    &lt;/tns2:Lavorazione&gt;
                    &lt;xsl:if test="$GetNPCorrelata/Record[1]/CODICEORDINEOLO"&gt;
                        &lt;tns2:CodiceOrdineOLO&gt;
                            &lt;xsl:value-of select="$GetNPCorrelata/Record[1]/CODICEORDINEOLO"/&gt;
                        &lt;/tns2:CodiceOrdineOLO&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$GetNPCorrelata/Record[1]/IDASSET"&gt;
                        &lt;tns2:IdAsset&gt;
                            &lt;xsl:value-of select="$GetNPCorrelata/Record[1]/IDASSET"/&gt;
                        &lt;/tns2:IdAsset&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns2:Input&gt;
            &lt;/Input&gt;
        &lt;/tns4:Lock_UnlockRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;GetOfferta&quot;/>&#xa;    &lt;xsl:param name=&quot;GetNPCorrelata&quot;/>&#xa;    &lt;xsl:template name=&quot;LockCorrelato-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:ID_Risorsa>&#xa;                &lt;xsl:value-of select=&quot;$GetNPCorrelata/Record[1]/IDRISORSA&quot;/>&#xa;            &lt;/tns2:ID_Risorsa>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;'LOCK'&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;tns2:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns2:CODICE_OLO>&#xa;            &lt;xsl:if test=&quot;$GetNPCorrelata/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                &lt;tns2:CODIFICA_OLO_AGICOM>&#xa;                    &lt;xsl:value-of select=&quot;$GetNPCorrelata/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                &lt;/tns2:CODIFICA_OLO_AGICOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:SERVIZIO>&#xa;                &lt;xsl:value-of select=&quot;$GetOfferta/Record[1]/NOME_OFFERTA_ESTERNA&quot;/>&#xa;            &lt;/tns2:SERVIZIO>&#xa;            &lt;tns2:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns2:ID_RICH_OLO>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:Lavorazione&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;xsl:if test=&quot;$GetNPCorrelata/Record[1]/CODICEORDINEOLO&quot;>&#xa;                &lt;tns2:CodiceOrdineOLO>&#xa;                    &lt;xsl:value-of select=&quot;$GetNPCorrelata/Record[1]/CODICEORDINEOLO&quot;/>&#xa;                &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GetNPCorrelata/Record[1]/IDASSET&quot;>&#xa;                &lt;tns2:IdAsset>&#xa;                    &lt;xsl:value-of select=&quot;$GetNPCorrelata/Record[1]/IDASSET&quot;/>&#xa;                &lt;/tns2:IdAsset>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LogGetNPCorrelataToLockCorrelato"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LockCorrelatoToCallProcess"/>
                </bpws:sources>
