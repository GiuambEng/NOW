            <bpws:reply name="LockRisorsaFalse1"
                operation="Verifica_OL_in_Corso"
                partnerLink="BPM_CheckPortType"
                portType="ns1:BPM_CheckPortType"
                tibex:xpdlId="6ec75a85-28dc-4b4d-8c6c-a3054ce9d792" variable="LockRisorsaFalse1-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" xmlns:tns2="http://www.tim.com/NOW/xsd/Lock_Risorsa/" version="2.0"&gt;
    &lt;xsl:param name="GetTipoRichiesta"/&gt;
    &lt;xsl:param name="Lock_RisorsaInvoke"/&gt;
    &lt;xsl:param name="Call_EsitoMultiplo1"/&gt;
    &lt;xsl:template name="LockRisorsaFalse1-input" match="/"&gt;
        &lt;tns1:Verifica_OL_in_CorsoResponse&gt;
            &lt;parameters&gt;
                &lt;tns1:Verifica_OL_in_CorsoResponse&gt;
                    &lt;tns:Codice&gt;
                        &lt;xsl:value-of select="false()"/&gt;
                    &lt;/tns:Codice&gt;
                    &lt;tns:Descrizione&gt;
                        &lt;xsl:value-of select="'KO'"/&gt;
                    &lt;/tns:Descrizione&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length(string($Call_EsitoMultiplo1/em:IdAnagraficaCausale)) &gt; 0"&gt;
                            &lt;xsl:if test="$Call_EsitoMultiplo1/em:IdAnagraficaCausale"&gt;
                                &lt;tns:idCausale&gt;
                                    &lt;xsl:value-of select="$Call_EsitoMultiplo1/em:IdAnagraficaCausale"/&gt;
                                &lt;/tns:idCausale&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:when test="$Lock_RisorsaInvoke/Output/tns2:Output/tns2:Esito/tns2:Codice = '10' and $GetTipoRichiesta/Record[1]/TIPORICHIESTA = 'RICARICA'"&gt;
                            &lt;tns:idCausale&gt;
                                &lt;xsl:value-of select="591"/&gt;
                            &lt;/tns:idCausale&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns1:Verifica_OL_in_CorsoResponse&gt;
            &lt;/parameters&gt;
        &lt;/tns1:Verifica_OL_in_CorsoResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock_RisorsaInvoke.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;GetTipoRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_EsitoMultiplo1&quot;/>&#xa;    &lt;xsl:template name=&quot;LockRisorsaFalse1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_OL_in_CorsoResponse>&#xa;            &lt;tns:Codice>&#xa;                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;            &lt;/tns:Codice>&#xa;            &lt;tns:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;            &lt;/tns:Descrizione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($Call_EsitoMultiplo1/em:IdAnagraficaCausale)) > 0&quot;>&#xa;                    &lt;xsl:if test=&quot;$Call_EsitoMultiplo1/em:IdAnagraficaCausale&quot;>&#xa;                        &lt;tns:idCausale>&#xa;                            &lt;xsl:value-of select=&quot;$Call_EsitoMultiplo1/em:IdAnagraficaCausale&quot;/>&#xa;                        &lt;/tns:idCausale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Lock_RisorsaInvoke.Output/tns2:Esito/tns2:Codice = '10' and $GetTipoRichiesta/Record[1]/TIPORICHIESTA = 'RICARICA'&quot;>&#xa;                    &lt;tns:idCausale>&#xa;                        &lt;xsl:value-of select=&quot;591&quot;/>&#xa;                    &lt;/tns:idCausale>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:Verifica_OL_in_CorsoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
