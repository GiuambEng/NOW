                        &lt;/tns2:CODIFICA_OLO_AGICOM&gt;
                    &lt;/xsl:if&gt;
                    &lt;tns2:SERVIZIO&gt;
                        &lt;xsl:value-of select="$GetRisorsaCorrelata/Record[1]/OFFERTA"/&gt;
                    &lt;/tns2:SERVIZIO&gt;
                    &lt;tns2:ID_RICH_OLO&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:IDRichiestaOLO"/&gt;
                    &lt;/tns2:ID_RICH_OLO&gt;
                    &lt;tns2:Lavorazione&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:Lavorazione"/&gt;
                    &lt;/tns2:Lavorazione&gt;
                    &lt;tns2:CodiceOrdineOLO&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:CodiceOrdineOLO"/&gt;
                    &lt;/tns2:CodiceOrdineOLO&gt;
                    &lt;xsl:if test="$GetRisorsaCorrelata/Record[1]/IDASSET"&gt;
                        &lt;tns2:IdAsset&gt;
                            &lt;xsl:value-of select="$GetRisorsaCorrelata/Record[1]/IDASSET"/&gt;
                        &lt;/tns2:IdAsset&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns2:Input&gt;
            &lt;/Input&gt;
        &lt;/tns4:Lock_UnlockRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;GetRisorsaCorrelata&quot;/>&#xa;    &lt;xsl:template name=&quot;LockRisorsaCorrelata-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:Input>&#xa;            &lt;tns2:ID_Risorsa>&#xa;                &lt;xsl:value-of select=&quot;$GetRisorsaCorrelata/Record[1]/IDRISORSA&quot;/>&#xa;            &lt;/tns2:ID_Risorsa>&#xa;            &lt;tns2:Azione>&#xa;                &lt;xsl:value-of select=&quot;'LOCK'&quot;/>&#xa;            &lt;/tns2:Azione>&#xa;            &lt;xsl:if test=&quot;$GetRisorsaCorrelata/Record[1]/COD_OLO&quot;>&#xa;                &lt;tns2:CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$GetRisorsaCorrelata/Record[1]/COD_OLO&quot;/>&#xa;                &lt;/tns2:CODICE_OLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$GetRisorsaCorrelata/Record[1]/CODIFICAOLOAGCOM&quot;>&#xa;                &lt;tns2:CODIFICA_OLO_AGICOM>&#xa;                    &lt;xsl:value-of select=&quot;$GetRisorsaCorrelata/Record[1]/CODIFICAOLOAGCOM&quot;/>&#xa;                &lt;/tns2:CODIFICA_OLO_AGICOM>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:SERVIZIO>&#xa;                &lt;xsl:value-of select=&quot;$GetRisorsaCorrelata/Record[1]/OFFERTA&quot;/>&#xa;            &lt;/tns2:SERVIZIO>&#xa;            &lt;tns2:ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns2:ID_RICH_OLO>&#xa;            &lt;tns2:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:Lavorazione&quot;/>&#xa;            &lt;/tns2:Lavorazione>&#xa;            &lt;tns2:CodiceOrdineOLO>&#xa;                &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:CodiceOrdineOLO&quot;/>&#xa;            &lt;/tns2:CodiceOrdineOLO>&#xa;            &lt;xsl:if test=&quot;$GetRisorsaCorrelata/Record[1]/IDASSET&quot;>&#xa;                &lt;tns2:IdAsset>&#xa;                    &lt;xsl:value-of select=&quot;$GetRisorsaCorrelata/Record[1]/IDASSET&quot;/>&#xa;                &lt;/tns2:IdAsset>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns2:Input>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="JDBCQueryToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="LockRisorsaCorrelataToCallProcess"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e1fa66a7-9e06-4039-8a22-6417583886cf+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSACORRELATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:IdRisorsaCorrelata)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:IdRisorsaCorrelata&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSACORRELATO>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="GetRisorsaCorrelata-input"
                    name="GetRisorsaCorrelata"
                    outputVariable="GetRisorsaCorrelata"
                    tibex:xpdlId="e1fa66a7-9e06-4039-8a22-6417583886cf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToJDBCQuery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToInvoke"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e1fa66a7-9e06-4039-8a22-6417583886cf+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IDRISORSACORRELATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Verifica_OL_in_CorsoIn.parameters/tns:IdRisorsaCorrelata)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:IdRisorsaCorrelata&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSACORRELATO>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT A.IDRISORSA, O.COD_OLO, A.CODIFICAOLOAGCOM, A.OFFERTA, A.IDASSET&#xa;FROM BDS_1_CASEDATA_ASSET A JOIN OLO O &#xa;on A.CODIFICAOLOAGCOM=O.CODFC_OLO_AGCOM&#xa;WHERE IDRISORSA=?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSACORRELATO"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODIFICAOLOAGCOM"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;LockRisorsaCorrelata&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaOLinCorso&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Verifica_OL_in_Corso&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Invoke LockRisorsaCorrelata result: &amp;quot;, tib:render-xml($LockRisorsaCorrelata/Output/tns2:Output, true(), true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogLockRisorsaCorrelata-input"
                    name="LogLockRisorsaCorrelata"
                    tibex:xpdlId="33bfd062-00e6-4580-a4f8-d19805acc139"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LockRisorsaCorrelataToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogLockRisorsaCorrelataToGetNumPrincipale">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$LockRisorsaCorrelata/Output/tns:Output/tns:Esito/tns:Codice='00' or $LockRisorsaCorrelata/Output/tns:Output/tns:Esito/tns:Codice='03'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[$LockRisorsaCorrelata.Output/tns:Esito/tns:Codice='00' or $LockRisorsaCorrelata.Output/tns:Esito/tns:Codice='03']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogLockRisorsaCorrelataToUnlockRisorsa">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Verifica_OL_in_CorsoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LockRisorsaCorrelata.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaOLinCorso&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Verifica_OL_in_Corso&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;tns4:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Verifica_OL_in_CorsoIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns4:BusinessID>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Invoke LockRisorsaCorrelata result: &amp;quot;, tib:render-xml($LockRisorsaCorrelata.Output, true(), true()))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="StoricizzaOL_1-input"
                name="StoricizzaOL_1" operation="StoricizzaOLinCorso"
                outputVariable="StoricizzaOL_1"
                partnerLink="GestioneEsitiMultipli"
                portType="ns15:EsitiMultipliPortType" tibex:xpdlId="65111ada-7834-4a57-bacd-f5bedc02935c">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/EsitiMultipli/" xmlns:tns3="http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/" xmlns:tns2="http://www.tim.com/NOW/xsd/Lock_Risorsa/" version="2.0"&gt;
    &lt;xsl:param name="Verifica_OL_in_CorsoIn"/&gt;
    &lt;xsl:param name="Lock_RisorsaInvoke"/&gt;
    &lt;xsl:template name="StoricizzaOL_1-input" match="/"&gt;
        &lt;tns5:StoricizzaOLinCorsoRequest&gt;
            &lt;Input&gt;
                &lt;tns3:StoricizzaOLinCorsoRequest&gt;
                    &lt;IdRisorsaBloccata&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:IdRisorsa"/&gt;
                    &lt;/IdRisorsaBloccata&gt;
                    &lt;IdOlBloccante&gt;
                        &lt;xsl:value-of select="$Lock_RisorsaInvoke/Output/tns2:Output/tns2:Esito/tns2:Descrizione"/&gt;
                    &lt;/IdOlBloccante&gt;
                    &lt;!--Nella DESCRIZIONE di Lock è presente l'idOrdine NOW o CRMWS. da aggiornare con cambio interfaccia su output LockUnlock.--&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="starts-with($Lock_RisorsaInvoke/Output/tns2:Output/tns2:Esito/tns2:Descrizione, &amp;quot;pvm&amp;quot;)"&gt;
                            &lt;SistemaCoinvolto&gt;
                                &lt;xsl:value-of select="&amp;quot;NOW&amp;quot;"/&gt;
                            &lt;/SistemaCoinvolto&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;SistemaCoinvolto&gt;
                                &lt;xsl:value-of select="&amp;quot;CRMWS&amp;quot;"/&gt;
                            &lt;/SistemaCoinvolto&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;IdAsset&gt;
                        &lt;xsl:value-of select="$Verifica_OL_in_CorsoIn/parameters/tns1:Verifica_OL_in_Corso/tns:IdAsset"/&gt;
                    &lt;/IdAsset&gt;
                &lt;/tns3:StoricizzaOLinCorsoRequest&gt;
            &lt;/Input&gt;
        &lt;/tns5:StoricizzaOLinCorsoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
