                    &lt;tns2:Azione&gt;
                        &lt;xsl:value-of select="'LOCK'"/&gt;
                    &lt;/tns2:Azione&gt;
                    &lt;xsl:if test="$GetRisorsaCorrelata/Record[1]/COD_OLO"&gt;
