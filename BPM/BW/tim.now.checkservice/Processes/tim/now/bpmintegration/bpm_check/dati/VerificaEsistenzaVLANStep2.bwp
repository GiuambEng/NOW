                                tibex:group="groupStart" tibex:xpdlId="ab5daca2-c80d-4e3e-8886-e149edb25900">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart2ToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
