                                expression="$Variable/ns0:Codice=false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Variable/ns0:Codice=false()]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;= count($Start/ns0:NGA-VULA/ns0:UserVlan)  and $Variable/ns0:Codice =true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<= count($Start/ns0:NGA-VULA/ns0:UserVlan)  and $Variable/ns0:Codice =true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SelectOLOVLANToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessToAssign" tibex:linkType="SUCCESS"/>
