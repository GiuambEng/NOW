if test=&quot;$JDBCQuery/Record[1]/CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/TIPOLG&quot;>&lt;tns:TIPOLOGIA>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/TIPOLG&quot;/>&lt;/tns:TIPOLOGIA>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/COD_KIT&quot;>&lt;tns:CODICE_KIT>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/COD_KIT&quot;/>&lt;/tns:CODICE_KIT>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/DSLAM_TYPE&quot;>&lt;tns:DSLAM_TYPE>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/DSLAM_TYPE&quot;/>&lt;/tns:DSLAM_TYPE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$JDBCQuery/Record[1]/TIPO_COS =&amp;quot;BMD&amp;quot;&quot;>&lt;tns:BMD>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:BMD>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:BMD>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:BMD>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$JDBCQuery/Record[1]/TIPO_TRASPORTO&quot;>&lt;tns:TIPO_TRASPORTO>&lt;xsl:value-of select=&quot;$JDBCQuery/Record[1]/TIPO_TRASPORTO&quot;/>&lt;/tns:TIPO_TRASPORTO>&lt;/xsl:if>&lt;/tns:VLAN>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaEsistenzaVLANResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
