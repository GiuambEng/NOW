                                    expression="starts-with($Start/ns0:Offerta, &quot;BITSTREAMGBEAS&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[starts-with($Start/ns0:Offerta, "BITSTREAMGBEAS")]]></bpws:transitionCondition>
