                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link name="GroupStart2ToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQueryToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToAccumulate" tibex:linkType="SUCCESS"/>
                            </bpws:links>
