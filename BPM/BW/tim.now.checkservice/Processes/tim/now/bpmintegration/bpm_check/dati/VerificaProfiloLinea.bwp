                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaProfiloLinea.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;QuerySelectFlag&quot;/>&#xa;    &lt;xsl:template name=&quot;VerProfLin&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$QuerySelectFlag/Record[1]/FLAG_OSCURABILE = &amp;quot;Y&amp;quot; or count($QuerySelectFlag/Record)=0&quot;>&#xa;                &lt;tns:VerificaProfiloLineaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;'KO_01'&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaProfiloLineaResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$QuerySelectFlag/Record[1]/FLAG_VENDIBILITA != 'Y'&quot;>&#xa;                &lt;tns:VerificaProfiloLineaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;'KO_02'&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaProfiloLineaResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;starts-with($VerificaProfiloLinea.parameters/tns:Offerta, 'BITSTREAMATMSIMMETRICO') and $VerificaProfiloLinea.parameters/tns:VariazioneDatiVC=true() &quot;>&#xa;                &lt;tns:VerificaProfiloLineaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;'KO_03'&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaProfiloLineaResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VerificaProfiloLineaResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaProfiloLineaResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
