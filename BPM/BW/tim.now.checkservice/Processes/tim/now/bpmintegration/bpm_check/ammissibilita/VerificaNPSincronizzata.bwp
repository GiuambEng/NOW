                       &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
