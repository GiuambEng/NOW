                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDnTLC&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDnOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDnTLC2&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DN_flag>&#xa;            &lt;tns:DN>&#xa;                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)]&quot;/>&#xa;            &lt;/tns:DN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$index = 1&quot;>&#xa;                    &lt;tns:FlagAggiuntivo>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns:FlagAggiuntivo>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:FlagAggiuntivo>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                    &lt;/tns:FlagAggiuntivo>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM != &amp;quot;TLC&amp;quot;&quot;>&#xa;                    &lt;tns:CasoNP>&#xa;                        &lt;xsl:value-of select=&quot;3&quot;/>&#xa;                    &lt;/tns:CasoNP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($CheckDnTLC/Record/CODIFICAOLOAGCOM)>0 or count($CheckDnTLC2/Record/CODIFICAOLOAGCOM)>0&quot;>&#xa;                    &lt;tns:CasoNP>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns:CasoNP>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:CasoNP>&#xa;                        &lt;xsl:value-of select=&quot;2&quot;/>&#xa;                    &lt;/tns:CasoNP>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM&quot;>&#xa;                &lt;tns:DonorDIOGENE>&#xa;                    &lt;xsl:value-of select=&quot;$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM&quot;/>&#xa;                &lt;/tns:DonorDIOGENE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CheckDnTLC)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$CheckDnTLC/Record&quot;>&#xa;                        &lt;tns:AttributoAsset>&#xa;                            &lt;xsl:if test=&quot;IDASSET&quot;>&#xa;                                &lt;tns:IdAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                                &lt;/tns:IdAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns:IdRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns:IdRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:IdDettaglioAsset>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(IDDETTAGLIOASSET)&quot;/>&#xa;                            &lt;/tns:IdDettaglioAsset>&#xa;                            &lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&#xa;                                &lt;tns:NomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&#xa;                                &lt;/tns:NomeAttributo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&#xa;                                &lt;tns:ValoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&#xa;                                &lt;/tns:ValoreAttributo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns:CodificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns:CodificaOLOAGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                &lt;tns:NumeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                &lt;/tns:NumeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:AttributoAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:for-each select=&quot;$CheckDnTLC2/Record&quot;>&#xa;                        &lt;tns:AttributoAsset>&#xa;                            &lt;xsl:if test=&quot;IDASSET&quot;>&#xa;                                &lt;tns:IdAsset>&#xa;                                    &lt;xsl:value-of select=&quot;IDASSET&quot;/>&#xa;                                &lt;/tns:IdAsset>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;IDRISORSA&quot;>&#xa;                                &lt;tns:IdRisorsa>&#xa;                                    &lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&#xa;                                &lt;/tns:IdRisorsa>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns:IdDettaglioAsset>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int(IDDETTAGLIOASSET)&quot;/>&#xa;                            &lt;/tns:IdDettaglioAsset>&#xa;                            &lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&#xa;                                &lt;tns:NomeAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&#xa;                                &lt;/tns:NomeAttributo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&#xa;                                &lt;tns:ValoreAttributo>&#xa;                                    &lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&#xa;                                &lt;/tns:ValoreAttributo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&#xa;                                &lt;tns:CodificaOLOAGCOM>&#xa;                                    &lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&#xa;                                &lt;/tns:CodificaOLOAGCOM>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&#xa;                                &lt;tns:NumeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&#xa;                                &lt;/tns:NumeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:AttributoAsset>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:DN_flag>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
