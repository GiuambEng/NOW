                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if ($CheckDnOLO/Record[1]/CODFC_OLO_AGCOM != &quot;TLC&quot; &#xd;&#xa;     or (exists($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia/tns:AssetBTWhiteList) and $VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia/tns:AssetBTWhiteList='TIM EX BT') &#xd;&#xa;&#x9; or (exists($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaDati/tns:AssetBTWhiteList) and $VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaDati/tns:AssetBTWhiteList='TIM EX BT') ) then true() &#xd;&#xa;else&#xd;&#xa; if(exists($CheckDnTLC/Record[1]) and not(exists($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntiveFase2))) then true() &#xd;&#xa; else&#xd;&#xa; if(exists($CheckDnTLC2/Record[1]) and not(exists($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntiveFase2))) then true() &#xd;&#xa;else&#xd;&#xa; if(exists($CheckDnTLC/Record[1]) and contains(tib:concat-sequence-format($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntiveFase2, &quot;','&quot;), $VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)])) then true() &#xd;&#xa; else&#xd;&#xa; if(exists($CheckDnTLC2/Record[1]) and contains(tib:concat-sequence-format($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntiveFase2, &quot;','&quot;), $VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)])) then true() &#xd;&#xa; else false()"
