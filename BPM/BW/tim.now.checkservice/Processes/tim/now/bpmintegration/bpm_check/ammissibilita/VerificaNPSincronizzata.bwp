                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CheckDonorOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDonorOLO_2&quot;/>&#xa;    &lt;xsl:param name=&quot;EsitiMultipli4&quot;/>&#xa;    &lt;xsl:template name=&quot;Esito&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_NP_Sincronizzata_Response>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CheckDonorOLO=true() and starts-with($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:Offerta, 'VULL')&quot;>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($CheckDonorOLO_2/Record)=0 and $CheckDonorOLO=false()&quot;>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;        