                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0d04cc96-5acf-42a3-890c-44a09bbe7e33+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckDonorOLO_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;COD_DIST>&#xa;                &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;            &lt;/COD_DIST>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;number($index)&amp;lt;=count($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive)&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                            &lt;DN>&#xa;                                &lt;xsl:value-of select=&quot;substring($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)],3)&quot;/>&#xa;                            &lt;/DN>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;DN>&#xa;                                &lt;xsl:value-of select=&quot;substring-after($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)], $Distretto)&quot;/>&#xa;                            &lt;/DN>&#xa;                        &lt;/xsl:otherwise>&#xa; 