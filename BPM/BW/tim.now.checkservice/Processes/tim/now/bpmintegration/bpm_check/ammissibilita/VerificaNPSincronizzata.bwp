                                    expression="if (number($index)>count($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive)) then &#xd;&#xa;(if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 2, 1) = &quot;6&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 1, 2)) else if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;0&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;1&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;5&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;9&quot;) then substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 1, 3) else substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 2, 3)) &#xd;&#xa;else&#xd;&#xa;(if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 2, 1) = &quot;6&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 1, 2)) else if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;0&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;1&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sinc