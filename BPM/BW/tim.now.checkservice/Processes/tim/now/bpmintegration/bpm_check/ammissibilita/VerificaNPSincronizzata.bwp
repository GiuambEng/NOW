                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="c3710718-4cd3-48d1-af24-d3f8f08e63a4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
