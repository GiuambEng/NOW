                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d27f0e45-712b-4566-afd6-af3f1853b731+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckDnTLC2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;number($index)&amp;lt;=count($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive)&quot;>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)])&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)]&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DN)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DN&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaFonia/tns2:Azione) and $VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaFonia/tns2:Azione='D'&quot;>&#xa;                    &lt;CODIFICAOLOAGCOM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaFonia/tns2:CodificaOLOAGCOMDonating)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaFonia/tns2:CodificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODIFICAOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODIFICAOLOAGCOM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaDati/tns2:CodificaOLOAGCOMDonating)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaDati/tns2:CodificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODIFICAOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CheckDnTLC2-input"
                                    name="CheckDnTLC2"
                                    outputVariable="CheckDnTLC2"
                                    tibex:xpdlId="d27f0e45-712b-4566-afd6-af3f1853b731" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="Empty2ToCheckDnTLC2"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckDnTLC2ToLogCheckTLC"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+d27f0e45-712b-4566-afd6-af3f1853b731+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckDnTLC2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;number($index)&amp;lt;=count($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive)&quot;>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)])&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)]&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:DN)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:DN&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:ConsistenzaFonia/tns2:Azione) and $VerificaNPSincronizzataIn.input/tns1:ConsistenzaFonia/tns2:Azione='D'&quot;>&#xa;                    &lt;CODIFICAOLOAGCOM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:ConsistenzaFonia/tns2:CodificaOLOAGCOMDonating)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:ConsistenzaFonia/tns2:CodificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODIFICAOLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODIFICAOLOAGCOM>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:ConsistenzaDati/tns2:CodificaOLOAGCOMDonating)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:ConsistenzaDati/tns2:CodificaOLOAGCOMDonating&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODIFICAOLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT dett.IDASSET,dett.IDRISORSA,dett.IDDETTAGLIOASSET,att.NOMEATTRIBUTO,att.VALOREATTRIBUTO,ass.CODIFICAOLOAGCOM,ass.NUMEROTELEFONICO &#xa;FROM BDS_1_CASEDATA_ASSET ass LEFT OUTER JOIN BDS_1_CASEDATA_DETTAGLIOASSET dett ON ass.BDS_ID=dett.ASSET_DETTAGLIOASSET_BDSID &#xa;LEFT OUTER JOIN BDS_1_CASEDATA_ATTRIBTDTTGLSST att ON dett.BDS_ID=att.DTTGLSST_TTRBTIDTTGLISST_BDSID&#xa;WHERE &#xa;ass.STATOASSET IN ('ATTIVO','INLAVORAZIONE') &#xa;AND &#xa;ass.IDRISORSA=?&#xa;AND&#xa;ass.CODIFICAOLOAGCOM=?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODIFICAOLOAGCOM"/>
                                    <columnMetadata
