                                    <bpws:transitionCondition><![CDATA[(exists($VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia/tns:Azione) and $VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia/tns:Azione='D') or (exists($VerificaNPSincronizzataIn.input/ns3:ConsistenzaDati/tns:Azione) and $VerificaNPSincronizzataIn.input/ns3:ConsistenzaDati/tns:Azione='D')]]></bpws:transitionCondition>
