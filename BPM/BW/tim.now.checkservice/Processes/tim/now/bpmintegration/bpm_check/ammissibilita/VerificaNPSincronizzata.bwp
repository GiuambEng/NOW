                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDnTLC2&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDnTLC&quot;/>&#xa;    &lt;xsl:template name=&quot;LogCheckTLC-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CheckDnTLC/Record)&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultato query CheckDnTLC per DN ',$VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)],tib:render-xml($CheckDnTLC))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($CheckDnTLC2/Record)&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Risultato query CheckDnTLC2 per DN ',$VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)],tib:render-xml($CheckDnTLC2))&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Nessun risultato in asset per DN ',$VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)])&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaNPSincronizzata_', $VerificaNPSincronizzataIn.input/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
