                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NP_sincronizzata&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;CheckDnTLC&quot;/>&lt;xsl:param name=&quot;CheckDnOLO&quot;/>&lt;xsl:param name=&quot;CheckDnTLC2&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns:DN_flag>&lt;tns:DN>&lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)]&quot;/>&lt;/tns:DN>&lt;xsl:choose>&lt;xsl:when test=&quot;$index = 1&quot;>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:FlagAggiuntivo>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:FlagAggiuntivo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM != &amp;quot;TLC&amp;quot;&quot;>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;3&quot;/>&lt;/tns:CasoNP>&lt;/xsl:when>&lt;xsl:when test=&quot;count($CheckDnTLC/Record/CODIFICAOLOAGCOM)>0 or count($CheckDnTLC2/Record/CODIFICAOLOAGCOM)>0&quot;>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns:CasoNP>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:CasoNP>&lt;xsl:value-of select=&quot;2&quot;/>&lt;/tns:CasoNP>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM&quot;>&lt;tns:DonorDIOGENE>&lt;xsl:value-of select=&quot;$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM&quot;/>&lt;/tns:DonorDIOGENE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CheckDnTLC)&quot;>&lt;xsl:for-each select=&quot;$CheckDnTLC/Record&quot;>&lt;tns:AttributoAsset>&lt;xsl:if test=&quot;IDASSET&quot;>&lt;tns:IdAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:IdAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:if>&lt;tns:IdDettaglioAsset>&lt;xsl:value-of select=&quot;xsd:int(IDDETTAGLIOASSET)&quot;/>&lt;/tns:IdDettaglioAsset>&lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&lt;tns:NomeAttributo>&lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&lt;/tns:NomeAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&lt;tns:ValoreAttributo>&lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&lt;/tns:ValoreAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:NumeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:NumeroTelefonico>&lt;/xsl:if>&lt;/tns:AttributoAsset>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$CheckDnTLC2/Record&quot;>&lt;tns:AttributoAsset>&lt;xsl:if test=&quot;IDASSET&quot;>&lt;tns:IdAsset>&lt;xsl:value-of select=&quot;IDASSET&quot;/>&lt;/tns:IdAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;IDRISORSA&quot;>&lt;tns:IdRisorsa>&lt;xsl:value-of select=&quot;IDRISORSA&quot;/>&lt;/tns:IdRisorsa>&lt;/xsl:if>&lt;tns:IdDettaglioAsset>&lt;xsl:value-of select=&quot;xsd:int(IDDETTAGLIOASSET)&quot;/>&lt;/tns:IdDettaglioAsset>&lt;xsl:if test=&quot;NOMEATTRIBUTO&quot;>&lt;tns:NomeAttributo>&lt;xsl:value-of select=&quot;NOMEATTRIBUTO&quot;/>&lt;/tns:NomeAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;VALOREATTRIBUTO&quot;>&lt;tns:ValoreAttributo>&lt;xsl:value-of select=&quot;VALOREATTRIBUTO&quot;/>&lt;/tns:ValoreAttributo>&lt;/xsl:if>&lt;xsl:if test=&quot;CODIFICAOLOAGCOM&quot;>&lt;tns:CodificaOLOAGCOM>&lt;xsl:value-of select=&quot;CODIFICAOLOAGCOM&quot;/>&lt;/tns:CodificaOLOAGCOM>&lt;/xsl:if>&lt;xsl:if test=&quot;NUMEROTELEFONICO&quot;>&lt;tns:NumeroTelefonico>&lt;xsl:value-of select=&quot;NUMEROTELEFONICO&quot;/>&lt;/tns:NumeroTelefonico>&lt;/xsl:if>&lt;/tns:AttributoAsset>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:DN_flag>&lt;/xsl:template>&lt;/xsl:stylesheet>"
