                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9c56eaf9-d7b2-401b-a873-ad6d9b5d8c64+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckDnOLO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:jdbcQueryActivityInput>&#xa;            &lt;COD_DISTR>&#xa;                &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;            &lt;/COD_DISTR>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:value-of select=&quot;substring($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)], 3)&quot;/>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DN>&#xa;                        &lt;xsl:value-of select=&quot;substring-after($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)], $Distretto)&quot;/>&#xa;                    &lt;/DN>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;COUNT_1>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)], 3))&quot;/>&#xa;                    &lt;/COUNT_1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COUNT_1>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring-after($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)], $Distretto))&quot;/>&#xa;                    &lt;/COUNT_1>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$Distretto ='002' or $Distretto ='006'&quot;>&#xa;                    &lt;COUNT_2>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)], 3))&quot;/>&#xa;                    &lt;/COUNT_2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;COUNT_2>&#xa;                        &lt;xsl:value-of select=&quot;string-length(substring-after($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)], $Distretto))&quot;/>&#xa;                    &lt;/COUNT_2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:Data_Invio_Rich)&quot;>&#xa;                    &lt;DATA_INVIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:Data_Invio_Rich)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:Data_Invio_Rich&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DATA_INVIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATA_INVIO xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CODFC_OLO_AGCOM&#xa;  FROM ARCHI_NUMRZNE_DIOGENE&#xa;  WHERE COD_DISTR = ? AND ? BETWEEN RPAD(ARCO_NUMRZNE_DA, ?, 0) AND RPAD(ARCO_NUMRZNE_A, ?, 9) AND (? BETWEEN DATAINZ_VALID AND DATAFI_VALID OR SYSDATE BETWEEN DATAINZ_VALID AND DATAFI_VALID)" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_DISTR"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DN"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COUNT_2"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATA_INVIO"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (number($index)>count($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive)) then &#xd;&#xa;(if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 2, 1) = &quot;6&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 1, 2)) else if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;0&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;1&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;5&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 3, 1) = &quot;9&quot;) then substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 1, 3) else substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN, 2, 3)) &#xd;&#xa;else&#xd;&#xa;(if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 2, 1) = &quot;6&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 1, 2)) else if(substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;0&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;1&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;5&quot; or substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;9&quot;) then substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 1, 3) else substring($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)], 2, 3))"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Distretto"
                                    name="AssignDistretto"
                                    outputVariable="Distretto"
                                    tibex:xpdlId="dcdfc26e-801a-4192-9fd3-88542893ec5e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart2ToAssignDistretto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignDistrettoToCheckNPOLO"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (number($index)>count($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive)) then &#xd;&#xa;(if(substring($VerificaNPSincronizzataIn.input/ns3:DN, 2, 1) = &quot;6&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DN, 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($VerificaNPSincronizzataIn.input/ns3:DN, 1, 2)) else if(substring($VerificaNPSincronizzataIn.input/ns3:DN, 3, 1) = &quot;0&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DN, 3, 1) = &quot;1&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DN, 3, 1) = &quot;5&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DN, 3, 1) = &quot;9&quot;) then substring($VerificaNPSincronizzataIn.input/ns3:DN, 1, 3) else substring($VerificaNPSincronizzataIn.input/ns3:DN, 2, 3)) &#xd;&#xa;else&#xd;&#xa;(if(substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 2, 1) = &quot;6&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 2, 1) = &quot;2&quot;) then concat(&quot;0&quot;, substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 1, 2)) else if(substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;0&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;1&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;5&quot; or substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 3, 1) = &quot;9&quot;) then substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 1, 3) else substring($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)], 2, 3))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Distretto" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDnOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPostInvokeD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CheckDnOLO/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Scenario migrazione e offerta !=WLR/VULL, Check DN not TLC, query result: ',string($CheckDnOLO/Record[1]/CODFC_OLO_AGCOM),' per DN ',$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DN)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Scenario migrazione e offerta !=WLR/VULL, Check DN OLO, query result: ','nessun risultato in assett OLO per DN ',$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DN)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaNPSincronizzata_', $VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogPostInvokeD-input"
                                    name="LogPostInvokeD"
                                    tibex:xpdlId="4338db0e-ae90-4229-9fe1-d4ccdd80d77d"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckDnOLOToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogPostInvokeDToEmpty2">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogPostInvokeDToMapper_DONOROLOOK">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM !=  &quot;TLC&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$CheckDnOLO/Record[1]/CODFC_OLO_AGCOM !=  "TLC"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckDnOLO&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPostInvokeD-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CheckDnOLO/Record[1]/CODFC_OLO_AGCOM)>0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Scenario migrazione e offerta !=WLR/VULL, Check DN not TLC, query result: ',string($CheckDnOLO/Record[1]/CODFC_OLO_AGCOM),' per DN ',$VerificaNPSincronizzataIn.input/tns1:DN)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Scenario migrazione e offerta !=WLR/VULL, Check DN OLO, query result: ','nessun risultato in assett OLO per DN ',$VerificaNPSincronizzataIn.input/tns1:DN)&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaNPSincronizzata_', $VerificaNPSincronizzataIn.input/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDnDonorOlo-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Distretto calcolato: &amp;quot;, $Distretto)&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaNPSincronizzata_', $VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
