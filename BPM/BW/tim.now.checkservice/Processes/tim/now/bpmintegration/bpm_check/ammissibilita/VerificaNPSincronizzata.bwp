            <bpws:empty name="AttivazioneOMigrazione" tibex:xpdlId="9c26d179-d9bb-4cd9-82e8-cbee32726ad5">
                <bpws:targets>
                    <bpws:target linkName="LogInputToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="AttivazioneOMigrazioneToMigrazione">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:Lavorazione='MIGRAZIONE' and not(exists($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DN))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VerificaNPSincronizzataIn.input/ns3:Lavorazione='MIGRAZIONE' and not(exists($VerificaNPSincronizzataIn.input/ns3:DN))]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="AttivazioneOMigrazioneToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:Lavorazione='ATTIVAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VerificaNPSincronizzataIn.input/ns3:Lavorazione='ATTIVAZIONE']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="AttivazioneOMigrazioneToReply1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="CheckOfferta" tibex:xpdlId="4595b92f-e30c-41eb-ba0b-8ce8864bdba1">
                <bpws:targets>
                    <bpws:target linkName="AttivazioneOMigrazioneToMigrazione"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="MigrazioneToEmpty_WLRVULL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="(starts-with($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia[1]/tns:Offerta,'VULL') or starts-with($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia[1]/tns:Offerta,'WLR')) and $VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia/tns:Azione='D'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[(starts-with($VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia[1]/tns:Offerta,'VULL') or starts-with($VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia[1]/tns:Offerta,'WLR')) and $VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia/tns:Azione='D']]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckOffertaToEmpty_WLRVULL">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckOffertaToCallProcess">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="((starts-with($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia[1]/tns:Offerta,'ULL') or starts-with($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia[1]/tns:Offerta,'SLU')) and $VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia/tns:Azione =&quot;D&quot;  and $VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia/tns:CodificaOLOAGCOMDonating ='TLC') or &#xd;&#xa;(($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:Sottolavorazione ='ATTIVAZIONE274') and&#xd;&#xa;($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia/tns:Azione !=&quot;D&quot; &#xd;&#xa;or &#xd;&#xa;not(exists($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia/tns:Azione ))))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[((starts-with($VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia[1]/tns:Offerta,'ULL') or starts-with($VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia[1]/tns:Offerta,'SLU')) and $VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia/tns:Azione ="D"  and $VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia/tns:CodificaOLOAGCOMDonating ='TLC') or 
(($VerificaNPSincronizzataIn.input/ns3:Sottolavorazione ='ATTIVAZIONE274') and
($VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia/tns:Azione !="D" 
or 
not(exists($VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia/tns:Azione ))))]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="CheckIDRisorsa" tibex:xpdlId="a1271e71-a35d-4e18-8775-eee97b7e6274">
                <bpws:documentation>Verificare che l’ID RISORSA della componente CONSISTENZAFONIA coincida con il DN in input</bpws:documentation>
                <bpws:targets>
                    <bpws:target linkName="MigrazioneToEmpty_WLRVULL"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckIDRisorsaToEmpty_EqualDN">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="exists($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[.=$VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia[1]/tns:IDRisorsa])" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[exists($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[.=$VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia[1]/tns:IDRisorsa])]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckIDRisorsaToRecuperaCausaleEsitoMultiplo">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:reply name="ExitKO"
                operation="VerificaNPSincronizzata"
                partnerLink="BPM_CheckServiceAmmissibilitaPortType"
                portType="ns1:BPM_CheckServiceAmmissibilitaPortType"
                tibex:xpdlId="6118f10e-1835-4ea1-b8a1-3f5071706d9c" variable="ExitKO-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/" xmlns:tns1="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" version="2.0"&gt;
    &lt;xsl:param name="EsitiMultipli"/&gt;
    &lt;xsl:template name="ExitKO-input" match="/"&gt;
        &lt;tns2:VerificaNPSincronizzataResponse&gt;
            &lt;output&gt;
                &lt;tns1:Verifica_NP_Sincronizzata_Response&gt;
                    &lt;tns1:Esito&gt;
                        &lt;tns1:Codice&gt;
                            &lt;xsl:value-of select="false()"/&gt;
                        &lt;/tns1:Codice&gt;
                        &lt;tns1:Descrizione&gt;
                            &lt;xsl:value-of select="'KO'"/&gt;
                        &lt;/tns1:Descrizione&gt;
                    &lt;/tns1:Esito&gt;
                    &lt;xsl:if test="exists($EsitiMultipli/em:IdAnagraficaCausale)"&gt;
                        &lt;xsl:if test="$EsitiMultipli/em:IdAnagraficaCausale"&gt;
                            &lt;tns1:idCausale&gt;
                                &lt;xsl:value-of select="$EsitiMultipli/em:IdAnagraficaCausale"/&gt;
                            &lt;/tns1:idCausale&gt;
                        &lt;/xsl:if&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns1:Verifica_NP_Sincronizzata_Response&gt;
            &lt;/output&gt;
        &lt;/tns2:VerificaNPSincronizzataResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceAmmissibilita/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;EsitiMultipli&quot;/>&#xa;    &lt;xsl:template name=&quot;ExitKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_NP_Sincronizzata_Response>&#xa;            &lt;tns1:Esito>&#xa;                &lt;tns1:Codice>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:Codice>&#xa;                &lt;tns1:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns1:Descrizione>&#xa;            &lt;/tns1:Esito>&#xa;            &lt;xsl:if test=&quot;exists($EsitiMultipli/em:IdAnagraficaCausale)&quot;>&#xa;                &lt;xsl:if test=&quot;$EsitiMultipli/em:IdAnagraficaCausale&quot;>&#xa;                    &lt;tns1:idCausale>&#xa;                        &lt;xsl:value-of select=&quot;$EsitiMultipli/em:IdAnagraficaCausale&quot;/>&#xa;                    &lt;/tns1:idCausale>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Verifica_NP_Sincronizzata_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="RecuperaCausaleEsitoMultiploToExitKO"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:empty name="CheckDNAggiuntive" tibex:xpdlId="d8f43d7c-d01c-479c-bcb5-b0f29a14abbc">
                <bpws:targets>
                    <bpws:target linkName="CheckIDRisorsaToEmpty_EqualDN"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckDNAggiuntiveToWhile">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckDNAggiuntiveToCheckServizio_NotPresent">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive)=1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[count($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive)=1]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="d02413e4-c9ec-4165-bcca-d214132c15c0">
                <bpws:targets>
                    <bpws:target linkName="CheckDNAggiuntiveToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToRecuperaCausaleEsitoMultiplo">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$CheckConsistenza=false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$CheckConsistenza=false()]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="WhileToEmpty">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="number($index) &lt;= count($VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive) and $CheckConsistenza=true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[number($index) <= count($VerificaNPSincronizzataIn.input/ns3:DNAggiuntive) and $CheckConsistenza=true()]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="CheckAggiuntiviInConstistenzaToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToAssignCheckConsistenza" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToEmpty3" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Empty3ToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="438368fc-8e9b-4e5c-aad5-ec42a0eb2a97">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToEmpty3">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:DNAggiuntive[number($index)]=$VerificaNPSincronizzataIn/input/ns3:Verifica_NP_Sincronizzata_Request/ns3:ConsistenzaFonia[1]/tns:IDRisorsa" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VerificaNPSincronizzataIn.input/ns3:DNAggiuntive[number($index)]=$VerificaNPSincronizzataIn.input/ns3:ConsistenzaFonia[1]/tns:IDRisorsa]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="67667d92-4acb-4427-a249-07ee0abc771e">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                    <bpws:target linkName="Empty3ToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+842cfc7c-896e-42f3-a7da-c71312a4ea88+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckAggiuntiviInConstistenza-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IDAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaFonia[1]/tns4:IDAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:ConsistenzaFonia[1]/tns4:IDAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDAsset>&#xa;            &lt;CurrentDnAggiuntivo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)])&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)]&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CurrentDnAggiuntivo>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="CheckAggiuntiviInConstistenza-input"
                                    name="CheckAggiuntiviInConstistenza"
                                    outputVariable="CheckAggiuntiviInConstistenza"
                                    tibex:xpdlId="842cfc7c-896e-42f3-a7da-c71312a4ea88" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CheckAggiuntiviInConstistenzaToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+842cfc7c-896e-42f3-a7da-c71312a4ea88+input&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;CheckAggiuntiviInConstistenza-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IDAsset>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:ConsistenzaFonia[1]/tns4:IDAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:ConsistenzaFonia[1]/tns4:IDAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDAsset>&#xa;            &lt;CurrentDnAggiuntivo>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)])&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn.input/tns1:DNAggiuntive[number($index)]&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CurrentDnAggiuntivo>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT count(*) &#xa;FROM BDS_1_CASEDATA_ASSET ass,BDS_1_CASEDATA_DETTAGLIOASSET dett,BDS_1_CASEDATA_ATTRIBTDTTGLSST att&#xa;WHERE ass.BDS_ID=dett.ASSET_DETTAGLIOASSET_BDSID and&#xa;dett.BDS_ID=att.DTTGLSST_TTRBTIDTTGLISST_BDSID and&#xa;ass.IDASSET=? and &#xa;att.NOMEATTRIBUTO='NUMEROTELEFONICO'and&#xa;dett.NOMECOMPONENTE='AGGIUNTIVO'and &#xa;att.VALOREATTRIBUTO=?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDAsset"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CurrentDnAggiuntivo"/>
                                    <columnMetadata
                                    columnName="COUNT(*)"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="CheckConsistenza"
                                    name="AssignCheckConsistenza"
                                    outputVariable="CheckConsistenza"
                                    tibex:xpdlId="20a849da-85d0-429b-b7ed-bb06d0360e34" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallProcessToAssignCheckConsistenza"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if($CheckAggiuntiviInConstistenza/Record[1]/COUNT>0) then true() else false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="CheckConsistenza" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaNPSincronizzataIn&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CheckAggiuntiviInConstistenza&quot;/>&#xa;    &lt;xsl:template name=&quot;LogPostInvokeDB_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaNPSincronizzata&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;tns2:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:BusinessID>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Scenario migrazione e offerta =WLR/VULL,Check DN aggiuntive in consistenza, query result: ',string($CheckAggiuntiviInConstistenza/Record[1]/COUNT),' per DN ',$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:DNAggiuntive[number($index)])&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkAmmissibilita'&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;'INTEGRATION'&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;tns2:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                        &lt;/tns2:BusinessID>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaNPSincronizzata_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat('VerificaNPSincronizzata_', $VerificaNPSincronizzataIn/input/tns1:Verifica_NP_Sincronizzata_Request/tns1:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogPostInvokeDB_2-input"
                                    name="LogPostInvokeDB_2"
                                    tibex:xpdlId="e66df550-14bb-4f7e-8636-77bc18bd8ce6"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CheckAggiuntiviInConstistenzaToCallProcess"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToAssignCheckConsistenza"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
