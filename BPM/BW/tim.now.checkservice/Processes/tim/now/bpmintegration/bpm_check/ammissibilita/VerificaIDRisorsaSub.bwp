                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToGetSottofamiglia"/>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="CheckTipoOfferta" tibex:xpdlId="13b1882a-1201-44a3-b947-e8dc2812cde5">
                <bpws:targets>
                    <bpws:target linkName="LogTipoRichiestaToCheckTipoOfferta"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckTipoOffertaToAssignOfferta">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckTipoOffertaToWhile">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:StrutturaRichiesta) = ('NGA', 'XDSL')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[upper-case($VerificaIDRisorsaSub.input/ns7:StrutturaRichiesta) = ('NGA', 'XDSL')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if &#xd;&#xa;(starts-with($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta, 'ULL')&#xd;&#xa;and&#xd;&#xa;$VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Lavorazione='CESSAZIONE')&#xd;&#xa;then&#xd;&#xa;&quot;ULLLINEAATTIVA', 'ULLLINEANONATTIVA','ULLLINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVA', 'ULLDATILINEANONATTIVA&quot; &#xd;&#xa;else&#xd;&#xa;if &#xd;&#xa;($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Lavorazione='VARIAZIONE' &#xd;&#xa;and&#xd;&#xa;($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta =&quot;SHACONMANODOPERA&quot; &#xd;&#xa;or &#xd;&#xa;$VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta =&quot;SHASENZAMANODOPERA&quot; &#xd;&#xa;or&#xd;&#xa;starts-with($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta, 'ULL'))) &#xd;&#xa;then&#xd;&#xa;&quot;ULLLINEAATTIVA', 'ULLLINEANONATTIVA','SHASENZAMANODOPERA','SHACONMANODOPERA','ULLLINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVA',&#xd;&#xa;'ULLDATILINEANONATTIVA&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(starts-with($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta, 'SLU'))&#xd;&#xa;then&#xd;&#xa;&quot;SLULINEAATTIVA', 'SLULINEANONATTIVA', 'SLULINEAATTIVANP&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(starts-with($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta, 'WLR'))&#xd;&#xa;then&#xd;&#xa;&quot;WLRLINEANONATTIVA',  'WLRLINEAATTIVA&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(starts-with($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta, 'SHA')&#xd;&#xa;and&#xd;&#xa;$VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Lavorazione='CESSAZIONE') &#xd;&#xa;then&#xd;&#xa;&quot;SHASENZAMANODOPERA', 'SHACONMANODOPERA&quot; &#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta='FIBERSTREAM'&#xd;&#xa;and&#xd;&#xa;$VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Lavorazione='CESSAZIONE') &#xd;&#xa;then&#xd;&#xa;&quot;FIBERSTREAM&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(contains($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta, 'CPS'))&#xd;&#xa;then&#xd;&#xa;&quot;CPS&quot;&#xd;&#xa;else&#xd;&#xa;&quot;VULLLINEANONATTIVA',  'VULL&quot;"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="Offerta1" name="AssignOfferta"
                    outputVariable="Offerta1"
                    tibex:xpdlId="34220aee-aae1-42bf-abf8-b84411a45e2d" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckTipoOffertaToAssignOfferta"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToSelectVariazioneCessazione"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="if &#xd;&#xa;(starts-with($VerificaIDRisorsaSub.input/ns7:Offerta, 'ULL')&#xd;&#xa;and&#xd;&#xa;$VerificaIDRisorsaSub.input/ns7:Lavorazione='CESSAZIONE')&#xd;&#xa;then&#xd;&#xa;&quot;ULLLINEAATTIVA', 'ULLLINEANONATTIVA','ULLLINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVA', 'ULLDATILINEANONATTIVA&quot; &#xd;&#xa;else&#xd;&#xa;if &#xd;&#xa;($VerificaIDRisorsaSub.input/ns7:Lavorazione='VARIAZIONE' &#xd;&#xa;and&#xd;&#xa;($VerificaIDRisorsaSub.input/ns7:Offerta =&quot;SHACONMANODOPERA&quot; &#xd;&#xa;or &#xd;&#xa;$VerificaIDRisorsaSub.input/ns7:Offerta =&quot;SHASENZAMANODOPERA&quot; &#xd;&#xa;or&#xd;&#xa;starts-with($VerificaIDRisorsaSub.input/ns7:Offerta, 'ULL'))) &#xd;&#xa;then&#xd;&#xa;&quot;ULLLINEAATTIVA', 'ULLLINEANONATTIVA','SHASENZAMANODOPERA','SHACONMANODOPERA','ULLLINEAATTIVANP','ULLDATILINEAATTIVANP','ULLDATILINEAATTIVA',&#xd;&#xa;'ULLDATILINEANONATTIVA&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(starts-with($VerificaIDRisorsaSub.input/ns7:Offerta, 'SLU'))&#xd;&#xa;then&#xd;&#xa;&quot;SLULINEAATTIVA', 'SLULINEANONATTIVA', 'SLULINEAATTIVANP&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(starts-with($VerificaIDRisorsaSub.input/ns7:Offerta, 'WLR'))&#xd;&#xa;then&#xd;&#xa;&quot;WLRLINEANONATTIVA',  'WLRLINEAATTIVA&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(starts-with($VerificaIDRisorsaSub.input/ns7:Offerta, 'SHA')&#xd;&#xa;and&#xd;&#xa;$VerificaIDRisorsaSub.input/ns7:Lavorazione='CESSAZIONE') &#xd;&#xa;then&#xd;&#xa;&quot;SHASENZAMANODOPERA', 'SHACONMANODOPERA&quot; &#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;($VerificaIDRisorsaSub.input/ns7:Offerta='FIBERSTREAM'&#xd;&#xa;and&#xd;&#xa;$VerificaIDRisorsaSub.input/ns7:Lavorazione='CESSAZIONE') &#xd;&#xa;then&#xd;&#xa;&quot;FIBERSTREAM&quot;&#xd;&#xa;else&#xd;&#xa;if&#xd;&#xa;(contains($VerificaIDRisorsaSub.input/ns7:Offerta, 'CPS'))&#xd;&#xa;then&#xd;&#xa;&quot;CPS&quot;&#xd;&#xa;else&#xd;&#xa;&quot;VULLLINEANONATTIVA',  'VULL&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Offerta1" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+54c92f93-33d2-4102-a98c-49784136a2f4+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Offerta1&quot;/>&lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&lt;xsl:param name=&quot;TipoRichiesta&quot;/>&lt;xsl:template name=&quot;SelectVariazioneCessazione-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' AND OPZIONEDINAMICA='Y' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM = ('&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;') OR&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE = ('&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;'))&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;$Offerta1='CPS' and $TipoRichiesta/Record[1]/CANALERICHIESTA='SDR'&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Offerta='FIBERSTREAM' and $VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione='CESSAZIONE'&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDRISORSAOPENFIBER,IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM = ('&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;') OR&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE = ('&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;'))&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM = ('&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;') OR&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE = ('&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;'))&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectVariazioneCessazione-input"
                    name="SelectVariazioneCessazione"
                    outputVariable="SelectVariazioneCessazione"
                    tibex:xpdlId="54c92f93-33d2-4102-a98c-49784136a2f4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToSelectVariazioneCessazione"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SQLDirectToSelectLog"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+54c92f93-33d2-4102-a98c-49784136a2f4+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;Offerta1&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectVariazioneCessazione-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' AND OPZIONEDINAMICA='Y' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM = ('&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;') OR&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE = ('&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;'))&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$Offerta1='CPS' and $TipoRichiesta/Record[1]/CANALERICHIESTA='SDR'&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VerificaIDRisorsaSub.input/tns1:Offerta='FIBERSTREAM' and $VerificaIDRisorsaSub.input/tns1:Lavorazione='CESSAZIONE'&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDRISORSAOPENFIBER,IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM = ('&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;') OR&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE = ('&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;'))&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;&amp;#xD;&amp;#xA;SELECT IDASSET, OFFERTA, STATOASSET, NUMEROFITTIZIO, IDRISORSA, IDRISORSANOW, IDOFFERTA as IDENTIFICATIVO_OFFERTA&amp;#xD;&amp;#xA; FROM BDS_1_CASEDATA_ASSET &amp;#xD;&amp;#xA; &amp;#xD;&amp;#xA;WHERE &amp;#xD;&amp;#xA;STATOASSET &amp;lt;> 'CESSATO' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;(IDRISORSA IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROFITTIZIO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;OR&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;NUMEROTELEFONICO IN ('&amp;quot;, tib:concat-sequence-format($VerificaIDRisorsaSub.input/tns1:IDRisorsa, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;#xD;&amp;#xA;) &amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;AND OFFERTA IN ('&amp;quot;,$Offerta1,&amp;quot;')&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;(&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM = ('&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;') OR&amp;#xD;&amp;#xA;CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO WHERE COD_OLO_ACCORPANTE = ('&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;'))&amp;#xD;&amp;#xA;)&amp;#xD;&amp;#xA;&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="41d7a10d-574c-439c-91bb-e8c35f7573e5">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToSelectLog"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="count($VerificaIdRisorsaRecuperaAsset/tns:VerificaIdRisorsaRecuperaAssetResponse)=0 and number($index)&lt;=4" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($VerificaIdRisorsaRecuperaAsset/tns:VerificaIdRisorsaRecuperaAssetResponse)=0 and number($index)<=4]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToSQLDirect_Ramononinuso"
                                    tibex:label="Ramo non in uso" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="CallProcessToNotFound" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link name="Empty1ToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="SelectAssetToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="LogOutSelectAssetToAssignCountOccorrenzeAssetDati" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="AssignCountOccorrenzeAssetDatiToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToVerificaIdRisorsaRecuperaAsset" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="VerificaIdRisorsaRecuperaAssetToLogOutSelectAsset" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="c34d2b24-4a0f-407e-ae9f-6950e217a56f">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToSQLDirect_Ramononinuso">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="1=2" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[1=2]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="GroupStartToVerificaIdRisorsaRecuperaAsset">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="98725086-8436-46f4-8894-45d1c0c6f2c2">
                                <bpws:targets>
                                    <bpws:target linkName="Empty1ToGroupEnd"/>
                                    <bpws:target linkName="AssignCountOccorrenzeAssetDatiToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:empty name="NotFound" tibex:xpdlId="61051aee-98c5-40b1-b70a-072dd2d55e6f">
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToNotFound"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="Empty1ToGroupEnd"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+540ab0d1-8cbf-4223-b249-c6847784d991+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcolaIdRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;number($index)=1&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO,&amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.IDRISORSA = '&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO,&amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.IDRISORSA = '&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;number($index)=2&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,&amp;#xD;&amp;#xA;F.DESCR,&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,&amp;#xD;&amp;#xA;TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROTELEFONICO = '&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,&amp;#xD;&amp;#xA;F.DESCR,&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,&amp;#xD;&amp;#xA;TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROTELEFONICO = '&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;number($index)=3&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa,&amp;quot;' AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa,&amp;quot;'AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$CalcolaIdRisorsa/tns1:IDRisorsa,&amp;quot;' AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$CalcolaIdRisorsa/tns1:IDRisorsa,&amp;quot;'AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectAsset-input"
                                    name="SelectAsset"
                                    outputVariable="SelectAsset"
                                    tibex:xpdlId="540ab0d1-8cbf-4223-b249-c6847784d991" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToSQLDirect_Ramononinuso"/>
