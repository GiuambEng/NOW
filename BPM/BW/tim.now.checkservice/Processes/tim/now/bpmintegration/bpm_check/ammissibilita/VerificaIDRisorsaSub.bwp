                    <bpws:sources>
                        <bpws:source linkName="SelectLogToInsertDatiVerificaControlli_OnceRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$CountOccorrenzeAsset=1" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
