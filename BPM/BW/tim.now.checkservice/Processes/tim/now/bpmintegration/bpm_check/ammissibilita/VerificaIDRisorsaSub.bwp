                        faultName="fault" faultVariable="fault" tibex:xpdlId="1262a690-2207-4085-b227-4a5d2f629fd1">
                        <bpws:scope name="scope1">
                            <bpws:flow name="flow3">
                                <bpws:links/>
                                <bpws:throw faultName="ns9:DefaultFault"
                                    faultVariable="FaultEsitiMultipli-input"
                                    name="FaultEsitiMultipli" tibex:xpdlId="947be43b-78d0-4ef8-ac58-3a43a101d7bd">
                                    <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;fault&quot;/>&#xa;    &lt;xsl:template name=&quot;FaultEsitiMultipli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Uscita EsitiMultipli activity: ',tib:render-xml($fault/Fault/em:EsitiMultipliFault, true(),true()))&quot;/>&#xa;            &lt;/message>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;'Errore sul recupero causale EsitiMultipli'&quot;/>&#xa;            &lt;/msgCode>&#xa;        &lt;/tns5:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                </bpws:throw>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:catch>
                    <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                        tibex:faultNameVar="FaultName1" tibex:xpdlId="7cc6f8c0-c66b-4c4f-bbc7-83bb928878fd">
                        <bpws:scope name="scope2">
