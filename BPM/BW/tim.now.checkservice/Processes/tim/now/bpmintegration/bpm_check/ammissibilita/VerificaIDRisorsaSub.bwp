                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAttivazione&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectAttivazioneLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIDRisorsaSub&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectAttivazione/Record)>0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Estrazione della tabella BDS_1_CASEDATA_ASSET:&amp;quot;, tib:render-xml($SelectAttivazione, true(), true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono record all'interno della tabella BDS_1_CASEDATA_ASSET per i dati in input&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectAttivazioneLog-input"
                    name="SelectAttivazioneLog"
                    tibex:xpdlId="0e8d475d-6e6e-45de-952e-365e908b58d8"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SelectAttivazioneToSelectAttivazioneLog"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectAttivazioneLogToInsertDatiVerificaControlli_OKRecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(count($SelectAttivazione/Record) > 0 and $VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta!='CPS') or ($VerificaIDRisorsaSub/input/ns7:Verifica_ID_Risorsa_Request/ns7:Offerta='CPS' and exists($SelectAttivazione/Record[OFFERTA='CPS']))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(count($SelectAttivazione/Record) > 0 and $VerificaIDRisorsaSub.input/ns7:Offerta!='CPS') or ($VerificaIDRisorsaSub.input/ns7:Offerta='CPS' and exists($SelectAttivazione/Record[OFFERTA='CPS']))]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="SelectAttivazioneLogToGetSottofamiglia_Norecord">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAttivazione&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectAttivazioneLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIDRisorsaSub&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectAttivazione/Record)>0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Estrazione della tabella BDS_1_CASEDATA_ASSET:&amp;quot;, tib:render-xml($SelectAttivazione, true(), true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono record all'interno della tabella BDS_1_CASEDATA_ASSET per i dati in input&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns9:DefaultFault"
                faultVariable="GenerateErrorDatiVerificaControlli-input"
                name="GenerateErrorDatiVerificaControlli" tibex:xpdlId="564e8944-0006-4f99-b43b-faeef19c8363">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;'KO Insert Dati Verifica Controlli'&quot;/>&#xa;            &lt;/message>&#xa;            &lt;xsl:if test=&quot;$_error/MsgCode&quot;>&#xa;                &lt;msgCode>&#xa;                    &lt;xsl:value-of select=&quot;$_error/MsgCode&quot;/>&#xa;                &lt;/msgCode>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns5:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="UpdateDatiVerificaControlliToThrow"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+89e276e1-a63d-44b4-9556-fe9101211e22+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&#xa;    &lt;xsl:template name=&quot;GetSottofamiglia-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:jdbcQueryActivityInput>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns5:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
