                                   &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                    &lt;tns1:OffertaAsset>&#xa;                                        &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;OFFERTA&amp;quot;]/value)&quot;/>&#xa;                                    &lt;/tns1:OffertaAsset>&#xa;                                    &lt;tns1:IdRisorsaNOW>&#xa;                                        &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSANOW&amp;quot;]/value)&quot;/>&#xa;                                    &lt;/tns1:IdRisorsaNOW>&#xa;                                    &lt;tns1:IdRisorsaDati>&#xa;                                        &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSA&amp;quot;]/value)&quot;/>&#xa;                                    &lt;/tns1:IdRisorsaDati>&#xa;                                    &lt;tns1:DatiAccesso>&#xa;                                        &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;>&#xa;                                            &lt;tns3:IDRisorsaFonia>&#xa;                                                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;/>&#xa;                                            &lt;/tns3:IDRisorsaFonia>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns3:IdRisorsaDati>&#xa;                                            &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSA&amp;quot;]/value)&quot;/>&#xa;                                        &lt;/tns3:IdRisorsaDati>&#xa;                                        &lt;tns3:IdRisorsaNow>&#xa;                                            &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSANOW&amp;quot;]/value)&quot;/>&#xa;                                        &lt;/tns3:IdRisorsaNow>&#xa;                                        &lt;tns3:OffertaAsset>&#xa;                                            &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;OFFERTA&amp;quot;]/value)&quot;/>&#xa;                                        &lt;/tns3:OffertaAsset>&#xa;                                        &lt;tns3:IdentificativoOffertaAsset>&#xa;                                            &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDENTIFICATIVO_OFFERTA&amp;quot;]/value)&quot;/>&#xa;                                        &lt;/tns3:IdentificativoOffertaAsset>&#xa;                                        &lt;xsl:if test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:NumeroLinea)=upper-case(string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;NUMEROFITTIZIO&amp;quot;]/value)) and upper-case($VerificaIDRisorsaSub.input/tns1:IDRisorsa) !=string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSA&amp;quot;]/value)&quot;>&#xa;                                            &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                                &lt;tns3:IdRisorsaDaOLO>&#xa;                                                    &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                                &lt;/tns3:IdRisorsaDaOLO>&#xa;                                            &lt;/xsl:if>&#xa;                                        &lt;/xsl:if>&#xa;                                        &lt;tns3:IdAsset>&#xa;                                            &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDASSET&amp;quot;]/value)&quot;/>&#xa;                                        &lt;/tns3:IdAsset>&#xa;                                    &lt;/tns1:DatiAccesso>&#xa;                                &lt;/tns1:Verifica_ID_Risorsa_Response>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:Verifica_ID_Risorsa_Response>&#xa;                                    &lt;tns1:Esito>&#xa;                                        &lt;tns1:Codice>&#xa;                                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                        &lt;/tns1:Codice>&#xa;                                        &lt;tns1:Descrizione>&#xa;                                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                        &lt;/tns1:Descrizione>&#xa;                                    &lt;/tns1:Esito>&#xa;                                    &lt;xsl:if test=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;>&#xa;                                        &lt;tns1:IdAnagraficaCausale>&#xa;                                            &lt;xsl:value-of select=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;/>&#xa;                                        &lt;/tns1:IdAnagraficaCausale>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:DatiAccesso/>&#xa;                                &lt;/tns1:Verifica_ID_Risorsa_Response>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse) = 1&quot;>&#xa;                        &lt;tns1:Verifica_ID_Risorsa_Response>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;tns1:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns1:Codice>&#xa;                                &lt;tns1:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:Descrizione>&#xa;                            &lt;/tns1:Esito>&#xa;                            &lt;tns1:OffertaAsset>&#xa;                                &lt;xsl:value-of select=&quot;string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:OFFERTA)&quot;/>&#xa;                            &lt;/tns1:OffertaAsset>&#xa;                            &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;>&#xa;                                &lt;tns1:IdRisorsaNOW>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;/>&#xa;                                &lt;/tns1:IdRisorsaNOW>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&#xa;                                &lt;tns1:IdRisorsaDati>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;/>&#xa;                                &lt;/tns1:IdRisorsaDati>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO&quot;>&#xa;                                &lt;tns1:NumeroFittizio>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO&quot;/>&#xa;                                &lt;/tns1:NumeroFittizio>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROTELEFONICO&quot;>&#xa;                                &lt;tns1:NumeroTelefonico>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROTELEFONICO&quot;/>&#xa;                                &lt;/tns1:NumeroTelefonico>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:DatiAccesso>&#xa;                                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;>&#xa;                                    &lt;tns3:IDRisorsaFonia>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;/>&#xa;                                    &lt;/tns3:IDRisorsaFonia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&#xa;                                    &lt;tns3:IdRisorsaDati>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;/>&#xa;                                    &lt;/tns3:IdRisorsaDati>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;>&#xa;                                    &lt;tns3:IdRisorsaNow>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;/>&#xa;                                    &lt;/tns3:IdRisorsaNow>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns3:OffertaAsset>&#xa;                                    &lt;xsl:value-of select=&quot;string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:OFFERTA)&quot;/>&#xa;                                &lt;/tns3:OffertaAsset>&#xa;                                &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA&quot;>&#xa;                                    &lt;tns3:IdentificativoOffertaAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA&quot;/>&#xa;                                    &lt;/tns3:IdentificativoOffertaAsset>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:IDRisorsa) = upper-case(string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO) )and upper-case($VerificaIDRisorsaSub.input/tns1:IDRisorsa) !=$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                        &lt;tns3:IdRisorsaDaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                        &lt;/tns3:IdRisorsaDaOLO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns3:IdAsset>&#xa;                                    &lt;xsl:value-of select=&quot;string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDASSET)&quot;/>&#xa;                                &lt;/tns3:IdAsset>&#xa;                            &lt;/tns1:DatiAccesso>&#xa;                        &lt;/tns1:Verifica_ID_Risorsa_Response>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Verifica_ID_Risorsa_Response>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;tns1:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns1:Codice>&#xa;                                &lt;tns1:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                                &lt;/tns1:Descrizione>&#xa;                            &lt;/tns1:Esito>&#xa;                            &lt;xsl:if test=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;>&#xa;                                &lt;tns1:IdAnagraficaCausale>&#xa;                                    &lt;xsl:value-of select=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;/>&#xa;                                &lt;/tns1:IdAnagraficaCausale>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns1:Verifica_ID_Risorsa_Response>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;tib:trim(upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione))=('CESSAZIONE', 'VARIAZIONE') and string-length($VerificaIDRisorsaSub.input/tns1:IDRisorsa)=0&quot;>&#xa;                &lt;tns1:Verifica_ID_Risorsa_Response>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'KO - IdRisorsa mancante in caso di lavorazione VARIAZIONE o CESSAZIONE'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;xsl:if test=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;>&#xa;                        &lt;tns1:IdAnagraficaCausale>&#xa;                            &lt;xsl:value-of select=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;/>&#xa;                        &lt;/tns1:IdAnagraficaCausale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:Verifica_ID_Risorsa_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Verifica_ID_Risorsa_Response>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;xsl:if test=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;>&#xa;                        &lt;tns1:IdAnagraficaCausale>&#xa;                            &lt;xsl:value-of select=&quot;$EsitiMultipli.Output/em:IdAnagraficaCausale&quot;/>&#xa;                        &lt;/tns1:IdAnagraficaCausale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns1:Verifica_ID_Risorsa_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VerificaIDRisorsa" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIDRisorsaSub&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Output VerificaIDRisorsa:&amp;quot;, tib:render-xml($VerificaIDRisorsa, true(), true()))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="OutputLog-input" name="OutputLog"
                    tibex:xpdlId="f209b1d6-5ddb-47dd-84bf-922417605e87"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:template name=&quot;OutputLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIDRisorsaSub&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns5:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Output VerificaIDRisorsa:&amp;quot;, tib:render-xml($VerificaIDRisorsa, true(), true()))&quot;/>&#xa;                &lt;/tns5:Message>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke
                inputVariable="InsertDatiVerificaControlli-input"
                name="InsertDatiVerificaControlli"
                operation="DatiVerificaControlli"
                outputVariable="InsertDatiVerificaControlli"
                partnerLink="DatiVerificaControlli"
                portType="ns8:DatiVerificaControlliPortType" tibex:xpdlId="d6ad7ac6-a092-45ae-84e7-a4001ca17650">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns5="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns3="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns1="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns2="http://www.tim.com/NOW/xsd/BPM_CheckUtil" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="VerificaIDRisorsaSub"/&gt;
    &lt;xsl:param name="SelectVariazioneCessazione"/&gt;
    &lt;xsl:param name="VerificaIdRisorsaRecuperaAsset"/&gt;
    &lt;xsl:template name="InsertDatiVerificaControlli-input" match="/"&gt;
        &lt;tns5:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="tib:trim(upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione))='ATTIVAZIONE'"&gt;
                        &lt;tns3:DatiVerificaControlliInput&gt;
                            &lt;tns3:Operatore&gt;
                                &lt;xsl:value-of select="'BPM'"/&gt;
                            &lt;/tns3:Operatore&gt;
                            &lt;tns3:IDRichiestaOLO&gt;
                                &lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO"/&gt;
                            &lt;/tns3:IDRichiestaOLO&gt;
                            &lt;tns3:Azione&gt;
                                &lt;xsl:value-of select="'INSERT'"/&gt;
                            &lt;/tns3:Azione&gt;
                            &lt;tns3:DatiAccesso&gt;
                                &lt;xsl:if test="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:NumeroLinea"&gt;
                                    &lt;tns3:IDRisorsaFonia&gt;
                                        &lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:NumeroLinea"/&gt;
                                    &lt;/tns3:IDRisorsaFonia&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"&gt;
                                    &lt;tns3:IdRisorsaDati&gt;
                                        &lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"/&gt;
                                    &lt;/tns3:IdRisorsaDati&gt;
                                &lt;/xsl:if&gt;
                            &lt;/tns3:DatiAccesso&gt;
                        &lt;/tns3:DatiVerificaControlliInput&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns3:DatiVerificaControlliInput&gt;
                            &lt;tns3:Operatore&gt;
                                &lt;xsl:value-of select="'BPM'"/&gt;
                            &lt;/tns3:Operatore&gt;
                            &lt;tns3:IDRichiestaOLO&gt;
                                &lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO"/&gt;
                            &lt;/tns3:IDRichiestaOLO&gt;
                            &lt;tns3:Azione&gt;
                                &lt;xsl:value-of select="'INSERT'"/&gt;
                            &lt;/tns3:Azione&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:StrutturaRichiesta) = ('NGA', 'XDSL')"&gt;
                                    &lt;tns3:DatiAccesso&gt;
                                        &lt;xsl:if test="$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA"&gt;
                                            &lt;tns3:IdRisorsaDati&gt;
                                                &lt;xsl:value-of select="$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA"/&gt;
                                            &lt;/tns3:IdRisorsaDati&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW"&gt;
                                            &lt;tns3:IdRisorsaNow&gt;
                                                &lt;xsl:value-of select="$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW"/&gt;
                                            &lt;/tns3:IdRisorsaNow&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA"&gt;
                                            &lt;tns3:IdentificativoOffertaAsset&gt;
                                                &lt;xsl:value-of select="$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA"/&gt;
                                            &lt;/tns3:IdentificativoOffertaAsset&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;xsl:if test="upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa) = upper-case(string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO)) and upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa) !=$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA"&gt;
                                            &lt;xsl:if test="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"&gt;
                                                &lt;tns3:IdRisorsaDaOLO&gt;
                                                    &lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"/&gt;
                                                &lt;/tns3:IdRisorsaDaOLO&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:DatiAccesso&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns3:DatiAccesso&gt;
                                        &lt;xsl:if test="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"&gt;
                                            &lt;tns3:IdRisorsaDati&gt;
                                                &lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"/&gt;
                                            &lt;/tns3:IdRisorsaDati&gt;
                                        &lt;/xsl:if&gt;
                                        &lt;tns3:IdRisorsaNow&gt;
                                            &lt;xsl:value-of select="string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSANOW&amp;quot;]/value)"/&gt;
                                        &lt;/tns3:IdRisorsaNow&gt;
                                        &lt;tns3:IdentificativoOffertaAsset&gt;
                                            &lt;xsl:value-of select="string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDOFFERTA&amp;quot;]/value)"/&gt;
                                        &lt;/tns3:IdentificativoOffertaAsset&gt;
                                        &lt;xsl:if test="upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa)=upper-case(string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;NUMEROFITTIZIO&amp;quot;]/value)) and upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa) !=string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSA&amp;quot;]/value)"&gt;
                                            &lt;xsl:if test="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"&gt;
                                                &lt;tns3:IdRisorsaDaOLO&gt;
                                                    &lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa"/&gt;
                                                &lt;/tns3:IdRisorsaDaOLO&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/tns3:DatiAccesso&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns3:DatiVerificaControlliInput&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/parameters&gt;
        &lt;/tns5:DatiVerificaControlliRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectVariazioneCessazione&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIdRisorsaRecuperaAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertDatiVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;tib:trim(upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione))='ATTIVAZIONE'&quot;>&#xa;                &lt;tns3:DatiVerificaControlliInput>&#xa;                    &lt;tns3:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;                    &lt;/tns3:Operatore>&#xa;                    &lt;tns3:IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:IDRichiestaOLO>&#xa;                    &lt;tns3:Azione>&#xa;                        &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                    &lt;/tns3:Azione>&#xa;                    &lt;tns3:DatiAccesso>&#xa;                        &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;>&#xa;                            &lt;tns3:IDRisorsaFonia>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;/>&#xa;                            &lt;/tns3:IDRisorsaFonia>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                            &lt;tns3:IdRisorsaDati>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                            &lt;/tns3:IdRisorsaDati>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns3:DatiAccesso>&#xa;                &lt;/tns3:DatiVerificaControlliInput>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns3:DatiVerificaControlliInput>&#xa;                    &lt;tns3:Operatore>&#xa;                        &lt;xsl:value-of select=&quot;'BPM'&quot;/>&#xa;                    &lt;/tns3:Operatore>&#xa;                    &lt;tns3:IDRichiestaOLO>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns3:IDRichiestaOLO>&#xa;                    &lt;tns3:Azione>&#xa;                        &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                    &lt;/tns3:Azione>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:StrutturaRichiesta) = ('NGA', 'XDSL')&quot;>&#xa;                            &lt;tns3:DatiAccesso>&#xa;                                &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&#xa;                                    &lt;tns3:IdRisorsaDati>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;/>&#xa;                                    &lt;/tns3:IdRisorsaDati>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;>&#xa;                                    &lt;tns3:IdRisorsaNow>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;/>&#xa;                                    &lt;/tns3:IdRisorsaNow>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA&quot;>&#xa;                                    &lt;tns3:IdentificativoOffertaAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA&quot;/>&#xa;                                    &lt;/tns3:IdentificativoOffertaAsset>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:IDRisorsa) = upper-case(string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO)) and upper-case($VerificaIDRisorsaSub.input/tns1:IDRisorsa) !=$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                        &lt;tns3:IdRisorsaDaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                        &lt;/tns3:IdRisorsaDaOLO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns3:DatiAccesso>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns3:DatiAccesso>&#xa;                                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                    &lt;tns3:IdRisorsaDati>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                    &lt;/tns3:IdRisorsaDati>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;tns3:IdRisorsaNow>&#xa;                                    &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSANOW&amp;quot;]/value)&quot;/>&#xa;                                &lt;/tns3:IdRisorsaNow>&#xa;                                &lt;tns3:IdentificativoOffertaAsset>&#xa;                                    &lt;xsl:value-of select=&quot;string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDOFFERTA&amp;quot;]/value)&quot;/>&#xa;                                &lt;/tns3:IdentificativoOffertaAsset>&#xa;                                &lt;xsl:if test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:IDRisorsa)=upper-case(string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;NUMEROFITTIZIO&amp;quot;]/value)) and upper-case($VerificaIDRisorsaSub.input/tns1:IDRisorsa) !=string($SelectVariazioneCessazione/unknownResultset[1]/row[1]/column[name = &amp;quot;IDRISORSA&amp;quot;]/value)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                        &lt;tns3:IdRisorsaDaOLO>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                        &lt;/tns3:IdRisorsaDaOLO>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns3:DatiAccesso>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns3:DatiVerificaControlliInput>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="SelectAttivazioneLogToInsertDatiVerificaControlli_OKRecord"/>
                    <bpws:target linkName="SelectLogToInsertDatiVerificaControlli_OnceRecord"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateDatiVerificaControlliToAssign">
                        <tibex:DesignExpression/>
                    </bpws:source>
                    <bpws:source
                        linkName="UpdateDatiVerificaControlliToThrow"
                        tibex:faultDetailsVar="InsertDatiVerificaControlli" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectVariazioneCessazione&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIdRisorsaRecuperaAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIDRisorsaSub&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectVariazioneCessazione/unknownResultset/row)>0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Estrazione della tabella BDS_1_CASEDATA_ASSET:&amp;quot;, tib:render-xml($SelectVariazioneCessazione, true(), true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse) > 0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Estrazione per Dati della tabella BDS_1_CASEDATA_ASSET:&amp;quot;, tib:render-xml($VerificaIdRisorsaRecuperaAsset, true(), true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:StrutturaRichiesta) = (&amp;quot;NGA&amp;quot;,&amp;quot;XSDL&amp;quot;) and count($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse) = 0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono record all'interno della tabella BDS_1_CASEDATA_ASSET per l'estrazione DATI&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Non ci sono record all'interno della tabella BDS_1_CASEDATA_ASSET per i dati in input&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
