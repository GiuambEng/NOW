                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:template name=&quot;CalcolaIdRisorsa&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_ID_Risorsa_Request>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 2, 1) ='6' or substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 2, 1) ='2'&quot;>&#xa;                    &lt;tns1:IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;concat('0',$VerificaIDRisorsaSub.input/tns1:IDRisorsa)&quot;/>&#xa;                    &lt;/tns1:IDRisorsa>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='0' or substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='5' or substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='1' or  substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 3, 1)='9'&quot;>&#xa;                    &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                        &lt;tns1:IDRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                        &lt;/tns1:IDRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:IDRisorsa>&#xa;                        &lt;xsl:value-of select=&quot;substring($VerificaIDRisorsaSub.input/tns1:IDRisorsa, 2)&quot;/>&#xa;                    &lt;/tns1:IDRisorsa>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:Offerta&quot;/>&#xa;            &lt;/tns1:Offerta>&#xa;            &lt;tns1:CodiceOLOAGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns1:CodiceOLOAGCOM>&#xa;        &lt;/tns1:Verifica_ID_Risorsa_Request>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
