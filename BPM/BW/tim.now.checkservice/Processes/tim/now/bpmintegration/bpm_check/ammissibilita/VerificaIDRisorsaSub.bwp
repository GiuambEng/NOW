ultset[1]/row[1]/column[name = &amp;quot;IDASSET&amp;quot;]/value)&quot;/>&lt;/tns3:IdAsset>&lt;/tns1:DatiAccesso>&lt;/tns1:Verifica_ID_Risorsa_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Verifica_ID_Risorsa_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;xsl:if test=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;>&lt;tns1:IdAnagraficaCausale>&lt;xsl:value-of select=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;/>&lt;/tns1:IdAnagraficaCausale>&lt;/xsl:if>&lt;tns1:DatiAccesso/>&lt;/tns1:Verifica_ID_Risorsa_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;count($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse) = 1&quot;>&lt;tns1:Verifica_ID_Risorsa_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;tns1:OffertaAsset>&lt;xsl:value-of select=&quot;string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:OFFERTA)&quot;/>&lt;/tns1:OffertaAsset>&lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;>&lt;tns1:IdRisorsaNOW>&lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;/>&lt;/tns1:IdRisorsaNOW>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&lt;tns1:IdRisorsaDati>&lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;/>&lt;/tns1:IdRisorsaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO&quot;>&lt;tns1:NumeroFittizio>&lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO&quot;/>&lt;/tns1:NumeroFittizio>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROTELEFONICO&quot;>&lt;tns1:NumeroTelefonico>&lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROTELEFONICO&quot;/>&lt;/tns1:NumeroTelefonico>&lt;/xsl:if>&lt;tns1:DatiAccesso>&lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:NumeroLinea&quot;>&lt;tns3:IDRisorsaFonia>&lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:NumeroLinea&quot;/>&lt;/tns3:IDRisorsaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&lt;tns3:IdRisorsaDati>&lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;/>&lt;/tns3:IdRisorsaDati>&lt;/xsl:if>&lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;>&lt;tns3:IdRisorsaNow>&lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSANOW&quot;/>&lt;/tns3:IdRisorsaNow>&lt;/xsl:if>&lt;tns3:OffertaAsset>&lt;xsl:value-of select=&quot;string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:OFFERTA)&quot;/>&lt;/tns3:OffertaAsset>&lt;xsl:if test=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA&quot;>&lt;tns3:IdentificativoOffertaAsset>&lt;xsl:value-of select=&quot;$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDENTIFICATIVO_OFFERTA&quot;/>&lt;/tns3:IdentificativoOffertaAsset>&lt;/xsl:if>&lt;xsl:if test=&quot;upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa) = upper-case(string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:NUMEROFITTIZIO) )and upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa) !=$VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDRISORSA&quot;>&lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa&quot;>&lt;tns3:IdRisorsaDaOLO>&lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa&quot;/>&lt;/tns3:IdRisorsaDaOLO>&lt;/xsl:if>&lt;/xsl:if>&lt;tns3:IdAsset>&lt;xsl:value-of select=&quot;string($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse[1]/tns2:IDASSET)&quot;/>&lt;/tns3:IdAsset>&lt;/tns1:DatiAccesso>&lt;/tns1:Verifica_ID_Risorsa_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Verifica_ID_Risorsa_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;xsl:if test=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;>&lt;tns1:IdAnagraficaCausale>&lt;xsl:value-of select=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;/>&lt;/tns1:IdAnagraficaCausale>&lt;/xsl:if>&lt;/tns1:Verifica_ID_Risorsa_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;tib:trim(upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione))=('CESSAZIONE', 'VARIAZIONE') and string-length($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa)=0&quot;>&lt;tns1:Verifica_ID_Risorsa_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO - IdRisorsa mancante in caso di lavorazione VARIAZIONE o CESSAZIONE'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;xsl:if test=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;>&lt;tns1:IdAnagraficaCausale>&lt;xsl:value-of select=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;/>&lt;/tns1:IdAnagraficaCausale>&lt;/xsl:if>&lt;/tns1:Verifica_ID_Risorsa_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Verifica_ID_Risorsa_Response>&lt;tns1:Esito>&lt;tns1:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:Codice>&lt;tns1:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns1:Descrizione>&lt;/tns1:Esito>&lt;xsl:if test=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;>&lt;tns1:IdAnagraficaCausale>&lt;xsl:value-of select=&quot;$EsitiMultipli/Output/em:EsitiMultipliResponse/em:IdAnagraficaCausale&quot;/>&lt;/tns1:IdAnagraficaCausale>&lt;/xsl:if>&lt;/tns1:Verifica_ID_Risorsa_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VerificaIDRisorsa"
                    name="AssignVerificaID"
                    outputVariable="VerificaIDRisorsa"
                    tibex:xpdlId="55b83ede-8564-4c95-b385-cc263ecac7e2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateDatiVerificaControlliToAssign"/>
                        <bpws:target linkName="ScopeToAssignVerificaID"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;EsitiMultipli.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectAttivazione&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectVariazioneCessazione&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIdRisorsaRecuperaAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaIDRisorsa&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VerificaIDRisorsaSub.input/tns1:Offerta='CPS' and tib:trim(upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione))='ATTIVAZIONE'&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectAttivazione/Record[OFFERTA='CPS'])&quot;>&#xa;                        &lt;tns1:Verifica_ID_Risorsa_Response>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;tns1:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns1:Codice>&#xa;                                &lt;tns1:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                                &lt;/tns1:Descrizione>&#xa;                            &lt;/tns1:Esito>&#xa;                            &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:Offerta='CPS'&quot;>&#xa;                                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                    &lt;tns1:IdRisorsaNOW>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                    &lt;/tns1:IdRisorsaNOW>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;>&#xa;                                &lt;tns1:IdRisorsaFonia>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;/>&#xa;                                &lt;/tns1:IdRisorsaFonia>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                &lt;tns1:IdRisorsaDati>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                &lt;/tns1:IdRisorsaDati>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;tns1:DatiAccesso>&#xa;                                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;>&#xa;                                    &lt;tns3:IDRisorsaFonia>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:NumeroLinea&quot;/>&#xa;                                    &lt;/tns3:IDRisorsaFonia>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                    &lt;tns3:IdRisorsaDati>&#xa;                                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                    &lt;/tns3:IdRisorsaDati>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:Offerta='CPS'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;>&#xa;                                        &lt;tns3:IdRisorsaNow>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRisorsa&quot;/>&#xa;                                        &lt;/tns3:IdRisorsaNow>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub.input/tns1:Offerta='CPS'&quot;>&#xa;                                    &lt;xsl:if test=&quot;$SelectAttivazione/Record[OFFERTA='CPS']/IDOFFERTA&quot;>&#xa;                                        &lt;tns3:IdentificativoOffertaAsset>&#xa;                                            &lt;xsl:value-of select=&quot;$SelectAttivazione/Record[OFFERTA='CPS']/IDOFFERTA&quot;/>&#xa;                                        &lt;/tns3:IdentificativoOffertaAsset>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:if>&#xa;                                &lt;xsl:if test=&quot;$SelectAttivazione/Record[OFFERTA='CPS']/IDASSET&quot;>&#xa;                                    &lt;tns3:IdAsset>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectAttivazione/Record[OFFERTA='CPS']/IDASSET&quot;/>&#xa;                                    &lt;/tns3:IdAsset>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/tns1:DatiAccesso>&#xa;                        &lt;/tns1:Verifica_ID_Risorsa_Response>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:oth