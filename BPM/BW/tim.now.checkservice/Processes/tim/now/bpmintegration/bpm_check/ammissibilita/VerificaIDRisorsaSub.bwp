                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcolaIdRisorsa&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaIdRisorsaRecuperaAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:VerificaIdRisorsaRecuperaAssetRequest>&#xa;            &lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;>&#xa;                &lt;tns2:IdRichiestaOlo>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns2:IdRichiestaOlo>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns2:Index>&#xa;                &lt;xsl:value-of select=&quot;$index&quot;/>&#xa;            &lt;/tns2:Index>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$index=4&quot;>&#xa;                    &lt;xsl:if test=&quot;$CalcolaIdRisorsa/tns1:IDRisorsa&quot;>&#xa;                        &lt;tns2:IdRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$CalcolaIdRisorsa/tns1:IDRisorsa&quot;/>&#xa;                        &lt;/tns2:IdRisorsa>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRisorsa&quot;>&#xa;                        &lt;tns2:IdRisorsa>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaIDRis