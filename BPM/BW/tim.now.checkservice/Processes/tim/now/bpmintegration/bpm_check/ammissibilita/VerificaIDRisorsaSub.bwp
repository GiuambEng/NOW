                                    <bpws:sources>
                                    <bpws:source linkName="SelectAssetToCallProcess"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+540ab0d1-8cbf-4223-b249-c6847784d991+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;CalcolaIdRisorsa&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoRichiesta&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;number($index)=1&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO,&amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.IDRISORSA = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO,&amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.IDRISORSA = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;number($index)=2&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,&amp;#xD;&amp;#xA;F.DESCR,&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,&amp;#xD;&amp;#xA;TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROTELEFONICO = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,&amp;#xD;&amp;#xA;F.DESCR,&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,&amp;#xD;&amp;#xA;TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROTELEFONICO = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND F.DESCR !='REGOLATORIO'&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;number($index)=3&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;' AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$VerificaIDRisorsaSub.input/tns1:IDRisorsa,&amp;quot;'AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$TipoRichiesta/Record[1]/TIPORICHIESTA='RICARICA'&quot;>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$CalcolaIdRisorsa/tns1:IDRisorsa,&amp;quot;' AND A.OPZIONEDINAMICA='Y' AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;statement>&#xa;                                &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT A.IDASSET,A.OFFERTA, A.STATOASSET, A.NUMEROFITTIZIO, &amp;#xD;&amp;#xA;A.IDRISORSA, A.IDRISORSANOW,T.NOME_OFFERTA_ESTERNA,F.DESCR,&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;A.IDOFFERTA as IDENTIFICATIVO_OFFERTA, A.NUMEROTELEFONICO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;FROM BDS_1_CASEDATA_ASSET A,OFFERTA O,TRASCODFC_OFFERTA T,FAMIG_OFFERTA F&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE A.NUMEROFITTIZIO = '&amp;quot;,$CalcolaIdRisorsa/tns1:IDRisorsa,&amp;quot;'AND (A.STATOASSET IN ('ATTIVO','INLAVORAZIONE')) &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;AND (A.CODIFICAOLOAGCOM='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;' &amp;#xD;&amp;#xA;OR &amp;#xD;&amp;#xA;A.CODIFICAOLOAGCOM IN (SELECT CODFC_OLO_AGCOM FROM OLO &amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;WHERE COD_OLO_ACCORPANTE='&amp;quot;,$VerificaIDRisorsaSub.input/tns1:CodiceOLOAGCOM,&amp;quot;')) &amp;#xD;&amp;#xA;AND&amp;#xD;&amp;#xA;O.ID_OFFERTA=T.ID_OFFERTA AND&amp;#xD;&amp;#xA;O.ID_FAMIG_OFFERTA=F.ID_FAMIG_OFFERTA AND&amp;#xD;&amp;#xA;T.PROVENIENZA='BPM' &amp;#xD;&amp;#xA;AND &amp;#xD;&amp;#xA;T.NOME_OFFERTA_ESTERNA=A.OFFERTA&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;&amp;#xD;&amp;#xA;ORDER BY LASTUPDATE DESC&amp;quot;)&quot;/>&#xa;                            &lt;/statement>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns5:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.SQLDirect"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaIdRisorsaRecuperaAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutSelectAsset-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceAmmissibilita&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckServiceAmmissibilitaPortType&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaIDRisorsaSub&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($VerificaIdRisorsaRecuperaAsset/tns2:VerificaIdRisorsaRecuperaAssetResponse)>0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat('Ramo Dati -  ciclio numero: ',string(number($index)),' SelctAssett result: ', tib:render-xml($VerificaIdRisorsaRecuperaAsset, true(),true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Select asset non ha tornato record&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogOutSelectAsset-input"
