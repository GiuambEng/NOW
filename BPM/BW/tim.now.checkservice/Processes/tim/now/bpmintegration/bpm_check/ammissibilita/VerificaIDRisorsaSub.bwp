                                <bpws:links/>
                                <bpws:throw faultName="ns9:DefaultFault"
                                    faultVariable="Throw-input"
                                    name="Throw" tibex:xpdlId="682a2235-2090-481f-b431-52f344e3edca">
                                    <tibex:inputBindings>
