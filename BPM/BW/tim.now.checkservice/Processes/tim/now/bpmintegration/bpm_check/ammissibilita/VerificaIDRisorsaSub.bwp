                        portType="ns11:EsitiMultipliPortType" tibex:xpdlId="db5f4757-04ae-4410-9d09-42585bcc2ff7">
                        <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/EsitiMultipli/" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" version="2.0"&gt;&lt;xsl:param name="VerificaIDRisorsaSub"/&gt;&lt;xsl:param name="GetSottofamiglia"/&gt;&lt;xsl:param name="CountOccorrenzeAsset"/&gt;&lt;xsl:template name="EsitiMultipli-input" match="/"&gt;&lt;tns4:RecuperaCausaleEsitoMultiploRequest&gt;&lt;Input&gt;&lt;em:EsitiMultipliRequest&gt;&lt;em:IdRichiesta&gt;&lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IDRichiestaOLO"/&gt;&lt;/em:IdRichiesta&gt;&lt;em:CodiceControllo&gt;&lt;xsl:value-of select="'CTRL ID_RISORSA'"/&gt;&lt;/em:CodiceControllo&gt;&lt;xsl:choose&gt;&lt;xsl:when test="upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione) = ('SCHEDULAZIONE','ACCENSIONE')"&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_05'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$CountOccorrenzeAsset=0"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="(upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione) = ('CESSAZIONE','VARIAZIONE')) and ($GetSottofamiglia/Record[1]/SOTTOFAMIGLIA = (1, 2, 3, 10, 11, 12))"&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_01'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:when&gt;&lt;xsl:when test="(upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione) ='CESSAZIONE') and ($GetSottofamiglia/Record[1]/SOTTOFAMIGLIA = 15)"&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_06'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:when&gt;&lt;xsl:when test="upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione) = 'CESSAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA &amp;lt; 8 and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA &gt; 3"&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_03'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:when&gt;&lt;xsl:when test="upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione) = 'CESSAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA &gt;= 8"&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_02'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:when&gt;&lt;xsl:when test="(upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione) = 'VARIAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA &amp;lt; 8 and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA &gt; 3) or (upper-case($VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione) = 'VARIAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA =27 )"&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_02'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_03'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;em:EsitoControllo&gt;&lt;xsl:value-of select="'KO_04'"/&gt;&lt;/em:EsitoControllo&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;em:Offerta&gt;&lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Offerta"/&gt;&lt;/em:Offerta&gt;&lt;em:Lavorazione&gt;&lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:Lavorazione"/&gt;&lt;/em:Lavorazione&gt;&lt;em:IsPacchetto&gt;&lt;xsl:value-of select="$VerificaIDRisorsaSub/input/tns1:Verifica_ID_Risorsa_Request/tns1:IsPacchetto"/&gt;&lt;/em:IsPacchetto&gt;&lt;/em:EsitiMultipliRequest&gt;&lt;/Input&gt;&lt;/tns4:RecuperaCausaleEsitoMultiploRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                        <tibex:inputBindings>
                            <tibex:partBinding
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControllidiAmmissibilita/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/EsitiMultipli/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaIDRisorsaSub.input&quot;/>&#xa;    &lt;xsl:param name=&quot;GetSottofamiglia&quot;/>&#xa;    &lt;xsl:param name=&quot;CountOccorrenzeAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;EsitiMultipli-input&quot; match=&quot;/&quot;>&#xa;        &lt;em:EsitiMultipliRequest>&#xa;            &lt;em:IdRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/em:IdRichiesta>&#xa;            &lt;em:CodiceControllo>&#xa;                &lt;xsl:value-of select=&quot;'CTRL ID_RISORSA'&quot;/>&#xa;            &lt;/em:CodiceControllo>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione) = ('SCHEDULAZIONE','ACCENSIONE')&quot;>&#xa;                    &lt;em:EsitoControllo>&#xa;                        &lt;xsl:value-of select=&quot;'KO_05'&quot;/>&#xa;                    &lt;/em:EsitoControllo>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$CountOccorrenzeAsset=0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;(upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione) = ('CESSAZIONE','VARIAZIONE')) and ($GetSottofamiglia/Record[1]/SOTTOFAMIGLIA = (1, 2, 3, 10, 11, 12))&quot;>&#xa;                            &lt;em:EsitoControllo>&#xa;                                &lt;xsl:value-of select=&quot;'KO_01'&quot;/>&#xa;                            &lt;/em:EsitoControllo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione) ='CESSAZIONE') and ($GetSottofamiglia/Record[1]/SOTTOFAMIGLIA = 15)&quot;>&#xa;                            &lt;em:EsitoControllo>&#xa;                                &lt;xsl:value-of select=&quot;'KO_06'&quot;/>&#xa;                            &lt;/em:EsitoControllo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione) = 'CESSAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA &amp;lt; 8 and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA > 3&quot;>&#xa;                            &lt;em:EsitoControllo>&#xa;                                &lt;xsl:value-of select=&quot;'KO_03'&quot;/>&#xa;                            &lt;/em:EsitoControllo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione) = 'CESSAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA >= 8&quot;>&#xa;                            &lt;em:EsitoControllo>&#xa;                                &lt;xsl:value-of select=&quot;'KO_02'&quot;/>&#xa;                            &lt;/em:EsitoControllo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;(upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione) = 'VARIAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA &amp;lt; 8 and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA > 3) or (upper-case($VerificaIDRisorsaSub.input/tns1:Lavorazione) = 'VARIAZIONE' and $GetSottofamiglia/Record[1]/SOTTOFAMIGLIA =27 )&quot;>&#xa;                            &lt;em:EsitoControllo>&#xa;                                &lt;xsl:value-of select=&quot;'KO_02'&quot;/>&#xa;                            &lt;/em:EsitoControllo>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;em:EsitoControllo>&#xa;                                &lt;xsl:value-of select=&quot;'KO_03'&quot;/>&#xa;                            &lt;/em:EsitoControllo>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;em:EsitoControllo>&#xa;                        &lt;xsl:value-of select=&quot;'KO_04'&quot;/>&#xa;                    &lt;/em:EsitoControllo>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;em:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:Offerta&quot;/>&#xa;            &lt;/em:Offerta>&#xa;            &lt;em:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:Lavorazione&quot;/>&#xa;            &lt;/em:Lavorazione>&#xa;            &lt;em:IsPacchetto>&#xa;                &lt;xsl:value-of select=&quot;$VerificaIDRisorsaSub.input/tns1:IsPacchetto&quot;/>&#xa;            &lt;/em:IsPacchetto>&#xa;        &lt;/em:EsitiMultipliRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
