                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VerificaIdRisorsaRecuperaAsset-input"
                                    name="VerificaIdRisorsaRecuperaAsset"
                                    outputVariable="VerificaIdRisorsaRecuperaAsset"
                                    tibex:xpdlId="1ac13c34-837c-4bd1-91bc-37f2c9343af9"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
