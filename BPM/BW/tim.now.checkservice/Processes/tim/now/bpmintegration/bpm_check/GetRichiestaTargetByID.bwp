        <bpws:variable element="ns3:GetRichiestaTargetByID_Response"
            name="Mapper-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:GetRichiestaTargetByID_Response"
            name="Mapper" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:GetRichiestaTargetByID_Response"
            name="End-input" sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable name="TimeoutJDBC" sca-bpel:hotUpdate="false"
