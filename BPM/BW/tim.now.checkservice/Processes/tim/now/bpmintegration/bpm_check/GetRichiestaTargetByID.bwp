                                    sqlStatement="SELECT NOME, VALORE&#xa;  FROM DATI_VERIFICA_CTRLI&#xa;  WHERE ID_RICH_OLO = ? and TIPOLG_DATO = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
