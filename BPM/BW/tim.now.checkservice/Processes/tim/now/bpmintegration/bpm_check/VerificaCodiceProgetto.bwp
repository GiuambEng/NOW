            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoResponse&quot;/>&#xa;    &lt;xsl:template name=&quot;CallEsitiMultipli2-input&quot; match=&quot;/&quot;>&#xa;        &lt;em:EsitiMultipliRequest>&#xa;            &lt;em:IdRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:IDRichiesta&quot;/>&#xa;            &lt;/em:IdRichiesta>&#xa;            &lt;em:CodiceControllo>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;CTRL CODICE PROGETTO&amp;quot;&quot;/>&#xa;            &lt;/em:CodiceControllo>&#xa;            &lt;em:EsitoControllo>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione&quot;/>&#xa;            &lt;/em:EsitoControllo>&#xa;            &lt;em:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta&quot;/>&#xa;            &lt;/em:Offerta>&#xa;            &lt;em:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione&quot;/>&#xa;            &lt;/em:Lavorazione>&#xa;            &lt;xsl:if test=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Scenario&quot;>&#xa;                &lt;em:Scenario>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Scenario&quot;/>&#xa;                &lt;/em:Scenario>&#xa;            &lt;/xsl:if>&#xa;            &lt;em:IsPacchetto>&#xa;                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;            &lt;/em:IsPacchetto>&#xa;        &lt;/em:EsitiMultipliRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CallEsitiMultipli2-input"
                    name="CallEsitiMultipli2"
                    outputVariable="CallEsitiMultipli2"
                    tibex:xpdlId="7904002e-1dfa-4882-ab7a-c2ad9afd15cb"
