                    <bpws:sources>
                        <bpws:source linkName="LOG_ProgettoToVerificaCodiceProgettoResponseAssign1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_ProgettoToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;ULL&quot;) or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;SLU&quot;) or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;WLR&quot;) or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;VULL&quot;)) and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Lavorazione ='VARIAZIONE'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "ULL") or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "SLU") or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "WLR") or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "VULL")) and $VerificaCodiceProgettoIn.parameters/ns2:Lavorazione ='VARIAZIONE']]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgetto&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_Progetto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:CW_BUS_MESSAGE>&#xa;            &lt;tns5:GenericLogger>&#xa;                &lt;tns5:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns5:Application>&#xa;                &lt;tns5:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCodiceProgetto&amp;quot;&quot;/>&#xa;                &lt;/tns5:Process>&#xa;                &lt;tns5:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns5:Service>&#xa;                &lt;tns5:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaCodiceProgetto&amp;quot;&quot;/>&#xa;                &lt;/tns5:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaCodiceProgettoIn.parameters/tns2:IDRichiesta&quot;>&#xa;                    &lt;tns5:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn.parameters/tns2:IDRichiesta&quot;/>&#xa;                    &lt;/tns5:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectProgetto/Record) > 0&quot;>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Risultato SelectProgetto: &amp;quot;, tib:render-xml($SelectProgetto/Record[1], true(), true()))&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns5:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun record recuperato.&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns5:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns5:LoggerName>&#xa;                &lt;tns5:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns5:LogLevel>&#xa;                &lt;tns5:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns5:LogJMS>&#xa;            &lt;/tns5:GenericLogger>&#xa;            &lt;tns5:ActiveLoggerServices>&#xa;                &lt;tns5:Envelope>&#xa;                    &lt;tns5:Identifier>&#xa;                        &lt;tns5:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_check&amp;quot;&quot;/>&#xa;                        &lt;/tns5:ServiceName>&#xa;                        &lt;tns5:Operation>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaCodiceProgetto&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Operation>&#xa;                        &lt;tns5:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns5:Source>&#xa;                        &lt;xsl:if test=&quot;$VerificaCodiceProgettoIn.parameters/tns2:IDRichiesta&quot;>&#xa;                            &lt;tns5:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn.parameters/tns2:IDRichiesta&quot;/>&#xa;                            &lt;/tns5:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns5:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;VerificaCodiceProgetto_SUB-PROCESS&amp;quot;&quot;/>&#xa;                        &lt;/tns5:EventType>&#xa;                    &lt;/tns5:Identifier>&#xa;                    &lt;tns5:track_position>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                    &lt;/tns5:track_position>&#xa;                    &lt;tns5:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns5:Timestamp>&#xa;                &lt;/tns5:Envelope>&#xa;            &lt;/tns5:ActiveLoggerServices>&#xa;        &lt;/tns5:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
