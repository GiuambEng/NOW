                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgetto&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlliInvoke1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn.parameters/tns2:IDRichiesta&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:LavorazioneRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectProgetto) and $SelectProgetto/Record[1]/ONESTEP = 'SI' and string-length($SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO)>0 and (starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SLU') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'BITSTREAM') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'UBB') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'EASYIP') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SEMI') or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'VULAFTTH')&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;>&#xa;                            &lt;tns1:ProprietaMateriale>&#xa;                                &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;/>&#xa;                            &lt;/tns1:ProprietaMateriale>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/PRODOTTI_A_CATALOGO&quot;>&#xa;                    &lt;tns1:ProdottoCatalogo>&#xa;                        &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/PRODOTTI_A_CATALOGO&quot;/>&#xa;                    &lt;/tns1:ProdottoCatalogo>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:LavorazioneRichiesta>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AssignToDatiVerificaControlliInvoke1"/>
                </bpws:targets>
                <bpws:sources>
