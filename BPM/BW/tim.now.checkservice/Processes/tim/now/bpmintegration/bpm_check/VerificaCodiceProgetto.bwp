                tibex:xpdlId="3a07db5d-74ea-40ee-a499-e0ed7bbef22d" variable="VerificaCodiceProgettoOutput-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:tns2="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="VerificaCodiceProgettoResponse"/&gt;&lt;xsl:param name="FlagEnrichment"/&gt;&lt;xsl:param name="JDBC_AnagraficaProgettoVULL"/&gt;&lt;xsl:param name="SelectProgetto"/&gt;&lt;xsl:param name="CallEsitiMultipli"/&gt;&lt;xsl:param name="VerificaCodiceProgettoIn"/&gt;&lt;xsl:param name="CallEsitiMultipli2"/&gt;&lt;xsl:template name="VerificaCodiceProgettoOutput-input" match="/"&gt;&lt;tns3:VerificaCodiceProgettoResponse&gt;&lt;parameters&gt;&lt;tns3:VerificaCodiceProgettoResponse&gt;&lt;tns2:Esito&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione ='ATTIVAZIONE' and ( starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;BITSTREAMGBE&amp;quot;) or  starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;EASYIP&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;BITSTREAMATM&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta !=&amp;quot;EASYIPNGAFTTCAB&amp;quot; and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta !=&amp;quot;EASYIPNGAFTTH&amp;quot;  and string-length($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Codice_Progetto) =0 and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Flag_Modem ='Y'"&gt;&lt;tns2:Codice&gt;&lt;xsl:value-of select="false()"/&gt;&lt;/tns2:Codice&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Codice&gt;&lt;xsl:value-of select="$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice"/&gt;&lt;/tns2:Codice&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione ='ATTIVAZIONE' and ( starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;BITSTREAMGBE&amp;quot;) or  starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;EASYIP&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;BITSTREAMATM&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta !=&amp;quot;EASYIPNGAFTTCAB&amp;quot; and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta !=&amp;quot;EASYIPNGAFTTH&amp;quot;  and string-length($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Codice_Progetto) =0 and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Flag_Modem ='Y'"&gt;&lt;tns2:Descrizione&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns2:Descrizione&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns2:Descrizione&gt;&lt;xsl:value-of select="$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione"/&gt;&lt;/tns2:Descrizione&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns2:Esito&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($VerificaCodiceProgettoResponse/tns2:Id_Progetto)"&gt;&lt;xsl:if test="$VerificaCodiceProgettoResponse/tns2:Id_Progetto"&gt;&lt;tns2:Id_Progetto&gt;&lt;xsl:value-of select="$VerificaCodiceProgettoResponse/tns2:Id_Progetto"/&gt;&lt;/tns2:Id_Progetto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$VerificaCodiceProgettoResponse/tns2:ProgettoVULL"&gt;&lt;tns2:ProgettoVULL&gt;&lt;xsl:value-of select="$VerificaCodiceProgettoResponse/tns2:ProgettoVULL"/&gt;&lt;/tns2:ProgettoVULL&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($CallEsitiMultipli2/em:IdAnagraficaCausale)"&gt;&lt;xsl:if test="$CallEsitiMultipli2/em:IdAnagraficaCausale"&gt;&lt;tns2:IdCausale&gt;&lt;xsl:value-of select="$CallEsitiMultipli2/em:IdAnagraficaCausale"/&gt;&lt;/tns2:IdCausale&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="$CallEsitiMultipli/em:IdAnagraficaCausale"&gt;&lt;tns2:IdCausale&gt;&lt;xsl:value-of select="$CallEsitiMultipli/em:IdAnagraficaCausale"/&gt;&lt;/tns2:IdCausale&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$FlagEnrichment=true()"&gt;&lt;tns2:DatiAccesso&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($SelectProgetto/Record) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = true()"&gt;&lt;xsl:if test="$SelectProgetto/Record[1]/ID_PRGT"&gt;&lt;tns1:IDCodiceProgetto&gt;&lt;xsl:value-of select="$SelectProgetto/Record[1]/ID_PRGT"/&gt;&lt;/tns1:IDCodiceProgetto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($JDBC_AnagraficaProgettoVULL/Record)"&gt;&lt;xsl:if test="$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT"&gt;&lt;tns1:IDCodiceProgetto&gt;&lt;xsl:value-of select="$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT"/&gt;&lt;/tns1:IDCodiceProgetto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = false()"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($JDBC_AnagraficaProgettoVULL/Record)"&gt;&lt;tns1:ProgettoVULL&gt;&lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;&lt;/tns1:ProgettoVULL&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ProgettoVULL&gt;&lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;&lt;/tns1:ProgettoVULL&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="$VerificaCodiceProgettoResponse/tns2:DatiAccesso/tns1:OneStep"&gt;&lt;tns1:OneStep&gt;&lt;xsl:value-of select="$VerificaCodiceProgettoResponse/tns2:DatiAccesso/tns1:OneStep"/&gt;&lt;/tns1:OneStep&gt;&lt;/xsl:if&gt;&lt;/tns2:DatiAccesso&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($SelectProgetto) and $SelectProgetto/Record[1]/ONESTEP = 'SI' and string-length($SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO)&gt;0 and (starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'SLU') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'BITSTREAM') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'UBB') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'EASYIP') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'SEMI') or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'VULAFTTH' or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'SEMIGPON1BPNRR' or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'FULLGPON1BPNRR')"&gt;&lt;xsl:if test="$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO"&gt;&lt;tns2:ProprietaMateriale&gt;&lt;xsl:value-of select="$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO"/&gt;&lt;/tns2:ProprietaMateriale&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="exists($SelectProgetto) and string-length($SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI)&gt;0"&gt;&lt;xsl:if test="$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI"&gt;&lt;tns2:FlagEquivalenzaProdotti&gt;&lt;xsl:value-of select="$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI"/&gt;&lt;/tns2:FlagEquivalenzaProdotti&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$SelectProgetto/Record[1]/PRODOTTI_A_CATALOGO"&gt;&lt;tns2:ProdottoCatologo&gt;&lt;xsl:value-of select="$SelectProgetto/Record[1]/PRODOTTI_A_CATALOGO"/&gt;&lt;/tns2:ProdottoCatologo&gt;&lt;/xsl:if&gt;&lt;/tns3:VerificaCodiceProgettoResponse&gt;&lt;/parameters&gt;&lt;/tns3:VerificaCodiceProgettoResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_AnagraficaProgettoVULL&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgetto&quot;/>&#xa;    &lt;xsl:param name=&quot;CallEsitiMultipli&quot;/>&#xa;    &lt;xsl:param name=&quot;CallEsitiMultipli2&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCodiceProgettoOutput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:VerificaCodiceProgettoResponse>&#xa;            &lt;tns2:Esito>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$VerificaCodiceProgettoIn.parameters/tns2:Lavorazione ='ATTIVAZIONE' and ( starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;BITSTREAMGBE&amp;quot;) or  starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;EASYIP&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;BITSTREAMATM&amp;quot;)) and  $VerificaCodiceProgettoIn.parameters/tns2:Offerta !=&amp;quot;EASYIPNGAFTTCAB&amp;quot; and $VerificaCodiceProgettoIn.parameters/tns2:Offerta !=&amp;quot;EASYIPNGAFTTH&amp;quot;  and string-length($VerificaCodiceProgettoIn.parameters/tns2:Codice_Progetto) =0 and $VerificaCodiceProgettoIn.parameters/tns2:Flag_Modem ='Y'&quot;>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$VerificaCodiceProgettoIn.parameters/tns2:Lavorazione ='ATTIVAZIONE' and ( starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;BITSTREAMGBE&amp;quot;) or  starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;EASYIP&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;BITSTREAMATM&amp;quot;)) and  $VerificaCodiceProgettoIn.parameters/tns2:Offerta !=&amp;quot;EASYIPNGAFTTCAB&amp;quot; and $VerificaCodiceProgettoIn.parameters/tns2:Offerta !=&amp;quot;EASYIPNGAFTTH&amp;quot;  and string-length($VerificaCodiceProgettoIn.parameters/tns2:Codice_Progetto) =0 and $VerificaCodiceProgettoIn.parameters/tns2:Flag_Modem ='Y'&quot;>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns2:Esito>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaCodiceProgettoResponse/tns2:Id_Progetto)&quot;>&#xa;                    &lt;xsl:if test=&quot;$VerificaCodiceProgettoResponse/tns2:Id_Progetto&quot;>&#xa;                        &lt;tns2:Id_Progetto>&#xa;                            &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoResponse/tns2:Id_Progetto&quot;/>&#xa;                        &lt;/tns2:Id_Progetto>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$VerificaCodiceProgettoResponse/tns2:ProgettoVULL&quot;>&#xa;                &lt;tns2:ProgettoVULL>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoResponse/tns2:ProgettoVULL&quot;/>&#xa;                &lt;/tns2:ProgettoVULL>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CallEsitiMultipli2/em:IdAnagraficaCausale)&quot;>&#xa;                    &lt;xsl:if test=&quot;$CallEsitiMultipli2/em:IdAnagraficaCausale&quot;>&#xa;                        &lt;tns2:IdCausale>&#xa;                            &lt;xsl:value-of select=&quot;$CallEsitiMultipli2/em:IdAnagraficaCausale&quot;/>&#xa;                        &lt;/tns2:IdCausale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$CallEsitiMultipli/em:IdAnagraficaCausale&quot;>&#xa;                        &lt;tns2:IdCausale>&#xa;                            &lt;xsl:value-of select=&quot;$CallEsitiMultipli/em:IdAnagraficaCausale&quot;/>&#xa;                        &lt;/tns2:IdCausale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectProgetto/Record) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = true()&quot;>&#xa;                                &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/ID_PRGT&quot;>&#xa;                                    &lt;tns1:IDCodiceProgetto>&#xa;                                        &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/ID_PRGT&quot;/>&#xa;                                    &lt;/tns1:IDCodiceProgetto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_AnagraficaProgettoVULL/Record)&quot;>&#xa;                                &lt;xsl:if test=&quot;$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT&quot;>&#xa;                                    &lt;tns1:IDCodiceProgetto>&#xa;                                        &lt;xsl:value-of select=&quot;$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT&quot;/>&#xa;                                    &lt;/tns1:IDCodiceProgetto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = false()&quot;>&#xa;                                &lt;xsl:choose>&#xa;                                    &lt;xsl:when test=&quot;exists($JDBC_AnagraficaProgettoVULL/Record)&quot;>&#xa;                                        &lt;tns1:ProgettoVULL>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:ProgettoVULL>&#xa;                                    &lt;/xsl:when>&#xa;                                    &lt;xsl:otherwise>&#xa;                                        &lt;tns1:ProgettoVULL>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                        &lt;/tns1:ProgettoVULL>&#xa;                                    &lt;/xsl:otherwise>&#xa;                                &lt;/xsl:choose>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise/>&#xa;                        &lt;/xsl:choose>&#xa;                        &lt;xsl:if test=&quot;$VerificaCodiceProgettoResponse/tns2:DatiAccesso/tns1:OneStep&quot;>&#xa;                            &lt;tns1:OneStep>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoResponse/tns2:DatiAccesso/tns1:OneStep&quot;/>&#xa;                            &lt;/tns1:OneStep>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SelectProgetto) and $SelectProgetto/Record[1]/ONESTEP = 'SI' and string-length($SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO)>0 and (starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SLU') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'BITSTREAM') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'UBB') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'EASYIP') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SEMI') or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'VULAFTTH' or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'SEMIGPON1BPNRR' or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'FULLGPON1BPNRR')&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;>&#xa;                        &lt;tns2:ProprietaMateriale>&#xa;                            &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;/>&#xa;                        &lt;/tns2:ProprietaMateriale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;exists($SelectProgetto) and string-length($SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI)>0&quot;>&#xa;                &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI&quot;>&#xa;                    &lt;tns2:FlagEquivalenzaProdotti>&#xa;                        &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI&quot;/>&#xa;                    &lt;/tns2:FlagEquivalenzaProdotti>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/PRODOTTI_A_CATALOGO&quot;>&#xa;                &lt;tns2:ProdottoCatologo>&#xa;                    &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/PRODOTTI_A_CATALOGO&quot;/>&#xa;                &lt;/tns2:ProdottoCatologo>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns3:VerificaCodiceProgettoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AssignToVerificaCodiceProgettoOutput1_OK"/>
                    <bpws:target linkName="CallProcessToVerificaCodiceProgettoOutput"/>
                    <bpws:target linkName="CallEsitiMultipli2ToVerificaCodiceProgettoOutput"/>
                </bpws:targets>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9e5d450f-f4b4-432d-ae34-2c49eec6e97f+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectProgetto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;CODICE_PROGETTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Codice_Progetto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Codice_Progetto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_PROGETTO>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Codice_OLO&quot;/>&#xa;            &lt;/COD_OLO>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectProgetto-input"
                    name="SelectProgetto"
                    outputVariable="SelectProgetto"
                    tibex:xpdlId="9e5d450f-f4b4-432d-ae34-2c49eec6e97f" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToSelectProgetto"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectProgettoToCopy_1_LOG_Input"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9e5d450f-f4b4-432d-ae34-2c49eec6e97f+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectProgetto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcQueryActivityInput>&#xa;            &lt;CODICE_PROGETTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($VerificaCodiceProgettoIn.parameters/tns2:Codice_Progetto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn.parameters/tns2:Codice_Progetto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODICE_PROGETTO>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn.parameters/tns2:Codice_OLO&quot;/>&#xa;            &lt;/COD_OLO>&#xa;        &lt;/tns4:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT P.COD_PRGT, P.DATAFI_VALID, P.DATAINZ_VALID, ID_PRGT, P.ONESTEP, P.PROPRIETAMATERIALEOAO, P.FLAGEQUIVALENZAPRODOTTI, P.PRODOTTI_A_CATALOGO&#xa;FROM PRGT P, OLO O&#xa;WHERE P.COD_PRGT = ? AND P.CODFC_OLO_AGCOM = O.CODFC_OLO_AGCOM AND &#x9;O.COD_OLO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICE_PROGETTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <columnMetadata columnIndex="1"
                                    columnName="COD_PRGT"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="2"
                                    columnName="DATAFI_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="3"
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata columnIndex="4"
                                    columnName="ID_PRGT"
                                    dataType="1111" typeName="NUMBER"/>
                                    <columnMetadata columnIndex="5"
                                    columnName="ONESTEP"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="6"
                                    columnName="PROPRIETAMATERIALEOAO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="7"
                                    columnName="FLAGEQUIVALENZAPRODOTTI"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata columnIndex="8"
                                    columnName="PRODOTTI_A_CATALOGO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgetto&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCodiceProgettoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) &amp;lt; $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:DRO and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:DRO &amp;lt; tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($SelectProgetto/Record[1]/DATAFI_VALID))&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta), &amp;quot;VULL&amp;quot;) or starts-with(upper-case($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta), &amp;quot;VLAN&amp;quot;) or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta='VP'&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) &amp;lt; $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:DRO and starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;WLR&amp;quot;) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione=(&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;MIGRAZIONE&amp;quot;,&amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;tns2:ProgettoVULL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns2:ProgettoVULL>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) &amp;lt; $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:DRO and (starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SLU&amp;quot;)) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione=(&amp;quot;MIGRAZIONE&amp;quot;)&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;tns2:ProgettoVULL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns2:ProgettoVULL>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:DRO &amp;lt; tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($SelectProgetto/Record[1]/DATAFI_VALID)) and  (starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SLU&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;VARIAZIONE&amp;quot;)&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;tns2:ProgettoVULL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns2:ProgettoVULL>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($SelectProgetto/Record)=0&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO_CASO1&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta), &amp;quot;VULL&amp;quot;)&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) >= $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:DRO&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO_CASO2&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta), &amp;quot;VULL&amp;quot;)&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:DRO >= tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($SelectProgetto/Record[1]/DATAFI_VALID))&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO_CASO3&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta), &amp;quot;VULL&amp;quot;)&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
