                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgetto&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaCodiceProgettoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) &amp;lt; $VerificaCodiceProgettoIn.parameters/tns2:DRO and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn.parameters/tns2:DRO &amp;lt; tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($SelectProgetto/Record[1]/DATAFI_VALID))&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn.parameters/tns2:Offerta), &amp;quot;VULL&amp;quot;) or starts-with(upper-case($VerificaCodiceProgettoIn.parameters/tns2:Offerta), &amp;quot;VLAN&amp;quot;) or $VerificaCodiceProgettoIn.parameters/tns2:Offerta='VP'&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) &amp;lt; $VerificaCodiceProgettoIn.parameters/tns2:DRO and starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;WLR&amp;quot;) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn.parameters/tns2:Lavorazione=(&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;MIGRAZIONE&amp;quot;,&amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;tns2:ProgettoVULL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns2:ProgettoVULL>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) &amp;lt; $VerificaCodiceProgettoIn.parameters/tns2:DRO and (starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;VULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;SLU&amp;quot;)) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn.parameters/tns2:Lavorazione=(&amp;quot;MIGRAZIONE&amp;quot;)&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;tns2:ProgettoVULL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns2:ProgettoVULL>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn.parameters/tns2:DRO &amp;lt; tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($SelectProgetto/Record[1]/DATAFI_VALID)) and  (starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;VULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, &amp;quot;SLU&amp;quot;)) and  $VerificaCodiceProgettoIn.parameters/tns2:Lavorazione =(&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;VARIAZIONE&amp;quot;)&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;tns2:ProgettoVULL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns2:ProgettoVULL>&#xa;                    &lt;tns2:DatiAccesso>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/tns2:DatiAccesso>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;count($SelectProgetto/Record)=0&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO_CASO1&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn.parameters/tns2:Offerta), &amp;quot;VULL&amp;quot;)&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;,  string($SelectProgetto/Record[1]/DATAINZ_VALID)) >= $VerificaCodiceProgettoIn.parameters/tns2:DRO&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO_CASO2&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn.parameters/tns2:Offerta), &amp;quot;VULL&amp;quot;)&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectProgetto/Record/ID_PRGT) and &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn.parameters/tns2:DRO >= tib:parse-date(&amp;quot;yyyy-MM-dd&amp;quot;, string($SelectProgetto/Record[1]/DATAFI_VALID))&quot;>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO_CASO3&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                    &lt;tns2:Id_Progetto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectProgetto/Record[1]/ID_PRGT)&quot;/>&#xa;                    &lt;/tns2:Id_Progetto>&#xa;                    &lt;xsl:if test=&quot;starts-with(upper-case($VerificaCodiceProgettoIn.parameters/tns2:Offerta), &amp;quot;VULL&amp;quot;)&quot;>&#xa;                        &lt;tns2:ProgettoVULL>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns2:ProgettoVULL>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns2:Verifica_Codice_Progetto_Response>&#xa;                    &lt;tns2:Esito>&#xa;                        &lt;tns2:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns2:Codice>&#xa;                        &lt;tns2:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Descrizione>&#xa;                    &lt;/tns2:Esito>&#xa;                &lt;/tns2:Verifica_Codice_Progetto_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
