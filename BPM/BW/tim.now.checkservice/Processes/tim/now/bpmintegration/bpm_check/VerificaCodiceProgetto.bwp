            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaCodiceProgettoIn&quot;/>&lt;xsl:param name=&quot;VerificaCodiceProgettoResponse&quot;/>&lt;xsl:template name=&quot;CallEsitiMultipli-input&quot; match=&quot;/&quot;>&lt;em:EsitiMultipliRequest>&lt;em:IdRichiesta>&lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:IDRichiesta&quot;/>&lt;/em:IdRichiesta>&lt;em:CodiceControllo>&lt;xsl:value-of select=&quot;&amp;quot;CTRL CODICE PROGETTO&amp;quot;&quot;/>&lt;/em:CodiceControllo>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione ='ATTIVAZIONE' and ( starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;BITSTREAMGBE&amp;quot;) or  starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;BITSTREAMATM&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;EASYIP&amp;quot;)) and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta !=&amp;quot;EASYIPNGAFTTCAB&amp;quot; and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta !=&amp;quot;EASYIPNGAFTTH&amp;quot; and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta !=&amp;quot;SEMIEASYIPNGAFTTH&amp;quot; and string-length($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Codice_Progetto) =0 and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Flag_Modem ='Y'&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_08&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;BITSTREAM&amp;quot;) or &amp;#xD;&amp;#xA;starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SEMIBITSTREAM&amp;quot;) or&amp;#xD;&amp;#xA;starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;EASYIP&amp;quot;) or&amp;#xD;&amp;#xA;starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SEMIEASYIP&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULA&amp;quot;) or&amp;#xD;&amp;#xA;starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SEMIVULA&amp;quot;) or  starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VLAN&amp;quot;) or&amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta='VP' or&amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;SEDEOLT&amp;quot; or &amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;CANALE&amp;quot; or&amp;#xD;&amp;#xA;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;FIXEDWIRELESSACCESS&amp;quot; or  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;FIBERSTREAM&amp;quot; or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;FWAITALIA1GIGASARDEGNA&amp;quot; or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;FULLGPONPLUS&amp;quot; or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;FULLGPONPLUSNGA&amp;quot;&amp;#xD;&amp;#xA;or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;SEMIGPON1BPNRR&amp;quot; or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=&amp;quot;FULLGPON1BPNRR&amp;quot;or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta='UBBSEMIGPON' or  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta='UBBFULLGPON' )&amp;#xD;&amp;#xA;and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;ATTIVAZIONE&amp;quot;,&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;VARIAZIONE&amp;quot;,&amp;quot;MIGRAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = false()&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_07&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SLU&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;ATTIVAZIONE&amp;quot;,&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;VARIAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione = &amp;quot;KO_CASO1&amp;quot;&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SLU&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;ATTIVAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione = &amp;quot;KO_CASO2&amp;quot;&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SLU&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;ATTIVAZIONE&amp;quot;,&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;VARIAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione =&amp;quot;KO_CASO3&amp;quot;&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_03&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;WLR&amp;quot;))   and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;ATTIVAZIONE&amp;quot;,&amp;quot;CESSAZIONE&amp;quot;,&amp;quot;VARIAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione = &amp;quot;KO_CASO1&amp;quot;&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;WLR&amp;quot;))   and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;ATTIVAZIONE&amp;quot;,&amp;quot;VARIAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione = &amp;quot;KO_CASO2&amp;quot;&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_04&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;WLR&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SLU&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULL&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;MIGRAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione = &amp;quot;KO_CASO1&amp;quot;&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_05&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;ULL&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SHA&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;WLR&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;SLU&amp;quot;) or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;VULL&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;MIGRAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Descrizione = &amp;quot;KO_CASO2&amp;quot;&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:when test=&quot;(starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, &amp;quot;NP&amp;quot;)) and  $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione =(&amp;quot;ATTIVAZIONE&amp;quot;) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = false()&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;&amp;quot;KO_06&amp;quot;&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;'KO_06'&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;em:Offerta>&lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta&quot;/>&lt;/em:Offerta>&lt;em:Lavorazione>&lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione&quot;/>&lt;/em:Lavorazione>&lt;xsl:if test=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Scenario&quot;>&lt;em:Scenario>&lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Scenario&quot;/>&lt;/em:Scenario>&lt;/xsl:if>&lt;em:IsPacchetto>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/em:IsPacchetto>&lt;/em:EsitiMultipliRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
