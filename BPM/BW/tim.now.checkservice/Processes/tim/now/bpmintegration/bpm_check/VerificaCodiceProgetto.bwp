                    <bpws:sources>
                        <bpws:source linkName="RecuperaCodiceSessioneToRecuperaCausaleEsitoMultiplo_KO">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="(count($Oscuramento/Record) = 0 or $Oscuramento/Record[1]/FLAG_OSCURMENTO != '1') and string-length($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Codice_Progetto) = 0 and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Lavorazione = 'MIGRAZIONE' and ($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta = ('BITSTREAMNGAFTTCAB', 'VULAFTTCAB', 'EASYIPNGAFTTCAB') or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, 'SLU')) and $RecuperaCodiceSessione/Record[1]/TIPOLOGIASOTTOLAV='MIGRAZIONEOLO' and $RecuperaCodiceSessione/Record[1]/CODICESESSIONE='CAMBIOTECNOLOGIA'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[(count($Oscuramento/Record) = 0 or $Oscuramento/Record[1]/FLAG_OSCURMENTO != '1') and string-length($VerificaCodiceProgettoIn.parameters/ns2:Codice_Progetto) = 0 and $VerificaCodiceProgettoIn.parameters/ns2:Lavorazione = 'MIGRAZIONE' and ($VerificaCodiceProgettoIn.parameters/ns2:Offerta = ('BITSTREAMNGAFTTCAB', 'VULAFTTCAB', 'EASYIPNGAFTTCAB') or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, 'SLU')) and $RecuperaCodiceSessione/Record[1]/TIPOLOGIASOTTOLAV='MIGRAZIONEOLO' and $RecuperaCodiceSessione/Record[1]/CODICESESSIONE='CAMBIOTECNOLOGIA']]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="RecuperaCodiceSessioneToEmpty">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="RecuperaCodiceSessioneToDatiVerificaControlli">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Codice_Progetto)=0 and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Lavorazione = 'ATTIVAZIONE' and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Flag_Naked='S' and ($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta=('BITSTREAMNGAFTTCAB', 'VULAFTTCAB', 'EASYIPNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA') or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, 'SLU')) and ($RecuperaCodiceSessione/Record[1]/CODICESESSIONE='CAMBIOTECNOLOGIA' or $RecuperaCodiceSessione/Record[1]/TIPOLOGIASOTTOLAV='CAMBIOTECNOLOGIA' or $RecuperaCodiceSessione/Record[1]/CAMBIOTECNOLOGIA='S')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($VerificaCodiceProgettoIn.parameters/ns2:Codice_Progetto)=0 and $VerificaCodiceProgettoIn.parameters/ns2:Lavorazione = 'ATTIVAZIONE' and $VerificaCodiceProgettoIn.parameters/ns2:Flag_Naked='S' and ($VerificaCodiceProgettoIn.parameters/ns2:Offerta=('BITSTREAMNGAFTTCAB', 'VULAFTTCAB', 'EASYIPNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA') or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, 'SLU')) and ($RecuperaCodiceSessione/Record[1]/CODICESESSIONE='CAMBIOTECNOLOGIA' or $RecuperaCodiceSessione/Record[1]/TIPOLOGIASOTTOLAV='CAMBIOTECNOLOGIA' or $RecuperaCodiceSessione/Record[1]/CAMBIOTECNOLOGIA='S')]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
