                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns1="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns2="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" version="2.0"&gt;&lt;xsl:param name="VerificaCodiceProgettoIn"/&gt;&lt;xsl:param name="SelectProgetto"/&gt;&lt;xsl:param name="VerificaCodiceProgettoResponse"/&gt;&lt;xsl:param name="JDBC_AnagraficaProgettoVULL"/&gt;&lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;&lt;tns:DatiVerificaControlliRequest&gt;&lt;parameters&gt;&lt;tns1:DatiVerificaControlliInput&gt;&lt;tns1:Operatore&gt;&lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;&lt;/tns1:Operatore&gt;&lt;tns1:IDRichiestaOLO&gt;&lt;xsl:value-of select="$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:IDRichiesta"/&gt;&lt;/tns1:IDRichiestaOLO&gt;&lt;tns1:Azione&gt;&lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;&lt;/tns1:Azione&gt;&lt;tns1:DatiAccesso&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($SelectProgetto/Record) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = true()"&gt;&lt;xsl:if test="$SelectProgetto/Record[1]/ID_PRGT"&gt;&lt;tns1:IDCodiceProgetto&gt;&lt;xsl:value-of select="$SelectProgetto/Record[1]/ID_PRGT"/&gt;&lt;/tns1:IDCodiceProgetto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($JDBC_AnagraficaProgettoVULL/Record)"&gt;&lt;xsl:if test="$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT"&gt;&lt;tns1:IDCodiceProgetto&gt;&lt;xsl:value-of select="$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT"/&gt;&lt;/tns1:IDCodiceProgetto&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = false()"&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($JDBC_AnagraficaProgettoVULL/Record)"&gt;&lt;tns1:ProgettoVULL&gt;&lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;&lt;/tns1:ProgettoVULL&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:ProgettoVULL&gt;&lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;&lt;/tns1:ProgettoVULL&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise/&gt;&lt;/xsl:choose&gt;&lt;xsl:choose&gt;&lt;xsl:when test="$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione='ATTIVAZIONE' and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR') and $SelectProgetto/Record[1]/ONESTEP='SI'"&gt;&lt;tns1:OneStep&gt;&lt;xsl:value-of select="'Y'"/&gt;&lt;/tns1:OneStep&gt;&lt;/xsl:when&gt;&lt;xsl:when test="$VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTCAB','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH','BITSTREAMATMASIMMETRICO','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','FULLGPONPLUS','FULLGPONPLUSNGA') and $SelectProgetto/Record[1]/ONESTEP='SI' and $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Flag_Naked='S'"&gt;&lt;tns1:OneStep&gt;&lt;xsl:value-of select="'Y'"/&gt;&lt;/tns1:OneStep&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:OneStep&gt;&lt;xsl:value-of select="'N'"/&gt;&lt;/tns1:OneStep&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;/tns1:DatiAccesso&gt;&lt;tns1:LavorazioneRichiesta&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($SelectProgetto) and $SelectProgetto/Record[1]/ONESTEP = 'SI' and string-length($SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO)&gt;0 and (starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'SLU') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'BITSTREAM') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'UBB') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'EASYIP') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'SEMI') or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'VULAFTTH' or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'FULLGPONPLUS' or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'FULLGPONPLUSNGA' or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'SEMIGPON1BPNRR' or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'FULLGPON1BPNRR')"&gt;&lt;xsl:if test="$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO"&gt;&lt;tns1:ProprietaMateriale&gt;&lt;xsl:value-of select="$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO"/&gt;&lt;/tns1:ProprietaMateriale&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="exists($SelectProgetto) and string-length($SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI)&gt;0"&gt;&lt;xsl:if test="$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI"&gt;&lt;tns1:FlagEquivalenzaProdotti&gt;&lt;xsl:value-of select="$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI"/&gt;&lt;/tns1:FlagEquivalenzaProdotti&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;/tns1:LavorazioneRichiesta&gt;&lt;/tns1:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgetto&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_AnagraficaProgettoVULL&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlliInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:DatiVerificaControlliInput>&#xa;            &lt;tns1:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns1:Operatore>&#xa;            &lt;tns1:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaCodiceProgettoIn.parameters/tns2:IDRichiesta&quot;/>&#xa;            &lt;/tns1:IDRichiestaOLO>&#xa;            &lt;tns1:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns1:Azione>&#xa;            &lt;tns1:DatiAccesso>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectProgetto/Record) and $VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = true()&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/ID_PRGT&quot;>&#xa;                            &lt;tns1:IDCodiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/ID_PRGT&quot;/>&#xa;                            &lt;/tns1:IDCodiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;exists($JDBC_AnagraficaProgettoVULL/Record)&quot;>&#xa;                        &lt;xsl:if test=&quot;$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT&quot;>&#xa;                            &lt;tns1:IDCodiceProgetto>&#xa;                                &lt;xsl:value-of select=&quot;$JDBC_AnagraficaProgettoVULL/Record[1]/COD_PRGT&quot;/>&#xa;                            &lt;/tns1:IDCodiceProgetto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$VerificaCodiceProgettoResponse/tns2:Esito/tns2:Codice = false()&quot;>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($JDBC_AnagraficaProgettoVULL/Record)&quot;>&#xa;                                &lt;tns1:ProgettoVULL>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                &lt;/tns1:ProgettoVULL>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;tns1:ProgettoVULL>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                &lt;/tns1:ProgettoVULL>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise/>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$VerificaCodiceProgettoIn.parameters/tns2:Lavorazione='ATTIVAZIONE' and $VerificaCodiceProgettoIn.parameters/tns2:Offerta=('UBBSEMIGPON','UBBFULLGPON','SEMIGPON1BPNRR','FULLGPON1BPNRR') and $SelectProgetto/Record[1]/ONESTEP='SI'&quot;>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;$VerificaCodiceProgettoIn.parameters/tns2:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $VerificaCodiceProgettoIn.parameters/tns2:Offerta=('BITSTREAMNGAFTTCAB','BITSTREAMNGAFTTH','SEMIBITSTREAMNGAFTTH','VULAFTTCAB','VULAFTTH','SEMIVULAFTTH','EASYIPNGAFTTCAB','EASYIPNGAFTTH','SEMIEASYIPNGAFTTH','BITSTREAMATMASIMMETRICO','BITSTREAMATMASIMMETRICOFLAT','BITSTREAMATMASIMMETRICOHL','BITSTREAMATMASIMMETRICOLITE','BITSTREAMGBEASIMMETRICOFLAT','EASYIPBASEPLUSFLAT','EASYIPBASEPLUSLITE','EASYIPSPECIALPROFILEFLAT','EASYIPSPECIALPROFILELITE','FULLGPONPLUS','FULLGPONPLUSNGA') and $SelectProgetto/Record[1]/ONESTEP='SI' and $VerificaCodiceProgettoIn.parameters/tns2:Flag_Naked='S'&quot;>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'Y'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:OneStep>&#xa;                            &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                        &lt;/tns1:OneStep>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns1:DatiAccesso>&#xa;            &lt;tns1:LavorazioneRichiesta>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectProgetto) and $SelectProgetto/Record[1]/ONESTEP = 'SI' and string-length($SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO)>0 and (starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SLU') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'BITSTREAM') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'UBB') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'EASYIP') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SEMI') or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'VULAFTTH' or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'FULLGPONPLUS' or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'FULLGPONPLUSNGA' or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'SEMIGPON1BPNRR' or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'FULLGPON1BPNRR')&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;>&#xa;                            &lt;tns1:ProprietaMateriale>&#xa;                                &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;/>&#xa;                            &lt;/tns1:ProprietaMateriale>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:if test=&quot;exists($SelectProgetto) and string-length($SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI&quot;>&#xa;                        &lt;tns1:FlagEquivalenzaProdotti>&#xa;                            &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/FLAGEQUIVALENZAPRODOTTI&quot;/>&#xa;                        &lt;/tns1:FlagEquivalenzaProdotti>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:LavorazioneRichiesta>&#xa;        &lt;/tns1:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
