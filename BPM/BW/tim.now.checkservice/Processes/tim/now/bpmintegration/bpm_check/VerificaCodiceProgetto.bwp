            <bpws:reply name="Reply" operation="VerificaCodiceProgetto"
                partnerLink="BPM_CheckPortType"
                portType="ns1:BPM_CheckPortType"
                tibex:xpdlId="ac07df61-d0f7-405c-86b2-afa285a6fc2c" variable="Reply-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" version="2.0"&gt;
    &lt;xsl:param name="VerificaCodiceProgettoResponse"/&gt;
    &lt;xsl:param name="VerificaCodiceProgettoIn"/&gt;
    &lt;xsl:param name="SelectProgetto"/&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
        &lt;tns3:VerificaCodiceProgettoResponse&gt;
            &lt;parameters&gt;
                &lt;tns3:VerificaCodiceProgettoResponse&gt;
                    &lt;xsl:copy-of select="$VerificaCodiceProgettoResponse/tns2:Esito"/&gt;
                    &lt;xsl:copy-of select="$VerificaCodiceProgettoResponse/tns2:DatiAccesso"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($SelectProgetto) and $SelectProgetto/Record[1]/ONESTEP = 'SI' and string-length($SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO)&gt;0 and (starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'SLU') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'BITSTREAM') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'UBB') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'EASYIP') or starts-with($VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta, 'SEMI') or $VerificaCodiceProgettoIn/parameters/tns3:VerificaCodiceProgetto/tns2:Offerta = 'VULAFTTH')"&gt;
                            &lt;xsl:if test="$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO"&gt;
                                &lt;tns2:ProprietaMateriale&gt;
                                    &lt;xsl:value-of select="$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO"/&gt;
                                &lt;/tns2:ProprietaMateriale&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns3:VerificaCodiceProgettoResponse&gt;
            &lt;/parameters&gt;
        &lt;/tns3:VerificaCodiceProgettoResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaCodiceProgettoResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectProgetto&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:VerificaCodiceProgettoResponse>&#xa;            &lt;xsl:copy-of select=&quot;$VerificaCodiceProgettoResponse/tns2:Esito&quot;/>&#xa;            &lt;xsl:copy-of select=&quot;$VerificaCodiceProgettoResponse/tns2:DatiAccesso&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($SelectProgetto) and $SelectProgetto/Record[1]/ONESTEP = 'SI' and string-length($SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO)>0 and (starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'ULL') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SLU') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'BITSTREAM') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'UBB') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'EASYIP') or starts-with($VerificaCodiceProgettoIn.parameters/tns2:Offerta, 'SEMI') or $VerificaCodiceProgettoIn.parameters/tns2:Offerta = 'VULAFTTH')&quot;>&#xa;                    &lt;xsl:if test=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;>&#xa;                        &lt;tns2:ProprietaMateriale>&#xa;                            &lt;xsl:value-of select=&quot;$SelectProgetto/Record[1]/PROPRIETAMATERIALEOAO&quot;/>&#xa;                        &lt;/tns2:ProprietaMateriale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:VerificaCodiceProgettoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
