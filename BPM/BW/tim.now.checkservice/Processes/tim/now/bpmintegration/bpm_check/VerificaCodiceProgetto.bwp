                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToSelectProgetto">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBC_AnagraficaProgettoVULL">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;VULL&quot;) and ($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Lavorazione = &quot;MIGRAZIONE&quot; or $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Lavorazione = &quot;ATTIVAZIONE&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "VULL") and ($VerificaCodiceProgettoIn.parameters/ns2:Lavorazione = "MIGRAZIONE" or $VerificaCodiceProgettoIn.parameters/ns2:Lavorazione = "ATTIVAZIONE")]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="EmptyToCallEsitiMultipli">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Lavorazione ='ATTIVAZIONE' and ( starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;BITSTREAMGBE&quot;) or  starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;EASYIP&quot;) or starts-with($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta, &quot;BITSTREAMATM&quot;)) and string-length($VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Codice_Progetto) =0 and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta != &quot;EASYIPNGAFTTCAB&quot; and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta != &quot;EASYIPNGAFTTH&quot; and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Offerta != &quot;SEMIEASYIPNGAFTTH&quot; and $VerificaCodiceProgettoIn/parameters/ns1:VerificaCodiceProgetto/ns2:Flag_Modem ='Y'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VerificaCodiceProgettoIn.parameters/ns2:Lavorazione ='ATTIVAZIONE' and ( starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "BITSTREAMGBE") or  starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "EASYIP") or starts-with($VerificaCodiceProgettoIn.parameters/ns2:Offerta, "BITSTREAMATM")) and string-length($VerificaCodiceProgettoIn.parameters/ns2:Codice_Progetto) =0 and $VerificaCodiceProgettoIn.parameters/ns2:Offerta != "EASYIPNGAFTTCAB" and $VerificaCodiceProgettoIn.parameters/ns2:Offerta != "EASYIPNGAFTTH" and $VerificaCodiceProgettoIn.parameters/ns2:Offerta != "SEMIEASYIPNGAFTTH" and $VerificaCodiceProgettoIn.parameters/ns2:Flag_Modem ='Y']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
