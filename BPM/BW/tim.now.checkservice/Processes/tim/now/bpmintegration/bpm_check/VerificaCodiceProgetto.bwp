&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" version="2.0"&gt;
    &lt;xsl:template name="Reply-input" match="/"&gt;
