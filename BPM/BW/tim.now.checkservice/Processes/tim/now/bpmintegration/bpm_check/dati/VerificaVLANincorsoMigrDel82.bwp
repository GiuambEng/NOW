                                    name="Richiesta"
                                    outputVariable="Richiesta"
                                    tibex:xpdlId="2793d0a2-edcc-4a2f-83ff-fafac546f3c6" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCQuery"/>
                                    </bpws:targets>
