                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2793d0a2-edcc-4a2f-83ff-fafac546f3c6+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Richiesta-input&quot; match=&quot;/&quot;>&lt;tns1:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA' or $Start/tns:Offerta='VULAFTTH' or $Start/tns:Offerta='SEMIVULAFTTH' or $Start/tns:Offerta='FULLGPONPLUS'&quot;>&lt;NOMECOMPONENTE>&lt;xsl:value-of select=&quot;'RACCOLTAVLANNGA'&quot;/>&lt;/NOMECOMPONENTE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NOMECOMPONENTE>&lt;xsl:value-of select=&quot;'RACCOLTAVLANVULA'&quot;/>&lt;/NOMECOMPONENTE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;VALOREATTRIBUTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:CVLAN[$index]/tns:CodiceVlan)&quot;>&lt;xsl:value-of select=&quot;$Start/tns:CVLAN[$index]/tns:CodiceVlan&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/VALOREATTRIBUTO>&lt;/tns1:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT(BR.IDRICHIESTAOLO),BA.VALOREATTRIBUTO,BR.STATORICHIESTANOW&#xa;FROM &#xa;BDS_1_CASEDATA_ATTRIBTDTTGLRDN BA,BDS_1_CASEDATA_DETTAGLIOORDINE CD,BDS_1_CASEDATA_RICHIESTA BR&#xa;WHERE&#xa;BA.IDRICHIESTAOLO=CD.IDRICHIESTAOLO AND CD.IDRICHIESTAOLO=BR.IDRICHIESTAOLO&#xa;AND&#xa;CD.NOMECOMPONENTE= ? AND BA.NOMEATTRIBUTO='IDRISORSA' AND BR.LAVORAZIONE IN ('CESSAZIONE','VARIAZIONE')&#xa;AND BR.STATORICHIESTANOW NOT IN ('SCARTATO','ANNULLATO','CHIUSO','ESPLETAMENTOTECNICOKO','ESPLETAMENTOTECNICO','INVIATOAFATTURAZIONE','FATTURAZIONEKO')&#xa;AND BA.VALOREATTRIBUTO=?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOMECOMPONENTE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VALOREATTRIBUTO"/>
                                    <columnMetadata
                                    columnIndex="1"
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="2"
                                    columnName="VALOREATTRIBUTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnIndex="3"
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="LogRichiesta-input"
                                    name="LogRichiesta"
                                    tibex:xpdlId="38422ee3-2fe0-47fd-beb1-874b26e692f0"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToLogBANDA_PICCO"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogRichiestaToAssign1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Logger_Name&quot;/>&lt;xsl:param name=&quot;Logger_Level&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;LogRichiesta-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;'VerificaVLANincorsoMigrDel82'&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;'VerificaVLANincorsoMigrDel82'&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;'VerificaVLANincorsoMigrDel82'&quot;/>&lt;/tns2:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Richiesta/Record)>0&quot;>&lt;tns2:Message>&lt;xsl:value-of select=&quot;concat('Record trovati su Richiesta:',tib:render-xml($Richiesta, true(),true()))&quot;/>&lt;/tns2:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Message>&lt;xsl:value-of select=&quot;'Record non trovati su Richiesta'&quot;/>&lt;/tns2:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$Logger_Name&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$Logger_Level&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="Esiti" name="Assign1"
                                    outputVariable="Esiti"
                                    tibex:xpdlId="fb77ea61-893d-4c61-b7e0-05ea21862c14" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogRichiestaToAssign1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="Assign1ToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.example.org/ServiziOpzionaliMigr&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esiti&quot;/>&lt;xsl:param name=&quot;Richiesta&quot;/>&lt;xsl:template name=&quot;Esiti&quot; match=&quot;/&quot;>&lt;tns3:Esito>&lt;xsl:copy-of select=&quot;$Esiti/tns3:Esito&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Richiesta/Record)=0&quot;>&lt;tns3:Esito>&lt;tns3:Esito>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns3:Esito>&lt;/tns3:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns3:Esito>&lt;tns3:Esito>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns3:Esito>&lt;/tns3:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns3:Esito>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Esiti" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerificaVLANincorsoMigrDel821"
                    name="Assign"
                    outputVariable="VerificaVLANincorsoMigrDel821"
                    tibex:xpdlId="ccbcd3b5-72b4-4f5b-ad2f-b0520b590438" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns3=&quot;http://www.example.org/ServiziOpzionaliMigr&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Esiti&quot;/>&lt;xsl:template name=&quot;VerificaVLANincorsoMigrDel821&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($Esiti/tns3:Esito[tns3:Esito='KO'])>0&quot;>&lt;tns:VerificaVLANincorsoMigrDel82_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVLANincorsoMigrDel82_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaVLANincorsoMigrDel82_Response>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVLANincorsoMigrDel82_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VerificaVLANincorsoMigrDel821" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
