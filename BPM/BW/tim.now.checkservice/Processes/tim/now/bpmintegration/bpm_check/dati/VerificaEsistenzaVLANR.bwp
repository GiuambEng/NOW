            <bpws:reply name="KOStep3Singoltag"
                operation="VerificaEsistenzaVLANR"
                partnerLink="BPM_CheckDatiPortType"
                portType="ns1:BPM_CheckDatiPortType"
                tibex:xpdlId="67df3098-7464-4264-803c-c3ef74a6be66" variable="KOStep3Singoltag-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:tns5="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" version="2.0"&gt;
    &lt;xsl:param name="MapperStep2"/&gt;
    &lt;xsl:param name="FlagEnrichment"/&gt;
    &lt;xsl:param name="VerificaEsistenzaVLANR"/&gt;
    &lt;xsl:template name="KOStep3Singoltag-input" match="/"&gt;
        &lt;tns6:VerificaEsistenzaVLANResponse&gt;
            &lt;output&gt;
                &lt;tns1:VerificaEsistenzaVLANResponse&gt;
                    &lt;xsl:copy-of select="$MapperStep2/tns1:VLAN"/&gt;
                    &lt;tns1:Codice&gt;
                        &lt;xsl:value-of select="$MapperStep2/tns1:Codice"/&gt;
                    &lt;/tns1:Codice&gt;
                    &lt;tns1:Descrizione&gt;
                        &lt;xsl:value-of select="$MapperStep2/tns1:Descrizione"/&gt;
                    &lt;/tns1:Descrizione&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$FlagEnrichment=true()"&gt;
                            &lt;xsl:for-each select="$MapperStep2/tns1:VLAN"&gt;
                                &lt;xsl:variable name="IDDettaglioOrdine" select="tns1:IDDettaglioOrdine"/&gt;
                                &lt;tns1:UservlanVC&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="tns1:TIPO_COS = &amp;quot;BMD&amp;quot;"&gt;
                                            &lt;tns5:BMD&gt;
                                                &lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;
                                            &lt;/tns5:BMD&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns5:BMD&gt;
                                                &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                            &lt;/tns5:BMD&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;xsl:if test="string-length(tns1:CLLI) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:CLLI"&gt;
                                            &lt;tns5:CLLI&gt;
                                                &lt;xsl:value-of select="tns1:CLLI"/&gt;
                                            &lt;/tns5:CLLI&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns1:CODICE_KIT) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:CODICE_KIT"&gt;
                                            &lt;tns5:CodiceKIT&gt;
                                                &lt;xsl:value-of select="tns1:CODICE_KIT"/&gt;
                                            &lt;/tns5:CodiceKIT&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns1:DSLAM_TYPE) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:DSLAM_TYPE"&gt;
                                            &lt;tns5:DSLAMType&gt;
                                                &lt;xsl:value-of select="tns1:DSLAM_TYPE"/&gt;
                                            &lt;/tns5:DSLAMType&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns1:FLAG_ENCAPSULATION) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:FLAG_ENCAPSULATION"&gt;
                                            &lt;tns5:FlagEncapsulation&gt;
                                                &lt;xsl:value-of select="tns1:FLAG_ENCAPSULATION"/&gt;
                                            &lt;/tns5:FlagEncapsulation&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA)"&gt;
                                            &lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode"&gt;
                                                &lt;tns5:SVLANCODE&gt;
                                                    &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode"/&gt;
                                                &lt;/tns5:SVLANCODE&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE)"&gt;
                                            &lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode"&gt;
                                                &lt;tns5:SVLANCODE&gt;
                                                    &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode"/&gt;
                                                &lt;/tns5:SVLANCODE&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns5:SVLANCODE&gt;
                                                &lt;xsl:value-of select="&amp;quot;&amp;quot;"/&gt;
                                            &lt;/tns5:SVLANCODE&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;xsl:if test="string-length(tns1:TIPO_BANDA) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:TIPO_BANDA"&gt;
                                            &lt;tns5:TipoBanda&gt;
                                                &lt;xsl:value-of select="tns1:TIPO_BANDA"/&gt;
                                            &lt;/tns5:TipoBanda&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns1:TIPO_COS) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:TIPO_COS"&gt;
                                            &lt;tns5:TipoCos&gt;
                                                &lt;xsl:value-of select="tns1:TIPO_COS"/&gt;
                                            &lt;/tns5:TipoCos&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns1:TIPOLOGIA) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:TIPOLOGIA"&gt;
                                            &lt;tns5:Tipologia&gt;
                                                &lt;xsl:value-of select="tns1:TIPOLOGIA"/&gt;
                                            &lt;/tns5:Tipologia&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns1:TIPO_TRASPORTO) &gt; 0"&gt;
                                        &lt;xsl:if test="tns1:TIPO_TRASPORTO"&gt;
                                            &lt;tns5:TipoTrasporto&gt;
                                                &lt;xsl:value-of select="tns1:TIPO_TRASPORTO"/&gt;
                                            &lt;/tns5:TipoTrasporto&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan) and exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan/tns1:CodiciVLAN)"&gt;
                                            &lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN"&gt;
                                                &lt;tns5:CVLANID&gt;
                                                    &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN"/&gt;
                                                &lt;/tns5:CVLANID&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC) and exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC/tns1:CodiciVLAN)"&gt;
                                            &lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID"&gt;
                                                &lt;tns5:CVLANID&gt;
                                                    &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID"/&gt;
                                                &lt;/tns5:CVLANID&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns5:CVLANID&gt;
                                                &lt;xsl:value-of select="&amp;quot;&amp;quot;"/&gt;
                                            &lt;/tns5:CVLANID&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                &lt;/tns1:UservlanVC&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns1:VerificaEsistenzaVLANResponse&gt;
            &lt;/output&gt;
        &lt;/tns6:VerificaEsistenzaVLANResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR.input&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperStep2&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:template name=&quot;KOStep3Singoltag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaEsistenzaVLANResponse>&#xa;            &lt;xsl:copy-of select=&quot;$MapperStep2/tns1:VLAN&quot;/>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;$MapperStep2/tns1:Codice&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;tns1:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;$MapperStep2/tns1:Descrizione&quot;/>&#xa;            &lt;/tns1:Descrizione>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$MapperStep2/tns1:VLAN&quot;>&#xa;                        &lt;xsl:variable name=&quot;IDDettaglioOrdine&quot; select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                        &lt;tns1:UservlanVC>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;tns1:TIPO_COS = &amp;quot;BMD&amp;quot;&quot;>&#xa;                                    &lt;tns5:BMD>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                    &lt;/tns5:BMD>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:BMD>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                    &lt;/tns5:BMD>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:CLLI) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                                    &lt;tns5:CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                                    &lt;/tns5:CLLI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:CODICE_KIT) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:CODICE_KIT&quot;>&#xa;                                    &lt;tns5:CodiceKIT>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:CODICE_KIT&quot;/>&#xa;                                    &lt;/tns5:CodiceKIT>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:DSLAM_TYPE) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:DSLAM_TYPE&quot;>&#xa;                                    &lt;tns5:DSLAMType>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:DSLAM_TYPE&quot;/>&#xa;                                    &lt;/tns5:DSLAMType>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:FLAG_ENCAPSULATION) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:FLAG_ENCAPSULATION&quot;>&#xa;                                    &lt;tns5:FlagEncapsulation>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:FLAG_ENCAPSULATION&quot;/>&#xa;                                    &lt;/tns5:FlagEncapsulation>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode&quot;>&#xa;                                        &lt;tns5:SVLANCODE>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                                        &lt;/tns5:SVLANCODE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:GBE)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode&quot;>&#xa;                                        &lt;tns5:SVLANCODE>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                                        &lt;/tns5:SVLANCODE>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:SVLANCODE>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/tns5:SVLANCODE>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:TIPO_BANDA) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&#xa;                                    &lt;tns5:TipoBanda>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&#xa;                                    &lt;/tns5:TipoBanda>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:TIPO_COS) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:TIPO_COS&quot;>&#xa;                                    &lt;tns5:TipoCos>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:TIPO_COS&quot;/>&#xa;                                    &lt;/tns5:TipoCos>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:TIPOLOGIA) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:TIPOLOGIA&quot;>&#xa;                                    &lt;tns5:Tipologia>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:TIPOLOGIA&quot;/>&#xa;                                    &lt;/tns5:Tipologia>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns1:TIPO_TRASPORTO) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns1:TIPO_TRASPORTO&quot;>&#xa;                                    &lt;tns5:TipoTrasporto>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:TIPO_TRASPORTO&quot;/>&#xa;                                    &lt;/tns5:TipoTrasporto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan) and exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan/tns1:CodiciVLAN)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN&quot;>&#xa;                                        &lt;tns5:CVLANID>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN&quot;/>&#xa;                                        &lt;/tns5:CVLANID>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC) and exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC/tns1:CodiciVLAN)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;>&#xa;                                        &lt;tns5:CVLANID>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&#xa;                                        &lt;/tns5:CVLANID>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns5:CVLANID>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                                    &lt;/tns5:CVLANID>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:UservlanVC>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:VerificaEsistenzaVLANResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Empty7ToKOStep3Singoltag_FlagGuiTrue"/>
                    <bpws:target linkName="Assign7ToKOStep3Singoltag"/>
