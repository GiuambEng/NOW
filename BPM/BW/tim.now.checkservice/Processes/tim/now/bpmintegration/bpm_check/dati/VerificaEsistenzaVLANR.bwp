                tibex:xpdlId="2c1c426e-08ac-43b4-89bc-0788b4c8fb5d" variable="KOTipolNonCong-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" version="2.0"&gt;
    &lt;xsl:template name="KOTipolNonCong-input" match="/"&gt;
        &lt;tns6:VerificaEsistenzaVLANResponse&gt;
            &lt;output&gt;
                &lt;tns1:VerificaEsistenzaVLANResponse&gt;
                    &lt;tns1:Codice&gt;
                        &lt;xsl:value-of select="false()"/&gt;
                    &lt;/tns1:Codice&gt;
                    &lt;tns1:Descrizione&gt;
                        &lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;
                    &lt;/tns1:Descrizione&gt;
                &lt;/tns1:VerificaEsistenzaVLANResponse&gt;
            &lt;/output&gt;
        &lt;/tns6:VerificaEsistenzaVLANResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;KOTipolNonCong-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaEsistenzaVLANResponse>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;tns1:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns1:Descrizione>&#xa;        &lt;/tns1:VerificaEsistenzaVLANResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
