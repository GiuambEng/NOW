psulation&gt;&lt;xsl:value-of select="tns1:FLAG_ENCAPSULATION"/&gt;&lt;/tns5:FlagEncapsulation&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:TIPO_BANDA) &gt; 0"&gt;&lt;xsl:if test="tns1:TIPO_BANDA"&gt;&lt;tns5:TipoBanda&gt;&lt;xsl:value-of select="tns1:TIPO_BANDA"/&gt;&lt;/tns5:TipoBanda&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:TIPO_COS) &gt; 0"&gt;&lt;xsl:if test="tns1:TIPO_COS"&gt;&lt;tns5:TipoCos&gt;&lt;xsl:value-of select="tns1:TIPO_COS"/&gt;&lt;/tns5:TipoCos&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:TIPOLOGIA) &gt; 0"&gt;&lt;xsl:if test="tns1:TIPOLOGIA"&gt;&lt;tns5:Tipologia&gt;&lt;xsl:value-of select="tns1:TIPOLOGIA"/&gt;&lt;/tns5:Tipologia&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:TIPO_TRASPORTO) &gt; 0"&gt;&lt;xsl:if test="tns1:TIPO_TRASPORTO"&gt;&lt;tns5:TipoTrasporto&gt;&lt;xsl:value-of select="tns1:TIPO_TRASPORTO"/&gt;&lt;/tns5:TipoTrasporto&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan) and exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan/tns1:CodiciVLAN)"&gt;&lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID"&gt;&lt;tns5:CVLANID&gt;&lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID"/&gt;&lt;/tns5:CVLANID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC) and exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC/tns1:CodiciVLAN)"&gt;&lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID"&gt;&lt;tns5:CVLANID&gt;&lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID"/&gt;&lt;/tns5:CVLANID&gt;&lt;/xsl:if&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns5:CVLANID&gt;&lt;xsl:value-of select="&amp;quot;&amp;quot;"/&gt;&lt;/tns5:CVLANID&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="string-length(tns1:BMC_LIGHT)&gt;0"&gt;&lt;xsl:if test="tns1:BMC_LIGHT"&gt;&lt;tns5:BmcLight&gt;&lt;xsl:value-of select="tns1:BMC_LIGHT"/&gt;&lt;/tns5:BmcLight&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:INTERMEDIATE_AGENT)&gt;0"&gt;&lt;xsl:if test="tns1:INTERMEDIATE_AGENT"&gt;&lt;tns5:IntermediateAgent&gt;&lt;xsl:value-of select="tns1:INTERMEDIATE_AGENT"/&gt;&lt;/tns5:IntermediateAgent&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:TIPOLOGIA_CLUSTER_VLAN)&gt;0"&gt;&lt;xsl:if test="tns1:TIPOLOGIA_CLUSTER_VLAN"&gt;&lt;tns5:TipologiaClusterVlan&gt;&lt;xsl:value-of select="tns1:TIPOLOGIA_CLUSTER_VLAN"/&gt;&lt;/tns5:TipologiaClusterVlan&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:TIPOLOGIA_CLUSTER_VLAN_OLD)&gt;0"&gt;&lt;xsl:if test="tns1:TIPOLOGIA_CLUSTER_VLAN_OLD"&gt;&lt;tns5:TipologiaClusterVlanOld&gt;&lt;xsl:value-of select="tns1:TIPOLOGIA_CLUSTER_VLAN_OLD"/&gt;&lt;/tns5:TipologiaClusterVlanOld&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:FLAG_FTTH_ONLY)&gt;0"&gt;&lt;xsl:if test="tns1:FLAG_FTTH_ONLY"&gt;&lt;tns5:FlagFtthOnly&gt;&lt;xsl:value-of select="tns1:FLAG_FTTH_ONLY"/&gt;&lt;/tns5:FlagFtthOnly&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;xsl:if test="string-length(tns1:CARATTERISTICAVLAN)&gt;0"&gt;&lt;xsl:if test="tns1:CARATTERISTICAVLAN"&gt;&lt;tns5:CaratteristicaVlan&gt;&lt;xsl:value-of select="tns1:CARATTERISTICAVLAN"/&gt;&lt;/tns5:CaratteristicaVlan&gt;&lt;/xsl:if&gt;&lt;/xsl:if&gt;&lt;/tns5:UservlanVC&gt;&lt;/xsl:for-each&gt;&lt;/tns5:DatiVerificaControlliInput&gt;&lt;/parameters&gt;&lt;/tns4:DatiVerificaControlliRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR.input&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperStep2_2&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeDataVerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns5:DatiVerificaControlliInput>&#xa;            &lt;tns5:Operatore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/tns5:Operatore>&#xa;            &lt;tns5:IDRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:IDRichiestaOLO&quot;/>&#xa;            &lt;/tns5:IDRichiestaOLO>&#xa;            &lt;tns5:Azione>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;            &lt;/tns5:Azione>&#xa;            &lt;xsl:for-each select=&quot;$MapperStep2_2/tns1:VLAN&quot;>&#xa;                &lt;xsl:variable name=&quot;IDDettaglioOrdine&quot; select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                &lt;tns5:UservlanVC>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:BMD) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:BMD&quot;>&#xa;                            &lt;tns5:BMD>&#xa;                                &lt;xsl:value-of select=&quot;tns1:BMD&quot;/>&#xa;                            &lt;/tns5:BMD>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:CLLI) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                            &lt;tns5:CLLI>&#xa;                                &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                            &lt;/tns5:CLLI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:CODICE_KIT) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:CODICE_KIT&quot;>&#xa;                            &lt;tns5:CodiceKIT>&#xa;                                &lt;xsl:value-of select=&quot;tns1:CODICE_KIT&quot;/>&#xa;                            &lt;/tns5:CodiceKIT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:DSLAM_TYPE) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:DSLAM_TYPE&quot;>&#xa;                            &lt;tns5:DSLAMType>&#xa;                                &lt;xsl:value-of select=&quot;tns1:DSLAM_TYPE&quot;/>&#xa;                            &lt;/tns5:DSLAMType>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:FLAG_ENCAPSULATION) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:FLAG_ENCAPSULATION&quot;>&#xa;                            &lt;tns5:FlagEncapsulation>&#xa;                                &lt;xsl:value-of select=&quot;tns1:FLAG_ENCAPSULATION&quot;/>&#xa;                            &lt;/tns5:FlagEncapsulation>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPO_BANDA) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&#xa;                            &lt;tns5:TipoBanda>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&#xa;                            &lt;/tns5:TipoBanda>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPO_COS) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPO_COS&quot;>&#xa;                            &lt;tns5:TipoCos>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPO_COS&quot;/>&#xa;                            &lt;/tns5:TipoCos>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPOLOGIA) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPOLOGIA&quot;>&#xa;                            &lt;tns5:Tipologia>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPOLOGIA&quot;/>&#xa;                            &lt;/tns5:Tipologia>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPO_TRASPORTO) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPO_TRASPORTO&quot;>&#xa;                            &lt;tns5:TipoTrasporto>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPO_TRASPORTO&quot;/>&#xa;                            &lt;/tns5:TipoTrasporto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan) and exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan/tns1:CodiciVLAN)&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;>&#xa;                                &lt;tns5:CVLANID>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&#xa;                                &lt;/tns5:CVLANID>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC) and exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC/tns1:CodiciVLAN)&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;>&#xa;                                &lt;tns5:CVLANID>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&#xa;                                &lt;/tns5:CVLANID>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:CVLANID>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;&amp;quot;&quot;/>&#xa;                            &lt;/tns5:CVLANID>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:BMC_LIGHT)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:BMC_LIGHT&quot;>&#xa;                            &lt;tns5:BmcLight>&#xa;                                &lt;xsl:value-of select=&quot;tns1:BMC_LIGHT&quot;/>&#xa;                            &lt;/tns5:BmcLight>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:INTERMEDIATE_AGENT)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:INTERMEDIATE_AGENT&quot;>&#xa;                            &lt;tns5:IntermediateAgent>&#xa;                                &lt;xsl:value-of select=&quot;tns1:INTERMEDIATE_AGENT&quot;/>&#xa;                            &lt;/tns5:IntermediateAgent>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPOLOGIA_CLUSTER_VLAN)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPOLOGIA_CLUSTER_VLAN&quot;>&#xa;                            &lt;tns5:TipologiaClusterVlan>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPOLOGIA_CLUSTER_VLAN&quot;/>&#xa;                            &lt;/tns5:TipologiaClusterVlan>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPOLOGIA_CLUSTER_VLAN_OLD)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPOLOGIA_CLUSTER_VLAN_OLD&quot;>&#xa;                            &lt;tns5:TipologiaClusterVlanOld>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPOLOGIA_CLUSTER_VLAN_OLD&quot;/>&#xa;                            &lt;/tns5:TipologiaClusterVlanOld>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:FLAG_FTTH_ONLY)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:FLAG_FTTH_ONLY&quot;>&#xa;                            &lt;tns5:FlagFtthOnly>&#xa;                                &lt;xsl:value-of select=&quot;tns1:FLAG_FTTH_ONLY&quot;/>&#xa;                            &lt;/tns5:FlagFtthOnly>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:CARATTERISTICAVLAN)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:CARATTERISTICAVLAN&quot;>&#xa;                            &lt;tns5:CaratteristicaVlan>&#xa;                                &lt;xsl:value-of select=&quot;tns1:CARATTERISTICAVLAN&quot;/>&#xa;                            &lt;/tns5:CaratteristicaVlan>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns5:UservlanVC>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns5:DatiVerificaControlliInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
