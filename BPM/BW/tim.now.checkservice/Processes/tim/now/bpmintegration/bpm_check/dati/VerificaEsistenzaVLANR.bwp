                                expression="$Step2/ns3:Descrizione = &quot;Esiste almeno un CODICE_KIT valorizzato e gli UserVlan sono DoubleTag&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
