            <bpws:invoke
                inputVariable="InvokeNOWtoCRMWS_CheckRaccoltaVLAN-input"
                name="InvokeNOWtoCRMWS_CheckRaccoltaVLAN"
                operation="NOWtoCRMWS_CheckRaccoltaVLAN"
                outputVariable="InvokeNOWtoCRMWS_CheckRaccoltaVLAN"
                partnerLink="NOWtoCRMWS_CheckRaccoltaVLAN"
                portType="ns6:NOWtoCRMWS_CheckRaccoltaVLAN" tibex:xpdlId="f7bf2b0e-b627-4358-8169-9df4f752c1aa">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tibco.com/NOWtoCRMWS_CheckRaccoltaVLAN/" xmlns:tns8="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" version="2.0"&gt;
    &lt;xsl:param name="VerificaEsistenzaVLANR"/&gt;
    &lt;xsl:param name="GetCodOlo"/&gt;
    &lt;xsl:template name="InvokeRaccoltaVLANO-input" match="/"&gt;
        &lt;tns7:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
            &lt;parameters&gt;
                &lt;tns8:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
                    &lt;tns8:CODICE_OLO&gt;
                        &lt;xsl:value-of select="$GetCodOlo/Record[1]/COD_OLO"/&gt;
                    &lt;/tns8:CODICE_OLO&gt;
                    &lt;tns8:CODICE_OLOAGCOM&gt;
                        &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:CodiceOLOAGCOM"/&gt;
                    &lt;/tns8:CODICE_OLOAGCOM&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA)"&gt;
                            &lt;xsl:for-each select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan"&gt;
                                &lt;tns8:INFO_VLAN&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:CVLAN_ID) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:CVLAN_ID)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:SVlanCode)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="3791"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodiciVLAN/tns1:SVlanCode"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodeVlanSingleTag"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                        &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                    &lt;/tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                &lt;/tns8:INFO_VLAN&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:for-each select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC"&gt;
                                &lt;tns8:INFO_VLAN&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:CVLAN_ID) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:CVLAN_ID)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:SVlanCode)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="3791"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodiciVLAN/tns1:SVlanCode"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodeVlanSingleTag"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                        &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                    &lt;/tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                &lt;/tns8:INFO_VLAN&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO"&gt;
                        &lt;tns8:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO"/&gt;
                        &lt;/tns8:ID_RICH_OLO&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns8:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns7:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
    &lt;/xsl:template&gt;
