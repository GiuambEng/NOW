                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaEsistenzaVLANROut_5-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2.parameters/tns7:RESPONSE_INFO_VLAN[1]/tns7:CODICE_CAUSALE = &amp;quot;00&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaEsistenzaVLANResponse>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC&quot;>&#xa;                                &lt;xsl:variable name=&quot;IDVLAN_1&quot; select=&quot;tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&#xa;                                &lt;xsl:variable name=&quot;SVlanCod1&quot; select=&quot;tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                                &lt;tns1:VLAN>&#xa;                                    &lt;tns1:IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/tns1:IDDettaglioOrdine>&#xa;                              