    &lt;xsl:param name="VerificaEsistenzaVLANR"/&gt;
    &lt;xsl:param name="InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3"/&gt;
    &lt;xsl:template name="InvokeDatiVerificaControlli_3-input" match="/"&gt;
        &lt;tns4:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns5:DatiVerificaControlliInput&gt;
                    &lt;tns5:Operatore&gt;
                        &lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;
                    &lt;/tns5:Operatore&gt;
                    &lt;tns5:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO"/&gt;
                    &lt;/tns5:IDRichiestaOLO&gt;
                    &lt;tns5:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns5:Azione&gt;
                    &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                        &lt;tns5:UservlanVC&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:TIPO_COS) &gt; 0"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="tns7:INFO_VLAN/tns7:TIPO_COS = &amp;quot;BMD&amp;quot;"&gt;
                                        &lt;tns5:BMD&gt;
                                            &lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;
                                        &lt;/tns5:BMD&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns5:BMD&gt;
                                            &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                        &lt;/tns5:BMD&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:CLLI) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:CLLI"&gt;
                                    &lt;tns5:CLLI&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:CLLI"/&gt;
                                    &lt;/tns5:CLLI&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:TD_KIT) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:TD_KIT"&gt;
                                    &lt;tns5:CodiceKIT&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TD_KIT"/&gt;
                                    &lt;/tns5:CodiceKIT&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:CVLANIDDuplicato&gt;
                                &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                            &lt;/tns5:CVLANIDDuplicato&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:DSLAM_TYPE) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:DSLAM_TYPE"&gt;
                                    &lt;tns5:DSLAMType&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:DSLAM_TYPE"/&gt;
                                    &lt;/tns5:DSLAMType&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:ENCAPSULATION) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:ENCAPSULATION"&gt;
                                    &lt;tns5:FlagEncapsulation&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:ENCAPSULATION"/&gt;
                                    &lt;/tns5:FlagEncapsulation&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:SVLAN_CODE) &gt; 0"&gt;
                                &lt;tns5:SVLANCODE&gt;
                                    &lt;xsl:value-of select="tns7:SVLAN_CODE"/&gt;
                                &lt;/tns5:SVLANCODE&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:TIPOLOGIA) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPOLOGIA"&gt;
                                    &lt;tns5:Tipo&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPOLOGIA"/&gt;
                                    &lt;/tns5:Tipo&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:TIPO_BANDA) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_BANDA"&gt;
                                    &lt;tns5:TipoBanda&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_BANDA"/&gt;
                                    &lt;/tns5:TipoBanda&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:TIPO_COS) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_COS"&gt;
                                    &lt;tns5:TipoCos&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_COS"/&gt;
                                    &lt;/tns5:TipoCos&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:TIPO_TRASPORTO) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"&gt;
                                    &lt;tns5:TipoTrasporto&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"/&gt;
                                    &lt;/tns5:TipoTrasporto&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(string(tns7:CVLAN_ID)) &gt; 0"&gt;
                                &lt;tns5:CVLANID&gt;
                                    &lt;xsl:value-of select="tns7:CVLAN_ID"/&gt;
                                &lt;/tns5:CVLANID&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:INTERMEDIATE_AGENT) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:INTERMEDIATE_AGENT"&gt;
                                    &lt;tns5:IntermediateAgent&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:INTERMEDIATE_AGENT"/&gt;
                                    &lt;/tns5:IntermediateAgent&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns7:INFO_VLAN/tns7:TIPOLOGIA_CLUSTER_VLAN) &gt; 0"&gt;
                                &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPOLOGIA_CLUSTER_VLAN"&gt;
                                    &lt;tns5:TipologiaClusterVlan&gt;
                                        &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPOLOGIA_CLUSTER_VLAN"/&gt;
                                    &lt;/tns5:TipologiaClusterVlan&gt;
                                &lt;/xsl:if&gt;
