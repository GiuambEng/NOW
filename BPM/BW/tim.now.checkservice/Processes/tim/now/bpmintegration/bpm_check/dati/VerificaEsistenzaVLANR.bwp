            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperStep2_2&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR&quot;/>&#xa;    &lt;xsl:template name=&quot;EsitoVLAN&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:VerificaEsistenzaVLANResponse>&#xa;            &lt;tns1:Codice>&#xa;                &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;            &lt;/tns1:Codice>&#xa;            &lt;tns1:Descrizione>&#xa;                &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;            &lt;/tns1:Descrizione>&#xa;            &lt;xsl:for-each select=&quot;$MapperStep2_2/tns1:VLAN&quot;>&#xa;                &lt;xsl:variable name=&quot;IDDettaglioOrdine&quot; select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                &lt;tns1:UservlanVC>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:BMD) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:BMD&quot;>&#xa;                            &lt;tns5:BMD>&#xa;                                &lt;xsl:value-of select=&quot;tns1:BMD&quot;/>&#xa;                            &lt;/tns5:BMD>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:CLLI) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:CLLI&quot;>&#xa;                            &lt;tns5:CLLI>&#xa;                                &lt;xsl:value-of select=&quot;tns1:CLLI&quot;/>&#xa;                            &lt;/tns5:CLLI>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:CODICE_KIT) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:CODICE_KIT&quot;>&#xa;                            &lt;tns5:CodiceKIT>&#xa;                                &lt;xsl:value-of select=&quot;tns1:CODICE_KIT&quot;/>&#xa;                            &lt;/tns5:CodiceKIT>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:DSLAM_TYPE) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:DSLAM_TYPE&quot;>&#xa;                            &lt;tns5:DSLAMType>&#xa;                                &lt;xsl:value-of select=&quot;tns1:DSLAM_TYPE&quot;/>&#xa;                            &lt;/tns5:DSLAMType>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:FLAG_ENCAPSULATION) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:FLAG_ENCAPSULATION&quot;>&#xa;                            &lt;tns5:FlagEncapsulation>&#xa;                                &lt;xsl:value-of select=&quot;tns1:FLAG_ENCAPSULATION&quot;/>&#xa;                            &lt;/tns5:FlagEncapsulation>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPO_BANDA) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPO_BANDA&quot;>&#xa;                            &lt;tns5:TipoBanda>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPO_BANDA&quot;/>&#xa;                            &lt;/tns5:TipoBanda>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPO_COS) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPO_COS&quot;>&#xa;                            &lt;tns5:TipoCos>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPO_COS&quot;/>&#xa;                            &lt;/tns5:TipoCos>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPOLOGIA) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPOLOGIA&quot;>&#xa;                            &lt;tns5:Tipologia>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPOLOGIA&quot;/>&#xa;                            &lt;/tns5:Tipologia>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns1:TIPO_TRASPORTO) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns1:TIPO_TRASPORTO&quot;>&#xa;                            &lt;tns5:TipoTrasporto>&#xa;                                &lt;xsl:value-of select=&quot;tns1:TIPO_TRASPORTO&quot;/>&#xa;                            &lt;/tns5:TipoTrasporto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan) and exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan/tns1:CodiciVLAN)&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;>&#xa;                                &lt;tns5:CVLANID>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&#xa;                                &lt;/tns5:CVLANID>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC) and exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC/tns1:CodiciVLAN)&quot;>&#xa;                            &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;>&#xa;                                &lt;tns5:CVLANID>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[tns1:IDDettaglioOrdine = $IDDettaglioOrdine]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&#xa;                                &lt;/tns5:CVLANID>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns5:CVLANID>&#xa;                                &lt;xsl:value-of select=&quot;''&quot;/>&#xa;                            &lt;/tns5:CVLANID>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:UservlanVC>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns1:VerificaEsistenzaVLANResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
