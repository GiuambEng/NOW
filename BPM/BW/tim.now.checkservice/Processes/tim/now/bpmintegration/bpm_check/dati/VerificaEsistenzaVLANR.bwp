                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToReply1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Step1/ns3:Descrizione =('KO - Esiste almeno una UservVlan in stato INACTIVE su ANAG_VLAN',&quot;KO - Esiste almeno una UservVlan che ha TIPOLG su ANAG_VLAN differente dall'offerta in input&quot;) or ($Step1/ns3:Descrizione ='KO - Occorrenza/e non trovate su ANAG_VLAN ricercando per ID_VLAN_OLO' and (exists($VerificaEsistenzaVLANR/input/ns3:VerificaEsistenzaVLANRequest/ns3:NGA-VULA/ns3:UserVlan/ns3:CodeVlanSingleTag) or exists($VerificaEsistenzaVLANR/input/ns3:VerificaEsistenzaVLANRequest/ns3:GBE/ns3:VC/ns3:CodeVlanSingleTag)))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$Step1/ns3:Descrizione =('KO - Esiste almeno una UservVlan in stato INACTIVE su ANAG_VLAN',"KO - Esiste almeno una UservVlan che ha TIPOLG su ANAG_VLAN differente dall'offerta in input") or ($Step1/ns3:Descrizione ='KO - Occorrenza/e non trovate su ANAG_VLAN ricercando per ID_VLAN_OLO' and (exists($VerificaEsistenzaVLANR.input/ns3:NGA-VULA/ns3:UserVlan/ns3:CodeVlanSingleTag) or exists($VerificaEsistenzaVLANR.input/ns3:GBE/ns3:VC/ns3:CodeVlanSingleTag)))]]></bpws:transitionCondition>
