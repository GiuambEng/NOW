                                                &lt;tns5:FlagEncapsulation&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:ENCAPSULATION"/&gt;
                                                &lt;/tns5:FlagEncapsulation&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;tns5:SVLANCODE&gt;
                                                &lt;xsl:value-of select="tns7:SVLAN_CODE"/&gt;
                                            &lt;/tns5:SVLANCODE&gt;
                                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPOLOGIA"&gt;
                                                &lt;tns5:Tipo&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPOLOGIA"/&gt;
                                                &lt;/tns5:Tipo&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_BANDA"&gt;
                                                &lt;tns5:TipoBanda&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_BANDA"/&gt;
                                                &lt;/tns5:TipoBanda&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_COS"&gt;
                                                &lt;tns5:TipoCos&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_COS"/&gt;
                                                &lt;/tns5:TipoCos&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"&gt;
                                                &lt;tns5:TipoTrasporto&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"/&gt;
                                                &lt;/tns5:TipoTrasporto&gt;
                                            &lt;/xsl:if&gt;
                                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:CUSTOMER"&gt;
                                                &lt;tns5:IdentificativoOperatoreRete&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:CUSTOMER"/&gt;
                                                &lt;/tns5:IdentificativoOperatoreRete&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/tns1:UservlanVC&gt;
                                    &lt;/xsl:for-each&gt;
                                &lt;/xsl:when&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns1:VerificaEsistenzaVLANResponse&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/output&gt;
        &lt;/tns6:VerificaEsistenzaVLANResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
