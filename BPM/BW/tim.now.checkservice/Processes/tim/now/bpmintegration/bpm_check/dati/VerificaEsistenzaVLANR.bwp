lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns7:INFO_VLAN/tns7:TIPO_TRASPORTO) > 0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:TIPO_TRASPORTO&quot;>&#xa;                            &lt;tns5:TipoTrasporto>&#xa;                                &lt;xsl:value-of select=&quot;tns7:INFO_VLAN/tns7:TIPO_TRASPORTO&quot;/>&#xa;                            &lt;/tns5:TipoTrasporto>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(string(tns7:CVLAN_ID)) > 0&quot;>&#xa;                        &lt;tns5:CVLANID>&#xa;                            &lt;xsl:value-of select=&quot;tns7:CVLAN_ID&quot;/>&#xa;                        &lt;/tns5:CVLANID>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns7:INFO_VLAN/tns7:INTERMEDIATE_AGENT)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:INTERMEDIATE_AGENT&quot;>&#xa;                            &lt;tns5:IntermediateAgent>&#xa;                                &lt;xsl:value-of select=&quot;tns7:INFO_VLAN/tns7:INTERMEDIATE_AGENT&quot;/>&#xa;                            &lt;/tns5:IntermediateAgent>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns7:INFO_VLAN/tns7:TIPOLOGIA_CLUSTER_VLAN)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:TIPOLOGIA_CLUSTER_VLAN&quot;>&#xa;                            &lt;tns5:TipologiaClusterVlan>&#xa;                                &lt;xsl:value-of select=&quot;tns7:INFO_VLAN/tns7:TIPOLOGIA_CLUSTER_VLAN&quot;/>&#xa;                            &lt;/tns5:TipologiaClusterVlan>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;string-length(tns7:INFO_VLAN/tns7:TIPOLOGIA_CL