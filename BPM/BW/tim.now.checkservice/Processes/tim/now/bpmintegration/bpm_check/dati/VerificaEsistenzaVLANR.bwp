:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;xsl:value-of select=&quot;'BITSTREAMGBEASIMMETRICOFLAT'&quot;/>&#xa;                    &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode )>0&quot;>&#xa;                    &lt;BCR1.VALOREATTRIBUTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/BCR1.VALOREATTRIBUTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;BCR1.VALOREATTRIBUTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>t