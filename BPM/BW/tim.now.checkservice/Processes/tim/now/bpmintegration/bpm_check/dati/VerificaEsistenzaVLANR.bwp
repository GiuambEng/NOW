lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'BITSTREAMGBES')&quot;>&#xa;                    &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;xsl:value-of select=&quot;'BITSTREAMGBESIMMETRICOFLAT'&quot;/>&#xa;                    &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'BITSTREAMNGA') or starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'SEMIBITSTREAMNGA') or $VerificaEsistenzaVLANR.input/tns1:Offerta='FULLGPONPLUSNGA'&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'SEMIBITSTREAMNGA')&quot;>&#xa;                            &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                                &lt;xsl:value-of select=&quot;'SEMIBITSTREAMNGAFTTH'&quot;/>&#xa;                            &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'BITSTREAMNGAFTTCAB')&quot;>&#xa;                            &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                                &lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTCAB'&quot;/>&#xa;                            &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaEsistenzaVLANR.input/tns1:Offerta='FULLGPONPLUSNGA'&quot;>&#xa;                            &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                                &lt;xsl:value-of select=&quot;'FULLGPONPLUSNGA'&quot;/>&#xa;                            &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                                &lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&#xa;                            &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'EASYIPNGA') or starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'SEMIEASYIPNGA')&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'SEMIEASYIPNGA')&quot;>&#xa;                            &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                                &lt;xsl:value-of select=&quot;'SEMIEASYIPNGAFTTH'&quot;/>&#xa;                            &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta,'EASYIPNGAFTTCAB')&quot;>&#xa;                            &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                                &lt;xsl:value-of select=&quot;'EASYIPNGAFTTCAB'&quot;/>&#xa;                            &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                                &lt;xsl:value-of select=&quot;'EASYIPNGAFTTH'&quot;/>&#xa;                            &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                        &lt;xsl:value-of select=&quot;'BITSTREAMGBEASIMMETRICOFLAT'&quot;/>&#xa;                    &lt;/TRO.NOME_OFFERTA_ESTERNA_2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode )>0&quot;>&#xa;                    &lt;BCR1.VALOREATTRIBUTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/BCR1.VALOREATTRIBUTO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;BCR1.VALOREATTRIBUTO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/BCR1.VALOREATTRIBUTO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns2:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SYSDATE&#xa;  FROM DUAL&#xa;WHERE     ROWNUM &lt;= 1&#xa;       AND (   (SELECT COUNT ( 1 )&#xa;                  FROM APPUSER.BDS_1_CASEDATA_RICHIESTA  BCR,&#xa;                       APPUSER.RICH_OLO_DETT             RO1,&#xa;                       APPUSER.RICH_OLO_DETT             RO2,&#xa;                       APPUSER.TRASCODFC_OFFERTA         TRO,&#xa;                       APPUSER.OFFERTA                   O,&#xa;                       APPUSER.OFFERTA                   O1&#xa;                 WHERE     ROWNUM &lt;= 2&#xa;                       AND RO2.VALORE = ?&#xa;                       AND TRO.NOME_OFFERTA_ESTERNA = ?&#xa;                       AND TRO.ID_OFFERTA = O1.ID_OFFERTA&#xa;                       AND BCR.IDOFFERTA = O.ID_OFFERTA&#xa;                       AND O.ID_FAMIG_OFFERTA = O1.ID_FAMIG_OFFERTA&#xa;                       AND TRO.PROVENIENZA = 'BPM'&#xa;                       AND RO1.PROGRS_TIPOLG_DATO_RICH = RO2.PROGRS_TIPOLG_DATO_RICH&#xa;                         AND RO1.IDTPLG_DATO_RICH = RO2.IDTPLG_DATO_RICH&#xa;                       AND RO1.ID_RICH_OLO = BCR.IDRICHIESTAOLO&#xa;                       AND RO2.ID_RICH_OLO = BCR.IDRICHIESTAOLO&#xa;                       AND RO2.NOME = 'CVLAN_ID'&#xa;                       AND SYSDATE > BCR.DATAINVIORICHIESTA&#xa;                       AND BCR.STATORICHIESTANOW NOT IN ('SCARTATO',&#xa;                                                         'ANNULLATO',&#xa;                                                         'CHIUSO',&#xa;                                                         'ESPLETAMENTOTECNICOKO',&#xa;                                                         'ESPLETAMENTOTECNICO',&#xa;                                                         'INVIATOAFATTURAZIONE',&#xa;                                                         'FATTURAZIONEKO',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'CHIUSOB2B',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'SCARTATOB2B',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'ANNULLATOB2B',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'ESPLETAMENTOTECNICOB2B')&#xa;                       AND RO1.NOME = 'SVLANCODE'&#xa;                       AND RO1.VALORE = ?) > 1&#xa;            OR (EXISTS&#xa;                  (SELECT 1&#xa;                     FROM APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST  BCR,&#xa;                          APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST  BCR1,&#xa;                          APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET   BCD,&#xa;                          APPUSER.BDS_1_CASEDATA_ASSET            RO1,&#xa;                          APPUSER.TRASCODFC_OFFERTA               TRO,&#xa;                          APPUSER.OFFERTA                         O,&#xa;                          APPUSER.OFFERTA                         O1&#xa;                    WHERE     ROWNUM &lt;= 1&#xa;                          AND BCR.VALOREATTRIBUTO = ?&#xa;                          AND RO1.STATOASSET IN ('INLAVORAZIONE', 'ATTIVO')&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  AND BCD.STATODETTAGLIOASSET IN ('INLAVORAZIONE', 'ATTIVO')&#xa;                          AND TRO.NOME_OFFERTA_ESTERNA = ?&#xa;                          AND TRO.ID_OFFERTA = O1.ID_OFFERTA&#xa;                          AND RO1.IDOFFERTA = O.ID_OFFERTA&#xa;                          AND O.ID_FAMIG_OFFERTA = O1.ID_FAMIG_OFFERTA&#xa;                          AND TRO.PROVENIENZA = 'BPM'&#xa;                          AND BCD.ASSET_DETTAGLIOASSET_BDSID = RO1.bds_id   &#xa;                          and BCR.DTTGLSST_TTRBTIDTTGLISST_BDSID = bcd.bds_id&#xa;                          and BCR1.DTTGLSST_TTRBTIDTTGLISST_BDSID = bcd.bds_id&#xa;--                          &#xa;                          AND BCR.NOMEATTRIBUTO = 'CVLANID'&#xa;                          AND BCR1.NOMEATTRIBUTO = 'SVLANCODE'&#xa;                          AND BCR1.VALOREATTRIBUTO = ?)))" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="RO2.VALORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TRO.NOME_OFFERTA_ESTERNA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="RO1.VALORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BCR.VALOREATTRIBUTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TRO.NOME_OFFERTA_ESTERNA_2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BCR1.VALOREATTRIBUTO"/>
                                    <columnMetadata
                                    columnName="SYSDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="EsitoStep3"
                                    name="AssignEsitoStep3_2"
                                    outputVariable="EsitoStep3"
                                    tibex:xpdlId="c3d1193d-d3c8-405c-bd94-c75989b322dc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCExistRecords2ToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignEsitoStep3_2ToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if(exists($JDBCExistRecords2/Record))  then true() else false()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="EsitoStep3" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;VerificaEsistenzaVLANR&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;JDBCExistRecords2&quot;/>&lt;xsl:template name=&quot;LogStep3_2-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&amp;#xD;&amp;#xA;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'BPM_CheckDatiPortType'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'VerificaEsistenzaVLAN'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCExistRecords2/Record)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Step 3 OUT - ciclo numero &amp;quot;,string(number($index)),&amp;quot;: esaminata UserVlan (CVLANID= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID),&amp;quot;,SVlanCode= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode),&amp;quot;) - JDBCExistsRecords result:  &amp;quot;,tib:render-xml($JDBCExistRecords2, true(),  true()))&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Step 3 OUT - ciclo numero &amp;quot;,string(number($index)),&amp;quot;: esaminata VC (CVLANID= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID),&amp;quot;, SVlanCode= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode),&amp;quot;) - JDBCExistsRecords result:  &amp;quot;,tib:render-xml($JDBCExistRecords2, true(),  true()))&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA)&quot;>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Step 3 OUT - ciclo numero &amp;quot;,string(number($index)),&amp;quot;: esaminata UserVlan (CVLANID= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID),&amp;quot;, SVlanCode= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode),&amp;quot;) - JDBCExistsRecords non ha prodotto risultati&amp;quot;)&quot;/>&lt;/tns:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Step 3 OUT - ciclo numero &amp;quot;,string(number($index)),&amp;quot;: esaminata VC (CVLANID= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID),&amp;quot;, SVlanCode= &amp;quot;,string($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode),&amp;quot;) - JDBCExistsRecords non ha prodotto risultati&amp;quot;)&quot;/>&lt;/tns:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogStep3_2-input"
                                    name="LogStep3_2"
                                    tibex:xpdlId="e1dd1703-d963-4a36-b0fd-3525d39a2111"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignEsitoStep3_2ToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="GenericLoggerToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCExistRecords2&quot;/>&#xa;    &lt;xsl:template name=&quot;LogStep3_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&amp;#xD;&amp;#xA;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'BPM_CheckDatiPortType'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'VerificaEsistenzaVLAN'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaEsistenzaVLANR.input/tns1:IDRichiestaOLO&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCExistRecords