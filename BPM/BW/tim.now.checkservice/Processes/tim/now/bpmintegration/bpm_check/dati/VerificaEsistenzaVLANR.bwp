                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:TIPO_TRASPORTO)&gt;0"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"&gt;
                                                        &lt;tns5:TipoTrasporto&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"/&gt;
                                                        &lt;/tns5:TipoTrasporto&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:CUSTOMER"&gt;
                                                &lt;tns5:IdentificativoOperatoreRete&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:CUSTOMER"/&gt;
                                                &lt;/tns5:IdentificativoOperatoreRete&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:for-each&gt;
                                    &lt;/tns1:UservlanVC&gt;
                                &lt;/xsl:when&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns1:VerificaEsistenzaVLANResponse&gt;
                    &lt;/xsl:when&gt;
                    &lt;xsl:otherwise&gt;
                        &lt;tns1:VerificaEsistenzaVLANResponse&gt;
                            &lt;tns1:Codice&gt;
                                &lt;xsl:value-of select="false()"/&gt;
                            &lt;/tns1:Codice&gt;
                            &lt;tns1:Descrizione&gt;
                                &lt;xsl:value-of select="'KO'"/&gt;
                            &lt;/tns1:Descrizione&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="$FlagEnrichment=true()"&gt;
                                    &lt;tns1:UservlanVC&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="tns7:INFO_VLAN/tns7:TIPO_COS =&amp;quot;BMD&amp;quot;"&gt;
                                                    &lt;tns5:BMD&gt;
                                                        &lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;
                                                    &lt;/tns5:BMD&gt;
                                                &lt;/xsl:when&gt;
                                                &lt;xsl:otherwise&gt;
                                                    &lt;tns5:BMD&gt;
                                                        &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                                    &lt;/tns5:BMD&gt;
                                                &lt;/xsl:otherwise&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:CLLI)&gt;0"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:CLLI"&gt;
                                                        &lt;tns5:CLLI&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:CLLI"/&gt;
                                                        &lt;/tns5:CLLI&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:TD_KIT)&gt;0"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:TD_KIT"&gt;
                                                        &lt;tns5:CodiceKIT&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TD_KIT"/&gt;
                                                        &lt;/tns5:CodiceKIT&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;tns5:CVLANIDDuplicato&gt;
                                                &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                            &lt;/tns5:CVLANIDDuplicato&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:DSLAM_TYPE)&gt;0"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:DSLAM_TYPE"&gt;
                                                        &lt;tns5:DSLAMType&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:DSLAM_TYPE"/&gt;
                                                        &lt;/tns5:DSLAMType&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:ENCAPSULATION)&gt;0"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:ENCAPSULATION"&gt;
                                                        &lt;tns5:FlagEncapsulation&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:ENCAPSULATION"/&gt;
                                                        &lt;/tns5:FlagEncapsulation&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:SVLAN_CODE)"&gt;
                                                    &lt;tns5:SVLANCODE&gt;
                                                        &lt;xsl:value-of select="tns7:SVLAN_CODE"/&gt;
                                                    &lt;/tns5:SVLANCODE&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:TIPO_BANDA)"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_BANDA"&gt;
                                                        &lt;tns5:TipoBanda&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_BANDA"/&gt;
                                                        &lt;/tns5:TipoBanda&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:TIPO_COS)&gt;0"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_COS"&gt;
                                                        &lt;tns5:TipoCos&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_COS"/&gt;
                                                        &lt;/tns5:TipoCos&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:choose&gt;
                                                &lt;xsl:when test="string-length(tns7:INFO_VLAN/tns7:TIPO_TRASPORTO)&gt;0"&gt;
                                                    &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"&gt;
                                                        &lt;tns5:TipoTrasporto&gt;
                                                            &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TIPO_TRASPORTO"/&gt;
                                                        &lt;/tns5:TipoTrasporto&gt;
                                                    &lt;/xsl:if&gt;
                                                &lt;/xsl:when&gt;
                                            &lt;/xsl:choose&gt;
                                        &lt;/xsl:for-each&gt;
                                        &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:CUSTOMER"&gt;
                                                &lt;tns5:IdentificativoOperatoreRete&gt;
                                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:CUSTOMER"/&gt;
                                                &lt;/tns5:IdentificativoOperatoreRete&gt;
                                            &lt;/xsl:if&gt;
                                        &lt;/xsl:for-each&gt;
                                    &lt;/tns1:UservlanVC&gt;
                                &lt;/xsl:when&gt;
                            &lt;/xsl:choose&gt;
                        &lt;/tns1:VerificaEsistenzaVLANResponse&gt;
                    &lt;/xsl:otherwise&gt;
                &lt;/xsl:choose&gt;
            &lt;/output&gt;
        &lt;/tns6:VerificaEsistenzaVLANResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaEsistenzaVLANROut_7-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[1]/tns7:CODICE_CAUSALE = &amp;quot;00&amp;quot;&quot;>&#xa;                &lt;tns1:VerificaEsistenzaVLANResponse>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC)&quot;>&#xa;                            &lt;xsl:for-each select=&quot;$VerificaEsistenzaVLANR.input/tns1:GBE/tns1:VC&quot;>&#xa;                                &lt;xsl:variable name=&quot;IDVLAN_1&quot; select=&quot;tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&#xa;                                &lt;xsl:variable name=&quot;SVlanCod1&quot; select=&quot;tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&#xa;                                &lt;tns1:VLAN>&#xa;                                    &lt;tns1:IDDettaglioOrdine>&#xa;                                        &lt;xsl:value-of select=&quot;tns1:IDDettaglioOrdine&quot;/>&#xa;                                    &lt;/tns1:IDDettaglioOrdine>&#xa;                                    &lt;xsl:if test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:TIPO_BANDA&quot;>&#xa;                                        &lt;tns1:TIPO_BANDA>&#xa;                                            &lt;xsl:value-of select=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:TIPO_BANDA&quot;/>&#xa;                                        &lt;/tns1:TIPO_BANDA>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:TIPO_COS&quot;>&#xa;                                        &lt;tns1:TIPO_COS>&#xa;                                            &lt;xsl:value-of select=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:TIPO_COS&quot;/>&#xa;                                        &lt;/tns1:TIPO_COS>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:ENCAPSULATION&quot;>&#xa;                                        &lt;tns1:FLAG_ENCAPSULATION>&#xa;                                            &lt;xsl:value-of select=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:ENCAPSULATION&quot;/>&#xa;                                        &lt;/tns1:FLAG_ENCAPSULATION>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:CLLI&quot;>&#xa;                                        &lt;tns1:CLLI>&#xa;                                            &lt;xsl:value-of select=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:CLLI&quot;/>&#xa;                                        &lt;/tns1:CLLI>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;xsl:if test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:TIPOLOGIA&quot;>&#xa;                                        &lt;tns1:TIPOLOGIA>&#xa;                                            &lt;xsl:value-of select=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:TIPOLOGIA&quot;/>&#xa;                                        &lt;/tns1:TIPOLOGIA>&#xa;                                    &lt;/xsl:if>&#xa;                                    &lt;tns1:CVLAN_ID_DUPLICATO>&#xa;                                        &lt;xsl:value-of select=&quot;'N'&quot;/>&#xa;                                    &lt;/tns1:CVLAN_ID_DUPLICATO>&#xa;                                    &lt;xsl:if test=&quot;$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_3.parameters/tns7:RESPONSE_INFO_VLAN[tns7:CVLAN_ID = xsd:int($IDVLAN_1) and tns7:SVLAN_CODE = $SVlanCod1]/tns7:INFO_VLAN/tns7:TD_KIT&quot;>&#xa;                                        &lt;tns1:CODICE_KIT>&#xa;                                            &lt;xsl:value-of select=&quot;$InvokeNOWtoCRMWS