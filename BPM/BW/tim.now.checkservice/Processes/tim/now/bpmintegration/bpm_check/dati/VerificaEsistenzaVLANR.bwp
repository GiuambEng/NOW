                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT SYSDATE&#xa;  FROM DUAL&#xa;WHERE     ROWNUM &lt;= 1&#xa;       AND (   (SELECT COUNT ( 1 )&#xa;                  FROM APPUSER.BDS_1_CASEDATA_RICHIESTA  BCR,&#xa;                       APPUSER.RICH_OLO_DETT             RO1,&#xa;                       APPUSER.RICH_OLO_DETT             RO2,&#xa;                       APPUSER.TRASCODFC_OFFERTA         TRO,&#xa;                       APPUSER.OFFERTA                   O,&#xa;                       APPUSER.OFFERTA                   O1&#xa;                 WHERE     ROWNUM &lt;= 2&#xa;                       AND RO2.VALORE = ?&#xa;                       AND TRO.NOME_OFFERTA_ESTERNA = ?&#xa;                       AND TRO.ID_OFFERTA = O1.ID_OFFERTA&#xa;                       AND BCR.IDOFFERTA = O.ID_OFFERTA&#xa;                       AND O.ID_FAMIG_OFFERTA = O1.ID_FAMIG_OFFERTA&#xa;                       AND TRO.PROVENIENZA = 'BPM'&#xa;                       AND RO1.PROGRS_TIPOLG_DATO_RICH = RO2.PROGRS_TIPOLG_DATO_RICH&#xa;                         AND RO1.IDTPLG_DATO_RICH = RO2.IDTPLG_DATO_RICH&#xa;                       AND RO1.ID_RICH_OLO = BCR.IDRICHIESTAOLO&#xa;                       AND RO2.ID_RICH_OLO = BCR.IDRICHIESTAOLO&#xa;                       AND RO2.NOME = 'CVLAN_ID'&#xa;                       AND SYSDATE > BCR.DATAINVIORICHIESTA&#xa;                       AND BCR.STATORICHIESTANOW NOT IN ('SCARTATO',&#xa;                                                         'ANNULLATO',&#xa;                                                         'CHIUSO',&#xa;                                                         'ESPLETAMENTOTECNICOKO',&#xa;                                                         'ESPLETAMENTOTECNICO',&#xa;                                                         'INVIATOAFATTURAZIONE',&#xa;                                                         'FATTURAZIONEKO',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'CHIUSOB2B',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'SCARTATOB2B',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'ANNULLATOB2B',&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; 'ESPLETAMENTOTECNICOB2B')&#xa;                       AND RO1.NOME = 'SVLANCODE'&#xa;                       AND RO1.VALORE = ?) > 1&#xa;            OR (EXISTS&#xa;                  (SELECT 1&#xa;                     FROM APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST  BCR,&#xa;                          APPUSER.BDS_1_CASEDATA_ATTRIBTDTTGLSST  BCR1,&#xa;                          APPUSER.BDS_1_CASEDATA_DETTAGLIOASSET   BCD,&#xa;                          APPUSER.BDS_1_CASEDATA_ASSET            RO1,&#xa;                          APPUSER.TRASCODFC_OFFERTA               TRO,&#xa;                          APPUSER.OFFERTA                         O,&#xa;                          APPUSER.OFFERTA                         O1&#xa;                    WHERE     ROWNUM &lt;= 1&#xa;                          AND BCR.VALOREATTRIBUTO = ?&#xa;                          AND RO1.STATOASSET IN ('INLAVORAZIONE', 'ATTIVO')&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  AND BCD.STATODETTAGLIOASSET IN ('INLAVORAZIONE', 'ATTIVO')&#xa;                          AND TRO.NOME_OFFERTA_ESTERNA = ?&#xa;                          AND TRO.ID_OFFERTA = O1.ID_OFFERTA&#xa;                          AND RO1.IDOFFERTA = O.ID_OFFERTA&#xa;                          AND O.ID_FAMIG_OFFERTA = O1.ID_FAMIG_OFFERTA&#xa;                          AND TRO.PROVENIENZA = 'BPM'&#xa;                          AND BCD.ASSET_DETTAGLIOASSET_BDSID = RO1.bds_id   &#xa;                          and BCR.DTTGLSST_TTRBTIDTTGLISST_BDSID = bcd.bds_id&#xa;                          and BCR1.DTTGLSST_TTRBTIDTTGLISST_BDSID = bcd.bds_id&#xa;--                          &#xa;                          AND BCR.NOMEATTRIBUTO = 'CVLANID'&#xa;                          AND BCR1.NOMEATTRIBUTO = 'SVLANCODE'&#xa;                          AND BCR1.VALOREATTRIBUTO = ?&#xa;                          AND RO1.IDASSET &lt;> ?)))&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="RO2.VALORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TRO.NOME_OFFERTA_ESTERNA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="RO1.VALORE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BCR.VALOREATTRIBUTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TRO.NOME_OFFERTA_ESTERNA_2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BCR1.VALOREATTRIBUTO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="IDASSET"/>
                                    <columnMetadata
                                    columnName="SYSDATE"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+cee2c457-7838-4a51-9aeb-58ef05fc727f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;VerificaEsistenzaVLANR&quot;/>&lt;xsl:template name=&quot;JDBCExistRecords2-input&quot; match=&quot;/&quot;>&lt;tns2:jdbcQueryActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID )>0&quot;>&lt;RO2.VALORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/RO2.VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;RO2.VALORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/RO2.VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'VULA') or starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIVULA') or $VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta ='SEMIVULAFTTH'&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'SEMIVULAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta ='VULAFTTH'&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUS'&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'FULLGPONPLUS'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'BITSTREAMGBES')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'BITSTREAMGBESIMMETRICOFLAT'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'BITSTREAMNGA') or starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIBITSTREAMNGA') or $VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUSNGA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIBITSTREAMNGA')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'SEMIBITSTREAMNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'BITSTREAMNGAFTTCAB')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTCAB'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUSNGA'&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'FULLGPONPLUSNGA'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'EASYIPNGA') or starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIEASYIPNGA')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIEASYIPNGA')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'SEMIEASYIPNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'EASYIPNGAFTTCAB')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'EASYIPNGAFTTCAB'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'EASYIPNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'BITSTREAMGBEASIMMETRICOFLAT'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode )>0&quot;>&lt;RO1.VALORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/RO1.VALORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;RO1.VALORE>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/RO1.VALORE>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID )>0&quot;>&lt;BCR.VALOREATTRIBUTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/BCR.VALOREATTRIBUTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;BCR.VALOREATTRIBUTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:CVLAN_ID&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/BCR.VALOREATTRIBUTO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'VULA') or starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIVULA') or $VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUS'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIVULA')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'SEMIVULA'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta ='VULAFTTH'&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUS'&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'FULLGPONPLUS'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'VULAFTTCAB'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'BITSTREAMGBES')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'BITSTREAMGBESIMMETRICOFLAT'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'BITSTREAMNGA') or starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIBITSTREAMNGA') or $VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUSNGA'&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIBITSTREAMNGA')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'SEMIBITSTREAMNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'BITSTREAMNGAFTTCAB')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTCAB'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta='FULLGPONPLUSNGA'&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'FULLGPONPLUSNGA'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'EASYIPNGA') or starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIEASYIPNGA')&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'SEMIEASYIPNGA')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'SEMIEASYIPNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:Offerta,'EASYIPNGAFTTCAB')&quot;>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'EASYIPNGAFTTCAB'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'EASYIPNGAFTTH'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;TRO.NOME_OFFERTA_ESTERNA_2>&lt;xsl:value-of select=&quot;'BITSTREAMGBEASIMMETRICOFLAT'&quot;/>&lt;/TRO.NOME_OFFERTA_ESTERNA_2>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode )>0&quot;>&lt;BCR1.VALOREATTRIBUTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/BCR1.VALOREATTRIBUTO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;BCR1.VALOREATTRIBUTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode)&quot;>&lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan[number($index)]/tns1:CodiciVLAN/tns1:SVlanCode&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/BCR1.VALOR