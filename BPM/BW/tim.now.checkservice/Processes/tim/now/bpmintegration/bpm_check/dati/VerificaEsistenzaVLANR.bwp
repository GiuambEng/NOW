                inputVariable="InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2-input"
                name="InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2"
                operation="NOWtoCRMWS_CheckRaccoltaVLAN"
                outputVariable="InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2"
                partnerLink="NOWtoCRMWS_CheckRaccoltaVLAN"
                portType="ns6:NOWtoCRMWS_CheckRaccoltaVLAN" tibex:xpdlId="1236a239-f0cb-4695-85cf-4153d41db39e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tibco.com/NOWtoCRMWS_CheckRaccoltaVLAN/" xmlns:tns8="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" version="2.0"&gt;
    &lt;xsl:param name="VerificaEsistenzaVLANR"/&gt;
    &lt;xsl:param name="SelctCodOLO"/&gt;
    &lt;xsl:param name="Step2"/&gt;
    &lt;xsl:template name="InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2-input" match="/"&gt;
        &lt;tns7:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
            &lt;parameters&gt;
                &lt;tns8:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
                    &lt;tns8:CODICE_OLO&gt;
                        &lt;xsl:value-of select="$SelctCodOLO/Record[1]/COD_OLO"/&gt;
                    &lt;/tns8:CODICE_OLO&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:CodiceOLOAGCOM=('WIN','INF') and exists($Step2/tns1:CodificaAgcom) and string-length($Step2/tns1:CodificaAgcom)&gt;0"&gt;
                            &lt;tns8:CODICE_OLOAGCOM&gt;
                                &lt;xsl:value-of select="$Step2/tns1:CodificaAgcom"/&gt;
                            &lt;/tns8:CODICE_OLOAGCOM&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns8:CODICE_OLOAGCOM&gt;
                                &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:CodiceOLOAGCOM"/&gt;
                            &lt;/tns8:CODICE_OLOAGCOM&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA)"&gt;
                            &lt;xsl:for-each select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:NGA-VULA/tns1:UserVlan"&gt;
                                &lt;tns8:INFO_VLAN&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:CVLAN_ID) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:CVLAN_ID)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:SVlanCode)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="3791"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodiciVLAN/tns1:SVlanCode"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodeVlanSingleTag"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                        &lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;
                                    &lt;/tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                &lt;/tns8:INFO_VLAN&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:for-each select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:GBE/tns1:VC"&gt;
                                &lt;tns8:INFO_VLAN&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:CVLAN_ID) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:CVLAN_ID)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="xsd:int(tns1:CodiciVLAN/tns1:SVlanCode)"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:CVLAN_ID&gt;
                                                &lt;xsl:value-of select="3791"/&gt;
                                            &lt;/tns8:CVLAN_ID&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;xsl:choose&gt;
                                        &lt;xsl:when test="string-length(tns1:CodiciVLAN/tns1:SVlanCode) &gt; 0"&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodiciVLAN/tns1:SVlanCode"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:when&gt;
                                        &lt;xsl:otherwise&gt;
                                            &lt;tns8:SVLAN_COD&gt;
                                                &lt;xsl:value-of select="tns1:CodeVlanSingleTag"/&gt;
                                            &lt;/tns8:SVLAN_COD&gt;
                                        &lt;/xsl:otherwise&gt;
                                    &lt;/xsl:choose&gt;
                                    &lt;tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                        &lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;
                                    &lt;/tns8:VERIFICA_SUB_CONTRACTOR&gt;
                                &lt;/tns8:INFO_VLAN&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO"&gt;
                        &lt;tns8:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO"/&gt;
                        &lt;/tns8:ID_RICH_OLO&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns8:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
            &lt;/parameters&gt;
        &lt;/tns7:NOWtoCRMWS_CheckRaccoltaVLANRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/NOWtoCRMWS_CheckRaccoltaVLAN/&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR.input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelctCodOLO&quot;/>&#xa;    &lt;xsl:param name=&quot;Step2&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns8:NOWtoCRMWS_CheckRaccoltaVLANRequest>&#xa;            &lt;tns8:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$SelctCodOLO/Record[1]/COD_OLO&quot;/>&#xa;            &lt;/tns8:CODICE_OLO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$VerificaEsistenzaVLANR.input/tns1:CodiceOLOAGCOM=('WIN','INF') and exists($Step2/tns1:CodificaAgcom) and string-length($Step2/tns1:CodificaAgcom)>0&quot;>&#xa;                    &lt;tns8:CODICE_OLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$Step2/tns1:CodificaAgcom&quot;/>&#xa;                    &lt;/tns8:CODICE_OLOAGCOM>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns8:CODICE_OLOAGCOM>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaEsistenzaVLANR.input/tns1:CodiceOLOAGCOM&quot;/>&#xa;                    &lt;/tns8:CODICE_OLOAGCOM>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VerificaEsistenzaVLANR.input/tns1:NGA-VULA)&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$VerificaEsistenzaVLANR.input/tns1:NGA