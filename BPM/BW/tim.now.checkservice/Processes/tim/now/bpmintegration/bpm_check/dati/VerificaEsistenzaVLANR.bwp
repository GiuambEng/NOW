                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fced672a-08dd-45dc-8bd8-ee24724b46a3+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaEsistenzaVLANR.input&quot;/>&#xa;    &lt;xsl:template name=&quot;VerifTipolog7-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta, &amp;quot;VULA&amp;quot;) or starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta, &amp;quot;SEMIVULA&amp;quot;)&quot;>&#xa;                &lt;tns7:ActivityInputType>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT ANAG.COD_VLAN FROM ANAG_VLAN ANAG WHERE ANAG.TIPOLG = 'VULA' AND ANAG.ID_VLAN_OLO IN ('&amp;quot;, tib:concat-sequence-format($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan/tns1:CodiciVLAN/tns1:SVlanCode, &amp;quot;','&amp;quot;, true()), &amp;quot;')&amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/tns7:ActivityInputType>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;starts-with($VerificaEsistenzaVLANR.input/tns1:Offerta, &amp;quot;BITSTREAMGBES&amp;quot;)&quot;>&#xa;                &lt;tns7:ActivityInputType>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT ANAG.COD_VLAN FROM ANAG_VLAN ANAG WHERE ANAG.TIPOLG = 'GBE' AND ANAG.ID_VLAN_OLO IN ('&amp;quot;, tib:concat-sequence-format($VerificaEsistenzaVLANR.input/tns1:NGA-VULA/tns1:UserVlan/tns1:CodiciVLAN/tns1:SVlanCode, &amp;quot;','&amp;quot;, true()), &amp;quot;