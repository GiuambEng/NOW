                    </bpws:source>
                    <bpws:source linkName="EmptyToJDBCQuery_DubleTaNoRecord">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$Step2/ns3:Descrizione =&quot;Non tutti gli UserVlan in input sono stati trovati sulla tabella VLAN OLO e gli UserVlan sono DoubleTag&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
