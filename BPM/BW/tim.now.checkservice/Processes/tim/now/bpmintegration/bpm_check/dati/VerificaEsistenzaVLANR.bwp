            <bpws:invoke
                inputVariable="InvokeDatiVerificaControlli_2-input"
                name="InvokeDatiVerificaControlli_2"
                operation="DatiVerificaControlli"
                outputVariable="InvokeDatiVerificaControlli_2"
                partnerLink="DatiVerificaControlli"
                portType="ns28:DatiVerificaControlliPortType" tibex:xpdlId="142e06d8-520e-47cf-aa92-53d533e299ec">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns5="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:tns7="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/" version="2.0"&gt;
    &lt;xsl:param name="VerificaEsistenzaVLANR"/&gt;
    &lt;xsl:param name="InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2"/&gt;
    &lt;xsl:template name="InvokeDatiVerificaControlli_2-input" match="/"&gt;
        &lt;tns4:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns5:DatiVerificaControlliInput&gt;
                    &lt;tns5:Operatore&gt;
                        &lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;
                    &lt;/tns5:Operatore&gt;
                    &lt;tns5:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$VerificaEsistenzaVLANR/input/tns1:VerificaEsistenzaVLANRequest/tns1:IDRichiestaOLO"/&gt;
                    &lt;/tns5:IDRichiestaOLO&gt;
                    &lt;tns5:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns5:Azione&gt;
                    &lt;xsl:for-each select="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN_2/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN"&gt;
                        &lt;tns5:UservlanVC&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="tns7:INFO_VLAN/tns7:TIPO_COS ='BMD'"&gt;
                                    &lt;tns5:BMD&gt;
                                        &lt;xsl:value-of select="&amp;quot;Y&amp;quot;"/&gt;
                                    &lt;/tns5:BMD&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise&gt;
                                    &lt;tns5:BMD&gt;
                                        &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                                    &lt;/tns5:BMD&gt;
                                &lt;/xsl:otherwise&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:CLLI"&gt;
                                &lt;tns5:CLLI&gt;
                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:CLLI"/&gt;
                                &lt;/tns5:CLLI&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:TD_KIT"&gt;
                                &lt;tns5:CodiceKIT&gt;
                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:TD_KIT"/&gt;
                                &lt;/tns5:CodiceKIT&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:CVLANIDDuplicato&gt;
                                &lt;xsl:value-of select="&amp;quot;N&amp;quot;"/&gt;
                            &lt;/tns5:CVLANIDDuplicato&gt;
                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:DSLAM_TYPE"&gt;
                                &lt;tns5:DSLAMType&gt;
                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:DSLAM_TYPE"/&gt;
                                &lt;/tns5:DSLAMType&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:ENCAPSULATION"&gt;
                                &lt;tns5:FlagEncapsulation&gt;
                                    &lt;xsl:value-of select="tns7:INFO_VLAN/tns7:ENCAPSULATION"/&gt;
                                &lt;/tns5:FlagEncapsulation&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns5:SVLANCODE&gt;
                                &lt;xsl:value-of select="tns7:SVLAN_CODE"/&gt;
                            &lt;/tns5:SVLANCODE&gt;
                            &lt;xsl:if test="tns7:INFO_VLAN/tns7:TIPO_BANDA"&gt;
                                &lt;tns5:TipoBanda&gt;
