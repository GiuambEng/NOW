-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns5:BMD>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:CLLI&quot;>&#xa;                        &lt;tns5:CLLI>&#xa;                            &lt;xsl:value-of select=&quot;tns7:INFO_VLAN/tns7:CLLI&quot;/>&#xa;                        &lt;/tns5:CLLI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:TD_KIT&quot;>&#xa;                        &lt;tns5:CodiceKIT>&#xa;                            &lt;xsl:value-of select=&quot;tns7:INFO_VLAN/tns7:TD_KIT&quot;/>&#xa;                        &lt;/tns5:CodiceKIT>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:CVLANIDDuplicato>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                    &lt;/tns5:CVLANIDDuplicato>&#xa;                    &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:DSLAM_TYPE&quot;>&#xa;                        &lt;tns5:DSLAMType>&#xa;                            &lt;xsl:value-of select=&quot;tns7:INFO_VLAN/tns7:DSLAM_TYPE&quot;/>&#xa;                        &lt;/tns5:DSLAMType>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:ENCAPSULATION&quot;>&#xa;                        &lt;tns5:FlagEncapsulation>&#xa;                            &lt;xsl:value-of select=&quot;tns7:INFO_VLAN/tns7:ENCAPSULATION&quot;/>&#xa;                        &lt;/tns5:FlagEncapsulation>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns5:SVLANCODE>&#xa;                        &lt;xsl:value-of select=&quot;tns7:SVLAN_CODE&quot;/>&#xa;                    &lt;/tns5:SVLANCODE>&#xa;                    &lt;xsl:if test=&quot;tns7:INFO_VLAN/tns7:TIPO_BANDA&quot;>&#xa;                        &lt;tns5:TipoBanda>&#xa;                            &lt;xsl:value-of select