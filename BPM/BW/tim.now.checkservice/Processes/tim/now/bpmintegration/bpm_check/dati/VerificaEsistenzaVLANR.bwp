    &lt;xsl:template name="VerificaEsistenzaVLANROut-input1" match="/"&gt;
        &lt;tns6:VerificaEsistenzaVLANResponse&gt;
            &lt;output&gt;
                &lt;xsl:choose&gt;
                    &lt;xsl:when test="$InvokeNOWtoCRMWS_CheckRaccoltaVLAN/parameters/tns7:NOWtoCRMWS_CheckRaccoltaVLANResponse/tns7:RESPONSE_INFO_VLAN[1]/tns7:CODICE_CAUSALE = &amp;quot;00&amp;quot;"&gt;
                        &lt;tns1:VerificaEsistenzaVLANResponse&gt;
