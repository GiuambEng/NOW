&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVPResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:VerificaVPResponse>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:CODICE_CAUSALE = &amp;quot;04&amp;quot;&quot;>&#xa;                            &lt;tns:VP_Verifica>&#xa;                                &lt;tns:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;0&quot;/>&#xa;                                &lt;/tns:IDDettaglioOrdine>&#xa;                                &lt;tns:ModalitaFatturazione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&#xa;                                &lt;/tns:ModalitaFatturazione>&#xa;                                &lt;tns:Tipo>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&#xa;                                &lt;/tns:Tipo>&#xa;                                &lt;tns:BandaMCR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&#xa;                                &lt;/tns:BandaMCR>&#xa;                                &lt;tns:BandaPCR>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&#xa;                                &lt;/tns:BandaPCR>&#xa;                                &lt;tns:VP_Disponibili>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&#xa;                                &lt;/tns:VP_Disponibili>&#xa;                                &lt;tns:VPCode>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non pre