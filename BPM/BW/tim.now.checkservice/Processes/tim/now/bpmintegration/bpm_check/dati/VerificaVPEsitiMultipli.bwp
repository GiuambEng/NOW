            <bpws:receive createInstance="yes" name="VerificaVP"
                operation="VerificaEsistenzaVPEsistiMultipli"
                partnerLink="BPM_CheckDatiPortType"
                portType="ns1:BPM_CheckDatiPortType"
                tibex:xpdlId="07bdf4f4-f584-4f6f-b503-8811ab0c96e1" variable="VerificaVP">
                <bpws:sources>
                    <bpws:source linkName="VerificaVPToCallProcess"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:receive>
            <bpws:reply name="ReplyVerificaVP"
                operation="VerificaEsistenzaVPEsistiMultipli"
                partnerLink="BPM_CheckDatiPortType"
                portType="ns1:BPM_CheckDatiPortType"
                tibex:xpdlId="7cc1149b-3652-4304-ab26-882f6feab864" variable="ReplyVerificaVP-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/" xmlns:tns="http://www.tim.com/NOW/xsd/ControlliAmmessiDati/" xmlns:tns4="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" version="2.0"&gt;
    &lt;xsl:param name="VP"/&gt;
    &lt;xsl:param name="FlagEnrichment"/&gt;
    &lt;xsl:param name="RecuperaCausaleEsitoMultiplo"/&gt;
    &lt;xsl:param name="InterrogaAnagrafica"/&gt;
    &lt;xsl:template name="ReplyVerificaVP-input" match="/"&gt;
        &lt;tns3:VerificaEsistenzaVPEsistiMultipliResponse&gt;
            &lt;output&gt;
                &lt;tns:VerificaVPResponseEsistiMultipli&gt;
                    &lt;xsl:copy-of select="$VP/tns:VP_Verifica"/&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($VP/tns:CLLI)&gt;0"&gt;
                            &lt;xsl:if test="$VP/tns:CLLI"&gt;
                                &lt;tns:CLLI&gt;
                                    &lt;xsl:value-of select="$VP/tns:CLLI"/&gt;
                                &lt;/tns:CLLI&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;xsl:if test="$VP/tns:CLLI"&gt;
                                &lt;tns:CLLI&gt;
                                    &lt;xsl:value-of select="$VP/tns:CLLI"/&gt;
                                &lt;/tns:CLLI&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($InterrogaAnagrafica/unknownResultset/row/column[name='STATO' and upper-case(string(value))='INACTIVE'])&gt;0"&gt;
                            &lt;tns:Codice&gt;
                                &lt;xsl:value-of select="false()"/&gt;
                            &lt;/tns:Codice&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns:Codice&gt;
                                &lt;xsl:value-of select="$VP/tns:Codice"/&gt;
                            &lt;/tns:Codice&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($InterrogaAnagrafica/unknownResultset/row/column[name='STATO' and upper-case(string(value))='INACTIVE'])&gt;0"&gt;
                            &lt;tns:Descrizione&gt;
                                &lt;xsl:value-of select="'KO'"/&gt;
                            &lt;/tns:Descrizione&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns:Descrizione&gt;
                                &lt;xsl:value-of select="$VP/tns:Descrizione"/&gt;
                            &lt;/tns:Descrizione&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="exists($RecuperaCausaleEsitoMultiplo)"&gt;
                            &lt;xsl:if test="$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale"&gt;
                                &lt;tns:IDCausale&gt;
                                    &lt;xsl:value-of select="$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale"/&gt;
                                &lt;/tns:IDCausale&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="$FlagEnrichment=true()"&gt;
                            &lt;xsl:for-each select="$VP/tns:VP_Verifica"&gt;
                                &lt;tns:UservlanVC&gt;
                                    &lt;xsl:if test="string-length(tns:BandaMCR) &gt; 0"&gt;
                                        &lt;tns4:BandaMCR&gt;
                                            &lt;xsl:value-of select="tns:BandaMCR"/&gt;
                                        &lt;/tns4:BandaMCR&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns:BandaPCR) &gt; 0"&gt;
                                        &lt;tns4:BandaPCR&gt;
                                            &lt;xsl:value-of select="tns:BandaPCR"/&gt;
                                        &lt;/tns4:BandaPCR&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(../tns:CLLI) &gt; 0"&gt;
                                        &lt;xsl:if test="../tns:CLLI"&gt;
                                            &lt;tns4:CLLI&gt;
                                                &lt;xsl:value-of select="../tns:CLLI"/&gt;
                                            &lt;/tns4:CLLI&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns:ModalitaFatturazione) &gt; 0"&gt;
                                        &lt;tns4:ModalitaFatturazione&gt;
                                            &lt;xsl:value-of select="tns:ModalitaFatturazione"/&gt;
                                        &lt;/tns4:ModalitaFatturazione&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns:Tipo) &gt; 0"&gt;
                                        &lt;tns4:Tipo&gt;
                                            &lt;xsl:value-of select="tns:Tipo"/&gt;
                                        &lt;/tns4:Tipo&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns:Tipo_Trasporto) &gt; 0"&gt;
                                        &lt;xsl:if test="tns:Tipo_Trasporto"&gt;
                                            &lt;tns4:TipoTrasporto&gt;
                                                &lt;xsl:value-of select="tns:Tipo_Trasporto"/&gt;
                                            &lt;/tns4:TipoTrasporto&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:if&gt;
                                    &lt;xsl:if test="string-length(tns:VP_Disponibili) &gt; 0"&gt;
                                        &lt;tns4:VCDisponibili&gt;
                                            &lt;xsl:value-of select="tns:VP_Disponibili"/&gt;
                                        &lt;/tns4:VCDisponibili&gt;
                                    &lt;/xsl:if&gt;
                                &lt;/tns:UservlanVC&gt;
                            &lt;/xsl:for-each&gt;
                        &lt;/xsl:when&gt;
                    &lt;/xsl:choose&gt;
                &lt;/tns:VerificaVPResponseEsistiMultipli&gt;
            &lt;/output&gt;
        &lt;/tns3:VerificaEsistenzaVPEsistiMultipliResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckServiceDati/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VP&quot;/>&#xa;    &lt;xsl:param name=&quot;FlagEnrichment&quot;/>&#xa;    &lt;xsl:param name=&quot;RecuperaCausaleEsitoMultiplo&quot;/>&#xa;    &lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyVerificaVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:VerificaVPResponseEsistiMultipli>&#xa;            &lt;xsl:copy-of select=&quot;$VP/tns:VP_Verifica&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VP/tns:CLLI)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$VP/tns:CLLI&quot;>&#xa;                        &lt;tns:CLLI>&#xa;                            &lt;xsl:value-of select=&quot;$VP/tns:CLLI&quot;/>&#xa;                        &lt;/tns:CLLI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:if test=&quot;$VP/tns:CLLI&quot;>&#xa;                        &lt;tns:CLLI>&#xa;                            &lt;xsl:value-of select=&quot;$VP/tns:CLLI&quot;/>&#xa;                        &lt;/tns:CLLI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($InterrogaAnagrafica/unknownResultset/row/column[name='STATO' and upper-case(string(value))='INACTIVE'])>0&quot;>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;$VP/tns:Codice&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($InterrogaAnagrafica/unknownResultset/row/column[name='STATO' and upper-case(string(value))='INACTIVE'])>0&quot;>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;$VP/tns:Descrizione&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($RecuperaCausaleEsitoMultiplo)&quot;>&#xa;                    &lt;xsl:if test=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;>&#xa;                        &lt;tns:IDCausale>&#xa;                            &lt;xsl:value-of select=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;/>&#xa;                        &lt;/tns:IDCausale>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$FlagEnrichment=true()&quot;>&#xa;                    &lt;xsl:for-each select=&quot;$VP/tns:VP_Verifica&quot;>&#xa;                        &lt;tns:UservlanVC>&#xa;                            &lt;xsl:if test=&quot;string-length(tns:BandaMCR) > 0&quot;>&#xa;                                &lt;tns4:BandaMCR>&#xa;                                    &lt;xsl:value-of select=&quot;tns:BandaMCR&quot;/>&#xa;                                &lt;/tns4:BandaMCR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns:BandaPCR) > 0&quot;>&#xa;                                &lt;tns4:BandaPCR>&#xa;                                    &lt;xsl:value-of select=&quot;tns:BandaPCR&quot;/>&#xa;                                &lt;/tns4:BandaPCR>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(../tns:CLLI) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;../tns:CLLI&quot;>&#xa;                                    &lt;tns4:CLLI>&#xa;                                        &lt;xsl:value-of select=&quot;../tns:CLLI&quot;/>&#xa;                                    &lt;/tns4:CLLI>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns:ModalitaFatturazione) > 0&quot;>&#xa;                                &lt;tns4:ModalitaFatturazione>&#xa;                                    &lt;xsl:value-of select=&quot;tns:ModalitaFatturazione&quot;/>&#xa;                                &lt;/tns4:ModalitaFatturazione>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns:Tipo) > 0&quot;>&#xa;                                &lt;tns4:Tipo>&#xa;                                    &lt;xsl:value-of select=&quot;tns:Tipo&quot;/>&#xa;                                &lt;/tns4:Tipo>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns:Tipo_Trasporto) > 0&quot;>&#xa;                                &lt;xsl:if test=&quot;tns:Tipo_Trasporto&quot;>&#xa;                                    &lt;tns4:TipoTrasporto>&#xa;                                        &lt;xsl:value-of select=&quot;tns:Tipo_Trasporto&quot;/>&#xa;                                    &lt;/tns4:TipoTrasporto>&#xa;                                &lt;/xsl:if>&#xa;                            &lt;/xsl:if>&#xa;                            &lt;xsl:if test=&quot;string-length(tns:VP_Disponibili) > 0&quot;>&#xa;                                &lt;tns4:VCDisponibili>&#xa;                                    &lt;xsl:value-of select=&quot;tns:VP_Disponibili&quot;/>&#xa;                                &lt;/tns4:VCDisponibili>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/tns:UservlanVC>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:VerificaVPResponseEsistiMultipli>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="AssignToReplayVerificaVP"/>
                    <bpws:target linkName="EnrichmentTrueToReplayVerificaVP"/>
                    <bpws:target linkName="CallProcessToReplayVerificaVP1"/>
                </bpws:targets>
                <bpws:sources/>
                <bpws:correlations/>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LoginpVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input: &amp;quot;, tib:render-xml($VerificaVP/input/tns:VerificaVPRequestEsitiMultipli, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LoginpVP-input" name="LoginpVP"
                    tibex:xpdlId="d687c441-dd3d-472e-a725-efedcfa71add"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VerificaVPToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LoginpVPToSQLDirect"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LoginpVP-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Input: &amp;quot;, tib:render-xml($VerificaVP.input, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:invoke inputVariable="VerificaVpKit-input"
                name="VerificaVpKit" operation="NOWtoCRMWS_CheckVPKIT"
                outputVariable="VerificaVpKit"
                partnerLink="NOWtoCRMWS_CheckATMVPKIT"
                portType="ns3:NOWtoCRMWS_CheckVPKITPortType" tibex:xpdlId="296a179c-c857-4786-8caf-5cb101c1999f">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/NOWtoCRMWS_CheckVPKIT/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns1="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/" version="2.0"&gt;
    &lt;xsl:param name="VPKitInfo"/&gt;
    &lt;xsl:template name="VerificaVpKit-input" match="/"&gt;
        &lt;tns3:NOWtoCRMWS_CheckVPKITRequest&gt;
            &lt;REQUEST&gt;
                &lt;xsl:for-each select="$VPKitInfo"&gt;
                    &lt;tns1:NOWtoCRMWS_CheckVPKITRequest&gt;
                        &lt;tns1:CODICE_OLO&gt;
                            &lt;xsl:value-of select="tns1:CODICE_OLO"/&gt;
                        &lt;/tns1:CODICE_OLO&gt;
                        &lt;tns1:CODICE_OLO_AGCOM&gt;
                            &lt;xsl:value-of select="tns1:CODICE_OLO_AGCOM"/&gt;
                        &lt;/tns1:CODICE_OLO_AGCOM&gt;
                        &lt;xsl:copy-of select="tns1:INFO_VP_KIT"/&gt;
                        &lt;xsl:if test="tns1:ID_RICH_OLO"&gt;
                            &lt;tns1:ID_RICH_OLO&gt;
                                &lt;xsl:value-of select="tns1:ID_RICH_OLO"/&gt;
                            &lt;/tns1:ID_RICH_OLO&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns1:NOWtoCRMWS_CheckVPKITRequest&gt;
                &lt;/xsl:for-each&gt;
            &lt;/REQUEST&gt;
        &lt;/tns3:NOWtoCRMWS_CheckVPKITRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VPKitInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaVpKit-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:for-each select=&quot;$VPKitInfo&quot;>&#xa;            &lt;tns1:NOWtoCRMWS_CheckVPKITRequest>&#xa;                &lt;tns1:CODICE_OLO>&#xa;                    &lt;xsl:value-of select=&quot;tns1:CODICE_OLO&quot;/>&#xa;                &lt;/tns1:CODICE_OLO>&#xa;                &lt;tns1:CODICE_OLO_AGCOM>&#xa;                    &lt;xsl:value-of select=&quot;tns1:CODICE_OLO_AGCOM&quot;/>&#xa;                &lt;/tns1:CODICE_OLO_AGCOM>&#xa;                &lt;xsl:copy-of select=&quot;tns1:INFO_VP_KIT&quot;/>&#xa;                &lt;xsl:if test=&quot;tns1:ID_RICH_OLO&quot;>&#xa;                    &lt;tns1:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;tns1:ID_RICH_OLO&quot;/>&#xa;                    &lt;/tns1:ID_RICH_OLO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:NOWtoCRMWS_CheckVPKITRequest>&#xa;        &lt;/xsl:for-each>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="GenericLoggerToVerificaVpKit"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="VerificaVpKitToAssign"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVpKit&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaVP&quot;/>&#xa;    &lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&#xa;    &lt;xsl:template name=&quot;VP&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:CODICE_CAUSALE = &amp;quot;00&amp;quot;&quot;>&#xa;                &lt;xsl:variable name=&quot;listaIDRisorsa&quot; select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP/tns:VPCode&quot;/>&#xa;                &lt;tns:VerificaVPResponse>&#xa;                    &lt;xsl:for-each-group select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP&quot; group-by=&quot;tns:VPCode&quot;>&#xa;                        &lt;xsl:variable name=&quot;idRisorsa&quot; select=&quot;current-group()/tns:VPCode&quot;/>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name = &amp;quot;STATO&amp;quot; and value=&amp;quot;Active&amp;quot;])&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP[tns:VPCode=$idRisorsa]&quot;>&#xa;                                    &lt;tns:VP_Verifica>&#xa;                                        &lt;tns:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglioOrdine>&#xa;                                        &lt;tns:ModalitaFatturazione>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='MODALITA_FATTURAZIONE']/value&quot;/>&#xa;                                        &lt;/tns:ModalitaFatturazione>&#xa;                                        &lt;tns:Tipo>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO']/value&quot;/>&#xa;                                        &lt;/tns:Tipo>&#xa;                                        &lt;tns:BandaMCR>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_MCR']/value&quot;/>&#xa;                                        &lt;/tns:BandaMCR>&#xa;                                        &lt;tns:BandaPCR>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_PCR']/value&quot;/>&#xa;                                        &lt;/tns:BandaPCR>&#xa;                                        &lt;tns:VP_Disponibili>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                        &lt;/tns:VP_Disponibili>&#xa;                                        &lt;tns:VPCode>&#xa;                                            &lt;xsl:value-of select=&quot;$idRisorsa[1]&quot;/>&#xa;                                        &lt;/tns:VPCode>&#xa;                                        &lt;tns:Tipo_Trasporto>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case(string($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO_TRASPORTO']/value))&quot;/>&#xa;                                        &lt;/tns:Tipo_Trasporto>&#xa;                                    &lt;/tns:VP_Verifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:for-each select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP[tns:VPCode=$idRisorsa]&quot;>&#xa;                                    &lt;tns:VP_Verifica>&#xa;                                        &lt;tns:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglioOrdine>&#xa;                                        &lt;tns:ModalitaFatturazione>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:MOD_FATT&quot;/>&#xa;                                        &lt;/tns:ModalitaFatturazione>&#xa;                                        &lt;tns:Tipo>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:TIPO&quot;/>&#xa;                                        &lt;/tns:Tipo>&#xa;                                        &lt;tns:BandaMCR>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:BANDA_MCR&quot;/>&#xa;                                        &lt;/tns:BandaMCR>&#xa;                                        &lt;tns:BandaPCR>&#xa;                                            &lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:BANDA_PCR&quot;/>&#xa;                                        &lt;/tns:BandaPCR>&#xa;                                        &lt;tns:VP_Disponibili>&#xa;                                            &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                        &lt;/tns:VP_Disponibili>&#xa;                                        &lt;tns:VPCode>&#xa;                                            &lt;xsl:value-of select=&quot;$idRisorsa[1]&quot;/>&#xa;                                        &lt;/tns:VPCode>&#xa;                                        &lt;tns:Tipo_Trasporto>&#xa;                                            &lt;xsl:value-of select=&quot;upper-case($VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:TIPO_TRASPORTO)&quot;/>&#xa;                                        &lt;/tns:Tipo_Trasporto>&#xa;                                    &lt;/tns:VP_Verifica>&#xa;                                &lt;/xsl:for-each>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/xsl:for-each-group>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&#xa;                            &lt;xsl:if test=&quot;not((string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&#xa;                                &lt;tns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value&quot;/>&#xa;                                &lt;/tns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$listaIDRisorsa][1]/tns1:CLLI&quot;>&#xa;                                &lt;tns:CLLI>&#xa;                                    &lt;xsl:value-of select=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$listaIDRisorsa][1]/tns1:CLLI&quot;/>&#xa;                                &lt;/tns:CLLI>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVPResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:CODICE_CAUSALE = &amp;quot;01&amp;quot;&quot;>&#xa;                &lt;xsl:variable name=&quot;listaidrisorsa01&quot; select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP/tns:VPCode&quot;/>&#xa;                &lt;tns:VerificaVPResponse>&#xa;                    &lt;xsl:for-each-group select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP&quot; group-by=&quot;tns:VPCode&quot;>&#xa;                        &lt;xsl:variable name=&quot;idrisorsa01&quot; select=&quot;current-group()/tns:VPCode&quot;/>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name = &amp;quot;STATO&amp;quot; and upper-case(string(value))=&amp;quot;ACTIVE&amp;quot;])&quot;>&#xa;                                &lt;xsl:for-each select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP[tns:VPCode=$idrisorsa01]&quot;>&#xa;                                    &lt;tns:VP_Verifica>&#xa;                                        &lt;tns:IDDettaglioOrdine>&#xa;                                            &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                        &lt;/tns:IDDettaglioOrdine>&#xa;                                        &lt;tns:ModalitaFatturazione>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='MODALITA_FATTURAZIONE']/value&quot;/>&#xa;                                        &lt;/tns:ModalitaFatturazione>&#xa;                                        &lt;tns:Tipo>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='TIPO']/value&quot;/>&#xa;                                        &lt;/tns:Tipo>&#xa;                                        &lt;tns:BandaMCR>&#xa;                                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='BANDA_MCR']/value&quot;/>&#xa;                                        &lt;/tns:BandaMCR>&#xa;                                        &lt;tns:BandaPCR>&#xa;                                            &lt;xsl:value-of s