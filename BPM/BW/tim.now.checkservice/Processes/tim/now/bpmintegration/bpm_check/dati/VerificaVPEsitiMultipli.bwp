                <bpws:link name="EnrichmentTrueToReplayVerificaVP" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToReplayVerificaVP1" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="RecuperaCausaleEsitoMultiploToThrow" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="LoginpVPToSQLDirect" tibex:linkType="SUCCESS"/>
                <bpws:link name="InterrogaAnagraficaToAssignVPActive" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignVPInactiveToAssignInfoVpKit" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignVPActiveToAssignVPInactive" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignInfoVpKitToVerificaVpKit" tibex:linkType="SUCCESS"/>
