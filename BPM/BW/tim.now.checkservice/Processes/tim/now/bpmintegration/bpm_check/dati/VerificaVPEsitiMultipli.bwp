            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LoggerName" type="xsd:string"/>
        <bpws:variable name="log_level" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Log/LogLevel" type="xsd:string"/>
        <bpws:variable element="tns:VerificaVPResponse" name="VP"/>
        <bpws:variable name="SommaVPActive" type="xsd:integer">
            <bpws:from>
                <bpws:literal>0</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable messageType="ns3:NOWtoCRMWS_CheckVPKITRequest"
            name="VerificaVpKit-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns3:NOWtoCRMWS_CheckVPKITResponse"
            name="VerificaVpKit" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="LogOutputVP-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns8:DatiVerificaControlliRequest"
            name="DatiVerificaControlliInvoke-input" sca-bpel:internal="true"/>
        <bpws:variable messageType="ns8:DatiVerificaControlliResponse"
            name="DatiVerificaControlliInvoke" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="LOG_DatiVerificaControlliInvoke-input" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns0:ErrorReport" name="_error" sca-bpel:internal="true"/>
        <bpws:variable element="ns9:ErrorLinkHandlerFaultData"
            name="_error_DatiVerificaControlliInvoke" sca-bpel:internal="true"/>
        <bpws:variable name="FlagEnrichment" type="xsd:boolean">
            <bpws:from>
                <bpws:literal>false</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable element="ns12:EsitiMultipliRequest"
            name="RecuperaCausaleEsitoMultiplo-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns12:EsitiMultipliResponse"
            name="RecuperaCausaleEsitoMultiplo" sca-bpel:internal="true"/>
        <bpws:variable element="ns13:DefaultFault" name="Throw-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns15:ActivityInputType"
            name="InterrogaAnagrafica-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns16:jdbcGeneralActivityOutput"
            name="InterrogaAnagrafica" sca-bpel:internal="true"/>
        <bpws:variable name="SommaVPInactive" type="xsd:integer">
            <bpws:from>
                <bpws:literal>0</bpws:literal>
            </bpws:from>
        </bpws:variable>
        <bpws:variable name="TimeoutJDBC" sca-bpel:hotUpdate="false"
            sca-bpel:privateProperty="true" sca-bpel:property="yes"
            tibex:propertySource="/Process/TimerJDBC/TimeoutJDBC" type="xsd:int"/>
        <bpws:variable element="ns6:NOWtoCRMWS_CheckVPKITRequest" name="VPKitInfo"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
