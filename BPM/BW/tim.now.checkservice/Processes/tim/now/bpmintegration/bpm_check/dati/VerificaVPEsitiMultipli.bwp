    &lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;
        &lt;tns3:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns4:DatiVerificaControlliInput&gt;
                    &lt;tns4:Operatore&gt;
