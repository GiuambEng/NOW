                                &lt;/tns4:ModalitaFatturazione&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns:Tipo) &gt; 0"&gt;
                                &lt;tns4:Tipo&gt;
                                    &lt;xsl:value-of select="tns:Tipo"/&gt;
                                &lt;/tns4:Tipo&gt;
                            &lt;/xsl:if&gt;
                            &lt;xsl:if test="string-length(tns:Tipo_Trasporto) &gt; 0"&gt;
