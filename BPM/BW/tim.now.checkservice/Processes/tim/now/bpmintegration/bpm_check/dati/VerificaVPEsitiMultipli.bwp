;/>&#xa;                                &lt;/tns:VPCode>&#xa;                                &lt;tns:Tipo_Trasporto>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&#xa;                                &lt;/tns:Tipo_Trasporto>&#xa;                            &lt;/tns:VP_Verifica>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$VerificaVpKit/RESPONSE/tns1:NOWtoCRMWS_CheckVPKITResponse/tns1:CODICE_CAUSALE = &amp;quot;04&amp;quot;&quot;>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Descrizione>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&#xa;                            &lt;/tns:Descrizione>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:VerificaVPResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
