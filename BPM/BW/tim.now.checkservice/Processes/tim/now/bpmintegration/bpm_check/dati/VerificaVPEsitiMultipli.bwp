        <bpws:variable element="ns17:jdbcQueryActivityInput"
            name="Oscuramento-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns18:resultSet" name="Oscuramento" sca-bpel:internal="true"/>
        <bpws:variable element="ns2:CW_BUS_MESSAGE"
            name="Log_Oscuramento-input" sca-bpel:internal="true"/>
