                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaVP&quot;/>&lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&lt;xsl:template name=&quot;VPKitInfo&quot; match=&quot;/&quot;>&lt;tns1:NOWtoCRMWS_CheckVPKITRequest>&lt;tns1:CODICE_OLO>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:CodiceOLO&quot;/>&lt;/tns1:CODICE_OLO>&lt;tns1:CODICE_OLO_AGCOM>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:CodiceOLOAGCOM&quot;/>&lt;/tns1:CODICE_OLO_AGCOM>&lt;xsl:for-each select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP&quot;>&lt;tns1:INFO_VP_KIT>&lt;tns1:IdDetOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns1:IdDetOrdine>&lt;tns1:NUM_VC>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns1:NUM_VC>&lt;tns1:ID_RISORSA>&lt;xsl:value-of select=&quot;tns:VPCode&quot;/>&lt;/tns1:ID_RISORSA>&lt;tns1:TIPO_CONSEGNA>&lt;xsl:value-of select=&quot;&amp;quot;BandaCondivisa&amp;quot;&quot;/>&lt;/tns1:TIPO_CONSEGNA>&lt;xsl:choose>&lt;xsl:when test=&quot;tns:VPCode=$InterrogaAnagrafica/unknownResultset/row[column[name='STATO' and upper-case(string(value))='ACTIVE']]/column[name='COD_VP']/value&quot;>&lt;tns1:FLAG_PRESENZA_NOW>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns1:FLAG_PRESENZA_NOW>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:FLAG_PRESENZA_NOW>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns1:FLAG_PRESENZA_NOW>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns1:INFO_VP_KIT>&lt;/xsl:for-each>&lt;xsl:if test=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;>&lt;tns1:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;/>&lt;/tns1:ID_RICH_OLO>&lt;/xsl:if>&lt;/tns1:NOWtoCRMWS_CheckVPKITRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VPKitInfo" name="AssignInfoVpKit"
                    outputVariable="VPKitInfo"
                    tibex:xpdlId="dbb7e4ed-2723-4641-9aae-67756961c06c" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignVPInactiveToAssignInfoVpKit"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignInfoVpKitToVerificaVpKit">
                            <tibex:DesignExpression/>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&#xa;    &lt;xsl:template name=&quot;VPKitInfo&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NOWtoCRMWS_CheckVPKITRequest>&#xa;            &lt;tns1:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:CodiceOLO&quot;/>&#xa;            &lt;/tns1:CODICE_OLO>&#xa;            &lt;tns1:CODICE_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns1:CODICE_OLO_AGCOM>&#xa;            &lt;xsl:for-each select=&quot;$VerificaVP.input/tns:VC_VerificaVP&quot;>&#xa;                &lt;tns1:INFO_VP_KIT>&#xa;                    &lt;tns1:IdDetOrdine>&#xa;                        &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                    &lt;/tns1:IdDetOrdine>&#xa;                    &lt;tns1:NUM_VC>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns1:NUM_VC>&#xa;                    &lt;tns1:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;tns:VPCode&quot;/>&#xa;                    &lt;/tns1:ID_RISORSA>&#xa;                    &lt;tns1:TIPO_CONSEGNA>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;BandaCondivisa&amp;quot;&quot;/>&#xa;                    &lt;/tns1:TIPO_CONSEGNA>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;tns:VPCode=$InterrogaAnagrafica/unknownResultset/row[column[name='STATO' and upper-case(string(value))='ACTIVE']]/column[name='COD_VP']/value&quot;>&#xa;                            &lt;tns1:FLAG_PRESENZA_NOW>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                            &lt;/tns1:FLAG_PRESENZA_NOW>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:FLAG_PRESENZA_NOW>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns1:FLAG_PRESENZA_NOW>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:INFO_VP_KIT>&#xa;            &lt;/xsl:for-each>&#xa;            &lt;xsl:if test=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;>&#xa;                &lt;tns1:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:ID_RICH_OLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:NOWtoCRMWS_CheckVPKITRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="VPKitInfo" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Record Estratti: &amp;quot;, tib:render-xml($InterrogaAnagrafica, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="CallProcess-input" name="CallProcess"
                    tibex:xpdlId="e784b4a3-ff92-4c9a-94a5-a02353d87697"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InterrogaAnagraficaToAssignVPActive"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToAssignVPActive">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallProcessToRecuperaCausaleEsitoMultiplo">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($InterrogaAnagrafica/unknownResultset/row/column[name='STATO' and upper-case(string(value))='INACTIVE'])>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($InterrogaAnagrafica/unknownResultset/row/column[name='STATO' and upper-case(string(value))='INACTIVE'])>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&#xa;    &lt;xsl:template name=&quot;CallProcess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns2:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Record Estratti: &amp;quot;, tib:render-xml($InterrogaAnagrafica, true(), true()))&quot;/>&#xa;                &lt;/tns2:Message>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="Oscuramento-input" name="Oscuramento"
                    outputVariable="Oscuramento"
                    tibex:xpdlId="4bdb6c3f-9c4b-466b-bf67-a76047c1b080" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignInfoVpKitToVerificaVpKit"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+4bdb6c3f-9c4b-466b-bf67-a76047c1b080+input&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput/>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count (*) as conteggio&#xa;from oscuramento_agesp oa&#xa;where oa.cod_agesp = 'R58-23-2040' and oa.flag_oscurmento in ('1','Y')&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <columnMetadata columnIndex="1"
                                    columnName="CONTEGGIO"
                                    dataType="4"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaVP&quot;/>&lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&lt;xsl:param name=&quot;VPKitInfo&quot;/>&lt;xsl:template name=&quot;VP&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VPKitInfo/tns1:INFO_VP_KIT[tns1:FLAG_PRESENZA_NOW = &amp;quot;N&amp;quot;])&quot;>&lt;tns:VerificaVPResponse>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVPResponse>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:variable name=&quot;listaIDRisorsa&quot; select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP/tns:VPCode&quot;/>&lt;tns:VerificaVPResponse>&lt;xsl:for-each-group select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP&quot; group-by=&quot;tns:VPCode&quot;>&lt;xsl:variable name=&quot;idRisorsa&quot; select=&quot;current-group()/tns:VPCode&quot;/>&lt;xsl:for-each select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:VC_VerificaVP[tns:VPCode=$idRisorsa]&quot;>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='MODALITA_FATTURAZIONE']/value&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO']/value&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_MCR']/value&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_PCR']/value&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$idRisorsa[1]&quot;/>&lt;/tns:VPCode>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;upper-case(string($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO_TRASPORTO']/value))&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/tns:VP_Verifica>&lt;/xsl:for-each>&lt;/xsl:for-each-group>&lt;xsl:if test=&quot;not((string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVPResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VP" name="Assign" outputVariable="VP"
                    tibex:xpdlId="44189eb1-c69c-486e-bab5-bfd620d5e1e1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="GenericLoggerToAssign"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignToLogOutputVP"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&#xa;    &lt;xsl:param name=&quot;VPKitInfo&quot;/>&#xa;    &lt;xsl:template name=&quot;VP&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($VPKitInfo/tns1:INFO_VP_KIT[tns1:FLAG_PRESENZA_NOW = &amp;quot;N&amp;quot;])&quot;>&#xa;                &lt;tns:VerificaVPResponse>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVPResponse>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;xsl:variable name=&quot;listaIDRisorsa&quot; select=&quot;$VerificaVP.input/tns:VC_VerificaVP/tns:VPCode&quot;/>&#xa;                &lt;tns:VerificaVPResponse>&#xa;                    &lt;xsl:for-each-group select=&quot;$VerificaVP.input/tns:VC_VerificaVP&quot; group-by=&quot;tns:VPCode&quot;>&#xa;                        &lt;xsl:variable name=&quot;idRisorsa&quot; select=&quot;current-group()/tns:VPCode&quot;/>&#xa;                        &lt;xsl:for-each select=&quot;$VerificaVP.input/tns:VC_VerificaVP[tns:VPCode=$idRisorsa]&quot;>&#xa;                            &lt;tns:VP_Verifica>&#xa;                                &lt;tns:IDDettaglioOrdine>&#xa;                                    &lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&#xa;                                &lt;/tns:IDDettaglioOrdine>&#xa;                                &lt;tns:ModalitaFatturazione>&#xa;                                    &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='MODALITA_FATTURAZIONE']/value&quot;/>&#xa;                                &lt;/tns:ModalitaFatturazione>&#xa;                                &lt;tns:Tipo>&#xa;                                    &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO']/value&quot;/>&#xa;                                &lt;/tns:Tipo>&#xa;                                &lt;tns:BandaMCR>&#xa;                                    &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_MCR']/value&quot;/>&#xa;                                &lt;/tns:BandaMCR>&#xa;                                &lt;tns:BandaPCR>&#xa;                                    &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_PCR']/value&quot;/>&#xa;                                &lt;/tns:BandaPCR>&#xa;                                &lt;tns:VP_Disponibili>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&#xa;                                &lt;/tns:VP_Disponibili>&#xa;                                &lt;tns:VPCode>&#xa;                                    &lt;xsl:value-of select=&quot;$idRisorsa[1]&quot;/>&#xa;                                &lt;/tns:VPCode>&#xa;                                &lt;tns:Tipo_Trasporto>&#xa;                                    &lt;xsl:value-of select=&quot;upper-case(string($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO_TRASPORTO']/value))&quot;/>&#xa;                                &lt;/tns:Tipo_Trasporto>&#xa;                            &lt;/tns:VP_Verifica>&#xa;                        &lt;/xsl:for-each>&#xa;                    &lt;/xsl:for-each-group>&#xa;                    &lt;xsl:if test=&quot;not((string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&#xa;                        &lt;tns:CLLI>&#xa;                            &lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value&quot;/>&#xa;                        &lt;/tns:CLLI>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns:Codice>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns:Codice>&#xa;                    &lt;tns:Descrizione>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                    &lt;/tns:Descrizione>&#xa;                &lt;/tns:VerificaVPResponse>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="VP" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Oscuramento/Record[1]/CONTEGGIO = 0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Disoscurato&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Oscurato&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkDati&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaVP'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica_VP_SUB_PROCESSED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Verifica_VP_SUB_PROCESSED_&amp;quot;, $VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;                &lt;tns2:Playload>&#xa;                    &lt;tns2:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaVP/input/tns:VerificaVPRequestEsitiMultipli)))&quot;/>&#xa;                    &lt;/tns2:Binary>&#xa;                    &lt;tns2:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VerificaVP/input/tns:VerificaVPRequestEsitiMultipli, true(), true())&quot;/>&#xa;                    &lt;/tns2:XMLString>&#xa;                &lt;/tns2:Playload>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log_Oscuramento-input"
                    name="Log_Oscuramento"
                    tibex:xpdlId="a3391f79-ddff-4a38-b9e1-3a664178423f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCQueryToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="GenericLoggerToVerificaVpKit">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="GenericLoggerToAssign">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="$Oscuramento/Record[1]/CONTEGGIO = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$Oscuramento/Record[1]/CONTEGGIO = 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaVP.input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:CW_BUS_MESSAGE>&#xa;            &lt;tns2:GenericLogger>&#xa;                &lt;tns2:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns2:Application>&#xa;                &lt;tns2:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Process>&#xa;                &lt;tns2:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;CheckServiceDati&amp;quot;&quot;/>&#xa;                &lt;/tns2:Service>&#xa;                &lt;tns2:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaVP&amp;quot;&quot;/>&#xa;                &lt;/tns2:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;>&#xa;                    &lt;tns2:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$Oscuramento/Record[1]/CONTEGGIO = 0&quot;>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Disoscurato&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns2:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Oscurato&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns2:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns2:LoggerName>&#xa;                &lt;tns2:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns2:LogLevel>&#xa;                &lt;tns2:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns2:LogJMS>&#xa;            &lt;/tns2:GenericLogger>&#xa;            &lt;tns2:ActiveLoggerServices>&#xa;                &lt;tns2:Envelope>&#xa;                    &lt;tns2:Identifier>&#xa;                        &lt;tns2:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.bpm_checkDati&amp;quot;&quot;/>&#xa;                        &lt;/tns2:ServiceName>&#xa;                        &lt;tns2:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'VerificaVP'&quot;/>&#xa;                        &lt;/tns2:Operation>&#xa;                        &lt;tns2:Source>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;INTEGRATION&amp;quot;&quot;/>&#xa;                        &lt;/tns2:Source>&#xa;                        &lt;xsl:if test=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;>&#xa;                            &lt;tns2:BusinessID>&#xa;                                &lt;xsl:value-of select=&quot;$VerificaVP.input/tns:IDRichiestaOLO&quot;/>&#xa;                            &lt;/tns2:BusinessID>&#xa;                        &lt;/xsl:if>&#xa;                        &lt;tns2:EventType>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Verifica_VP_SUB_PROCESSED&amp;quot;&quot;/>&#xa;                        &lt;/tns2:EventType>&#xa;                        &lt;tns2:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Verifica_VP_SUB_PROCESSED_&amp;quot;, $VerificaVP.input/tns:IDRichiestaOLO)&quot;/>&#xa;                        &lt;/tns2:trackID>&#xa;                    &lt;/tns2:Identifier>&#xa;                    &lt;tns2:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns2:track_position>&#xa;                    &lt;tns2:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:Timestamp>&#xa;                &lt;/tns2:Envelope>&#xa;                &lt;tns2:Playload>&#xa;                    &lt;tns2:Binary>&#xa;                        &lt;xsl:value-of select=&quot;xsd:base64Binary(tib:string-to-base64(tib:render-xml($VerificaVP.input)))&quot;/>&#xa;                    &lt;/tns2:Binary>&#xa;                    &lt;tns2:XMLString>&#xa;                        &lt;xsl:value-of select=&quot;tib:render-xml($VerificaVP.input, true(), true())&quot;/>&#xa;                    &lt;/tns2:XMLString>&#xa;                &lt;/tns2:Playload>&#xa;            &lt;/tns2:ActiveLoggerServices>&#xa;        &lt;/tns2:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
