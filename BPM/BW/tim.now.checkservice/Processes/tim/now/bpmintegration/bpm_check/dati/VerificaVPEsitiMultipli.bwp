                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VP&quot;/>&lt;xsl:param name=&quot;VerificaVP&quot;/>&lt;xsl:template name=&quot;RecuperaCausaleEsitoMultiplo-input&quot; match=&quot;/&quot;>&lt;em:EsitiMultipliRequest>&lt;em:IdRichiesta>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IDRichiestaOLO&quot;/>&lt;/em:IdRichiesta>&lt;em:CodiceControllo>&lt;xsl:value-of select=&quot;'CTRL ESISTENZA VP'&quot;/>&lt;/em:CodiceControllo>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VP/tns:Descrizione)>0&quot;>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;$VP/tns:Descrizione&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:when>&lt;xsl:otherwise>&lt;em:EsitoControllo>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/em:EsitoControllo>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;em:Offerta>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:Offerta&quot;/>&lt;/em:Offerta>&lt;em:Lavorazione>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:Lavorazione&quot;/>&lt;/em:Lavorazione>&lt;xsl:if test=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:Scenario&quot;>&lt;em:Scenario>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:Scenario&quot;/>&lt;/em:Scenario>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IsPacchetto = true()&quot;>&lt;em:IsPacchetto>&lt;xsl:value-of select=&quot;$VerificaVP/input/tns:VerificaVPRequestEsitiMultipli/tns:IsPacchetto&quot;/>&lt;/em:IsPacchetto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;em:IsPacchetto>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/em:IsPacchetto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/em:EsitiMultipliRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
