                    &lt;/tns4:IDRichiestaOLO&gt;
                    &lt;tns4:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns4:Azione&gt;
                    &lt;xsl:for-each select="$VP/tns:VP_Verifica"&gt;
                        &lt;tns4:UservlanVC&gt;
                            &lt;xsl:if test="string-length(tns:BandaMCR) &gt; 0"&gt;
