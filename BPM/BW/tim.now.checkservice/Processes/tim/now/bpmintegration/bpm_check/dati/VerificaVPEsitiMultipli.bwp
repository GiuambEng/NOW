                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessiDati/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaVpKit.RESPONSE&quot;/>&lt;xsl:param name=&quot;VerificaVP.input&quot;/>&lt;xsl:param name=&quot;InterrogaAnagrafica&quot;/>&lt;xsl:template name=&quot;VP&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaVpKit.RESPONSE/tns1:CODICE_CAUSALE = &amp;quot;00&amp;quot;&quot;>&lt;xsl:variable name=&quot;listaIDRisorsa&quot; select=&quot;$VerificaVP.input/tns:VC_VerificaVP/tns:VPCode&quot;/>&lt;tns:VerificaVPResponse>&lt;xsl:for-each-group select=&quot;$VerificaVP.input/tns:VC_VerificaVP&quot; group-by=&quot;tns:VPCode&quot;>&lt;xsl:variable name=&quot;idRisorsa&quot; select=&quot;current-group()/tns:VPCode&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name = &amp;quot;STATO&amp;quot; and value=&amp;quot;Active&amp;quot;])&quot;>&lt;xsl:for-each select=&quot;$VerificaVP.input/tns:VC_VerificaVP[tns:VPCode=$idRisorsa]&quot;>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='MODALITA_FATTURAZIONE']/value&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO']/value&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_MCR']/value&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='BANDA_PCR']/value&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$idRisorsa[1]&quot;/>&lt;/tns:VPCode>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;upper-case(string($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idRisorsa]]/column[name='TIPO_TRASPORTO']/value))&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/tns:VP_Verifica>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$VerificaVP.input/tns:VC_VerificaVP[tns:VPCode=$idRisorsa]&quot;>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:MOD_FATT&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:TIPO&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:BANDA_MCR&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:BANDA_PCR&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;Y&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$idRisorsa[1]&quot;/>&lt;/tns:VPCode>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;upper-case($VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idRisorsa]/tns1:TIPO_TRASPORTO)&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/tns:VP_Verifica>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each-group>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&lt;xsl:if test=&quot;not((string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$listaIDRisorsa][1]/tns1:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$listaIDRisorsa][1]/tns1:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVPResponse>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaVpKit.RESPONSE/tns1:CODICE_CAUSALE = &amp;quot;01&amp;quot;&quot;>&lt;xsl:variable name=&quot;listaidrisorsa01&quot; select=&quot;$VerificaVP.input/tns:VC_VerificaVP/tns:VPCode&quot;/>&lt;tns:VerificaVPResponse>&lt;xsl:for-each-group select=&quot;$VerificaVP.input/tns:VC_VerificaVP&quot; group-by=&quot;tns:VPCode&quot;>&lt;xsl:variable name=&quot;idrisorsa01&quot; select=&quot;current-group()/tns:VPCode&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name = &amp;quot;STATO&amp;quot; and upper-case(string(value))=&amp;quot;ACTIVE&amp;quot;])&quot;>&lt;xsl:for-each select=&quot;$VerificaVP.input/tns:VC_VerificaVP[tns:VPCode=$idrisorsa01]&quot;>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='MODALITA_FATTURAZIONE']/value&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='TIPO']/value&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='BANDA_MCR']/value&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='BANDA_PCR']/value&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$idrisorsa01[1]&quot;/>&lt;/tns:VPCode>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;upper-case(string($InterrogaAnagrafica/unknownResultset[1]/row[column[name='COD_VP' and value=$idrisorsa01]]/column[name='TIPO_TRASPORTO']/value))&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/tns:VP_Verifica>&lt;/xsl:for-each>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:for-each select=&quot;$VerificaVP.input/tns:VC_VerificaVP[tns:VPCode=$idrisorsa01]&quot;>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;tns:IDDettaglioOrdine&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idrisorsa01]/tns1:MOD_FATT&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idrisorsa01]/tns1:TIPO&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idrisorsa01]/tns1:BANDA_MCR&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idrisorsa01]/tns1:BANDA_PCR&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;$idrisorsa01[1]&quot;/>&lt;/tns:VPCode>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;upper-case($VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$idrisorsa01]/tns1:TIPO_TRASPORTO)&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/tns:VP_Verifica>&lt;/xsl:for-each>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:for-each-group>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&lt;xsl:if test=&quot;not((string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value)&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$InterrogaAnagrafica/unknownResultset[1]/row[1]/column[name='CLLI']/value&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$listaidrisorsa01][1]/tns1:CLLI&quot;>&lt;tns:CLLI>&lt;xsl:value-of select=&quot;$VerificaVpKit.RESPONSE/tns1:INFO_VP_KIT_VP[tns1:ID_RISORSA=$listaidrisorsa01][1]/tns1:CLLI&quot;/>&lt;/tns:CLLI>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:VerificaVPResponse>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaVPResponse>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaVpKit.RESPONSE/tns1:CODICE_CAUSALE = &amp;quot;04&amp;quot;&quot;>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:VPCode>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/tns:VP_Verifica>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VP_Verifica>&lt;tns:IDDettaglioOrdine>&lt;xsl:value-of select=&quot;0&quot;/>&lt;/tns:IDDettaglioOrdine>&lt;tns:ModalitaFatturazione>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:ModalitaFatturazione>&lt;tns:Tipo>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:Tipo>&lt;tns:BandaMCR>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:BandaMCR>&lt;tns:BandaPCR>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:BandaPCR>&lt;tns:VP_Disponibili>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:VP_Disponibili>&lt;tns:VPCode>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:VPCode>&lt;tns:Tipo_Trasporto>&lt;xsl:value-of select=&quot;&amp;quot;Non presente&amp;quot;&quot;/>&lt;/tns:Tipo_Trasporto>&lt;/tns:VP_Verifica>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaVpKit.RESPONSE/tns1:CODICE_CAUSALE = &amp;quot;04&amp;quot;&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_01&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO_02&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:VerificaVPResponse>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
