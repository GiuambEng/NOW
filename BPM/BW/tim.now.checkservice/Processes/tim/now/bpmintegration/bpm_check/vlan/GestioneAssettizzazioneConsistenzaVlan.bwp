                                    sqlStatement="UPDATE OLO_VLAN SET DATAFI_VALID=?, STATO=? WHERE COD_VLAN=? AND CODFC_OLO_AGCOM IN (?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

