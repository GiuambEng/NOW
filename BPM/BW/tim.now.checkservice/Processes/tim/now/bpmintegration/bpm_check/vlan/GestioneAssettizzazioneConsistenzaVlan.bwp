CCOLTAVLANNGA','RACCOLTAVLANGBE')]) and $Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')]/tns:Attributi[tns:NomeAttributo='FAMIGLIAVLAN']/tns:ValoreAttributo='2'&quot;>&lt;tns1:TipoCos>&lt;xsl:value-of select=&quot;'BMC'&quot;/>&lt;/tns1:TipoCos>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TipoCos>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:TipoCos>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:TipoTrasporto>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='TRASPORTO']/tns:ValoreAttributo&quot;/>&lt;/tns1:TipoTrasporto>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLANNGA'&quot;>&lt;tns1:Tipologia>&lt;xsl:value-of select=&quot;'NGA'&quot;/>&lt;/tns1:Tipologia>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Offerta='VLANVULA'&quot;>&lt;tns1:Tipologia>&lt;xsl:value-of select=&quot;'VULA'&quot;/>&lt;/tns1:Tipologia>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:Tipologia>&lt;xsl:value-of select=&quot;'GBE'&quot;/>&lt;/tns1:Tipologia>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:IntermediateAgent>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='INTERMEDIATEAGENTDHCPOPTION82']/tns:ValoreAttributo&quot;/>&lt;/tns1:IntermediateAgent>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='BMCLIGHT']/tns:ValoreAttributo='SI'&quot;>&lt;tns1:BmcLight>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:BmcLight>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:BmcLight>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:BmcLight>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:TipologiaClusterVlan>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tn