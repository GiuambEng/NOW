                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+ef8d6a5b-7a1d-4b1b-8ec6-81a65bf040d9+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GestioneAssettizzazioneConsistenzaVlan&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertAnagraficaVp&quot;/>&#xa;    &lt;xsl:template name=&quot;InsAnagVpAtt-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;CLLI>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Clli)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Clli&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CLLI>&#xa;            &lt;COD_VP>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceVp)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceVp&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_VP>&#xa;            &lt;COD_AREA_RACCOLTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceAreaRaccolta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceAreaRaccolta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_AREA_RACCOLTA>&#xa;            &lt;COD_KIT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceKit)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceKit&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_KIT>&#xa;            &lt;DESC_AREA_RACCOLTA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:DescrizioneAreaRaccolta)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:DescrizioneAreaRaccolta&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DESC_AREA_RACCOLTA>&#xa;            &lt;BANDA_MCR>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:BandaMcr)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:BandaMcr&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/BANDA_MCR>&#xa;            &lt;BANDA_PCR>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:BandaPcr)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:BandaPcr&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/BANDA_PCR>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodificaOloAgcom)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodificaOloAgcom&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceOlo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:CodiceOlo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_OLO>&#xa;            &lt;DEC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Dec)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Dec&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DEC>&#xa;            &lt;DEC_ATTIVAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:DecAttivazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:DecAttivazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/DEC_ATTIVAZIONE>&#xa;            &lt;NOME_CENTRALE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:NomeCentrale)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:NomeCentrale&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_CENTRALE>&#xa;            &lt;TIPO_TRASPORTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:TipoTrasporto)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:TipoTrasporto&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIPO_TRASPORTO>&#xa;            &lt;TIPO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Tipo)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Tipo&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIPO>&#xa;            &lt;VPI>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Vpi)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Vpi&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/VPI>&#xa;            &lt;VPI_RETE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:VpiRete)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:VpiRete&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/VPI_RETE>&#xa;            &lt;STATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Stato)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:Stato&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/STATO>&#xa;            &lt;NUMERO_MAX_VC>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:NumeroMaxVc)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:NumeroMaxVc&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NUMERO_MAX_VC>&#xa;            &lt;MODALITA_FATTURAZIONE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:ModalitaFatturazione)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$InsertAnagraficaVp/tns1:Insert_AnagraficaVP/tns1:ModalitaFatturazione&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/MODALITA_FATTURAZIONE>&#xa;        &lt;/tns4:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO ANAG_VP (CLLI, COD_VP, COD_AREA_RACCOLTA, COD_KIT, DESC_AREA_RACCOLTA, BANDA_MCR, BANDA_PCR, CODFC_OLO_AGCOM, COD_OLO, DEC, DEC_ATTIVAZIONE, NOME_CENTRALE, TIPO_TRASPORTO, TIPO, VPI, VPI_RETE, STATO, NUMERO_MAX_VC, MODALITA_FATTURAZIONE) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CLLI"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_VP"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_AREA_RACCOLTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_KIT"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESC_AREA_RACCOLTA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BANDA_MCR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="BANDA_PCR"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DEC"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DEC_ATTIVAZIONE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_CENTRALE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_TRASPORTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VPI"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VPI_RETE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMERO_MAX_VC"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="MODALITA_FATTURAZIONE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="UpdateAnagraficaVp"
                    name="UpdateAnagVpVar"
                    outputVariable="UpdateAnagraficaVp"
                    tibex:xpdlId="6c72fd7e-6f4a-4ed7-9848-20f89cc316a2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckLavorazioneVpToAssign_Var"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="UpdateAnagVpVarToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GestioneAssettizzazioneConsistenzaVlan&quot; xmlns:ns=&quot;http://NOW.it.telecomitalia.it/casedata_v1&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateAnagraficaVp&quot; match=&quot;/&quot;>&lt;tns1:UpdateAnagraficaVP>&lt;tns1:Update_AnagraficaVP>&lt;tns1:CodiceKit>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']/tns:Attributi[tns:NomeAttributo='CODICETDKIT']/tns:ValoreAttributo&quot;/>&lt;/tns1:CodiceKit>&lt;tns1:Dec>&lt;xsl:value-of select=&quot;$Start/tns:Des&quot;/>&lt;/tns1:Dec>&lt;tns1:Vpi>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']/tns:Attributi[tns:NomeAttributo='VPI']/tns:ValoreAttributo&quot;/>&lt;/tns1:Vpi>&lt;tns1:Tipo>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']/tns:Attributi[tns:NomeAttributo='CARATTERISTICAVP']/tns:ValoreAttributo&quot;/>&lt;/tns1:Tipo>&lt;tns1:BandaMcr>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']/tns:Attributi[tns:NomeAttributo='BANDAMCR']/tns:ValoreAttributo&quot;/>&lt;/tns1:BandaMcr>&lt;tns1:BandaPcr>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']/tns:Attributi[tns:NomeAttributo='BANDAPCR']/tns:ValoreAttributo&quot;/>&lt;/tns1:BandaPcr>&lt;tns1:CodiceVp>&lt;xsl:value-of select=&quot;$Start/tns:IdRisorsa&quot;/>&lt;/tns1:CodiceVp>&lt;/tns1:Update_AnagraficaVP>&lt;/tns1:UpdateAnagraficaVP>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="UpdateAnagraficaVp" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="LogUpdateAnagVpVar-input"
                    name="LogUpdateAnagVpVar"
                    tibex:xpdlId="c88caf00-d553-4d07-ac8d-a775cb8aec8c"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="UpdateAnagVpVarToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogUpdateAnagVpVarToJDBCUpdate"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GestioneAssettizzazioneConsistenzaVlan&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;UpdateAnagraficaVp&quot;/>&#xa;    &lt;xsl:template name=&quot;LogUpdateAnagVpVar-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'GestioneAssettizzazioneConsistenzaVlan'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaOlo&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Dati da updatare in ANAG_VP per variazione: 