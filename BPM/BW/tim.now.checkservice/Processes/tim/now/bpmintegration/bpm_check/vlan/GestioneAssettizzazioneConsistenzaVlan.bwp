t;/>&lt;/tns1:CodificaOloAgcom>&lt;tns1:CodiceOlo>&lt;xsl:value-of select=&quot;$Start/tns:CodificaOloNow&quot;/>&lt;/tns1:CodiceOlo>&lt;tns1:Dec>&lt;xsl:value-of select=&quot;$Start/tns:Des&quot;/>&lt;/tns1:Dec>&lt;tns1:DecAttivazione>&lt;xsl:value-of select=&quot;$Start/tns:Des&quot;/>&lt;/tns1:DecAttivazione>&lt;tns1:NomeCentrale>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']//tns:Attributi[tns:NomeAttributo='NOMECLLI']/tns:ValoreAttributo&quot;/>&lt;/tns1:NomeCentrale>&lt;tns1:TipoTrasporto>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']//tns:Attributi[tns:NomeAttributo='TRASPORTO']/tns:ValoreAttributo&quot;/>&lt;/tns1:TipoTrasporto>&lt;tns1:Tipo>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']//tns:Attributi[tns:NomeAttributo='CARATTERISTICAVP']/tns:ValoreAttributo&quot;/>&lt;/tns1:Tipo>&lt;tns1:Vpi>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']//tns:Attributi[tns:NomeAttributo='VPI']/tns:ValoreAttributo&quot;/>&lt;/tns1:Vpi>&lt;tns1:VpiRete>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']//tns:Attributi[tns:NomeAttributo='VPIRETE']/tns:ValoreAttributo&quot;/>&lt;/tns1:VpiRete>&lt;tns1:Stato>&lt;xsl:value-of select=&quot;'Active'&quot;/>&lt;/tns1:Stato>&lt;tns1:NumeroMaxVc>&lt;xsl:value-of select=&quot;'1000'&quot;/>&lt;/tns1:NumeroMaxVc>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']//tns:Attributi[tns:NomeAttributo='CARATTERISTICAVP']/tns:ValoreAttributo='Lite'&quot;>&lt;tns1:ModalitaFatturazione>&lt;xsl:value-of select=&quot;'Lite'&quot;/>&lt;/tns1:ModalitaFatturazione>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente='RACCOLTAVP']//tns:Attributi[tns:NomeAttributo='CARATTERISTICAVP']/tns:ValoreAttributo=('Standard','Special')&quot;>&lt;tns1:ModalitaFatturazione>&lt;xsl:value-of select=&quot;'Flat'&quot;