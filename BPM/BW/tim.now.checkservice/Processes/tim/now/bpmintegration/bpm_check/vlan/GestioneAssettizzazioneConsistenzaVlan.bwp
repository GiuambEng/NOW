                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+9901ae3a-b6d4-4d89-ab76-f25ee744f205+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GestioneAssettizzazioneConsistenzaVlan&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;currElem&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdOloVlanCess-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:jdbcUpdateActivityInput>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$currElem/tns1:DataFineValidita&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;STATO>&#xa;                &lt;xsl:value-of select=&quot;$currElem/tns1:Stato&quot;/>&#xa;            &lt;/STATO>&#xa;            &lt;COD_VLAN>&#xa;                &lt;xsl:value-of select=&quot;$currElem/tns1:CodiceVlan&quot;/>&#xa;            &lt;/COD_VLAN>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($currElem/tns1:CodificaOloAgcomOrdine)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$currElem/tns1:CodificaOloAgcomOrdine&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;CODFC_OLO_AGCOM_2>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($currElem/tns1:CodificaOloAgcomAttributoDettaglioOrdine)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$currElem/tns1:CodificaOloAgcomAttributoDettaglioOrdine&quot;/>&#xa;   