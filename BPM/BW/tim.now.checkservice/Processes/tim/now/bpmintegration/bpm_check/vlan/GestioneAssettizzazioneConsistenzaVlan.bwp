            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="InsertAnagraficaVlan"
                    name="InsertAnagVlanAtt"
                    outputVariable="InsertAnagraficaVlan"
                    tibex:xpdlId="98be79b1-1346-402e-b8ed-05099c3b3747" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckLavorazioneToAssign_Att"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="InsertAnagVlanAttToGenericLogger"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GestioneAssettizzazioneConsistenzaVlan&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;InsertAnagraficaVlan&quot; match=&quot;/&quot;>&lt;tns1:InsertAnagraficaVlan>&lt;tns1:Insert_AnagraficaVlan>&lt;tns1:Clli>&lt;xsl:value-of select=&quot;$Start/tns:Clli&quot;/>&lt;/tns1:Clli>&lt;tns1:CodiceAreaRaccolta>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='CODICEAREARACCOLTA']/tns:ValoreAttributo&quot;/>&lt;/tns1:CodiceAreaRaccolta>&lt;tns1:CodiceKit>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='CODICETDKIT']/tns:ValoreAttributo&quot;/>&lt;/tns1:CodiceKit>&lt;tns1:CodiceMacroArea>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='CODICEMACROAREA']/tns:ValoreAttributo&quot;/>&lt;/tns1:CodiceMacroArea>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo=('1','2','3')&quot;>&lt;tns1:CodiceSuperMacroArea>&lt;xsl:value-of select=&quot;'9999'&quot;/>&lt;/tns1:CodiceSuperMacroArea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:CodiceSuperMacroArea>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:CodiceSuperMacroArea>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:CodiceVlan>&lt;xsl:value-of select=&quot;$Start/tns:IdRisorsa&quot;/>&lt;/tns1:CodiceVlan>&lt;tns1:Dec>&lt;xsl:value-of select=&quot;$Start/tns:Des&quot;/>&lt;/tns1:Dec>&lt;tns1:DecAttivazione>&lt;xsl:value-of select=&quot;$Start/tns:Des&quot;/>&lt;/tns1:DecAttivazione>&lt;tns1:DescrizioneAreaRaccolta>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='NOMEAREARACCOLTA']/tns:ValoreAttributo&quot;/>&lt;/tns1:DescrizioneAreaRaccolta>&lt;tns1:DescrizioneMacroArea>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='NOMEMACROAREA']/tns:ValoreAttributo&quot;/>&lt;/tns1:DescrizioneMacroArea>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo='1'&quot;>&lt;tns1:DescrizioneSuperMacroArea>&lt;xsl:value-of select=&quot;'SUPERMACROAREA'&quot;/>&lt;/tns1:DescrizioneSuperMacroArea>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo='2'&quot;>&lt;tns1:DescrizioneSuperMacroArea>&lt;xsl:value-of select=&quot;'SUPERMACROAREA_CC'&quot;/>&lt;/tns1:DescrizioneSuperMacroArea>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo='3'&quot;>&lt;tns1:DescrizioneSuperMacroArea>&lt;xsl:value-of select=&quot;'SUPERMACROAREA_LIB'&quot;/>&lt;/tns1:DescrizioneSuperMacroArea>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:DescrizioneSuperMacroArea>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:DescrizioneSuperMacroArea>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:DslamType>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='DSLAMTYPE']/tns:ValoreAttributo&quot;/>&lt;/tns1:DslamType>&lt;tns1:FlagEncapsulation>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='QINQFLAG']/tns:ValoreAttributo&quot;/>&lt;/tns1:FlagEncapsulation>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente='RACCOLTAVLANVULA'])&quot;>&lt;tns1:FlagVlanTranslation>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:FlagVlanTranslation>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:FlagVlanTranslation>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='FLAGVLANTRANSLATION']/tns:ValoreAttributo&quot;/>&lt;/tns1:FlagVlanTranslation>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:IdVlanOlo>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='IDENTIFICATIVOVLANOLO']/tns:ValoreAttributo&quot;/>&lt;/tns1:IdVlanOlo>&lt;tns1:Nome>&lt;xsl:value-of select=&quot;$Start/tns:Offerta&quot;/>&lt;/tns1:Nome>&lt;tns1:NomeCentrale>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='NOMECLLI']/tns:ValoreAttributo&quot;/>&lt;/tns1:NomeCentrale>&lt;tns1:Stato>&lt;xsl:value-of select=&quot;'ACTIVE'&quot;/>&lt;/tns1:Stato>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente='RACCOLTAVLANVULA'])&quot;>&lt;tns1:TipoBanda>&lt;xsl:value-of select=&quot;'MULTICOS'&quot;/>&lt;/tns1:TipoBanda>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')]) &amp;#xD;&amp;#xA;and $Start/tns:Componente[tns:Nom