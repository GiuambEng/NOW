                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GestioneAssettizzazioneConsistenzaVlan&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;UpdateAnagraficaVlan&quot; match=&quot;/&quot;>&lt;tns1:UpdateAnagraficaVlan>&lt;tns1:Update_AnagraficaVlan>&lt;tns1:CodiceKit>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='CODICETDKIT']/tns:ValoreAttributo&quot;/>&lt;/tns1:CodiceKit>&lt;tns1:Dec>&lt;xsl:value-of select=&quot;$Start/tns:Des&quot;/>&lt;/tns1:Dec>&lt;tns1:IdVlanOlo>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='IDENTIFICATIVOVLANOLO']/tns:ValoreAttributo&quot;/>&lt;/tns1:IdVlanOlo>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente='RACCOLTAVLANVULA'])&quot;>&lt;tns1:TipoBanda>&lt;xsl:value-of select=&quot;'MULTICOS'&quot;/>&lt;/tns1:TipoBanda>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')]) &amp;#xD;&amp;#xA;and $Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')]/tns:Attributi[tns:NomeAttributo='FAMIGLIAVLAN']/tns:ValoreAttributo='1'&quot;>&lt;tns1:TipoBanda>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente='TIPOCOS']/tns:Attributi[tns:NomeAttributo='TIPOBANDA']/tns:ValoreAttributo&quot;/>&lt;/tns1:TipoBanda>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')]) &amp;#xD;&amp;#xA;and $Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE')]/tns:Attributi[tns:NomeAttributo='FAMIGLIAVLAN']/tns:ValoreAttributo=('2','3')&quot;>&lt;tns1:TipoBanda>&lt;xsl:value-of select=&quot;'MULTICOS'&quot;/>&lt;/tns1:TipoBanda>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:TipoBanda>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:TipoBanda>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:TIPOLOGIACLUSTERVLAN>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='TIPOLOGIACLUSTERVLAN']/tns:ValoreAttributo&quot;/>&lt;/tns1:TIPOLOGIACLUSTERVLAN>&lt;tns1:TIPOLOGIACLUSTERVLANOLD>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:TIPOLOGIACLUSTERVLANOLD>&lt;tns1:FLAGFTTHONLY>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='FTTHONLY']/tns:ValoreAttributo&quot;/>&lt;/tns1:FLAGFTTHONLY>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo=('1','2','3')&quot;>&lt;tns1:COD_SUPER_MACRO_AREA>&lt;xsl:value-of select=&quot;'9999'&quot;/>&lt;/tns1:COD_SUPER_MACRO_AREA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:COD_SUPER_MACRO_AREA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:COD_SUPER_MACRO_AREA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo) and $Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo=('1')&quot;>&lt;tns1:DESC_SUPER_MACRO_AREA>&lt;xsl:value-of select=&quot;'SUPERMACROAREA'&quot;/>&lt;/tns1:DESC_SUPER_MACRO_AREA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo) and $Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo=('2')&quot;>&lt;tns1:DESC_SUPER_MACRO_AREA>&lt;xsl:value-of select=&quot;'SUPERMACROAREA_CC'&quot;/>&lt;/tns1:DESC_SUPER_MACRO_AREA>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo) and $Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='SUPERMACROAREA']/tns:ValoreAttributo=('3')&quot;>&lt;tns1:DESC_SUPER_MACRO_AREA>&lt;xsl:value-of select=&quot;'SUPERMACROAREA_LIB'&quot;/>&lt;/tns1:DESC_SUPER_MACRO_AREA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:DESC_SUPER_MACRO_AREA>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:DESC_SUPER_MACRO_AREA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:COD_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='CODICEAREARACCOLTA']/tns:ValoreAttributo&quot;/>&lt;/tns1:COD_AREA_RACCOLTA>&lt;tns1:COD_MACRO_AREA>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='CODICEMACROAREA']/tns:ValoreAttributo&quot;/>&lt;/tns1:COD_MACRO_AREA>&lt;tns1:DESC_AREA_RACCOLTA>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='NOMEAREARACCOLTA']/tns:ValoreAttributo&quot;/>&lt;/tns1:DESC_AREA_RACCOLTA>&lt;tns1:DESC_MACRO_AREA>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='NOMEMACROAREA']/tns:ValoreAttributo&quot;/>&lt;/tns1:DESC_MACRO_AREA>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='BMCLIGHT']/tns:ValoreAttributo='SI'&quot;>&lt;tns1:BMC_LIGHT>&lt;xsl:value-of select=&quot;'Y'&quot;/>&lt;/tns1:BMC_LIGHT>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns1:BMC_LIGHT>&lt;xsl:value-of select=&quot;''&quot;/>&lt;/tns1:BMC_LIGHT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns1:CodiceVlan>&lt;xsl:value-of select=&quot;$Start/tns:IdRisorsa&quot;/>&lt;/tns1:CodiceVlan>&lt;tns1:Car>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='IDENTIFICATIVOCAR']/tns:ValoreAttributo&quot;/>&lt;/tns1:Car>&lt;tns1:TipoTrasporto>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='TRASPORTO']/tns:ValoreAttributo&quot;/>&lt;/tns1:TipoTrasporto>&lt;tns1:CaratteristicaVlan>&lt;xsl:value-of select=&quot;$Start/tns:Componente[tns:NomeComponente=('RACCOLTAVLANNGA','RACCOLTAVLANGBE','RACCOLTAVLANVULA')]/tns:Attributi[tns:NomeAttributo='CARATTERISTICAVLAN']/tns:ValoreAttributo&quot;/>&lt;/tns1:CaratteristicaVlan>&lt;/tns1:Update_AnagraficaVlan>&lt;/tns1:UpdateAnagraficaVlan>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
