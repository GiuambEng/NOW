            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogOscuramento-input"
                    name="LogOscuramento"
                    tibex:xpdlId="cc8b36de-1940-4ae2-acc0-75b0b1eb575f"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="OscuramentoToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogOscuramentoToEmpty2">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LogOscuramentoToEmpty1">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($Oscuramento/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($Oscuramento/Record)>0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliVlan/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;LogName&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Oscuramento&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOscuramento-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;'CheckServiceVlan'&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'GestioneAssettizzazioneConsistenzaVlan'&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$Start/tns:IdRichiestaOlo&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Oscuramento/Record)>0&quot;>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;'L agesp R1I-20-0150 risulta oscurato'&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns4:Message>&#xa;                            &lt;xsl:value-of select=&quot;'L agesp R1I-20-0150 non risulta oscurato'&quot;/>&#xa;                        &lt;/tns4:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LogName&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$LogLevel&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
