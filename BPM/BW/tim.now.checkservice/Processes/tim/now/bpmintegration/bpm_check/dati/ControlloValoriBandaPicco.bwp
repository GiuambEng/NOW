                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO_COS"/>
                                    <columnMetadata
                                    columnName="BANDA_DOWNSTREAM"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="BANDA_UPSTREAM"
                                    dataType="2" typeName="NUMBER"/>
