                                    <value maxRows="100"
                                    sharedResourceProperty="JDBCProperty"
                                    sqlStatement="SELECT BANDA_DOWNSTREAM, BANDA_UPSTREAM, TIPO_COS&#xa;  FROM BANDA_PICCO&#xa;  WHERE BANDA_DOWNSTREAM = ? AND BANDA_UPSTREAM = ? AND TIPO_COS = ?&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">

