                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="CheckNumTelef" tibex:xpdlId="912fa79e-dd20-41f7-a494-168254559f07">
                <bpws:targets>
                    <bpws:target linkName="CheckTipoLineaToEmpty_Caso2-LineaPOTSISDN"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckNumTelefToAssignEsito">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckNumTelefToScompattaCodiceIndirizzo_NoNumTelefono">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="CheckDistrettoValido" tibex:xpdlId="7bd0d758-1df5-40ea-a92f-ddedb821e008">
                <bpws:targets>
                    <bpws:target linkName="AssignEsitoToCheckDistrettoValido"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckDistrettoValidoToAssignEsitoKO_KO">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckDistrettoValidoToEmpty_OK">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="($ControlloRecuperaDistrettoResponse/tns:Esito/tns:Codice = true()) and (string-length($ControlloRecuperaDistrettoResponse/tns:Distretto) > 0) and ($ControlloRecuperaDistrettoResponse/tns:Distretto != '999') " expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[($ControlloRecuperaDistrettoResponse/tns:Esito/tns:Codice = true()) and (string-length($ControlloRecuperaDistrettoResponse/tns:Distretto) > 0) and ($ControlloRecuperaDistrettoResponse/tns:Distretto != '999') ]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="ControlloRecuperaDistrettoResponse"
                    name="AssignEsitoKO"
                    outputVariable="ControlloRecuperaDistrettoResponse"
