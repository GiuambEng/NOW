                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignEsitoToCheckDistrettoValido"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput.parameters&quot;/>&lt;xsl:param name=&quot;JDBC_ComuneOLocalita&quot;/>&lt;xsl:param name=&quot;Via&quot;/>&lt;xsl:param name=&quot;CentraleNumeroCivico&quot;/>&lt;xsl:param name=&quot;DistrettoValidoCivico&quot;/>&lt;xsl:param name=&quot;DistrettoValidoVia&quot;/>&lt;xsl:param name=&quot;DistrettoValidoLocalita&quot;/>&lt;xsl:param name=&quot;NumeroCivico&quot;/>&lt;xsl:template name=&quot;ControlloRecuperaDistrettoResponse&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;(count($CentraleNumeroCivico/Record) > 0 and $DistrettoValidoCivico = true()) or (count($Via/unknownResultset/row) > 0 and $DistrettoValidoVia = true()) or (count($JDBC_ComuneOLocalita/Record) > 0 and $DistrettoValidoLocalita = true())&quot;>&lt;tns:Controllo_Recupera_Distretto_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;count($CentraleNumeroCivico/Record) > 0 and $DistrettoValidoCivico = true()&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;substring($CentraleNumeroCivico/Record[1]/ADC, 1, 3)&quot;/>&lt;/tns:Distretto>&lt;/xsl:when>&lt;xsl:when test=&quot;count($Via/unknownResultset/row) > 0 and $DistrettoValidoVia = true()&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($NumeroCivico/Record)>0 and substring($NumeroCivico/Record[1]/ADC, 1, 3) != '999'&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;substring($NumeroCivico/Record[1]/ADC, 1, 3)&quot;/>&lt;/tns:Distretto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string($Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value)&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value&quot;/>&lt;/tns:Distretto>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;$JDBC_ComuneOLocalita/Record[1]/COD_DISTR&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;$JDBC_ComuneOLocalita/Record[1]/COD_DISTR&quot;/>&lt;/tns:Distretto>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Controllo_Recupera_Distretto_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;string-length($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico) > 0&quot;>&lt;tns:Controllo_Recupera_Distretto_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;xsl:choose>&lt;xsl:when test=&quot;substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 2, 1) ='6' or substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 2, 1) ='2'&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;concat('0',substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 1, 2))&quot;/>&lt;/tns:Distretto>&lt;/xsl:when>&lt;xsl:when test=&quot;substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 3, 1)='0' or substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 3, 1)='5' or substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 3, 1)='1' or  substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 3, 1)='9'&quot;>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 1, 3)&quot;/>&lt;/tns:Distretto>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Distretto>&lt;xsl:value-of select=&quot;substring($ControlloRecuperaDistrettoInput.parameters/tns:NumeroTelefonico, 2, 3)&quot;/>&lt;/tns:Distretto>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Controllo_Recupera_Distretto_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Controllo_Recupera_Distretto_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:Controllo_Recupera_Distretto_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
