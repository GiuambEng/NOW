                        <bpws:target linkName="Log_ComuneOLocalita_NullToAssignEsito"/>
                        <bpws:target linkName="DistrettoValido3ToAssignEsito"/>
                        <bpws:target linkName="CheckDistrettoRealeToAssignEsito_DistrettoReale"/>
