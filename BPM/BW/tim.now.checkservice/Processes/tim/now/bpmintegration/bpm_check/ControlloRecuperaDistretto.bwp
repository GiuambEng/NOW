                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;CentraleNumeroCivico&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_CentraleNumCivico-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkService.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloRecuperaDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloRecuperaDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ControlloRecuperaDistrettoInput.parameters/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($CentraleNumeroCivico/Record) > 0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Risultato query Centrale Numero Civico: &amp;quot;, tib:render-xml($CentraleNumeroCivico, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun risultato recuperato da Centrale Numero Civico.&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="CheckDistretto1" tibex:xpdlId="7f00e2da-ad9d-4735-90a7-199b78c3a02a">
                <bpws:targets>
                    <bpws:target linkName="DistrettoValidoToCheckDistretto1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckDistretto1ToReplaceParticella">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckDistretto1ToAssign_SiDistretto">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$DistrettoValidoCivico = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$DistrettoValidoCivico = true()]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+94f18fc9-edea-4ae6-954f-c956d492f4cb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput&quot;/>&lt;xsl:param name=&quot;CodiceIndirizzo&quot;/>&lt;xsl:param name=&quot;ReplaceVia&quot;/>&lt;xsl:param name=&quot;ReplaceParticella&quot;/>&lt;xsl:template name=&quot;Via-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInputType>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($ControlloRecuperaDistrettoInput/parameters/tns1:Controllo_Recupera_Distretto_Request/tns1:CodiceIndirizzo) > 0 and string-length($CodiceIndirizzo/tns2:CodiceVia) > 0 and string(number($CodiceIndirizzo/tns2:CodiceVia))!='NaN'&quot;>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_DISTR FROM VIA WHERE COD_ISTAT_COMUNE = '&amp;quot;, $CodiceIndirizzo/tns2:CodiceProvincia, $CodiceIndirizzo/tns2:CodiceComune, &amp;quot;' AND COD_VIA = &amp;quot;, $CodiceIndirizzo/tns2:CodiceVia)&quot;/>&lt;/statement>&lt;/xsl:when>&lt;xsl:otherwise>&lt;statement>&lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_DISTR, COD_STRADA FROM VIA WHERE COD_ISTAT_COMUNE = '&amp;quot;, $ControlloRecuperaDistrettoInput/parameters/tns1:Controllo_Recupera_Distretto_Request/tns1:IstatComune, &amp;quot;' AND COD_PARTICELLA_TOPON = (SELECT COD_PARTICELLA_TOPON FROM PARTICELLA WHERE DESCR_PARTICELLA_TOPON = '&amp;quot;, $ReplaceParticella/ReplaceCharacterOutput/tns4:OutputString/tns4:NewString, &amp;quot;' ) AND DESCR_VIA = '&amp;quot;, $ReplaceVia/ReplaceCharacterOutput/tns4:OutputString/tns4:NewString, &amp;quot;' &amp;quot;)&quot;/>&lt;/statement>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:ActivityInputType>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Via-input" name="Via"
                    outputVariable="Via"
                    tibex:xpdlId="94f18fc9-edea-4ae6-954f-c956d492f4cb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InvokeToVia"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="VIAToCopy_1_Log_CentraleNumCivico"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+94f18fc9-edea-4ae6-954f-c956d492f4cb+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ReplaceVia.ReplaceCharacterOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;ReplaceParticella.ReplaceCharacterOutput&quot;/>&#xa;    &lt;xsl:param name=&quot;CodiceIndirizzo&quot;/>&#xa;    &lt;xsl:template name=&quot;Via-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:ActivityInputType>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($ControlloRecuperaDistrettoInput.parameters/tns1:CodiceIndirizzo) > 0 and string-length($CodiceIndirizzo/tns2:CodiceVia) > 0 and string(number($CodiceIndirizzo/tns2:CodiceVia))!='NaN'&quot;>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_DISTR FROM VIA WHERE COD_ISTAT_COMUNE = '&amp;quot;, $CodiceIndirizzo/tns2:CodiceProvincia, $CodiceIndirizzo/tns2:CodiceComune, &amp;quot;' AND COD_VIA = &amp;quot;, $CodiceIndirizzo/tns2:CodiceVia)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;statement>&#xa;                        &lt;xsl:value-of select=&quot;concat(&amp;quot;SELECT COD_DISTR, COD_STRADA FROM VIA WHERE COD_ISTAT_COMUNE = '&amp;quot;, $ControlloRecuperaDistrettoInput.parameters/tns1:IstatComune, &amp;quot;' AND COD_PARTICELLA_TOPON = (SELECT COD_PARTICELLA_TOPON FROM PARTICELLA WHERE DESCR_PARTICELLA_TOPON = '&amp;quot;, $ReplaceParticella.ReplaceCharacterOutput/tns4:NewString, &amp;quot;' ) AND DESCR_VIA = '&amp;quot;, $ReplaceVia.ReplaceCharacterOutput/tns4:NewString, &amp;quot;' &amp;quot;)&quot;/>&#xa;                    &lt;/statement>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:ActivityInputType>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.SQLDirect"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//SQLDirectActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty" xsi:type="jdbcPalette:SQLDirectActivity"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput&quot;/>&#xa;    &lt;xsl:param name=&quot;Via&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_Via-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkService.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloRecuperaDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloRecuperaDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ControlloRecuperaDistrettoInput/parameters/tns1:Controllo_Recupera_Distretto_Request/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Via/unknownResultset/row) > 0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Risultato query Via: &amp;quot;, tib:render-xml($Via, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun risultato recuperato da Via.&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="Log_Via-input" name="Log_Via"
                    tibex:xpdlId="5922f333-9586-4e96-801d-ac3c2afb8355"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="VIAToCopy_1_Log_CentraleNumCivico"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Log_ViaToDistrettoValido2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Via&quot;/>&#xa;    &lt;xsl:template name=&quot;Log_Via-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkService.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloRecuperaDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;ControlloRecuperaDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$ControlloRecuperaDistrettoInput.parameters/tns1:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($Via/unknownResultset/row) > 0&quot;>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;Risultato query Via: &amp;quot;, tib:render-xml($Via, true(), true()))&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Message>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Nessun risultato recuperato da Via.&amp;quot;&quot;/>&#xa;                        &lt;/tns:Message>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:empty name="CheckDistretto2" tibex:xpdlId="ffceadd5-24db-4e49-8115-0437e3a604dc">
                <bpws:targets>
                    <bpws:target linkName="DistrettoValido2ToCheckDistretto2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="CheckDistretto2ToJDBC_NoDistretto">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckDistretto2ToCheckDistrettoReale">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$DistrettoValidoVia = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$DistrettoValidoVia = true()]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBC_ComuneOLocalita&quot;/>&#xa;    &lt;xsl:param name=&quot;Via&quot;/>&#xa;    &lt;xsl:param name=&quot;CentraleNumeroCivico&quot;/>&#xa;    &lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput&quot;/>&#xa;    &lt;xsl:param name=&quot;DistrettoValidoCivico&quot;/>&#xa;    &lt;xsl:param name=&quot;DistrettoValidoVia&quot;/>&#xa;    &lt;xsl:param name=&quot;DistrettoValidoLocalita&quot;/>&#xa;    &lt;xsl:param name=&quot;NumeroCivico&quot;/>&#xa;    &lt;xsl:template name=&quot;ControlloRecuperaDistrettoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;(count($CentraleNumeroCivico/Record) > 0 and $DistrettoValidoCivico = true()) or (count($Via/unknownResultset/row) > 0 and $DistrettoValidoVia = true()) or (count($JDBC_ComuneOLocalita/Record) > 0 and $DistrettoValidoLocalita = true())&quot;>&#xa;                &lt;tns:Controllo_Recupera_Distretto_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($CentraleNumeroCivico/Record) > 0 and $DistrettoValidoCivico = true()&quot;>&#xa;                            &lt;tns:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;substring($CentraleNumeroCivico/Record[1]/ADC, 1, 3)&quot;/>&#xa;                            &lt;/tns:Distretto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;count($Via/unknownResultset/row) > 0 and $DistrettoValidoVia = true()&quot;>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;count($NumeroCivico/Record)>0 and substring($NumeroCivico/Record[1]/ADC, 1, 3) != '999'&quot;>&#xa;                                    &lt;tns:Distretto>&#xa;                                        &lt;xsl:value-of select=&quot;substring($NumeroCivico/Record[1]/ADC, 1, 3)&quot;/>&#xa;                                    &lt;/tns:Distretto>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:if test=&quot;not((string($Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value)&quot;>&#xa;                                        &lt;tns:Distretto>&#xa;                                            &lt;xsl:value-of select=&quot;$Via/unknownResultset[1]/row[1]/column[name = 'COD_DISTR']/value&quot;/>&#xa;                                        &lt;/tns:Distretto>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:if test=&quot;$JDBC_ComuneOLocalita/Record[1]/COD_DISTR&quot;>&#xa;                                &lt;tns:Distretto>&#xa;                                    &lt;xsl:value-of select=&quot;$JDBC_ComuneOLocalita/Record[1]/COD_DISTR&quot;/>&#xa;                                &lt;/tns:Distretto>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Controllo_Recupera_Distretto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico) > 0&quot;>&#xa;                &lt;tns:Controllo_Recupera_Distretto_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 2, 1) ='6' or substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 2, 1) ='2'&quot;>&#xa;                            &lt;tns:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;concat('0',substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 1, 2))&quot;/>&#xa;                            &lt;/tns:Distretto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 3, 1)='0' or substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 3, 1)='5' or substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 3, 1)='1' or  substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 3, 1)='9'&quot;>&#xa;                            &lt;tns:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 1, 3)&quot;/>&#xa;                            &lt;/tns:Distretto>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Distretto>&#xa;                                &lt;xsl:value-of select=&quot;substring($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:NumeroTelefonico, 2, 3)&quot;/>&#xa;                            &lt;/tns:Distretto>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Controllo_Recupera_Distretto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Controllo_Recupera_Distretto_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Controllo_Recupera_Distretto_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ControlloRecuperaDistrettoResponse"
                    name="AssignEsito"
                    outputVariable="ControlloRecuperaDistrettoResponse"
                    tibex:xpdlId="cffe7dcd-4510-470e-af70-f579e8ebe244" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CheckDistretto1ToAssign_SiDistretto"/>
