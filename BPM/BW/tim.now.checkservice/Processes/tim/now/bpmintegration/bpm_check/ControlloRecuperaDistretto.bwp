            <bpws:empty name="CheckTipoLinea" tibex:xpdlId="ec8096a4-4a37-4296-b774-3a0510342f19">
                <bpws:targets>
                    <bpws:target linkName="Log_InputToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToScompattaCodiceIndirizzo_Caso1-LineaNonFonia">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="upper-case($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:TipoLinea) = 'LINEANONFONIA' or string-length($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:IDRichiestaOLO)=0 or ($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:Offerta='FIBERSTREAM')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[upper-case($ControlloRecuperaDistrettoInput.parameters/tns:TipoLinea) = 'LINEANONFONIA' or string-length($ControlloRecuperaDistrettoInput.parameters/tns:IDRichiestaOLO)=0 or ($ControlloRecuperaDistrettoInput.parameters/tns:Lavorazione=('ATTIVAZIONE','MIGRAZIONE') and $ControlloRecuperaDistrettoInput.parameters/tns:Offerta='FIBERSTREAM')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckTipoLineaToEmpty_Caso2-LineaPOTSISDN">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="contains(upper-case($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:TipoLinea), 'POTS') or contains(upper-case($ControlloRecuperaDistrettoInput/parameters/tns:Controllo_Recupera_Distretto_Request/tns:TipoLinea), 'ISDN')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[contains(upper-case($ControlloRecuperaDistrettoInput.parameters/tns:TipoLinea), 'POTS') or contains(upper-case($ControlloRecuperaDistrettoInput.parameters/tns:TipoLinea), 'ISDN')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="CheckTipoLineaToJDBC_Default">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
