                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/ReplaceCharacter&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ReplaceCharacter&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;ControlloRecuperaDistrettoInput.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplaceParticella-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:InputString>&#xa;            &lt;tns1:OldString>&#xa;                &lt;xsl:value-of select=&quot;$ControlloRecuperaDistrettoInput.parameters/tns2:ParticellaToponomastica&quot;/>&#xa;            &lt;/tns1:OldString>&#xa;            &lt;tns1:OldChar>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;'&amp;quot;&quot;/>&#xa;            &lt;/tns1:OldChar>&#xa;            &lt;tns1:NewChar>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;''&amp;quot;&quot;/>&#xa;            &lt;/tns1:NewChar>&#xa;        &lt;/tns1:InputString>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
