    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns8=&quot;http://www.tim.com/NOW/wsdl/abstract//NOWtoCRMWS_GetContract/&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetContract&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;GetContractInvoke-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:REQUEST>&#xa;            &lt;tns7:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:CODICE_OLO&quot;/>&#xa;            &lt;/tns7:CODICE_OLO>&#xa;            &lt;tns7:CODICE_OLO_CRMWS>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/tns7:CODICE_OLO_CRMWS>&#xa;            &lt;tns7:SERVIZIO>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:Offerta&quot;/>&#xa;            &lt;/tns7:SERVIZIO>&#xa;            &lt;xsl:if test=&quot;$VerificaContrattoIn.parameters/tns1:IDRichiesta&quot;>&#xa;                &lt;tns7:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:IDRichiesta&quot;/>&#xa;                &lt;/tns7:ID_RICH_OLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns7:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
