zione>&#xa;            &lt;xsl:if test=&quot;$VerificaContrattoIn.parameters/tns1:Scenario&quot;>&#xa;                &lt;em:Scenario>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:Scenario&quot;/>&#xa;                &lt;/em:Scenario>&#xa;            &lt;/xsl:if>&#xa;            &lt;em:IsPacchetto>&#xa;                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;            &lt;/em:IsPacchetto>&#xa;        &lt;/em:EsitiMultipliRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
