            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="if (substring($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DN, 2, 1)=('2','6')) then substring($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DN, 1, 2) else if (substring($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DN, 3, 1)=('0','1','5','9')) then substring($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DN, 1, 3) else substring($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DN, 1, 4)"
