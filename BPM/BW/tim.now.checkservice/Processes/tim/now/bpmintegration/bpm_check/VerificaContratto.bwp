            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+28d72884-2934-4b9a-855f-d58ce275f8fc+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectContratto2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;PROVENIENZA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/PROVENIENZA>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DESCRIPTION>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&#xa;            &lt;/DESCRIPTION>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE1>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE1 xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectContratto2-input"
                    name="SelectContratto2"
                    outputVariable="SelectContratto2"
                    tibex:xpdlId="28d72884-2934-4b9a-855f-d58ce275f8fc" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_ContractInvoke1ToSelectContratto2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectContratto2ToLOG_Contratto2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+28d72884-2934-4b9a-855f-d58ce275f8fc+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectContratto2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;PROVENIENZA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/PROVENIENZA>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DESCRIPTION>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&#xa;            &lt;/DESCRIPTION>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE1>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE1 xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.ID_CONTRATTO, CON.FLAG_DIFFIDATO, CON.FLAG_ANFIBIO, CON.ID_COD_CONTRATTO_PADRE,CON.FLAG_NPD,CON.TIMSTP_INSMTO,CON.ID_TPLG_OPERATORE&#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xa;AND OFFER.PROVENIENZA = ? AND OFFER.NOME_OFFERTA_ESTERNA = ? &#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = ?&#xa;AND (CON.ID_TPLG_OPERATORE =? OR (? IS NULL AND CON.ID_TPLG_OPERATORE IS NULL))&#xa;ORDER BY CON.FLAG_NPD desc,CON.TIMSTP_INSMTO desc" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROVENIENZA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIPTION"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TPLG_OPERATORE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TPLG_OPERATORE1"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="FLAG_ANFIBIO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_COD_CONTRATTO_PADRE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_NPD"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="TIMSTP_INSMTO"
                                    dataType="93" typeName="TIMESTAMP"/>
                                    <columnMetadata
                                    columnName="ID_TPLG_OPERATORE"
                                    dataType="2"
                                    status="OptionalElement" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b1ac8982-f062-4438-a3ca-00cbb40a2daf+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectContratto1&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectContrattoPadre1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;ID_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_COD_CONTRATTO_PADRE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/ID_COD_CONTRATTO_PADRE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CONTRATTO>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelectContrattoPadre1-input"
                    name="SelectContrattoPadre1"
                    outputVariable="SelectContrattoPadre1"
                    tibex:xpdlId="b1ac8982-f062-4438-a3ca-00cbb40a2daf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="EmptyToSelectContrattoPadre_Name"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelectContrattoPadre1ToCopy_1_LOG_Contratto1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b1ac8982-f062-4438-a3ca-00cbb40a2daf+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectContratto1&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectContrattoPadre1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;ID_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_COD_CONTRATTO_PADRE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/ID_COD_CONTRATTO_PADRE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CONTRATTO>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT UPPER(TSC.DESCRIPTION) AS STATO, CON.ID_CONTRATTO_CRMWS, CON.DATAINZ_VALID, CON.DATAFI_VALID, CAT.DATAINZ_ASSOCZ_VALID, CAT.DATAFI_ASSOCZ_VALID, CON.COD_OLO, CON.CODFC_OLO_AGCOM&#xd;&#xa;FROM CONTRATTO CON, TIPOLG_STATO_CONTRATTO TSC, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER&#xd;&#xa;WHERE CON.ID_CONTRATTO = ? AND CON.ID_STATO_CONTRATTO = TSC.ID_STATO_CONTRATTO &#xd;&#xa;      AND CAT.ID_OFFERTA = OFFER.ID_OFFERTA AND OFFER.PROVENIENZA = 'BPM' AND OFFER.NOME_OFFERTA_ESTERNA = ?&#xd;&#xa;      AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_CONTRATTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO_CRMWS"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_ASSOCZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetContract&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectContratto1&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectContrattoPadre1&quot;/>&#xa;    &lt;xsl:param name=&quot;GetContractInvoke2&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaContrattoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_COD_CONTRATTO_PADRE) and $SelectContrattoPadre1/Record[1]/STATO = &amp;quot;ACTIVE&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and $SelectContrattoPadre1/Record[1]/DATAINZ_VALID &amp;lt; dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and $SelectContrattoPadre1/Record[1]/DATAFI_VALID > dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and $SelectContrattoPadre1/Record[1]/DATAINZ_ASSOCZ_VALID &amp;lt; dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and (&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID > dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or not(exists($SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID