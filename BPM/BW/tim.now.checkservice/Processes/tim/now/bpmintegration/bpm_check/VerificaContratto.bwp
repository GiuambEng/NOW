tring($SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID)) = 0&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&quot;>&#xa;                &lt;tns1:Verifica_Contratto_Response>&#xa;                    &lt;tns1:Id_Contratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns1:Id_Contratto>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SelectContratto1/Record[1]/FLAG_DIFFIDATO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                &lt;tns1:Flag_Diffidato>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                &lt;/tns1:Flag_Diffidato>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:Flag_Diffidato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Flag_Diffidato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/ID_TPLG_OPERATORE&quot;>&#xa;                                &lt;tns1:CodiceOperatoreRete>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/ID_TPLG_OPERATORE&quot;/>&#xa;                                &lt;/tns1:CodiceOperatoreRete>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:Verifica_Contratto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;not(exists($SelectContratto1/Record[1]/ID_COD_CONTRATTO_PADRE))  and count($SelectContratto1/Record) > 0&quot;>&#xa;                &lt;tns1:Verifica_Contratto_Response>&#xa;                    &lt;tns1:Id_Contratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns1:Id_Contratto>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SelectContratto1/Record[1]/FLAG_DIFFIDATO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                &lt;tns1:Flag_Diffidato>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                &lt;/tns1:Flag_Diffidato>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:Flag_Diffidato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Flag_Diffidato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/ID_TPLG_OPERATORE&quot;>&#xa;                                &lt;tns1:CodiceOperatoreRete>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/ID_TPLG_OPERATORE&quot;/>&#xa;                                &lt;/tns1:CodiceOperatoreRete>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:Verifica_Contratto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_COD_CONTRATTO_PADRE) and $SelectContrattoPadre1/Record[1]/STATO !=&amp;quot;ACTIVE&amp;quot;&amp;#xD;&amp;#xA;or $SelectContrattoPadre1/Record[1]/DATAINZ_VALID >= dateTime($VerificaContrattoIn.parameters/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;or $SelectContrattoPadre1/Record[1]/DATAFI_VALID &amp;lt;= dateTime($VerificaContrattoIn.parameters/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;or $SelectContrattoPadre1/Record[1]/DATAINZ_ASSOCZ_VALID >= dateTime($VerificaContrattoIn.parameters/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;or (exists($SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID)&amp;#xD;&amp;#xA;&amp;#x9;and $SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID &amp;lt;= dateTime($VerificaContrattoIn.parameters/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;))&amp;#xD;&amp;#xA;&amp;#x9;)&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($GetContractInvoke2.Output/tns7:CONTRATTO[tns7:AGREE_ID_CRMWS = $SelectContrattoPadre1/Record[1]/ID_CONTRATTO_CRMWS and tns7:STATO_CONTRATTO = &amp;quot;ACTIVE&amp;quot;])&quot;>&#xa;                        &lt;tns1:Verifica_Contratto_Response>&#xa;                            &lt;tns1:Id_Contratto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                            &lt;/tns1:Id_Contratto>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SelectContratto1/Record[1]/FLAG_DIFFIDATO) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                        &lt;tns1:Flag_Diffidato>&#xa;                                            &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                        &lt;/tns1:Flag_Diffidato>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:Flag_Diffidato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:Flag_Diffidato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;tns1:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns1:Codice>&#xa;                                &lt;tns1:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns1:Descrizione>&#xa;                            &lt;/tns1:Esito>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                                    &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/ID_TPLG_OPERATORE&quot;>&#xa;                                        &lt;tns1:CodiceOperatoreRete>&#xa;                                            &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/ID_TPLG_OPERATORE&quot;/>&#xa;                                        &lt;/tns1:CodiceOperatoreRete>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/tns1:Verifica_Contratto_Response>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns1:Verifica_Contratto_Response>&#xa;                            &lt;tns1:Id_Contratto>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                            &lt;/tns1:Id_Contratto>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;string-length($SelectContratto1/Record[1]/FLAG_DIFFIDATO) > 0&quot;>&#xa;                                    &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                        &lt;tns1:Flag_Diffidato>&#xa;                                            &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                        &lt;/tns1:Flag_Diffidato>&#xa;                                    &lt;/xsl:if>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;tns1:Flag_Diffidato>&#xa;                                        &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                                    &lt;/tns1:Flag_Diffidato>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                            &lt;tns1:Esito>&#xa;                                &lt;tns1:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns1:Codice>&#xa;                                &lt;tns1:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns1:Descrizione>&#xa;                            &lt;/tns1:Esito>&#xa;                        &lt;/tns1:Verifica_Contratto_Response>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Verifica_Contratto_Response>&#xa;                    &lt;tns1:Id_Contratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns1:Id_Contratto>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SelectContratto1/Record[1]/FLAG_DIFFIDATO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                &lt;tns1:Flag_Diffidato>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                &lt;/tns1:Flag_Diffidato>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:Flag_Diffidato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Flag_Diffidato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/tns1:Verifica_Contratto_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
