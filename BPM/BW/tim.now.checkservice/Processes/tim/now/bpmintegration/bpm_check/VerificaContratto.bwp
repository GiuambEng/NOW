                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectContratto1&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectContratto2&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaContrattoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($SelectContratto1/Record) > 0&quot;>&#xa;                &lt;tns1:Verifica_Contratto_Response>&#xa;                    &lt;tns1:Id_Contratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns1:Id_Contratto>&#xa;                    &lt;xsl:if test=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                        &lt;tns1:Flag_Diffidato>&#xa;                            &lt;xsl:value-of select=&quot;$SelectContratto1/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                        &lt;/tns1:Flag_Diffidato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;tns1:DatiAccesso/>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectContratto1/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                            &lt;tns1:CodiceOperatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[1]/ID_TPLG_OPERATORE)&quot;/>&#xa;                            &lt;/tns1:CodiceOperatoreRete>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:Verifica_Contratto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Verifica_Contratto_Response>&#xa;                    &lt;tns1:Id_Contratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto2/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns1:Id_Contratto>&#xa;                    &lt;xsl:if test=&quot;$SelectContratto2/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                        &lt;tns1:Flag_Diffidato>&#xa;                            &lt;xsl:value-of select=&quot;$SelectContratto2/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                        &lt;/tns1:Flag_Diffidato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;tns1:DatiAccesso>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectContratto2/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                                &lt;tns5:IdentificativoOperatoreRete>&#xa;                                    &lt;xsl:value-of select=&quot;xsd:int($SelectContratto2/Record[1]/ID_TPLG_OPERATORE)&quot;/>&#xa;                                &lt;/tns5:IdentificativoOperatoreRete>&#xa;                            &lt;/xsl:when>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/tns1:DatiAccesso>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectContratto2/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                            &lt;tns1:CodiceOperatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;xsd:int($SelectContratto2/Record[1]/ID_TPLG_OPERATORE)&quot;/>&#xa;                            &lt;/tns1:CodiceOperatoreRete>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:Verifica_Contratto_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
