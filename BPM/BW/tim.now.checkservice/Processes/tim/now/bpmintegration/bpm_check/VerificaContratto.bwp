            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCQuery1-input" name="JDBCQuery1"
                    outputVariable="JDBCQuery1"
                    tibex:xpdlId="d6dcd1ba-bc4a-48bc-ad24-29d28f6d4287" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
