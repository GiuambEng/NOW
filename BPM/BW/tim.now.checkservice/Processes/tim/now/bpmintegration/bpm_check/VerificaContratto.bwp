                partnerLink="DatiVerificaControlli"
                portType="ns13:DatiVerificaControlliPortType" tibex:xpdlId="282d13e2-5bf9-436c-9fc0-5d934740a048">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns7="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns5="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="VerificaContrattoIn"/&gt;
    &lt;xsl:param name="VerificaContrattoResponse"/&gt;
    &lt;xsl:param name="SelectContratto2"/&gt;
    &lt;xsl:param name="SelectContratto1"/&gt;
    &lt;xsl:param name="ContrattoFull"/&gt;
    &lt;xsl:template name="DatiVerificaControlliInvoke-input" match="/"&gt;
        &lt;tns7:DatiVerificaControlliRequest&gt;
            &lt;parameters&gt;
                &lt;tns5:DatiVerificaControlliInput&gt;
                    &lt;tns5:Operatore&gt;
                        &lt;xsl:value-of select="&amp;quot;BPM&amp;quot;"/&gt;
                    &lt;/tns5:Operatore&gt;
                    &lt;tns5:IDRichiestaOLO&gt;
                        &lt;xsl:value-of select="$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:IDRichiesta"/&gt;
                    &lt;/tns5:IDRichiestaOLO&gt;
                    &lt;tns5:Azione&gt;
                        &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                    &lt;/tns5:Azione&gt;
                    &lt;tns5:DatiAccesso&gt;
                        &lt;xsl:if test="$VerificaContrattoResponse/tns1:Flag_Diffidato"&gt;
                            &lt;tns5:FlagOLODiffidato&gt;
                                &lt;xsl:value-of select="$VerificaContrattoResponse/tns1:Flag_Diffidato"/&gt;
                            &lt;/tns5:FlagOLODiffidato&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($ContrattoFull/Record[1]/FLAG_DIFFIDATO)&gt;0"&gt;
                                &lt;xsl:if test="$ContrattoFull/Record[1]/FLAG_DIFFIDATO"&gt;
                                    &lt;tns5:FlagOLODiffidatoFull&gt;
                                        &lt;xsl:value-of select="$ContrattoFull/Record[1]/FLAG_DIFFIDATO"/&gt;
                                    &lt;/tns5:FlagOLODiffidatoFull&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$VerificaContrattoResponse/tns1:Id_Contratto"&gt;
                            &lt;tns5:IDContratto&gt;
                                &lt;xsl:value-of select="$VerificaContrattoResponse/tns1:Id_Contratto"/&gt;
                            &lt;/tns5:IDContratto&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="starts-with($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Offerta, &amp;quot;WLR&amp;quot;) and (exists($SelectContratto1/Record) or exists($SelectContratto2/Record))"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($SelectContratto1/Record)"&gt;
                                        &lt;tns5:IDContrattoFiglioWLR&gt;
                                            &lt;xsl:value-of select="string(xsd:int($SelectContratto1/Record[1]/ID_CONTRATTO))"/&gt;
                                        &lt;/tns5:IDContrattoFiglioWLR&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns5:IDContrattoFiglioWLR&gt;
                                            &lt;xsl:value-of select="string(xsd:int($SelectContratto2/Record[1]/ID_CONTRATTO))"/&gt;
                                        &lt;/tns5:IDContrattoFiglioWLR&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="$VerificaContrattoResponse/tns1:CodiceOperatoreRete"&gt;
                            &lt;tns5:IdentificativoOperatoreRete&gt;
                                &lt;xsl:value-of select="$VerificaContrattoResponse/tns1:CodiceOperatoreRete"/&gt;
                            &lt;/tns5:IdentificativoOperatoreRete&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns5:DatiAccesso&gt;
                &lt;/tns5:DatiVerificaControlliInput&gt;
            &lt;/parameters&gt;
        &lt;/tns7:DatiVerificaControlliRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
