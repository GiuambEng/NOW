                            &lt;xsl:value-of select="false()"/&gt;
                        &lt;/tns1:Codice&gt;
                        &lt;tns1:Descrizione&gt;
                            &lt;xsl:value-of select="'KO'"/&gt;
                        &lt;/tns1:Descrizione&gt;
                    &lt;/tns1:Esito&gt;
                    &lt;tns1:IdCausale&gt;
                        &lt;xsl:value-of select="xsd:int($RecuperaCausaleEsitoMultiplo1/em:IdAnagraficaCausale)"/&gt;
                    &lt;/tns1:IdCausale&gt;
                &lt;/tns2:VerificaContrattoResponse&gt;
            &lt;/parameters&gt;
        &lt;/tns2:VerificaContrattoResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;RecuperaCausaleEsitoMultiplo1&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:VerificaContrattoResponse>&#xa;            &lt;tns1:Esito>&#xa;                &lt;tns1:Codice>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:Codice>&#xa;                &lt;tns1:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                &lt;/tns1:Descrizione>&#xa;            &lt;/tns1:Esito>&#xa;            &lt;tns1:IdCausale>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($RecuperaCausaleEsitoMultiplo1/em:IdAnagraficaCausale)&quot;/>&#xa;            &lt;/tns1:IdCausale>&#xa;        &lt;/tns2:VerificaContrattoResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="RecuperaCausaleEsitoMultiplo1ToReply2"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="VerificaContrattoResponse"
                    name="AssignResponseCPS"
                    outputVariable="VerificaContrattoResponse"
                    tibex:xpdlId="f841ace0-06bf-4ebb-9ce9-70ac56b91b30" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="WhileToAssignResponseCPS"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="AssignResponseCPSToVerificaContrattoResponseAssign"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;EsitoCPS&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaContrattoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Verifica_Contratto_Response>&#xa;            &lt;xsl:if test=&quot;$EsitoCPS/tns7:IdContratto&quot;>&#xa;                &lt;tns1:Id_Contratto>&#xa;                    &lt;xsl:value-of select=&quot;$EsitoCPS/tns7:IdContratto&quot;/>&#xa;                &lt;/tns1:Id_Contratto>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$EsitoCPS/tns7:FlagDiffidato&quot;>&#xa;                &lt;tns1:Flag_Diffidato>&#xa;                    &lt;xsl:value-of select=&quot;$EsitoCPS/tns7:FlagDiffidato&quot;/>&#xa;                &lt;/tns1:Flag_Diffidato>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns1:Esito>&#xa;                &lt;tns1:Codice>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns1:Codice>&#xa;                &lt;tns1:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                &lt;/tns1:Descrizione>&#xa;            &lt;/tns1:Esito>&#xa;            &lt;xsl:if test=&quot;exists($EsitoCPS/tns7:CodiceOperatoreRete)&quot;>&#xa;                &lt;xsl:if test=&quot;$EsitoCPS/tns7:CodiceOperatoreRete&quot;>&#xa;                    &lt;tns1:CodiceOperatoreRete>&#xa;                        &lt;xsl:value-of select=&quot;$EsitoCPS/tns7:CodiceOperatoreRete&quot;/>&#xa;                    &lt;/tns1:CodiceOperatoreRete>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;exists($EsitoCPS/tns7:DataInizioValidita)&quot;>&#xa;                &lt;xsl:if test=&quot;$EsitoCPS/tns7:DataInizioValidita&quot;>&#xa;                    &lt;tns1:DataInizioValidita>&#xa;                        &lt;xsl:value-of select=&quot;$EsitoCPS/tns7:DataInizioValidita&quot;/>&#xa;                    &lt;/tns1:DataInizioValidita>&#xa;                &lt;/xsl:if>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Verifica_Contratto_Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VerificaContrattoResponse" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:empty name="Empty" tibex:xpdlId="a2b1bda8-8705-498c-b8bf-1071369bc943">
                <bpws:targets>
                    <bpws:target linkName="VerificaContrattoResponseAssignToEmpty"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToEmpty1">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="isGuiToCopy_1_LOG_DISABSERV">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Lavorazione='VARIAZIONE' and ($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:TipologiaSottolav='DISABILITAZIONESERVIZIO' or $VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:TipologiaSottolav='RIABILITAZIONE')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VerificaContrattoIn.parameters/ns5:Lavorazione='VARIAZIONE' and ($VerificaContrattoIn.parameters/ns5:TipologiaSottolav='DISABILITAZIONESERVIZIO' or $VerificaContrattoIn.parameters/ns5:TipologiaSottolav='RIABILITAZIONE')]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="6dd9938f-17d5-46d0-9d7c-d6b82edb16ef">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToAssignResponseCPS">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="WhileToRecuperaCausaleEsitoMultiplo1">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$EsitoCPS/tns:Esito='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$EsitoCPS/tns:Esito='KO']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index&lt;=count($SelectContratto1/Record) and $EsitoCPS/tns:Esito='KO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index<=count($SelectContratto1/Record) and $EsitoCPS/tns:Esito='KO']]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="JDBCQueryToGenericLogger" tibex:linkType="SUCCESS"/>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link name="LogQueryToAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="9f4c76aa-909f-41c9-a44a-4a4ed3a2cba1">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="2ca2d66b-91a6-45bc-b1d6-c1b43c4f7c31">
                                <bpws:targets>
                                    <bpws:target linkName="AssignToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:IDRichiesta&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:IDRichiesta&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Output Query : ', tib:render-xml($JDBCQuery))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogQuery-input"
                                    name="LogQuery"
                                    tibex:xpdlId="83765280-e4b9-4bb0-b207-30c7cc8271be"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCQueryToGenericLogger"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogQueryToAssign"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;LogQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaContrattoIn.parameters/tns1:IDRichiesta&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:IDRichiesta&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Output Query : ', tib:render-xml($JDBCQuery))&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCQuery-input"
                                    name="JDBCQuery"
                                    outputVariable="JDBCQuery"
                                    tibex:xpdlId="57e34c40-671a-4115-a9e0-98d60c25f668" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToGenericLogger"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+57e34c40-671a-4115-a9e0-98d60c25f668+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectContratto1&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;AGREE_ROW_ID>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectContratto1/Record[number($index)]/ID_CONTRATTO_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectContratto1/Record[number($index)]/ID_CONTRATTO_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/AGREE_ROW_ID>&#xa;            &lt;VAL>&#xa;                &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;            &lt;/VAL>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CPS.AGREE_ROW_ID, TRUNC(CPS.DATA_INIZIO_VALIDITA) AS DATA_INIZIO_VALIDITA FROM OGG_DACRMWS_AGREE_CPS CPS, OGG_DACRMWS_DISTRICT_VAL VL&#xa;WHERE CPS.AGREE_ROW_ID = ?&#xa;AND CPS.DISTRICT = VL.ROW_ID &#xa;AND VL.NAME = ?&#xa;AND TRUNC(CPS.DATA_INIZIO_VALIDITA)&lt;=TRUNC(SYSDATE) AND TRUNC(CPS.DATA_FINE_VALIDITA)>=TRUNC(SYSDATE)"
                                    timeout="10" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="AGREE_ROW_ID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VAL"/>
                                    <columnMetadata
                                    columnName="AGREE_ROW_ID"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATA_INIZIO_VALIDITA"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="EsitoCPS"
                                    name="EsitoCPS"
                                    outputVariable="EsitoCPS"
                                    tibex:xpdlId="82f8640b-0644-44da-82a3-87d649e59414" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogQueryToAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/BPM_CheckUtil&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectContratto1&quot;/>&#xa;    &lt;xsl:template name=&quot;EsitoCPS&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;count($JDBCQuery/Record)>0&quot;>&#xa;                &lt;tns7:VerificaContrattoCPS>&#xa;                    &lt;tns7:Esito>&#xa;                        &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                    &lt;/tns7:Esito>&#xa;                    &lt;tns7:IdContratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto1/Record[number($index)]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns7:IdContratto>&#xa;                    &lt;xsl:if test=&quot;$SelectContratto1/Record[number($index)]/FLAG_DIFFIDATO&quot;>&#xa;                        &lt;tns7:FlagDiffidato>&#xa;                            &lt;xsl:value-of select=&quot;$SelectContratto1/Record[number($index)]/FLAG_DIFFIDATO&quot;/>&#xa;                        &lt;/tns7:FlagDiffidato>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($SelectContratto1/Record[number($index)]/ID_TPLG_OPERATORE)&quot;>&#xa;                        &lt;xsl:if test=&quot;$SelectContratto1/Record[number($index)]/ID_TPLG_OPERATORE&quot;>&#xa;                            &lt;tns7:CodiceOperatoreRete>&#xa;                                &lt;xsl:value-of select=&quot;$SelectContratto1/Record[number($index)]/ID_TPLG_OPERATORE&quot;/>&#xa;                            &lt;/tns7:CodiceOperatoreRete>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;xsl:if test=&quot;exists($JDBCQuery/Record[1]/DATA_INIZIO_VALIDITA)&quot;>&#xa;                        &lt;tns7:DataInizioValidita>&#xa;                            &lt;xsl:value-of select=&quot;xsd:date($JDBCQuery/Record[1]/DATA_INIZIO_VALIDITA)&quot;/>&#xa;                        &lt;/tns7:DataInizioValidita>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/tns7:VerificaContrattoCPS>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns7:VerificaContrattoCPS>&#xa;                    &lt;tns7:Esito>&#xa;                        &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;                    &lt;/tns7:Esito>&#xa;                &lt;/tns7:VerificaContrattoCPS>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="EsitoCPS" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
