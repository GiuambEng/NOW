                portType="ns1:BPM_CheckPortType"
                tibex:xpdlId="5a06a01a-727e-47f3-b77b-18df668fc7a2" variable="ReplyCPS-GPON-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/" xmlns:tns1="http://www.tim.com/NOW/xsd/ControlliAmmessi/" xmlns:em="http://www.tim.com/NOW/xsd/EsitiMultipli/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="RecuperaCausaleEsitoMultiplo"/&gt;
    &lt;xsl:template name="ReplyCPS-input" match="/"&gt;
        &lt;tns2:VerificaContrattoResponse&gt;
            &lt;parameters&gt;
                &lt;tns2:VerificaContrattoResponse&gt;
                    &lt;tns1:Esito&gt;
                        &lt;tns1:Codice&gt;
                            &lt;xsl:value-of select="false()"/&gt;
                        &lt;/tns1:Codice&gt;
                        &lt;tns1:Descrizione&gt;
