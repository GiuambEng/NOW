            <bpws:empty name="Empty1" tibex:xpdlId="0407e32b-2606-4ba9-877f-946a5b66c2f7">
                <bpws:targets>
                    <bpws:target linkName="LOG_QueryDisabToEmpty1"/>
                    <bpws:target linkName="EmptyToEmpty1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty1ToContratto_Semi">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Lavorazione = ('ATTIVAZIONE', 'MIGRAZIONE', 'VARIAZIONE') and $VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Offerta = ('SEMIVULAFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIEASYIPNGAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$VerificaContrattoIn.parameters/ns5:Lavorazione = ('ATTIVAZIONE', 'MIGRAZIONE', 'VARIAZIONE') and $VerificaContrattoIn.parameters/ns5:Offerta = ('SEMIVULAFTTH', 'SEMIBITSTREAMNGAFTTH', 'SEMIEASYIPNGAFTTH','FULLGPONPLUS','FULLGPONPLUSNGA')]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToEmpty2">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty1ToJDBCQuery2_SemiGpon">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Offerta='UBBSEMIGPON' and $VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:GestioneAutonoma='OS'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$VerificaContrattoIn.parameters/ns5:Offerta='UBBSEMIGPON' and $VerificaContrattoIn.parameters/ns5:GestioneAutonoma='OS']]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:empty name="Empty2" tibex:xpdlId="cf2001a6-ceda-4eb9-8a48-adda635d99e9">
                <bpws:targets>
                    <bpws:target linkName="LogContrattoFullToEmpty2"/>
                    <bpws:target linkName="Empty1ToEmpty2"/>
                    <bpws:target linkName="LogGestAutPAToEmpty2"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="Empty2ToDatiVerificaControlliInvoke">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="string-length($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:IDRichiesta) > 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[string-length($VerificaContrattoIn.parameters/ns5:IDRichiesta) > 0]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="Empty2ToEnrichmentTrue">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
            </bpws:empty>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0430f209-2f05-497c-b7d9-d0a4a8c27d51+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VerificaContrattoIn&quot;/>&lt;xsl:template name=&quot;ContrattoFull-input&quot; match=&quot;/&quot;>&lt;tns6:jdbcQueryActivityInput>&lt;PROVENIENZA>&lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&lt;/PROVENIENZA>&lt;xsl:choose>&lt;xsl:when test=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Offerta = 'SEMIEASYIPNGAFTTH'&quot;>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'EASYIPNGAFTTH'&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Offerta = ('SEMIVULAFTTH','FULLGPONPLUS')&quot;>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;DATAFI_ASSOCZ_VALID>&lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&lt;/DATAFI_ASSOCZ_VALID>&lt;DATAINZ_ASSOCZ_VALID>&lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&lt;/DATAINZ_ASSOCZ_VALID>&lt;DATAFI_VALID>&lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&lt;/DATAFI_VALID>&lt;DATAINZ_VALID>&lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO&quot;/>&lt;/DATAINZ_VALID>&lt;CODFC_OLO_AGCOM>&lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOLOAGCOM&quot;/>&lt;/CODFC_OLO_AGCOM>&lt;DESCRIPTION>&lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&lt;/DESCRIPTION>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)>0&quot;>&lt;ID_TPLG_OPERATORE>&lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)&quot;/>&lt;/ID_TPLG_OPERATORE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)>0&quot;>&lt;ID_TPLG_OPERATORE1>&lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:CodiceOperatoreRete)&quot;/>&lt;/ID_TPLG_OPERATORE1>&lt;/xsl:when>&lt;xsl:otherwise>&lt;ID_TPLG_OPERATORE1 xsi:nil=&quot;true&quot;/>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns6:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="ContrattoFull-input"
                    name="ContrattoFull" outputVariable="ContrattoFull"
                    tibex:xpdlId="0430f209-2f05-497c-b7d9-d0a4a8c27d51" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Empty1ToContratto_Semi"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="ContrattoFullToLogContrattoFull"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+0430f209-2f05-497c-b7d9-d0a4a8c27d51+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;ContrattoFull-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:jdbcQueryActivityInput>&#xa;            &lt;PROVENIENZA>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;BPM&amp;quot;&quot;/>&#xa;            &lt;/PROVENIENZA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$VerificaContrattoIn.parameters/tns1:Offerta = 'SEMIEASYIPNGAFTTH'&quot;>&#xa;                    &lt;NOME_OFFERTA_ESTERNA>&#xa;                        &lt;xsl:value-of select=&quot;'EASYIPNGAFTTH'&quot;/>&#xa;                    &lt;/NOME_OFFERTA_ESTERNA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$VerificaContrattoIn.parameters/tns1:Offerta = ('SEMIVULAFTTH','FULLGPONPLUS')&quot;>&#xa;                    &lt;NOME_OFFERTA_ESTERNA>&#xa;                        &lt;xsl:value-of select=&quot;'VULAFTTH'&quot;/>&#xa;                    &lt;/NOME_OFFERTA_ESTERNA>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NOME_OFFERTA_ESTERNA>&#xa;                        &lt;xsl:value-of select=&quot;'BITSTREAMNGAFTTH'&quot;/>&#xa;                    &lt;/NOME_OFFERTA_ESTERNA>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;DATAFI_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_ASSOCZ_VALID>&#xa;            &lt;DATAINZ_ASSOCZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_ASSOCZ_VALID>&#xa;            &lt;DATAFI_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAFI_VALID>&#xa;            &lt;DATAINZ_VALID>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:DRO&quot;/>&#xa;            &lt;/DATAINZ_VALID>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:CodiceOLOAGCOM&quot;/>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;DESCRIPTION>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;Active&amp;quot;&quot;/>&#xa;            &lt;/DESCRIPTION>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE1>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($VerificaContrattoIn.parameters/tns1:CodiceOperatoreRete)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE1 xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns6:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.ID_CONTRATTO, CON.FLAG_DIFFIDATO, CAT.DATAINZ_ASSOCZ_VALID, CAT.DATAFI_ASSOCZ_VALID, CON.DATAINZ_VALID, CON.DATAFI_VALID &#xd;&#xa;FROM CONTRATTO CON, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER, TIPOLG_STATO_CONTRATTO CONTR&#xd;&#xa;WHERE CAT.ID_OFFERTA = OFFER.ID_OFFERTA &#xd;&#xa;AND OFFER.PROVENIENZA = ? AND OFFER.NOME_OFFERTA_ESTERNA = ? &#xd;&#xa;AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO AND (CAT.DATAFI_ASSOCZ_VALID > ? OR CAT.DATAFI_ASSOCZ_VALID = NULL) &#xd;&#xa;AND CAT.DATAINZ_ASSOCZ_VALID &lt; ? AND CON.DATAFI_VALID > ? AND CON.DATAINZ_VALID &lt; ? &#xd;&#xa;AND CON.CODFC_OLO_AGCOM = ? AND CON.ID_STATO_CONTRATTO = CONTR.ID_STATO_CONTRATTO AND CONTR.DESCRIPTION = ?&#xd;&#xa;AND (CON.ID_TPLG_OPERATORE = ? OR (? IS NULL AND CON.ID_TPLG_OPERATORE IS NULL))&#xd;&#xa;ORDER BY CON.FLAG_NPD desc, CON.TIMSTP_INSMTO desc" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="PROVENIENZA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_ASSOCZ_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>
                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESCRIPTION"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TPLG_OPERATORE"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TPLG_OPERATORE1"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="FLAG_DIFFIDATO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINZ_ASSOCZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
