                    <bpws:targets>
                        <bpws:target linkName="SelectContrattoPadre1ToCopy_1_LOG_Contratto1"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Copy_1_LOG_NOACTIVE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="LOG_ACTIVE">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($SelectContrattoPadre1/Record) = 0 or (&#xd;&#xa;&#x9;count($SelectContrattoPadre1/Record) > 0 &#xd;&#xa;&#x9;&#x9;and $SelectContrattoPadre1/Record[1]/STATO = &quot;ACTIVE&quot; &#xd;&#xa;&#x9;&#x9;and $SelectContrattoPadre1/Record[1]/DATAINZ_VALID &lt; xsd:dateTime($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DRO)&#xd;&#xa;&#x9;&#x9;and $SelectContrattoPadre1/Record[1]/DATAFI_VALID > xsd:dateTime($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DRO)&#xd;&#xa;&#x9;&#x9;and $SelectContrattoPadre1/Record[1]/DATAINZ_ASSOCZ_VALID &lt; xsd:dateTime($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DRO) &#xd;&#xa;&#x9;&#x9;and (&#xd;&#xa;&#x9;&#x9;&#x9;$SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID > xsd:dateTime($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:DRO) &#xd;&#xa;&#x9;&#x9;&#x9;or not(exists($SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID)) &#xd;&#xa;&#x9;&#x9;&#x9;or string-length(string($SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID)) = 0&#xd;&#xa;&#x9;&#x9;&#x9;)&#xd;&#xa;&#x9;&#x9;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[count($SelectContrattoPadre1/Record) = 0 or (
	count($SelectContrattoPadre1/Record) > 0 
		and $SelectContrattoPadre1/Record[1]/STATO = "ACTIVE" 
		and $SelectContrattoPadre1/Record[1]/DATAINZ_VALID < xsd:dateTime($VerificaContrattoIn.parameters/ns5:DRO)
		and $SelectContrattoPadre1/Record[1]/DATAFI_VALID > xsd:dateTime($VerificaContrattoIn.parameters/ns5:DRO)
		and $SelectContrattoPadre1/Record[1]/DATAINZ_ASSOCZ_VALID < xsd:dateTime($VerificaContrattoIn.parameters/ns5:DRO) 
		and (
			$SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID > xsd:dateTime($VerificaContrattoIn.parameters/ns5:DRO) 
			or not(exists($SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID)) 
			or string-length(string($SelectContrattoPadre1/Record[1]/DATAFI_ASSOCZ_VALID)) = 0
			)
		)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
