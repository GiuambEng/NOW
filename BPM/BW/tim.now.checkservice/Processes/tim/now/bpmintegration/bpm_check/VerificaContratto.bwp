                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+74eb54ca-4f23-4519-bfce-f42d2cf0c8a7+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectContratto2&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectContrattoPadre2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:jdbcQueryActivityInput>&#xa;            &lt;ID_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectContratto2/Record[1]/ID_COD_CONTRATTO_PADRE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectContratto2/Record[1]/ID_COD_CONTRATTO_PADRE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CONTRATTO>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:Offerta&quot;/>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns7:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT UPPER(TSC.DESCRIPTION) AS STATO, CON.ID_CONTRATTO_CRMWS, CON.DATAINZ_VALID, CON.DATAFI_VALID, CAT.DATAINZ_ASSOCZ_VALID, CAT.DATAFI_ASSOCZ_VALID, CON.COD_OLO, CON.CODFC_OLO_AGCOM&#xd;&#xa;FROM CONTRATTO CON, TIPOLG_STATO_CONTRATTO TSC, CONTRATTO_OFFERTA_CATLG CAT, TRASCODFC_OFFERTA OFFER&#xd;&#xa;WHERE CON.ID_CONTRATTO = ? AND CON.ID_STATO_CONTRATTO = TSC.ID_STATO_CONTRATTO &#xd;&#xa;      AND CAT.ID_OFFERTA = OFFER.ID_OFFERTA AND OFFER.PROVENIENZA = 'BPM' AND OFFER.NOME_OFFERTA_ESTERNA = ?&#xd;&#xa;      AND CON.ID_CONTRATTO = CAT.ID_CONTRATTO" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_CONTRATTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <columnMetadata
                                    columnName="STATO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="ID_CONTRATTO_CRMWS"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAINZ_ASSOCZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="DATAFI_ASSOCZ_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>
                                    <columnMetadata
                                    columnName="COD_OLO"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="CODFC_OLO_AGCOM"
                                    dataType="12"
                                    status="OptionalElement" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectContrattoPadre2&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectContratto2&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaContrattoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;exists($SelectContratto2/Record[1]/ID_COD_CONTRATTO_PADRE) and $SelectContrattoPadre2/Record[1]/STATO = &amp;quot;ACTIVE&amp;quot; &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and $SelectContrattoPadre2/Record[1]/DATAINZ_VALID &amp;lt; dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and $SelectContrattoPadre2/Record[1]/DATAFI_VALID > dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and $SelectContrattoPadre2/Record[1]/DATAINZ_ASSOCZ_VALID &amp;lt; dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;and (&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;$SelectContrattoPadre2/Record[1]/DATAFI_ASSOCZ_VALID > dateTime($VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:DRO, xsd:time(&amp;quot;00:00:00&amp;quot;)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or not(exists($SelectContrattoPadre2/Record[1]/DATAFI_ASSOCZ_VALID)) &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;or string-length(string($SelectContrattoPadre2/Record[1]/DATAFI_ASSOCZ_VALID)) = 0&amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9;&amp;#x9;)&quot;>&#xa;                &lt;tns1:Verifica_Contratto_Response>&#xa;                    &lt;tns1:Id_Contratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto2/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns1:Id_Contratto>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SelectContratto2/Record[1]/FLAG_DIFFIDATO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto2/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                &lt;tns1:Flag_Diffidato>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto2/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                &lt;/tns1:Flag_Diffidato>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:Flag_Diffidato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Flag_Diffidato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($SelectContratto2/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto2/Record[1]/ID_TPLG_OPERATORE&quot;>&#xa;                                &lt;tns1:CodiceOperatoreRete>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto2/Record[1]/ID_TPLG_OPERATORE&quot;/>&#xa;                                &lt;/tns1:CodiceOperatoreRete>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns1:Verifica_Contratto_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns1:Verifica_Contratto_Response>&#xa;                    &lt;tns1:Id_Contratto>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelectContratto2/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/tns1:Id_Contratto>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($SelectContratto2/Record[1]/FLAG_DIFFIDATO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$SelectContratto2/Record[1]/FLAG_DIFFIDATO&quot;>&#xa;                                &lt;tns1:Flag_Diffidato>&#xa;                                    &lt;xsl:value-of select=&quot;$SelectContratto2/Record[1]/FLAG_DIFFIDATO&quot;/>&#xa;                                &lt;/tns1:Flag_Diffidato>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:Flag_Diffidato>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;N&amp;quot;&quot;/>&#xa;                            &lt;/tns1:Flag_Diffidato>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;tns1:Esito>&#xa;                        &lt;tns1:Codice>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns1:Codice>&#xa;                        &lt;tns1:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                        &lt;/tns1:Descrizione>&#xa;                    &lt;/tns1:Esito>&#xa;                &lt;/tns1:Verifica_Contratto_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="VerificaContrattoResponse"
                    name="ResponseAssignFalseCodPadre2"
                    outputVariable="VerificaContrattoResponse"
                    tibex:xpdlId="41da8292-0d53-42d0-b9b1-d15df2bf938b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
