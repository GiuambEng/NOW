                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="EmptyToSelectContrattoPadre_OFFERTAWLR">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Offerta, &quot;WLR&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with($VerificaContrattoIn.parameters/ns5:Offerta, "WLR")]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RecordSIToVerificaContrattoResponseAssignTrue">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RecordSIToEmpty_OFFERTAEASYIP">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="starts-with($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Offerta, &quot;EASYIP&quot;) and ($VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Offerta != &quot;EASYIPNGAFTTCAB&quot; and $VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Offerta != &quot;EASYIPNGAFTTH&quot;)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[starts-with($VerificaContrattoIn.parameters/ns5:Offerta, "EASYIP") and ($VerificaContrattoIn.parameters/ns5:Offerta != "EASYIPNGAFTTCAB" and $VerificaContrattoIn.parameters/ns5:Offerta != "EASYIPNGAFTTH")]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RecordSI1ToCPS_OFFERTACPS">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$VerificaContrattoIn/parameters/ns1:VerificaContratto/ns5:Offerta= &quot;CPS&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[$VerificaContrattoIn.parameters/ns5:Offerta= "CPS"]]></bpws:transitionCondition>
                    </bpws:source>
                </bpws:sources>
