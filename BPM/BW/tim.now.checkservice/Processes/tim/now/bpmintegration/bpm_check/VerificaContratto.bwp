                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:template name=&quot;LogDistretto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns4:CW_BUS_MESSAGE>&#xa;            &lt;tns4:GenericLogger>&#xa;                &lt;tns4:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns4:Application>&#xa;                &lt;tns4:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns4:Process>&#xa;                &lt;tns4:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;BPM_CheckPortType&amp;quot;&quot;/>&#xa;                &lt;/tns4:Service>&#xa;                &lt;tns4:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;VerificaContratto&amp;quot;&quot;/>&#xa;                &lt;/tns4:Operation>&#xa;                &lt;xsl:if test=&quot;$VerificaContrattoIn.parameters/tns1:IDRichiesta&quot;>&#xa;                    &lt;tns4:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$VerificaContrattoIn.parameters/tns1:IDRichiesta&quot;/>&#xa;                    &lt;/tns4:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns4:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat('Recuperato distretto : ', $Distretto)&quot;/>&#xa;                &lt;/tns4:Message>&#xa;                &lt;tns4:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns4:LoggerName>&#xa;                &lt;tns4:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns4:LogLevel>&#xa;                &lt;tns4:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns4:LogJMS>&#xa;            &lt;/tns4:GenericLogger>&#xa;        &lt;/tns4:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/ControlliAmmessi/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/wsdl/abstract/BPM_CheckService/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaContrattoIn&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaCausaleEsitoMultiplo1-input&quot; match=&quot;/&quot;>&#xa;        &lt;em:EsitiMultipliRequest>&#xa;            &lt;em:IdRichiesta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:IDRichiesta&quot;/>&#xa;            &lt;/em:IdRichiesta>&#xa;            &lt;em:CodiceControllo>&#xa;                &lt;xsl:value-of select=&quot;'CTRL CONTRATTO OLO'&quot;/>&#xa;            &lt;/em:CodiceControllo>&#xa;            &lt;em:EsitoControllo>&#xa;                &lt;xsl:value-of select=&quot;'KO_02'&quot;/>&#xa;            &lt;/em:EsitoControllo>&#xa;            &lt;em:Offerta>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Offerta&quot;/>&#xa;            &lt;/em:Offerta>&#xa;            &lt;em:Lavorazione>&#xa;                &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Lavorazione&quot;/>&#xa;            &lt;/em:Lavorazione>&#xa;            &lt;xsl:if test=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Scenario&quot;>&#xa;                &lt;em:Scenario>&#xa;                    &lt;xsl:value-of select=&quot;$VerificaContrattoIn/parameters/tns2:VerificaContratto/tns1:Scenario&quot;/>&#xa;                &lt;/em:Scenario>&#xa;            &lt;/xsl:if>&#xa;            &lt;em:IsPacchetto>&#xa;                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;            &lt;/em:IsPacchetto>&#xa;        &lt;/em:EsitiMultipliRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="RecuperaCausaleEsitoMultiplo1-input"
                    name="RecuperaCausaleEsitoMultiplo1"
