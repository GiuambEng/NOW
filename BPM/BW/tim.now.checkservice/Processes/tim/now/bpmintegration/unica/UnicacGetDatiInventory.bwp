                portType="ns4:InsertUpdateStagingPortType" tibex:xpdlId="6dc97d52-0db2-4f44-9005-1bf5f26637df">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:impl="http://getdatiinventory.unicac.telecomitalia.it" xmlns:tns11="http://types.getdatiinventory.unicac.telecomitalia.it" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns2="http://www.tim.now/xsd/UnicacGetDatiInventory" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="ID_nofile_unicac"/&gt;
    &lt;xsl:param name="MapperUnicaCRequest"/&gt;
    &lt;xsl:param name="UnicacGetDatiInventoryIn"/&gt;
    &lt;xsl:template name="InsertStagingUnicac-input" match="/"&gt;
        &lt;tns:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns1:StagingRequest&gt;
                    &lt;tns1:GenericStaging&gt;
                        &lt;tns1:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="11"/&gt;
                        &lt;/tns1:ID_STATO_ELAB_STAG&gt;
                        &lt;tns1:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="tib:render-xml($MapperUnicaCRequest/impl:request)"/&gt;
                        &lt;/tns1:CONTENUTO_REQUEST&gt;
                        &lt;tns1:ESITO&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:ESITO&gt;
                        &lt;tns1:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns1:TIMSTP_RICH&gt;
                        &lt;xsl:if test="$UnicacGetDatiInventoryIn/Input/tns2:REQUEST/tns2:IdRichiestaOLO"&gt;
                            &lt;tns1:ID_RICH&gt;
                                &lt;xsl:value-of select="$UnicacGetDatiInventoryIn/Input/tns2:REQUEST/tns2:IdRichiestaOLO"/&gt;
                            &lt;/tns1:ID_RICH&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="not((string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;1&amp;quot;)))"&gt;
                            &lt;tns1:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id"/&gt;
                            &lt;/tns1:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns1:PRINCIPALE&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:PRINCIPALE&gt;
                        &lt;tns1:TIPO_NUMERO&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:TIPO_NUMERO&gt;
                        &lt;tns1:TIPO_SRVZ&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:TIPO_SRVZ&gt;
                        &lt;tns1:CAPOSERIE&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:CAPOSERIE&gt;
                        &lt;xsl:if test="not((string($MapperUnicaCRequest/impl:request/tns11:body/tns11:DN/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:body/tns11:DN/@xsi:nil)=(&amp;quot;1&amp;quot;)))"&gt;
                            &lt;tns1:DN&gt;
                                &lt;xsl:value-of select="$MapperUnicaCRequest/impl:request/tns11:body/tns11:DN"/&gt;
                            &lt;/tns1:DN&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns1:FLAG_ATTIVO&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:FLAG_ATTIVO&gt;
                        &lt;tns1:FLAG_TIPO_LINEA&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:FLAG_TIPO_LINEA&gt;
                        &lt;tns1:FLAG_NUM_SERVZ&gt;
                            &lt;xsl:value-of select="'NA'"/&gt;
                        &lt;/tns1:FLAG_NUM_SERVZ&gt;
                    &lt;/tns1:GenericStaging&gt;
                    &lt;tns1:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_UNICAC&amp;quot;"/&gt;
                    &lt;/tns1:StagingType&gt;
                    &lt;tns1:LoggerIn&gt;
                        &lt;ns:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns:TipologiaProcesso&gt;
                        &lt;ns:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns:TipologiaOperazione&gt;
                        &lt;ns:EsecuzioneNOFileProcessato&gt;
                            &lt;ns:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$ID_nofile_unicac"/&gt;
                            &lt;/ns:ID_PROCSO_NO_FILE&gt;
                            &lt;ns:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;
                            &lt;/ns:STATO_ESEC&gt;
                            &lt;ns:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns:EsecuzioneNOFileProcessato&gt;
                        &lt;ns:LogFileProcessato&gt;
                            &lt;ns:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                            &lt;/ns:LOG_LEVEL&gt;
                            &lt;ns:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns:LOG_MESSAGE&gt;
                            &lt;ns:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TIMSTP_INSMTO&gt;
                        &lt;/ns:LogFileProcessato&gt;
                    &lt;/tns1:LoggerIn&gt;
                &lt;/tns1:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:impl=&quot;http://getdatiinventory.unicac.telecomitalia.it&quot; xmlns:tns11=&quot;http://types.getdatiinventory.unicac.telecomitalia.it&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;UnicacGetDatiInventoryIn.Input&quot;/>&lt;xsl:param name=&quot;ID_nofile_unicac&quot;/>&lt;xsl:param name=&quot;MapperUnicaCRequest&quot;/>&lt;xsl:template name=&quot;InsertStagingUnicac-input&quot; match=&quot;/&quot;>&lt;tns1:StagingRequest>&lt;tns1:GenericStaging>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;11&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;tns1:CONTENUTO_REQUEST>&lt;xsl:value-of select=&quot;tib:render-xml($MapperUnicaCRequest/impl:request)&quot;/>&lt;/tns1:CONTENUTO_REQUEST>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:ESITO>&lt;tns1:TIMSTP_RICH>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns1:TIMSTP_RICH>&lt;xsl:if test=&quot;$UnicacGetDatiInventoryIn.Input/tns2:IdRichiestaOLO&quot;>&lt;tns1:ID_RICH>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryIn.Input/tns2:IdRichiestaOLO&quot;/>&lt;/tns1:ID_RICH>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns1:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id&quot;/>&lt;/tns1:TRANSACTION_ID>&lt;/xsl:if>&lt;tns1:PRINCIPALE>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:PRINCIPALE>&lt;tns1:TIPO_NUMERO>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:TIPO_NUMERO>&lt;tns1:TIPO_SRVZ>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:TIPO_SRVZ>&lt;tns1:CAPOSERIE>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:CAPOSERIE>&lt;xsl:if test=&quot;not((string($MapperUnicaCRequest/impl:request/tns11:body/tns11:DN/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:body/tns11:DN/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns1:DN>&lt;xsl:value-of select=&quot;$MapperUnicaCRequest/impl:request/tns11:body/tns11:DN&quot;/>&lt;/tns1:DN>&lt;/xsl:if>&lt;tns1:FLAG_ATTIVO>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:FLAG_ATTIVO>&lt;tns1:FLAG_TIPO_LINEA>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:FLAG_TIPO_LINEA>&lt;tns1:FLAG_NUM_SERVZ>&lt;xsl:value-of select=&quot;'NA'&quot;/>&lt;/tns1:FLAG_NUM_SERVZ>&lt;/tns1:GenericStaging>&lt;tns1:StagingType>&lt;xsl:value-of select=&quot;&amp;quot;STAG_UNICAC&amp;quot;&quot;/>&lt;/tns1:StagingType>&lt;tns1:LoggerIn>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:EsecuzioneNOFileProcessato>&lt;ns:ID_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$ID_nofile_unicac&quot;/>&lt;/ns:ID_PROCSO_NO_FILE>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;IN ELABORAZIONE&amp;quot;&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_INIZIO_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_INIZIO_ELAB>&lt;/ns:EsecuzioneNOFileProcessato>&lt;ns:LogFileProcessato>&lt;ns:LOG_LEVEL>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/ns:LOG_LEVEL>&lt;ns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&lt;/ns:LOG_MESSAGE>&lt;ns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_INSMTO>&lt;/ns:LogFileProcessato>&lt;/tns1:LoggerIn>&lt;/tns1:StagingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LOG_MapperRequestUnicacToInvoke"/>
                </bpws:targets>
                <bpws:sources>
