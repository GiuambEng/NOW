&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns11="http://types.getdatiinventory.unicac.telecomitalia.it" xmlns:impl="http://getdatiinventory.unicac.telecomitalia.it" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;
    &lt;xsl:param name="ServiceUnicacGetDatiInventoryInvoke"/&gt;
    &lt;xsl:param name="InsertStagingUnicac"/&gt;
    &lt;xsl:param name="ID_nofile_unicac"/&gt;
    &lt;xsl:param name="MapperUnicaCRequest"/&gt;
    &lt;xsl:template name="UpdateStagingKO-input" match="/"&gt;
        &lt;tns:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns1:StagingRequest&gt;
                    &lt;tns1:GenericStaging&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito)"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='01'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Distretto non trovato.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='02'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Numero non trovato.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='03'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Errore elaborazione.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='04'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Errore di connessione con Service Inventory.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Chiamata a ServiceUnicacGetDatiInventory non riuscita.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
