                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:impl="http://getdatiinventory.unicac.telecomitalia.it" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns11="http://types.getdatiinventory.unicac.telecomitalia.it" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns2="http://www.tim.now/xsd/UnicacGetDatiInventory" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" version="2.0"&gt;
    &lt;xsl:param name="MapperResponseUnicac"/&gt;
