    &lt;xsl:template name="UpdateStagingUnicaC-input" match="/"&gt;
        &lt;tns:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns1:StagingRequest&gt;
                    &lt;tns1:GenericStaging&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito)"&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='01'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Distretto non trovato.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='02'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Numero non trovato.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='03'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Errore elaborazione.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:when test="$ServiceUnicacGetDatiInventoryInvoke/parameters/impl:ReperimentoServizioResponse/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='04'"&gt;
                                        &lt;tns1:DESCR_ERRORE&gt;
                                            &lt;xsl:value-of select="&amp;quot;Errore di connessione con Service Inventory.&amp;quot;"/&gt;
                                        &lt;/tns1:DESCR_ERRORE&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;tns1:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="&amp;quot;11&amp;quot;"/&gt;
                        &lt;/tns1:ID_STATO_ELAB_STAG&gt;
                        &lt;tns1:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="tib:render-xml($MapperResponseUnicac/impl:ReperimentoServizioReturn)"/&gt;
                        &lt;/tns1:CONTENUTO_RESPONSE&gt;
                        &lt;tns1:ESITO&gt;
                            &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:esito"/&gt;
                        &lt;/tns1:ESITO&gt;
                        &lt;xsl:if test="not((string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;1&amp;quot;)))"&gt;
                            &lt;tns1:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id"/&gt;
                            &lt;/tns1:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="not((string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;1&amp;quot;)))"&gt;
                            &lt;tns1:ID_TRANSAZIONE&gt;
                                &lt;xsl:value-of select="$MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id"/&gt;
                            &lt;/tns1:ID_TRANSAZIONE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale)"&gt;
                            &lt;tns1:PRINCIPALE&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale"/&gt;
                            &lt;/tns1:PRINCIPALE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero)"&gt;
                            &lt;tns1:TIPO_NUMERO&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero"/&gt;
                            &lt;/tns1:TIPO_NUMERO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio)"&gt;
                            &lt;tns1:TIPO_SRVZ&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio"/&gt;
                            &lt;/tns1:TIPO_SRVZ&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale)"&gt;
                            &lt;tns1:RADICALE&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale"/&gt;
                            &lt;/tns1:RADICALE&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="not(exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie)) or (exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie) and string-length($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie)=0) and upper-case($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio)='LINEA PBX'"&gt;
                                &lt;tns1:CAPOSERIE&gt;
                                    &lt;xsl:value-of select="$UnicacGetDatiInventoryIn/Input/tns2:REQUEST/tns2:DN"/&gt;
                                &lt;/tns1:CAPOSERIE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie)"&gt;
                                    &lt;tns1:CAPOSERIE&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie"/&gt;
                                    &lt;/tns1:CAPOSERIE&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:otherwise&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO)"&gt;
                            &lt;tns1:COD_RO&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO"/&gt;
                            &lt;/tns1:COD_RO&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="string-length($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:qta_linee)&gt;0"&gt;
                                &lt;tns1:QTA_LINEE&gt;
                                    &lt;xsl:value-of select="xsd:int($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:qta_linee)"/&gt;
                                &lt;/tns1:QTA_LINEE&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body)"&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo)"&gt;
                                    &lt;tns1:FLAG_ATTIVO&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo"/&gt;
                                    &lt;/tns1:FLAG_ATTIVO&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:response_date/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:response_date/@xsi:nil)=(&amp;quot;1&amp;quot;)))"&gt;
                            &lt;tns1:TIMSTP_RISPOSTA&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:response_date"/&gt;
                            &lt;/tns1:TIMSTP_RISPOSTA&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:choose&gt;
                            &lt;xsl:when test="exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea)"&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio)"&gt;
                                    &lt;tns1:FLAG_NUM_SERVZ&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio"/&gt;
                                    &lt;/tns1:FLAG_NUM_SERVZ&gt;
                                &lt;/xsl:if&gt;
                            &lt;/xsl:when&gt;
                            &lt;xsl:otherwise/&gt;
                        &lt;/xsl:choose&gt;
                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito)"&gt;
                            &lt;tns1:DESCR_ESITO&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito"/&gt;
                            &lt;/tns1:DESCR_ESITO&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns1:GenericStaging&gt;
                    &lt;tns1:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_UNICAC&amp;quot;"/&gt;
                    &lt;/tns1:StagingType&gt;
                    &lt;tns1:LoggerIn&gt;
                        &lt;ns:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns:TipologiaProcesso&gt;
                        &lt;ns:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns:TipologiaOperazione&gt;
                        &lt;ns:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsertStagingUnicac/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsertStagingUnicac/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStagingUnicac/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE)) "/&gt;
                            &lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$ID_nofile_unicac"/&gt;
                            &lt;/ns:ID_PROCSO_NO_FILE&gt;
                            &lt;ns:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                            &lt;/ns:STATO_ESEC&gt;
                            &lt;ns:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TMSP_FINE_ELAB&gt;
                        &lt;/ns:EsecuzioneNOFileProcessato&gt;
                        &lt;ns:LogFileProcessato&gt;
                            &lt;ns:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                            &lt;/ns:LOG_LEVEL&gt;
                            &lt;ns:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;"/&gt;
                            &lt;/ns:LOG_MESSAGE&gt;
                            &lt;ns:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns:TIMSTP_INSMTO&gt;
                        &lt;/ns:LogFileProcessato&gt;
                    &lt;/tns1:LoggerIn&gt;
                &lt;/tns1:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:impl=&quot;http://getdatiinventory.unicac.telecomitalia.it&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns11=&quot;http://types.getdatiinventory.unicac.telecomitalia.it&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InsertStagingUnicac.RESPONSE&quot;/>&lt;xsl:param name=&quot;ServiceUnicacGetDatiInventoryInvoke.parameters&quot;/>&lt;xsl:param name=&quot;UnicacGetDatiInventoryIn.Input&quot;/>&lt;xsl:param name=&quot;MapperResponseUnicac&quot;/>&lt;xsl:param name=&quot;ID_nofile_unicac&quot;/>&lt;xsl:param name=&quot;MapperUnicaCRequest&quot;/>&lt;xsl:template name=&quot;UpdateStagingUnicaC-input&quot; match=&quot;/&quot;>&lt;tns1:StagingRequest>&lt;tns1:GenericStaging>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($ServiceUnicacGetDatiInventoryInvoke.parameters/impl:ReperimentoServizioReturn/tns11:header/tns11:esito)&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;$ServiceUnicacGetDatiInventoryInvoke.parameters/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='01'&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;&amp;quot;Distretto non trovato.&amp;quot;&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceUnicacGetDatiInventoryInvoke.parameters/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='02'&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;&amp;quot;Numero non trovato.&amp;quot;&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceUnicacGetDatiInventoryInvoke.parameters/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='03'&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;&amp;quot;Errore elaborazione.&amp;quot;&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:when test=&quot;$ServiceUnicacGetDatiInventoryInvoke.parameters/impl:ReperimentoServizioReturn/tns11:header/tns11:esito='04'&quot;>&lt;tns1:DESCR_ERRORE>&lt;xsl:value-of select=&quot;&amp;quot;Errore di connessione con Service Inventory.&amp;quot;&quot;/>&lt;/tns1:DESCR_ERRORE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;tns1:ID_STATO_ELAB_STAG>&lt;xsl:value-of select=&quot;&amp;quot;11&amp;quot;&quot;/>&lt;/tns1:ID_STATO_ELAB_STAG>&lt;tns1:CONTENUTO_RESPONSE>&lt;xsl:value-of select=&quot;tib:render-xml($MapperResponseUnicac/impl:ReperimentoServizioReturn)&quot;/>&lt;/tns1:CONTENUTO_RESPONSE>&lt;tns1:ESITO>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:esito&quot;/>&lt;/tns1:ESITO>&lt;xsl:if test=&quot;not((string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns1:TRANSACTION_ID>&lt;xsl:value-of select=&quot;$MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id&quot;/>&lt;/tns1:TRANSACTION_ID>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns1:ID_TRANSAZIONE>&lt;xsl:value-of select=&quot;$MapperUnicaCRequest/impl:request/tns11:header/tns11:transaction_id&quot;/>&lt;/tns1:ID_TRANSAZIONE>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale)&quot;>&lt;tns1:PRINCIPALE>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:principale&quot;/>&lt;/tns1:PRINCIPALE>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero)&quot;>&lt;tns1:TIPO_NUMERO>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_numero&quot;/>&lt;/tns1:TIPO_NUMERO>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio)&quot;>&lt;tns1:TIPO_SRVZ>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio&quot;/>&lt;/tns1:TIPO_SRVZ>&lt;/xsl:if>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale)&quot;>&lt;tns1:RADICALE>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:radicale&quot;/>&lt;/tns1:RADICALE>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie)) or (exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie) and string-length($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie)=0) and upper-case($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:tipo_servizio)='LINEA PBX'&quot;>&lt;tns1:CAPOSERIE>&lt;xsl:value-of select=&quot;$UnicacGetDatiInventoryIn.Input/tns2:DN&quot;/>&lt;/tns1:CAPOSERIE>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie)&quot;>&lt;tns1:CAPOSERIE>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:caposerie&quot;/>&lt;/tns1:CAPOSERIE>&lt;/xsl:if>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO)&quot;>&lt;tns1:COD_RO>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:codice_RO&quot;/>&lt;/tns1:COD_RO>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:qta_linee)>0&quot;>&lt;tns1:QTA_LINEE>&lt;xsl:value-of select=&quot;xsd:int($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:qta_linee)&quot;/>&lt;/tns1:QTA_LINEE>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body)&quot;>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo)&quot;>&lt;tns1:FLAG_ATTIVO>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:flag_Attivo&quot;/>&lt;/tns1:FLAG_ATTIVO>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:response_date/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:response_date/@xsi:nil)=(&amp;quot;1&amp;quot;)))&quot;>&lt;tns1:TIMSTP_RISPOSTA>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:response_date&quot;/>&lt;/tns1:TIMSTP_RISPOSTA>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea)&quot;>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio)&quot;>&lt;tns1:FLAG_NUM_SERVZ>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:body/tns11:tipo_linea/tns11:flg_num_servizio&quot;/>&lt;/tns1:FLAG_NUM_SERVZ>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:if test=&quot;not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito)&quot;>&lt;tns1:DESCR_ESITO>&lt;xsl:value-of select=&quot;$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns11:header/tns11:desc_esito&quot;/>&lt;/tns1:DESCR_ESITO>&lt;/xsl:if>&lt;/tns1:GenericStaging>&lt;tns1:StagingType>&lt;xsl:value-of select=&quot;&amp;quot;STAG_UNICAC&amp;quot;&quot;/>&lt;/tns1:StagingType>&lt;tns1:LoggerIn>&lt;ns:TipologiaProcesso>&lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&lt;/ns:TipologiaProcesso>&lt;ns:TipologiaOperazione>&lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&lt;/ns:TipologiaOperazione>&lt;ns:EsecuzioneNOFileProcessato>&lt;xsl:if test=&quot;$InsertStagingUnicac.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&lt;ns:COD_PROCSO_FILE>&lt;xsl:value-of select=&quot;$InsertStagingUnicac.RESPONSE/tns1:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&lt;/ns:COD_PROCSO_FILE>&lt;/xsl:if>&lt;ns:ID_ESEC_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStagingUnicac.RESPONSE/tns1:LogResponse/ns:ID_ESEC_PROCSO_NOFILE)) &quot;/>&lt;/ns:ID_ESEC_PROCSO_NO_FILE>&lt;ns:ID_PROCSO_NO_FILE>&lt;xsl:value-of select=&quot;$ID_nofile_unicac&quot;/>&lt;/ns:ID_PROCSO_NO_FILE>&lt;ns:STATO_ESEC>&lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&lt;/ns:STATO_ESEC>&lt;ns:TMSP_FINE_ELAB>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TMSP_FINE_ELAB>&lt;/ns:EsecuzioneNOFileProcessato>&lt;ns:LogFileProcessato>&lt;ns:LOG_LEVEL>&lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&lt;/ns:LOG_LEVEL>&lt;ns:LOG_MESSAGE>&lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&lt;/ns:LOG_MESSAGE>&lt;ns:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/ns:TIMSTP_INSMTO>&lt;/ns:LogFileProcessato>&lt;/tns1:LoggerIn>&lt;/tns1:StagingRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="LOG_MapperResponseUnicacToInvoke"/>
