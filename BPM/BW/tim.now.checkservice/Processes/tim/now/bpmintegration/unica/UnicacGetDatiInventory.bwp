                tibex:xpdlId="9d977254-503b-4484-9040-3fea2cf14292" variable="UnicacGetDatiInventoryOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/UnicacGetDatiInventory/" xmlns:impl="http://getdatiinventory.unicac.telecomitalia.it" xmlns:tns1="http://types.getdatiinventory.unicac.telecomitalia.it" xmlns:tns2="http://www.tim.now/xsd/UnicacGetDatiInventory" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.0"&gt;
    &lt;xsl:param name="MapperResponseUnicac"/&gt;
    &lt;xsl:param name="MapperUnicaCRequest"/&gt;
    &lt;xsl:param name="UnicacGetDatiInventoryIn"/&gt;
    &lt;xsl:template name="UnicacGetDatiInventoryOut-input" match="/"&gt;
        &lt;tns:UnicacGetDatiInventoryResponse&gt;
            &lt;Output&gt;
                &lt;tns2:RESPONSE&gt;
                    &lt;tns2:ReperimentoServizioReturn&gt;
                        &lt;tns2:body&gt;
                            &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:donating/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:donating/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:donating)"&gt;
                                &lt;tns2:donating&gt;
                                    &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:donating"/&gt;
                                &lt;/tns2:donating&gt;
                            &lt;/xsl:if&gt;
                            &lt;tns2:flag_Attivo&gt;
                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:flag_Attivo"/&gt;
                            &lt;/tns2:flag_Attivo&gt;
                            &lt;tns2:tipo_linea&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi)"&gt;
                                        &lt;tns2:aggiuntivi&gt;
                                            &lt;xsl:for-each select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:linee"&gt;
                                                &lt;tns2:linee&gt;
                                                    &lt;tns2:DN&gt;
                                                        &lt;xsl:value-of select="tns1:DN"/&gt;
                                                    &lt;/tns2:DN&gt;
                                                    &lt;tns2:stato&gt;
                                                        &lt;xsl:value-of select="tns1:stato"/&gt;
                                                    &lt;/tns2:stato&gt;
                                                &lt;/tns2:linee&gt;
                                            &lt;/xsl:for-each&gt;
                                            &lt;tns2:qta_aggiuntivi&gt;
                                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:aggiuntivi/tns1:qta_aggiuntivi"/&gt;
                                            &lt;/tns2:qta_aggiuntivi&gt;
                                        &lt;/tns2:aggiuntivi&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise/&gt;
                                &lt;/xsl:choose&gt;
                                &lt;xsl:choose&gt;
                                    &lt;xsl:when test="not(exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie)) or (exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie) and string-length($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie)=0) and upper-case($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio)='LINEA PBX'"&gt;
                                        &lt;tns2:caposerie&gt;
                                            &lt;xsl:value-of select="$UnicacGetDatiInventoryIn/Input/tns2:REQUEST/tns2:DN"/&gt;
                                        &lt;/tns2:caposerie&gt;
                                    &lt;/xsl:when&gt;
                                    &lt;xsl:otherwise&gt;
                                        &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie)"&gt;
                                            &lt;tns2:caposerie&gt;
                                                &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:caposerie"/&gt;
                                            &lt;/tns2:caposerie&gt;
                                        &lt;/xsl:if&gt;
                                    &lt;/xsl:otherwise&gt;
                                &lt;/xsl:choose&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO)"&gt;
                                    &lt;tns2:codice_RO&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:codice_RO"/&gt;
                                    &lt;/tns2:codice_RO&gt;
                                &lt;/xsl:if&gt;
                                &lt;tns2:flag_TP&gt;
                                    &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flag_TP"/&gt;
                                &lt;/tns2:flag_TP&gt;
                                &lt;tns2:flg_num_servizio&gt;
                                    &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:flg_num_servizio"/&gt;
                                &lt;/tns2:flg_num_servizio&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO)"&gt;
                                    &lt;tns2:BANDA_SERVIZIO&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:BANDA_SERVIZIO"/&gt;
                                    &lt;/tns2:BANDA_SERVIZIO&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA)"&gt;
                                    &lt;tns2:TIPO_PORTABILITA&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:TIPO_PORTABILITA"/&gt;
                                    &lt;/tns2:TIPO_PORTABILITA&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale)"&gt;
                                    &lt;tns2:principale&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:principale"/&gt;
                                    &lt;/tns2:principale&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee)"&gt;
                                    &lt;tns2:qta_linee&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:qta_linee"/&gt;
                                    &lt;/tns2:qta_linee&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale)"&gt;
                                    &lt;tns2:radicale&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:radicale"/&gt;
                                    &lt;/tns2:radicale&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero)"&gt;
                                    &lt;tns2:tipo_numero&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_numero"/&gt;
                                    &lt;/tns2:tipo_numero&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="not((string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio/@xsi:nil)=(&amp;quot;true&amp;quot;)) or (string($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio/@xsi:nil)=(&amp;quot;1&amp;quot;))) and exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio)"&gt;
                                    &lt;tns2:tipo_servizio&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:tipo_servizio"/&gt;
                                    &lt;/tns2:tipo_servizio&gt;
                                &lt;/xsl:if&gt;
                                &lt;xsl:if test="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma"&gt;
                                    &lt;tns2:piattaforma&gt;
                                        &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:tipo_linea/tns1:piattaforma"/&gt;
                                    &lt;/tns2:piattaforma&gt;
                                &lt;/xsl:if&gt;
                            &lt;/tns2:tipo_linea&gt;
                            &lt;xsl:choose&gt;
                                &lt;xsl:when test="exists($MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:STS)"&gt;
                                    &lt;tns2:STS&gt;
                                        &lt;xsl:for-each select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:STS/tns1:Codice_STS"&gt;
                                            &lt;tns2:Codice_STS&gt;
                                                &lt;xsl:value-of select="."/&gt;
                                            &lt;/tns2:Codice_STS&gt;
                                        &lt;/xsl:for-each&gt;
                                    &lt;/tns2:STS&gt;
                                &lt;/xsl:when&gt;
                                &lt;xsl:otherwise/&gt;
                            &lt;/xsl:choose&gt;
                            &lt;xsl:if test="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:CODOLO_CPS"&gt;
                                &lt;tns2:CODOLO_CPS&gt;
                                    &lt;xsl:copy-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:CODOLO_CPS/@xsi:nil"/&gt;
                                    &lt;xsl:value-of select="$MapperResponseUnicac/impl:ReperimentoServizioReturn/tns1:body/tns1:CODOLO_CPS"/&gt;
                                &lt;/tns2:CODOLO_CPS&gt;
                            &lt;/xsl:if&gt;
                        &lt;/tns2:body&gt;
                        &lt;tns2:header&gt;
