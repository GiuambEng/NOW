                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns6="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" xmlns:tns7="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:tns2="http://www.tim.com/NOW/xsd/GetIndirizzoRisorsa_Jive" xmlns:ns="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;&lt;xsl:param name="Start"/&gt;&lt;xsl:param name="InsertStag"/&gt;&lt;xsl:param name="SendHTTPRequest"/&gt;&lt;xsl:param name="ParseJSON"/&gt;&lt;xsl:template name="UpdStag-input" match="/"&gt;&lt;tns6:InsertUpdateStagingRequest&gt;&lt;REQUEST&gt;&lt;tns7:StagingRequest&gt;&lt;tns7:StagingIn&gt;&lt;xsl:if test="$SendHTTPRequest/asciiContent"&gt;&lt;tns7:CONTENUTO_RESPONSE&gt;&lt;xsl:value-of select="$SendHTTPRequest/asciiContent"/&gt;&lt;/tns7:CONTENUTO_RESPONSE&gt;&lt;/xsl:if&gt;&lt;tns7:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="183"/&gt;&lt;/tns7:ID_PROCSO_NO_FILE&gt;&lt;xsl:if test="$Start/tns2:IdRichiestaOlo"&gt;&lt;tns7:ID_RICH_OLO&gt;&lt;xsl:value-of select="$Start/tns2:IdRichiestaOlo"/&gt;&lt;/tns7:ID_RICH_OLO&gt;&lt;/xsl:if&gt;&lt;tns7:ID_STATO_ELAB_STAG&gt;&lt;xsl:value-of select="11"/&gt;&lt;/tns7:ID_STATO_ELAB_STAG&gt;&lt;xsl:if test="$ParseJSON/tns2:indirizzo/tns2:codiceToponomastico"&gt;&lt;tns7:CODICE_TOPONOMASTICO&gt;&lt;xsl:value-of select="$ParseJSON/tns2:indirizzo/tns2:codiceToponomastico"/&gt;&lt;/tns7:CODICE_TOPONOMASTICO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseJSON/tns2:indirizzo/tns2:istatComune"&gt;&lt;tns7:ISTAT_COMUNE&gt;&lt;xsl:value-of select="$ParseJSON/tns2:indirizzo/tns2:istatComune"/&gt;&lt;/tns7:ISTAT_COMUNE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseJSON/tns2:esito/tns2:codice"&gt;&lt;tns7:CODICE_ESITO&gt;&lt;xsl:value-of select="$ParseJSON/tns2:esito/tns2:codice"/&gt;&lt;/tns7:CODICE_ESITO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="$ParseJSON/tns2:esito/tns2:descrizione"&gt;&lt;tns7:DESCRIZIONE_ESITO&gt;&lt;xsl:value-of select="$ParseJSON/tns2:esito/tns2:descrizione"/&gt;&lt;/tns7:DESCRIZIONE_ESITO&gt;&lt;/xsl:if&gt;&lt;/tns7:StagingIn&gt;&lt;xsl:if test="$Start/tns2:IdRichiestaOlo"&gt;&lt;tns7:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns2:IdRichiestaOlo"/&gt;&lt;/tns7:IdRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;tns7:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_GET_INDRISORSA'"/&gt;&lt;/tns7:StagingType&gt;&lt;tns7:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'UPDATE'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;xsl:if test="$InsertStag/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO_FILE&gt;&lt;xsl:value-of select="$InsertStag/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO_FILE&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStag/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO_NO_FILE&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="183"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'CHIUSO'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_FINE_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_FINE_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;xsl:if test="$InsertStag/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns:COD_PROCSO_NO_FILE"&gt;&lt;ns:COD_PROCSO&gt;&lt;xsl:value-of select="$InsertStag/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns:COD_PROCSO_NO_FILE"/&gt;&lt;/ns:COD_PROCSO&gt;&lt;/xsl:if&gt;&lt;ns:ID_ESEC_PROCSO&gt;&lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStag/RESPONSE/tns7:StagingResponse/tns7:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))"/&gt;&lt;/ns:ID_ESEC_PROCSO&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="'DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA'"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns7:LoggerIn&gt;&lt;/tns7:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetIndirizzoRisorsa_Jive&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InsertStag.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;SendHTTPRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;ParseJSON&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:StagingRequest>&#xa;            &lt;tns7:StagingIn>&#xa;                &lt;xsl:if test=&quot;$SendHTTPRequest/asciiContent&quot;>&#xa;                    &lt;tns7:CONTENUTO_RESPONSE>&#xa;                        &lt;xsl:value-of select=&quot;$SendHTTPRequest/asciiContent&quot;/>&#xa;                    &lt;/tns7:CONTENUTO_RESPONSE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;183&quot;/>&#xa;                &lt;/tns7:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:IdRichiestaOlo&quot;>&#xa;                    &lt;tns7:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns7:ID_RICH_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns7:ID_STATO_ELAB_STAG>&#xa;                &lt;xsl:if test=&quot;$ParseJSON/tns2:indirizzo/tns2:codiceToponomastico&quot;>&#xa;                    &lt;tns7:CODICE_TOPONOMASTICO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns2:indirizzo/tns2:codiceToponomastico&quot;/>&#xa;                    &lt;/tns7:CODICE_TOPONOMASTICO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseJSON/tns2:indirizzo/tns2:istatComune&quot;>&#xa;                    &lt;tns7:ISTAT_COMUNE>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns2:indirizzo/tns2:istatComune&quot;/>&#xa;                    &lt;/tns7:ISTAT_COMUNE>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseJSON/tns2:esito/tns2:codice&quot;>&#xa;                    &lt;tns7:CODICE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns2:esito/tns2:codice&quot;/>&#xa;                    &lt;/tns7:CODICE_ESITO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$ParseJSON/tns2:esito/tns2:descrizione&quot;>&#xa;                    &lt;tns7:DESCRIZIONE_ESITO>&#xa;                        &lt;xsl:value-of select=&quot;$ParseJSON/tns2:esito/tns2:descrizione&quot;/>&#xa;                    &lt;/tns7:DESCRIZIONE_ESITO>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns7:StagingIn>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:IdRichiestaOlo&quot;>&#xa;                &lt;tns7:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:IdRichiestaOlo&quot;/>&#xa;                &lt;/tns7:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns7:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_GET_INDRISORSA'&quot;/>&#xa;            &lt;/tns7:StagingType>&#xa;            &lt;tns7:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'UPDATE'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStag.RESPONSE/tns7:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStag.RESPONSE/tns7:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStag.RESPONSE/tns7:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;183&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'CHIUSO'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_FINE_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStag.RESPONSE/tns7:LogResponse/ns:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns:COD_PROCSO>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStag.RESPONSE/tns7:LogResponse/ns:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns:COD_PROCSO>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns:ID_ESEC_PROCSO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStag.RESPONSE/tns7:LogResponse/ns:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns:ID_ESEC_PROCSO>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;'DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA'&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns7:LoggerIn>&#xa;        &lt;/tns7:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="ParseJSONToInvoke"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InvokeToMapResponse"/>
                </bpws:sources>
            </bpws:invoke>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
