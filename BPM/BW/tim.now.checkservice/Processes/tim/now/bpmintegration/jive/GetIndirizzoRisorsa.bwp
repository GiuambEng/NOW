"$TransactionId"/&gt;&lt;/tns7:ID_RICH_JIVE&gt;&lt;/tns7:StagingIn&gt;&lt;xsl:if test="$Start/tns2:IdRichiestaOlo"&gt;&lt;tns7:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Start/tns2:IdRichiestaOlo"/&gt;&lt;/tns7:IdRichiestaOLO&gt;&lt;/xsl:if&gt;&lt;tns7:StagingType&gt;&lt;xsl:value-of select="'ANALITICO_GET_INDRISORSA'"/&gt;&lt;/tns7:StagingType&gt;&lt;tns7:LoggerIn&gt;&lt;ns:TipologiaProcesso&gt;&lt;xsl:value-of select="'NOFILE'"/&gt;&lt;/ns:TipologiaProcesso&gt;&lt;ns:TipologiaOperazione&gt;&lt;xsl:value-of select="'INSERT'"/&gt;&lt;/ns:TipologiaOperazione&gt;&lt;ns:EsecuzioneNOFileProcessato&gt;&lt;ns:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="183"/&gt;&lt;/ns:ID_PROCSO_NO_FILE&gt;&lt;ns:STATO_ESEC&gt;&lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;&lt;/ns:STATO_ESEC&gt;&lt;ns:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TMSP_INIZIO_ELAB&gt;&lt;/ns:EsecuzioneNOFileProcessato&gt;&lt;ns:LogFileProcessato&gt;&lt;ns:LOG_LEVEL&gt;&lt;xsl:value-of select="'INFO'"/&gt;&lt;/ns:LOG_LEVEL&gt;&lt;ns:LOG_MESSAGE&gt;&lt;xsl:value-of select="'DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA'"/&gt;&lt;/ns:LOG_MESSAGE&gt;&lt;ns:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns:TIMSTP_INSMTO&gt;&lt;/ns:LogFileProcessato&gt;&lt;/tns7:LoggerIn&gt;&lt;/tns7:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns6:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GetIndirizzoRisorsa_Jive&quot; xmlns:tns6=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; xmlns:tns7=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:ns=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;TransactionId&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:param name=&quot;Asset&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStag-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:StagingRequest>&#xa;            &lt;tns7:StagingIn>&#xa;                &lt;xsl:if test=&quot;$Mapper/tns2:Richiesta&quot;>&#xa;                    &lt;tns7:CONTENUTO_REQUEST>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper/tns2:Richiesta&quot;/>&#xa;                    &lt;/tns7:CONTENUTO_REQUEST>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns7:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;183&quot;/>&#xa;                &lt;/tns7:ID_PROCSO_NO_FILE>&#xa;                &lt;xsl:if test=&quot;$Start/tns2:IdRichiestaOlo&quot;>&#xa;                    &lt;tns7:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Start/tns2:IdRichiestaOlo&quot;/>&#xa;                    &lt;/tns7:ID_RICH_OLO>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;starts-with($Asset/Record[1]/IDRISORSA, 'U')&quot;>&#xa;                        &lt;xsl:if test=&quot;$Asset/Record[1]/IDRISORSA&quot;>&#xa;                            &lt;tns7:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$Asset/Record[1]/IDRISORSA&quot;/>&#xa;                            &lt;/tns7:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;string-length($Asset/Record[1]/NUMEROTELEFONICO)>0&quot;>&#xa;                        &lt;xsl:if test=&quot;$Asset/Record[1]/NUMEROTELEFONICO&quot;>&#xa;                            &lt;tns7:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$Asset/Record[1]/NUMEROTELEFONICO&quot;/>&#xa;                            &lt;/tns7:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:if test=&quot;$Asset/Record[1]/NUMEROFITTIZIO&quot;>&#xa;                            &lt;tns7:ID_RISORSA>&#xa;                                &lt;xsl:value-of select=&quot;$Asset/Record[1]/NUMEROFITTIZIO&quot;/>&#xa;                            &lt;/tns7:ID_RISORSA>&#xa;                        &lt;/xsl:if>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns7:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;11&quot;/>&#xa;                &lt;/tns7:ID_STATO_ELAB_STAG>&#xa;                &lt;tns7:ID_RICH_JIVE>&#xa;                    &lt;xsl:value-of select=&quot;$TransactionId&quot;/>&#xa;                &lt;/tns7:ID_RICH_JIVE>&#xa;            &lt;/tns7:StagingIn>&#xa;            &lt;xsl:if test=&quot;$Start/tns2:IdRichiestaOlo&quot;>&#xa;                &lt;tns7:IdRichiestaOLO>&#xa;                    &lt;xsl:value-of select=&quot;$Start/tns2:IdRichiestaOlo&quot;/>&#xa;                &lt;/tns7:IdRichiestaOLO>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns7:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'ANALITICO_GET_INDRISORSA'&quot;/>&#xa;            &lt;/tns7:StagingType>&#xa;            &lt;tns7:LoggerIn>&#xa;                &lt;ns:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;'NOFILE'&quot;/>&#xa;                &lt;/ns:TipologiaProcesso>&#xa;                &lt;ns:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;'INSERT'&quot;/>&#xa;                &lt;/ns:TipologiaOperazione>&#xa;                &lt;ns:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;183&quot;/>&#xa;                    &lt;/ns:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns:STATO_ESEC>&#xa;                    &lt;ns:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns:EsecuzioneNOFileProcessato>&#xa;                &lt;ns:LogFileProcessato>&#xa;                    &lt;ns:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns:LOG_LEVEL>&#xa;                    &lt;ns:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;'DA NOW A SIS EST ASINC: RICHIESTA XML INVIATA'&quot;/>&#xa;                    &lt;/ns:LOG_MESSAGE>&#xa;                    &lt;ns:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns:TIMSTP_INSMTO>&#xa;                &lt;/ns:LogFileProcessato>&#xa;            &lt;/tns7:LoggerIn>&#xa;        &lt;/tns7:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
