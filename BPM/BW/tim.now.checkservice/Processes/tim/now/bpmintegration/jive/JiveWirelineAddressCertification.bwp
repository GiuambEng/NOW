                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQueryCustomTypes/2016-04-19&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_JiveIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperJiveRequest-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:getAddressVerifyRequest>&#xa;            &lt;tns:PlacePartyRoleAssoc>&#xa;                &lt;cst:UrbanPropertyAddress>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Codice/tns1:CODICE_TOPONOMASTICA) >0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Codice/tns1:CODICE_TOPONOMASTICA&quot;>&#xa;                                &lt;cst:publicRegStreetTypeCode>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Codice/tns1:CODICE_TOPONOMASTICA&quot;/>&#xa;                                &lt;/cst:publicRegStreetTypeCode>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_PART_TOPON) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_PART_TOPON&quot;>&#xa;                                &lt;cst:streetType>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_PART_TOPON&quot;/>&#xa;                                &lt;/cst:streetType>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_VIA) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_VIA&quot;>&#xa;                                &lt;cst:addressOrLocality>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_VIA&quot;/>&#xa;                                &lt;/cst:addressOrLocality>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_LOCALITA) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_LOCALITA&quot;>&#xa;                                &lt;cst:locality>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:DESC_LOCALITA&quot;/>&#xa;                                &lt;/cst:locality>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:CAP) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:CAP&quot;>&#xa;                                &lt;cst:postcode>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:CAP&quot;/>&#xa;                                &lt;/cst:postcode>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:CIVICO) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:CIVICO&quot;>&#xa;                                &lt;cst:streetNrFirst>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:CIVICO&quot;/>&#xa;                                &lt;/cst:streetNrFirst>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/cst:UrbanPropertyAddress>&#xa;                &lt;cst:GeographicLocation>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:PROVINCIA) > 0&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:PROVINCIA&quot;>&#xa;                                &lt;cst:province>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:PROVINCIA&quot;/>&#xa;                                &lt;/cst:province>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:ISTAT_COMUNE) > 0 and string-length($Call_JiveIn.parameters/tns1:Indirizzo/tns1:ISTAT_COMUNE) &amp;lt; 7&quot;>&#xa;                            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:ISTAT_COMUNE&quot;>&#xa;                                &lt;cst:ISTATCityCode>&#xa;                                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:Indirizzo/tns1:ISTAT_COMUNE&quot;/>&#xa;                                &lt;/cst:ISTATCityCode>&#xa;                            &lt;/xsl:if>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise/>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/cst:GeographicLocation>&#xa;            &lt;/tns:PlacePartyRoleAssoc>&#xa;        &lt;/tns:getAddressVerifyRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
