            <bpws:invoke inputVariable="InsertStaging-input"
                name="InsertStaging" operation="InsertUpdateStaging"
                outputVariable="InsertStaging"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns9:InsertUpdateStagingPortType" tibex:xpdlId="72e1485e-b124-419b-a96b-cf599d220810">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:sm="http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19" xmlns:cst="http://telecomitalia.it/SOA/WirelineAddressCertificationQueryCustomTypes/2016-04-19" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/InsertUpdateStaging" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" version="2.0"&gt;
    &lt;xsl:param name="MapperJiveRequest"/&gt;
    &lt;xsl:param name="MapperJiveHeader"/&gt;
    &lt;xsl:param name="DataRichiesta"/&gt;
    &lt;xsl:param name="IdProcsoNoFile"/&gt;
    &lt;xsl:param name="IdStato_OK"/&gt;
    &lt;xsl:template name="InsertStaging-input" match="/"&gt;
        &lt;tns:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns1:StagingRequest&gt;
                    &lt;tns1:StagingOut&gt;
                        &lt;tns1:CONTENUTO_REQUEST&gt;
                            &lt;xsl:value-of select="concat(tib:render-xml($MapperJiveHeader, true(), true()), tib:render-xml($MapperJiveRequest, true(), true()))"/&gt;
                        &lt;/tns1:CONTENUTO_REQUEST&gt;
                        &lt;tns1:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                        &lt;/tns1:ID_PROCSO_NO_FILE&gt;
                        &lt;tns1:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="$IdStato_OK"/&gt;
                        &lt;/tns1:ID_STATO_ELAB_STAG&gt;
                        &lt;tns1:TIMSTP_RICH&gt;
                            &lt;xsl:value-of select="$DataRichiesta"/&gt;
                        &lt;/tns1:TIMSTP_RICH&gt;
                        &lt;xsl:if test="$MapperJiveHeader/h:transactionID"&gt;
                            &lt;tns1:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$MapperJiveHeader/h:transactionID"/&gt;
                            &lt;/tns1:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$MapperJiveRequest/sm:PlacePartyRoleAssoc/cst:UrbanPropertyAddress/cst:publicRegStreetTypeCode"&gt;
                            &lt;tns1:COD_TOPON&gt;
                                &lt;xsl:value-of select="$MapperJiveRequest/sm:PlacePartyRoleAssoc/cst:UrbanPropertyAddress/cst:publicRegStreetTypeCode"/&gt;
                            &lt;/tns1:COD_TOPON&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns1:OPERATORE&gt;
                            &lt;xsl:value-of select="&amp;quot;AUTOMATICO&amp;quot;"/&gt;
                        &lt;/tns1:OPERATORE&gt;
                    &lt;/tns1:StagingOut&gt;
                    &lt;tns1:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_VERF_IND_NO_FILE'"/&gt;
                    &lt;/tns1:StagingType&gt;
                    &lt;tns1:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;INSERT&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="'IN ELABORAZIONE'"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_INIZIO_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_INIZIO_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="'INFO'"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns1:LoggerIn&gt;
                &lt;/tns1:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:sm=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQueryCustomTypes/2016-04-19&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/InsertUpdateStaging&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperJiveRequest&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperJiveHeader&quot;/>&#xa;    &lt;xsl:param name=&quot;DataRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:param name=&quot;IdStato_OK&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:CONTENUTO_REQUEST>&#xa;                    &lt;xsl:value-of select=&quot;concat(tib:render-xml($MapperJiveHeader, true(), true()), tib:render-xml($MapperJiveRequest, true(), true()))&quot;/>&#xa;                &lt;/tns1:CONTENUTO_REQUEST>&#xa;                &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                &lt;tns1:ID_STATO_ELAB_STAG>&#xa;                    &lt;xsl:value-of select=&quot;$IdStato_OK&quot;/>&#xa;                &lt;/tns1:ID_STATO_ELAB_STAG>&#xa;                &lt;tns1:TIMSTP_RICH>&#xa;                    &lt;xsl:value-of select=&quot;$DataRichiesta&quot;/>&#xa;                &lt;/tns1:TIMSTP_RICH>&#xa;                &lt;xsl:if test=&quot;$MapperJiveHeader/h:transactionID&quot;>&#xa;                    &lt;tns1:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$MapperJiveHeader/h:transactionID&quot;/>&#xa;                    &lt;/tns1:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;xsl:if test=&quot;$MapperJiveRequest/sm:PlacePartyRoleAssoc/cst:UrbanPropertyAddress/cst:publicRegStreetTypeCode&quot;>&#xa;                    &lt;tns1:COD_TOPON>&#xa;                        &lt;xsl:value-of select=&quot;$MapperJiveRequest/sm:PlacePartyRoleAssoc/cst:UrbanPropertyAddress/cst:publicRegStreetTypeCode&quot;/>&#xa;                    &lt;/tns1:COD_TOPON>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                &lt;/tns1:OPERATORE>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_VERF_IND_NO_FILE'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;INSERT&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;'IN ELABORAZIONE'&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_INIZIO_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_INIZIO_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;'INFO'&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcessToInsertStaging"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="InsertStagingTogetAddressVerifyRequest"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:invoke inputVariable="UpdateStaging-input"
                name="UpdateStaging" operation="InsertUpdateStaging"
                outputVariable="UpdateStaging"
                partnerLink="InsertUpdateStagingPortType"
                portType="ns9:InsertUpdateStagingPortType" tibex:xpdlId="6aeb71ab-ae0a-430f-9a3f-fb99c8de385e">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:sm="http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19" xmlns:h="http://telecomitalia.it/SOA/SOAP/SOAPHeader" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/InsertUpdateStaging" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" version="2.0"&gt;
    &lt;xsl:param name="MapperJiveHeader"/&gt;
    &lt;xsl:param name="IdProcsoNoFile"/&gt;
    &lt;xsl:param name="InsertStaging"/&gt;
    &lt;xsl:param name="getAddressVerifyRequest"/&gt;
    &lt;xsl:template name="UpdateStaging-input" match="/"&gt;
        &lt;tns:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns1:StagingRequest&gt;
                    &lt;tns1:StagingOut&gt;
                        &lt;tns1:CONTENUTO_RESPONSE&gt;
                            &lt;xsl:value-of select="concat(tib:render-xml($getAddressVerifyRequest/Header, true(), true()), tib:render-xml($getAddressVerifyRequest/body, true(), true()))"/&gt;
                        &lt;/tns1:CONTENUTO_RESPONSE&gt;
                        &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:ProcessData/sm:descErr"&gt;
                            &lt;tns1:DESCR_ERRORE&gt;
                                &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:ProcessData/sm:descErr"/&gt;
                            &lt;/tns1:DESCR_ERRORE&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns1:ID_PROCSO_NO_FILE&gt;
                            &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                        &lt;/tns1:ID_PROCSO_NO_FILE&gt;
                        &lt;tns1:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns1:TIMSTP_RISPOSTA&gt;
                        &lt;xsl:if test="$MapperJiveHeader/h:transactionID"&gt;
                            &lt;tns1:TRANSACTION_ID&gt;
                                &lt;xsl:value-of select="$MapperJiveHeader/h:transactionID"/&gt;
                            &lt;/tns1:TRANSACTION_ID&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns1:OPERATORE&gt;
                            &lt;xsl:value-of select="'AUTOMATICO'"/&gt;
                        &lt;/tns1:OPERATORE&gt;
                        &lt;xsl:if test="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                            &lt;tns1:COD_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                            &lt;/tns1:COD_PROCSO_NO_FILE&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns1:StagingOut&gt;
                    &lt;tns1:StagingType&gt;
                        &lt;xsl:value-of select="'STAG_VERF_IND_NO_FILE'"/&gt;
                    &lt;/tns1:StagingType&gt;
                    &lt;tns1:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($InsertStaging/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$IdProcsoNoFile"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;CHIUSO&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns1:LoggerIn&gt;
                &lt;/tns1:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/InsertUpdateStaging/&quot; xmlns:sm=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19&quot; xmlns:h=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns1=&quot;http://www.tim.now.sharedlibrary.logprocess.telecom&quot; xmlns:ns=&quot;http://www.tim.com/NOW/wsdl/concrete/InsertUpdateStaging&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getAddressVerifyRequest.body&quot;/>&#xa;    &lt;xsl:param name=&quot;InsertStaging.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;getAddressVerifyRequest.Header&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperJiveHeader&quot;/>&#xa;    &lt;xsl:param name=&quot;IdProcsoNoFile&quot;/>&#xa;    &lt;xsl:template name=&quot;UpdateStaging-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:StagingRequest>&#xa;            &lt;tns1:StagingOut>&#xa;                &lt;tns1:CONTENUTO_RESPONSE>&#xa;                    &lt;xsl:value-of select=&quot;concat(tib:render-xml($getAddressVerifyRequest.Header, true(), true()), tib:render-xml($getAddressVerifyRequest.body, true(), true()))&quot;/>&#xa;                &lt;/tns1:CONTENUTO_RESPONSE>&#xa;                &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:ProcessData/sm:descErr&quot;>&#xa;                    &lt;tns1:DESCR_ERRORE>&#xa;                        &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:ProcessData/sm:descErr&quot;/>&#xa;                    &lt;/tns1:DESCR_ERRORE>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                &lt;/tns1:ID_PROCSO_NO_FILE>&#xa;                &lt;tns1:TIMSTP_RISPOSTA>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/tns1:TIMSTP_RISPOSTA>&#xa;                &lt;xsl:if test=&quot;$MapperJiveHeader/h:transactionID&quot;>&#xa;                    &lt;tns1:TRANSACTION_ID>&#xa;                        &lt;xsl:value-of select=&quot;$MapperJiveHeader/h:transactionID&quot;/>&#xa;                    &lt;/tns1:TRANSACTION_ID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns1:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;'AUTOMATICO'&quot;/>&#xa;                &lt;/tns1:OPERATORE>&#xa;                &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                    &lt;tns1:COD_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                    &lt;/tns1:COD_PROCSO_NO_FILE>&#xa;                &lt;/xsl:if>&#xa;            &lt;/tns1:StagingOut>&#xa;            &lt;tns1:StagingType>&#xa;                &lt;xsl:value-of select=&quot;'STAG_VERF_IND_NO_FILE'&quot;/>&#xa;            &lt;/tns1:StagingType>&#xa;            &lt;tns1:LoggerIn>&#xa;                &lt;ns1:TipologiaProcesso>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;NOFILE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaProcesso>&#xa;                &lt;ns1:TipologiaOperazione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;UPDATE&amp;quot;&quot;/>&#xa;                &lt;/ns1:TipologiaOperazione>&#xa;                &lt;ns1:EsecuzioneNOFileProcessato>&#xa;                    &lt;xsl:if test=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;>&#xa;                        &lt;ns1:COD_PROCSO_FILE>&#xa;                            &lt;xsl:value-of select=&quot;$InsertStaging.RESPONSE/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE&quot;/>&#xa;                        &lt;/ns1:COD_PROCSO_FILE>&#xa;                    &lt;/xsl:if>&#xa;                    &lt;ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer(xsd:decimal($InsertStaging.RESPONSE/tns1:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))&quot;/>&#xa;                    &lt;/ns1:ID_ESEC_PROCSO_NO_FILE>&#xa;                    &lt;ns1:ID_PROCSO_NO_FILE>&#xa;                        &lt;xsl:value-of select=&quot;$IdProcsoNoFile&quot;/>&#xa;                    &lt;/ns1:ID_PROCSO_NO_FILE>&#xa;                    &lt;ns1:STATO_ESEC>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CHIUSO&amp;quot;&quot;/>&#xa;                    &lt;/ns1:STATO_ESEC>&#xa;                    &lt;ns1:TMSP_FINE_ELAB>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TMSP_FINE_ELAB>&#xa;                &lt;/ns1:EsecuzioneNOFileProcessato>&#xa;                &lt;ns1:LogFileProcessato>&#xa;                    &lt;ns1:LOG_LEVEL>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;INFO&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_LEVEL>&#xa;                    &lt;ns1:LOG_MESSAGE>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DA NOW A SIS EST SINC: RISPOSTA XML RICEVUTA&amp;quot;&quot;/>&#xa;                    &lt;/ns1:LOG_MESSAGE>&#xa;                    &lt;ns1:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/ns1:TIMSTP_INSMTO>&#xa;                &lt;/ns1:LogFileProcessato>&#xa;            &lt;/tns1:LoggerIn>&#xa;        &lt;/tns1:StagingRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="Log_false"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="UpdateStagingToCall_JiveOut"/>
                </bpws:sources>
            </bpws:invoke>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Call_JiveIn&quot;/>&lt;xsl:param name=&quot;LogLevel&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.checkservice.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'JiveWirelineAddressCertification'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:IDRichiestaNOW&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:IDRichiestaNOW&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Input verifica indirizzo certificato&amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($Call_JiveIn/parameters/tns1:Request, true(), true())&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$LogLevel&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LogInput-input" name="LogInput"
                    tibex:xpdlId="2e8903d2-b0e5-4bc8-aaa5-92976fe80109"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Call_JiveInToLogInputProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogInputProcessToMapperJiveRequest"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_JiveIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LogLevel&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:template name=&quot;LogInput-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.checkservice.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'JiveWirelineAddressCertification'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:IDRichiestaNOW&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:IDRichiestaNOW&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Input verifica indirizzo certificato&amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib: