                                </operationConfiguration>
                                <outboundConfiguration xsi:type="axis2:HttpTransportConfiguration"/>
                            </scaext:binding>
                            <scact:bindingAdjunct bindingName="SOAPReferenceBinding">
                                <sca:property name="endpointURI" scaext:simpleValue="/Connection/HTTP/ExternalReference/Management/StagingProcess/URI"/>
                            </scact:bindingAdjunct>
