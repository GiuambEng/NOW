    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catchAll tibex:faultDetailsVar="FaultDetails"
                tibex:faultNameVar="FaultName" tibex:xpdlId="cbaf7d36-afa5-49a5-a743-e666cc44c3be">
                <bpws:scope name="scope1">
                    <bpws:flow name="flow1">
                        <bpws:links>
                            <bpws:link name="FaultLogToReply" tibex:linkType="SUCCESS"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:extActivity
                                expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Call_JiveIn&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;FaultDetails&quot;/>&lt;xsl:template name=&quot;FaultLog-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;'JiveWirelineAddressCertification'&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&lt;/tns:Operation>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:IDRichiestaNOW&quot;>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:IDRichiestaNOW&quot;/>&lt;/tns:BusinessID>&lt;/xsl:if>&lt;tns:Message>&lt;xsl:value-of select=&quot;&amp;quot;Errore Generico nella chiamata a Jive&amp;quot;&quot;/>&lt;/tns:Message>&lt;tns:Payload>&lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&lt;/tns:Payload>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;'Error'&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                inputVariable="FaultLog-input"
                                name="FaultLog"
                                tibex:xpdlId="9cd89502-a1f2-479d-876e-071978be2f5a"
                                type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="FaultLogToReply"/>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_JiveIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;LoggerName&quot;/>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;FaultLog-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;'tim.now.bpmintegration.application'&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;'JiveWirelineAddressCertification'&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;'Call_Jive'&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:IDRichiestaNOW&quot;>&#xa;                    &lt;tns:BusinessID>&#xa;                        &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:IDRichiestaNOW&quot;/>&#xa;                    &lt;/tns:BusinessID>&#xa;                &lt;/xsl:if>&#xa;                &lt;tns:Message>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Errore Generico nella chiamata a Jive&amp;quot;&quot;/>&#xa;                &lt;/tns:Message>&#xa;                &lt;tns:Payload>&#xa;                    &lt;xsl:value-of select=&quot;tib:render-xml($FaultDetails, true(), true())&quot;/>&#xa;                &lt;/tns:Payload>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$LoggerName&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;'Error'&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:CallProcess
                                    moduleRef="tim.now.shared_library"
                                    spawn="true"
                                    subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                            </tibex:extActivity>
                        </bpws:extensionActivity>
                        <bpws:reply name="ReplyKO" operation="Call_Jive"
                            partnerLink="Call_Jive"
                            portType="ns1:Call_Jive"
                            tibex:xpdlId="b3e8b4ff-b267-4f85-acc6-abf516149115" variable="ReplyKO-input">
                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/VerificaIndirizzo_Jive/" xmlns:tns1="http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive" version="2.0"&gt;&lt;xsl:param name="FaultDetails"/&gt;&lt;xsl:template name="ReplyKO-input" match="/"&gt;&lt;tns:Call_JiveResponse&gt;&lt;parameters&gt;&lt;tns1:Response&gt;&lt;tns1:ESITO&gt;&lt;xsl:value-of select="&amp;quot;KO&amp;quot;"/&gt;&lt;/tns1:ESITO&gt;&lt;tns1:cod_Err&gt;&lt;xsl:value-of select="$FaultDetails/MsgCode"/&gt;&lt;/tns1:cod_Err&gt;&lt;tns1:desc_Err&gt;&lt;xsl:value-of select="$FaultDetails/Msg"/&gt;&lt;/tns1:desc_Err&gt;&lt;/tns1:Response&gt;&lt;/parameters&gt;&lt;/tns:Call_JiveResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
                                <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/VerificaIndirizzo_Jive/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;FaultDetails&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyKO-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;tns1:ESITO>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;            &lt;/tns1:ESITO>&#xa;            &lt;tns1:cod_Err>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;            &lt;/tns1:cod_Err>&#xa;            &lt;tns1:desc_Err>&#xa;                &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;            &lt;/tns1:desc_Err>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                            </tibex:inputBindings>
                            <bpws:targets>
                                <bpws:target linkName="FaultLogToReply"/>
                            </bpws:targets>
                            <bpws:correlations/>
                        </bpws:reply>
                    </bpws:flow>
                </bpws:scope>
            </bpws:catchAll>
        </bpws:faultHandlers>
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="DataRichiestaAssignToMapperJiveHeader" tibex:linkType="SUCCESS"/>
                <bpws:link name="InsertStagingTogetAddressVerifyRequest" tibex:linkType="SUCCESS"/>
                <bpws:link name="UpdateStagingToCall_JiveOut" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInputProcessToMapperJiveRequest" tibex:linkType="SUCCESS"/>
                <bpws:link name="Call_JiveInToLogInputProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperJiveRequestToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperJiveHeaderToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToDataRichiestaAssign" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallProcessToInsertStaging" tibex:linkType="SUCCESS"/>
                <bpws:link name="Log_false" tibex:label="false" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="Log_RispostaToCall_true"
                    tibex:label="true" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="getAddressVerifyRequestToLog_Risposta" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:receive createInstance="yes" name="Call_JiveIn"
                operation="Call_Jive" partnerLink="Call_Jive"
                portType="ns1:Call_Jive"
                tibex:xpdlId="8574bd4f-8f8c-4e48-8ac2-841c4b81e787" variable="Call_JiveIn">
                <bpws:sources>
                    <bpws:source linkName="Call_JiveInToLogInputProcess"/>
                </bpws:sources>
                <bpws:correlations/>
            </bpws:receive>
            <bpws:reply name="Call_JiveOut" operation="Call_Jive"
                partnerLink="Call_Jive" portType="ns1:Call_Jive"
                tibex:xpdlId="94746e60-65fb-4aad-be16-a6bc87174e22" variable="Call_JiveOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/VerificaIndirizzo_Jive/" xmlns:sm="http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19" xmlns:tns1="http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive" xmlns:cst="http://telecomitalia.it/SOA/WirelineAddressCertificationQueryCustomTypes/2016-04-19" xmlns:xsd="http://www.w3.org/2001/XMLSchema" version="2.0"&gt;
    &lt;xsl:param name="getAddressVerifyRequest"/&gt;
    &lt;xsl:template name="Call_JiveOut-input" match="/"&gt;
        &lt;tns:Call_JiveResponse&gt;
            &lt;parameters&gt;
                &lt;tns1:Response&gt;
                    &lt;tns1:ESITO&gt;
                        &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:ProcessData/sm:returnCode"/&gt;
                    &lt;/tns1:ESITO&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:ProcessData/sm:codeErr"&gt;
                        &lt;tns1:cod_Err&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:ProcessData/sm:codeErr"/&gt;
                        &lt;/tns1:cod_Err&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:ProcessData/sm:descErr"&gt;
                        &lt;tns1:desc_Err&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:ProcessData/sm:descErr"/&gt;
                        &lt;/tns1:desc_Err&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:ISTATProvinceCode"&gt;
                        &lt;tns1:INSTAT_PROV&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:ISTATProvinceCode"/&gt;
                        &lt;/tns1:INSTAT_PROV&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:provinceSigle"&gt;
                        &lt;tns1:SIGLA_PROV&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:provinceSigle"/&gt;
                        &lt;/tns1:SIGLA_PROV&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:province"&gt;
                        &lt;tns1:PROVINCIA&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:province"/&gt;
                        &lt;/tns1:PROVINCIA&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:ISTATCityCode"&gt;
                        &lt;tns1:INSTAT_COMUNE&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:ISTATCityCode"/&gt;
                        &lt;/tns1:INSTAT_COMUNE&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:district"&gt;
                        &lt;tns1:DISTRETTO&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:district"/&gt;
                        &lt;/tns1:DISTRETTO&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:locality"&gt;
                        &lt;tns1:DESC_LOCALITA&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:locality"/&gt;
                        &lt;/tns1:DESC_LOCALITA&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocalityCode"&gt;
                        &lt;tns1:COD_VIA&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocalityCode"/&gt;
                        &lt;/tns1:COD_VIA&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:streetType"&gt;
                        &lt;tns1:DESC_PART_TOPON&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:streetType"/&gt;
                        &lt;/tns1:DESC_PART_TOPON&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocality"&gt;
                        &lt;tns1:DESC_VIA&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocality"/&gt;
                        &lt;/tns1:DESC_VIA&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:streetNrFirst"&gt;
                        &lt;tns1:CIVICO&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:streetNrFirst"/&gt;
                        &lt;/tns1:CIVICO&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="count($getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:Central/cst:CLLI)&gt;0 and string-length($getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:Central[1]/cst:CLLI)&gt;0"&gt;
                            &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:Central[1]/cst:CLLI"&gt;
                                &lt;tns1:CCLI&gt;
                                    &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:Central[1]/cst:CLLI"/&gt;
                                &lt;/tns1:CCLI&gt;
                            &lt;/xsl:if&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise/&gt;
                    &lt;/xsl:choose&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:postcode"&gt;
                        &lt;tns1:CAP&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:postcode"/&gt;
                        &lt;/tns1:CAP&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:flagOPA"&gt;
                        &lt;tns1:FLAG_OPA&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:flagOPA"/&gt;
                        &lt;/tns1:FLAG_OPA&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:latitude"&gt;
                        &lt;tns1:LATITUDINE&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:latitude"/&gt;
                        &lt;/tns1:LATITUDINE&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:longitude"&gt;
                        &lt;tns1:LONGITUDINE&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:longitude"/&gt;
                        &lt;/tns1:LONGITUDINE&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:typeOfSource"&gt;
                        &lt;tns1:TIPO_FONTE&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:typeOfSource"/&gt;
                        &lt;/tns1:TIPO_FONTE&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:categoryType"&gt;
                        &lt;tns1:TIPO_CATEGORIA&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:categoryType"/&gt;
                        &lt;/tns1:TIPO_CATEGORIA&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:precision"&gt;
                        &lt;tns1:PRECISIONE&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:precision"/&gt;
                        &lt;/tns1:PRECISIONE&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:DR"&gt;
                        &lt;tns1:DR&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:GeographicLocation/cst:DR"/&gt;
                        &lt;/tns1:DR&gt;
                    &lt;/xsl:if&gt;
                    &lt;xsl:if test="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:publicRegStreetType"&gt;
                        &lt;tns1:CODICE_TOPONOMATICA&gt;
                            &lt;xsl:value-of select="$getAddressVerifyRequest/body/sm:getAddressVerifyResponse/sm:Address/cst:UrbanPropertyAddress/cst:publicRegStreetType"/&gt;
                        &lt;/tns1:CODICE_TOPONOMATICA&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns1:Response&gt;
            &lt;/parameters&gt;
        &lt;/tns:Call_JiveResponse&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/VerificaIndirizzo_Jive/&quot; xmlns:sm=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQueryCustomTypes/2016-04-19&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;getAddressVerifyRequest.body&quot;/>&#xa;    &lt;xsl:template name=&quot;Call_JiveOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Response>&#xa;            &lt;tns1:ESITO>&#xa;                &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:ProcessData/sm:returnCode&quot;/>&#xa;            &lt;/tns1:ESITO>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:ProcessData/sm:codeErr&quot;>&#xa;                &lt;tns1:cod_Err>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:ProcessData/sm:codeErr&quot;/>&#xa;                &lt;/tns1:cod_Err>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:ProcessData/sm:descErr&quot;>&#xa;                &lt;tns1:desc_Err>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:ProcessData/sm:descErr&quot;/>&#xa;                &lt;/tns1:desc_Err>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:ISTATProvinceCode&quot;>&#xa;                &lt;tns1:INSTAT_PROV>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:ISTATProvinceCode&quot;/>&#xa;                &lt;/tns1:INSTAT_PROV>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:provinceSigle&quot;>&#xa;                &lt;tns1:SIGLA_PROV>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:provinceSigle&quot;/>&#xa;                &lt;/tns1:SIGLA_PROV>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:province&quot;>&#xa;                &lt;tns1:PROVINCIA>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:province&quot;/>&#xa;                &lt;/tns1:PROVINCIA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:ISTATCityCode&quot;>&#xa;                &lt;tns1:INSTAT_COMUNE>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:ISTATCityCode&quot;/>&#xa;                &lt;/tns1:INSTAT_COMUNE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:district&quot;>&#xa;                &lt;tns1:DISTRETTO>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:district&quot;/>&#xa;                &lt;/tns1:DISTRETTO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:locality&quot;>&#xa;                &lt;tns1:DESC_LOCALITA>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:locality&quot;/>&#xa;                &lt;/tns1:DESC_LOCALITA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocalityCode&quot;>&#xa;                &lt;tns1:COD_VIA>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocalityCode&quot;/>&#xa;                &lt;/tns1:COD_VIA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:streetType&quot;>&#xa;                &lt;tns1:DESC_PART_TOPON>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:streetType&quot;/>&#xa;                &lt;/tns1:DESC_PART_TOPON>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocality&quot;>&#xa;                &lt;tns1:DESC_VIA>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:addressOrLocality&quot;/>&#xa;                &lt;/tns1:DESC_VIA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:streetNrFirst&quot;>&#xa;                &lt;tns1:CIVICO>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:streetNrFirst&quot;/>&#xa;                &lt;/tns1:CIVICO>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:Central/cst:CLLI)>0 and string-length($getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:Central[1]/cst:CLLI)>0&quot;>&#xa;                    &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:Central[1]/cst:CLLI&quot;>&#xa;                        &lt;tns1:CCLI>&#xa;                            &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:Central[1]/cst:CLLI&quot;/>&#xa;                        &lt;/tns1:CCLI>&#xa;                    &lt;/xsl:if>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:postcode&quot;>&#xa;                &lt;tns1:CAP>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:postcode&quot;/>&#xa;                &lt;/tns1:CAP>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:flagOPA&quot;>&#xa;                &lt;tns1:FLAG_OPA>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:flagOPA&quot;/>&#xa;                &lt;/tns1:FLAG_OPA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:latitude&quot;>&#xa;                &lt;tns1:LATITUDINE>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:latitude&quot;/>&#xa;                &lt;/tns1:LATITUDINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:longitude&quot;>&#xa;                &lt;tns1:LONGITUDINE>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:longitude&quot;/>&#xa;                &lt;/tns1:LONGITUDINE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:typeOfSource&quot;>&#xa;                &lt;tns1:TIPO_FONTE>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:typeOfSource&quot;/>&#xa;                &lt;/tns1:TIPO_FONTE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:categoryType&quot;>&#xa;                &lt;tns1:TIPO_CATEGORIA>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:categoryType&quot;/>&#xa;                &lt;/tns1:TIPO_CATEGORIA>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:precision&quot;>&#xa;                &lt;tns1:PRECISIONE>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:precision&quot;/>&#xa;                &lt;/tns1:PRECISIONE>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:DR&quot;>&#xa;                &lt;tns1:DR>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:GeographicLocation/cst:DR&quot;/>&#xa;                &lt;/tns1:DR>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:publicRegStreetType&quot;>&#xa;                &lt;tns1:CODICE_TOPONOMATICA>&#xa;                    &lt;xsl:value-of select=&quot;$getAddressVerifyRequest.body/sm:Address/cst:UrbanPropertyAddress/cst:publicRegStreetType&quot;/>&#xa;                &lt;/tns1:CODICE_TOPONOMATICA>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns1:Response>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
