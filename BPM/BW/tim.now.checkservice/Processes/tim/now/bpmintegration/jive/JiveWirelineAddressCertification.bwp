                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DataRichiesta&quot;/>&lt;xsl:param name=&quot;_processContext&quot;/>&lt;xsl:param name=&quot;Call_JiveIn&quot;/>&lt;xsl:template name=&quot;MapperJiveHeader-input&quot; match=&quot;/&quot;>&lt;tns:Header>&lt;tns:sourceSystem>&lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&lt;/tns:sourceSystem>&lt;tns:interactionDate>&lt;tns:Date>&lt;xsl:value-of select=&quot;format-dateTime($DataRichiesta, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&lt;/tns:Date>&lt;tns:Time>&lt;xsl:value-of select=&quot;format-dateTime($DataRichiesta, &amp;quot;[H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/tns:Time>&lt;/tns:interactionDate>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:CodiceOrdineOLO&quot;>&lt;tns:businessID>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:CodiceOrdineOLO&quot;/>&lt;/tns:businessID>&lt;/xsl:if>&lt;tns:transactionID>&lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&lt;/tns:transactionID>&lt;/tns:Header>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="MapperJiveHeader-input"
                    name="MapperJiveHeader"
                    outputVariable="MapperJiveHeader"
                    tibex:xpdlId="1521d175-ff8a-4872-9c2a-a57fd48daded" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
