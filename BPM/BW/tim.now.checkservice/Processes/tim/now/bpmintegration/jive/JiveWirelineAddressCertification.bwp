            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQuery/2016-04-19&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:cst=&quot;http://telecomitalia.it/SOA/WirelineAddressCertificationQueryCustomTypes/2016-04-19&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Call_JiveIn&quot;/>&lt;xsl:template name=&quot;MapperJiveRequest-input&quot; match=&quot;/&quot;>&lt;tns:getAddressVerifyRequest>&lt;tns:PlacePartyRoleAssoc>&lt;cst:UrbanPropertyAddress>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Codice/tns1:CODICE_TOPONOMASTICA) >0&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Codice/tns1:CODICE_TOPONOMASTICA&quot;>&lt;cst:publicRegStreetTypeCode>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Codice/tns1:CODICE_TOPONOMASTICA&quot;/>&lt;/cst:publicRegStreetTypeCode>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_PART_TOPON) > 0&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_PART_TOPON&quot;>&lt;cst:streetType>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_PART_TOPON&quot;/>&lt;/cst:streetType>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_VIA) > 0&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_VIA&quot;>&lt;cst:addressOrLocality>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_VIA&quot;/>&lt;/cst:addressOrLocality>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_LOCALITA) > 0&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_LOCALITA&quot;>&lt;cst:locality>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:DESC_LOCALITA&quot;/>&lt;/cst:locality>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:CAP) > 0&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:CAP&quot;>&lt;cst:postcode>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:CAP&quot;/>&lt;/cst:postcode>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:CIVICO) > 0&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:CIVICO&quot;>&lt;cst:streetNrFirst>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:CIVICO&quot;/>&lt;/cst:streetNrFirst>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/cst:UrbanPropertyAddress>&lt;cst:GeographicLocation>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:PROVINCIA) > 0&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:PROVINCIA&quot;>&lt;cst:province>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:PROVINCIA&quot;/>&lt;/cst:province>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:ISTAT_COMUNE) > 0 and string-length($Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:ISTAT_COMUNE) &amp;lt; 7&quot;>&lt;xsl:if test=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:ISTAT_COMUNE&quot;>&lt;cst:ISTATCityCode>&lt;xsl:value-of select=&quot;$Call_JiveIn/parameters/tns1:Request/tns1:Indirizzo/tns1:ISTAT_COMUNE&quot;/>&lt;/cst:ISTATCityCode>&lt;/xsl:if>&lt;/xsl:when>&lt;xsl:otherwise/>&lt;/xsl:choose>&lt;/cst:GeographicLocation>&lt;/tns:PlacePartyRoleAssoc>&lt;/tns:getAddressVerifyRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
