                                <bindingType style="DOCUMENT"/>
                                <operationConfiguration
                                    action="InsertUpdateStaging" operationName="InsertUpdateStaging">
                                    <bindingType style="DOCUMENT"/>
                                    <messageConfiguration
                                    messageQName="pt:InsertUpdateStagingRequest" wsdlLocation="platform:/resource/tim.now.shared_library/Service%20Descriptors/LogProcess/InsertUpdateStaging.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
                                    partElementName="InsertUpdateStaging:StagingRequest"
                                    partName="REQUEST" xsi:type="axis2:BodyPartConfiguration"/>
                                    </messageConfiguration>
                                    <messageConfiguration
                                    messageDirection="OUTPUT"
                                    messageQName="pt:InsertUpdateStagingResponse" wsdlLocation="platform:/resource/tim.now.shared_library/Service%20Descriptors/LogProcess/InsertUpdateStaging.wsdl">
                                    <messagePartConfigurations
                                    encoding="literal"
