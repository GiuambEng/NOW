                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://telecomitalia.it/SOA/SOAP/SOAPHeader&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/VerificaIndirizzo_Jive&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_JiveIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;DataRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperJiveHeader-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Header>&#xa;            &lt;tns:sourceSystem>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;NOW&amp;quot;&quot;/>&#xa;            &lt;/tns:sourceSystem>&#xa;            &lt;tns:interactionDate>&#xa;                &lt;tns:Date>&#xa;                    &lt;xsl:value-of select=&quot;format-dateTime($DataRichiesta, &amp;quot;[Y0001]-[M01]-[D01]&amp;quot;)&quot;/>&#xa;                &lt;/tns:Date>&#xa;                &lt;tns:Time>&#xa;                    &lt;xsl:value-of select=&quot;format-dateTime($DataRichiesta, &amp;quot;[H01]:[m01]:[s01]&amp;quot;)&quot;/>&#xa;                &lt;/tns:Time>&#xa;            &lt;/tns:interactionDate>&#xa;            &lt;xsl:if test=&quot;$Call_JiveIn.parameters/tns1:CodiceOrdineOLO&quot;>&#xa;                &lt;tns:businessID>&#xa;                    &lt;xsl:value-of select=&quot;$Call_JiveIn.parameters/tns1:CodiceOrdineOLO&quot;/>&#xa;                &lt;/tns:businessID>&#xa;            &lt;/xsl:if>&#xa;            &lt;tns:transactionID>&#xa;                &lt;xsl:value-of select=&quot;concat($_processContext/ProcessInstanceId, string(tib:timestamp()))&quot;/>&#xa;            &lt;/tns:transactionID>&#xa;        &lt;/tns:Header>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:SOAPHeader="http://telecomitalia.it/SOA/SOAP/SOAPHeader"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
