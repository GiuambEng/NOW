                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/RecuperaTipoNumeroTipoServizio/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio&quot; xmlns:ns=&quot;http://www.tim.com/NOW/xsd/OscuraFunzione/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallOscuraFunzione&quot;/>&#xa;    &lt;xsl:param name=&quot;Accumulate&quot;/>&#xa;    &lt;xsl:template name=&quot;RecuperaTipoNumeroTipoServizioOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:RecuperaTipoNumTipoServOut>&#xa;            &lt;xsl:copy-of select=&quot;$Accumulate/tns1:RecuperaTipoNumTipoServOut/tns1:RecuperaTipoNumOutput&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$CallOscuraFunzione/ns:Abilitato = false()&quot;>&#xa;                    &lt;tns1:Oscurato>&#xa;                        &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                    &lt;/tns1:Oscurato>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:Oscurato>&#xa;                        &lt;xsl:value-of select=&quot;$Accumulate/tns1:RecuperaTipoNumTipoServOut[1]/tns1:Oscurato&quot;/>&#xa;                    &lt;/tns1:Oscurato>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns1:RecuperaTipoNumTipoServOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallProcess1ToEnd"/>
                    <bpws:target linkName="CallProcess1ToEnd1"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:reply faultName="fault" name="ReplyFault"
                operation="RecuperaTipoNumeroTipoServizio"
                partnerLink="RecuperaTipoNumeroTipoServizio"
                portType="ns1:RecuperaTipoNumeroTipoServizio"
                tibex:xpdlId="d23d38d4-7af8-4e92-bddc-f0228e5747dd" variable="ReplyFault-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/RecuperaTipoNumeroTipoServizio/" xmlns:tns1="http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio" xmlns:tns2="http://www.tim.now/xsd/UnicacGetDatiInventory" version="2.0"&gt;&lt;xsl:param name="_error"/&gt;&lt;xsl:template name="ReplyFault-input" match="/"&gt;&lt;tns:RecuperaTipoNumeroTipoServizioFault&gt;&lt;parameters&gt;&lt;tns1:Fault&gt;&lt;tns1:Esito&gt;&lt;xsl:value-of select="$_error/MsgCode"/&gt;&lt;/tns1:Esito&gt;&lt;tns1:Messaggio&gt;&lt;xsl:value-of select="$_error/Msg"/&gt;&lt;/tns1:Messaggio&gt;&lt;/tns1:Fault&gt;&lt;/parameters&gt;&lt;/tns:RecuperaTipoNumeroTipoServizioFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/wsdl/abstract/RecuperaTipoNumeroTipoServizio/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;ReplyFault-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:Fault>&#xa;            &lt;tns1:Esito>&#xa;                &lt;xsl:value-of select=&quot;$_error/MsgCode&quot;/>&#xa;            &lt;/tns1:Esito>&#xa;            &lt;tns1:Messaggio>&#xa;                &lt;xsl:value-of select=&quot;$_error/Msg&quot;/>&#xa;            &lt;/tns1:Messaggio>&#xa;        &lt;/tns1:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="WhileToReplyFault"/>
                </bpws:targets>
            </bpws:reply>
            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="e3396152-8500-4da7-a3de-a198b6811cdf">
                <bpws:targets>
                    <bpws:target linkName="CallProcessToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToReplyFault"
                        tibex:faultDetailsVar="InvokeUnicaGet" tibex:faultNameVar="FaultName">
                        <tibex:DesignExpression>
                            <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="WhileToEnd"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+57153fb0-e3fe-49d2-855b-c5a5a25043ff" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="number($index)&lt;=count($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[number($index)<=count($Input.parameters/tns:NumeroTelefonicoNP)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link
                                    name="InvokeUnicaGetToGroupEnd" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToInvokeUnicaGet" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="CallProcessToInvokeUnicaGet" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="GroupStartToAssignCalcolaDistretto" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="b6a376a4-813e-4754-a1d4-6fbc579750cc">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToAssignCalcolaDistretto"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="57153fb0-e3fe-49d2-855b-c5a5a25043ff" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:invoke
                                inputVariable="InvokeUnicaGet-input"
                                name="InvokeUnicaGet"
                                operation="UnicacGetDatiInventory"
                                outputVariable="InvokeUnicaGet"
                                partnerLink="UnicacGetDatiInventory"
                                portType="ns2:UnicacGetDatiInventoryPortType" tibex:xpdlId="562efe91-bd6c-4f17-a4cf-47b1e755114a">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio" xmlns:tns1="http://www.tibco.com/UnicacGetDatiInventory/" xmlns:tns2="http://www.tim.now/xsd/UnicacGetDatiInventory" version="2.0"&gt;&lt;xsl:param name="Input"/&gt;&lt;xsl:param name="Distretto"/&gt;&lt;xsl:param name="index"/&gt;&lt;xsl:template name="InvokeUnicaGet-input" match="/"&gt;&lt;tns1:UnicacGetDatiInventoryRequest&gt;&lt;Input&gt;&lt;tns2:REQUEST&gt;&lt;tns2:IdRichiestaOLO&gt;&lt;xsl:value-of select="$Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:IdRichiestaOLO"/&gt;&lt;/tns2:IdRichiestaOLO&gt;&lt;tns2:DN&gt;&lt;xsl:value-of select="$Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico"/&gt;&lt;/tns2:DN&gt;&lt;tns2:distretto&gt;&lt;xsl:value-of select="$Distretto"/&gt;&lt;/tns2:distretto&gt;&lt;/tns2:REQUEST&gt;&lt;/Input&gt;&lt;/tns1:UnicacGetDatiInventoryRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio&quot; xmlns:tns1=&quot;http://www.tibco.com/UnicacGetDatiInventory/&quot; xmlns:tns2=&quot;http://www.tim.now/xsd/UnicacGetDatiInventory&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Input.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;Distretto&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeUnicaGet-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:REQUEST>&#xa;            &lt;tns2:IdRichiestaOLO>&#xa;                &lt;xsl:value-of select=&quot;$Input.parameters/tns:IdRichiestaOLO&quot;/>&#xa;            &lt;/tns2:IdRichiestaOLO>&#xa;            &lt;tns2:DN>&#xa;                &lt;xsl:value-of select=&quot;$Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico&quot;/>&#xa;            &lt;/tns2:DN>&#xa;            &lt;tns2:distretto>&#xa;                &lt;xsl:value-of select=&quot;$Distretto&quot;/>&#xa;            &lt;/tns2:distretto>&#xa;        &lt;/tns2:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessToInvokeUnicaGet"/>
                                </bpws:targets>
                                <bpws:sources>
                                    <bpws:source linkName="InvokeUnicaGetToGroupEnd">
                                    <tibex:DesignExpression/>
                                    </bpws:source>
                                </bpws:sources>
                            </bpws:invoke>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="if (string-length($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico) > 0) then if (substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 2, 1) = &quot;6&quot; or substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 2, 1) = &quot;2&quot;) then substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 1, 2) else if (substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;0&quot; or substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;1&quot; or substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;5&quot; or substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;9&quot;) then substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 1, 3) else substring($Input/parameters/tns:RecuperaTipoNumTipoServIn/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 1, 4) else &quot;00&quot;"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                                    inputVariable="Distretto"
                                    name="AssignCalcolaDistretto"
                                    outputVariable="Distretto"
                                    tibex:xpdlId="8aff5faf-2c8a-41e8-9315-dcc4d14133f9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToAssignCalcolaDistretto"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="AssignToInvokeUnicaGet"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="if (string-length($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico) > 0) then if (substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 2, 1) = &quot;6&quot; or substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 2, 1) = &quot;2&quot;) then substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 1, 2) else if (substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;0&quot; or substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;1&quot; or substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;5&quot; or substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 3, 1) = &quot;9&quot;) then substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 1, 3) else substring($Input.parameters/tns:NumeroTelefonicoNP[number($index)]/tns:NumeroTelefonico, 1, 4) else &quot;00&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="Distretto" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Input&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutAssignCalcolaDistretto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaTipoNumeroTipoServizioI&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaTipoNumeroTipoServizio_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaTipoNumeroTipoServizio&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Input/parameters/tns2:RecuperaTipoNumTipoServIn/tns2:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LogOutAssignDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:MsgCode>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;                &lt;tns:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns:LogLevel>&#xa;                &lt;tns:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                &lt;/tns:LogJMS>&#xa;            &lt;/tns:GenericLogger>&#xa;            &lt;tns:ActiveLoggerServices>&#xa;                &lt;tns:Envelope>&#xa;                    &lt;tns:Identifier>&#xa;                        &lt;tns:ServiceName>&#xa;                            &lt;xsl:value-of select=&quot;'tim.now.checkservice.bpm_checkNp'&quot;/>&#xa;                        &lt;/tns:ServiceName>&#xa;                        &lt;tns:Operation>&#xa;                            &lt;xsl:value-of select=&quot;'InterrogazioneInventory'&quot;/>&#xa;                        &lt;/tns:Operation>&#xa;                        &lt;tns:BusinessID>&#xa;                            &lt;xsl:value-of select=&quot;$Input/parameters/tns2:RecuperaTipoNumTipoServIn/tns2:IdRichiestaOLO&quot;/>&#xa;                        &lt;/tns:BusinessID>&#xa;                        &lt;tns:EventType>&#xa;                            &lt;xsl:value-of select=&quot;'InterrogazioneInventory_SUB-PROCESS'&quot;/>&#xa;                        &lt;/tns:EventType>&#xa;                        &lt;tns:trackID>&#xa;                            &lt;xsl:value-of select=&quot;concat(&amp;quot;RecuperaTipoNumeroTipoServizio_&amp;quot;, $Input/parameters/tns2:RecuperaTipoNumTipoServIn/tns2:IdRichiestaOLO)&quot;/>&#xa;                        &lt;/tns:trackID>&#xa;                    &lt;/tns:Identifier>&#xa;                    &lt;tns:track_position>&#xa;                        &lt;xsl:value-of select=&quot;'IN'&quot;/>&#xa;                    &lt;/tns:track_position>&#xa;                    &lt;tns:Timestamp>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogOutAssignCalcolaDistretto-input"
                                    name="LogOutAssignCalcolaDistretto"
                                    tibex:xpdlId="44e8f7a4-0b40-44e2-8008-87f7a1c754d2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="AssignToInvokeUnicaGet"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallProcessToInvokeUnicaGet"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/RecuperaTipoNumeroTipoServizio&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Input.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:template name=&quot;LogOutAssignCalcolaDistretto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:CW_BUS_MESSAGE>&#xa;            &lt;tns:GenericLogger>&#xa;                &lt;tns:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns:Application>&#xa;                &lt;tns:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaTipoNumeroTipoServizioI&amp;quot;&quot;/>&#xa;                &lt;/tns:Process>&#xa;                &lt;tns:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaTipoNumeroTipoServizio_PortType&amp;quot;&quot;/>&#xa;                &lt;/tns:Service>&#xa;                &lt;tns:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;RecuperaTipoNumeroTipoServizio&amp;quot;&quot;/>&#xa;                &lt;/tns:Operation>&#xa;                &lt;tns:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$Input.parameters/tns2:IdRichiestaOLO&quot;/>&#xa;                &lt;/tns:BusinessID>&#xa;                &lt;tns:MsgCode>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;LogOutAssignDistretto&amp;quot;&quot;/>&#xa;                &lt;/tns:MsgCode>&#xa;                &lt;tns:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns:LoggerName>&#xa;        