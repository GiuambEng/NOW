                       &lt;/tns:Tipo_Portabilita>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:RecuperaTipoNumOutput>&#xa;            &lt;tns:Oscurato>&#xa;                &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;            &lt;/tns:Oscurato>&#xa;        &lt;/tns:RecuperaTipoNumTipoServOut>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
