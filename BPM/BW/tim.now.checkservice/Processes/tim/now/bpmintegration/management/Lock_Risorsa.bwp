                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;_error&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Fault>&#xa;            &lt;tns:Messaggio_Errore>&#xa;                &lt;xsl:value-of select=&quot;tib:render-xml($_error)&quot;/>&#xa;            &lt;/tns:Messaggio_Errore>&#xa;            &lt;tns:Codice_Errore>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;InputValidation.&amp;quot;&quot;/>&#xa;            &lt;/tns:Codice_Errore>&#xa;        &lt;/tns:Fault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
