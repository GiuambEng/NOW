                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$Lock/tns:Esito/tns:Codice='00' and $Lock/tns:Esito/tns:Descrizione='Ricarica lavorabile' and $Lock/tns:Esito/tns:Esito=true() and $TipoRichiesta = &quot;RICARICA&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$Lock/tns:Esito/tns:Codice='00' and $Lock/tns:Esito/tns:Descrizione='Ricarica lavorabile' and $Lock/tns:Esito/tns:Esito=true() and $TipoRichiesta = "RICARICA"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock_Unlock.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectFromAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;StatoAsset&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRichiestaOld&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCAssetTarget&quot;/>&#xa;    &lt;xsl:param name=&quot;TipoRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRichiestaOldCorrelato&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCAssetTargetCorrelato&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRichiestaCorrelato&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectFromAssetCorrelato&quot;/>&#xa;    &lt;xsl:param name=&quot;VerificaStatoAggiuntivo&quot;/>&#xa;    &lt;xsl:template name=&quot;Lock&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;xsl:variable name=&quot;StatoAsset&quot; select=&quot;if(exists($SelectFromAsset/Record[./STATOASSET='ATTIVO'])) then 'ATTIVO' else if(exists($SelectFromAsset/Record[./STATOASSET='INLAVORAZIONE'])) then 'INLAVORAZIONE' else 'CESSATO'&quot;/>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTargetCorrelato/Record[1]/LAVORAZIONE='CESSAZIONE' or $SelectRichiestaCorrelato/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot; or $SelectRichiestaOldCorrelato/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot;) and starts-with($SelectFromAssetCorrelato/Record[1]/OFFERTA, &amp;quot;WLR&amp;quot;)&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Risorsa lavorabile'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$TipoRichiesta = &amp;quot;RICARICA&amp;quot;and count($SelectFromAsset/Record[STATOASSET =(&amp;quot;INLAVORAZIONE&amp;quot;, &amp;quot;CESSATO&amp;quot;)]) = 0&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Ricarica lavorabile'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='MIGRAZIONE' or $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot;)&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Migrazione in corso'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = (&amp;quot;INLAVORAZIONE&amp;quot;,&amp;quot;CESSATO&amp;quot;) and ($JDBCAssetTarget/Record[1]/OFFERTA='NP' or $SelectRichiesta/Record[1]/OFFERTA = &amp;quot;NP&amp;quot; or $SelectRichiestaOld/Record[1]/OFFERTA = &amp;quot;NP&amp;quot;) and string-length($Lock_Unlock.Input/tns:IdDettaglioAsset)>0&quot;>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;count($VerificaStatoAggiuntivo/Record)=0&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;'11'&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'Risorsa non esistente'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                                &lt;tns:Esito>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Esito>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;$VerificaStatoAggiuntivo/Record[1]/STATODETTAGLIOASSET='INLAVORAZIONE'&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;'01'&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'NP in corso'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                                &lt;tns:Esito>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Esito>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;'10'&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;'Risorsa cessata'&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                                &lt;tns:Esito>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Esito>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/OFFERTA='NP' or $SelectRichiesta/Record[1]/OFFERTA = &amp;quot;NP&amp;quot; or $SelectRichiestaOld/Record[1]/OFFERTA = &amp;quot;NP&amp;quot;)&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'NP in corso'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='ATTIVAZIONE' or $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;ATTIVAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;04&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Attivazione in corso'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='CESSAZIONE' or $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot;)&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Cessazione in corso'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='VARIAZIONE' or  $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;VARIAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;VARIAZIONE&amp;quot;)&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;05&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Variazione in corso'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;ATTIVO&amp;quot; and $Lock_Unlock.Input/tns:CODIFICA_OLO_AGICOM = &amp;quot;TLC&amp;quot;&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Risorsa lavorabile'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$StatoAsset = &amp;quot;CESSATO&amp;quot;&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Risorsa cessata'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;count($SelectFromAsset/Record)=0&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;11&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Risorsa non esistente'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;99&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'Errore tecnico'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
