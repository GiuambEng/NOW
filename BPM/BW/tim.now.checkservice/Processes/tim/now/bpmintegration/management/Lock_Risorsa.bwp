                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="select count (*) as conteggio&#xa;from oscuramento_agesp oa&#xa;where oa.cod_agesp = 'R58-23-2042' and oa.flag_oscurmento in ('1','Y')" xsi:type="jdbcPalette:JDBCQueryActivity">
