                                    <bpws:sources>
                                    <bpws:source linkName="Assign_IdRichOrdineToReply1"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeCheckOrdineInCorso.Output&quot;/>&#xa;    &lt;xsl:param name=&quot;Lock&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCAssetTarget&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRichiesta&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectRichiestaOld&quot;/>&#xa;    &lt;xsl:template name=&quot;Lock&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;tns:Esito>&#xa;                &lt;tns:Codice>&#xa;                    &lt;xsl:value-of select=&quot;$Lock/tns:Esito/tns:Codice&quot;/>&#xa;                &lt;/tns:Codice>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($JDBCAssetTarget/Record) > 0&quot;>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;$JDBCAssetTarget/Record[1]/IDRICHIESTAOLO&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($SelectRichiesta/Record) > 0&quot;>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;$SelectRichiesta/Record[1]/IDRICHIESTAOLO&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:when test=&quot;count($SelectRichiestaOld/Record) > 0&quot;>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;$SelectRichiestaOld/Record[1]/IDRICHIESTAOLO&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso.Output/tns1:ID_ORDINE&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:Esito>&#xa;                    &lt;xsl:value-of select=&quot;$Lock/tns:Esito/tns:Esito&quot;/>&#xa;                &lt;/tns:Esito>&#xa;            &lt;/tns:Esito>&#xa;        &lt;/tns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
