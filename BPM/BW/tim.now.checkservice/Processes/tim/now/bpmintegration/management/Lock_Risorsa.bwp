                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;InvokeCheckOrdineInCorso.Output&quot;/>&#xa;    &lt;xsl:template name=&quot;Lock&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso.Output/tns1:RETURN_CODE = &amp;quot;00&amp;quot;&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso.Output/tns1:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso.Output/tns1:RETURN_CODE = &amp;quot;01&amp;quot;&quot;>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso.Output/tns1:RETURN_CODE&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;NP in Corso&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Esito>&#xa;           