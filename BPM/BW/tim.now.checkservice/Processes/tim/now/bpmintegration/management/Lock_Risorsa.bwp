                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;SelectAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;Lock&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;tns:Esito>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectAsset/Record) > 0 and $SelectAsset/Record[1]/OFFERTA = &amp;quot;NP&amp;quot;&quot;>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;99&amp;quot;&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;tns:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                &lt;/tns:Descrizione>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelectAsset/Record) > 0 and $SelectAsset/Record[1]/OFFERTA = &amp;quot;NP&amp;quot;&quot;>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Esito>&#xa;                            &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                        &lt;/tns:Esito>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/tns:Esito>&#xa;        &lt;/tns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
