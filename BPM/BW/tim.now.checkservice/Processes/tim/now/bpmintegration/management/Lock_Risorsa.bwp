                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Lock_Unlock&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:param name=&quot;Oscuramento&quot;/>&lt;xsl:template name=&quot;GenericLogger-input&quot; match=&quot;/&quot;>&lt;tns2:CW_BUS_MESSAGE>&lt;tns2:GenericLogger>&lt;tns2:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns2:Application>&lt;tns2:Process>&lt;xsl:value-of select=&quot;&amp;quot;Lock_Risorsa&amp;quot;&quot;/>&lt;/tns2:Process>&lt;tns2:Service>&lt;xsl:value-of select=&quot;&amp;quot;LockPortType&amp;quot;&quot;/>&lt;/tns2:Service>&lt;tns2:Operation>&lt;xsl:value-of select=&quot;&amp;quot;Lock_Unlock&amp;quot;&quot;/>&lt;/tns2:Operation>&lt;xsl:if test=&quot;$Lock_Unlock/Input/tns:Input/tns:ID_RICH_OLO&quot;>&lt;tns2:BusinessID>&lt;xsl:value-of select=&quot;$Lock_Unlock/Input/tns:Input/tns:ID_RICH_OLO&quot;/>&lt;/tns2:BusinessID>&lt;/xsl:if>&lt;xsl:choose>&lt;xsl:when test=&quot;$Oscuramento/Record[1]/CONTEGGIO=0&quot;>&lt;tns2:Message>&lt;xsl:value-of select=&quot;&amp;quot;Disoscurato&amp;quot; &quot;/>&lt;/tns2:Message>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns2:Message>&lt;xsl:value-of select=&quot;&amp;quot;Oscurato&amp;quot;&quot;/>&lt;/tns2:Message>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns2:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns2:LoggerName>&lt;tns2:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns2:LogLevel>&lt;tns2:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns2:LogJMS>&lt;/tns2:GenericLogger>&lt;/tns2:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
