                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+98e65368-8853-4bc9-a81d-eba6a5b1ff3c+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock_Unlock.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectFromAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectRichiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Lock_Unlock.Input/tns:ID_RICH_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Lock_Unlock.Input/tns:ID_RICH_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectFromAsset/Record[1]/IDRISORSA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($SelectFromAsset/Record[1]/IDRISORSA, 'W')&quot;>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($SelectFromAsset/Record[1]/IDRISORSA, 'W'))&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectFromAsset/Record[1]/IDRISORSA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($SelectFromAsset/Record[1]/IDRISORSA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDRISORSA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($SelectFromAsset/Record[1]/IDRISORSA, 'W')&quot;>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($SelectFromAsset/Record[1]/IDRISORSA, 'W'))&quot;/>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectFromAsset/Record[1]/IDRISORSA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($SelectFromAsset/Record[1]/IDRISORSA, 'W')&quot;>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($SelectFromAsset/Record[1]/IDRISORSA, 'W'))&quot;/>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectFromAsset/Record[1]/IDRISORSA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($SelectFromAsset/Record[1]/IDRISORSA, 'W')&quot;>&#xa;                    &lt;CODICERISORSADONATING1>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($SelectFromAsset/Record[1]/IDRISORSA, 'W'))&quot;/>&#xa;                    &lt;/CODICERISORSADONATING1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICERISORSADONATING1>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectFromAsset/Record[1]/IDRISORSA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICERISORSADONATING1>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($SelectFromAsset/Record[1]/IDRISORSA, 'W')&quot;>&#xa;                    &lt;CODICERISORSADONATING2>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($SelectFromAsset/Record[1]/IDRISORSA, 'W'))&quot;/>&#xa;                    &lt;/CODICERISORSADONATING2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICERISORSADONATING2>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($SelectFromAsset/Record[1]/IDRISORSA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/CODICERISORSADONATING2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RICH.IDRISORSA,&#xa;       RICH.NUMEROTELEFONICO,&#xa;       RICH.STATORICHIESTAOLO,&#xa;       RICH.STATORICHIESTANOW,&#xa;       RICH.LAVORAZIONE,&#xa;       RICH.OFFERTA,&#xa;       RICH.IDRICHIESTAOLO&#xa;FROM BDS_1_CASEDATA_RICHIESTA RICH&#xa;WHERE RICH.STATORICHIESTANOW NOT IN &#xa; ('CHIUSO',&#xa;  'SCARTATO',&#xa;  'ANNULLATO',&#xa;  'FATTURAZIONEKO',&#xa;  'INVIATOAFATTURAZIONE',&#xa;  'ESPLETAMENTOTECNICOKO',&#xa;  'ESPLETATOOKCONSUNTIVO')&#xa;  AND RICH.IDRICHIESTAOLO &lt;> ?&#xa;  AND EXISTS &#xa;  (SELECT 1 FROM BDS_1_CASEDATA_ORDINE WHERE RICH.BDS_ID = RICHIESTA_ORDINE_BDSID AND IDRISORSA = ?&#xa;    UNION ALL&#xa;    SELECT 1 FROM BDS_1_CASEDATA_ORDINE WHERE RICH.BDS_ID = RICHIESTA_ORDINE_BDSID AND NUMEROFITTIZIO = ?&#xa;    UNION ALL&#xa;    SELECT 1 FROM BDS_1_CASEDATA_RICHIESTA WHERE RICH.BDS_ID = BDS_ID AND IDRISORSA = ?&#xa;    UNION ALL&#xa;    SELECT 1 FROM BDS_1_CASEDATA_RICHIESTA WHERE RICH.BDS_ID = BDS_ID AND NUMEROTELEFONICO = ?&#xa;    UNION ALL&#xa;    SELECT 1 FROM BDS_1_CASEDATA_ORDINE WHERE RICH.BDS_ID = RICHIESTA_ORDINE_BDSID AND NUMEROTELEFONICO = ?&#xa;    UNION ALL&#xa;    SELECT 1 FROM BDS_1_CASEDATA_RICHIESTA WHERE RICH.BDS_ID = BDS_ID AND CODICERISORSADONATING = ?&#xa;    UNION ALL&#xa;    SELECT 1 FROM BDS_1_CASEDATA_RICHIESTA WHERE RICH.BDS_ID = BDS_ID AND CODICERISORSADONATING2 = ?&#xa;    )&#xa;ORDER BY RICH.CREATED DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICERISORSADONATING1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICERISORSADONATING2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTAOLO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="STATORICHIESTANOW"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="LAVORAZIONE"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+953a99d1-ebef-47af-aeb4-1ea7786b0815+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock_Unlock&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IDASSET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Lock_Unlock/Input/tns:Input/tns:IdAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Lock_Unlock/Input/tns:Input/tns:IdAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDASSET>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectAsset-input"
                                    name="SelectAsset"
                                    outputVariable="SelectAsset"
                                    tibex:xpdlId="953a99d1-ebef-47af-aeb4-1ea7786b0815" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LOG_UNLOCK"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQueryToJDBCUpdate">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($SelectAsset/Record) > 0 and $SelectAsset/Record[1]/OFFERTA != &quot;NP&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($SelectAsset/Record) > 0 and $SelectAsset/Record[1]/OFFERTA != "NP"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBCQueryToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+953a99d1-ebef-47af-aeb4-1ea7786b0815+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock_Unlock.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;IDASSET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Lock_Unlock.Input/tns:IdAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Lock_Unlock.Input/tns:IdAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDASSET>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT STATOASSET, IDASSET, OFFERTA, DISTRETTO, NUMEROTELEFONICO, IDRISORSA, IDASSETCRMWS&#xa;  FROM BDS_1_CASEDATA_ASSET&#xa;  WHERE  IDASSET=? AND STATOASSET NOT IN ('SCARTATO','ANNULLATO','CHIUSO','INVIATOAFATTURAZIONE','FATTURAZIONEKO') &#xa;  ORDER BY CREATED DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDASSET"/>
                                    <columnMetadata
                                    columnName="STATOASSET"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSET"
                                    dataType="-5" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="OFFERTA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="DISTRETTO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="NUMEROTELEFONICO"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDRISORSA"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    <columnMetadata
                                    columnName="IDASSETCRMWS"
                                    dataType="-9"
                                    status="OptionalElement" typeName="NVARCHAR2"/>
                                    </value>
