                                <tibex:activityExtension
                                    inputVariable="Lock" name="Assign1"
                                    outputVariable="Lock"
                                    tibex:xpdlId="bfc8760b-ac95-419a-8102-5e76c13d1958" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
