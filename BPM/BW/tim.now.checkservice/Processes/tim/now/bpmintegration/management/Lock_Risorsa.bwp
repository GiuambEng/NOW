                            <bpws:reply name="Reply1"
                                operation="Lock_Unlock"
                                partnerLink="LockPortType"
                                portType="ns1:LockPortType"
                                tibex:xpdlId="2ea4fa45-bd9f-4530-a59b-4d7a634203bd" variable="Reply1-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tim.com/NOW/xsd/Lock_Risorsa/" xmlns:tns1="http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/" version="2.0"&gt;&lt;xsl:param name="Lock"/&gt;&lt;xsl:template name="Reply1-input" match="/"&gt;&lt;tns1:Lock_UnlockResponse&gt;&lt;Output&gt;&lt;tns:Output&gt;&lt;xsl:copy-of select="$Lock/tns:Esito"/&gt;&lt;/tns:Output&gt;&lt;/Output&gt;&lt;/tns1:Lock_UnlockResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock&quot;/>&#xa;    &lt;xsl:template name=&quot;Reply1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;xsl:copy-of select=&quot;$Lock/tns:Esito&quot;/>&#xa;        &lt;/tns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
