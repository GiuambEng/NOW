                            </bpws:reply>
                            <bpws:invoke
                                inputVariable="InvokeCheckOrdineInCorso-input"
                                name="InvokeCheckOrdineInCorso"
                                operation="NOWtoCRMWS_CheckOrdineInCorso"
                                outputVariable="InvokeCheckOrdineInCorso"
                                partnerLink="NOWtoCRMWS_CheckOrdineInCorso"
                                portType="ns16:NOWtoCRMWS_CheckOrdineInCorsoPortType" tibex:xpdlId="38d1a4e2-b970-48b1-83e7-ec7123c18ba6">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/NOW_Check_OrdineInCorso/" xmlns:tns1="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/" xmlns:tns="http://www.tim.com/NOW/xsd/Lock_Risorsa/" version="2.0"&gt;
    &lt;xsl:param name="Lock_Unlock"/&gt;
    &lt;xsl:param name="SelectFromAsset"/&gt;
    &lt;xsl:template name="InvokeCheckOrdineInCorso-input" match="/"&gt;
        &lt;tns3:NOWtoCRMWS_CheckOrdineInCorsoRequest&gt;
            &lt;Input&gt;
                &lt;tns1:REQUEST&gt;
                    &lt;tns1:TRANSACTION_DATE&gt;
                        &lt;xsl:value-of select="current-dateTime()"/&gt;
                    &lt;/tns1:TRANSACTION_DATE&gt;
                    &lt;tns1:TRANSACTION_ID&gt;
                        &lt;xsl:value-of select="$Lock_Unlock/Input/tns:Input/tns:CODIFICA_OLO_AGICOM"/&gt;
                    &lt;/tns1:TRANSACTION_ID&gt;
                    &lt;xsl:choose&gt;
                        &lt;xsl:when test="string-length($Lock_Unlock/Input/tns:Input/tns:CodiceOrdineOLO)&gt;0"&gt;
                            &lt;tns1:CODICE_ORDINE_OLO&gt;
                                &lt;xsl:value-of select="$Lock_Unlock/Input/tns:Input/tns:CodiceOrdineOLO"/&gt;
                            &lt;/tns1:CODICE_ORDINE_OLO&gt;
                        &lt;/xsl:when&gt;
                        &lt;xsl:otherwise&gt;
                            &lt;tns1:CODICE_ORDINE_OLO&gt;
                                &lt;xsl:value-of select="'NonValorizzatoDaOLO'"/&gt;
                            &lt;/tns1:CODICE_ORDINE_OLO&gt;
                        &lt;/xsl:otherwise&gt;
                    &lt;/xsl:choose&gt;
                    &lt;tns1:RISORSE&gt;
                        &lt;xsl:if test="$SelectFromAsset/Record[1]/IDRISORSA"&gt;
                            &lt;tns1:ID_RISORSA&gt;
                                &lt;xsl:value-of select="$SelectFromAsset/Record[1]/IDRISORSA"/&gt;
                            &lt;/tns1:ID_RISORSA&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns1:DN&gt;
                            &lt;xsl:value-of select="concat($SelectFromAsset/Record[1]/DISTRETTO, $SelectFromAsset/Record[1]/NUMEROTELEFONICO)"/&gt;
                        &lt;/tns1:DN&gt;
                        &lt;xsl:if test="$SelectFromAsset/Record[1]/IDASSETCRMWS"&gt;
                            &lt;tns1:ID_CRMWS&gt;
                                &lt;xsl:value-of select="$SelectFromAsset/Record[1]/IDASSETCRMWS"/&gt;
                            &lt;/tns1:ID_CRMWS&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$SelectFromAsset/Record[1]/IDASSET"&gt;
                            &lt;tns1:ID_NOW&gt;
                                &lt;xsl:value-of select="$SelectFromAsset/Record[1]/IDASSET"/&gt;
                            &lt;/tns1:ID_NOW&gt;
                        &lt;/xsl:if&gt;
                        &lt;xsl:if test="$Lock_Unlock/Input/tns:Input/tns:Lavorazione"&gt;
                            &lt;tns1:LAVORAZIONE&gt;
                                &lt;xsl:value-of select="$Lock_Unlock/Input/tns:Input/tns:Lavorazione"/&gt;
                            &lt;/tns1:LAVORAZIONE&gt;
                        &lt;/xsl:if&gt;
                    &lt;/tns1:RISORSE&gt;
                    &lt;xsl:if test="$Lock_Unlock/Input/tns:Input/tns:ID_RICH_OLO"&gt;
                        &lt;tns1:ID_RICH_OLO&gt;
                            &lt;xsl:value-of select="$Lock_Unlock/Input/tns:Input/tns:ID_RICH_OLO"/&gt;
                        &lt;/tns1:ID_RICH_OLO&gt;
                    &lt;/xsl:if&gt;
                &lt;/tns1:REQUEST&gt;
            &lt;/Input&gt;
        &lt;/tns3:NOWtoCRMWS_CheckOrdineInCorsoRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/NOW_Check_OrdineInCorso/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock_Unlock.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;SelectFromAsset&quot;/>&#xa;    &lt;xsl:template name=&quot;InvokeCheckOrdineInCorso-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:REQUEST>&#xa;            &lt;tns1:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/tns1:TRANSACTION_DATE>&#xa;            &lt;tns1:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$Lock_Unlock.Input/tns:CODIFICA_OLO_AGICOM&quot;/>&#xa;            &lt;/tns1:TRANSACTION_ID>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($Lock_Unlock.Input/tns:CodiceOrdineOLO)>0&quot;>&#xa;                    &lt;tns1:CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$Lock_Unlock.Input/tns:CodiceOrdineOLO&quot;/>&#xa;                    &lt;/tns1:CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;tns1:CODICE_ORDINE_OLO>&#xa;                        &lt;xsl:value-of select=&quot;'NonValorizzatoDaOLO'&quot;/>&#xa;                    &lt;/tns1:CODICE_ORDINE_OLO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;tns1:RISORSE>&#xa;                &lt;xsl:if test=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;>&#xa;                    &lt;tns1:ID_RISORSA>&#xa;                        &lt;xsl:value-of select=&quot;$SelectFromAsset/Record[1]/IDRISORSA&quot;/>&#xa;     