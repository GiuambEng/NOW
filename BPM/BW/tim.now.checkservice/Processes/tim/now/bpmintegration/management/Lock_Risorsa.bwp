&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tim.com/NOW/wsdl/abstract/ID_Risorsa_Lock/&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;ReplyFault-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:Output>&#xa;            &lt;tns:Esito>&#xa;                &lt;tns:Codice>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;11&amp;quot;&quot;/>&#xa;                &lt;/tns:Codice>&#xa;                &lt;tns:Descrizione>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;Risorsa non esistente&amp;quot;&quot;/>&#xa;                &lt;/tns:Descrizione>&#xa;                &lt;tns:Esito>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns:Esito>&#xa;            &lt;/tns:Esito>&#xa;        &lt;/tns:Output>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
