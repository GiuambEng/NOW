                    &lt;tns:Codice_Errore&gt;
                        &lt;xsl:value-of select="&amp;quot;InputValidation.&amp;quot;"/&gt;
                    &lt;/tns:Codice_Errore&gt;
                &lt;/tns:Fault&gt;
            &lt;/Fault&gt;
        &lt;/tns3:Lock_UnlockFault&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <tibex:inputBindings>
