                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+912e2344-8f2c-4648-a675-dfd90a76d1b0+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Lock_Unlock&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaStatoComponente-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;ASSET_DETTAGLIOASSET_BDSID>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Lock_Unlock/Input/tns:Input/tns:IdAsset)&quot;/>&#xa;            &lt;/ASSET_DETTAGLIOASSET_BDSID>&#xa;            &lt;IDDETTAGLIOASSET>&#xa;                &lt;xsl:value-of select=&quot;xsd:int($Lock_Unlock/Input/tns:Input/tns:IdDettaglioAsset)&quot;/>&#xa;            &lt;/IDDETTAGLIOASSET>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VerificaStatoComponente-input"
                                    name="VerificaStatoComponente"
                                    outputVariable="VerificaStatoComponente"
                                    tibex:xpdlId="912e2344-8f2c-4648-a675-dfd90a76d1b0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="JDBCUpdateStatoASSETToVerificaStatoComponente_NPPortin"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VerificaStatoComponenteToJDBCUpdate_Attivo">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$VerificaStatoComponente/Record[1]/STATODETTAGLIOASSET='ATTIVO'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[$VerificaStatoComponente/Record[1]/STATODETTAGLIOASSET='ATTIVO']]></bpws:transitionCondition>
