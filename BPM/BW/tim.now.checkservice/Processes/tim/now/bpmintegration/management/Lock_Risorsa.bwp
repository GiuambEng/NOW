                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Lock&quot;/>&lt;xsl:param name=&quot;InvokeCheckOrdineInCorso&quot;/>&lt;xsl:param name=&quot;JDBCAssetTarget&quot;/>&lt;xsl:param name=&quot;SelectRichiesta&quot;/>&lt;xsl:param name=&quot;SelectRichiestaOld&quot;/>&lt;xsl:template name=&quot;Lock&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$Lock/tns:Esito/tns:Codice&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;count($JDBCAssetTarget/Record) > 0&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$JDBCAssetTarget/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectRichiesta/Record) > 0&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$SelectRichiesta/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectRichiestaOld/Record) > 0&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$SelectRichiestaOld/Record[1]/IDRICHIESTAOLO&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:ID_ORDINE&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;tns:Esito>&lt;xsl:value-of select=&quot;$Lock/tns:Esito/tns:Esito&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Lock"
                                    name="Assign_IdRichOrdine"
                                    outputVariable="Lock"
                                    tibex:xpdlId="855a4c91-2003-40a0-a742-5d3b5372da8e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
