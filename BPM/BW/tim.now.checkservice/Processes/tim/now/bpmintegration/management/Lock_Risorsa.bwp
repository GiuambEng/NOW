                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;SelectFromAsset&quot;/>&lt;xsl:param name=&quot;Lock_Unlock&quot;/>&lt;xsl:param name=&quot;SelectRichiesta&quot;/>&lt;xsl:param name=&quot;StatoAsset&quot;/>&lt;xsl:param name=&quot;SelectRichiestaOld&quot;/>&lt;xsl:param name=&quot;JDBCAssetTarget&quot;/>&lt;xsl:param name=&quot;TipoRichiesta&quot;/>&lt;xsl:param name=&quot;SelectRichiestaOldCorrelato&quot;/>&lt;xsl:param name=&quot;JDBCAssetTargetCorrelato&quot;/>&lt;xsl:param name=&quot;SelectRichiestaCorrelato&quot;/>&lt;xsl:param name=&quot;SelectFromAssetCorrelato&quot;/>&lt;xsl:param name=&quot;VerificaStatoAggiuntivo&quot;/>&lt;xsl:template name=&quot;Lock&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:variable name=&quot;StatoAsset&quot; select=&quot;if(exists($SelectFromAsset/Record[./STATOASSET='ATTIVO'])) then 'ATTIVO' else if(exists($SelectFromAsset/Record[./STATOASSET='INLAVORAZIONE'])) then 'INLAVORAZIONE' else 'CESSATO'&quot;/>&lt;xsl:choose>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTargetCorrelato/Record[1]/LAVORAZIONE='CESSAZIONE' or $SelectRichiestaCorrelato/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot; or $SelectRichiestaOldCorrelato/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot;) and starts-with($SelectFromAssetCorrelato/Record[1]/OFFERTA, &amp;quot;WLR&amp;quot;)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Risorsa lavorabile'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$TipoRichiesta = &amp;quot;RICARICA&amp;quot;and count($SelectFromAsset/Record[STATOASSET =(&amp;quot;INLAVORAZIONE&amp;quot;, &amp;quot;CESSATO&amp;quot;)]) = 0&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Ricarica lavorabile'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='MIGRAZIONE' or $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;MIGRAZIONE&amp;quot;)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;02&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Migrazione in corso'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = (&amp;quot;INLAVORAZIONE&amp;quot;,&amp;quot;CESSATO&amp;quot;) and ($JDBCAssetTarget/Record[1]/OFFERTA='NP' or $SelectRichiesta/Record[1]/OFFERTA = &amp;quot;NP&amp;quot; or $SelectRichiestaOld/Record[1]/OFFERTA = &amp;quot;NP&amp;quot;) and string-length($Lock_Unlock/Input/tns:Input/tns:IdDettaglioAsset)>0&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;count($VerificaStatoAggiuntivo/Record)=0&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;'11'&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Risorsa non esistente'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$VerificaStatoAggiuntivo/Record[1]/STATODETTAGLIOASSET='INLAVORAZIONE'&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;'01'&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'NP in corso'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;'10'&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Risorsa cessata'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/OFFERTA='NP' or $SelectRichiesta/Record[1]/OFFERTA = &amp;quot;NP&amp;quot; or $SelectRichiestaOld/Record[1]/OFFERTA = &amp;quot;NP&amp;quot;)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;01&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'NP in corso'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='ATTIVAZIONE' or $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;ATTIVAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;ATTIVAZIONE&amp;quot;)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;04&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Attivazione in corso'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='CESSAZIONE' or $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;CESSAZIONE&amp;quot;)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;03&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Cessazione in corso'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;INLAVORAZIONE&amp;quot; and ($JDBCAssetTarget/Record[1]/LAVORAZIONE='VARIAZIONE' or  $SelectRichiesta/Record[1]/LAVORAZIONE = &amp;quot;VARIAZIONE&amp;quot; or $SelectRichiestaOld/Record[1]/LAVORAZIONE = &amp;quot;VARIAZIONE&amp;quot;)&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;05&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Variazione in corso'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;ATTIVO&amp;quot; and $Lock_Unlock/Input/tns:Input/tns:CODIFICA_OLO_AGICOM = &amp;quot;TLC&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Risorsa lavorabile'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$StatoAsset = &amp;quot;CESSATO&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;10&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Risorsa cessata'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;count($SelectFromAsset/Record)=0&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;11&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Risorsa non esistente'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;99&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Errore tecnico'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
