                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectRichiestaCorrelato-input"
                                    name="SelectRichiestaCorrelato"
                                    outputVariable="SelectRichiestaCorrelato"
                                    tibex:xpdlId="cd7ed120-2141-4764-8cf7-1176545bf6d4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
