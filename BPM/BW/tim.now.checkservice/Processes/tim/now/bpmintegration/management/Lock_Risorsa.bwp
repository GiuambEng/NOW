                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/Lock_Risorsa/&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;InvokeCheckOrdineInCorso&quot;/>&lt;xsl:template name=&quot;Lock&quot; match=&quot;/&quot;>&lt;tns:Output>&lt;xsl:choose>&lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE = &amp;quot;00&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE = &amp;quot;01&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;NP in Corso&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE = &amp;quot;02&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Migrazione in Corso&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE = &amp;quot;11&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;&amp;quot;00&amp;quot;&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Risorsa non esistente&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE = &amp;quot;04&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Attivazione in Corso&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE = &amp;quot;05&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Variazione in Corso&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:when test=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE = &amp;quot;10&amp;quot;&quot;>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;&amp;quot;Risorsa Cessata&amp;quot;&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;$InvokeCheckOrdineInCorso/Output/tns1:RESPONSE/tns1:RETURN_CODE&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'Errore tecnico'&quot;/>&lt;/tns:Descrizione>&lt;tns:Esito>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Esito>&lt;/tns:Esito>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Output>&lt;/xsl:template>&lt;/xsl:stylesheet>"
