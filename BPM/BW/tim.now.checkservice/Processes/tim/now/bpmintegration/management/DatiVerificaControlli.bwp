                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/MappingDatiVerificaControlli&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;ProgressivoDatiUnica&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper_VerificaControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:MappingDatiVerificaControlli>&#xa;            &lt;!--DATI ACCESSO-->&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:CLLIIDSLUCO) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:CLLIIDSLUCO))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:CLLIIDSLUCO&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:CLLIIDULLCO) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:CLLIIDULLCO))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:CLLIIDULLCO&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:FlagNuovoModello) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:FlagNuovoModello))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:FlagNuovoModello&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:FlagOLODiffidato) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:FlagOLODiffidato))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:FlagOLODiffidato&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDCodiceProgetto) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDCodiceProgetto))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDCodiceProgetto&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDContratto) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDContratto))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDContratto&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDContrattoFiglioWLR) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDContrattoFiglioWLR))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDContrattoFiglioWLR&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDRisorsaFonia) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDRisorsaFonia))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IDRisorsaFonia&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:ProgettoVULL) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:ProgettoVULL))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:ProgettoVULL&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IdRisorsaDati) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiAccesso/tns:IdRisorsaDati))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &l