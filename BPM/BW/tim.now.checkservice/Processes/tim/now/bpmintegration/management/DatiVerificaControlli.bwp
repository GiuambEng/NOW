                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToCallProcess2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+07e1dd8b-6e38-48b5-bf23-909111f316ce+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/MappingDatiVerificaControlli&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliInsert&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCInsertControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$DatiVerificaControlliInsert/tns2:MappingCaseRequest[string-length(tns2:NOME) > 0 and string-length(tns2:VALORE) > 0]&quot;>&#xa;                &lt;Record>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;NOME>&#xa;                        &lt;xsl:value-of select=&quot;tns2:NOME&quot;/>&#xa;                    &lt;/NOME>&#xa;                    &lt;NOTE>&#xa;                        &lt;xsl:value-of select=&quot;tns2:NOTE&quot;/>&#xa;                    &lt;/NOTE>&#xa;                    &lt;OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;tns2:OPERATORE&quot;/>&#xa;                    &lt;/OPERATORE>&#xa;                    &lt;PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:PROGRS_TIPOLG_DATO&quot;/>&#xa;                    &lt;/PROGRS_TIPOLG_DATO>&#xa;                    &lt;TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:TIMSTP_AGGTO&quot;/>&#xa;                    &lt;/TIMSTP_AGGTO>&#xa;                    &lt;TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:TIMSTP_INSMTO&quot;/>&#xa;                    &lt;/TIMSTP_INSMTO>&#xa;                    &lt;TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:TIPOLG_DATO&quot;/>&#xa;                    &lt;/TIPOLG_DATO>&#xa;                    &lt;VALORE>&#xa;                        &lt;xsl:value-of select=&quot;tns2:VALORE&quot;/>&#xa;                    &lt;/VALORE>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="jdbcTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO DATI_VERIFICA_CTRLI (ID_RICH_OLO, NOME, NOTE, OPERATORE, PROGRS_TIPOLG_DATO, TIMSTP_AGGTO, TIMSTP_INSMTO, TIPOLG_DATO, VALORE)&#xd;&#xa;  VALUES (?, ?, ?, ?, ?, ?, ?, (select IDTPLG_DATO_RICH&#xd;&#xa;from TIPOLG_DATO_RICH&#xd;&#xa;where DESCR = ?), ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
