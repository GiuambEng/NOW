                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/MappingDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper_VerificaControlli&quot;/>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliUpdate&quot;/>&#xa;    &lt;xsl:template name=&quot;DatiVerificaControlliUpdate&quot; match=&quot;/&quot;>&#xa;        &lt;tns2:MappingDatiVerificaControlli>&#xa;            &lt;xsl:copy-of select=&quot;$DatiVerificaControlliUpdate/tns2:MappingCaseRequest&quot;/>&#xa;            &lt;tns2:MappingCaseRequest>&#xa;                &lt;tns2:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:ID_RICH_OLO&quot;/>&#xa;                &lt;/tns2:ID_RICH_OLO>&#xa;                &lt;tns2:NOME>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:NOME&quot;/>&#xa;                &lt;/tns2:NOME>&#xa;                &lt;tns2:NOTE>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:NOTE&quot;/>&#xa;                &lt;/tns2:NOTE>&#xa;                &lt;tns2:OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:OPERATORE&quot;/>&#xa;                &lt;/tns2:OPERATORE>&#xa;                &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:PROGRS_TIPOLG_DATO&quot;/>&#xa;                &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                &lt;tns2:TIMSTP_AGGTO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:TIMSTP_AGGTO&quot;/>&#xa;                &lt;/tns2:TIMSTP_AGGTO>&#xa;                &lt;tns2:TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:TIMSTP_INSMTO&quot;/>&#xa;                &lt;/tns2:TIMSTP_INSMTO>&#xa;                &lt;tns2:TIPOLG_DATO>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:TIPOLG_DATO&quot;/>&#xa;                &lt;/tns2:TIPOLG_DATO>&#xa;                &lt;tns2:VALORE>&#xa;                    &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:VALORE&quot;/>&#xa;                &lt;/tns2:VALORE>&#xa;            &lt;/tns2:MappingCaseRequest>&#xa;        &lt;/tns2:MappingDatiVerificaControlli>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
