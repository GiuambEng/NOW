            <bpws:scope name="While" tibex:group="while" tibex:xpdlId="2d112f1d-5b29-4b87-a176-dfc5f2b73d4c">
                <bpws:targets>
                    <bpws:target linkName="LOG_MapperVerificaControlliToWhile"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="WhileToJDBCInsertControlli"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($Mapper_VerificaControlli/ns7:MappingCaseRequest)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($Mapper_VerificaControlli/ns7:MappingCaseRequest)]]></bpws:condition>
                        <bpws:flow name="flow2">
                            <bpws:links>
                                <bpws:link name="GroupStartToJDBCQuery" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCSelectControlliToAssign" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                                <bpws:link
                                    name="JDBCSelectControlliToAssign1" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link name="Assign1ToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="AssignToAccumulate" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="766a9c3e-2844-4a40-b164-65bb589869e0">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToJDBCQuery"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="f60c4bf0-1fb9-44c5-9a3f-f1e6a2c6562f">
                                <bpws:targets>
                                    <bpws:target linkName="Assign1ToAccumulate"/>
                                    <bpws:target linkName="AssignToAccumulate"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    inputVariable="JDBCSelectControlli-input"
                                    name="JDBCSelectControlli"
                                    outputVariable="JDBCSelectControlli"
                                    tibex:xpdlId="799975ed-4e55-4625-91dd-a12ae3c0bcf2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToJDBCQuery"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCSelectControlliToAssign">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="JDBCSelectControlliToAssign1">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($JDBCSelectControlli/Record)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($JDBCSelectControlli/Record)]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+799975ed-4e55-4625-91dd-a12ae3c0bcf2+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/MappingDatiVerificaControlli&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper_VerificaControlli&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCSelectControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:ID_RICH_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_RICH_OLO>&#xa;            &lt;NOME>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:NOME)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:NOME&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME>&#xa;            &lt;TIPOLG_DATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:TIPOLG_DATO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:TIPOLG_DATO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIPOLG_DATO>&#xa;            &lt;PROGRS_TIPOLG_DATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:PROGRS_TIPOLG_DATO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$Mapper_VerificaControlli/tns2:MappingCaseRequest[number($index)]/tns2:PROGRS_TIPOLG_DATO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/PROGRS_TIPOLG_DATO>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
