                tibex:xpdlId="97d4466f-6152-497d-a8fd-aece3a6e1adf" variable="DatiVerificaControlliOut-input">
                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns3="http://www.tim.com/NOW/wsdl/abstract/DatiVerificaControlli/" xmlns:tns="http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli" version="2.0"&gt;
    &lt;xsl:param name="MapperOutput"/&gt;
