   &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:LavorazioneInCorso/tns:TipologiaLavorazioneNOW) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:LavorazioneInCorso/tns:TipologiaLavorazioneNOW))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;LAVORAZIONE IN CORSO&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:LavorazioneInCorso/tns:TipologiaLavorazioneNOW&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;!--DATI UNICA-->&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:DatiUnica/tns:Caposerie) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:DatiUnica/tns:Caposerie))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($ProgressivoDatiUnica)&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;DATI UNICA&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-o