            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="JDBCUpdateControlli-input"
                    name="JDBCUpdateControlli"
                    outputVariable="JDBCUpdateControlli"
                    tibex:xpdlId="1eb95942-bea8-448d-b92c-4f7b3b274730" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LOG_OutputInsertToJDBCUpdate"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCUpdateToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+1eb95942-bea8-448d-b92c-4f7b3b274730+input&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/MappingDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliUpdate&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdateControlli-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcUpdateActivityInput>&#xa;            &lt;xsl:for-each select=&quot;$DatiVerificaControlliUpdate/tns2:MappingCaseRequest[string-length(tns2:NOME) > 0 and string-length(tns2:VALORE) > 0]&quot;>&#xa;                &lt;Record>&#xa;                    &lt;NOTE>&#xa;                        &lt;xsl:value-of select=&quot;tns2:NOTE&quot;/>&#xa;                    &lt;/NOTE>&#xa;                    &lt;OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;tns2:OPERATORE&quot;/>&#xa;                    &lt;/OPERATORE>&#xa;                    &lt;TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:TIMSTP_AGGTO&quot;/>&#xa;                    &lt;/TIMSTP_AGGTO>&#xa;                    &lt;VALORE>&#xa;                        &lt;xsl:value-of select=&quot;tns2:VALORE&quot;/>&#xa;                    &lt;/VALORE>&#xa;                    &lt;ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:ID_RICH_OLO&quot;/>&#xa;                    &lt;/ID_RICH_OLO>&#xa;                    &lt;NOME>&#xa;                        &lt;xsl:value-of select=&quot;tns2:NOME&quot;/>&#xa;                    &lt;/NOME>&#xa;                    &lt;PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:PROGRS_TIPOLG_DATO&quot;/>&#xa;                    &lt;/PROGRS_TIPOLG_DATO>&#xa;                    &lt;TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;tns2:TIPOLG_DATO&quot;/>&#xa;                    &lt;/TIPOLG_DATO>&#xa;                &lt;/Record>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns3:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.update"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="jdbcTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE DATI_VERIFICA_CTRLI&#xa;  SET NOTE = ?, OPERATORE = ?, TIMSTP_AGGTO = ?, VALORE = ?&#xa;  WHERE ID_RICH_OLO = ? AND NOME = ? AND PROGRS_TIPOLG_DATO = ? AND TIPOLG_DATO = (select IDTPLG_DATO_RICH&#xa;from TIPOLG_DATO_RICH&#xa;where DESCR = ?)" xsi:type="jdbcPalette:JDBCUpdateActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOTE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE"/>
                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_AGGTO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="VALORE"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME"/>
                                    <PreparedParameters DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PROGRS_TIPOLG_DATO"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_DATO"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliIn&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCUpdateControlli&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_OutputUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DatiVerificaControlli&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DatiVerificaControlliPortType&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DatiVerificaControlli&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Modificati nella tabella: &amp;quot;, string($JDBCUpdateControlli/noOfUpdates), &amp;quot; record per IDRichiestaOLO: &amp;quot;, $DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:IDRichiestaOLO)&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="LOG_OutputUpdate-input"
                    name="LOG_OutputUpdate"
                    tibex:xpdlId="52adbbb7-1644-44e9-ae53-0503da3f1a69"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="JDBCUpdateToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToDatiVerificaControlliOut"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;logger_name&quot;/>&#xa;    &lt;xsl:param name=&quot;log_level&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCUpdateControlli&quot;/>&#xa;    &lt;xsl:template name=&quot;LOG_OutputUpdate-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:CW_BUS_MESSAGE>&#xa;            &lt;tns1:GenericLogger>&#xa;                &lt;tns1:Application>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&#xa;                &lt;/tns1:Application>&#xa;                &lt;tns1:Process>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DatiVerificaControlli&amp;quot;&quot;/>&#xa;                &lt;/tns1:Process>&#xa;                &lt;tns1:Service>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DatiVerificaControlliPortType&amp;quot;&quot;/>&#xa;                &lt;/tns1:Service>&#xa;                &lt;tns1:Operation>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;DatiVerificaControlli&amp;quot;&quot;/>&#xa;                &lt;/tns1:Operation>&#xa;                &lt;tns1:BusinessID>&#xa;                    &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                &lt;/tns1:BusinessID>&#xa;                &lt;tns1:Message>&#xa;                    &lt;xsl:value-of select=&quot;concat(&amp;quot;Modificati nella tabella: &amp;quot;, string($JDBCUpdateControlli/noOfUpdates), &amp;quot; record per IDRichiestaOLO: &amp;quot;, $DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO)&quot;/>&#xa;                &lt;/tns1:Message>&#xa;                &lt;tns1:LoggerName>&#xa;                    &lt;xsl:value-of select=&quot;$logger_name&quot;/>&#xa;                &lt;/tns1:LoggerName>&#xa;                &lt;tns1:LogLevel>&#xa;                    &lt;xsl:value-of select=&quot;$log_level&quot;/>&#xa;                &lt;/tns1:LogLevel>&#xa;                &lt;tns1:LogJMS>&#xa;                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                &lt;/tns1:LogJMS>&#xa;            &lt;/tns1:GenericLogger>&#xa;        &lt;/tns1:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+675811d0-0803-432e-b833-30b71d9b15a4+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliIn&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="JDBCQueryOutput-input"
                    name="JDBCQueryOutput"
                    outputVariable="JDBCQueryOutput"
                    tibex:xpdlId="675811d0-0803-432e-b833-30b71d9b15a4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToDatiVerificaControlliOut"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="JDBCQueryOutputToCallProcess"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+675811d0-0803-432e-b833-30b71d9b15a4+input&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;DatiVerificaControlliIn.parameters&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCQuery-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:jdbcQueryActivityInput>&#xa;            &lt;ID_RICH_OLO>&#xa;                &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;            &lt;/ID_RICH_OLO>&#xa;        &lt;/tns3:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="jdbcTimeout"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DAT.NOME, DAT.VALORE, DAT.PROGRS_TIPOLG_DATO, TIP.DESCR&#xa;  FROM DATI_VERIFICA_CTRLI DAT, TIPOLG_DATO_RICH TIP&#xa;  WHERE DAT.ID_RICH_OLO = ? AND TIP.IDTPLG_DATO_RICH = DAT.TIPOLG_DATO&#xa;  ORDER BY IDTPLG_DATO_RICH, PROGRS_TIPOLG_DATO ASC&#xa;" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="VALORE"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="PROGRS_TIPOLG_DATO"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="DESCR"
                                    dataType="12" typeName="VARCHAR2"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="MapperOutput-input"
                    name="MapperOutput" outputVariable="MapperOutput"
                    tibex:xpdlId="224639ed-826f-41da-8a59-9b02a26f60b3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToMapperOutput"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperOutputToCallProcess1"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCQueryOutput&quot;/>&lt;xsl:template name=&quot;MapperOutput-input&quot; match=&quot;/&quot;>&lt;tns:DatiVerificaControlliOutput>&lt;tns:DatiAccesso>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;CLLIIDSLUCO&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:CLLIIDSLUCO>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;CLLIIDSLUCO&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:CLLIIDSLUCO>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;CLLIIDULLCO&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:CLLIIDULLCO>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;CLLIIDULLCO&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:CLLIIDULLCO>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;FlagNuovoModello&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:FlagNuovoModello>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;FlagNuovoModello&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:FlagNuovoModello>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;FlagOLODiffidato&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:FlagOLODiffidato>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;FlagOLODiffidato&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:FlagOLODiffidato>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDCodiceProgetto&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:IDCodiceProgetto>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDCodiceProgetto&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:IDCodiceProgetto>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDContratto&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:IDContratto>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDContratto&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:IDContratto>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDContrattoFiglioWLR&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:IDContrattoFiglioWLR>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDContrattoFiglioWLR&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:IDContrattoFiglioWLR>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDRisorsaFonia&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:IDRisorsaFonia>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;IDRisorsaFonia&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:IDRisorsaFonia>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;ProgettoVULL&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;>&lt;tns:ProgettoVULL>&lt;xsl:value-of select=&quot;$JDBCQueryOutput/Record[NOME = upper-case(&amp;quot;ProgettoVULL&amp;quot;) and DESCR = &amp;quot;DATI ACCESSO&amp;quot;]/VALORE&quot;/>&lt;/tns:ProgettoVULL>&lt;/xsl:if>&lt;xsl:if test=&quot;$JDBCQueryOutput/Record[NOME = upper-