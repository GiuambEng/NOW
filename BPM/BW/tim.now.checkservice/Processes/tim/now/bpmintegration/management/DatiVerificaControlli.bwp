            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tim.com/NOW/xsd/MappingDatiVerificaControlli&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/StoricoDatiVerificaControlli&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;DatiVerificaControlliIn&quot;/>&lt;xsl:param name=&quot;ProgressivoDatiUnica&quot;/>&lt;xsl:template name=&quot;Mapper_VerificaControlli-input&quot; match=&quot;/&quot;>&lt;tns2:MappingDatiVerificaControlli>&#xa;                    &lt;!--DATI ACCESSO-->&lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:DatiAccesso/tns:CLLIIDSLUCO) > 0&quot;>&lt;tns2:MappingCaseRequest>&lt;tns2:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:IDRichiestaOLO&quot;/>&lt;/tns2:ID_RICH_OLO>&lt;tns2:NOME>&lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:DatiAccesso/tns:CLLIIDSLUCO))&quot;/>&lt;/tns2:NOME>&lt;tns2:NOTE>&lt;xsl:value-of select=&quot;$DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:Note&quot;/>&lt;/tns2:NOTE>&lt;tns2:OPERATORE>&lt;xsl:value-of select=&quot;$DatiVerificaControlliIn/parameters/tns:DatiVerificaControlliInput/tns:Operatore&quot;/>&lt;/tns2:OPERATORE>&lt;tns2:PROGRS_TIPOLG_DATO>&lt;xsl:value-of select=&quot;1&quot;/>&lt;/tns2:PROGRS_TIPOLG_DATO>&lt;tns2:TIMSTP_AGGTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TIMSTP_AGGTO>&lt;tns2:TIMSTP_INSMTO>&lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&lt;/tns2:TIMSTP_INSMTO>&lt;tns2:TIPOLG_DATO>&lt;xsl:value-of select=&quot;&amp;quot;DATI ACCESSO&amp;quot;&quot;/>&lt;/tns2:TIPOLG_DATO>&lt;tns2:VALORE>&lt;xsl:value-of select=&quot;$DatiVerificaControlli