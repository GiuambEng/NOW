                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT ID_RICH_OLO, NOME, TIPOLG_DATO, PROGRS_TIPOLG_DATO&#xa;FROM DATI_VERIFICA_CTRLI&#xa;WHERE ID_RICH_OLO = ? AND NOME = ? AND TIPOLG_DATO = (select IDTPLG_DATO_RICH&#xa;from TIPOLG_DATO_RICH&#xa;where DESCR = ?) AND PROGRS_TIPOLG_DATO = ?" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_RICH_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_DATO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="PROGRS_TIPOLG_DATO"/>
                                    <columnMetadata
                                    columnName="ID_RICH_OLO"
                                    dataType="12" typeName="VARCHAR2"/>
                                    <columnMetadata
                                    columnName="NOME"
                                    dataType="12" typeName="VARCHAR2"/>
