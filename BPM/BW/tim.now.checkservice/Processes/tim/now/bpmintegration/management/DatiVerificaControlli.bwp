;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:DestinazioneUso&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:Direzionalita) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:Direzionalita))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CONSISTENZA DATI&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:Direzionalita&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:FlagBTSNaked) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:FlagBTSNaked))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CONSISTENZA DATI&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:FlagBTSNaked&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDAsset) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;IDENTIFICATIVOASSET&amp;quot;&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CONSISTENZA DATI&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDAsset&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsa) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsa))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CONSISTENZA DATI&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsa&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsaCorrelato) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsaCorrelato))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_AGGTO>&#xa;                    &lt;tns2:TIMSTP_INSMTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns2:TIMSTP_INSMTO>&#xa;                    &lt;tns2:TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;CONSISTENZA DATI&amp;quot;&quot;/>&#xa;                    &lt;/tns2:TIPOLG_DATO>&#xa;                    &lt;tns2:VALORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsaCorrelato&quot;/>&#xa;                    &lt;/tns2:VALORE>&#xa;                &lt;/tns2:MappingCaseRequest>&#xa;            &lt;/xsl:if>&#xa;            &lt;xsl:if test=&quot;string-length($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsaNOW) > 0&quot;>&#xa;                &lt;tns2:MappingCaseRequest>&#xa;                    &lt;tns2:ID_RICH_OLO>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:IDRichiestaOLO&quot;/>&#xa;                    &lt;/tns2:ID_RICH_OLO>&#xa;                    &lt;tns2:NOME>&#xa;                        &lt;xsl:value-of select=&quot;upper-case(local-name($DatiVerificaControlliIn.parameters/tns:ConsistenzaDati/tns:IDRisorsaNOW))&quot;/>&#xa;                    &lt;/tns2:NOME>&#xa;                    &lt;tns2:NOTE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Note&quot;/>&#xa;                    &lt;/tns2:NOTE>&#xa;                    &lt;tns2:OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;$DatiVerificaControlliIn.parameters/tns:Operatore&quot;/>&#xa;                    &lt;/tns2:OPERATORE>&#xa;                    &lt;tns2:PROGRS_TIPOLG_DATO>&#xa;                        &lt;xsl:value-of select=&quot;1&quot;/>&#xa;                    &lt;/tns2:PROGRS_TIPOLG_DATO>&#xa;                    &lt;tns2:TIMSTP_AGGTO>&#xa;                        &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;    