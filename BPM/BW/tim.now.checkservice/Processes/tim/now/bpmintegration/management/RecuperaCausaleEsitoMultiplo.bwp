    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLogIn" tibex:linkType="SUCCESS"/>
                <bpws:link name="SelCausaleEsitoMultiploToLogOut" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogInToSelCausaleEsitoMultiplo" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogOutToAssignResponse" tibex:linkType="SUCCESS"/>
                <bpws:link name="AssignResponseToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="SelCausaleEsitoMultiploToErrorLog_error"
                    tibex:label="error" tibex:linkType="ERROR"/>
                <bpws:link name="ErrorLogToAssignResponse" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="36b18294-a7de-46cc-8e0d-a9b1233861b1"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLogIn"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Response&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="End-input" name="End"
                    tibex:xpdlId="227946e4-3610-49e1-a136-67fd716367cb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="AssignResponseToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Response&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:copy-of select=&quot;$Response&quot;/>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5e868008-9f3a-4c4d-9236-a5a217745d30+input&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SelCausaleEsitoMultiplo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;TIPOLG_LAVRZ>&lt;xsl:value-of select=&quot;$Start/em:Lavorazione&quot;/>&lt;/TIPOLG_LAVRZ>&lt;SCENARIO_BPM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/em:Scenario)&quot;>&lt;xsl:value-of select=&quot;$Start/em:Scenario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SCENARIO_BPM>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;$Start/em:Offerta&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;COD_CTRL>&lt;xsl:value-of select=&quot;$Start/em:CodiceControllo&quot;/>&lt;/COD_CTRL>&lt;DESC_ESITO_CTRL>&lt;xsl:value-of select=&quot;$Start/em:EsitoControllo&quot;/>&lt;/DESC_ESITO_CTRL>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                    inputVariable="SelCausaleEsitoMultiplo-input"
                    name="SelCausaleEsitoMultiplo"
                    outputVariable="SelCausaleEsitoMultiplo"
                    tibex:xpdlId="5e868008-9f3a-4c4d-9236-a5a217745d30" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogInToSelCausaleEsitoMultiplo"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SelCausaleEsitoMultiploToLogOut"/>
                        <bpws:source
                            linkName="SelCausaleEsitoMultiploToErrorLog_error"
                            tibex:faultDetailsVar="SelCausaleEsitoMultiplo" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+5e868008-9f3a-4c4d-9236-a5a217745d30+input&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;SelCausaleEsitoMultiplo-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;TIPOLG_LAVRZ>&lt;xsl:value-of select=&quot;$Start/em:Lavorazione&quot;/>&lt;/TIPOLG_LAVRZ>&lt;SCENARIO_BPM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($Start/em:Scenario)&quot;>&lt;xsl:value-of select=&quot;$Start/em:Scenario&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/SCENARIO_BPM>&lt;NOME_OFFERTA_ESTERNA>&lt;xsl:value-of select=&quot;$Start/em:Offerta&quot;/>&lt;/NOME_OFFERTA_ESTERNA>&lt;COD_CTRL>&lt;xsl:value-of select=&quot;$Start/em:CodiceControllo&quot;/>&lt;/COD_CTRL>&lt;DESC_ESITO_CTRL>&lt;xsl:value-of select=&quot;$Start/em:EsitoControllo&quot;/>&lt;/DESC_ESITO_CTRL>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.jdbc.JDBCQuery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <attributeBindings
                                bindingType="moduleProperty"
                                eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT DISTINCT CEC.ID_ANAG_CAUS, CEC.ID_ANAG_CAUS_PACTO&#xd;&#xa;FROM CAUS_ESITI_CTRL CEC, CAUS_CTRL_SRVZ_LAVRZ CCSL, TIPOLG_LAVRZ TL, OFFERTA O, TRASCODFC_OFFERTA TF, ANAG_CTRLI_FORMALI CF, TIPOLG_SCENARIO SC&#xd;&#xa;WHERE CEC.ID_CAUS_CTRL_SRVZ_LAVRZ = CCSL.ID_CAUS_CTRL_SRVZ_LAVRZ &#xd;&#xa;  AND TL.IDTPLG_LAVRZ = CCSL.IDTPLG_LAVRZ&#xd;&#xa;  AND O.ID_OFFERTA = CCSL.ID_OFFERTA&#xd;&#xa;  AND CCSL.ID_ANAG_CTRLI_FORMALI = CF.ID_ANAG_CTRLI_FORMALI&#xd;&#xa;  AND TL.TIPOLG_LAVRZ = ?&#xd;&#xa;  AND (CCSL.ID_SCENARIO IS NULL OR (CCSL.ID_SCENARIO = SC.ID_SCENARIO AND SC.SCENARIO_BPM = ?))&#xd;&#xa;  AND ((O.ID_OFFERTA = TF.ID_OFFERTA AND TF.NOME_OFFERTA_ESTERNA = ? AND PROVENIENZA = 'BPM') OR (O.OFFERTA = 'ALL'))&#xd;&#xa;  AND CF.COD_CTRL = ?&#xd;&#xa;  AND CEC.DESC_ESITO_CTRL = ?" xsi:type="jdbcPalette:JDBCQueryActivity">
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPOLG_LAVRZ"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="SCENARIO_BPM"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_CTRL"/>
                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="DESC_ESITO_CTRL"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="ID_ANAG_CAUS_PACTO"
                                    dataType="2" typeName="NUMBER"/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
