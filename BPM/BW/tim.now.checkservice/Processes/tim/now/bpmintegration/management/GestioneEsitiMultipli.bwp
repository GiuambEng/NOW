                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectRichiesta-input"
                                    name="SelectRichiesta"
                                    outputVariable="SelectRichiesta"
                                    tibex:xpdlId="2d61ca4c-0901-4d64-a2d7-d2d2e4817413" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogAssetToSelectRichiesta"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectRichiestaToLogRichiesta"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2d61ca4c-0901-4d64-a2d7-d2d2e4817413+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StoricizzaOLinCorso.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectRichiesta-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDRICHIESTAOLO>&#xa;                &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdOlBloccante&quot;/>&#xa;            &lt;/IDRICHIESTAOLO>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdRisorsaBloccata&quot;/>&#xa;            &lt;/IDRISORSA>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W')&quot;>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W'))&quot;/>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdRisorsaBloccata&quot;/>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W')&quot;>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W'))&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROFITTIZIO>&#xa;                        &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdRisorsaBloccata&quot;/>&#xa;                    &lt;/NUMEROFITTIZIO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W')&quot;>&#xa;                    &lt;CODICERISORSADONATING1>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W'))&quot;/>&#xa;                    &lt;/CODICERISORSADONATING1>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICERISORSADONATING1>&#xa;                        &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdRisorsaBloccata&quot;/>&#xa;                    &lt;/CODICERISORSADONATING1>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W')&quot;>&#xa;                    &lt;CODICERISORSADONATING2>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W'))&quot;/>&#xa;                    &lt;/CODICERISORSADONATING2>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;CODICERISORSADONATING2>&#xa;                        &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdRisorsaBloccata&quot;/>&#xa;                    &lt;/CODICERISORSADONATING2>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;contains($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W')&quot;>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;tib:trim(substring-before($StoricizzaOLinCorso.Input/IdRisorsaBloccata, 'W'))&quot;/>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NUMEROTELEFONICO>&#xa;                        &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdRisorsaBloccata&quot;/>&#xa;                    &lt;/NUMEROTELEFONICO>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;IDRISORSA>&#xa;                &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdRisorsaBloccata&quot;/>&#xa;            &lt;/IDRISORSA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RICH.IDRICHIESTAOLO&#xa;FROM BDS_1_CASEDATA_RICHIESTA RICH LEFT OUTER join BDS_1_CASEDATA_ORDINE ORD &#xa;ON ORD.RICHIESTA_ORDINE_BDSID = RICH.BDS_ID&#xa;WHERE RICH.STATORICHIESTANOW NOT IN ('CHIUSO',&#xa;'SCARTATO', 'ANNULLATO', 'FATTURAZIONEKO', 'INVIATOAFATTURAZIONE', 'ESPLETAMENTOTECNICOKO',&#xa;'ESPLETATOOKCONSUNTIVO') AND &#xa;RICH.IDRICHIESTAOLO &lt;> ? AND (ORD.IDRISORSA = ? OR ORD.NUMEROTELEFONICO = ?&#xa;OR ORD.NUMEROFITTIZIO = ? OR RICH.CODICERISORSADONATING = ? OR RICH.CODICERISORSADONATING2 = ? &#xa;OR rich.NUMEROTELEFONICO=? OR rich.IDRISORSA=?)&#xa;ORDER BY RICH.CREATED DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRICHIESTAOLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROFITTIZIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICERISORSADONATING1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODICERISORSADONATING2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NUMEROTELEFONICO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDRISORSA"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fc4aa5ce-0c0b-42dc-a320-dce6607c54b1+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StoricizzaOLinCorso&quot;/>&lt;xsl:template name=&quot;SelectAssetTarget-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDASSET>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdAsset)&quot;>&lt;xsl:value-of select=&quot;$StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdAsset&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/IDASSET>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="SelectAssetTarget-input"
                                    name="SelectAssetTarget"
                                    outputVariable="SelectAssetTarget"
                                    tibex:xpdlId="fc4aa5ce-0c0b-42dc-a320-dce6607c54b1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="LogInputToSelectAssetTarget"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="SelectAssetTargetToLogAsset"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+fc4aa5ce-0c0b-42dc-a320-dce6607c54b1+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;StoricizzaOLinCorso.Input&quot;/>&#xa;    &lt;xsl:template name=&quot;SelectAssetTarget-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;IDASSET>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($StoricizzaOLinCorso.Input/IdAsset)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$StoricizzaOLinCorso.Input/IdAsset&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/IDASSET>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="TimeoutJDBC"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT RICH.BDS_ID, RICH.IDRICHIESTAOLO FROM BDS_1_CASEDATA_RICHIESTA RICH&#xa;          JOIN BDS_1_CASEDATA_ASSETTARGET TARGET ON TARGET.RICHIESTA_ASSETTARGET_BDSID = RICH.BDS_ID&#xa;          WHERE TARGET.IDASSET = ? AND RICH.STATORICHIESTANOW NOT IN ('CHIUSO','SCARTATO', 'ANNULLATO', 'FATTURAZIONEKO', 'INVIATOAFATTURAZIONE', 'ESPLETAMENTOTECNICOKO','ESPLETATOOKCONSUNTIVO') &#xa;          ORDER BY RICH.CREATED DESC" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDASSET"/>
                                    <columnMetadata
                                    columnName="BDS_ID"
                                    dataType="2" typeName="NUMBER"/>
                                    <columnMetadata
                                    columnName="IDRICHIESTAOLO"
                                    dataType="-9" typeName="NVARCHAR2"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StoricizzaOLinCorso&quot;/>&lt;xsl:param name=&quot;SelectAssetTarget&quot;/>&lt;xsl:param name=&quot;logger_name&quot;/>&lt;xsl:param name=&quot;log_level&quot;/>&lt;xsl:template name=&quot;LogAsset-input&quot; match=&quot;/&quot;>&lt;tns:CW_BUS_MESSAGE>&lt;tns:GenericLogger>&lt;tns:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.bpmintegration.application&amp;quot;&quot;/>&lt;/tns:Application>&lt;tns:Process>&lt;xsl:value-of select=&quot;&amp;quot;GestioneEsitiMultipli&amp;quot;&quot;/>&lt;/tns:Process>&lt;tns:Service>&lt;xsl:value-of select=&quot;&amp;quot;EsitiMultipliPortType&amp;quot;&quot;/>&lt;/tns:Service>&lt;tns:Operation>&lt;xsl:value-of select=&quot;&amp;quot;StoricizzaOLinCorso&amp;quot;&quot;/>&lt;/tns:Operation>&lt;tns:BusinessID>&lt;xsl:value-of select=&quot;$StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdOlBloccante&quot;/>&lt;/tns:BusinessID>&lt;tns:Message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Output query su AssetTarget: &amp;quot;, tib:render-xml($SelectAssetTarget, true(), true()))&quot;/>&lt;/tns:Message>&lt;tns:LoggerName>&lt;xsl:value-of select=&quot;$logger_name&quot;/>&lt;/tns:LoggerName>&lt;tns:LogLevel>&lt;xsl:value-of select=&quot;$log_level&quot;/>&lt;/tns:LogLevel>&lt;tns:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:LogJMS>&lt;/tns:GenericLogger>&lt;/tns:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="LogAsset-input"
                                    name="LogAsset"
                                    tibex:xpdlId="cb473543-4494-4100-b627-cb4d2e3933df"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="SelectAssetTargetToLogAsset"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="LogAssetToSelectRichiesta">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogAssetToEmpty">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="exists($SelectAssetTarget/Record[1]/BDS_ID) and string-length(xsd:string(($SelectAssetTarget/Record[1]/BDS_ID)))>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[exists($SelectAssetTarget/Record[1]/BDS_ID) and string-length(xsd:string(($SelectAssetTarget/Record[1]/BDS_ID)))>0]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
