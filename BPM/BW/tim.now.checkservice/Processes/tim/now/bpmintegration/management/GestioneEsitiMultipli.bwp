                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+2d61ca4c-0901-4d64-a2d7-d2d2e4817413+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/StoricizzaOLinCorso/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;StoricizzaOLinCorso&quot;/>&lt;xsl:template name=&quot;SelectRichiesta-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;IDRICHIESTAOLO>&lt;xsl:value-of select=&quot;$StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdOlBloccante&quot;/>&lt;/IDRICHIESTAOLO>&lt;IDRISORSA>&lt;xsl:value-of select=&quot;$StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdRisorsaBloccata&quot;/>&lt;/IDRISORSA>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdRisorsaBloccata, 'W')&quot;>&lt;NUMEROTELEFONICO>&lt;xsl:value-of select=&quot;tib:trim(substring-before($StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdRisorsaBloccata, 'W'))&quot;/>&lt;/NUMEROTELEFONICO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NUMEROTELEFONICO>&lt;xsl:value-of select=&quot;$StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdRisorsaBloccata&quot;/>&lt;/NUMEROTELEFONICO>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;contains($StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdRisorsaBloccata, 'W')&quot;>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;tib:trim(substring-before($StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdRisorsaBloccata, 'W'))&quot;/>&lt;/NUMEROFITTIZIO>&lt;/xsl:when>&lt;xsl:otherwise>&lt;NUMEROFITTIZIO>&lt;xsl:value-of select=&quot;$StoricizzaOLinCorso/Input/tns1:StoricizzaOLinCorsoRequest/IdRisorsaBloccata&quot;/>&lt;/NUMEROFITTIZIO>&lt;/xsl:otherwise>&l