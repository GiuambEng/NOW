                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckOrdineInCorso/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_CheckOrdineInCorsoIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:template name=&quot;Request&quot; match=&quot;/&quot;>&#xa;        &lt;tns:REQUEST>&#xa;            &lt;tns:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckOrdineInCorsoIn.Input/tns:TRANSACTION_DATE&quot;/>&#xa;            &lt;/tns:TRANSACTION_DATE>&#xa;            &lt;tns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;            &lt;/tns:TRANSACTION_ID>&#xa;            &lt;tns:CODICE_ORDINE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckOrdineInCorsoIn.Input/tns:CODICE_ORDINE_OLO&quot;/>&#xa;            &lt;/tns:CODICE_ORDINE_OLO>&#xa;            &lt;xsl:copy-of select=&quot;$NOWtoCRMWS_CheckOrdineInCorsoIn.Input/tns:RISORSE&quot;/>&#xa;            &lt;xsl:if test=&quot;$NOWtoCRMWS_CheckOrdineInCorsoIn.Input/tns:ID_RICH_OLO&quot;>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckOrdineInCorsoIn.Input/tns:ID_RICH_OLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:REQUEST>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value processVariable="Request" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
