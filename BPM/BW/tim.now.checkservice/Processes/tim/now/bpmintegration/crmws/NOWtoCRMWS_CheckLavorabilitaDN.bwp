                        </tibex:DesignExpression>
                        <bpws:transitionCondition><![CDATA[##otherwise##]]></bpws:transitionCondition>
                    </bpws:source>
                    <bpws:source linkName="RepeatOnErrorToReply">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="not(exists($CRMWSCheckLavorabilitaDN/RESPONSE/ns12:RESPONSE))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
