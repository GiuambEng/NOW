                                expression="$CRMWSCheckLavorabilitaDN/RESPONSE/ns12:RESPONSE/ns12:RETURN_CODE='00'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
