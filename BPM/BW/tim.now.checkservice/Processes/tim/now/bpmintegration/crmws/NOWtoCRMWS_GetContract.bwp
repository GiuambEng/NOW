                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetContract/Schema.xsd&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetContract&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_GetContractIn.Input&quot;/>&#xa;    &lt;xsl:param name=&quot;TransactionID&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperContratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:REQUEST>&#xa;            &lt;tns:TRANSACTION_ID>&#xa;                &lt;xsl:value-of select=&quot;$TransactionID&quot;/>&#xa;            &lt;/tns:TRANSACTION_ID>&#xa;            &lt;tns:TRANSACTION_DATE>&#xa;                &lt;xsl:value-of select=&quot;xsd:dateTime(format-dateTime(current-dateTime(), &amp;quot;[Y0001]-[M01]-[D01]T[H01]:[m01]:[s01]&amp;quot;))&quot;/>&#xa;            &lt;/tns:TRANSACTION_DATE>&#xa;            &lt;tns:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:CODICE_OLO_CRMWS&quot;/>&#xa;            &lt;/tns:CODICE_OLO>&#xa;            &lt;tns:CODICE_OLO_CRMWS>&#xa;                &lt;xsl:value-of select=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:CODICE_OLO&quot;/>&#xa;            &lt;/tns:CODICE_OLO_CRMWS>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO = ('EASYIPNGAFTTH', 'SEMIEASYIPNGAFTTH')&quot;>&#xa;                    &lt;tns:SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;TWS EasyIP NGA FTTH&amp;quot;&quot;/>&#xa;                    &lt;/tns:SERVIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO ='EASYIPNGAFTTCAB'&quot;>&#xa;                    &