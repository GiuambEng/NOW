                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetContract/Schema.xsd2&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+993aa8d7-b62b-4f07-b51c-a9a74acf9868+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSGetContract.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCSelectContratto-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcQueryActivityInput>&#xa;            &lt;COD_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_CONTRATTO>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_OLO>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;ID_CONTRATTO_CRMWS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_ID_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_ID_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CONTRATTO_CRMWS>&#xa;            &lt;NOME_OFFERTA_ESTERNA>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA>&#xa;        &lt;/tns:jdbcQueryActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.JDBCQuery"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCQueryActivity"/>
                                    <value
                                    maxRows="100"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="SELECT CON.ID_CONTRATTO, CON.DATAFI_VALID, CON.DATAINZ_VALID&#xd;&#xa;FROM CONTRATTO CON, TRASCODFC_OFFERTA TRA, OFFERTA OFFER&#xd;&#xa;WHERE CON.COD_CONTRATTO = ? AND (CON.COD_OLO = ? OR CON.COD_OLO IS NULL) AND (CON.CODFC_OLO_AGCOM = ? OR CON.CODFC_OLO_AGCOM IS NULL)&#xd;&#xa;AND (CON.ID_CONTRATTO_CRMWS = ? OR CON.ID_CONTRATTO_CRMWS IS NULL) AND CON.ID_FAMIG_OFFERTA = OFFER.ID_FAMIG_OFFERTA AND OFFER.ID_OFFERTA = TRA.ID_OFFERTA AND TRA.NOME_OFFERTA_ESTERNA = ? AND TRA.PROVENIENZA = 'CRMWS'" xsi:type="jdbcPalette:JDBCQueryActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_CONTRATTO_CRMWS"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA"/>

                                    <columnMetadata
                                    columnName="ID_CONTRATTO"
                                    dataType="2" typeName="NUMBER"/>

                                    <columnMetadata
                                    columnName="DATAFI_VALID"
                                    dataType="93"
                                    status="OptionalElement" typeName="DATE"/>

                                    <columnMetadata
                                    columnName="DATAINZ_VALID"
                                    dataType="93" typeName="DATE"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8a20cda3-5a54-4c77-8b37-1865f5010f22+input&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetContract/Schema.xsd2&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;CRMWSGetContract&quot;/>&lt;xsl:param name=&quot;JDBCSelectContratto&quot;/>&lt;xsl:param name=&quot;SelContrattoPadre&quot;/>&lt;xsl:template name=&quot;JDBCUpdateContract-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;COD_CONTRATTO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER)&quot;>&lt;xsl:value-of select=&quot;$CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_CONTRATTO>&lt;COD_OLO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS)&quot;>&lt;xsl:value-of select=&quot;$CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_OLO>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO)&quot;>&lt;xsl:value-of select=&quot;$CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA)) > 0&quot;>&lt;DATAINZ_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA)&quot;>&lt;xsl:value-of select=&quot;$CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAINZ_VALID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATAINZ_VALID>&lt;xsl:value-of select=&quot;xsd:date($JDBCSelectContratto/Record[1]/DATAINZ_VALID)&quot;/>&lt;/DATAINZ_VALID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)) > 0&quot;>&lt;DATAFI_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)&quot;>&lt;xsl:value-of select=&quot;$CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAFI_VALID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATAFI_VALID>&lt;xsl:value-of select=&quot;tib:create-date(2999, 01, 01)&quot;/>&lt;/DATAFI_VALID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;FLAG_ABILITATO>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:FLAG_ABILITATO)&quot;>&lt;xsl:value-of select=&quot;$CRMWSGetContract/RESPONSE/ns:RESPONSE/