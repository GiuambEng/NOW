                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+e51793d7-b8de-4776-9983-30e58cdb0de4+input&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetContract/Schema.xsd2&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSGetContract.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCSequenceContract&quot;/>&#xa;    &lt;xsl:param name=&quot;SelContrattoPadre&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCInsertContract-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;Record>&#xa;                &lt;COD_CONTRATTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/COD_CONTRATTO>&#xa;                &lt;COD_OLO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/COD_OLO>&#xa;                &lt;CODFC_OLO_AGCOM>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA)) > 0&quot;>&#xa;                        &lt;DATAINZ_VALID>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA)&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/DATAINZ_VALID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;DATAINZ_VALID>&#xa;                            &lt;xsl:value-of select=&quot;current-date()&quot;/>&#xa;                        &lt;/DATAINZ_VALID>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length(string($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)) > 0&quot;>&#xa;                        &lt;DATAFI_VALID>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/DATAFI_VALID>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;DATAFI_VALID>&#xa;                            &lt;xsl:value-of select=&quot;tib:create-date(2999, 01, 01)&quot;/>&#xa;                        &lt;/DATAFI_VALID>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;FLAG_ABILITATO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FLAG_ABILITATO)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FLAG_ABILITATO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/FLAG_ABILITATO>&#xa;                &lt;FLAG_ANFIBIO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:ANFIBIO_FLG)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:ANFIBIO_FLG&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/FLAG_ANFIBIO>&#xa;                &lt;FLAG_DIFFIDATO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DIFFIDATO_FLG)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DIFFIDATO_FLG&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/FLAG_DIFFIDATO>&#xa;                &lt;FLAG_FILE_NOTIFY>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FILE_NOTIFY_FLAG)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FILE_NOTIFY_FLAG&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/FLAG_FILE_NOTIFY>&#xa;                &lt;FLAG_NPD>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NPD_FLG)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NPD_FLG&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/FLAG_NPD>&#xa;                &lt;FLAG_STANDARD>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STANDARD_FLG)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STANDARD_FLG&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/FLAG_STANDARD>&#xa;                &lt;FLAG_VALIDO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:VALID_FLG)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:VALID_FLG&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/FLAG_VALIDO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;count($SelContrattoPadre/Record) > 0&quot;>&#xa;                        &lt;ID_COD_CONTRATTO_PADRE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:int($SelContrattoPadre/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                        &lt;/ID_COD_CONTRATTO_PADRE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ID_COD_CONTRATTO_PADRE xsi:nil=&quot;true&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;ID_CONTRATTO>&#xa;                    &lt;xsl:value-of select=&quot;xsd:int($JDBCSequenceContract/Record[1]/NEXTVAL)&quot;/>&#xa;                &lt;/ID_CONTRATTO>&#xa;                &lt;ID_CONTRATTO_CRMWS>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_ID_CRMWS)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_ID_CRMWS&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/ID_CONTRATTO_CRMWS>&#xa;                &lt;NOME_OFFERTA_ESTERNA_1>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/NOME_OFFERTA_ESTERNA_1>&#xa;                &lt;NOME_OFFERTA_ESTERNA_2>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/NOME_OFFERTA_ESTERNA_2>&#xa;                &lt;STATO_CONTRATTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_CONTRATTO)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_CONTRATTO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/STATO_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO_CONTRATTO) > 0&quot;>&#xa;                        &lt;TPLG_CONTRATTO>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO_CONTRATTO)&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO_CONTRATTO&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/TPLG_CONTRATTO>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;TPLG_CONTRATTO xsi:nil=&quot;true&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;NOME_CONTRATTO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NAME)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NAME&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/NOME_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_STANDARD) > 0&quot;>&#xa;                        &lt;NOME_STANDARD>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NOME_STANDARD)&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NOME_STANDARD&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/NOME_STANDARD>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;NOME_STANDARD xsi:nil=&quot;true&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;string-length($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_STANDARD) > 0&quot;>&#xa;                        &lt;STATO_STANDARD>&#xa;                            &lt;xsl:choose>&#xa;                                &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_STANDARD)&quot;>&#xa;                                    &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_STANDARD&quot;/>&#xa;                                &lt;/xsl:when>&#xa;                                &lt;xsl:otherwise>&#xa;                                    &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                                &lt;/xsl:otherwise>&#xa;                            &lt;/xsl:choose>&#xa;                        &lt;/STATO_STANDARD>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;STATO_STANDARD xsi:nil=&quot;true&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;                &lt;TIMSTP_INSMTO>&#xa;                    &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                &lt;/TIMSTP_INSMTO>&#xa;                &lt;TIPO>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO)&quot;>&#xa;                            &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO&quot;/>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/TIPO>&#xa;                &lt;OPERATORE>&#xa;                    &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;                &lt;/OPERATORE>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists(xsd:integer($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CUSTOMER))&quot;>&#xa;                        &lt;ID_TPLG_OPERATORE>&#xa;                            &lt;xsl:value-of select=&quot;xsd:integer($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CUSTOMER)&quot;/>&#xa;                        &lt;/ID_TPLG_OPERATORE>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/Record>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    batchUpdate="true"
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="INSERT INTO CONTRATTO(COD_CONTRATTO, COD_OLO, CODFC_OLO_AGCOM,&#xd;&#xa;DATAINZ_VALID, DATAFI_VALID, FLAG_ABILITATO, FLAG_ANFIBIO, FLAG_DIFFIDATO, FLAG_FILE_NOTIFY,&#xd;&#xa;FLAG_NPD, FLAG_STANDARD, FLAG_VALIDO, ID_COD_CONTRATTO_PADRE, ID_CONTRATTO, ID_CONTRATTO_CRMWS,&#xd;&#xa;ID_FAMIG_OFFERTA, ID_SOTTOFAMIG_OFFERTA, ID_STATO_CONTRATTO, IDTPLG_CONTRATTO, NOME_CONTRATTO,&#xd;&#xa;NOME_STANDARD, STATO_STANDARD, TIMSTP_INSMTO, TIPO, OPERATORE,ID_TPLG_OPERATORE)&#xd;&#xa;VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,&#xd;&#xa;(SELECT ID_FAMIG_OFFERTA FROM TRASCODFC_OFFERTA TSF JOIN OFFERTA OFF ON OFF.ID_OFFERTA = TSF.ID_OFFERTA WHERE TSF.NOME_OFFERTA_ESTERNA = ? AND PROVENIENZA = 'CRMWS'),&#xd;&#xa;(SELECT ID_SOTTOFAMIG_OFFERTA FROM TRASCODFC_OFFERTA TSF JOIN OFFERTA OFF ON OFF.ID_OFFERTA = TSF.ID_OFFERTA WHERE TSF.NOME_OFFERTA_ESTERNA = ? AND PROVENIENZA = 'CRMWS'),&#xd;&#xa;(SELECT ID_STATO_CONTRATTO FROM TIPOLG_STATO_CONTRATTO WHERE DESCRIPTION = ?),&#xd;&#xa;(SELECT IDTPLG_CONTRATTO FROM TIPOLG_CONTRATTO WHERE DESCR_ESTERNA = ?), ?, ?, ?, ?, ?, ?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_ABILITATO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_ANFIBIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_DIFFIDATO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_FILE_NOTIFY"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_NPD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_STANDARD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_VALIDO"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_COD_CONTRATTO_PADRE"/>

                                    <PreparedParameters
                                    DataType="4"
                                    DataTypeDisplayValue="INTEGER" ParameterName="ID_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_CONTRATTO_CRMWS"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA_1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA_2"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TPLG_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_STANDARD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_STANDARD"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE"/>

