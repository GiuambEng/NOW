                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCSelectOfferta&quot;/>&lt;xsl:param name=&quot;_error_JDBCInsertContract&quot;/>&lt;xsl:param name=&quot;_error_JDBCUpdateContract&quot;/>&lt;xsl:param name=&quot;_error_JDBCInsertOffertaCTLG1&quot;/>&lt;xsl:param name=&quot;_error_JDBCUpdateOffertaCTLG&quot;/>&lt;xsl:param name=&quot;_error_JDBCUpdateOffertaCTLG1&quot;/>&lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;not(exists($JDBCSelectOfferta/Record))&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;OFFERTA non trovata.&amp;quot;&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO OFFERTA non trovata.&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($_error_JDBCUpdateOffertaCTLG1)&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;UpdateOffertaCTLG1 non riuscito.&amp;quot;&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO update.&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($_error_JDBCInsertOffertaCTLG1)&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;InsertOffertaCTLG1.&amp;quot;&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO-Update non riuscito..&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($_error_JDBCInsertContract)&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;tib:render-xml($_error_JDBCInsertContract, true(), true())&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO ERRORE nell'insert in CONTRATTO.&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($_error_JDBCUpdateContract)&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;tib:render-xml($_error_JDBCUpdateContract, true(), true())&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO ERRORE nell'insert in CONTRATTO_OFFERTA_CATLG.&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($_error_JDBCUpdateContract)&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;tib:render-xml($_error_JDBCUpdateContract, true(), true())&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO ERRORE nell'update in CONTRATTO.&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:when test=&quot;exists($_error_JDBCUpdateOffertaCTLG)&quot;>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;tib:render-xml($_error_JDBCUpdateOffertaCTLG, true(), true())&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO ERRORE nell'update in CONTRATTO_OFFERTA_CATLG.&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:DefaultFault>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;Sequence non staccata.&amp;quot;&quot;/>&lt;/message>&lt;msgCode>&lt;xsl:value-of select=&quot;&amp;quot;KO Sequence non staccata.&amp;quot;&quot;/>&lt;/msgCode>&lt;/tns:DefaultFault>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
