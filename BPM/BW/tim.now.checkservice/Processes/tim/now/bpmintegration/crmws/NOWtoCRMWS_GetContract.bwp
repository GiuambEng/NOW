                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+8a20cda3-5a54-4c77-8b37-1865f5010f22+input&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetContract/Schema.xsd2&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSGetContract.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCSelectContratto&quot;/>&#xa;    &lt;xsl:param name=&quot;SelContrattoPadre&quot;/>&#xa;    &lt;xsl:template name=&quot;JDBCUpdateContract-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;COD_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NUMBER&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_CONTRATTO>&#xa;            &lt;COD_OLO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_OLO>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CODICE_OLO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/CODFC_OLO_AGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA)) > 0&quot;>&#xa;                    &lt;DATAINZ_VALID>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DATAINZ_VALID>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATAINZ_VALID>&#xa;                        &lt;xsl:value-of select=&quot;xsd:date($JDBCSelectContratto/Record[1]/DATAINZ_VALID)&quot;/>&#xa;                    &lt;/DATAINZ_VALID>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length(string($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)) > 0&quot;>&#xa;                    &lt;DATAFI_VALID>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/DATAFI_VALID>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;DATAFI_VALID>&#xa;                        &lt;xsl:value-of select=&quot;tib:create-date(2999, 01, 01)&quot;/>&#xa;                    &lt;/DATAFI_VALID>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;FLAG_ABILITATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FLAG_ABILITATO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FLAG_ABILITATO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_ABILITATO>&#xa;            &lt;FLAG_ANFIBIO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:ANFIBIO_FLG)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:ANFIBIO_FLG&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_ANFIBIO>&#xa;            &lt;FLAG_DIFFIDATO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DIFFIDATO_FLG)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:DIFFIDATO_FLG&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_DIFFIDATO>&#xa;            &lt;FLAG_FILE_NOTIFY>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FILE_NOTIFY_FLAG)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:FILE_NOTIFY_FLAG&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_FILE_NOTIFY>&#xa;            &lt;FLAG_NPD>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NPD_FLG)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NPD_FLG&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_NPD>&#xa;            &lt;FLAG_STANDARD>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STANDARD_FLG)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STANDARD_FLG&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_STANDARD>&#xa;            &lt;FLAG_VALIDO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:VALID_FLG)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:VALID_FLG&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/FLAG_VALIDO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;count($SelContrattoPadre/Record) > 0&quot;>&#xa;                    &lt;ID_COD_CONTRATTO_PADRE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:int($SelContrattoPadre/Record[1]/ID_CONTRATTO)&quot;/>&#xa;                    &lt;/ID_COD_CONTRATTO_PADRE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_COD_CONTRATTO_PADRE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_CONTRATTO_CRMWS>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_ID_CRMWS)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_ID_CRMWS&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CONTRATTO_CRMWS>&#xa;            &lt;NOME_OFFERTA_ESTERNA_1>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:SERVIZIO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_OFFERTA_ESTERNA_1>&#xa;            &lt;ID_STATO_CONTRATTO_DESCRIPTION>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_CONTRATTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_CONTRATTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_STATO_CONTRATTO_DESCRIPTION>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO_CONTRATTO) > 0&quot;>&#xa;                    &lt;IDTPLG_CONTRATTO_DESCR>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO_CONTRATTO)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO_CONTRATTO&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/IDTPLG_CONTRATTO_DESCR>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;IDTPLG_CONTRATTO_DESCR xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;NOME_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NAME)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:AGREE_NAME&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/NOME_CONTRATTO>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NOME_STANDARD) > 0&quot;>&#xa;                    &lt;NOME_STANDARD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NOME_STANDARD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:NOME_STANDARD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/NOME_STANDARD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;NOME_STANDARD xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_STANDARD) > 0&quot;>&#xa;                    &lt;STATO_STANDARD>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_STANDARD)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:STATO_STANDARD&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/STATO_STANDARD>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;STATO_STANDARD xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;TIMSTP_INSMTO>&#xa;                &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;            &lt;/TIMSTP_INSMTO>&#xa;            &lt;TIPO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:TIPO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIPO>&#xa;            &lt;OPERATORE>&#xa;                &lt;xsl:value-of select=&quot;&amp;quot;AUTOMATICO&amp;quot;&quot;/>&#xa;            &lt;/OPERATORE>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CUSTOMER)&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($CRMWSGetContract.RESPONSE/ns:CONTRATTO[number($index)]/ns:CUSTOMER)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;ID_CONTRATTO>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($JDBCSelectContratto/Record[1]/ID_CONTRATTO)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$JDBCSelectContratto/Record[1]/ID_CONTRATTO&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/ID_CONTRATTO>&#xa;        &lt;/tns:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.jdbc.update"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:jdbcPalette="http://ns.tibco.com/bw/palette/jdbc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <attributeBindings
                                    bindingType="moduleProperty"
                                    eAttributeName="timeout" processProperty="JDBCTimeout"/>
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/jdbc#//JDBCUpdateActivity"/>
                                    <value
                                    sharedResourceProperty="jdbcProperty"
                                    sqlStatement="UPDATE CONTRATTO&#xd;&#xa;SET COD_CONTRATTO = ?,&#xd;&#xa;COD_OLO = ?,&#xd;&#xa;CODFC_OLO_AGCOM = ?,&#xd;&#xa;DATAINZ_VALID = ?,&#xd;&#xa;DATAFI_VALID = ?,&#xd;&#xa;FLAG_ABILITATO = ?,&#xd;&#xa;FLAG_ANFIBIO = ?,&#xd;&#xa;FLAG_DIFFIDATO = ?,&#xd;&#xa;FLAG_FILE_NOTIFY = ?,&#xd;&#xa;FLAG_NPD = ?,&#xd;&#xa;FLAG_STANDARD = ?,&#xd;&#xa;FLAG_VALIDO = ?,&#xd;&#xa;ID_COD_CONTRATTO_PADRE = ?,&#xd;&#xa;ID_CONTRATTO_CRMWS = ?,&#xd;&#xa;ID_FAMIG_OFFERTA = (SELECT OFFER.ID_FAMIG_OFFERTA FROM TRASCODFC_OFFERTA TRA, OFFERTA OFFER WHERE TRA.ID_OFFERTA = OFFER.ID_OFFERTA AND TRA.NOME_OFFERTA_ESTERNA = ? AND PROVENIENZA = 'CRMWS'),&#xd;&#xa;ID_STATO_CONTRATTO = (SELECT ID_STATO_CONTRATTO FROM TIPOLG_STATO_CONTRATTO WHERE DESCRIPTION = ?),&#xd;&#xa;IDTPLG_CONTRATTO = (SELECT IDTPLG_CONTRATTO FROM TIPOLG_CONTRATTO WHERE DESCR_ESTERNA = ?),&#xd;&#xa;NOME_CONTRATTO = ?,&#xd;&#xa;NOME_STANDARD = ?,&#xd;&#xa;STATO_STANDARD = ?,&#xd;&#xa;TIMSTP_INSMTO = ?,&#xd;&#xa;TIPO = ?,&#xd;&#xa;OPERATORE = ?,&#xd;&#xa;ID_TPLG_OPERATORE=?&#xd;&#xa;WHERE ID_CONTRATTO = ?" xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="COD_OLO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="CODFC_OLO_AGCOM"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAINZ_VALID"/>

                                    <PreparedParameters
                                    DataType="91"
                                    DataTypeDisplayValue="DATE" ParameterName="DATAFI_VALID"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_ABILITATO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_ANFIBIO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_DIFFIDATO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_FILE_NOTIFY"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_NPD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_STANDARD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="FLAG_VALIDO"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_COD_CONTRATTO_PADRE"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_CONTRATTO_CRMWS"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_OFFERTA_ESTERNA_1"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="ID_STATO_CONTRATTO_DESCRIPTION"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="IDTPLG_CONTRATTO_DESCR"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_CONTRATTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="NOME_STANDARD"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="STATO_STANDARD"/>

                                    <PreparedParameters
                                    DataType="93"
                                    DataTypeDisplayValue="TIMESTAMP" ParameterName="TIMSTP_INSMTO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="TIPO"/>

                                    <PreparedParameters
                                    DataType="12"
                                    DataTypeDisplayValue="VARCHAR" ParameterName="OPERATORE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_TPLG_OPERATORE"/>

                                    <PreparedParameters
                                    DataType="2"
                                    DataTypeDisplayValue="NUMERIC" ParameterName="ID_CONTRATTO"/>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+90724887-4e7f-4e09-ac03-5c18b9b67a85+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSGetContract/Schema.xsd2&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;JDBCSelectContratto&quot;/>&lt;xsl:param name=&quot;JDBCSelectOfferta&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;CRMWSGetContract&quot;/>&lt;xsl:template name=&quot;JDBCUpdateOffertaCTLG-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)) > 0&quot;>&lt;DATAFI_ASSOCZ_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA)&quot;>&lt;xsl:value-of select=&quot;$CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_FINE_VALIDITA&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/DATAFI_ASSOCZ_VALID>&lt;/xsl:when>&lt;xsl:otherwise>&lt;DATAFI_ASSOCZ_VALID>&lt;xsl:value-of select=&quot;tib:create-date(2999, 01, 01)&quot;/>&lt;/DATAFI_ASSOCZ_VALID>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:choose>&lt;xsl:when test=&quot;string-length(string($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CONTRATTO[number($index)]/ns:DATA_INIZIO_VALIDITA)) > 0&quot;>&lt;DATAINZ_ASSOCZ_VALID>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSGetContract/RESPONSE/ns:RESPONSE/ns:CON