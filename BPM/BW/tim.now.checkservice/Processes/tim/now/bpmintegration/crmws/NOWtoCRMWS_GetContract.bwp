2:ID_PROCSO_NO_FILE&gt;&lt;xsl:value-of select="$GetContractID"/&gt;&lt;/ns2:ID_PROCSO_NO_FILE&gt;&lt;ns2:STATO_ESEC&gt;&lt;xsl:value-of select="&amp;quot;IN ELABORAZIONE&amp;quot;"/&gt;&lt;/ns2:STATO_ESEC&gt;&lt;ns2:TMSP_INIZIO_ELAB&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns2:TMSP_INIZIO_ELAB&gt;&lt;/ns2:EsecuzioneNOFileProcessato&gt;&lt;ns2:LogFileProcessato&gt;&lt;ns2:LOG_LEVEL&gt;&lt;xsl:value-of select="&amp;quot;INFO&amp;quot;"/&gt;&lt;/ns2:LOG_LEVEL&gt;&lt;ns2:LOG_MESSAGE&gt;&lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML INVIATA&amp;quot;"/&gt;&lt;/ns2:LOG_MESSAGE&gt;&lt;ns2:TIMSTP_INSMTO&gt;&lt;xsl:value-of select="current-dateTime()"/&gt;&lt;/ns2:TIMSTP_INSMTO&gt;&lt;/ns2:LogFileProcessato&gt;&lt;/tns1:LoggerIn&gt;&lt;/tns1:StagingRequest&gt;&lt;/REQUEST&gt;&lt;/tns:InsertUpdateStagingRequest&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
