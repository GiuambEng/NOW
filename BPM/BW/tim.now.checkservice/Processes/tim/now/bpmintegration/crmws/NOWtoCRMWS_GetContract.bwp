select=&quot;current-dateTime()&quot;/>&#xa;                    &lt;/tns:Timestamp>&#xa;                    &lt;tns:ErrorLog>&#xa;                        &lt;tns:TimeStamp>&#xa;                            &lt;xsl:value-of select=&quot;current-dateTime()&quot;/>&#xa;                        &lt;/tns:TimeStamp>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;Errore su NOWtoCRMWS_GetContract&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:track_position>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;IN&amp;quot;&quot;/>&#xa;                        &lt;/tns:track_position>&#xa;                        &lt;tns:ErrorReport>&#xa;                            &lt;tns:StackTrace>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/StackTrace&quot;/>&#xa;                            &lt;/tns:StackTrace>&#xa;                            &lt;tns:Msg>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/Msg&quot;/>&#xa;                            &lt;/tns:Msg>&#xa;                            &lt;tns:ProcessStack>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/ProcessStack&quot;/>&#xa;                            &lt;/tns:ProcessStack>&#xa;                            &lt;tns:MsgCode>&#xa;                                &lt;xsl:value-of select=&quot;$FaultDetails/MsgCode&quot;/>&#xa;                            &lt;/tns:MsgCode>&#xa;                            &lt;tns:Data/>&#xa;                        &lt;/tns:ErrorReport>&#xa;                    &lt;/tns:ErrorLog>&#xa;                &lt;/tns:Envelope>&#xa;            &lt;/tns:ActiveLoggerServices>&#xa;        &lt;/tns:CW_BUS_MESSAGE>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
