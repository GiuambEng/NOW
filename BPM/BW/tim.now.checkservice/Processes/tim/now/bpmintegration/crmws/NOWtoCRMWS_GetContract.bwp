xa;                    &lt;/tns:SERVIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO=&amp;quot;WLRLINEAATTIVA&amp;quot;&quot;>&#xa;                    &lt;tns:SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;WLR Linea Attiva&amp;quot;&quot;/>&#xa;                    &lt;/tns:SERVIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO=&amp;quot;WLRLINEANONATTIVA&amp;quot;&quot;>&#xa;                    &lt;tns:SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;WLR Linea Non Attiva&amp;quot;&quot;/>&#xa;                    &lt;/tns:SERVIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO=&amp;quot;SHACONMANODOPERA&amp;quot;&quot;>&#xa;                    &lt;tns:SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SHA con Manodopera&amp;quot;&quot;/>&#xa;                    &lt;/tns:SERVIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO=&amp;quot;SHASENZAMANODOPERA&amp;quot;&quot;>&#xa;                    &lt;tns:SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;SHA senza Manodopera&amp;quot;&quot;/>&#xa;                    &lt;/tns:SERVIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO=&amp;quot;ULLLINEAATTIVA&amp;quot;&quot;>&#xa;                    &lt;tns:SERVIZIO>&#xa;                        &lt;xsl:value-of select=&quot;&amp;quot;ULL Linea Attiva&amp;quot;&quot;/>&#xa;                    &lt;/tns:SERVIZIO>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;$NOWtoCRMWS_GetContractIn.Input/tns1:SERVIZIO=&amp;quot;SLULINEAATTIVA&amp;quot;&quot