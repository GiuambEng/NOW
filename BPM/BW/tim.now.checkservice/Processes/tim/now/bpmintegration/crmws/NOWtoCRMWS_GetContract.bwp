                            <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns1="http://www.tim.com/NOW/xsd/InsertUpdateStaging/" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tim.now.sharedlibrary.logprocess.telecom" xmlns:tns2="http://www.tim.com/NOW/xsd/NOWtoCRMWS_GetContract" xmlns:ns="http://www.tim.com/NOW/wsdl/concrete/InsertUpdateStaging" xmlns:tns="http://www.tim.com/NOW/wsdl/abstract/InsertUpdateStaging" version="2.0"&gt;
    &lt;xsl:param name="GetContractID"/&gt;
    &lt;xsl:param name="ProcessoInsertStagingGetContract"/&gt;
    &lt;xsl:param name="NOWtoCRMWS_GetContractIn"/&gt;
    &lt;xsl:template name="UpdateStagingKO-input" match="/"&gt;
        &lt;tns:InsertUpdateStagingRequest&gt;
            &lt;REQUEST&gt;
                &lt;tns1:StagingRequest&gt;
                    &lt;tns1:StagingOut&gt;
                        &lt;tns1:DESCR_ERRORE&gt;
                            &lt;xsl:value-of select="&amp;quot;KO nella chiamata al CRMWS.&amp;quot;"/&gt;
                        &lt;/tns1:DESCR_ERRORE&gt;
                        &lt;xsl:if test="$NOWtoCRMWS_GetContractIn/Input/tns2:REQUEST/tns2:ID_RICH_OLO"&gt;
                            &lt;tns1:ID_RICH&gt;
                                &lt;xsl:value-of select="$NOWtoCRMWS_GetContractIn/Input/tns2:REQUEST/tns2:ID_RICH_OLO"/&gt;
                            &lt;/tns1:ID_RICH&gt;
                        &lt;/xsl:if&gt;
                        &lt;tns1:ID_STATO_ELAB_STAG&gt;
                            &lt;xsl:value-of select="12"/&gt;
                        &lt;/tns1:ID_STATO_ELAB_STAG&gt;
                        &lt;tns1:TIMSTP_RISPOSTA&gt;
                            &lt;xsl:value-of select="current-dateTime()"/&gt;
                        &lt;/tns1:TIMSTP_RISPOSTA&gt;
                    &lt;/tns1:StagingOut&gt;
                    &lt;tns1:StagingType&gt;
                        &lt;xsl:value-of select="&amp;quot;STAG_RET_CONTR_NOFOUT&amp;quot;"/&gt;
                    &lt;/tns1:StagingType&gt;
                    &lt;tns1:LoggerIn&gt;
                        &lt;ns1:TipologiaProcesso&gt;
                            &lt;xsl:value-of select="&amp;quot;NOFILE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaProcesso&gt;
                        &lt;ns1:TipologiaOperazione&gt;
                            &lt;xsl:value-of select="&amp;quot;UPDATE&amp;quot;"/&gt;
                        &lt;/ns1:TipologiaOperazione&gt;
                        &lt;ns1:EsecuzioneNOFileProcessato&gt;
                            &lt;xsl:if test="$ProcessoInsertStagingGetContract/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE"&gt;
                                &lt;ns1:COD_PROCSO_FILE&gt;
                                    &lt;xsl:value-of select="$ProcessoInsertStagingGetContract/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:COD_PROCSO_NO_FILE"/&gt;
                                &lt;/ns1:COD_PROCSO_FILE&gt;
                            &lt;/xsl:if&gt;
                            &lt;ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="xsd:integer(xsd:decimal($ProcessoInsertStagingGetContract/RESPONSE/tns1:StagingResponse/tns1:LogResponse/ns1:ID_ESEC_PROCSO_NOFILE))"/&gt;
                            &lt;/ns1:ID_ESEC_PROCSO_NO_FILE&gt;
                            &lt;ns1:ID_PROCSO_NO_FILE&gt;
                                &lt;xsl:value-of select="$GetContractID"/&gt;
                            &lt;/ns1:ID_PROCSO_NO_FILE&gt;
                            &lt;ns1:STATO_ESEC&gt;
                                &lt;xsl:value-of select="&amp;quot;PROCESSO ESEGUITO CON ERRORE&amp;quot;"/&gt;
                            &lt;/ns1:STATO_ESEC&gt;
                            &lt;ns1:TMSP_FINE_ELAB&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TMSP_FINE_ELAB&gt;
                        &lt;/ns1:EsecuzioneNOFileProcessato&gt;
                        &lt;ns1:LogFileProcessato&gt;
                            &lt;ns1:LOG_LEVEL&gt;
                                &lt;xsl:value-of select="&amp;quot;ERROR&amp;quot;"/&gt;
                            &lt;/ns1:LOG_LEVEL&gt;
                            &lt;ns1:LOG_MESSAGE&gt;
                                &lt;xsl:value-of select="&amp;quot;DA NOW A SIS EST SINC: RICHIESTA XML NON INVIATA&amp;quot;"/&gt;
                            &lt;/ns1:LOG_MESSAGE&gt;
                            &lt;ns1:TIMSTP_INSMTO&gt;
                                &lt;xsl:value-of select="current-dateTime()"/&gt;
                            &lt;/ns1:TIMSTP_INSMTO&gt;
                        &lt;/ns1:LogFileProcessato&gt;
                    &lt;/tns1:LoggerIn&gt;
                &lt;/tns1:StagingRequest&gt;
            &lt;/REQUEST&gt;
        &lt;/tns:InsertUpdateStagingRequest&gt;
    &lt;/xsl:template&gt;
&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                            <tibex:inputBindings>
