                                    sqlStatement="INSERT INTO ANAG_VLAN&#xa;  ( TIPO_BANDA , TIPO_COS , NOME , STATO , CLLI ,&#xa;      NOME_CENTRALE , DEC_ATTIVAZIONE ,&#xa;      DEC , COD_AREA_RACCOLTA , DESC_AREA_RACCOLTA ,&#xa;      COD_MACRO_AREA , DESC_MACRO_AREA , COD_SUPER_MACRO_AREA ,&#xa;      DESC_SUPER_MACRO_AREA , TIPO_TRASPORTO , ID_VLAN_OLO ,&#xa;      FLAG_VLAN_TRANSLATION , DSLAM_TYPE ,COD_KIT ,FLAG_ENCAPSULATION ,TIPOLG,COD_VLAN,ID_TPLG_OPERATORE,BMC_LIGHT)&#xa;   VALUES (?,?,?,?,?,?,TO_DATE(?, 'DD-MM-YYYY'),TO_DATE(?, 'DD-MM-YYYY'),&#xa;  ?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)" xsi:type="jdbcPalette:JDBCUpdateActivity">

