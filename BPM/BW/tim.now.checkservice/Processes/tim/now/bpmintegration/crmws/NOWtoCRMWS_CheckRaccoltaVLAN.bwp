                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://www.tibco.com/NOWtoCRMWS_CheckRaccoltaVLAN/" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2" xmlns:tns1="http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/" version="2.0"&gt;&lt;xsl:param name="CRMWSCheckRaccoltaVLAN"/&gt;&lt;xsl:template name="NOWtoCRMWS_CheckRaccoltaVLANOut-input" match="/"&gt;&lt;tns:NOWtoCRMWS_CheckRaccoltaVLANResponse&gt;&lt;parameters&gt;&lt;tns1:NOWtoCRMWS_CheckRaccoltaVLANResponse&gt;&lt;tns1:ESITO&gt;&lt;xsl:value-of select="$CRMWSCheckRaccoltaVLAN/RESPONSE/ns:RESPONSE/ns:ESITO"/&gt;&lt;/tns1:ESITO&gt;&lt;tns1:CODICE_CAUSALE&gt;&lt;xsl:value-of select="$CRMWSCheckRaccoltaVLAN/RESPONSE/ns:RESPONSE/ns:CODICE_CAUSALE"/&gt;&lt;/tns1:CODICE_CAUSALE&gt;&lt;tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:value-of select="upper-case($CRMWSCheckRaccoltaVLAN/RESPONSE/ns:RESPONSE/ns:DESCRIZIONE_CAUSALE)"/&gt;&lt;/tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:for-each select="$CRMWSCheckRaccoltaVLAN/RESPONSE/ns:RESPONSE/ns:INFO_VLAN"&gt;&lt;tns1:RESPONSE_INFO_VLAN&gt;&lt;tns1:CVLAN_ID&gt;&lt;xsl:value-of select="ns:CVLAN_ID"/&gt;&lt;/tns1:CVLAN_ID&gt;&lt;tns1:SVLAN_CODE&gt;&lt;xsl:value-of select="ns:SVLAN_CODE"/&gt;&lt;/tns1:SVLAN_CODE&gt;&lt;tns1:CODICE_CAUSALE&gt;&lt;xsl:value-of select="ns:CODICE_CAUSALE"/&gt;&lt;/tns1:CODICE_CAUSALE&gt;&lt;xsl:choose&gt;&lt;xsl:when test="ns:DESCRIZIONE_CAUSALE ='K0 Generico'"&gt;&lt;tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:value-of select="&amp;quot;KOGENERICO&amp;quot;"/&gt;&lt;/tns1:DESCRIZIONE_CAUSALE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="ns:DESCRIZIONE_CAUSALE ='VLAN_Non_Associata_Ad_OLO'"&gt;&lt;tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:value-of select="&amp;quot;VLANNONASSOCIATAADOLO&amp;quot;"/&gt;&lt;/tns1:DESCRIZIONE_CAUSALE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="ns:DESCRIZIONE_CAUSALE ='VLAN_Inesistente'"&gt;&lt;tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:value-of select="&amp;quot;VLANINESISTENTE&amp;quot;"/&gt;&lt;/tns1:DESCRIZIONE_CAUSALE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="ns:DESCRIZIONE_CAUSALE ='VLAN_Cessata_O_In_Cessazione'"&gt;&lt;tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:value-of select="&amp;quot;VLANCESSATAOINCESSAZIONE&amp;quot;"/&gt;&lt;/tns1:DESCRIZIONE_CAUSALE&gt;&lt;/xsl:when&gt;&lt;xsl:when test="ns:DESCRIZIONE_CAUSALE ='Coppia_Esistente'"&gt;&lt;tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:value-of select="'COPPIAESISTENTE'"/&gt;&lt;/tns1:DESCRIZIONE_CAUSALE&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;tns1:DESCRIZIONE_CAUSALE&gt;&lt;xsl:value-of select="upper-case(ns:DESCRIZIONE_CAUSALE)"/&gt;&lt;/tns1:DESCRIZIONE_CAUSALE&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;tns1:INFO_VLAN&gt;&lt;tns1:IDVLAN&gt;&lt;xsl:value-of select="ns:VLAN/ns:IDVLAN"/&gt;&lt;/tns1:IDVLAN&gt;&lt;tns1:TIPO_BANDA&gt;&lt;xsl:value-of select="ns:VLAN/ns:TIPO_BANDA"/&gt;&lt;/tns1:TIPO_BANDA&gt;&lt;tns1:TIPO_COS&gt;&lt;xsl:value-of select="ns:VLAN/ns:TIPO_COS"/&gt;&lt;/tns1:TIPO_COS&gt;&lt;tns1:CODIFICAOLOAGCOM&gt;&lt;xsl:value-of select="ns:VLAN/ns:OLO_CODING"/&gt;&lt;/tns1:CODIFICAOLOAGCOM&gt;&lt;tns1:COD_OLO&gt;&lt;xsl:value-of select="ns:VLAN/ns:OLO_CODE"/&gt;&lt;/tns1:COD_OLO&gt;&lt;xsl:if test="ns:VLAN/ns:OLO_CODING_SUB"&gt;&lt;tns1:OLO_CODING_SUB&gt;&lt;xsl:value-of select="ns:VLAN/ns:OLO_CODING_SUB"/&gt;&lt;/tns1:OLO_CODING_SUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:OLO_CODE_SUB"&gt;&lt;tns1:OLO_CODE_SUB&gt;&lt;xsl:value-of select="ns:VLAN/ns:OLO_CODE_SUB"/&gt;&lt;/tns1:OLO_CODE_SUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:STATO_SUB"&gt;&lt;tns1:STATO_SUB&gt;&lt;xsl:value-of select="ns:VLAN/ns:STATO_SUB"/&gt;&lt;/tns1:STATO_SUB&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:DATA_CESSAZIONE_SUB"&gt;&lt;tns1:DATA_CESSAZIONE_SUB&gt;&lt;xsl:value-of select="ns:VLAN/ns:DATA_CESSAZIONE_SUB"/&gt;&lt;/tns1:DATA_CESSAZIONE_SUB&gt;&lt;/xsl:if&gt;&lt;tns1:ENCAPSULATION&gt;&lt;xsl:value-of select="ns:VLAN/ns:ENCAPSULATION"/&gt;&lt;/tns1:ENCAPSULATION&gt;&lt;tns1:TIPOLOGIA&gt;&lt;xsl:value-of select="ns:VLAN/ns:TIPOLOGIA"/&gt;&lt;/tns1:TIPOLOGIA&gt;&lt;tns1:STATO&gt;&lt;xsl:value-of select="ns:VLAN/ns:STATO"/&gt;&lt;/tns1:STATO&gt;&lt;tns1:NOME&gt;&lt;xsl:value-of select="ns:VLAN/ns:NOME"/&gt;&lt;/tns1:NOME&gt;&lt;tns1:CLLI&gt;&lt;xsl:value-of select="ns:VLAN/ns:CLLI"/&gt;&lt;/tns1:CLLI&gt;&lt;tns1:NOME_CENTRALE&gt;&lt;xsl:value-of select="ns:VLAN/ns:NOME_CENTRALE"/&gt;&lt;/tns1:NOME_CENTRALE&gt;&lt;tns1:TD_KIT&gt;&lt;xsl:value-of select="ns:VLAN/ns:TD_KIT"/&gt;&lt;/tns1:TD_KIT&gt;&lt;tns1:DEC_ATT&gt;&lt;xsl:value-of select="ns:VLAN/ns:DEC_ATT"/&gt;&lt;/tns1:DEC_ATT&gt;&lt;tns1:DEC&gt;&lt;xsl:value-of select="ns:VLAN/ns:DEC"/&gt;&lt;/tns1:DEC&gt;&lt;tns1:ADR_CODE&gt;&lt;xsl:value-of select="ns:VLAN/ns:ADR_CODE"/&gt;&lt;/tns1:ADR_CODE&gt;&lt;tns1:ADR_DESC&gt;&lt;xsl:value-of select="ns:VLAN/ns:ADR_DESC"/&gt;&lt;/tns1:ADR_DESC&gt;&lt;tns1:MACRO_AREA_CODE&gt;&lt;xsl:value-of select="ns:VLAN/ns:MACRO_AREA_CODE"/&gt;&lt;/tns1:MACRO_AREA_CODE&gt;&lt;tns1:MACRO_AREA_DESC&gt;&lt;xsl:value-of select="ns:VLAN/ns:MACRO_AREA_DESC"/&gt;&lt;/tns1:MACRO_AREA_DESC&gt;&lt;xsl:if test="ns:VLAN/ns:SUPER_MACRO_AREA_CODE"&gt;&lt;tns1:SUPER_MACRO_AREA_CODE&gt;&lt;xsl:value-of select="ns:VLAN/ns:SUPER_MACRO_AREA_CODE"/&gt;&lt;/tns1:SUPER_MACRO_AREA_CODE&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:SUPER_MACRO_AREA_DESC"&gt;&lt;tns1:SUPER_MACRO_AREA_DESC&gt;&lt;xsl:value-of select="ns:VLAN/ns:SUPER_MACRO_AREA_DESC"/&gt;&lt;/tns1:SUPER_MACRO_AREA_DESC&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:TIPO_TRASPORTO"&gt;&lt;tns1:TIPO_TRASPORTO&gt;&lt;xsl:value-of select="ns:VLAN/ns:TIPO_TRASPORTO"/&gt;&lt;/tns1:TIPO_TRASPORTO&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:IDVLANOLO"&gt;&lt;tns1:IDVLANOLO&gt;&lt;xsl:value-of select="ns:VLAN/ns:IDVLANOLO"/&gt;&lt;/tns1:IDVLANOLO&gt;&lt;/xsl:if&gt;&lt;tns1:FLAG_VLAN_TRANSLATION&gt;&lt;xsl:value-of select="ns:VLAN/ns:FLAG_VLAN_TRANSLATION"/&gt;&lt;/tns1:FLAG_VLAN_TRANSLATION&gt;&lt;xsl:if test="ns:VLAN/ns:DSLAM_TYPE"&gt;&lt;tns1:DSLAM_TYPE&gt;&lt;xsl:value-of select="ns:VLAN/ns:DSLAM_TYPE"/&gt;&lt;/tns1:DSLAM_TYPE&gt;&lt;/xsl:if&gt;&lt;xsl:choose&gt;&lt;xsl:when test="ns:VLAN/ns:CUSTOMER='CSPA'"&gt;&lt;tns1:CUSTOMER&gt;&lt;xsl:value-of select="'1'"/&gt;&lt;/tns1:CUSTOMER&gt;&lt;/xsl:when&gt;&lt;xsl:otherwise&gt;&lt;xsl:if test="ns:VLAN/ns:CUSTOMER"&gt;&lt;tns1:CUSTOMER&gt;&lt;xsl:value-of select="ns:VLAN/ns:CUSTOMER"/&gt;&lt;/tns1:CUSTOMER&gt;&lt;/xsl:if&gt;&lt;/xsl:otherwise&gt;&lt;/xsl:choose&gt;&lt;xsl:if test="ns:VLAN/ns:BMC_LIGHT"&gt;&lt;tns1:BMC_LIGHT&gt;&lt;xsl:value-of select="ns:VLAN/ns:BMC_LIGHT"/&gt;&lt;/tns1:BMC_LIGHT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:INTERMEDIATE_AGENT"&gt;&lt;tns1:INTERMEDIATE_AGENT&gt;&lt;xsl:value-of select="ns:VLAN/ns:INTERMEDIATE_AGENT"/&gt;&lt;/tns1:INTERMEDIATE_AGENT&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:TIPOLOGIA_CLUSTER_VLAN"&gt;&lt;tns1:TIPOLOGIA_CLUSTER_VLAN&gt;&lt;xsl:value-of select="ns:VLAN/ns:TIPOLOGIA_CLUSTER_VLAN"/&gt;&lt;/tns1:TIPOLOGIA_CLUSTER_VLAN&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:TIPOLOGIA_CLUSTER_VLAN_OLD"&gt;&lt;tns1:TIPOLOGIA_CLUSTER_VLAN_OLD&gt;&lt;xsl:value-of select="ns:VLAN/ns:TIPOLOGIA_CLUSTER_VLAN_OLD"/&gt;&lt;/tns1:TIPOLOGIA_CLUSTER_VLAN_OLD&gt;&lt;/xsl:if&gt;&lt;xsl:if test="ns:VLAN/ns:FLAG_FTTH_ONLY"&gt;&lt;tns1:FLAG_FTTH_ONLY&gt;&lt;xsl:value-of select="ns:VLAN/ns:FLAG_FTTH_ONLY"/&gt;&lt;/tns1:FLAG_FTTH_ONLY&gt;&lt;/xsl:if&gt;&lt;/tns1:INFO_VLAN&gt;&lt;/tns1:RESPONSE_INFO_VLAN&gt;&lt;/xsl:for-each&gt;&lt;/tns1:NOWtoCRMWS_CheckRaccoltaVLANResponse&gt;&lt;/parameters&gt;&lt;/tns:NOWtoCRMWS_CheckRaccoltaVLANResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
