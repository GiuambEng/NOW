                                    sqlStatement="UPDATE OLO_VLAN&#xa;  SET  COD_VLAN=?,CODFC_OLO_AGCOM=?, DATAFI_VALID = ? , DATAINZ_VALID= ? , &#xa;  ID_OLO_TITOLARE_VLAN= ?  , STATO = ?  WHERE  ID_OLO_VLAN=?  " xsi:type="jdbcPalette:JDBCUpdateActivity">

                                    <PreparedParameters
