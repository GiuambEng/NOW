            <bpws:scope name="While1" tibex:group="while" tibex:xpdlId="56c9f13a-a880-45b8-b716-9513ed865702">
                <bpws:targets>
                    <bpws:target linkName="AssignToWhile1"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="While1ToID_RICHIESTA"/>
                </bpws:sources>
                <bpws:variables>
                    <bpws:variable name="index" sca-bpel:internal="true" type="xsd:int">
                        <bpws:from>
                            <bpws:literal>1</bpws:literal>
                        </bpws:from>
                    </bpws:variable>
                </bpws:variables>
                <bpws:sequence name="sequence1" tibex:group="while">
                    <bpws:assign name="GroupInit1"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+7c2d9f08-5cba-49c9-b269-c8d8f0173885" version="2.0"> <xsl:template name="Accumulate" match="/"> <tns:AccumulatedOutput/> </xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="Accumulate"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:while name="while1" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($NOWtoCRMWS_CheckRaccoltaVLANIn/parameters/ns11:NOWtoCRMWS_CheckRaccoltaVLANRequest/ns11:INFO_VLAN)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($NOWtoCRMWS_CheckRaccoltaVLANIn.parameters/ns11:INFO_VLAN)]]></bpws:condition>
                        <bpws:flow name="flow3">
                            <bpws:links>
                                <bpws:link name="JDBCQuery1ToMapper" tibex:linkType="SUCCESSWITHCONDITION"/>
                                <bpws:link
                                    name="GroupStart1ToJDBCQuery1" tibex:linkType="SUCCESS"/>
                                <bpws:link name="MapperToAccumulate" tibex:linkType="SUCCESS"/>
                                <bpws:link name="JDBCQuery1ToMapper1" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="JDBCQueryANAGVLANToMapper" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart1"
                                tibex:group="groupStart" tibex:xpdlId="21235c19-b915-4be5-b5f7-cb6453d9db71">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStart1ToJDBCQuery1"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    name="Accumulate"
                                    outputVariable="Accumulate"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="7c2d9f08-5cba-49c9-b269-c8d8f0173885" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="MapperToAccumulate"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>Mapper</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+14d9c437-a59d-45e3-8f7a-e48b18500cf4+input&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;NOWtoCRMWS_CheckRaccoltaVLANIn&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:template name=&quot;JDBCQuery1-input&quot; match=&quot;/&quot;>&lt;tns:jdbcQueryActivityInput>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($NOWtoCRMWS_CheckRaccoltaVLANIn/parameters/tns1:NOWtoCRMWS_CheckRaccoltaVLANRequest/tns1:INFO_VLAN[number($index)]/tns1:SVLAN_COD)&quot;>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckRaccoltaVLANIn/parameters/tns1:NOWtoCRMWS_CheckRaccoltaVLANRequest/tns1:INFO_VLAN[number($index)]/tns1:SVLAN_COD&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;/tns:jdbcQueryActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="JDBCQueryANAGVLAN-input"
                                    name="JDBCQueryANAGVLAN"
                                    outputVariable="JDBCQueryANAGVLAN"
                                    tibex:xpdlId="14d9c437-a59d-45e3-8f7a-e48b18500cf4" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStart1ToJDBCQuery1"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="JDBCQuery1ToMapper">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="count($JDBCQueryANAGVLAN/Record)>0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition><![CDATA[count($JDBCQueryANAGVLAN/Record)>0]]></bpws:transitionCondition>
                                    </bpws:source>
