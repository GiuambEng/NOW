                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b2d31f2e-8f02-483f-9539-aa5e40641d2f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;MapperREQUESTVLAN&quot;/>&lt;xsl:param name=&quot;CRMWSCheckRaccoltaVLAN&quot;/>&lt;xsl:param name=&quot;JDBCQuery&quot;/>&lt;xsl:template name=&quot;InsertOLOVLAN-input&quot; match=&quot;/&quot;>&lt;tns:jdbcUpdateActivityInput>&lt;COD_VLAN>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE)&quot;>&lt;xsl:value-of select=&quot;$MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/COD_VLAN>&lt;CODFC_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($CRMWSCheckRaccoltaVLAN/RESPONSE/ns:RESPONSE/ns:INFO_VLAN[ns:SVLAN_CODE = $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE and $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:CVLAN_ID=ns:CVLAN_ID]/ns:VLAN/ns:OLO_CODING)&quot;>&lt;xsl:value-of select=&quot;$CRMWSCheckRaccoltaVLAN/RESPONSE/ns:RESPONSE/ns:INFO_VLAN[ns:SVLAN_CODE = $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE and $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:CVLAN_ID=ns:CVLAN_ID]/ns:VLAN/ns:OLO_CODING&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choos