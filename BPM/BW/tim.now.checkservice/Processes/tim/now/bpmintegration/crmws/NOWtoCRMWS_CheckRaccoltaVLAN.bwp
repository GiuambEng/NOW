                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:ns1=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd&quot; xmlns:tns=&quot;http://www.tibco.com/namespaces/tnt/plugins/jdbc+b2d31f2e-8f02-483f-9539-aa5e40641d2f+input&quot; xmlns:xsi=&quot;http://www.w3.org/2001/XMLSchema-instance&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSCheckRaccoltaVLAN.RESPONSE&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:param name=&quot;MapperREQUESTVLAN&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQuery&quot;/>&#xa;    &lt;xsl:template name=&quot;InsertOLOVLAN-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:jdbcUpdateActivityInput>&#xa;            &lt;COD_VLAN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_VLAN>&#xa;            &lt;CODFC_OLO_AGCOM>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN[ns:SVLAN_CODE = $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE and $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:CVLAN_ID=ns:CVLAN_ID]/ns:VLAN/ns:OLO_CODING)&quot;>&#xa;                        &lt;xsl:value-of select=&q