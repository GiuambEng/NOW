#xa;            &lt;TIPOLG>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN[ns:SVLAN_CODE = $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE and $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:CVLAN_ID=ns:CVLAN_ID]/ns:VLAN/ns:TIPOLOGIA)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN[ns:SVLAN_CODE = $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE and $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:CVLAN_ID=ns:CVLAN_ID]/ns:VLAN/ns:TIPOLOGIA&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/TIPOLG>&#xa;            &lt;COD_VLAN>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/COD_VLAN>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($trasc_customer/Record) and string-length(string($trasc_customer/Record[1]/ID_TPLG_OPERATORE))>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE>&#xa;                        &lt;xsl:choose>&#xa;                            &lt;xsl:when test=&quot;exists($trasc_customer/Record[1]/ID_TPLG_OPERATORE)&quot;>&#xa;                                &lt;xsl:value-of select=&quot;$trasc_customer/Record[1]/ID_TPLG_OPERATORE&quot;/>&#xa;                            &lt;/xsl:when>&#xa;                            &lt;xsl:otherwise>&#xa;                                &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                            &lt;/xsl:otherwise>&#xa;                        &lt;/xsl:choose>&#xa;                    &lt;/ID_TPLG_OPERATORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:when test=&quot;string-length($CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN[number($index)]/ns:VLAN/ns:CUSTOMER)>0&quot;>&#xa;                    &lt;ID_TPLG_OPERATORE>&#xa;                        &lt;xsl:value-of select=&quot;xsd:integer($CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN[number($index)]/ns:VLAN/ns:CUSTOMER)&quot;/>&#xa;                    &lt;/ID_TPLG_OPERATORE>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;ID_TPLG_OPERATORE xsi:nil=&quot;true&quot;/>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;BMC_LIGHT>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;exists($CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN[ns:SVLAN_CODE = $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE and $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:CVLAN_ID=ns:CVLAN_ID]/ns:VLAN/ns:BMC_LIGHT)&quot;>&#xa;                        &lt;xsl:value-of select=&quot;$CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN[ns:SVLAN_CODE = $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:SVLAN_CODE and $MapperREQUESTVLAN/ns1:INFO_VLAN[number($index)]/ns1:CVLAN_ID=ns:CVLAN_ID]/ns:VLAN/ns:BMC_LIGHT&quot;/>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/BMC_LIGHT>&#xa;        &lt;/tns1:jdbcUpdateActivityInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
