                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/NOWtoCRMWS_CheckRaccoltaVLAN/&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckRaccoltaVLAN/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSCheckRaccoltaVLAN.RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;NOWtoCRMWS_CheckRaccoltaVLANOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:NOWtoCRMWS_CheckRaccoltaVLANResponse>&#xa;            &lt;tns1:ESITO>&#xa;                &lt;xsl:value-of select=&quot;$CRMWSCheckRaccoltaVLAN.RESPONSE/ns:ESITO&quot;/>&#xa;            &lt;/tns1:ESITO>&#xa;            &lt;tns1:CODICE_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;$CRMWSCheckRaccoltaVLAN.RESPONSE/ns:CODICE_CAUSALE&quot;/>&#xa;            &lt;/tns1:CODICE_CAUSALE>&#xa;            &lt;tns1:DESCRIZIONE_CAUSALE>&#xa;                &lt;xsl:value-of select=&quot;upper-case($CRMWSCheckRaccoltaVLAN.RESPONSE/ns:DESCRIZIONE_CAUSALE)&quot;/>&#xa;            &lt;/tns1:DESCRIZIONE_CAUSALE>&#xa;            &lt;xsl:for-each select=&quot;$CRMWSCheckRaccoltaVLAN.RESPONSE/ns:INFO_VLAN&quot;>&#xa;                &lt;tns1:RESPONSE_INFO_VLAN>&#xa;                    &lt;tns1:CVLAN_ID>&#xa;                        &lt;xsl:value-of select=&quot;ns:CVLAN_ID&quot;/>&#xa;                    &lt;/tns1:CVLAN_ID>&#xa;                    &lt;tns1:SVLAN_CODE>&#xa;                        &lt;xsl:value-of select=&quot;ns:SVLAN_CODE&quot;/>&#xa;                    &lt;/tns1:SVLAN_CODE>&#xa;                    &lt;tns1:CODICE_CAUSALE>&#xa;                        &lt;xsl:value-of select=&quot;ns:CODICE_CAUSALE&quot;/>&#xa;                    &lt;/tns1:CODICE_CAUSALE>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;ns:DESCRIZIONE_CAUSALE ='K0 Generico'&quot;>&#xa;                            &lt;tns1:DESCRIZIONE_CAUSALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;KOGENERICO&amp;quot;&quot;/>&#xa;                            &lt;/tns1:DESCRIZIONE_CAUSALE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;ns:DESCRIZIONE_CAUSALE ='VLAN_Non_Associata_Ad_OLO'&quot;>&#xa;                            &lt;tns1:DESCRIZIONE_CAUSALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VLANNONASSOCIATAADOLO&amp;quot;&quot;/>&#xa;                            &lt;/tns1:DESCRIZIONE_CAUSALE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;ns:DESCRIZIONE_CAUSALE ='VLAN_Inesistente'&quot;>&#xa;                            &lt;tns1:DESCRIZIONE_CAUSALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VLANINESISTENTE&amp;quot;&quot;/>&#xa;                            &lt;/tns1:DESCRIZIONE_CAUSALE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;ns:DESCRIZIONE_CAUSALE ='VLAN_Cessata_O_In_Cessazione'&quot;>&#xa;                            &lt;tns1:DESCRIZIONE_CAUSALE>&#xa;                                &lt;xsl:value-of select=&quot;&amp;quot;VLANCESSATAOINCESSAZIONE&amp;quot;&quot;/>&#xa;                            &lt;/tns1:DESCRIZIONE_CAUSALE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:when test=&quot;ns:DESCRIZIONE_CAUSALE ='Coppia_Esistente'&quot;>&#xa;                            &lt;tns1:DESCRIZIONE_CAUSALE>&#xa;                                &lt;xsl:value-of select=&quot;'COPPIAESISTENTE'&quot;/>&#xa;                            &lt;/tns1:DESCRIZIONE_CAUSALE>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns1:DESCRIZIONE_CAUSALE>&