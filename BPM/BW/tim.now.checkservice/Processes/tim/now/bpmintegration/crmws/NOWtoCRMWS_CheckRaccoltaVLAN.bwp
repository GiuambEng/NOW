&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions" xmlns:ns="http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2" version="2.0"&gt;&lt;xsl:param name="CRMWSCheckRaccoltaVLAN"/&gt;&lt;xsl:template name="Throw-input" match="/"&gt;&lt;tns:DefaultFault&gt;&lt;message&gt;&lt;xsl:value-of select="concat('Esito non gestito' , $CRMWSCheckRaccoltaVLAN/RESPONSE/ns:RESPONSE/ns:ESITO)"/&gt;&lt;/message&gt;&lt;msgCode&gt;&lt;xsl:value-of select="'KO'"/&gt;&lt;/msgCode&gt;&lt;/tns:DefaultFault&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions&quot; xmlns:ns=&quot;http://www.tibco.com/schemas/NOW/SharedResources/XSD/CRMWSCheckRaccoltaVLAN/Schema.xsd2&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CRMWSCheckRaccoltaVLAN.RESPONSE&quot;/>&#xa;    &lt;xsl:template name=&quot;Throw-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DefaultFault>&#xa;            &lt;message>&#xa;                &lt;xsl:value-of select=&quot;concat('Esito non gestito' , $CRMWSCheckRaccoltaVLAN.RESPONSE/ns:ESITO)&quot;/>&#xa;            &lt;/message>&#xa;            &lt;msgCode>&#xa;                &lt;xsl:value-of select=&quot;'KO'&quot;/>&#xa;            &lt;/msgCode>&#xa;        &lt;/tns:DefaultFault>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
