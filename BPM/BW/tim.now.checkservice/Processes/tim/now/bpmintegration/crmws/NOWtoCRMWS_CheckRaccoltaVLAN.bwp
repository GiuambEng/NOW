&lt;xsl:choose>&lt;xsl:when test=&quot;exists($JDBCQuery/Record/STATO)&quot;>&lt;xsl:value-of select=&quot;$JDBCQuery/Record/STATO&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:attribute name=&quot;xsi:nil&quot;>true&lt;/xsl:attribute>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/STATO>&lt;/tns:jdbcUpdateActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
