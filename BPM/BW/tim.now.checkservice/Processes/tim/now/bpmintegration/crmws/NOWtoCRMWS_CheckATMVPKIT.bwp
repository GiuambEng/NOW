#xa;                            &lt;/tns1:TD_KIT>&#xa;                            &lt;tns1:STATO>&#xa;                                &lt;xsl:value-of select=&quot;ns:STATO&quot;/>&#xa;                            &lt;/tns1:STATO>&#xa;                            &lt;tns1:DEC_ATT>&#xa;                                &lt;xsl:value-of select=&quot;ns:DEC_ATT&quot;/>&#xa;                            &lt;/tns1:DEC_ATT>&#xa;                            &lt;tns1:DEC>&#xa;                                &lt;xsl:value-of select=&quot;ns:DEC&quot;/>&#xa;                            &lt;/tns1:DEC>&#xa;                            &lt;tns1:CLLI_SEDE>&#xa;                                &lt;xsl:value-of select=&quot;ns:CLLI_SEDE&quot;/>&#xa;                            &lt;/tns1:CLLI_SEDE>&#xa;                            &lt;tns1:ADR_CODE>&#xa;                                &lt;xsl:value-of select=&quot;ns:ADR_CODE&quot;/>&#xa;                            &lt;/tns1:ADR_CODE>&#xa;                            &lt;tns1:ADR_DESC>&#xa;                                &lt;xsl:value-of select=&quot;ns:ADR_DESC&quot;/>&#xa;                            &lt;/tns1:ADR_DESC>&#xa;                            &lt;tns1:OLO_CODING>&#xa;                                &lt;xsl:value-of select=&quot;ns:OLO_CODING&quot;/>&#xa;                            &lt;/tns1:OLO_CODING>&#xa;                            &lt;tns1:OLO_CODE>&#xa;                                &lt;xsl:value-of select=&quot;ns:OLO_CODE&quot;/>&#xa;                            &lt;/tns1:OLO_CODE>&#xa;                            &lt;tns1:TD_KIT_PRIME_CONTRACTOR>&#xa;                                &lt;xsl:value-of select=&quot;ns:TD_KIT_PRIME_CONTRACTOR&quot;/>&#xa;                            &lt;/tns1:TD_KIT_PRIME_CONTRACTOR>&#xa;                        &lt;/tns1:INFO_VP_KIT_KIT>&#xa;                    &lt;/xsl:for-each>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise/>&#xa;            &lt;/xsl:choose>&#xa;            