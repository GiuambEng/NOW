                                    sqlStatement="INSERT INTO  &#xd;&#xa;ANAG_VP (BANDA_MCR,BANDA_PCR,CLLI,COD_AREA_RACCOLTA,COD_KIT,COD_OLO,COD_VP,DEC,&#xd;&#xa;DEC_ATTIVAZIONE,DESC_AREA_RACCOLTA,MODALITA_FATTURAZIONE, NOME_CENTRALE,NUMERO_MAX_VC,STATO,&#xd;&#xa;TIPO,TIPO_TRASPORTO,VPI,VPI_RETE,CODFC_OLO_AGCOM) &#xd;&#xa;VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;" xsi:type="jdbcPalette:JDBCUpdateActivity">
