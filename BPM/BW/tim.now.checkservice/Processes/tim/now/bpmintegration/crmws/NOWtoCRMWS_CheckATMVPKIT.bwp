                </bpws:variables>
                <bpws:sequence name="sequence" tibex:group="while">
                    <bpws:empty name="GroupInit" tibex:group="groupInit"/>
                    <bpws:while name="while" tibex:counterName="index">
                        <tibex:DesignExpression>
                            <tibex:expression
                                expression="$index &lt;= count($NOWtoCRMWS_CheckVPKITIn/REQUEST/tns:NOWtoCRMWS_CheckVPKITRequest/tns:INFO_VP_KIT)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:condition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$index <= count($NOWtoCRMWS_CheckVPKITIn.REQUEST/tns:INFO_VP_KIT)]]></bpws:condition>
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="GroupStartToVCElementAssign" tibex:linkType="SUCCESS"/>
                                <bpws:link
                                    name="VCElementAssignToGroupEnd" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="GroupStart"
                                tibex:group="groupStart" tibex:xpdlId="ab2bcf50-7212-42e8-a63e-73c3c40ec230">
                                <bpws:sources>
                                    <bpws:source linkName="GroupStartToVCElementAssign"/>
                                </bpws:sources>
                            </bpws:empty>
                            <bpws:empty name="GroupEnd"
                                tibex:group="groupEnd" tibex:xpdlId="74bb1c29-e80b-4717-b203-e53b8635246f">
                                <bpws:targets>
                                    <bpws:target linkName="VCElementAssignToGroupEnd"/>
                                </bpws:targets>
                            </bpws:empty>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;VCElement&quot;/>&lt;xsl:param name=&quot;index&quot;/>&lt;xsl:param name=&quot;NOWtoCRMWS_CheckVPKITIn&quot;/>&lt;xsl:template name=&quot;VCElement&quot; match=&quot;/&quot;>&lt;tns:NOWtoCRMWS_CheckVPKITRequest>&lt;tns:CODICE_OLO>&lt;xsl:value-of select=&quot;$VCElement/tns:CODICE_OLO&quot;/>&lt;/tns:CODICE_OLO>&lt;tns:CODICE_OLO_AGCOM>&lt;xsl:value-of select=&quot;$VCElement/tns:CODICE_OLO_AGCOM&quot;/>&lt;/tns:CODICE_OLO_AGCOM>&lt;xsl:choose>&lt;xsl:when test=&quot;exists($VCElement/tns:INFO_VP_KIT[tns:ID_RISORSA = $NOWtoCRMWS_CheckVPKITIn/REQUEST/tns:NOWtoCRMWS_CheckVPKITRequest/tns:INFO_VP_KIT[number($index)]/tns:ID_RISORSA])&quot;>&lt;xsl:copy-of select=&quot;$VCElement/tns:INFO_VP_KIT&quot;/>&lt;/xsl:when>&lt;xsl:otherwise>&lt;xsl:copy-of select=&quot;$VCElement/tns:INFO_VP_KIT&quot;/>&lt;tns:INFO_VP_KIT>&lt;tns:NUM_VC>&lt;xsl:value-of select=&quot;$index&quot;/>&lt;/tns:NUM_VC>&lt;tns:ID_RISORSA>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckVPKITIn/REQUEST/tns:NOWtoCRMWS_CheckVPKITRequest/tns:INFO_VP_KIT[number($index)]/tns:ID_RISORSA&quot;/>&lt;/tns:ID_RISORSA>&lt;tns:TIPO_CONSEGNA>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckVPKITIn/REQUEST/tns:NOWtoCRMWS_CheckVPKITRequest/tns:INFO_VP_KIT[number($index)]/tns:TIPO_CONSEGNA&quot;/>&lt;/tns:TIPO_CONSEGNA>&lt;tns:FLAG_PRESENZA_NOW>&lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckVPKITIn/REQUEST/tns:NOWtoCRMWS_CheckVPKITRequest/tns:INFO_VP_KIT[number($index)]/tns:FLAG_PRESENZA_NOW&quot;/>&lt;/tns:FLAG_PRESENZA_NOW>&lt;/tns:INFO_VP_KIT>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;xsl:if test=&quot;$VCElement/tns:ID_RICH_OLO&quot;>&lt;tns:ID_RICH_OLO>&lt;xsl:value-of select=&quot;$VCElement/tns:ID_RICH_OLO&quot;/>&lt;/tns:ID_RICH_OLO>&lt;/xsl:if>&lt;/tns:NOWtoCRMWS_CheckVPKITRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="VCElement"
                                    name="VCElementAssign"
                                    outputVariable="VCElement"
                                    tibex:xpdlId="fe89f845-c31e-4d4b-9db5-568b031c3a04" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToVCElementAssign"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="VCElementAssignToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/NOWtoCRMWS_CheckVPKIT/&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;NOWtoCRMWS_CheckVPKITIn.REQUEST&quot;/>&#xa;    &lt;xsl:param name=&quot;VCElement&quot;/>&#xa;    &lt;xsl:param name=&quot;index&quot;/>&#xa;    &lt;xsl:template name=&quot;VCElement&quot; match=&quot;/&quot;>&#xa;        &lt;tns:NOWtoCRMWS_CheckVPKITRequest>&#xa;            &lt;tns:CODICE_OLO>&#xa;                &lt;xsl:value-of select=&quot;$VCElement/tns:CODICE_OLO&quot;/>&#xa;            &lt;/tns:CODICE_OLO>&#xa;            &lt;tns:CODICE_OLO_AGCOM>&#xa;                &lt;xsl:value-of select=&quot;$VCElement/tns:CODICE_OLO_AGCOM&quot;/>&#xa;            &lt;/tns:CODICE_OLO_AGCOM>&#xa;            &lt;xsl:choose>&#xa;                &lt;xsl:when test=&quot;exists($VCElement/tns:INFO_VP_KIT[tns:ID_RISORSA = $NOWtoCRMWS_CheckVPKITIn.REQUEST/tns:INFO_VP_KIT[number($index)]/tns:ID_RISORSA])&quot;>&#xa;                    &lt;xsl:copy-of select=&quot;$VCElement/tns:INFO_VP_KIT&quot;/>&#xa;                &lt;/xsl:when>&#xa;                &lt;xsl:otherwise>&#xa;                    &lt;xsl:copy-of select=&quot;$VCElement/tns:INFO_VP_KIT&quot;/>&#xa;                    &lt;tns:INFO_VP_KIT>&#xa;                        &lt;tns:NUM_VC>&#xa;                            &lt;xsl:value-of select=&quot;$index&quot;/>&#xa;                        &lt;/tns:NUM_VC>&#xa;                        &lt;tns:ID_RISORSA>&#xa;                            &lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckVPKITIn.REQUEST/tns:INFO_VP_KIT[number($index)]/tns:ID_RISORSA&quot;/>&#xa;                        &lt;/tns:ID_RISORSA>&#xa;                        &lt;tns:TIPO_CONSEGNA>&#xa;                            &lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckVPKITIn.REQUEST/tns:INFO_VP_KIT[number($index)]/tns:TIPO_CONSEGNA&quot;/>&#xa;                        &lt;/tns:TIPO_CONSEGNA>&#xa;                        &lt;tns:FLAG_PRESENZA_NOW>&#xa;                            &lt;xsl:value-of select=&quot;$NOWtoCRMWS_CheckVPKITIn.REQUEST/tns:INFO_VP_KIT[number($index)]/tns:FLAG_PRESENZA_NOW&quot;/>&#xa;                        &lt;/tns:FLAG_PRESENZA_NOW>&#xa;                    &lt;/tns:INFO_VP_KIT>&#xa;                &lt;/xsl:otherwise>&#xa;            &lt;/xsl:choose>&#xa;            &lt;xsl:if test=&quot;$VCElement/tns:ID_RICH_OLO&quot;>&#xa;                &lt;tns:ID_RICH_OLO>&#xa;                    &lt;xsl:value-of select=&quot;$VCElement/tns:ID_RICH_OLO&quot;/>&#xa;                &lt;/tns:ID_RICH_OLO>&#xa;            &lt;/xsl:if>&#xa;        &lt;/tns:NOWtoCRMWS_CheckVPKITRequest>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.bwassign"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VCElement" xsi:type="generalactivities:BWAssign"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                </tibex:activityExtension>
                            </bpws:extensionActivity>
                        </bpws:flow>
                    </bpws:while>
                </bpws:sequence>
            </bpws:scope>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    expression="concat($_processContext/ProcessInstanceId, string(tib:timestamp()))"
                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"
                    inputVariable="TransactionID"
                    name="GenerateTransactionID"
                    outputVariable="TransactionID"
                    tibex:xpdlId="87f8d672-9a29-40c8-8583-11d28c3cc1a3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="NOWtoCRMWS_CheckVPKITInToAssign1"/>
