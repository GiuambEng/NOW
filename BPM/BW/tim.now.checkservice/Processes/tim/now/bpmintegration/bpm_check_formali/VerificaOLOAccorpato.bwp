                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;VerificaOLOAccorpatoIn.parameters&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBC_OLO_Accorpato&quot;/>&#xa;    &lt;xsl:template name=&quot;VerificaOLOAccorpatoResponse&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;string-length($VerificaOLOAccorpatoIn.parameters/tns:CodificaOLOAGCOM2) > 0&quot;>&#xa;                &lt;xsl:choose>&#xa;                    &lt;xsl:when test=&quot;$JDBC_OLO_Accorpato/Record[1]/COD_OLO_ACCORPANTE = $VerificaOLOAccorpatoIn.parameters/tns:CodificaOLOAGCOM1 or $JDBC_OLO_Accorpato/Record[1]/COD_OLO_ACCORPANTE = $VerificaOLOAccorpatoIn.parameters/tns:CodificaOLOAGCOM2&quot;>&#xa;                        &lt;tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;                    &lt;/xsl:when>&#xa;                    &lt;xsl:otherwise>&#xa;                        &lt;tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;                    &lt;/xsl:otherwise>&#xa;                &lt;/xsl:choose>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:when test=&quot;string-length($VerificaOLOAccorpatoIn.parameters/tns:CodificaOLOAGCOM2) = 0 and string-length($VerificaOLOAccorpatoIn.parameters/tns:CodificaOLOAGCOM1)  > 0&quot;>&#xa;                &lt;tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;                    &lt;xsl:choose>&#xa;                        &lt;xsl:when test=&quot;$JDBC_OLO_Accorpato/Record[1]/COD_OLO_ACCORPANTE = $VerificaOLOAccorpatoIn.parameters/tns:CodificaOLOAGCOM1&quot;>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;false()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;KO&amp;quot;&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:when>&#xa;                        &lt;xsl:otherwise>&#xa;                            &lt;tns:Esito>&#xa;                                &lt;tns:Codice>&#xa;                                    &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                                &lt;/tns:Codice>&#xa;                                &lt;tns:Descrizione>&#xa;                                    &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                                &lt;/tns:Descrizione>&#xa;                            &lt;/tns:Esito>&#xa;                        &lt;/xsl:otherwise>&#xa;                    &lt;/xsl:choose>&#xa;                &lt;/tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;&amp;quot;OK&amp;quot;&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:Verifica_OLO_Accorpato_Recipient_Donating_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.bwassign"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//BWAssign"/>
                                    <value
                                    processVariable="VerificaOLOAccorpatoResponse" xsi:type="generalactivities:BWAssign"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
