                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:em=&quot;http://www.tim.com/NOW/xsd/EsitiMultipli/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;RecuperaCausaleEsitoMultiplo&quot;/>&lt;xsl:param name=&quot;QueryOscuramento&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;xsl:choose>&lt;xsl:when test=&quot;($Start/tns:Offerta=('VULAFTTCAB','EASYIPNGAFTTCAB','BITSTREAMNGAFTTCAB') and count($Start/tns:ServizioOpzionale[tns:ambitoDel82='SI'])>0) or ($Start/tns:Offerta=('VULAFTTH','SEMIVULAFTTH','BITSTREAMNGAFTTH','EASYIPNGAFTTH') and count($Start/tns:ServizioOpzionale[tns:codiceServizio='TLC8' and tns:vincolantePerEspletamento!='NO'])>0) and count($QueryOscuramento/Record/FLAG_OSCURMENTO) = 0&quot;>&lt;tns:VerificaAbilitazioneONTDel82_Response>&lt;xsl:if test=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;>&lt;tns:idAnagraficaCausale>&lt;xsl:value-of select=&quot;$RecuperaCausaleEsitoMultiplo/em:IdAnagraficaCausale&quot;/>&lt;/tns:idAnagraficaCausale>&lt;/xsl:if>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns:Codice>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:Offerta=('VULAFTTCAB','EASYIPNGAFTTCAB','BITSTREAMNGAFTTCAB') and count($Start/tns:ServizioOpzionale[tns:ambitoDel82='SI'])>0&quot;>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_01'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'KO_02'&quot;/>&lt;/tns:Descrizione>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns:Esito>&lt;/tns:VerificaAbilitazioneONTDel82_Response>&lt;/xsl:when>&lt;xsl:when test=&quot;count($QueryOscuramento/Record/FLAG_OSCURMENTO) !=0&quot;>&lt;tns:VerificaAbilitazioneONTDel82_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaAbilitazioneONTDel82_Response>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns:VerificaAbilitazioneONTDel82_Response>&lt;tns:Esito>&lt;tns:Codice>&lt;xsl:value-of select=&quot;true()&quot;/>&lt;/tns:Codice>&lt;tns:Descrizione>&lt;xsl:value-of select=&quot;'OK'&quot;/>&lt;/tns:Descrizione>&lt;/tns:Esito>&lt;/tns:VerificaAbilitazioneONTDel82_Response>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
