                    <bpws:targets>
                        <bpws:target linkName="CallProcess1ToEnd"/>
                        <bpws:target linkName="CallProcess2ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;JDBCQueryConteggioOloSec&quot;/>&#xa;    &lt;xsl:param name=&quot;JDBCQueryConteggioOlo&quot;/>&#xa;    &lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&#xa;        &lt;xsl:choose>&#xa;            &lt;xsl:when test=&quot;$JDBCQueryConteggioOloSec/Record/CONTEGGIO > 0 or $JDBCQueryConteggioOlo/Record/CONTEGGIO > 0&quot;>&#xa;                &lt;tns:DeterminaMigrazioneCommercialeIntraOLO_Response>&#xa;                    &lt;tns:migrCommercialeIntraOlo>&#xa;                        &lt;xsl:value-of select=&quot;'SI'&quot;/>&#xa;                    &lt;/tns:migrCommercialeIntraOlo>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:DeterminaMigrazioneCommercialeIntraOLO_Response>&#xa;            &lt;/xsl:when>&#xa;            &lt;xsl:otherwise>&#xa;                &lt;tns:DeterminaMigrazioneCommercialeIntraOLO_Response>&#xa;                    &lt;tns:migrCommercialeIntraOlo>&#xa;                        &lt;xsl:value-of select=&quot;'NO'&quot;/>&#xa;                    &lt;/tns:migrCommercialeIntraOlo>&#xa;                    &lt;tns:Esito>&#xa;                        &lt;tns:Codice>&#xa;                            &lt;xsl:value-of select=&quot;true()&quot;/>&#xa;                        &lt;/tns:Codice>&#xa;                        &lt;tns:Descrizione>&#xa;                            &lt;xsl:value-of select=&quot;'OK'&quot;/>&#xa;                        &lt;/tns:Descrizione>&#xa;                    &lt;/tns:Esito>&#xa;                &lt;/tns:DeterminaMigrazioneCommercialeIntraOLO_Response>&#xa;            &lt;/xsl:otherwise>&#xa;        &lt;/xsl:choose>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
