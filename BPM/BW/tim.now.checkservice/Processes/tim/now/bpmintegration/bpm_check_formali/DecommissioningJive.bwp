                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/VerificaDecomissioning_Jive&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&lt;tns5:RequestString>&lt;xsl:choose>&lt;xsl:when test=&quot;$Start/tns:TipologiaSottoLav = 'CAMBIOCOPPIA'&quot;>&lt;tns5:Richiesta>&lt;xsl:value-of select=&quot;'NOJIVE'&quot;/>&lt;/tns5:Richiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;$Start/tns:Lavorazione = 'VARIAZIONE' and $Start/tns:TipologiaSottoLav = 'VARIAZIONEDESTINAZIONEUSO'  and&amp;#xD;&amp;#xA;        (&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVA' or &amp;#xD;&amp;#xA;&amp;#x9;&amp;#x9; $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVANP')&quot;>&lt;tns5:Richiesta>&lt;xsl:value-of select=&quot;'NOJIVE'&quot;/>&lt;/tns5:Richiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;($Start/tns:Lavorazione='ATTIVAZIONE' and ($Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or &amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA')) or ($Start/tns:Lavorazione = 'VARIAZIONE' and&amp;#xD;&amp;#xA;        ($Start/tns:TipologiaSottoLav = 'TRASLOCOWLR12' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCO' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR13' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR14' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR15' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'TRASLOCOWLR16') and&amp;#xD;&amp;#xA;        ($Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'WLRLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVANP' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVANP')&amp;#xD;&amp;#xA;    )&quot;>&lt;tns5:Richiesta>&lt;xsl:value-of select=&quot;concat('codiceToponomastico=',$Start/tns:SEDECLIENTE/tns:codiceToponomastica,'&amp;amp;particellaToponomastica=',$Start/tns:SEDECLIENTE/tns:particellaToponomastica,'&amp;amp;strada=',$Start/tns:SEDECLIENTE/tns:via,'&amp;amp;comune=',$Start/tns:SEDECLIENTE/tns:localita,'&amp;amp;cap=',$Start/tns:SEDECLIENTE/tns:CAP,'&amp;amp;civico=',$Start/tns:SEDECLIENTE/tns:civico,'&amp;amp;istatComune=',$Start/tns:SEDECLIENTE/tns:IstatComune)&quot;/>&lt;/tns5:Richiesta>&lt;/xsl:when>&lt;xsl:when test=&quot;(($Start/tns:Lavorazione = 'ATTIVAZIONE' and $Start/tns:OffertaRichiesta = ('WLRLINEAATTIVA','ULLLINEAATTIVA','ULLLINEAATTIVANP')&amp;#xD;&amp;#xA;    )&amp;#xD;&amp;#xA;    or&amp;#xD;&amp;#xA;    ($Start/tns:Lavorazione = 'MIGRAZIONE' and &amp;#xD;&amp;#xA;        ($Start/tns:OffertaRichiesta = 'BITSTREAMGBEASIMMETRICOFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'BITSTREAMATMASIMMETRICOFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'BITSTREAMATMASIMMETRICOHL' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'BITSTREAMATMASIMMETRICOLITE' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPBASEPLUSFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPBASEPLUSLITE' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPSPECIALPROFILEFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPSPECIALPROFILELITE') and&amp;#xD;&amp;#xA;        ($Start/tns:OffertaConsDati = 'BITSTREAMGBEASIMMETRICOFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsDati = 'BITSTREAMATMASIMMETRICOFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsDati = 'BITSTREAMATMASIMMETRICOHL' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsDati = 'BITSTREAMATMASIMMETRICOLITE' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsDati = 'EASYIPBASEPLUSFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsDati = 'EASYIPBASEPLUSLITE' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsDati = 'EASYIPSPECIALPROFILEFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsDati = 'EASYIPSPECIALPROFILELITE')&amp;#xD;&amp;#xA;    )&amp;#xD;&amp;#xA;    or&amp;#xD;&amp;#xA;    ($Start/tns:Lavorazione = 'MIGRAZIONE' and &amp;#xD;&amp;#xA;        ($Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'WLRLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVANP' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVANP') and&amp;#xD;&amp;#xA;        ($Start/tns:OffertaConsFonia = 'ULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsFonia = 'ULLLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsFonia = 'ULLDATILINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsFonia = 'ULLDATILINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsFonia = 'WLRLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsFonia = 'WLRLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsFonia = 'ULLLINEAATTIVANP' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaConsFonia = 'ULLDATILINEAATTIVANP')&amp;#xD;&amp;#xA;    )&amp;#xD;&amp;#xA;    or&amp;#xD;&amp;#xA;    ($Start/tns:Lavorazione = 'VARIAZIONE' and &amp;#xD;&amp;#xA;        ($Start/tns:TipologiaSottoLav = 'CAMBIOCOPPIA' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'VARIAZIONEDESTINAZIONEUSO' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CAMBIONUMERO3' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CAMBIONUMERO4' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'INCREMENTOCANALI' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'DECREMENTOCANALI' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'INCREMENTOBORCHIA' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'DECREMENTOBORCHIA' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CAMBIOTIPOLOGiAWLR10' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CAMBIOTIPOLOGIAWLR11' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CAMBIOTIPOLOGIAWLR8' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CAMBIOTIPOLOGIAWLR9' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'ATTIVAZIONESTS' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'ATTIVAZIONESTSMULTINUMERO' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CESSAZIONESTS' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CESSAZIONESTSMULTINUMERO' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'PRESTAZIONEWLR5' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'PRESTAZIONEWLR6' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'PRESTAZIONEWLR7' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'PRESTAZIONEWLR18' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'PRESTAZIONEWLR19' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'PRESTAZIONEWLR20') and&amp;#xD;&amp;#xA;        ($Start/tns:OffertaRichiesta = 'WLRLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'WLRLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLLINEAATTIVANP' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEANONATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'ULLDATILINEAATTIVANP' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'SHACONMANODOPERA' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'SHASENZAMANODOPERA')&amp;#xD;&amp;#xA;    )&amp;#xD;&amp;#xA;    or&amp;#xD;&amp;#xA;    ($Start/tns:Lavorazione = 'VARIAZIONE' and &amp;#xD;&amp;#xA;        ($Start/tns:TipologiaSottoLav = 'RICONFIGURAZIONEVC' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'VARIAZIONECARATTERISTICA' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'INCREMENTODECREMENTOVC' or&amp;#xD;&amp;#xA;         $Start/tns:TipologiaSottoLav = 'CAMBIOSLA') and&amp;#xD;&amp;#xA;        ($Start/tns:OffertaRichiesta = 'BITSTREAMGBEASIMMETRICOFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'BITSTREAMATMASIMMETRICOFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'BITSTREAMATMASIMMETRICOHL' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'BITSTREAMATMASIMMETRICOLITE' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPBASEPLUSFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPBASEPLUSLITE' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPSPECIALPROFILEFLAT' or&amp;#xD;&amp;#xA;         $Start/tns:OffertaRichiesta = 'EASYIPSPECIALPROFILELITE')&amp;#xD;&amp;#xA;    )) and string-length($Start/tns:Clli4Jive)>0&quot;>&lt;tns5:Richiesta>&lt;xsl:value-of select=&quot;concat('clliCentrale=',$Start/tns:Clli4Jive)&quot;/>&lt;/tns5:Richiesta>&lt;/xsl:when>&lt;xsl:otherwise>&lt;tns5:Richiesta>&lt;xsl:value-of select=&quot;'NOJIVE'&quot;/>&lt;/tns5:Richiesta>&lt;/xsl:otherwise>&lt;/xsl:choose>&lt;/tns5:RequestString>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:VerificaDecomissioning_Jive="http://www.tim.com/NOW/xsd/VerificaDecomissioning_Jive"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="VerificaDecomissioning_Jive:RequestString" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    governedObjectTypes="BWHttpReference"
                    inputVariable="SendHTTPRequest-input"
                    name="SendHTTPRequest"
                    outputVariable="SendHTTPRequest"
                    tibex:xpdlId="f4e773c7-5d17-4e6f-8cd0-6022377230b1" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="InsertStagToSendHTTPRequest"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="SendHTTPRequestToLogJive"/>
                        <bpws:source
                            linkName="SendHTTPRequestToGenericLogger"
                            tibex:faultDetailsVar="SendHTTPRequest" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression expression="##error##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##error##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://tns.tibco.com/bw/activity/sendhttprequest/input+f4e773c7-5d17-4e6f-8cd0-6022377230b1+RequestActivityInput&quot; xmlns:tns5=&quot;http://www.tim.com/NOW/xsd/VerificaDecomissioning_Jive&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;URIDecomissioning&quot;/>&lt;xsl:param name=&quot;Mapper&quot;/>&lt;xsl:param name=&quot;TransactionId&quot;/>&lt;xsl:template name=&quot;SendHTTPRequest-input&quot; match=&quot;/&quot;>&lt;tns8:RequestActivityInput>&lt;Method>&lt;xsl:value-of select=&quot;'POST'&quot;/>&lt;/Method>&lt;RequestURI>&lt;xsl:value-of select=&quot;$URIDecomissioning&quot;/>&lt;/RequestURI>&lt;xsl:if test=&quot;$Mapper/tns5:Richiesta&quot;>&lt;PostData>&lt;xsl:value-of select=&quot;$Mapper/tns5:Richiesta&quot;/>&lt;/PostData>&lt;/xsl:if>&lt;Headers>&lt;Accept>&lt;xsl:value-of select=&quot;'application/json'&quot;/>&lt;/Accept>&lt;Content-Type>&lt;xsl:value-of select=&quot;&amp;quot;application/x-www-form-urlencoded&amp;quot;&quot;/>&lt;/Content-Type>&lt;/Headers>&lt;DynamicHeaders>&lt;Header>&lt;Name>&lt;xsl:value-of select=&quot;'transactionId'&quot;/>&lt;/Name>&lt;Value>&lt;xsl:value-of select=&quot;$TransactionId&quot;/>&lt;/Value>&lt;/Header>&lt;Header>&lt;Name>&lt;xsl:value-of select=&quot;'transactionDate'&quot;/>&lt;/Name>&lt;Value>&lt;xsl:value-of select=&quot;format-dateTime(current-dateTime(), &amp;quot;[D01]-[M01]-[Y0001] [H01]:[m01]:[s01]&amp;quot;)&quot;/>&lt;/Value>&lt;/Header>&lt;Header>&lt;Name>&lt;xsl:value-of select=&quot;'sistemaOrigine'&quot;/>&lt;/Name>&lt;Value>&lt;xsl:value-of select=&quot;'NOW'&quot;/>&lt;/Value>&lt;/Header>&lt;/DynamicHeaders>&lt;/tns8:RequestActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.http.sendHTTPRequest"
                            version="6.0.0.20132205"
                            xmlns:RequestActivityInput="http://tns.tibco.com/bw/activity/sendhttprequest/input+f4e773c7-5d17-4e6f-8cd0-6022377230b1+RequestActivityInput"
                            xmlns:RequestActivityOutput="http://tns.tibco.com/bw/activity/sendhttprequest/output+f4e773c7-5d17-4e6f-8cd0-6022377230b1+RequestActivityOutput"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:http="http://ns.tibco.com/bw/palette/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/http#//SendHTTPRequest"/>
                                    <value
                                    httpClientResource="httpClientResource"
                                    inputHeadersQName="RequestActivityInput:inputHeadersType"
                                    outputHeadersQName="RequestActivityOutput:outputHeadersType"
                                    postDataAs="String" xsi:type="http:SendHTTPRequest">
                                    <writeToFilePolicy/>
                                    </value>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity inputVariable="LogError-input"
                    name="LogError"
                    tibex:xpdlId="addb13f7-b05c-427b-9f2e-8e4ff03b9809"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="SendHTTPRequestToGenericLogger"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogErrorToMapResponseBPM"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tim.com/NOW/xsd/GenericLogger&quot; xmlns:tns=&quot;http://www.tim.com/NOW/xsd/ControlliFormali/&quot; xmlns:tib=&quot;http://www.tibco.com/bw/xslt/custom-functions&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;LoggerName&quot;/>&lt;xsl:param name=&quot;LoggerLevel&quot;/>&lt;xsl:param name=&quot;_error&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns1:CW_BUS_MESSAGE>&lt;tns1:GenericLogger>&lt;tns1:Application>&lt;xsl:value-of select=&quot;&amp;quot;tim.now.checkservice.application&amp;quot;&quot;/>&lt;/tns1:Application>&lt;tns1:Process>&lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&lt;/tns1:Process>&lt;tns1:Service>&lt;xsl:value-of select=&quot;'CheckServiceFormali'&quot;/>&lt;/tns1:Service>&lt;tns1:Operation>&lt;xsl:value-of select=&quot;'DecomissioningJive'&quot;/>&lt;/tns1:Operation>&lt;xsl:if test=&quot;$Start/tns:IDRichiestaOLO&quot;>&lt;tns1:BusinessID>&lt;xsl:value-of select=&quot;$Start/tns:IDRichiestaOLO&quot;/>&lt;/tns1:BusinessID>&lt;/xsl:if>&lt;tns1:Message>&lt;xsl:value-of select=&quot;concat('Errore chiamata Jive: ',tib:render-xml($_error))&quot;/>&lt;/tns1:Message>&lt;tns1:LoggerName>&lt;xsl:value-of select=&quot;$LoggerName&quot;/>&lt;/tns1:LoggerName>&lt;tns1:LogLevel>&lt;xsl:value-of select=&quot;$LoggerLevel&quot;/>&lt;/tns1:LogLevel>&lt;tns1:LogJMS>&lt;xsl:value-of select=&quot;false()&quot;/>&lt;/tns1:LogJMS>&lt;/tns1:GenericLogger>&lt;/tns1:CW_BUS_MESSAGE>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        moduleRef="tim.now.shared_library" spawn="true"
                        subProcessName="ProcessLogger.GenericLogger" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
